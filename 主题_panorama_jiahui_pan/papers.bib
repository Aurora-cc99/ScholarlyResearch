@misc{panorama_jiahui_pan_728b3e7220e31f67,
  title = {Role-RL: Online Long-Context Processing with Role Reinforcement Learning for Multiple LLMs in Their Optimal Roles},
  author = {Lewei He and Pengran Huang and Tianyu Shi and Jingcong Li and Qianglong Chen and Jiahui Pan},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11461298},
  url = {https://doi.org/10.1109/icassp55912.2026.11461298},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：Role-RL：在线长上下文处理和角色强化学习，让多个大语言模型处于最佳角色},
  abstract = {Large language models (LLMs) with long-context processing are still challenging because proactive interference, position bias, and integration failure persist, that is, a long window is not equivalent to long understanding. To address this issue, a new paradigm named Online Long-context Processing (OLP) is proposed for processing contexts of unlimited length. Meanwhile, a dilemma was often encountered when we tried to select the most suitable LLM from a huge number of LLMs amid explosive growth, aiming for outstanding performance, affordable prices, and low latency. In view of this, we develop Role Reinforcement Learning (Role-RL) to automatically deploy distinct LLMs in their respective roles according to their actual performance. Extensive experiments are conducted on our OLP-MINI dataset and the public LongBench and ∞Bench, and the results show that OLP with Role-RL framework achieves state-of-the-art performance with an average transcription accuracy of 91.6% and an average QA accuracy of 69.0%. The code, prompt, and dataset are publicly available at: https://github.com/Human-HLW/Role-RL.},
}

