@misc{panorama_jiahui_pan_ae6cee31972c120c,
  title = {Multi-Scale Dynamic Temporal Network With Graph Matching Domain Adaptation for Cross-Subject EEG Emotion Recognition},
  author = {Rongtao Chen and Zhepei Hong and Liting Li and Zhuoyi Huang and Jingcong Li and Jiahui Pan},
  year = {2026},
