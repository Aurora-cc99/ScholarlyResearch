@misc{panorama_jiahui_pan_1441343ca00f181a,
  title = {OPA-Pack: Object-Property-Aware Robotic Bin Packing},
  author = {Jiahui Pan and Yeok Tatt Cheah and Zhengzhe Liu and Ka-Hei Hui and Xiaojie Gao and Pheng‐Ann Heng and Yun-Hui Liu and Chi‐Wing Fu},
  year = {2026},
  doi = {10.1109/tro.2026.3750786},
  url = {https://doi.org/10.1109/tro.2026.3750786},
  howpublished = {IEEE Transactions on Robotics},
  annotation = {中文辅助译名：OPA-Pack：对象属性感知机器人装箱},
  abstract = {Robotic bin packing is a fundamental manipulation problem with broad applications in e-commerce and warehouse automation. However, existing methods primarily focus on object geometry to optimize packing compactness without explicitly modeling object properties such as fragility, edibility, and chemical compatibility that humans typically consider during packing. This paper presents OPA-Pack (Object-Property-Aware Packing), a framework that incorporates object-property information into robotic bin-packing planning. The framework includes an object property recognition scheme based on retrieval-augmented generation and chain-of-thought reasoning to establish a dataset with object property annotations for 1,032 everyday objects. The framework further incorporates OPA-Net, which encodes candidate-object properties via a property embedding layer and represents the container state using fragility and avoidance heightmaps. We design a reward function and adopt a deep Q-learning scheme to train OPA-Net. Experimental results show that OPA-Pack improves avoidance accuracy from 52.3% to 95.0%, reduces load on fragile objects by 29.4%, and achieves a packing compactness of 0.413, compared with 0.420 for the baseline. In addition, we evaluate OPA-Pack on a physical platform using 70 packing sequences sampled from 100 scanned real-world objects. Results show that OPA-Pack outperforms the baseline and other packing heuristics in reducing the number of closely packed incompatible object pair},
}

@misc{panorama_jiahui_pan_24ce95e78f97e378,
  title = {PA-MEANet: A Pointer-Attention and Manifold-to-Entropy Adaptation Network for Cross-Subject EEG-fNIRS Decoding},
  author = {Lina Qiu and Zixiang Zhou and Jiahui Pan},
  year = {2026},
  doi = {10.1109/jiot.2026.3754495},
  url = {https://doi.org/10.1109/jiot.2026.3754495},
  howpublished = {IEEE Internet of Things Journal},
  annotation = {中文辅助译名：PA-MEANet：用于跨主题 EEG-fNIRS 解码的指针注意和流形熵适应网络},
  abstract = {Hybrid EEG-fNIRS brain-computer interfaces (BCIs) fuse neural electrical activity and hemodynamic metabolic information, offering substantial potential for robust brain-state decoding. However, the practical deployment of such systems is hindered by two critical issues: the inherent physiological asymmetry between electrophysiological and hemodynamic signals, and severe performance degradation under cross-subject settings due to inter-individual distribution shifts. To address these challenges, this paper proposes PA-MEANet, a lightweight multimodal fusion network for cross-subject EEG-fNIRS classification. The framework first employs modality-specific encoders tailored to the distinct temporal-spatial characteristics of EEG and fNIRS. An electrophysiological pointer-attention module (EPAM) is then introduced to exploit the asymmetric cross-modal relationship by using EEG representations as pointers to retrieve task-relevant fNIRS contextual information. A dual-modal gated integrator (DMGI) dynamically regulates the contribution of the retrieved fNIRS context through an EEG residual pathway, thereby enabling task-dependent integration of complementary electrophysiological and hemodynamic information. Furthermore, a two-stage progressive unsupervised domain adaptation strategy—combining Euclidean alignment (EA) at the input level and entropy-minimization-based test-time adaptation (TTA) at the model level—is adopted to mitigate the impact of cross-subject distribution shifts. },
}

