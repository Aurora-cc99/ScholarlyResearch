  author = {R. R. Chen and Zhuoyi Huang and Jiajun Chen and Xinhan Lin and Jiahui Pan},
  year = {2026},
  doi = {10.1109/taffc.2026.3712128},
  url = {https://doi.org/10.1109/taffc.2026.3712128},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：用于跨数据集脑电图情绪识别的黄金式图形对齐},
  abstract = {Electroencephalography (EEG)-based emotion recognition represents a vital branch of affective computing, with broad applications across various domains. However, despite remarkable progress in both subject-dependent and subject-independent paradigms, achieving robust performance across diverse devices, sessions, and subjects (i.e., cross-dataset) remains challenging. Specifically, two major obstacles persist: (1) How to effectively integrate spatio-temporal information to derive truly domain-invariant features, and (2) How to align joint probability distributions across datasets without compromising the underlying emotional semantics. To address these challenges, we propose a novel domain adaptation framework for deeply extracting domain-invariant features. This framework leverages a multi-scale extractor to comprehensively fuse spatio-temporal features and introduces an independent golden-style alignment module after each extraction layer, thereby deriving domain-invariant representations across datasets. Furthermore, the synergistic graph module maximizes the preservation of emotional semantics by aligning the joint probability distributions across domains. To validate the effectiveness, we conducted comprehensive cross-subject and cross-dataset experiments on four benchmark datasets (SEED, SEED-IV, SEED-V, and SEED-VII). The results demonstrate that our approach consistently surpasses state-of-the-art methods across diverse evaluation protocols, confirming its robustness a},
}

