  annotation = {中文辅助译名：具有社会影响力的分层狄利克雷过程},
}

@misc{xuanjing_huang_dadd3698c5ee6e6a,
  title = {Task-oriented Dialogue System for Automatic Diagnosis},
  author = {Ting Chen and Xuanjing Huang and Baolin Peng and Xiangying Dai and Huaixiao Tou and Zhongyu Wei and Qianlong Liu and Kam-Fai Wong},
