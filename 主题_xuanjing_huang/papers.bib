@misc{xuanjing_huang_1fde987c7e529e07,
  title = {Learning to Rank Answers for Definitional Question Answering},
  author = {Shiyu Wu and Xuanjing Huang and Xipeng Qiu and Junkuo Cao},
  year = {2015},
  doi = {10.1007/978-3-319-25816-4_26},
  url = {https://doi.org/10.1007/978-3-319-25816-4_26},
  howpublished = {CCL},
  annotation = {中文辅助译名：学习对定义问答的答案进行排名},
  abstract = {In definitional question answering (QA), it is essential to rank the candidate answers. In this paper, we propose an online learning algorithm, which dynamically construct the supervisor to reduce the adverse effects of the large number of bad answers and noisy data. We compare our method with two state-of-the-art definitional QA systems and two ranking algorithms, and the experimental results show our method outperforms the others. These keywords were added by machine and not by the authors. This process is experimental and the keywords may be updated as the learning algorithm improves.},
}

@misc{xuanjing_huang_62f544ca8304e206,
  title = {Convolutional Neural Tensor Network Architecture for Community-Based Question Answering},
  author = {Xuanjing Huang and Xipeng Qiu},
  year = {2015},
  url = {https://www.ijcai.org/Proceedings/15/Papers/188.pdf},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：用于基于社区的问答的卷积神经张量网络架构},
  abstract = {Retrieving similar questions is very important in community-based question answering. A major challenge is the lexical gap in sentence matching. In this paper, we propose a convolutional neural tensor network architecture to encode the sentences in semantic space and model their interactions with a tensor layer. Our model integrates sentence modeling and semantic matching into a single model, which can not only capture the useful information with convolutional and pooling layers, but also learn the matching metrics between the question and its answer. Besides, our model is a general architecture, with no need for the other knowledge such as lexical or syntactic analysis. The experimental results shows that our method outperforms the other methods on two matching tasks.},
}

@misc{xuanjing_huang_d9069071d1d1c6b8,
  title = {Multi-Timescale Long Short-Term Memory Neural Network for Modelling Sentences and Documents},
  author = {Xinchi Chen and Xuanjing Huang and Shiyu Wu and Pengfei Liu and Xipeng Qiu},
  year = {2015},
  doi = {10.18653/V1/D15-1280},
  url = {https://doi.org/10.18653/V1/D15-1280},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：用于句子和文档建模的多时间尺度长短期记忆神经网络},
  abstract = {Neural network based methods have obtained great progress on a variety of natural language processing tasks.However, it is still a challenge task to model long texts, such as sentences and documents.In this paper, we propose a multi-timescale long short-term memory (MT-LSTM) neural network to model long texts.MT-LSTM partitions the hidden states of the standard LSTM into several groups.Each group is activated at different time periods.Thus, MT-LSTM can model very long documents as well as short sentences.Experiments on four benchmark datasets show that our model outperforms the other neural models in text classification task.},
}

@misc{xuanjing_huang_2bc54de882cd5b08,
  title = {Gated Recursive Neural Network for Chinese Word Segmentation},
