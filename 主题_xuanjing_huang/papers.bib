@misc{xuanjing_huang_9d77c1d7b0ae64f1,
  title = {Secrets of RLHF in Large Language Models Part II: Reward Modeling},
  author = {Xuanjing Huang and Chenyu Shi and Hang Yan and Enyu Zhou and Xiaoran Fan and Yuhao Zhou and Tao Gui and Zuxuan Wu and Zhan Chen and Rui Zheng and Senjie Jin and Zhiheng Xi and Caishuang Huang and Yu-Gang Jiang and Songyang Gao and Binghai Wang and Shihan Dou and Tao Ji and Wei Shen and Jun Zhao and Yan Liu and Nuo Xu and Lu Chen and Lixing Shen and Qi Zhang and Xipeng Qiu and Xiao Wang},
  year = {2024},
  doi = {10.48550/ARXIV.2401.06080},
