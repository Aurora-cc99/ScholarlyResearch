}

@misc{xuanjing_huang_29f7e4666df1374c,
  title = {A Re-ranking Model for Dependency Parser with Recursive Convolutional Neural Network},
  author = {Xinchi Chen and Xuanjing Huang and Xipeng Qiu and Chenxi Zhu},
  year = {2015},
