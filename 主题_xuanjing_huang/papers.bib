  abstract = {Xinchi Chen, Xipeng Qiu, Chenxi Zhu, Xuanjing Huang. Proceedings of the 53rd Annual Meeting of the Association for Computational Linguistics and the 7th International Joint Conference on Natural Language Processing (Volume 1: Long Papers). 2015.},
}

@misc{xuanjing_huang_5bea5b6ad3f66ce2,
  title = {Long Short-Term Memory Neural Networks for Chinese Word Segmentation},
  author = {Xuanjing Huang and Xinchi Chen and Pengfei Liu and Chenxi Zhu and Xipeng Qiu},
  year = {2015},
  doi = {10.18653/V1/D15-1141},
  url = {https://doi.org/10.18653/V1/D15-1141},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：用于中文分词的长短期记忆神经网络},
  abstract = {Currently most of state-of-the-art methods for Chinese word segmentation are based on supervised learning, whose features are mostly extracted from a local context.These methods cannot utilize the long distance information which is also crucial for word segmentation.In this paper, we propose a novel neural network model for Chinese word segmentation, which adopts the long short-term memory (LSTM) neural network to keep the previous important information in memory cell and avoids the limit of window size of local context.Experiments on PKU, MSRA and CTB6 benchmark datasets show that our model outperforms the previous neural network models and state-of-the-art methods.},
}

@misc{xuanjing_huang_acd9a1b6f592aeb7,
  title = {Overview of the NLPCC 2015 Shared Task: Chinese Word Segmentation and POS Tagging for Micro-blog Texts},
  author = {Shiyu Wu and Liusong Yin and Xuanjing Huang and Xipeng Qiu and Peng Qian},
  year = {2015},
  doi = {10.1007/978-3-319-25207-0_50},
  url = {https://doi.org/10.1007/978-3-319-25207-0_50},
  howpublished = {NLPCC},
  annotation = {中文辅助译名：NLPCC 2015共享任务概述：微博文本的中文分词和词性标注},
  abstract = {In this paper, we give an overview for the shared task at the 4th CCF Conference on Natural Language Processing & Chinese Computing (NLPCC 2015): Chinese word segmentation and part-of-speech (POS) tagging for micro-blog texts. Different with the popular used newswire datasets, the dataset of this shared task consists of the relatively informal micro-texts. The shared task has two sub-tasks: (1) individual Chinese word segmentation and (2) joint Chinese word segmentation and POS Tagging. Each subtask has three tracks to distinguish the systems with different resources. We first introduce the dataset and task, then we characterize the different approaches of the participating systems, report the test results, and provide a overview analysis of these results. An online system is available for open registration and evaluation at http://nlp.fudan.edu.cn/nlpcc2015 .},
}

