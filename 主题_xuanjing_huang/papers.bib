@misc{xuanjing_huang_477143d294bce1c1,
  title = {LLaMA Beyond English: An Empirical Study on Language Capability Transfer},
  author = {Xuanjing Huang and Tao Gui and Luhui Gao and Qi Zhang and Zhihao Zhang and Jun Zhao},
  year = {2024},
