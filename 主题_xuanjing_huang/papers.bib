@misc{xuanjing_huang_beb50c93c393e42a,
  title = {A Comprehensive Survey on Multimodal RAG: All Combinations of Modalities as Input and Output},
  author = {Rui Zhang and Chen Liu and Yixin Su and Ruixuan Li and Xuanjing Huang and Xuelong Li and Philip S. Yu},
  year = {2025},
  doi = {10.36227/techrxiv.176341513.38473003/v2},
  url = {https://doi.org/10.36227/techrxiv.176341513.38473003/v2},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：多模态 RAG 的综合综述：作为输入和输出的所有模态组合},
  abstract = {Retrieval-Augmented Generation (RAG) is an important way to mitigate hallucination in large language models (LLMs) by integrating relevant external knowledge. With the advance of multimodal LLMs, retrieval augmentation now extends not only textual tasks but also multimodal ones. In this paper, we conduct a comprehensive survey of the most recent work on multimodal RAG (MM-RAG) in the sense that it has a full coverage of almost all the combinations of modalities as input and output, whereas existing survey papers typically focus on one or two modalities. Based on different input-output modality combinations, we present a taxonomy of MM-RAG methods which gives us a much clearer picture of their key technical components. Facilitated by such a taxonomy, we identify four essential stages of the workflow of MM-RAG, summarize common approaches to each stage, and discuss optimization strategies for each modality. To provide a holistic understanding and practical guidance for building MM-RAG systems, we also discuss training strategies and evaluation methods of MM-RAG. Finally, we discuss various MM-RAG applications and future directions. Updated information related to this survey can be found at https://github.com/INTREBID/Awesome-MM-RAG.},
}

