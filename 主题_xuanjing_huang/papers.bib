@misc{xuanjing_huang_0f8a4e1820bbeb1b,
  title = {Memory in the Age of AI Agents},
  author = {Yixin Liu and Boyang Liu and Zhicheng Dou and Junhao Wang and Jiahao Huo and Tao Gui and Zewen Hu and Yu Wang and Jiaxin Guo and Yan Zhang and Dawei Cheng and Kun Wang and Xuanjing Huang and Guibin Zhang and Xuanbo Fan and Shihan Dou and Senjie Jin and Wangchunshu Zhou and Zhiheng Xi and Qiankun Li and Zhenfei Yin and Zhenrong Cheng and Zhongxiang Sun and Yu-Gang Jiang and Jiongnan Liu and Boci Peng and Yanbin Yin and Yuyang Hu and Fangyi Zhu and Jiejun Tan and Yue Liao and Shichun Liu and Zhenhong Zhou and Yanwei Yue and Xinlei Yu and Hao Sun and Shirui Pan and Shuicheng Yan and Qi Zhang and Honglin Guo and Yuwei Niu and Jiahang Lin and Xiaobin Hu and Ji-Rong Wen and Philip Torr and Yutao Zhu and Zeyu Zhang},
  year = {2025},
  doi = {10.48550/ARXIV.2512.13564},
  url = {https://doi.org/10.48550/ARXIV.2512.13564},
  howpublished = {CoRR},
  annotation = {中文辅助译名：人工智能代理时代的记忆},
  abstract = {Memory has emerged, and will continue to remain, a core capability of foundation model-based agents. As research on agent memory rapidly expands and attracts unprecedented attention, the field has also become increasingly fragmented. Existing works that fall under the umbrella of agent memory often differ substantially in their motivations, implementations, and evaluation protocols, while the proliferation of loosely defined memory terminologies has further obscured conceptual clarity. Traditional taxonomies such as long/short-term memory have proven insufficient to capture the diversity of contemporary agent memory systems. This work aims to provide an up-to-date landscape of current agent memory research. We begin by clearly delineating the scope of agent memory and distinguishing it from related concepts such as LLM memory, retrieval augmented generation (RAG), and context engineering. We then examine agent memory through the unified lenses of forms, functions, and dynamics. From the perspective of forms, we identify three dominant realizations of agent memory, namely token-level, parametric, and latent memory. From the perspective of functions, we propose a finer-grained taxonomy that distinguishes factual, experiential, and working memory. From the perspective of dynamics, we analyze how memory is formed, evolved, and retrieved over time. To support practical development, we compile a comprehensive summary of memory benchmarks and open-source frameworks. Beyond consolida},
}

