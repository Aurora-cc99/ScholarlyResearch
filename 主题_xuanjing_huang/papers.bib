@misc{xuanjing_huang_43914c923d0e75ba,
  title = {Template-free Prompt Tuning for Few-shot NER},
  author = {Xin Zhou and Xuanjing Huang and Tao Gui and Ruotian Ma and Yiding Tan and Linyang Li and Qi Zhang},
