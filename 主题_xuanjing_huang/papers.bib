@misc{xuanjing_huang_1cf2e06f8ed5cf8e,
  title = {From Individual to Society: A Survey on Social Simulation Driven by Large Language Model-based Agents},
  author = {Xuanjing Huang and Jie Zhou and Jiayu Lin and Jingcong Liang and Xinnong Zhang and Xuanwen Ding and Xinyi Mou and Zhongyu Wei and Liang Wang and Libo Sun and Qi He},
  year = {2026},
  doi = {10.1145/3800683},
  url = {https://doi.org/10.1145/3800683},
  howpublished = {ACM Comput. Surv.},
  annotation = {中文辅助译名：从个人到社会：基于大型语言模型的智能体驱动的社会模拟调查},
  abstract = {Traditional sociological research often relies on human participation, which, though effective, is expensive, challenging to scale, and with ethical concerns. Recent advancements in large language models (LLMs) highlight their potential to simulate human behavior, enabling the replication of individual responses and facilitating studies on many interdisciplinary studies. In this article, we conduct a comprehensive survey of this field, illustrating the recent progress in simulation driven by LLM-empowered agents. We categorize the simulations into three types: (1) Individual Simulation , which mimics specific individuals or demographic groups; (2) Scenario Simulation , where multiple agents collaborate to achieve goals within specific contexts; and (3) Society Simulation , which models interactions within agent societies to reflect the complexity and variety of real-world dynamics. These simulations follow a progression, ranging from detailed individual modeling to large-scale societal phenomena. We provide a detailed discussion of each simulation type, including the architecture or key components of the simulation, the classification of objectives or scenarios, and the evaluation method. Afterward, we summarize commonly used datasets, benchmarks and tools. Finally, we discuss the risks and challenges across these three types of simulation. A repository for the related sources is at https://github.com/FudanDISC/SocialAgent .},
}

