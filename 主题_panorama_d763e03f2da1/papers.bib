@misc{panorama_d763e03f2da1_5c9232d08c2c28d0,
  title = {Rethinking Cross-Modal Attention for Visual Token Pruning in Multimodal LVLMs},
  author = {Diego Weng Qiu and Lin Shang},
  year = {2026},
  doi = {10.18653/2026.aacl-long.131},
  url = {https://doi.org/10.18653/2026.aacl-long.131},
  howpublished = {International Joint Conference on Natural Language Processing and Conference of the Asia-Pacific Chapter of the Association for Computational Linguistics (IJCNLP-AACL)},
  annotation = {中文辅助译名：重新思考多模态 LVLM 中视觉标记修剪的跨模态注意力},
  abstract = {Recent studies challenge the reliability of crossmodal attention mechanisms as an indicator for visual token pruning in Large Vision-Language Models (LVLMs).In this work, we demonstrate that such negative conclusions can be substantially influenced by an overlooked phenomenon termed task-bound coupling, wherein cross-modal attention patterns become entangled with task-specific prompts.Through controlled configurations that decouple visual inputs from downstream queries, We find attention-ranked tokens have causal task relevance, with attention distributions maintaining relative consistency across evaluated settings.Concurrently, we identify an empirical scaling phenomenon which we term Attention Fidelity Decay, where the downstream effectiveness of attention-based token selection declines in higher-capacity models or advanced architectures.Motivated by these insights, we introduce TAP-LLaVA, a simple trainingfree framework that leverages localized taskagnostic attention for efficient, reusable visual token pruning across multi-turn sessions.Our approach achieves competitive downstream performance while substantially lowering computational overhead.This suggests that attention can provide a reliable structural prior at moderate model scales when isolated from textual confounders.},
}

