@misc{panorama_d763e03f2da1_58b3410b61da9944,
  title = {Multi-task Learning with Bidirectional Language Models for Text Classification},
  author = {Qi Yang and Lin Shang},
  year = {2019},
  doi = {10.1109/IJCNN.2019.8852388},
  url = {https://doi.org/10.1109/IJCNN.2019.8852388},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：用于文本分类的双向语言模型的多任务学习},
  abstract = {Multi-task learning is an effective approach to extract task-invariant features by leveraging potential information among related tasks, which improves the performance of a single task. Most existing work simply divides the whole model into shared and private spaces. Unfortunately, there is no explicit mechanism to prevent the two spaces from merging information from each other. As a result, the shared space may be mixed with task-specific features, while the private space may extract some task-invariant features. To alleviate the problem mentioned, in this paper, we propose a bidirectional language models based multi-task learning method for text classification. More specifically, we add language modelling as an auxiliary task to the private part, aiming to enhance its ability to extract task-specific features. In addition, to promote the shared part to learn common features, a loss constraint via uniform label distribution is introduced to the shared part. Finally, put task-specific features and taskinvariant features together in a weighted addition way to form the final representation, and it is then fed to the corresponding softmax layer. We do experiments on the FDU-MTL dataset which consists of 16 different text classification tasks. The experimental results show that our approach outperforms other typical methods.},
}

@misc{panorama_d763e03f2da1_dbbe29301346a2e1,
  title = {RAN-PSO: Random Apollonian Network embedded Partical Swarm Optimization Method},
  author = {Yiming Li and Aiqing He and Chengyan Wang and Lin Shang},
  year = {2019},
  doi = {10.1109/SSCI44817.2019.9002799},
  url = {https://doi.org/10.1109/SSCI44817.2019.9002799},
  howpublished = {SSCI},
  annotation = {中文辅助译名：RAN-PSO：随机阿波罗网络嵌入局部群优化方法},
  abstract = {Particle Swarm Optimization (PSO) has been developed as an important branch of Evolutionary Computation (EC). PSO algorithm originates from the simulation of the social community's intelligent behavior, in which the swarm's topology has the great effect on the optimization performance. Therefore, this paper proposes the PSO approach embedded with the Random Apollonian Network (RAN) model, which improves the topology and updates formula to form a new RAN-PSO optimization method. We test the RAN-PSO algorithm performance on nine typical test functions. Experimental results show that RAN-PSO can achieve higher accuracy with less time in practical optimization problems. In comparison with the standard PSO (Linearly Decreasing Weight Particle Swarm Optimization) and several other PSOs with different topologies, RAN-PSO is more stable and converges faster on our test sets. It can obtain a satisfactory extremum for the target function.},
}

