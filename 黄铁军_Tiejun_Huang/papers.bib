}

@misc{huang_tiejun_d88d58aae2d3,
  title = {Modeling The Detection Capability Of High-Speed Spiking Cameras},
  author = {Junwei Zhao and Zhaofei Yu and Lei Ma and Ziluo Ding and Shiliang Zhang and Yonghong Tian and Tiejun Huang},
  year = {2022},
  doi = {10.1109/ICASSP43922.2022.9747018},
  url = {https://doi.org/10.1109/ICASSP43922.2022.9747018},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：对高速脉冲相机的检测能力进行建模。},
  abstract = {The novel working principle enables spiking cameras to capture high-speed moving objects. However, the applications of spiking cameras can be affected by many factors, such as brightness intensity, detectable distance, and the maximum speed of moving targets. Improper settings such as weak ambient brightness and too short object-camera distance, will lead to failure in the application of such cameras. To address the issue, this paper proposes a modeling algorithm that studies the detection capability of spiking cameras. The algorithm deduces the maximum detectable speed of spiking cameras corresponding to different scenario settings (e.g., brightness intensity, camera lens, and object-camera distance) based on the basic technical parameters of cameras (e.g., pixel size, spatial and temporal resolution). Thereby, the proper camera settings for various applications can be determined. Extensive experiments verify the effectiveness of the modeling algorithm. To our best knowledge, it is the first work to investigate the detection capability of spiking cameras.},
}

@misc{huang_tiejun_88e159ca85c3,
  title = {Entity Divider with Language Grounding in Multi-Agent Reinforcement Learning},
  author = {Ziluo Ding and Wanpeng Zhang and Junpeng Yue and Xiangjun Wang and Tiejun Huang and Zongqing Lu},
  year = {2022},
  doi = {10.48550/ARXIV.2210.13942},
  url = {https://doi.org/10.48550/ARXIV.2210.13942},
  howpublished = {CoRR},
  annotation = {中文辅助译名：多智能体强化学习中基于语言锚定的实体划分器},
  abstract = {We investigate the use of natural language to drive the generalization of policies in multi-agent settings. Unlike single-agent settings, the generalization of policies should also consider the influence of other agents. Besides, with the increasing number of entities in multi-agent settings, more agent-entity interactions are needed for language grounding, and the enormous search space could impede the learning process. Moreover, given a simple general instruction,e.g., beating all enemies, agents are required to decompose it into multiple subgoals and figure out the right one to focus on. Inspired by previous work, we try to address these issues at the entity level and propose a novel framework for language grounding in multi-agent reinforcement learning, entity divider (EnDi). EnDi enables agents to independently learn subgoal division at the entity level and act in the environment based on the associated entities. The subgoal division is regularized by opponent modeling to avoid subgoal conflicts and promote coordinated strategies. Empirically, EnDi demonstrates the strong generalization ability to unseen games with new dynamics and expresses the superiority over existing methods.},
}

