@misc{huang_tiejun_c5f0df1ce378,
  title = {Implicit neural image field for biological microscopy image compression},
  author = {Gaole Dai and Rongyu Zhang and Qingpo Wuwu and Cheng-Ching Tseng and Yu Zhou and Shaokang Wang and Siyuan Qian and Ming Lu and Ali Ata Tuz and Matthias Gunzer and Tiejun Huang and Jianxu Chen and Shanghang Zhang},
  year = {2025},
  doi = {10.1038/S43588-025-00889-4},
  url = {https://doi.org/10.1038/S43588-025-00889-4},
  howpublished = {Nat. Comput. Sci.},
  annotation = {中文辅助译名：用于生物显微镜图像压缩的隐式神经图像场。},
  abstract = {The rapid pace of innovation in biological microscopy has produced increasingly large images, putting pressure on data storage and impeding efficient data sharing, management and visualization. This trend necessitates new, efficient compression solutions, as traditional coder-decoder methods often struggle with the diversity of bioimages, leading to suboptimal results. Here we show an adaptive compression workflow based on implicit neural representation that addresses these challenges. Our approach enables application-specific compression, supports images of varying dimensionality and allows arbitrary pixel-wise decompression. On a wide range of real-world microscopy images, we demonstrate that our workflow achieves high, controllable compression ratios while preserving the critical details necessary for downstream scientific analysis.},
}

@misc{huang_tiejun_943add7362e8,
  title = {Inter-event Interval Microscopy for Event Cameras},
  author = {Changqing Su and Yanqin Chen and Zihan Lin and Zhen Cheng and You Zhou and Bo Xiong and Zhaofei Yu and Tie-Jun Huang},
  year = {2025},
  doi = {10.48550/ARXIV.2504.04924},
  url = {https://doi.org/10.48550/ARXIV.2504.04924},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于事件相机的事件间间隔显微镜。},
  abstract = {Event cameras detect intensity changes rather than absolute intensity, recording variations as a stream of “event.” Intensity reconstruction from these sparse events remains a significant challenge. Previous approaches focused on transforming motion-induced events into videos or achieving intensity imaging for static scenes through modulation devices at the acquisition end. In this paper, we present inter-event interval microscopy (IEIM), a paradigm-shifting technique enabling static and dynamic fluorescence imaging through photon flux-to-temporal encoding, which integrates a pulse-light modulation device into a microscope equipped with an event camera. We also develop the inter-event interval (IEI) reconstruction algorithm for IEIM, which quantifies time intervals between consecutive events at each pixel. With a fixed threshold in the event camera, this time interval can directly encode intensity. The integration of pulse modulation enables IEIM to achieve static and dynamic fluorescence imaging with a fixed event camera. We evaluate the state-of-the-art performance of IEIM using simulated and real-world data under both static and dynamic scenes. We also demonstrate that IEIM achieves high-dynamic, high-speed imaging at 800 Hz in mimetic dynamic mice brain tissues. Furthermore, we show that IEIM enables imaging the movements of in vivo freshwater euglenae at 500 Hz.},
}

