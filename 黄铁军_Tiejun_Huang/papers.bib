  title = {Learn to Enhance Sparse Spike Streams},
  author = {Liwen Hu and Yijia Guo and Mianzhi Liu and Yiming Fan and Rui Ma and Shengbo Chen and Lei Ma and Tiejun Huang},
  year = {2026},
  doi = {10.1109/TPAMI.2026.3653768},
  url = {https://doi.org/10.1109/TPAMI.2026.3653768},
  howpublished = {IEEE Trans. Pattern Anal. Mach. Intell.},
  annotation = {中文辅助译名：学习增强稀疏脉冲流},
  abstract = {High-speed vision tasks have long been a challenge in computer vision. Recently, the spike camera has shown great potential in these tasks due to its high temporal resolution. Unlike traditional cameras, it emits asynchronous spike signals to capture visual information. However, under low-light conditions, spike signals become highly sparse, and the sparse spike stream severely hinders the effectiveness of existing spike-based methods in high-speed scenarios. To address this challenge, we introduce SS2DS, the first deep learning framework that enhances sparse spike streams into dense spike streams. SS2DS first estimates the spike firing frequency within sparse streams. Subsequently, the spike firing frequency is enhanced by a neural network. Finally, SS2DS decodes the enhanced spike stream from the enhanced spike firing frequency sequence. SS2DS can adjust the temporal distribution of sparse spike streams and improve the performance degradation of existing methods in low-light and high-speed scenarios. To evaluate sparse spike stream enhancement, we construct both synthetic and real sparse spike stream datasets. By comparing the reconstruction results, enhanced spike streams achieve an average improvement of +0.78 MA, -18.42 BRISQUE, and -1.42 NIQE over sparse spike streams. Moreover, the enhanced spike streams also benefit other spike-based vision tasks, such as 3D reconstruction (+1.325 dB PSNR, +0.005 SSIM, and -0.01 LPIPS) and superresolution (+0.63 MA, -13.67 BRISQUE, an},
}

@misc{huang_tiejun_0468047f21cb,
  title = {Icarus's Wings: Disabling MoE Offloading Acceleration via a Universal Hidden Prefix Attack},
  author = {Qichao Ma and Zecheng Hao and Zihao Zheng and Ling Liang and Xing Hu and Zhaofei Yu and Tiejun Huang},
  year = {2026},
  doi = {10.1145/3770743.3804088},
  url = {https://doi.org/10.1145/3770743.3804088},
  howpublished = {DAC},
  annotation = {中文辅助译名：伊卡洛斯之翼:通过通用隐藏前缀攻击禁用 MoE 卸载加速。},
  abstract = {Online LLM inference service demands low latency with tight memory. Mixture of Experts (MoE) meets memory constraints by activating a few Experts, computing active ones on GPUs, and offloading others to CPUs. For latency, acceleration systems utilize Expert caching and prefetching strategies, assuming Experts' temporal locality and predictable prefetch. When these assumptions fail, wrong experts loads inflate latency, enabling Denial-of-Service (DoS). Existing LLM DoS attacks target extending LLMs' generation length, with high attack costs, weak transferability, and lack MoE analysis.},
}

@misc{huang_tiejun_a896a332861b7357,
  title = {Spiking Cross-Modal Hashing for Energy-Efficient Retrieval},
  author = {Zhen Zhang and Xian Zhong and Lei Zhu and Wenxuan Liu and Zhaofei Yu and Tiejun Huang},
  year = {2026},
  doi = {10.1109/tmm.2026.3714314},
  url = {https://doi.org/10.1109/tmm.2026.3714314},
  howpublished = {IEEE Transactions on Multimedia},
  annotation = {中文辅助译名：用于节能检索的尖峰跨模式哈希},
  abstract = {Cross-modal hashing (CMH) techniques achieve high retrieval accuracy while enhancing computational and storage efficiency, making them essential for large-scale multimedia retrieval systems. However, the exponential growth of data has raised serious concerns about energy consumption. Spiking neural networks (SNNs) address this challenge by leveraging event-driven sparse computation and replacing traditional energy-intensive multiply-accumulate operations with energy-efficient additive spike integration. Despite their potential, the use of SNNs in cross- and multi-modal learning remains largely unexplored, particularly in CMH, where challenges persist in spike-based cross-modal fusion, information retention, and semantic alignment. In this work, we proposeSpikeHash, a novel framework that introduces spiking-based feature enhancement and hierarchical fusion mechanisms, enabling spiking signals to comprehensively represent samples and maximize cross-modal synergy. Experiments on three benchmarks demonstrate thatSpikeHashachieves accuracy comparable to state-of-the-art artificial neural networks (ANNs), while reducing energy consumption by up to 9×. This study establishes the first energy-efficient framework for spiking CMH retrieval.},
}

@misc{huang_tiejun_a92aa8017039,
  title = {Brain-Inspired Multimodal Spiking Neural Network for Image-Text Retrieval},
  author = {Xintao Zong and Xian Zhong and Wenxuan Liu and Jianhao Ding and Zhaofei Yu and Tiejun Huang},
  year = {2026},
  doi = {10.48550/ARXIV.2603.26787},
  url = {https://doi.org/10.48550/ARXIV.2603.26787},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于图像文本检索的脑启发多模态脉冲神经网络。},
  abstract = {Spiking neural networks (SNNs) have recently shown strong potential in unimodal visual and textual tasks, yet building a directly trained, low-energy, and high-performance SNN for multimodal applications such as image-text retrieval (ITR) remains highly challenging. Existing artificial neural network (ANN)-based methods often pursue richer unimodal semantics using deeper and more complex architectures, while overlooking cross-modal interaction, retrieval latency, and energy efficiency. To address these limitations, we present a brain-inspired Cross-Modal Spike Fusion network (CMSF) and apply it to ITR for the first time. The proposed spike fusion mechanism integrates unimodal features at the spike level, generating enhanced multimodal representations that act as soft supervisory signals to refine unimodal spike embeddings, effectively mitigating semantic loss within CMSF. Despite requiring only two time steps, CMSF achieves top-tier retrieval accuracy, surpassing state-of-the-art ANN counterparts while maintaining exceptionally low energy consumption and high retrieval speed. This work marks a significant step toward multimodal SNNs, offering a brain-inspired framework that unifies temporal dynamics with cross-modal alignment and provides new insights for future spiking-based multimodal research. The code is available at https://github.com/zxt6174/CMSF.},
}

