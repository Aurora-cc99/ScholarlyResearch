@misc{huang_tiejun_06fe0e0370db,
  title = {Fine-granularity ownership identification of multimedia content components: a mechanism for smart media streaming},
  author = {Luntian Mou and Hao Liu and Hao Ji and Tiejun Huang and Wen Gao},
  year = {2019},
  doi = {10.1109/MIPR.2019.00114},
  url = {https://doi.org/10.1109/MIPR.2019.00114},
  howpublished = {MIPR},
  annotation = {中文辅助译名：多媒体内容组件的细粒度所有权识别:智能媒体流的机制。},
  abstract = {Conventional media streaming methods fall short in content protection because they assume the ownership of a multimedia content is determined and it can be accessed or not as a whole. However, more and more multimedia contents are springing up on the Internet with each being composed of multiple content components bearing possibly different ownerships. In this paper, the authors propose a fine-granularity ownership identification method for enabling the protection of each individual multimedia content component as a critical feature for smart media streaming. Specifically, the ownership of each media content component is first figured out using content fingerprinting techniques, and then is provided in the hierarchical media presentation description of a media content, which leads to separately handling each media content component according to corresponding ownership information at the client. Experiments on large datasets demonstrate the efficacy and efficiency of the proposed method.},
}

@misc{huang_tiejun_30711fc44e9b,
  title = {Guest Editorial Special Issue on IoT on the Move: Enabling Technologies and Driving Applications for Internet of Intelligent Vehicles (IoIV)},
  author = {Liuqing Yang and Xiang Cheng and Mounir Ghogho and Ender Ayanoglu and Tiejun Huang and Nanning Zheng},
  year = {2019},
  doi = {10.1109/JIOT.2019.2896750},
  url = {https://doi.org/10.1109/JIOT.2019.2896750},
  howpublished = {IEEE Internet Things J.},
  annotation = {中文辅助译名：关于移动物联网的客座社论特刊:智能车辆互联网(IoIV)的支持技术和驱动应用。},
  abstract = {The new era of the Internet of Things (IoT) is prompting the evolution of conventional vehicle ad-hoc networks (VANETs) into the Internet of Intelligent Vehicles (IoIV). Different from VANETs, where a vehicle is essentially considered as a node disseminating messages, the emerging IoIV paradigm is expected to regard each vehicle as a smart object equipped with a powerful multisensor platform, unprecedented communication capability, computing units, and Internet protocol (IP)-based connectivity. As such, the vehicles in IoIV are highly efficient in a broad array of vehicular and transportation applications. As a unique subset of general purpose IoT, IoIV can benefit from the existing research on VANET, which lays the foundation toward a more pervasive and ubiquitous communications and networking core that is essential for IoIV. Nevertheless, research in many aspects of IoIV, especially those that are application-driven and data-oriented ones, is still at its infancy.},
}

