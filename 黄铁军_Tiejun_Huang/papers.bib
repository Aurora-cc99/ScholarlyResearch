@misc{huang_tiejun_f897888a926e,
  title = {Annotation Efficient Person Re-Identification with Diverse Cluster-Based Pair Selection},
  author = {Lantian Xue and Yixiong Zou and Peixi Peng and Yonghong Tian and Tiejun Huang},
  year = {2022},
