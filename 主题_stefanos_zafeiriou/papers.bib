  title = {Ear Cartilage Inference for Reconstructive Surgery with Convolutional Mesh Autoencoders},
  author = {Silvia Schievano and David J. Dunaway and Eimear O' Sullivan and Stefanos Zafeiriou and Lara van de Lande and Neil Bulstrode and Antonia Osolos},
