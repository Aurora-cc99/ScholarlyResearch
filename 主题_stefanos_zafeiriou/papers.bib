  howpublished = {Tensors in Image Processing and Computer Vision},
  annotation = {中文辅助译名：非负张量分解算法},
}

@misc{stefanos_zafeiriou_68bdfc9ccac650aa,
  title = {Nonlinear Nonnegative Component Analysis},
  author = {Stefanos Zafeiriou and Maria Petrou},
  year = {2009},
  doi = {10.1109/CVPR.2009.5206584},
  url = {https://doi.org/10.1109/CVPR.2009.5206584},
  howpublished = {CVPR},
  annotation = {中文辅助译名：非线性非负分量分析},
  abstract = {In this paper general solutions for nonlinear nonnegative component analysis for data representation and recognition are proposed. That is, motivated by a combination of the Nonnegative Matrix Factorization (NMF) algorithm and kernel theory, which has lead to an NMF algorithm in a polynomial feature space, we propose a general framework where one can build a nonlinear nonnegative component analysis using kernels, the so-called projected gradient Kernel Nonnegative Matrix Factorization (PGKNMF). In the proposed approach, arbitrary positive kernels can be adopted while at the same time it is ensured that the limit point of the procedure is a stationary point of the optimization problem. Moreover, we propose fixed point algorithms for the special case of Radial Basis Function (RBF) kernels. We demonstrate the power of the proposed methods in face and facial expression recognition applications.},
}

@misc{stefanos_zafeiriou_7410b07d5f3ecbba,
  title = {Novel Multiclass Classifiers Based on the Minimization of the Within-Class Variance},
  author = {Stefanos Zafeiriou and Irene Kotsia and Ioannis Pitas},
  year = {2009},
  doi = {10.1109/TNN.2008.2004376},
  url = {https://doi.org/10.1109/TNN.2008.2004376},
  howpublished = {IEEE Trans. Neural Networks},
  annotation = {中文辅助译名：基于类内方差最小化的新型多类分类器},
  abstract = {In this paper, a novel class of multiclass classifiers inspired by the optimization of Fisher discriminant ratio and the support vector machine (SVM) formulation is introduced. The optimization problem of the so-called minimum within-class variance multiclass classifiers (MWCVMC) is formulated and solved in arbitrary Hilbert spaces, defined by Mercer's kernels, in order to find multiclass decision hyperplanes/surfaces. Afterwards, MWCVMCs are solved using indefinite kernels and dissimilarity measures via pseudo-Euclidean embedding. The power of the proposed approach is first demonstrated in the facial expression recognition of the seven basic facial expressions (i.e., anger, disgust, fear, happiness, sadness, and surprise plus the neutral state) problem in the presence of partial facial occlusion by using a pseudo-Euclidean embedding of Hausdorff distances and the MWCVMC. The experiments indicated a recognition accuracy rate achieved up to 99%. The MWCVMC classifiers are also applied to face recognition and other classification problems using Mercer's kernels.},
}

@misc{stefanos_zafeiriou_f1f9ddfc0cba0230,
  title = {Discriminant Nonnegative Tensor Factorization Algorithms},
  author = {Stefanos Zafeiriou},
  year = {2009},
  doi = {10.1109/TNN.2008.2005293},
  url = {https://doi.org/10.1109/TNN.2008.2005293},
  howpublished = {IEEE Trans. Neural Networks},
  annotation = {中文辅助译名：判别式非负张量分解算法},
  abstract = {Nonnegative matrix factorization (NMF) has proven to be very successful for image analysis, especially for object representation and recognition. NMF requires the object tensor (with valence more than one) to be vectorized. This procedure may result in information loss since the local object structure is lost due to vectorization. Recently, in order to remedy this disadvantage of NMF methods, nonnegative tensor factorizations (NTF) algorithms that can be applied directly to the tensor representation of object collections have been introduced. In this paper, we propose a series of unsupervised and supervised NTF methods. That is, we extend several NMF methods using arbitrary valence tensors. Moreover, by incorporating discriminant constraints inside the NTF decompositions, we present a series of discriminant NTF methods. The proposed approaches are tested for face verification and facial expression recognition, where it is shown that they outperform other popular subspace approaches.},
}

