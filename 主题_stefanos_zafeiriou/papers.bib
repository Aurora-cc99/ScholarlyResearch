@misc{stefanos_zafeiriou_b9bc723bb21b46e2,
  title = {From Emotions to Violence: Multimodal Fine-Grained Behavior Analysis at the 9th ABAW},
  author = {Dimitris Kollias and Guanyu Hu and Damith Chamalke Senadeera and Stefanos Zafeiriou and Jianian Zheng and Irene Kotsia and Chunchang Shao and Gregory Slabaugh and Kaushal K. K. Yadav},
  year = {2025},
  doi = {10.1109/ICCVW69036.2025.00006},
  url = {https://doi.org/10.1109/ICCVW69036.2025.00006},
  howpublished = {ICCVW},
  annotation = {中文辅助译名：从情绪到暴力：第九届 ABAW 的多模态细粒度行为分析},
  abstract = {The 9th Affective and Behavior Analysis in-the-Wild (ABAW) Workshop, held in conjunction with ICCV 2025, advances research on modeling, analyzing and understanding human affect and behavior under real-world, unconstrained conditions. Continuing its dual format of competition and paper tracks, the workshop featured three core challenges: Valence-Arousal Estimation, Compound Expression Recognition and Fine-Grained Violence Detection, each designed to benchmark state-of-the-art methods on large-scale in-the-wild datasets. In parallel, the paper track showcased diverse contributions spanning multimodal affect recognition, human-robot interaction, novel datasets, data-centric methodologies, behavior understanding and anomaly detection. Together, these contributions highlight progress in multimodal and multitask learning, cross-domain generalization, privacy-preserving analysis and data efficiency. Building on the success of previous editions, the 9th ABAW Workshop not only provides rigorous benchmarks and curated resources but also strengthens interdisciplinary collaboration across computer vision, AI, psychology, and human-computer interaction, thereby shaping the next generation of human-centered affective computing technologies},
}

@misc{stefanos_zafeiriou_a269a9dcbaaeaa74,
  title = {Are Large Brainwave Foundation Models Capable Yet ? Insights from Fine-Tuning},
  author = {Nikolaos A. Laskaris and Dimitrios A. Adamos and Stefanos Zafeiriou and Na Lee and Yannis Panagakis and Konstantinos Barmpas},
  year = {2025},
  doi = {10.48550/arxiv.2507.01196},
  url = {http://arxiv.org/abs/2507.01196},
  howpublished = {ICML},
  annotation = {中文辅助译名：大型脑电波基础模型有能力吗？微调的见解},
  abstract = {Foundation Models have demonstrated significant success across various domains in Artificial Intelligence (AI), yet their capabilities for brainwave modeling remain unclear. In this paper, we comprehensively evaluate current Large Brainwave Foundation Models (LBMs) through systematic fine-tuning experiments across multiple Brain-Computer Interface (BCI) benchmark tasks, including memory tasks and sleep stage classification. Our extensive analysis shows that state-of-the-art LBMs achieve only marginal improvements (0.9%-1.2%) over traditional deep architectures while requiring significantly more parameters (millions vs thousands), raising important questions about their efficiency and applicability in BCI contexts. Moreover, through detailed ablation studies and Low-Rank Adaptation (LoRA), we significantly reduce trainable parameters without performance degradation, while demonstrating that architectural and training inefficiencies limit LBMs' current capabilities. Our experiments span both full model fine-tuning and parameter-efficient adaptation techniques, providing insights into optimal training strategies for BCI applications. We pioneer the application of LoRA to LBMs, revealing that performance benefits generally emerge when adapting multiple neural network components simultaneously. These findings highlight the critical need for domain-specific development strategies to advance LBMs, suggesting that current architectures may require redesign to fully leverage the poten},
}

@misc{stefanos_zafeiriou_f062ae047fa12910,
  title = {Large Learning Rates Simultaneously Achieve Robustness to Spurious Correlations and Compressibility},
  author = {Tolga Birdal and Melih Barsbey and Stefanos Zafeiriou and Lucas Prieto},
  year = {2025},
  doi = {10.1109/ICCV51701.2025.00199},
  url = {https://doi.org/10.1109/ICCV51701.2025.00199},
  howpublished = {ICCV},
  annotation = {中文辅助译名：大学习率同时实现对虚假相关性和可压缩性的鲁棒性},
  abstract = {Robustness and resource-efficiency are two highly desirable properties for modern machine learning models. However, achieving them jointly remains a challenge. In this paper, we identify high learning rates as a facilitator for simultaneously achieving robustness to spurious correlations and network compressibility. We demonstrate that large learning rates also produce desirable representation properties such as invariant feature utilization, class separation, and activation sparsity. Our findings indicate that large learning rates compare favorably to other hyperparameters and regularization methods, in consistently satisfying these properties in tandem. In addition to demonstrating the positive effect of large learning rates across diverse spurious correlation datasets, models, and optimizers, we also present strong evidence that the previously documented success of large learning rates in standard classification tasks is related to addressing hidden/rare spurious correlations in the training dataset. Our investigation of the mechanisms underlying this phenomenon reveals the importance of confident mispredictions of bias-conflicting samples under large learning rates.},
}

