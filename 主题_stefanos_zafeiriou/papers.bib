@misc{stefanos_zafeiriou_b44547007c82763e,
  title = {DeepFaceFlow: In-the-Wild Dense 3D Facial Motion Estimation},
  author = {Anastasios Roussos and Mohammad Rami Koujan and Stefanos Zafeiriou},
  year = {2020},
  doi = {10.1109/CVPR42600.2020.00665},
  url = {https://doi.org/10.1109/CVPR42600.2020.00665},
  howpublished = {CVPR},
  annotation = {中文辅助译名：DeepFaceFlow：野外密集 3D 面部运动估计},
  abstract = {Dense 3D facial motion capture from only monocular in-the-wild pairs of RGB images is a highly challenging problem with numerous applications, ranging from facial expression recognition to facial reenactment. In this work, we propose DeepFaceFlow, a robust, fast, and highly-accurate framework for the dense estimation of 3D non-rigid facial flow between pairs of monocular images. Our DeepFaceFlow framework was trained and tested on two very large-scale facial video datasets, one of them of our own collection and annotation, with the aid of occlusion-aware and 3D-based loss function. We conduct comprehensive experiments probing different aspects of our approach and demonstrating its improved performance against state-of-the-art flow and 3D reconstruction methods. Furthermore, we incorporate our framework in a full-head state-of-the-art facial video synthesis method and demonstrate the ability of our method in better representing and capturing the facial dynamics, resulting in a highly-realistic facial video synthesis. Given registered pairs of images, our framework generates 3D flow maps at 60 fps.},
}

@misc{stefanos_zafeiriou_3f8ca76f9fee2c13,
  title = {Head2Head: Video-based Neural Head Synthesis},
  author = {Anastasios Roussos and Stefanos Zafeiriou and Mohammad Rami Koujan and Michail C. Doukas},
  year = {2020},
  doi = {10.1109/FG47880.2020.00048},
  url = {https://doi.org/10.1109/FG47880.2020.00048},
  howpublished = {FG},
  annotation = {中文辅助译名：Head2Head：基于视频的神经头部合成},
  abstract = {In this paper, we propose a novel machine learning architecture for facial reenactment. In particular, contrary to the model-based approaches or recent frame-based methods that use Deep Convolutional Neural Networks (DCNNs) to generate individual frames, we propose a novel method that (a) exploits the special structure of facial motion (paying particular attention to mouth motion) and (b) enforces temporal consistency. We demonstrate that the proposed method can transfer facial expressions, pose and gaze of a source actor to a target video in a photo-realistic fashion more accurately than state-of-the-art methods.},
}

@misc{stefanos_zafeiriou_c62fde00c779c900,
  title = {HeadGAN: Video-and-Audio-Driven Talking Head Synthesis},
  author = {Viktoriia Sharmanska and Michail C. Doukas and Stefanos Zafeiriou},
  year = {2020},
  doi = {10.48550/ARXIV.2012.08261},
  url = {https://doi.org/10.48550/ARXIV.2012.08261},
  howpublished = {CoRR},
  annotation = {中文辅助译名：HeadGAN：视频和音频驱动的头部说话合成},
  abstract = {Recent attempts to solve the problem of talking head synthesis using a single reference image have shown promising results. However, most of them fail to meet the identity preservation problem, or perform poorly in terms of photo-realism, especially in extreme head poses. We propose HeadGAN, a novel reenactment approach that conditions synthesis on 3D face representations, which can be extracted from any driving video and adapted to the facial geometry of any source. We improve the plausibility of mouth movements, by utilising audio features as a complementary input to the Generator. Quantitative and qualitative experiments demonstrate the merits of our approach.},
}

@misc{stefanos_zafeiriou_c2f9f4f916f7bb1e,
  title = {P-nets: Deep Polynomial Neural Networks},
  author = {Giorgos Bouritsas and Jiankang Deng and Stylianos Moschoglou and Stefanos Zafeiriou and Yannis Panagakis and Grigorios Chrysos},
  year = {2020},
  doi = {10.1109/CVPR42600.2020.00735},
  url = {https://doi.org/10.1109/CVPR42600.2020.00735},
  howpublished = {CVPR},
  annotation = {中文辅助译名：P-nets：深度多项式神经网络},
  abstract = {Deep Convolutional Neural Networks (DCNNs) is currently the method of choice both for generative, as well as for discriminative learning in computer vision and machine learning. The success of DCNNs can be attributed to the careful selection of their building blocks (e.g., residual blocks, rectifiers, sophisticated normalization schemes, to mention but a few). In this paper, we propose Π-Nets, a new class of DCNNs. Π-Nets are polynomial neural networks, i.e., the output is a high-order polynomial of the input. Π-Nets can be implemented using special kind of skip connections and their parameters can be represented via high-order tensors. We empirically demonstrate that Π-Nets have better representation power than standard DCNNs and they even produce good results without the use of non-linear activation functions in a large battery of tasks and signals, i.e., images, graphs, and audio. When used in conjunction with activation functions, Π-Nets produce state-of-the-art results in challenging tasks, such as image generation. Lastly, our framework elucidates why recent generative models, such as StyleGAN, improve upon their predecessors, e.g., ProGAN.},
}

