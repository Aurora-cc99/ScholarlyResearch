@misc{panorama_0a5c09b51d11_e5be58395928337f,
  title = {Single-cell transcriptomic analysis of the tumor ecosystem of adenoid cystic carcinoma},
  author = {Quanquan Lin and Zhanjie Fang and Jinlong Sun and Fei Chen and Yipeng Ren and Zhenhong Fu and Sefei Yang and Lin Feng and Feng Wang and Zhigang Song and Wei Chen and Wenjun Yu and Chen Wang and Yixin Shi and Liang Yue and Haizhong Zhang and Hongzhu Qu and Xiangdong Fang and Qing Xi},
  year = {2022},
  doi = {10.3389/fonc.2022.1063477},
  url = {https://doi.org/10.3389/fonc.2022.1063477},
  howpublished = {Frontiers in Oncology},
  annotation = {中文辅助译名：腺样囊性癌肿瘤生态系统的单细胞转录组分析},
  abstract = {Adenoid cystic carcinoma (ACC) is a malignant tumor that originates from exocrine gland epithelial cells. We profiled the transcriptomes of 49,948 cells from paracarcinoma and carcinoma tissues of three patients using single-cell RNA sequencing. Three main types of the epithelial cells were identified into myoepithelial-like cells, intercalated duct-like cells, and duct-like cells by marker genes. And part of intercalated duct-like cells with special copy number variations which altered with MYB family gene and EN1 transcriptomes were identified as premalignant cells. Developmental pseudo-time analysis showed that the premalignant cells eventually transformed into malignant cells. Furthermore, MYB and MYBL1 were found to belong to two different gene modules and were expressed in a mutually exclusive manner. The two gene modules drove ACC progression into different directions. Our findings provide novel evidence to explain the high recurrence rate of ACC and its characteristic biological behavior.},
}

