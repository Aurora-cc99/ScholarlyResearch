@misc{panorama_0a5c09b51d11_2cd6b29a591793ac,
  title = {Machine vision system design for multispectral cameras},
  author = {Kangsheng Wang and 福建师范大学 光电与信息工程学院 医学光电科学与技术教育部重点实验室 福建省光子技术重点实验室，福建 福州 350007 and Lin Feng and XIE Zhongxin and Lin Li-yu and LIN Junjie and Sijia Li and Wei‐Min Chen},
