@misc{panorama_0a5c09b51d11_6442a6ab44dbe932,
  title = {Depth-UDiff: A Depth-Prior Diffusion Model for Underwater Image Enhancement},
  author = {Zhixiong Huang and Yining Wang and Hengshuai Cui and Xinying Wang and Haoran Gao and Lin Feng and Jingchun Zhou},
  year = {2026},
  doi = {10.1109/tcsvt.2026.3748637},
  url = {https://doi.org/10.1109/tcsvt.2026.3748637},
  howpublished = {IEEE Transactions on Circuits and Systems for Video Technology},
  annotation = {中文辅助译名：Depth-UDiff：用于水下图像增强的深度先验扩散模型},
  abstract = {Existing underwater image enhancement methods employ handcrafted prior knowledge and general large vision models to mitigate regional quality variations, often resulting in structural inconsistencies and color distortion in spatially non-uniform degradation scenarios. Therefore, scene-adaptive priors and region-specific enhancement are two major challenges. To address this, we propose a depth-prior diffusion enhancement model (Depth-UDiff), which aims to guide underwater diffusion reconstruction through a multi-scene prior generation mechanism. Depth-UDiff comprises three key stages: (1) SAM-guided depth estimation utilizes degradation representations and segmentation cues to capture the environmental quality distribution, thereby estimating scene-related depth maps. (2) Depth-aware degradation correction decouples degradation features into structural and color components to perform depth-guided adaptive compensation, effectively mitigating the coupling interference between detail restoration and color correction. (3) Priors-based diffusion enhancement incorporates depth and correction priors to constrain the generation process, enabling natural visual reconstruction in complex degradation conditions. Extensive experiments on six benchmarks demonstrate that our method outperforms state-of-the-art methods in both quantitative metrics and visual quality. The code is available at: https://github.com/WindySprint/Depth-UDiff.},
}

