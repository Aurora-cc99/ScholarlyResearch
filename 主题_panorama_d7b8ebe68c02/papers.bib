@misc{panorama_d7b8ebe68c02_7599ed973dd6631c,
  title = {A Long-sequence Hierarchical Multimodal Fusion Framework for Personality-aware Depression Detection},
  author = {Bichen Wang and Yufei Hou and Yonghui Ji and Yanyan Zhao and Yu Zhang and Bing Qin},
  year = {2026},
  doi = {10.1145/3840470.3841784},
  url = {https://doi.org/10.1145/3840470.3841784},
  howpublished = {来源待核},
  annotation = {中文辅助译名：用于人格感知抑郁症检测的长序列分层多模态融合框架},
  abstract = {Depression detection in older adults is an important human-aware multimedia problem, where latent mental-health states must be inferred from non-invasive behavioral and individual-difference cues. This task is challenging because depressive symptoms are often subtle, heterogeneous, and reflected across multiple channels, including speech, facial behavior, language use, and personality-related differences. The MPDD-AVG Elder dataset provides a personality-aware multimodal setting for elderly depression detection, but it also introduces practical challenges such as long and variable-length audio-visual sequences, limited labeled data, and the underuse of textual semantics embedded in audio. To address these challenges, we propose a long-sequence hierarchical multimodal fusion framework for subject-level depression prediction. Our method models each subject through a chunk-sample-subject hierarchy. Long audio-visual sequences are divided into MFCC-aligned chunks, encoded with an audio-visual interaction module, and aggregated by attention pooling across chunks and samples. In addition, we introduce ASR-derived textual representations to capture semantic and self-description cues from interview responses. For prediction, we combine ordinal classification with PHQ-9 regression and we further apply LLM-based PHQ-9 score calibration to improve PHQ-9 prediction stability under the small-data setting. Experiments on the MPDD-AVG Elder dataset demonstrate the effectiveness of the propo},
}

@misc{panorama_59d1207a515b_40a7ab47b0a66bb7,
  title = {ConflictBench: Evaluating Human-AI Conflict via Interactive and Visually Grounded Environments},
  author = {Weixiang Zhao and Haozhen Li and Yanyan Zhao and Xuda Zhi and Yongbo Huang and Hao He and Bing Qin and Ting Liu},
  year = {2026},
  doi = {10.48550/ARXIV.2603.08024},
  url = {https://doi.org/10.48550/ARXIV.2603.08024},
  howpublished = {CoRR},
  annotation = {中文辅助译名：ConflictBench：通过交互式和视觉基础环境评估人类与人工智能的冲突},
  abstract = {As large language models (LLMs) evolve into autonomous agents capable of acting in open-ended environments, ensuring behavioral alignment with human values becomes a critical concern. Existing benchmarks, focused on static, single-turn prompts, fail to capture the interactive and multi-modal nature of real-world conflicts. We introduce ConflictBench, a benchmark for evaluating human–AI conflict through 150 multi-turn scenarios derived from prior alignment queries. ConflictBench integrates a text-based simulation engine with a visually grounded world model, enabling agents to perceive, plan, and act under dynamic conditions. Results show that while agents often act safely when human harm is immediate, they frequently prioritize self-preservation or adopt deceptive strategies in delayed or low-risk settings. A regret test further reveals that aligned decisions are often reversed under escalating pressure, especially with visual input. These findings underscore the need for interaction-level, multi-modal evaluation to surface alignment failures that remain hidden in conventional benchmarks. Beyond evaluation, we show that ConflictBench can also support alignment improvement by generating high-quality interactive trajectories for targeted fine-tuning, significantly enhancing agent behavior in complex conflict scenarios. Code and data are available at: https://github.com/Yranes/ConflictBench.},
}

