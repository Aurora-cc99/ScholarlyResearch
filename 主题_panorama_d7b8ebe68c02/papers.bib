  howpublished = {Northwest Medical Education},
  annotation = {中文辅助译名：PBL教学模式在医学遗传学教学中的探索},
  abstract = {Problem-based learning(PBL),with students in the center of teaching, gives priority to bringing forth their initiative and guides them to discover and solve problems themselves.It can also cultivate students' professional quality,enhance their ability to combine theory with practice,promote improvement of teachers' professional level,which achieves teaching and learning benefiting each other.It has been universally recognized by scholars at home and abroad.The paper summarizes the effects of PBL teaching pattern selectively introduced into medical genetics teaching.},
}

@misc{panorama_d7b8ebe68c02_17e394aae15a200a,
