@misc{badong_chen_596a566d11bb6307,
  title = {Enhanced Convergence Guarantees for Distributed CHOCO-SGD Over Directed Networks With General Quantizers},
  author = {Roula Nassif and Hongyu Han and Sheng Zhang and Badong Chen},
  year = {2026},
  doi = {10.1109/TSP.2026.3734590},
  url = {https://doi.org/10.1109/TSP.2026.3734590},
  howpublished = {IEEE Trans. Signal Process.},
  annotation = {中文辅助译名：使用通用量化器增强定向网络上分布式 CHOCO-SGD 的收敛保证},
  abstract = {In this paper, we analyze the CHOCO-SGD algorithm over directed networks for optimizing strongly-convex functions with Lipschitz-continuous gradients. Unlike prior studies, our analysis considers distributed optimization problems under a general quantization model that accounts for both relative and absolute quantization errors, without requiring assumptions on bounded gradient. The main technical contribution is the development of three coupled inequalities that describe the algorithm’s mean-square dynamics, which is also applicable to other algorithms using combined compensation and differential quantization. Based on this framework, we establish new stability conditions and derive a steady-state mean-square error bound of order$O(\mu)+O(\overline\sigma_q^2)$, along with bit-rate stability, where$\mu$is the step-size and$\overline\sigma_q^2$quantifies the absolute quantization error. This analysis reveals that when the step-size is sufficiently small, the (graph-based) combined compensation strategy, resulting in the CHOCO-SGD approach, and the (time-based) error-feedback compensation method, resulting in the DEF-ATC approach, yield comparable estimation accuracy. Finally, numerical simulations confirm these theoretical insights.},
}

