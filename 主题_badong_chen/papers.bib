@misc{badong_chen_21bb9610399bc17e,
  title = {Optimal Subband Adaptive Filtering Algorithm Over Functional Link Neural Network},
  author = {Jianhong Ye and Zongsheng Zheng and Yi Yu and Badong Chen},
  year = {2023},
  doi = {10.1109/MLSP55844.2023.10285919},
  url = {https://doi.org/10.1109/MLSP55844.2023.10285919},
  howpublished = {MLSP},
  annotation = {中文辅助译名：功能链接神经网络的最优子带自适应滤波算法},
  abstract = {Recently, to overcome the slow convergence of the functional link neural network (FLNN) for highly auto-correlated input signals, the delayless multi-sampled multiband-structured subband over FLNN (DMSFLNN) algorithm was proposed. However, this algorithm exists a performance tradeoff between convergence and steady-state behaviors, due to the fact that it uses a fixed step-size. Therefore, to obtain fast convergence and low steady-state misadjustment at the same time, this paper develops an optimal DMSFLNN (ODMSFLNN) algorithm that minimizes the trace of the covariance matrix of the weight deviation vector. Intrinsically, the ODMSFLNN algorithm is an extension of the Kalman filtering theory over the subband-based FLNN structure. In addition, we design the vectorized implementation of the ODMSFLNN algorithm to reduce the computational complexity from $O(L^2)$ to $O(L)$. Simulations on nonlinear system identification and nonlinear acoustic echo cancellation have been conducted to demonstrate that the proposed ODMSFLNN algorithm outperforms the existing state-of-art algorithms.},
}

