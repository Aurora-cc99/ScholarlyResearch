@misc{badong_chen_2eae3451e25fb439,
  title = {Dual-Clock Guaranteed-Time Actor-Critic Optimal Control With Flexible Input Saturation},
  author = {Hui Cao and Shuangsi Xue and Junkai Tan and Badong Chen},
  year = {2026},
  doi = {10.1109/TSMC.2026.3710287},
  url = {https://doi.org/10.1109/TSMC.2026.3710287},
  howpublished = {IEEE Trans. Syst. Man Cybern. Syst.},
  annotation = {中文辅助译名：具有灵活输入饱和度的双时钟保证时间 Actor-Critic 最优控制},
  abstract = {This article presents a dual-clock guaranteed-time (Dual-GT) actor–critic learning-based near-optimal control (OC) framework for control-affine nonlinear systems, which assigns separate deadlines to actor–critic learning and state convergence under explicit dominance and feasibility conditions. The proposed GT actor–critic laws drive the critic and actor neural-network weight errors into residual sets by the assigned learning deadline$T_p$. Built on the learned nominal actor, a GT enforcement layer drives the closed-loop state into a residual set by a distinct deadline$T_e$in the ideal no-saturation case. To handle actuator limits, a flexible input saturation mechanism is introduced. The strict proof is stated for the ideal command; for the saturated implementation, an explicit input-feasibility/mismatch condition characterizes the corresponding practical residual enlargement while respecting prescribed physical bounds. Simulations on a single-agent system, a simplified multiagent intersection-crossing scenario, and a drift-data-driven integral RL setting illustrate deadline assignment, speed-energy tradeoffs, excitation indicators, and saturation behavior.},
}

