@misc{badong_chen_3afe9a8a262cfa8d,
  title = {Online Nonlinear Granger Causality Detection by Quantized Kernel Least Mean Square},
  author = {Zejian Yuan and Nanning Zheng and Andreas Keil and José C. Príncipe and Hong Ji and Badong Chen},
  year = {2014},
  doi = {10.1007/978-3-319-12640-1_9},
  url = {https://doi.org/10.1007/978-3-319-12640-1_9},
  howpublished = {ICONIP (2)},
