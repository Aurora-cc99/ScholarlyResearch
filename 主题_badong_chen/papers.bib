@misc{badong_chen_4ba87686b220417f,
  title = {Measure observability by the generalized informational correlation},
  author = {Zengqi Sun and Jinchun Hu and Hongbo Li and Badong Chen},
  year = {2007},
  doi = {10.1109/CDC.2007.4434179},
  url = {https://doi.org/10.1109/CDC.2007.4434179},
  howpublished = {CDC},
  annotation = {中文辅助译名：通过广义信息相关性来衡量可观察性},
  abstract = {Informational correlation coefficient (ICC) can be used to measure the degree of observability for a system. In this paper, we define the generalized informational correlation coefficient (GICC), which is suitable for both discrete and continuous random variables. For the case in which the probability density functions (PDFs) are regularly supersummable, we obtain the exact value of GICC. Moreover, for the linear, stochastically autonomous system, we derive the explicit formula for the degree of observability, and prove the equivalence between the proposed measure and the traditional rank condition. Finally, a simple example is given to compare the discrete state case and the continuous state case.},
}

@misc{badong_chen_8ae21c10c1a50971,
  title = {Adaptive Inverse Control under (h,ø)-Entropy Criterion},
  author = {Badong Chen and Jinchun Hu and Hongbo Li and Zengqi Sun},
  year = {2006},
  doi = {10.1109/iccis.2006.252273},
  url = {https://doi.org/10.1109/iccis.2006.252273},
  howpublished = {IEEE Conference on Cybernetics and Intelligent Systems},
  annotation = {中文辅助译名：(h,ø)-熵准则下的自适应逆控制},
  abstract = {Recent research suggested that the error entropy (EE) criteria could be used to achieve a better error distribution in estimation, adaptation and learning. In this paper, we formulated the adaptive inverse control under a generalized error entropy criterion, i.e. (h, ø)-entropy criterion, and derived the associated error-entropy minimization algorithm. Several detailed schemes of adaptive filtering and inverse control under (h, ø)-entropy criterion were also presented. Finally, a simple simulation example has illustrated the effectiveness and advantages of this new method.},
}

@misc{badong_chen_4f47ae661c0e0382,
  title = {Measuring the Couplings of MIMO Dynamic Systems: An Information-Theoretic Approach},
  author = {Badong Chen and Jinchun Hu and Hongbo Li and Zengqi Sun},
  year = {2006},
  doi = {10.1109/wcica.2006.1712424},
  url = {https://doi.org/10.1109/wcica.2006.1712424},
  howpublished = {World Congress on Intelligent Control and Automation},
  annotation = {中文辅助译名：测量 MIMO 动态系统的耦合：一种信息论方法},
  abstract = {From the viewpoint of information theory, we proposed a novel concept of information coupling (IC) between the variables of MIMO dynamic system. Two kinds of measures of information coupling strength (ICS) were formulated in terms of mutual information rates. We also derived the frequency formulae of information coupling strengths for MIMO LTI system. Connections between information decoupling and conventional dynamic decoupling of linear system were presented, i.e. the input-output information decoupling (IOID) is equivalent to the input-output dynamic decoupling (IODD), whereas the output information decoupling (OID) is just a necessity for IOID and IODD. Our work shall introduce a new approach for further study of decoupling control under the information-theoretic framework.},
}

@misc{badong_chen_ed506cce9f16ea5e,
  title = {System Identification of UAV Based on EWC-LMS},
  author = {Zijing Zhou and Jinchun Hu and Shiqian Liu and Badong Chen},
  year = {2006},
  doi = {10.1109/cesa.2006.4281747},
  url = {https://doi.org/10.1109/cesa.2006.4281747},
  howpublished = {The Multiconference on Computational Engineering in Systems Applications},
  annotation = {中文辅助译名：基于EWC-LMS的无人机系统辨识},
  abstract = {Mean-squared error (MES) can at best provide biased solution in the presence of additive disturbances (both correlated and white) on the input and the output signals. However, in the system identification of unmanned aerial vehicle (UAV), typically, in the takeoff, the UAV suffers serious disturbance e.g. wind gusts, turbulence, ground influence and sampling noise. For EWC, we can get the unbiased parameter estimation in white noise, and the system identification in this paper prove the noise rejection ability of EWC. EWC (error whitening criterion) was first put forward by Mr. Rao in 2002 and applied in filtering, and further developed theoretically. But EWC has not been applied in practical problems yet. This paper applies EWC in the system identification of real self-developed UAV's takeoff motion, and compares the result of EWC-LMS with traditional LMS (least mean square) and TLS (total least square). The result shows that in comparison with traditional LMS and TLS, EWC-LMS improve the performance significantly},
}

@misc{badong_chen_c382293289be2664,
  title = {A Joint Stochastic Gradient Algorithm and Its Application to System Identification with RBF Networks},
  author = {Badong Chen and Jinchun Hu and Hongbo Li and Zengqi Sun},
  year = {2006},
  doi = {10.1109/wcica.2006.1712654},
  url = {https://doi.org/10.1109/wcica.2006.1712654},
  howpublished = {World Congress on Intelligent Control and Automation},
  annotation = {中文辅助译名：联合随机梯度算法及其在RBF网络系统辨识中的应用},
  abstract = {Mean-square-error (MSE) and minimum-error-entropy entropy (MEE) criteria play significant roles in adaptive filtering and learning theory. Nevertheless, both the criteria have their respective shortcomings. In this paper, we propose a more general and effective stochastic gradient algorithm under joint criterion of MSE and MEE, and derive the approximate upper bound for the step size in the adaptive linear neuron (ADALINE) training. In particular, we demonstrate the superiority of this joint adaptive algorithm by applying it into system identification with radial basis function (RBF) networks.},
}

@misc{badong_chen_d9fe1b8bfcb0382e,
  title = {Modeling and Control of Networked Control Systems},
  author = {Hongbo Li and Zengqi Sun and Badong Chen},
  year = {2006},
  doi = {10.1109/chicc.2006.280908},
  url = {https://doi.org/10.1109/chicc.2006.280908},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：网络控制系统的建模和控制},
  abstract = {This paper is concerned with modeling and control of the networked control systems (NCSs). A new general model for the considered NCSs is proposed under consideration of network-induced delay, data packet dropout and nonlinear characteristic simultaneously. Based on the given model, an optimal controller with feedback gain optimized based on GASA algorithm (genetic algorithm and simulated anneal algorithm) is proposed. Compared to existing controllers, the proposed one is less conservative and can be applied to nonlinear NCSs. Two examples show the effectiveness of the proposed approaches.},
}

@misc{badong_chen_05c6d42d219970b7,
  title = {The Application of Minimum Entropy H Mixed Sensitivity to Flight Control},
  author = {Badong Chen and Jinchun Hu and Jihong Zhu and Zengqi Sun},
  year = {2006},
  doi = {10.1109/cesa.2006.4281727},
  url = {https://doi.org/10.1109/cesa.2006.4281727},
  howpublished = {The Multiconference on Computational Engineering in Systems Applications},
  annotation = {中文辅助译名：最小熵H混合灵敏度在飞行控制中的应用},
  abstract = {Minimum entropy control has been studied extensively. Controllers satisfying a closed-loop minimum entropy condition provide a means of trading off the robustness of Hinfincontrol with the performance of H2controller. In this paper, the minimum entropy Hinfinmixed sensitivity method is described, followed by the controller design for an aircraft longitudinal flight control. Analysis tests and simulations illustrate that the minimum entropy controller has better performances than most of the other Hinfincontrollers which belong to a certain subset of the "unit ball in Hinfin"},
}
