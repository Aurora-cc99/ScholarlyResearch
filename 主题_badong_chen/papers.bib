@misc{badong_chen_0637e25e5afe6111,
  title = {Neural Adaptive Finite-Time Formation Tracking Control for Manipulator End Effectors Under Input Constraints},
  author = {Kai Qu and Hui Cao and Shuangsi Xue and Junkai Tan and Zihang Guo and Badong Chen},
  year = {2026},
  doi = {10.1109/TSMC.2025.3634832},
  url = {https://doi.org/10.1109/TSMC.2025.3634832},
  howpublished = {IEEE Trans. Syst. Man Cybern. Syst.},
  annotation = {中文辅助译名：输入约束下机械臂末端执行器的神经自适应有限时间编队跟踪控制},
  abstract = {This work investigates the formation tracking issue for multirobot manipulator end-effectors under input constraints. A distributed formation control law is designed to guarantee the finite-time boundedness of tracking errors within the framework. To estimate the significant bias of dynamics discovered during practical multirobot collaborative manipulation tasks, a bias radial basis function neural network (RBFNN) is integrated, along with a designed adaptive updating law for expeditious approximation. In addition, an anti-windup compensator within a finite-time framework is specifically introduced to mitigate the input saturation issue arising from torque limitations in joint actuators. Finally, the system’s semi-global practical finite-time boundedness (SGPFTB) is rigorously established through Lyapunov theory. Five planar manipulators are employed in comparative computational experiments to validate the feasibility of the presented control strategy.},
}

@misc{badong_chen_feda456e1bf439d6,
  title = {Dual-Uncertainty-Aware State Estimation of Electric-Gas Integrated Energy System via CNN-LSTM and Physical Constraint Data Alignment},
  author = {Wentao Ma and Aolin Chen and Hao Wu and Badong Chen},
  year = {2026},
  doi = {10.1109/tim.2026.3652720},
  url = {https://doi.org/10.1109/tim.2026.3652720},
  howpublished = {IEEE Transactions on Instrumentation and Measurement},
  annotation = {中文辅助译名：通过 CNN-LSTM 和物理约束数据对齐进行电-气综合能源系统的双重不确定性状态估计},
  abstract = {As a complex system that integrates multiple forms of energy, there are multiple time scale issues with the measurement data between different systems in the Electric-Gas Integrated Energy System (EGIES). Meanwhile, to accurately monitor and predict the current state of the system, state estimation (SE) is becoming increasingly important for EGIES. However, during the SE process, the measurement uncertainty caused by the measurement data and the cognitive uncertainty caused by the model have not been widely studied. This paper establishes a novel robust SE method using MC-Dropout enhanced CNN-LSTM model considering uncertainty. Firstly, a data alignment method combining the internal physical constraint of natural gas pipelines with spline interpolation is developed for effectively addressing the issues of consistency and synchronization of measurement data at different time scales. Secondly, by integrating CNN-LSTM networks with MC-Dropout technique while accounting for the effects of both cognitive uncertainty and measurement uncertainty on SE, this approach significantly enhances the accuracy and robustness of SE. Finally, by constructing probability density functions, interval SE results were obtained at different confidence levels, which intuitively expressed the uncertainty of SE and evaluated the accuracy of point estimation. Numerical experiments were conducted on IEEE 33 node and 14 node gas systems, and the results indicated that the proposed method achieves substant},
}

@misc{badong_chen_3bd6bdd9ccaca121,
  title = {Efficient Structure-Aware Discrete Clustering via Multi-Order Anchor Graphs},
  author = {Xuetao Zhang and Yu Zhou and Feiping Nie and Haoxin Wu and Ben Yang and Badong Chen},
  year = {2026},
  doi = {10.1109/TKDE.2026.3700798},
  url = {https://doi.org/10.1109/TKDE.2026.3700798},
  howpublished = {IEEE Trans. Knowl. Data Eng.},
  annotation = {中文辅助译名：通过多阶锚图进行高效的结构感知离散聚类},
  abstract = {Anchor graph-based clustering has demonstrated strong potential for uncovering complex latent structures in large-scale scenarios. Nevertheless, existing approaches face two critical limitations: first, most fail to fully exploit the deep structural relationships among samples, resulting in graphs that inadequately capture the intrinsic data topology; second, the conventional two-stage paradigm that separates spectral embedding from label assignment introduces relaxation errors and redundant computations, degrading clustering performance and increasing computational overhead. To address these challenges, we propose an Efficient Structure-Aware Discrete Clustering via Multi-Order Anchor Graphs (ESADC). ESADC adaptively fuses multi-order anchor graphs to model complementary approximations of the underlying continuous manifold, while employing a single-stage, structure-aware framework that jointly learns spectral embeddings and discrete cluster labels, thereby enhancing both clustering effectiveness and computational efficiency. Furthermore, a fast coordinate descent-based optimization algorithm is developed for the discrete ESADC model to accelerate convergence. Extensive experiments on both regular and large-scale real-world datasets demonstrate that ESADC consistently outperforms state-of-the-art methods, highlighting its efficiency and strong structure-aware capability.},
}

