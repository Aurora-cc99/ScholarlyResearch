@misc{badong_chen_c5c965e2a0a7d150,
  title = {Adaptive filtering for desired error distribution under minimum information divergence criterion},
  author = {Zengqi Sun and Fuchun Sun and Jinchun Hu and Badong Chen},
  year = {2008},
  doi = {10.1109/IJCNN.2008.4633954},
