@misc{badong_chen_80eeb7d3783ba027,
  title = {Multiscale Cross-Attention CNN-Transformer Two-Branch Fusion Network for Detecting Railway U-Shaped Bolts & Nuts Defects},
  author = {Jin He and Wei Wang and Xiaozhao Jin and Hongbo Li and Jun Liu and Badong Chen},
  year = {2025},
  doi = {10.1109/tmech.2025.3587940},
  url = {https://doi.org/10.1109/tmech.2025.3587940},
  howpublished = {IEEE/ASME Transactions on Mechatronics},
  annotation = {中文辅助译名：用于检测铁路 U 形螺栓和螺母缺陷的多尺度交叉注意力 CNN-Transformer两分支融合网络},
  abstract = {U-shaped Bolts & Nuts (UBNs) are essential for ensuring a smooth and continuous power supply to trains. UBN defects can lead to a mismatch between the pantograph and the overhead line, potentially causing severe damage to the pantograph and even halting train operations. Unfortunately, a specialized algorithm for detecting small-size UBN defects in high-resolution catenary inspection images under intricate real-world environments is notably absent. To remedy this, we propose a multiscale cross-attention convolutional neural network (CNN)-transformer two-branch fusion network (M2CTFNet). This network accurately detects small-size UBN defects across various natural scenes by integrating global and local features through a weight-based multiscale cross-attention fusion, and building a multiscale shuffling technique in the transformer branch. Extensive experiments demonstrate that M2CTFNet achieves a 2.7% higher precision and a 2.4% higher recall rate with lower computational cost and fewer weight parameters in UBN defect detection compared to state-of-the-art networks. Furthermore, M2CTFNet has been deployed on multiple inspection vehicles and has successfully detected several hundred UBN defects. These results verify that M2CTFNet is effective for addressing small object defects in challenging natural environments.},
}

@misc{badong_chen_f05b3475fb412bbf,
  title = {Convolutional Retentive Network for EEG Decoding},
  author = {Shuang Liang and Wenlong Hang and Harry Qin and Qiong Wang and Junliang Wang and Badong Chen},
  year = {2025},
  doi = {10.1109/ICASSP49660.2025.10890343},
  url = {https://doi.org/10.1109/ICASSP49660.2025.10890343},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：用于脑电图解码的卷积保持网络},
  abstract = {The self-attention mechanism of Transformer has gained considerable attention for its potential in modeling long-term temporal dependencies in electroencephalogram (EEG) signals. Despite recent advancements, Transformer-based decoding methods often neglect the explicit temporal priors inherent in EEG signals, i.e., the dependency between tokens tends to diminish as their relative temporal distance increases, which limits the efficacy of these decoding approaches. Inspired by the recent Retentive Network (RetNet), we develop a novel convolutional retentive network for EEG decoding (RetEEG), which integrates temporal priors into the self-attention mechanism to tackle the above challenge. Specifically, RetEEG incorporates a convolution module to capture local EEG features and cascades multiple bidirectional retention modules to learn global correlations within these local features. The bidirectional retention module introduces a temporal decay matrix, which imparts prior knowledge to the self-attention mechanism by accounting for variations in relative temporal distances. To validate the superiority of RetEEG, we conducted experiments on two publicly available EEG datasets. The experimental results empirically demonstrate that the proposed RetEEG achieves the state-of-the-art EEG decoding performance. Code is available at: https://github.com/kfhss/RetEEG.},
}

