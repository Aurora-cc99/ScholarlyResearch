  author = {Lei Sun and Fei Liao and Zhengping Che and Jian Tang and Xinyuan Lv and Kun Wu and Langzhe Gu and Meng Li and Zhiyuan Xu and Xinhua Wang and Ziluo Ding and Shuanghao Bai and Wanqi Zhou and Chengkai Hou and Badong Chen and Jiawei Wang and Shanghang Zhang},
  year = {2026},
