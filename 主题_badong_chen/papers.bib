@misc{badong_chen_4da59ee4056d3e44,
  title = {Adaptive sparseness for correntropy-based robust regression via automatic relevance determination},
  author = {Yasuharu Koike and Yuanhao Li and Natsue Yoshimura and Okito Yamashita and Badong Chen},
  year = {2023},
  doi = {10.1109/IJCNN54540.2023.10191293},
  url = {https://doi.org/10.1109/IJCNN54540.2023.10191293},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：通过自动相关性确定实现基于相关熵的鲁棒回归的自适应稀疏性},
  abstract = {Sparseness and robustness are two important properties for many machine learning scenarios. In the present study, regarding the maximum correntropy criterion (MCC) based robust regression algorithm, we investigate to integrate the MCC method with the automatic relevance determination (ARD) technique in a Bayesian framework, so that MCC-based robust regression could be implemented with ‘adaptive sparseness’. To be specific, we use an inherent noise assumption from the MCC to derive an explicit likelihood function, and realize the maximum a posteriori (MAP) estimation with the ARD prior by variational Bayesian inference. Compared to the existing robust and sparse$L_1$-regularized MCC regression, the proposed MCC-ARD regression can eradicate the troublesome tuning for the regularization hyper-parameter which controls the regularization strength. Further, MCC-ARD achieves superior prediction performance and feature selection capability than$L_1$-regularized MCC, as demonstrated by a noisy and high-dimensional simulation study. The codes of the proposed method are shared at https://sites.google.com/view/liyuanhao/codes.},
}

