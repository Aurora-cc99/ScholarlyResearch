  abstract = {Chapter 3 introduced the KMPE criterion, also known as the MMPE criterion in kernel space. This criterion can provide a cost function for robust learning and signal processing. In [ 258 , 259 ], the QKMPE with q -Gaussian kernel and the mixture KMPE (MKMPE) were proposed as a special case and an extended version of KMPE, respectively. This chapter will focus on robust AFAs under KMPE family criteria, including AFA under KMPE, KAF under q -Gaussian KMPE [ 258 ], recursive KAF under MKMPE [ 259 ], and ELM with KMPE [ 257 ].},
}

@misc{badong_chen_96dc562bdae9c436,
  title = {LSTM with AhI-Model Based Kalman Filter for Lithium-ion Battery State of Charge Estimation},
  author = {Xiangyong Luo and Lujuan Dang and Meng Yang and Badong Chen},
  year = {2024},
  doi = {10.1109/cac63892.2024.10865434},
  url = {https://doi.org/10.1109/cac63892.2024.10865434},
  howpublished = {China Automation Congress (CAC)},
  annotation = {中文辅助译名：LSTM 与基于 AhI 模型的卡尔曼滤波器用于锂离子电池充电状态估计},
  abstract = {Accurate state of charge (SOC) estimation of lithium-ion battery in battery management system (BMS) is important for the safety and reliability of electronic devices and electric vehicles. This paper proposes a LSTM-extended Kalman filter based on AhI-model (LSTM-EA), which constrains SOC result from LSTM with an AhI-model based Kalman filter. AhI-model is based on Ampere-hour integration method and requires simpler structure to obtain estimated SOC with higher accuracy and robustness. In the experiments, the public datasets from the Center for Advanced Life Cycle Engineering (CALCE) are used to validate the SOC estimation performance. The mean absolute error (MAE) and maximum error of the proposed method are less than 2.51% and 8.82% respectively.},
}

@misc{badong_chen_cfdcc9e5d45dbb72,
