  howpublished = {IEEE Transactions on Industrial Informatics},
  annotation = {中文辅助译名：混合 FDI-DoS 攻击下具有不对称输入状态约束的固定时间收敛弹性批评学习控制},
  abstract = {This article presents a resilient robust optimal tracking control method for nonlinear cyber-physical systems subject to mixed probabilistic cyber-attacks and asymmetric state constraints. We consider a challenging scenario where the system is targeted by both denial-of-service and false data injection attacks, modeled as stochastic processes. The proposed framework integrates prescribed performance control to enforce asymmetric state constraints within a stochastic differential game framework designed to ensure robustness. A key innovation is the development of a critic neural network (critic-NN)-based reinforcement learning algorithm that achieves fixed-time (FxT) convergence, guaranteeing that the critic-NN parameters converge to their near-optimal values within a predictable time, irrespective of initial conditions. This overcomes the limitations of traditional methods when faced with stochastic uncertainties. A rigorous stability analysis establishes the practical FxT stability in probability of the closed-loop system. Extensive simulation results demonstrate that our approach achieves superior tracking accuracy and resilience, strictly adhering to performance constraints despite the presence of probabilistic cyber-attacks.},
}

@misc{badong_chen_641db6b6a651b137,
