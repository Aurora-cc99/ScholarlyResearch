@misc{panorama_cdc6c9790170_12f15f07d49ee5f4,
  title = {Multimodal Electromagnetic Neuromodulation and Clinical Applications},
  author = {Guizhi Xu and Wei Y and Liu Y},
  year = {2026},
  doi = {10.1109/apemc65388.2026.11593675},
  url = {https://doi.org/10.1109/apemc65388.2026.11593675},
  howpublished = {Asia-Pacific International Symposium on Electromagnetic Compatibility (APEMC)},
  annotation = {中文辅助译名：多模态电磁神经调节及临床应用},
  abstract = {Electromagnetic neuromodulation has been widely used in the rehabilitation of neurological and psychiatric disorders; however, substantial differences in mechanisms and regulatory effects exist across stimulation modalities, and unified parameter optimization and evaluation frameworks are still lacking. In this multicenter study, transcranial magnetic stimulation and transcranial electrical stimulation were systematically applied in patients with stroke, Parkinson's disease, and Alzheimer's disease, and a multimodal assessment framework integrating EEG, MRI, peripheral biomarkers, and clinical scales was established. The results demonstrate that electromagnetic neuromodulation effectively modulates neuronal excitability and improves neurological dysfunction, with disease-specific advantages across stimulation targets and parameters. Multimodal data fusion further confirms its positive effects on brain structure, function, and behavioral outcomes.},
}

@misc{panorama_cdc6c9790170_5c8f0acda5db8055,
  title = {The Mechanism and Clinical Research on the Effects of rTMS on Cognitive Functions Based on Multi-Scale Fusion},
  author = {Tian Wang and Miaomiao Guo and Rui Fu and Haijun Zhu and Tianheng Zhang and Guizhi Xu},
  year = {2026},
  doi = {10.64187/bim.2026.v1.i1.001},
  url = {https://doi.org/10.64187/bim.2026.v1.i1.001},
  howpublished = {来源待核},
  annotation = {中文辅助译名：基于多尺度融合的rTMS对认知功能影响的机制及临床研究},
  abstract = {Repetitive transcranial magnetic stimulation (rTMS) is increasingly utilized in the treatment of Alzheimer’s disease (AD). However, its regulatory mechanisms remain unclear. This narrative review provides an overview of current international research progress and integrates representative findings from longitudinal and multimodal studies, including evidence from both animal and clinical investigations. It further compares the effects of different stimulation parameters, experimental models, and therapeutic strategies to examine the neuroregulatory effects of rTMS on brain regions involved in learning and memory across multiple levels, encompassing molecular signaling, synaptic plasticity, neural network reorganization, and behavioral outcomes. Furthermore, it summarizes the potential cross-scale mechanisms through which rTMS may alleviate cognitive impairment in AD and discusses current evidence regarding parameter optimization and individualized treatment strategies, alongside multimodal neural signal-based frameworks for clinical efficacy assessment, while emphasizing the rationale for individualized neuromodulation strategies. Overall, this review provides multi-level evidence to elucidate the neural mechanisms underlying rTMS-mediated cognitive improvement in AD, summarizes current advances and remaining challenges in rTMS-based interventions, and highlights important directions for clinical translation and personalized neuromodulation strategies.},
}

@misc{panorama_cdc6c9790170_84f0c0d149cc,
