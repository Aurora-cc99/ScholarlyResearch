@misc{panorama_cdc6c9790170_9a5e678c4b17,
  title = {Transcranial magneto-acoustic stimulation improves corticostriatal transmission in direct medium spiny neurons and rescues neuroplasticity of Parkinson's disease model mice},
  author = {Yihao Xu and Siwen Zhang and Jinrui Mi and Xiaochao Lu and Yuchen An and Jizhou Liu and Jiaqi Sun and Yanbin Wang and Guizhi Xu},
  year = {2026},
  doi = {10.1038/s41531-026-01333-8},
  url = {https://doi.org/10.1038/s41531-026-01333-8},
  howpublished = {npj Parkinson s Disease},
  annotation = {中文辅助译名：经颅磁声刺激可改善直接中型多棘神经元的皮质纹状体传递，并挽救帕金森病模型小鼠的神经可塑性。 NPJ 帕金森病},
  abstract = {Transcranial magneto-acoustic stimulation (TMAS) is a noninvasive neuromodulation technique that has demonstrated benefits for neuroplasticity in Parkinson's disease (PD), yet its underlying mechanisms remain inadequately understood. This study aimed to investigate how TMAS affects dysfunction and synaptic-plasticity impairments in the corticostriatal pathway in a subacute 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)-induced PD mouse model. The results indicated that TMAS was associated with reduced presynaptic glutamate release and with improved N-methyl-D-aspartate receptor (NMDAR)-mediated responses. It also enhanced D1 dopamine receptor-dependent basal synaptic transmission and partially restored bidirectional corticostriatal synaptic plasticity. Furthermore, TMAS tended to normalize the distribution of spine subtypes, improve motor deficits, reduce dopaminergic neuron loss, and decrease aberrant α-synuclein expression. Transcriptomic and enrichment analyses further suggested a coordinated modulation of gene programs related to synaptic organization, ion homeostasis, and immune responses. These findings support TMAS as a promising noninvasive neuromodulation approach in the MPTP mouse model. TMAS attenuated excessive glutamatergic transmission and improved corticostriatal synaptic plasticity, providing a testable mechanistic framework for future studies.},
}

@misc{panorama_cdc6c9790170_cf7855dc003e,
  title = {Microstate dynamics in motor imagery of stroke patients with transcranial alternating current stimulation modulation},
  author = {Lei Song and Ying Zhang and Yujia Wei and Yuqing Liu and Chunfang Wang and Guizhi Xu},
  year = {2026},
  doi = {10.7507/1001-5515.202508021},
  url = {https://pubmed.ncbi.nlm.nih.gov/41760200/},
  howpublished = {Sheng Wu Yi Xue Gong Cheng Xue Za Zhi},
  annotation = {中文辅助译名：经颅交流电刺激调制中风患者运动想象的微状态动力学..生物医学工程学杂志},
  abstract = {Transcranial alternating current stimulation (tACS) holds significant potential for improving motor function in stroke patients, but its underlying mechanisms remain unclear. In this study, 20 Hz tACS was applied to 15 stroke patients, and their motor imagery (MI) signals were collected before and after stimulation, which were for assessment by combining with the Fugl-Meyer Assessment for Upper Extremity (FMA-UE). Additionally, 11 subjects were recruited as a healthy control group. The study demonstrated that FMA-UE scores of stroke patients significantly increased after tACS intervention. The duration of EEG microstate C and F decreased significantly, while microstate D (coverage, duration, and occurrence probability) increased markedly, and microstate E decreased. The transition probabilities of C→D and D→B were positively correlated with FMA-UE scores. Based on these findings, this study concludes that 20 Hz tACS can enhance neuroplasticity and motor function in patients, and the transition probabilities (C→D/D→B) may serve as potential indicators for assessing motor function, providing experimental evidence for the clinical application of tACS and the development of rehabilitation brain-computer interfaces.},
}

@misc{panorama_cdc6c9790170_9c51a9b4e6f4b9aa,
  title = {Dynamical Analysis of Abnormal Oscillatory Activity in the BG and PPN Associated with Sleep-Related Alterations in Parkinson’s Disease and Its Modulation by DBS},
