@misc{wanzeng_kong_8a888602c8524eab,
  title = {An EEG-based Decoding Method for Motor Imagery Intentions in Mixed-Subject Settings with Adversarial Disentanglement},
  author = {Tianyi Zhao and Wanzeng Kong and Jianghan Yan and Jiazheng Zhang and Chengrui Chen and Jianhai Zhang and Li Zhu and Lei Jin and Andrzej Cichocki},
  year = {2024},
