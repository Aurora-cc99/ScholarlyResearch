@misc{wanzeng_kong_62ef1ad0994c9f23,
  title = {Identification of EEG features in stroke patients based on common spatial pattern and sparse representation classification},
  author = {Luyun Wang and Hong Zeng and Shanbao Tong and Wanzeng Kong and Guojun Dai and Xuefeng Lei and Ruoyu Jin and Yong Peng and Junfeng Sun and Sanqing Hu},
  year = {2017},
  doi = {10.1109/NER.2017.8008305},
  url = {https://doi.org/10.1109/NER.2017.8008305},
  howpublished = {NER},
  annotation = {中文辅助译名：基于共同空间模式和稀疏表示分类的脑卒中患者脑电特征识别},
  abstract = {Electroencephalography (EEG) and brain-computer interfaces (BCI) are receiving increasing attention and expanding application in stroke study. To identify stroke patients and normal controls during mental rotation task, common spatial pattern (CSP) algorithm is employed to extract features from binary-class EEG which will be further to form the dictionary for sparse representation. In the classification process, sparse representation-based classification (SRC) method is used; specifically, each test trial is sparsely represented over the formed dictionary and the sparse coefficient is obtained by solving a l1-norm regularized least squares minimization objective. A series of experiments demonstrated the effectiveness of features extracted by CSP of both classes and the SRC could obtain excellent results in classification. These result suggest that stroke patients have distinct EEG feature from normal controls. These EEG features may be potential biomarkers to monitor the rehabilitation process of stroke patients.},
}

