@misc{wanzeng_kong_8af88d3e1121ee55,
  title = {A new Kmeans clustering model and its generalization achieved by joint spectral embedding and rotation},
  author = {Wanzeng Kong and Yuan Ge and Wenna Huang and Yong Peng},
  year = {2021},
  doi = {10.7717/PEERJ-CS.450},
  url = {https://doi.org/10.7717/PEERJ-CS.450},
  howpublished = {PeerJ Comput. Sci.},
  annotation = {中文辅助译名：一种新的 Kmeans 聚类模型及其通过联合谱嵌入和旋转实现的泛化},
  abstract = {The Kmeans clustering and spectral clustering are two popular clustering methods for grouping similar data points together according to their similarities. However, the performance of Kmeans clustering might be quite unstable due to the random initialization of the cluster centroids. Generally, spectral clustering methods employ a two-step strategy of spectral embedding and discretization postprocessing to obtain the cluster assignment, which easily lead to far deviation from true discrete solution during the postprocessing process. In this paper, based on the connection between the Kmeans clustering and spectral clustering, we propose a new Kmeans formulation by joint spectral embedding and spectral rotation which is an effective postprocessing approach to perform the discretization, termed KMSR. Further, instead of directly using the dot-product data similarity measure, we make generalization on KMSR by incorporating more advanced data similarity measures and call this generalized model as KMSR-G. An efficient optimization method is derived to solve the KMSR (KMSR-G) model objective whose complexity and convergence are provided. We conduct experiments on extensive benchmark datasets to validate the performance of our proposed models and the experimental results demonstrate that our models perform better than the related methods in most cases.},
}

@misc{wanzeng_kong_7af50621e0e45d02,
  title = {An Unsupervised Discriminative Random Vector Functional Link Network for Efficient Data Clustering},
  author = {Yikai Zhang and Qi Zhu and Yong Kang Peng and Wanzeng Kong},
  year = {2021},
  doi = {10.1109/prai53619.2021.9550792},
  url = {https://doi.org/10.1109/prai53619.2021.9550792},
  howpublished = {International Conference on Pattern Recognition and Artificial Intelligence (PRAI)},
  annotation = {中文辅助译名：用于高效数据聚类的无监督判别随机向量功能链接网络},
  abstract = {Random Vector Functional Link (RVFL) is a single hidden layer feed forward network which can be trained with non-iterative learning methods. Concretely, the input weights and hidden biases in RVFL can be randomly generated and then the calculation of the output weights can be reduced to solve a regularized least squares regression formula. Though RVFL network obtained promising performance in diverse applications, most of its current variants work mainly for supervised tasks such as classification and regression while less effort was made to utilize the unlabeled data. In this paper, we propose an unsupervised RVFL model by simultaneously considering the local manifold structure and the global discriminative information of data. The newly formulated unsupervised discriminative RVFL (UDRVFL) model can be efficiently solved by handling an eigen-value decomposition operation. We conduct experiments by comparing UDRVFL with several state-of-the-arts on representative benchmark data sets and the results demonstrate that it has very competitive performance in data clustering.},
}

