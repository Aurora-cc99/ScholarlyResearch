@misc{panorama_efb52ffa06f1_0a2e543c7e49531a,
  title = {Marginal Contribution Spectral Fusion Network for Remote Hyperspectral Soil Organic Matter Estimation},
  author = {Jiaze Tang and Dan Liu and Qisong Wang and Junbao Li and Jing-Xiao Liao and Jinwei Sun},
