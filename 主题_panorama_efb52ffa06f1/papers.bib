@misc{panorama_efb52ffa06f1_ffd3efd78d837fc1,
  title = {Millisecond-Latency Gesture Recognition via Transmitted Mechanomyography},
  author = {Guohua Ding and Dan Liu and Qisong Wang and Jinwei Sun},
  year = {2025},
  doi = {10.3233/atde251129},
  url = {https://doi.org/10.3233/atde251129},
  howpublished = {Advances in transdisciplinary engineering},
  annotation = {中文辅助译名：通过传输肌力图进行毫秒延迟手势识别},
  abstract = {Gesture recognition remains one of the core challenges in human-computer interaction. While traditional electromyography (EMG) and mechanomyography (MMG) based methods demonstrate high recognition accuracy, they face limitations including susceptibility to signal acquisition interference and insufficient physiological interpretability. To address these issues, this study proposes an innovative transmissive mechanomyography (tMMG) gesture recognition framework that identifies gestures through detecting forearm pressure variations. We developed a wearable acoustic-sensing armband integrating miniature vibration sources and microphone arrays, employing 3D printing technology for lightweight implementation. This device enables real-time capture of surface vibration modulation signals induced by muscle contraction, coupled with feature extraction algorithms for efficient classification of muscle resting states. Experimental results demonstrate that our system achieves >98% recognition accuracy for 10 gestures (20 ms window length), comparable to EMG/MMG approaches while exhibiting faster recognition speed, particularly suitable for non-stationary signal detection. This work establishes a novel and practical technical pathway for interpretable musculoskeletal motion recognition, with promising applications in medical rehabilitation and virtual reality domains.},
}

