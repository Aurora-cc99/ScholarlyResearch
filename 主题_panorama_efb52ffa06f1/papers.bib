  author = {Yong-Ping Zhao and Fen Zhang and Qisong Wang},
  year = {2008},
  url = {https://jglobal.jst.go.jp/en/detail?JGLOBAL_ID=200902203515518177},
  howpublished = {Ha'erbin gongye daxue xuebao},
  annotation = {中文辅助译名：CRC算法在TPMS中的应用},
  abstract = {This paper proposes a half-byte rapid table-lookup method of CRC(Cyclic Redundancy Code) calculation to improve the reliability and reduce the memory space of wireless communication in Tire Pressure Monitoring System(TPMS).The implementation of this method is presented,and it overcomes the disadvantage of the single-byte table-lookup method spending much more space for memory resource.It is shown by experiments that the error-checking rate of this algorithm can reach 99.9 percent,and this method is applicable in TPMS.},
}

