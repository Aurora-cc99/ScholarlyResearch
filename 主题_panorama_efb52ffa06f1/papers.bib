  annotation = {中文辅助译名：通过力反馈增强虚拟现实交互：感知、工具和治疗应用},
  abstract = {While virtual and augmented reality technologies have advanced human-computer interaction, integrating precise haptic feedback remains critical for immersive experiences. This thesis hypothesizes that carefully designed force feedback mechanisms can enhance user interaction and presence in virtual environments. This work is timely given VR's growing use in applications needing fine motor control and tactile discrimination, such as surgical training and industrial design. The thesis addresses three fundamental research questions: (RQ1) How do users perceive and discriminate virtual stiffness across different interaction spaces? (RQ2) What are the performance implications and trade-offs when integrating force feedback in tool-mediated manipulation? (RQ3) How can force feedback be effectively implemented to enhance therapeutic engagement in VR rehabilitation? The research comprised three interconnected studies. The first established high perceptual thresholds for virtual stiffness discrimination (26-48%), revealing a violation of Weber's Law (1.8:1 ratio) and significant spatial variations in perception. The second study examined virtual tool manipulation and found that force feedback did not improve task speed and actually increased errors for heavier objects. However, it enhanced force control with a 12.0–13.2% reduction in applied forces, particularly benefiting users prone to over-gripping. This improvement came at the cost of increased cognitive load. The final study explor},
}

@misc{panorama_efb52ffa06f1_1b2f652805a1b54c,
  title = {A Novel Pain-Evoked EEG Extraction Method Guided by Pain Brain Sources},
  author = {Wenjia Gao and Dan Liu and Qisong Wang and Shaobin Li and Yong-Ping Zhao and Jinwei Sun},
  year = {2025},
  doi = {10.3233/atde251160},
  url = {https://doi.org/10.3233/atde251160},
  howpublished = {Advances in transdisciplinary engineering},
  annotation = {中文辅助译名：一种以疼痛脑源为指导的新型疼痛诱发脑电图提取方法},
  abstract = {Pain-evoked potentials are widely recognized as a crucial electrophysiological indicator for assessing pain. However, isolating pain-evoked potentials from raw electroencephalogram (EEG) signals is often hindered by interference from background brain activity and external noise. Traditional methods, such as those based on wavelets, typically average data from all trials to generate templates. This approach, however, can mask subtle yet significant variations in EEG patterns associated with different pain intensities. To address this limitation, our study proposes a novel framework that utilizes pain-related brain source signals. By selectively extracting relevant EEG data from a historical database, the framework constructs more accurate templates, significantly improving the extraction of pain-related neural activity. Experiments show that our method surpasses four alternative techniques in accurately extracting pain-evoked potentials. This work not only tackles the challenge of weak pain representation in raw EEG data but also advances the development of reliable, objective biomarkers for pain assessment, representing a significant step forward in the field of pain diagnostics.},
}

