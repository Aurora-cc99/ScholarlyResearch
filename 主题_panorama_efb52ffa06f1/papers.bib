@misc{panorama_efb52ffa06f1_4a70a4fb93bb323b,
  title = {BGR-YOLO: an obstacle detection algorithm based on multi-scale feature fusion for UAVs in low-altitude complex environments},
  author = {Ershen Wang and Qisong Wang and Song Xu and Hongsheng Zhao and Jian Ming Yang and Bo Shao and Pingping Qu and La Na},
  year = {2025},
  doi = {10.1088/1361-6501/ae2e2d},
  url = {https://doi.org/10.1088/1361-6501/ae2e2d},
  howpublished = {Measurement Science and Technology},
  annotation = {中文辅助译名：BGR-YOLO：一种基于多尺度特征融合的低空复杂环境无人机障碍物检测算法},
  abstract = {Abstract In low-altitude environments, UAV obstacle detection faces significant challenges due to the small size of obstacles, variable weather conditions, and interference from signal disruptions, all of which severely impact flight safety. To address these issues, this paper proposes a bidirectional-extended-path aggregation network to enhance multi-scale feature fusion, along with the introduction of a balanced attention module to improve detection accuracy in complex scenarios. Additionally, the paper introduces the global sensory mamba module and ripple manhattan self-attention models to further strengthen the network’s learning capabilities, thereby enhancing detection precision in challenging environments. The Bidirectional Global Ripple Low-altitude YOLO(BGR-YOLO) model, which integrates the above structures with YOLOv1ln, is proposed and tested on a UAV flight safety dataset for low-altitude environments. Experimental results demonstrate a significant improvement, with mean average precision (mAP 0.5 ) increasing from 85.3% to 90.5%, and mAP 0.5 rising from 62.8% to 67.9%, without a notable increase in parameters. Furthermore, results on the VisDrone2019 and SODA-A datasets confirm that this method provides an effective solution for detecting low-altitude obstacles in complex environments.},
}

@misc{panorama_efb52ffa06f1_90489665e8387a82,
