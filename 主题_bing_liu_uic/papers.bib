@misc{bing_liu_uic_e83c36795793ab5d,
  title = {Insight into the User behind the Text: An LLM Powered User-Centric Text Opinion Analysis Framework},
  author = {Jintao Wen and Yan Li and Mayi Xu and Xin Miao and Dexi Liu and Bing Liu and Wenpeng Lu and Wei Zhang and Tieyun Qian},
  year = {2026},
  doi = {10.1109/taffc.2026.3711665},
  url = {https://doi.org/10.1109/taffc.2026.3711665},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：洞察文本背后的用户：大语言模型支持的以用户为中心的文本意见分析框架},
  abstract = {Text opinion analysis (TOA) aims to extract and analyze subjective information from textual data. There exist multiple tasks in TOA, such as stance detection, sentiment analysis, and toxic speech detection. Existing studies tackle these tasks separately and develop various text-centric models. However, the text-centric paradigm faces two practical limitations. First, the text-centric TOA model exhibits inherent perspective limitations, as it primarily focuses on semantic features while neglecting to incorporate a user-centric perspective. This problem leads to the model lacking users' social attributes, behavioral patterns, and value preferences during the analysis process. Second, existing models exhibit limitations in generalizability. Typically trained and fine-tuned for specific tasks, these models perform poor adaptability across different TOA subtasks. To address the perspective and generalizability limitations, in this paper, we shift the focus from the text to users, viewing the text from a social psychology perspective as symbols generated by humans during social interactions. Consequently, we redefine TOA tasks as a user-centric analysis process involving the user, the contextual scenario, and their interactions beyond the text itself. Based on this unified formulation, we propose a large language model (LLM)-powered user-centric text analysis framework. Specifically, we first create foundational user profiles and opinion-aware user profiles from text using LLM and },
}

@misc{bing_liu_uic_a2c6c7f016dace0a,
