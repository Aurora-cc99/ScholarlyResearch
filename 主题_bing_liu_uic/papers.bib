@misc{bing_liu_uic_b7388459827d7253,
  title = {Detecting group review spam},
  author = {Natalie S. Glance and Junhui Wang and Nitin Jindal and Arjun Mukherjee and Bing Liu},
  year = {2011},
  doi = {10.1145/1963192.1963240},
