@misc{bing_liu_uic_1968be1c97fbaef9,
  title = {Feature-based opinion analysis and summarization},
  author = {Bing Liu and Minqing Hu},
  year = {2006},
  url = {http://dl.acm.org/citation.cfm?id=1237398},
