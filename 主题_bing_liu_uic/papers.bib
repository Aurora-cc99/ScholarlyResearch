@misc{bing_liu_uic_c104f99e888ddde2,
  title = {Time Sensitive Ranking with Application to Publication Search},
  author = {Xin Li and Philip S. Yu and Bing Liu},
  year = {2010},
  doi = {10.1007/978-1-4419-6515-8_7},
  url = {https://doi.org/10.1007/978-1-4419-6515-8_7},
  howpublished = {Link Mining},
  annotation = {中文辅助译名：时间敏感的排名及其在出版物搜索中的应用},
  abstract = {Link-based ranking has contributed significantly to the success of Web search. PageRank and HITS are the best known link-based ranking algorithms. These algorithms do not consider an important dimension, the temporal dimension. They favor older pages because these pages have many in-links accumulated over time. Bringing new and quality pages to the users is important because most users want the latest information. Existing remedies to PageRank are mostly heuristic approaches. This paper investigates the temporal aspect of ranking with application to publication search, and proposes a principled method based on the stationary probability distribution of the Markov chain. The proposed techniques are evaluated empirically using a large collection of high energy particle physics publication. The results show that the proposed methods are highly effective.},
}

@misc{bing_liu_uic_625db206ab2556be,
  title = {Distributional Similarity vs. PU Learning for Entity Set Expansion},
  author = {See-Kiong Ng and Lei Zhang and Bing Liu and Xiaoli Li},
  year = {2010},
  url = {https://www.aclweb.org/anthology/P10-2066.pdf},
  howpublished = {ACL (2)},
  annotation = {中文辅助译名：实体集扩展的分布相似性与 PU 学习},
  abstract = {Distributional similarity is a classic technique for entity set expansion, where the system is given a set of seed entities of a particular class, and is asked to expand the set using a corpus to obtain more entities of the same class as represented by the seeds. This paper shows that a machine learning model called positive and unlabeled learning (PU learning) can model the set expansion problem better. Based on the test results of 10 corpora, we show that a PU learning technique outperformed distributional similarity significantly. 1},
}

@misc{bing_liu_uic_986ed81316af63be,
  title = {Grouping Product Features Using Semi-Supervised Learning with Soft-Constraints},
  author = {Hua Xu and Zhongwu Zhai and Peifa Jia and Bing Liu},
  year = {2010},
  url = {https://www.cs.uic.edu/~liub/publications/coling_2010_final_Zhai.pdf},
  howpublished = {COLING},
  annotation = {中文辅助译名：使用具有软约束的半监督学习对产品功能进行分组},
  abstract = {In opinion mining of product reviews, one often wants to produce a summary of opinions based on product features/attributes. However, for the same feature, people can express it with different words and phrases. To produce a meaningful summary, these words and phrases, which are domain synonyms, need to be grouped under the same feature group. This paper proposes a constrained semisupervised learning method to solve the problem. Experimental results using reviews from five different domains show that the proposed method is competent for the task. It outperforms the original EM and the state-of-the-art},
}

@misc{bing_liu_uic_20b49b1bc89d5fe5,
  title = {Detecting product review spammers using rating behaviors},
  author = {Hady Wirawan Lauw and Viet-An Nguyen and Nitin Jindal and Ee-Peng Lim and Bing Liu},
  year = {2010},
  doi = {10.1145/1871437.1871557},
  url = {https://doi.org/10.1145/1871437.1871557},
  howpublished = {CIKM},
  annotation = {中文辅助译名：使用评级行为检测产品评论垃圾邮件发送者},
  abstract = {This paper aims to detect users generating spam reviews or review spammers. We identify several characteristic behaviors of review spammers and model these behaviors so as to detect the spammers. In particular, we seek to model the following behaviors. First, spammers may target specific products or product groups in order to maximize their impact. Second, they tend to deviate from the other reviewers in their ratings of products. We propose scoring methods to measure the degree of spam for each reviewer and apply them on an Amazon review dataset. We then select a subset of highly suspicious reviewers for further scrutiny by our user evaluators with the help of a web based spammer evaluation software specially developed for user evaluation experiments. Our results show that our proposed ranking and supervised methods are effective in discovering spammers and outperform other baseline method based on helpfulness votes alone. We finally show that the detected spammers have more significant impact on ratings compared with the unhelpful reviewers.},
}

@misc{bing_liu_uic_3c2ec8e2e85eacb6,
  title = {Finding unusual review patterns using unexpected rules},
  author = {Nitin Jindal and Bing Liu and Ee-Peng Lim},
  year = {2010},
  doi = {10.1145/1871437.1871669},
  url = {https://doi.org/10.1145/1871437.1871669},
  howpublished = {CIKM},
  annotation = {中文辅助译名：使用意想不到的规则发现不寻常的评论模式},
  abstract = {In recent years, opinion mining attracted a great deal of research attention. However, limited work has been done on detecting opinion spam (or fake reviews). The problem is analogous to spam in Web search [1, 9 11]. However, review spam is harder to detect because it is very hard, if not impossible, to recognize fake reviews by manually reading them [2]. This paper deals with a restricted problem, i.e., identifying unusual review patterns which can represent suspicious behaviors of reviewers. We formulate the problem as finding unexpected rules. The technique is domain independent. Using the technique, we analyzed an Amazon.com review dataset and found many unexpected rules and rule groups which indicate spam activities.},
}

@misc{bing_liu_uic_03d3ca2d0118875c,
  title = {Soochow University: Description and Analysis of the Chinese Word Sense Induction System for CLP2010},
  author = {Hua Xu and Bing Liu and Longhua Qian and Guodong Zhou},
  year = {2010},
  url = {https://www.aclweb.org/anthology/W10-4171.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：苏州大学：CLP2010汉语词义归纳系统描述与分析},
  abstract = {Recent studies on word sense induction (WSI) mainly concentrate on European languages, Chinese word sense induction is becoming popular as it presents a new challenge to WSI. In this paper, we propose a feature-based approach using the spectral clustering algorithm to this problem. We also compare various clustering algorithms and similarity metrics. Experimental results show that our system achieves promising performance in F-score. 1},
}

