@misc{bing_liu_uic_0deda8b5f1e8e572,
  title = {Exploiting Domain Knowledge in Aspect Extraction},
  author = {Malú Castellanos and Zhiyuan Chen and Arjun Mukherjee and Meichun Hsu and Riddhiman Ghosh and Bing Liu},
  year = {2013},
  doi = {10.18653/V1/D13-1172},
  url = {https://doi.org/10.18653/V1/D13-1172},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：在方面提取中利用领域知识},
  abstract = {Aspect extraction is one of the key tasks in sentiment analysis.In recent years, statistical models have been used for the task.However, such models without any domain knowledge often produce aspects that are not interpretable in applications.To tackle the issue, some knowledge-based topic models have been proposed, which allow the user to input some prior domain knowledge to generate coherent aspects.However, existing knowledge-based topic models have several major shortcomings, e.g., little work has been done to incorporate the cannot-link type of knowledge or to automatically adjust the number of topics based on domain knowledge.This paper proposes a more advanced topic model, called MC-LDA (LDA with m-set and c-set), to address these problems, which is based on an Extended generalized Pólya urn (E-GPU) model (which is also proposed in this paper).Experiments on real-life product reviews from a variety of domains show that MC-LDA outperforms the existing state-of-the-art models markedly.},
}

@misc{bing_liu_uic_ad7f28a033c03a77,
  title = {Leveraging Multi-Domain Prior Knowledge in Topic Models},
  author = {Malú Castellanos and Arjun Mukherjee and Zhiyuan Chen and Meichun Hsu and Riddhiman Ghosh and Bing Liu},
  year = {2013},
  url = {https://www.cs.uic.edu/~zchen/presentations/IJCAI2013-Poster-Zhiyuan(Brett)Chen.pdf},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：在主题模型中利用多领域先验知识},
  abstract = {Topic models have been widely used to identify topics in text corpora. It is also known that purely unsupervised models often result in topics that are not comprehensible in applications. In recent years, a number of knowledge-based models have been proposed, which allow the user to input prior knowledge of the domain to produce more coherent and meaningful topics. In this paper, we go one step further to study how the prior knowledge from other domains can be exploited to help topic modeling in the new domain. This problem setting is important from both the application and the learning perspectives because knowledge is inherently accumulative. We human beings gain knowledge gradually and use the old knowledge to help solve new problems. To achieve this objective, existing models have some major difficulties. In this paper, we propose a novel knowledge-based model, called MDK-LDA, which is capable of using prior knowledge from multiple domains. Our evaluation results will demonstrate its effectiveness.},
}

@misc{bing_liu_uic_86bf2b4a21ba7962,
  title = {What Yelp Fake Review Filter Might Be Doing?},
  author = {Natalie S. Glance and Vivek Venkataraman and Arjun Mukherjee and Bing Liu},
  year = {2013},
  doi = {10.1609/icwsm.v7i1.14389},
  url = {https://doi.org/10.1609/icwsm.v7i1.14389},
  howpublished = {ICWSM},
  annotation = {中文辅助译名：Yelp 假评论过滤器可能在做什么？},
  abstract = {Online reviews have become a valuable resource for decision making. However, its usefulness brings forth a curse ‒ deceptive opinion spam. In recent years, fake review detection has attracted significant attention. However, most review sites still do not publicly filter fake reviews. Yelp is an exception which has been filtering reviews over the past few years. However, Yelp’s algorithm is trade secret. In this work, we attempt to find out what Yelp might be doing by analyzing its filtered reviews. The results will be useful to other review hosting sites in their filtering effort. There are two main approaches to filtering: supervised and unsupervised learning. In terms of features used, there are also roughly two types: linguistic features and behavioral features. In this work, we will take a supervised approach as we can make use of Yelp’s filtered reviews for training. Existing approaches based on supervised learning are all based on pseudo fake reviews rather than fake reviews filtered by a commercial Web site. Recently, supervised learning using linguistic n-gram features has been shown to perform extremely well (attaining around 90% accuracy) in detecting crowdsourced fake reviews generated using Amazon Mechanical Turk (AMT). We put these existing research methods to the test and evaluate performance on the real-life Yelp data. To our surprise, the behavioral features perform very well, but the linguistic features are not as effective. To investigate, a novel informatio},
}

