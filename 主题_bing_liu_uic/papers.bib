@misc{bing_liu_uic_d674e87a323df915,
  title = {Identifying False Human Papillomavirus (HPV) Vaccine Information and Corresponding Risk Perceptions From Twitter: Advanced Predictive Models},
  author = {Tre Tomaszewski and Alex Morales and Ismini Lourentzou and Rachel N. Caskey and Bing Liu and Alan Schwartz and Jessie Chin},
  year = {2021},
  doi = {10.2196/30451},
  url = {https://doi.org/10.2196/30451},
  howpublished = {Journal of Medical Internet Research},
  annotation = {中文辅助译名：识别来自 Twitter 的虚假人乳头瘤病毒 (HPV) 疫苗信息和相应的风险认知：高级预测模型},
  abstract = {BACKGROUND: The vaccination uptake rates of the human papillomavirus (HPV) vaccine remain low despite the fact that the effectiveness of HPV vaccines has been established for more than a decade. Vaccine hesitancy is in part due to false information about HPV vaccines on social media. Combating false HPV vaccine information is a reasonable step to addressing vaccine hesitancy. OBJECTIVE: Given the substantial harm of false HPV vaccine information, there is an urgent need to identify false social media messages before it goes viral. The goal of the study is to develop a systematic and generalizable approach to identifying false HPV vaccine information on social media. METHODS: This study used machine learning and natural language processing to develop a series of classification models and causality mining methods to identify and examine true and false HPV vaccine-related information on Twitter. RESULTS: We found that the convolutional neural network model outperformed all other models in identifying tweets containing false HPV vaccine-related information (F score=91.95). We also developed completely unsupervised causality mining models to identify HPV vaccine candidate effects for capturing risk perceptions of HPV vaccines. Furthermore, we found that false information contained mostly loss-framed messages focusing on the potential risk of vaccines covering a variety of topics using more diverse vocabulary, while true information contained both gain- and loss-framed messages foc},
}

