@misc{panorama_9e5a5cd4792f_be3e4b660857e576,
  title = {CT-Net: Arbitrary-Shaped Text Detection via Contour Transformer},
  author = {Zhiwen Shao and Yuchen Su and Yong Zhou and Fanrong Meng and Hancheng Zhu and Bing Liu and Rui Yao},
  year = {2024},
  doi = {10.1109/TCSVT.2023.3299087},
