@misc{panorama_9e5a5cd4792f_b5553bf1cd38a3cb,
  title = {Diverse Image Captioning via Conditional Variational Autoencoder and Dual Contrastive Learning},
  author = {Jing Xu and Bing Liu and Yong Zhou and Mingming Liu and Rui Yao and Zhiwen Shao},
  year = {2024},
  doi = {10.1145/3614435},
  url = {https://doi.org/10.1145/3614435},
