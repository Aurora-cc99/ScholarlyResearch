@misc{panorama_9e5a5cd4792f_d68318a3fb93797c,
  title = {Micro-Expression Recognition via Fine-Grained Dynamic Perception},
  author = {Zhiwen Shao and Yifan Cheng and Fan Zhang and Xuehuai Shi and Canlin Li and Lizhuang Ma and Dit-Yan Yeung},
  year = {2025},
  doi = {10.1145/3765901},
