@misc{panorama_9e5a5cd4792f_bce8c437e85d4edd,
  title = {Motion-Aware Self-Supervised RGBT Tracking with Multi-Modality Hierarchical Transformers},
  author = {Shenglan Li and Rui Yao and Yong Zhou and Hancheng Zhu and Jiaqi Zhao and Zhiwen Shao and Abdulmotaleb El Saddik},
  year = {2024},
  doi = {10.1145/3698399},
