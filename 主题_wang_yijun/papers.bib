@misc{wang_yijun_a5a296cc1b81d513,
  title = {DarHTG is a tripartite phage defence system for purine DNA base ADP-ribosylation},
  author = {Raphael Ledermann and Anna-Lena Gotzler and Barbara A. Steigenberger and Yijun Wang and Johanna Zimmermann and Selina Geiger and Jieying Fu and Johannes Hoffmann and Osamu Suyari and YuGeng Zhang and Yang Lu and Andreja Mikoč and Christoph M. Tang and Ivan Ahel and Marion Schuller},
  year = {2026},
  doi = {10.64898/2026.11.02.763450},
  url = {https://doi.org/10.64898/2026.11.02.763450},
  howpublished = {bioRxiv (Cold Spring Harbor Laboratory)},
  annotation = {中文辅助译名：DarHTG 是一种用于嘌呤 DNA 碱基 ADP-核糖基化的三方噬菌体防御系统},
  abstract = {Abstract Bacteria evolved a variety of phage defence strategies to combat the constant onslaught of viral threats. DarTG toxin-antitoxin systems provide phage defence by ADP-ribosylation of bases in single-stranded DNA which interferes with viral replication and aborts phage infection. Here, we describe DarHTG, a system widespread among bacteria, that combines DarTG with a non- processive superfamily I helicase functioning as co-toxin for DarT and thereby enabling the ADP- ribosylation of double-stranded DNA. We identified two such DarHTG subclasses which catalyse the ADP-ribosylation of adenosine and guanosine bases, respectively, and reverse these modifications with structurally unique ARH superfamily antitoxins. Thus, DarHTG antitoxins expand the known macromolecular target spectrum of the ARH enzyme class to nucleic acids. These DarHTG systems confer resistance to a broad range of bacteriophages and can be triggered by the highly charged tails of viral single-stranded DNA-binding proteins, which occlude the active site of the ARH antitoxin.},
}

@misc{gao_xiaorong_bb86ab2f5ed5,
  title = {A 240-target VEP-based BCI system employing narrow-band random sequences},
  author = {Yida Dong and Li Zheng and Weihua Pei and Xiaorong Gao and Yijun Wang},
  year = {2025},
  doi = {10.1088/1741-2552/adbfc1},
  url = {https://doi.org/10.1088/1741-2552/adbfc1},
  howpublished = {Journal of Neural Engineering},
  annotation = {中文辅助译名：采用窄带随机序列的 240 个目标的基于 VEP 的 BCI 系统},
  abstract = {Abstract Objective. In the field of brain–computer interface (BCI), achieving high information transfer rates (ITR) with a large number of targets remains a challenge. This study aims to address this issue by developing a novel code-modulated visual evoked potential (c-VEP) BCI system capable of handling an extensive instruction set while maintaining high performance. Approach . We propose a c-VEP BCI system that employs narrow-band random sequences as visual stimuli and utilizes a convolutional neural network (CNN)-based EEG2Code decoding algorithm. This algorithm predicts corresponding stimulus sequences from EEG data and achieves efficient and accurate classification. Main results. Offline experiments which conducted in a sequential paradigm, resulted in an average accuracy of 87.66% and a simulated ITR of 260.14 bits/min. In online experiments, the system demonstrated an accuracy of 76.27% and an ITR of 213.80 bits/min in a cued spelling task. Significance. This work represents an advancement in c-VEP BCI systems, offering one of the largest known instruction set in VEP-based BCIs and demonstrating robust performance metrics. The proposed system is potential for more practical and efficient BCI applications.},
}

@misc{wang_yijun_0ec780b11675d235,
  title = {The impact of perceived school climate and socio-demographic factors on immigrant students’ engagement in China},
  author = {Huiqi Hu and Tom Vanwing and Cai Juan and Ingeborg Placklé and Yijun Wang and Wolfgang Jacquet},
  year = {2025},
  doi = {10.1080/2331186x.2025.2514343},
  url = {https://doi.org/10.1080/2331186x.2025.2514343},
  howpublished = {Cogent Education},
  annotation = {中文辅助译名：感知的学校氛围和社会人口因素对移民学生在中国的参与的影响},
  abstract = {The development of immigrant students requires special attention due to their higher likelihood of encountering challenges. This research investigates how the school climate affects the school engagement of immigrant students, aiming to enhance understanding of their school experiences and identify strategies to improve their engagement. Our study focuses on a group of inter-country immigrant students in China. Using a case study methodology, we examined a school in Shanghai to identify socio-demographic factors influencing the school engagement of these students. The findings indicate that teachers and schools shape students’ desire to continue education and boost affective engagement. Positive feedback improves cognitive engagement, attention needs for male students. Professional skills and career development enhance behavioral engagement for students from higher socioeconomic backgrounds. The research concludes that targeted interventions by schools and teachers can effectively foster positive school engagement among immigrant students.},
}

