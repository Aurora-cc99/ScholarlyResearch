  howpublished = {IEEE photonics journal},
  annotation = {中文辅助译名：通过不可信纠缠源进行跨媒体连续可变量子密钥分发},
  abstract = {We propose a continuous-variable quantum key distribution (CVQKD) scheme based on the atmosphere-to-seawater channel. In particular, an untrusted entanglement source (two modes of the compressed vacuum state, TMSV) is deployed on the surface of the seawater, each mode of TMSV is sent to one of the two legitimate parts, respectively. In this way, we can establish a trans-media CVQKD link between the atmosphere and the underwater. Meanwhile, a suitable non-Gaussian operation, namely photon subtraction, is introduced to enhance the performance of the trans-media CVQKD scheme. Security analysis shows that the proposed scheme can establish a trans-media quantum communication system on the atmosphere-to-seawater channel. Moreover, the maximum transmission distance can be further extended by using proper photon subtraction operation. Our scheme provides a guidance for applying CVQKD to trans-media channels.},
}

@misc{wang_yijun_4a78897df973c88d,
