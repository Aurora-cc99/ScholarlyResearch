@misc{wang_yijun_9cef6d2b0b4f,
  title = {Individual Identification Based on Code-Modulated Visual-Evoked Potentials},
  author = {Hongze Zhao and Yijun Wang and Zhiduo Liu and Weihua Pei and Hongda Chen},
