@misc{wang_yijun_ff72652008f4,
  title = {A High-Speed Visual BCI Based on Hybrid Frequency–Phase–Space Encoding and High-Density EEG Decoding},
  author = {Gege Ming and Weihua Pei and Sen Tian and Xiaogang Chen and Xiaorong Gao and Yijun Wang},
