@misc{xu_ruifeng_552668fd29c05375,
  title = {Write, Execute, Refine: From Skill Followers to Skill Optimizers via Reinforcement Learning from Execution Feedback},
  author = {Kang Peng and Zhiwei Zhang and Yichen Zhang and Zezhong Wang and Yiming Du and Geng Tu and Baojun Wang and Bin Liang and Ruifeng Xu and Kam-Fai Wong},
  year = {2026},
  doi = {10.48550/ARXIV.2608.17587},
  url = {https://doi.org/10.48550/ARXIV.2608.17587},
  howpublished = {CoRR},
  annotation = {中文辅助译名：编写、执行、完善：通过执行反馈的强化学习从技能追随者到技能优化者},
  abstract = {Expert-written natural language skills can improve tool-using agents, yet agent-authored skills perform 8--11 points worse than using no skill. While inference-time loops can repair individual skills per task, they leave the underlying generator's refinement capability unimproved. We study how to organize execution experience from intermediate skills into training states for an optimizer. We introduce WER(Write, Execute, and Refine), a multi-phase framework that trains a Skill Optimizer outside a frozen executor. The optimizer proposes skills, a frozen agent executes each repeatedly, and a programmatic verifier scores the outcomes. These scores serve as group-relative rewards and filter for informative, mixed-outcome instances. Matched successful and failed trajectories from these records form the next phase's refinement states, so the optimizer learns from the consequences of its earlier outputs. On BFCL v4 multi-turn and tau2-bench, WER improves average Pass@1 over the no-skill baseline by 7.80 and 6.06 points, respectively. Under an identical refinement workflow, it outperforms the same backbone without optimizer training by 10.02 and 12.50 points. Notably, our trained 4B optimizer achieves 76.63\% on BFCL v4, outperforming all evaluated off-the-shelf general-purpose LLMs in the same role on average. Our code is available at https://github.com/littlepkk/wer-training.},
}

