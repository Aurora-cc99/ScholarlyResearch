  title = {A Joint Model for Chinese Microblog Sentiment Analysis},
  author = {Yuhui Cao and Zhao Chen and Ruifeng Xu and Tao Chen and Lin Gui},
  year = {2015},
  doi = {10.18653/V1/W15-3111},
  url = {https://aclanthology.org/W15-3111/},
