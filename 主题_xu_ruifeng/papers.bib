@misc{xu_ruifeng_676ff52e2034b367,
  title = {Reducing Spurious Correlations for Aspect-Based Sentiment Analysis with Variational Information Bottleneck and Contrastive Learning},
  author = {Mingshan Chang and Min Yang and Qingshan Jiang and Ruifeng Xu},
  year = {2023},
  doi = {10.48550/ARXIV.2303.02846},
