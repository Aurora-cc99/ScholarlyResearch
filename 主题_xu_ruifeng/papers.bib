@misc{xu_ruifeng_d5555f205111606d,
  title = {Event AutoAugment: Word-level data augmentation for textual event detection},
  author = {Jun Gao and Huan Zhao and Wei Wang and Changlong Yu and Ruifeng Xu},
  year = {2025},
  doi = {10.1016/J.ESWA.2025.127740},
