@misc{xu_ruifeng_ff4c9264bce7,
  title = {HITSZ-HLT at SemEval-2021 Task 5: Ensemble Sequence Labeling and Span Boundary Detection for Toxic Span Detection},
  author = {Qinglin Zhu and Zijie Lin and Yice Zhang and Jingyi Sun and Xiang Li and Qihui Lin and Yixue Dang and Ruifeng Xu},
  year = {2021},
  doi = {10.18653/V1/2021.SEMEVAL-1.63},
  url = {https://aclanthology.org/2021.semeval-1.63/},
  howpublished = {ACL Anthology author bibliography},
  annotation = {中文辅助译名：SemEval-2021 任务 5 上的 HITSZ-HLT：用于有毒跨度检测的集成序列标记和跨度边界检测},
  abstract = {This paper presents the winning system that participated in SemEval-2021 Task 5: Toxic Spans Detection.This task aims to locate those spans that attribute to the text's toxicity within a text, which is crucial for semiautomated moderation in online discussions.We formalize this task as the Sequence Labeling (SL) problem and the Span Boundary Detection (SBD) problem separately and employ three state-of-the-art models.Next, we integrate predictions of these models to produce a more credible and complement result.Our system achieves a char-level score of 70.83%, ranking 1/91.In addition, we also explore the lexicon-based method, which is strongly interpretable and flexible in practice.},
}

