@misc{xu_ruifeng_c152e12736e8,
  title = {Probing Graph Decomposition for Argument Pair Extraction},
  author = {Yang Sun and Bin Liang and Jianzhu Bao and Yice Zhang and Geng Tu and Min Yang and Ruifeng Xu},
  year = {2023},
  doi = {10.18653/V1/2023.FINDINGS-ACL.827},
  url = {https://aclanthology.org/2023.findings-acl.827/},
  howpublished = {ACL Anthology author bibliography},
  annotation = {中文辅助译名：用于参数对提取的探测图分解},
  abstract = {Argument pair extraction (APE) aims to extract interactive argument pairs from two passages within a discussion.The key challenge of APE is to effectively capture the complex contextaware interactive relations of arguments between the two passages.In this paper, we elicit relational semantic knowledge from large-scale pre-trained language models (PLMs) via a probing technique.The induced sentence-level relational probing graph can help capture rich explicit interactive relations between argument pairs effectively.Since the relevance score of a sentence pair within a passage is generally larger than that of the sentence pair from different passages, each sentence would prefer to propagate information within the same passage and under-explore the interactive relations between two passages.To tackle this issue, we propose a graph decomposition method to decompose the probing graph into four subgraphs from intra-and inter-passage perspectives, where the intra-passage graphs can help detect argument spans within each passage and the inter-passage graphs can help identify the argument pairs between the review and rebuttal passages.Experimental results on two benchmark datasets show that our method achieves substantial improvements over strong baselines for APE.},
}

