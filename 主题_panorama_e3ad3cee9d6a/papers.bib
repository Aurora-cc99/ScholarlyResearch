@misc{panorama_e3ad3cee9d6a_a5ef923377bf5030,
  title = {Mitigating Multimodal Hallucination Through Effective and Perception-Aware Granularity Alignment},
  author = {Zhibing Zhang and Jiantao Lin and Yuchen Zhang and Rui Xia and Cangqi Zhou},
  year = {2026},
  doi = {10.1109/taslpro.2026.3703183},
  url = {https://doi.org/10.1109/taslpro.2026.3703183},
  howpublished = {IEEE Transactions on Audio Speech and Language Processing},
  annotation = {中文辅助译名：通过有效和感知感知的粒度调整来减轻多模态幻觉},
  abstract = {Hallucinations in Large Vision-Language Models (LVLMs) have garnered great attention in recent studies. In our research, we observe a significant granularity mismatch between the data utilized across different training stages of LVLMs. However, the impact of this granularity mismatch on model performance remains underexplored. Such incongruence may lead to inconsistencies between the mapped coarse-grained visual information and the introduced fine-grained textual information. Trained on these misaligned data, the model will fabricate hallucinatory content through ungrounded extrapolation. In this paper, we systematically investigate how data granularity differences across different training stages affect model behavior, through defining a granularity metric and varying it in these stages. Our analysis confirms the detrimental impact of granularity discrepancies on model performance, underscoring the importance of identifying an appropriate alignment granularity and the challenge of achieving effective alignment across training stages. Based on these findings, we propose EPAlign, anEffective andPerception-aware granularityAlignment framework that aligns different stages to an appropriate granularity level to mitigate hallucinations. Extensive experiments show that EPAlign significantly reduces hallucinations in LVLMs.},
}

