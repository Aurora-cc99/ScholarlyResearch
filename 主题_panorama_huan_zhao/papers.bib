@misc{panorama_huan_zhao_d8888f713e92d185,
  title = {Cross-modal image-text search via Efficient Discrete Class Alignment Hashing},
  author = {Song Wang and Huan Zhao and Yunbo Wang and Jing Huang and Keqin Li},
  year = {2022},
  doi = {10.1016/J.IPM.2022.102886},
