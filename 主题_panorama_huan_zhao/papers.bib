@misc{panorama_117e02335c9b_d51fa3907661a5df,
  title = {WenetSpeech4TTS: A 12,800-hour Mandarin TTS Corpus for Large Speech Generation Model Benchmark},
  author = {Linhan Ma and Dake Guo and Kun Song and Yuepeng Jiang and Shuai Wang and Liumeng Xue and Weiming Xu and Huan Zhao and Binbin Zhang and Lei Xie},
  year = {2024},
  doi = {10.21437/interspeech.2024-2343},
  url = {https://doi.org/10.21437/interspeech.2024-2343},
  howpublished = {Interspeech (USB)},
  annotation = {中文辅助译名：WenetSpeech4TTS：用于大型语音生成模型基准的 12,800 小时普通话 TTS 语料库},
  abstract = {With the development of large text-to-speech (TTS) models and scale-up of the training data, state-of-the-art TTS systems have achieved impressive performance. In this paper, we present WenetSpeech4TTS, a multi-domain Mandarin corpus derived from the open-sourced WenetSpeech dataset. Tailored for the text-to-speech tasks, we refined WenetSpeech by adjusting segment boundaries, enhancing the audio quality, and eliminating speaker mixing within each segment. Following a more accurate transcription process and quality-based data filtering process, the obtained WenetSpeech4TTS corpus contains $12,800$ hours of paired audio-text data. Furthermore, we have created subsets of varying sizes, categorized by segment quality scores to allow for TTS model training and fine-tuning. VALL-E and NaturalSpeech 2 systems are trained and fine-tuned on these subsets to validate the usability of WenetSpeech4TTS, establishing baselines on benchmark for fair comparison of TTS systems. The corpus and corresponding benchmarks are publicly available on huggingface.},
}

@misc{panorama_huan_zhao_045e39bfbda7bbbf,
  title = {Research on Stacked Model for Cluster CPU Utilization Prediction Based on Butterworth Filter},
  author = {Zihao Wang and Huan Zhao and Rong Dai},
  year = {2023},
  doi = {10.1109/icbaie59714.2023.10281293},
  url = {http://dx.doi.org/10.1109/icbaie59714.2023.10281293},
  howpublished = {International Conference on Big Data, Artificial Intelligence and Internet of Things Engineering (ICBAIE)},
  annotation = {中文辅助译名：基于巴特沃斯滤波器的集群CPU利用率预测堆叠模型研究},
  abstract = {Accurately estimating CPU and disk utilization in a cluster is crucial for avoiding failures and reducing unnecessary losses. Although there are many mathematical and machine learning methods that can roughly predict the future trends of time series data, these methods are not applicable to all data. Although deep learning algorithms have a wide range of applications, they lack interpretability. This paper proposes a stacked model based on Butterworth data filtering the STACK_XGBOOST model, which combines data filtering with statistical methods, machine learning algorithms, and deep learning methods. Firstly, the 4-sigma method is used to remove outliers in the data. Then, the Butterworth filter is used to smooth the trend of the time series data. Next, mathematical statistics, machine learning algorithms, and deep learning methods are used for prediction. Finally, XGBoost is chosen as the meta-model, and the prediction results of each baseline model are used as input to obtain the final prediction results, thereby improving the accuracy of resource utiliztaion prediction. Experimental data collected from the past 13 days of cluster CPU utilization is used for testing in a Computing Center. The experimental results show that compared to individual time series prediction algorithms, the STACK_XGBOOST model has lower average absolute error, higher prediction accuracy, and stronger interpretability.},
}

