@misc{panorama_huan_zhao_5d8372e570131a5e,
  title = {Voice Activity Detection Based on Distance Entropy in Noisy Environment},
  author = {Huan Zhao and Li-xia Zhao and Kai Zhao and Gang‐Jin Wang},
  year = {2009},
  doi = {10.1109/ncm.2009.134},
  url = {https://doi.org/10.1109/ncm.2009.134},
  howpublished = {International Joint Conference on INC, IMS and IDC (NCM)},
  annotation = {中文辅助译名：噪声环境下基于距离熵的语音活动检测},
  abstract = {Voice activity detection is considered as a crucial part of the speech signal processing. In order to improve the accuracy of voice activity detection under the high-noisy environment, an algorithm named distance entropy is proposed. The algorithm firstly enhances speech with short time spectral amplitude, and then utilizes the robustness of cepstral distance and spectral entropy. The experimental results show that this method performs well on anti-noise, and is more accurate to detect the endpoint in low SNR environment.},
}

