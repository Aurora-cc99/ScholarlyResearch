  annotation = {中文辅助译名：用于可穿戴心电图跨人群情绪识别的可转移混合卷积曼巴网络},
  abstract = {Leveraging electrocardiogram (ECG) signals for emotion recognition represents a core challenge in affective computing, particularly in achieving robustness across diverse demographic groups (such as older adults with mild cognitive impairment). This challenge is rooted in three key issues: the complex multi-scale nature of ECG signals, high inter-individual physiological variability, and the need for computationally efficient temporal modeling for IoT applications. To address these issues systematically, this study proposes HCMNet, a novel, physiologically-inspired hybrid Convolutional-Mamba network. HCMNet’s architecture is problem-driven: a hierarchical scale-aware convolutional module captures multi-scale features analogous to HRV analysis; an innovative Non-Local Channel Convolutional Attention (NLCCA) mechanism mitigates inter-individual variability by learning to reshape the feature space; and a Mamba2-based Bidirectional State-Space Model (BiSSM) efficiently models temporal dynamics with linear complexity. Additionally, we validated the model on a self-built Wearable ECG emotion dataset comprising healthy elderly individuals and patients with mild cognitive impairment (MCI), as well as on public datasets WESAD and DREAMER. Experimental results demonstrate that our proposed HCMNet, through its synergistic hybrid architecture, effectively extracts robust emotional features. It not only achieves state-of-the-art performance on public benchmarks but also exhibits strong ro},
}

@misc{panorama_1d59543d7eba_16c720b07b376d0e,
  title = {CM-REACT: Condition-Modulated Motion Diffusion for REACT2026 Multiple Appropriate Facial Reaction Generation},
  author = {Tongjuan Ji and Peng Wang and Shurong Feng and Xiaofeng Liu},
  year = {2026},
  doi = {10.1145/3767308.3837717},
  url = {https://doi.org/10.1145/3767308.3837717},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：CM-REACT：用于 REACT2026 多种适当面部反应生成的条件调制运动扩散},
  abstract = {Listener facial reaction generation aims to synthesize timely and appropriate listener feedback from speaker-side conversational cues. This paper presents CM-REACT, a condition-modulated motion diffusion system for the REACT2026 MAFRG tasks. CM-REACT adds a lightweight Condition Modulation Block to a speaker-conditioned diffusion backbone. The block summarizes audio, facial affect, 3DMM motion, and latent condition tokens into a compact context representation, then gates residual adapters on each condition stream before denoising. During training, an auxiliary objective predicts listener-side MUSE EEG band-power features to regularize this modulation representation. EEG features are not used as generator inputs at inference, so the deployed system still relies only on the standard speaker-side streams required by the challenge protocol. Under the official generic face-metric protocol, CM-REACT obtains FRCorr scores of 0.7446 in offline testing and 0.7386 in online testing. Transferring the same system to personalised MAFRG gives FRCorr scores of 0.7404 offline and 0.6467 online. Our team won first place in the organizer-announced REACT 2026 Challenge Ranking. Ablations show that active condition modulation is the main source of the correlation gain, while the auxiliary EEG regularizer further improves distributional and frame-level metrics when paired with the modulation pathway.},
}

