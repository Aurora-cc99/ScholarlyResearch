  annotation = {中文辅助译名：使用高动态范围图像进行亮度测量的不同校准策略的评估},
  abstract = {High Dynamic Range Imaging (HDRI) is an increasingly popular technique for studying the lighting environment through luminance maps. However, a thorough calibration process is necessary to retrieve accurate photometric measurements when generating HDR images using commercially affordable equipment like cameras. This paper aims to provide an overview of the most commonly used luminance calibration strategies and evaluate their effectiveness in luminance measurements. Seven strategies were examined in two experiments consisting of four scenes with vary6ing levels of lighting disparity on the training patches and the testing patches. The LDR images were taken by two professional digital single-lens reflex cameras fitted with the standard zoom lens and merged into HDR images using the software Photomatix. The results indicate the much simpler sRGBD65 method using a reliable standard target as the reference could deliver a reasonable luminance measurement accuracy which is within 10% even for scenes with large luminance difference on the training and testing patches. Although the more complex camera-specific CTM methods can enhance colorimetric accuracy, they do not significantly improve photometric accuracy. Moreover, it was demonstrated that a linear regression model with an intercept, utilizing pixel luminance extracted from multiple grayscale patches in the HDR image, can serve as a potential solution for checking the significance of the scattering effect and providing a refer},
}

@misc{panorama_1d59543d7eba_bb7ce39b90708f32,
  title = {Tracking Object's Pose via Dynamic Tactile Interaction},
  author = {Qiguang Lin and Chaojie Yan and Qiang Li and Yonggen Ling and Wangwei Lee and Yu Zheng and Zhaoliang Wan and Bidan Huang and Xiaofeng Liu},
  year = {2024},
  doi = {10.1142/S0219843623500214},
  url = {https://doi.org/10.1142/S0219843623500214},
  howpublished = {Int. J. Humanoid Robotics},
  annotation = {中文辅助译名：通过动态触觉交互跟踪物体的姿势},
  abstract = {It is a challenging task to localize and track an in-hand object in robotic domain. Researchers were mainly using the vision as major modality for extracting object’s pose. The vision approaches are fragile when the object is occluded by the robotic arm and hand. To this end, we propose a tactile-based DTI-Tracker (tracking object’s pose via Dynamic Tactile Interaction) approach and formalize the object’s tracking as a filter problem. An Extended Kalman Filter (EKF) is used to estimate the in-hand object pose exploiting the high spatial resolution tactile feedback. Given the initial estimation error, the proposed approach rapidly converges the estimation result to the real pose and the statistic evaluation shows the robustness of the proposed approach. We evaluate this method in physics simulation and real multi-fingered grasping setup while the object is static and movable. The proposed method is a potential tool to foster future research on dexterous manipulation using multifingered robotic hand.},
}

@misc{panorama_1d59543d7eba_89eccf39ad396153,
