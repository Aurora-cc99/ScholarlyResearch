@misc{panorama_1d59543d7eba_59691ee633bb9883,
  title = {Improvement for One-against-one Multi-class SVM in Speech Recognition Application},
  author = {Xiaofeng Liu},
  year = {2013},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=KXJS201310015},
  howpublished = {Science Technology and Engineering},
  annotation = {中文辅助译名：语音识别应用中一对一多类SVM的改进},
  abstract = {For one-against-one multi-classification method of Support Vector Machine(SVM),all sub-classifiers that have been constructed during training phase are executed,which takes longer predicting time.This shortcoming greatly limits its application in the identification of large-scale datasets.Hence an improved one-against-one multi-class support vector machine is proposed.In the middle of the testing phase,statistics votes of all the categories,the lower of which will be removed,and the sub-classifiers constituted by these categories is not caculated.In this case,sub-classifiers can be reduced effectively.Finally,the improved method is applied to speech recognition system with noise immunity.The experiment results show that the method has certain advantages.},
}

