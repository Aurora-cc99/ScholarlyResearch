  author = {Shuqiang Wang and Yi Guo and Yihang Dong and Yanyan Shen and Zhiguo Zhang and Albert C. Cheung and Jiangbo Pu and Sheng-Hua Zhong and Raymond Kai-Yu Tong and Ye Li and Michael Kwok-Po Ng and Kim-Fung Tsang and Guanhua Ren},
