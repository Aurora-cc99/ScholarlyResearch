@misc{liang_zhen_5ebdd0e7418b,
  title = {The Real Time EEG Phase Locked Feedback Control for Alpha Amplitude and Frequency Regulation: An OpenBCI Implementation},
  author = {Xinyue Wang and Shaohui Hou and Li Zhang and Linling Li and Zhen Liang and Zhiguo Zhang and Gan Huang},
