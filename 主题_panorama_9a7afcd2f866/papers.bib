  howpublished = {Proceedings of the 2026 6th International Conference on Bioinformatics and Intelligent Computing},
  annotation = {中文辅助译名：SMOAgent：面向空间多组学整合与智能优化的分层科学智能体},
  abstract = {Spatial multi-omics (SMO) technologies enable simultaneous profiling of multiple molecular modalities with preserved spatial coordinates, offering insight into tissue organization and cellular microenvironments. However, SMO integration remains a complex multi-stage pipeline that must orchestrate heterogeneous tools and contend with intricate hyperparameter optimization (HPO). We introduce SMOAgent, a hierarchical agent that automatically integrates and analyzes spatial multi-omics data through specialized roles operating under a unified Plan–Execute–Review–Reflect paradigm. To address the fundamental algorithmic challenge of HPO within complex biological pipelines, we develop Agentic-Parallel Bayesian Optimization (APBO), a parallel Bayesian optimizer that couples tree-guided agent planning and reflection with Gaussian-process surrogates under adaptive tolerance, providing no-regret convergence. A principled spatial downsampling schedule further boosts APBO’s efficiency. Experiments on human lymph node and mouse brain datasets show that SMOAgent matches or exceeds manual integration in spatial domain identification, while making the overall workflow significantly faster than standard manual processing. Within APBO, spatial downsampling yields 6–70 × efficiency gains and enables robust parameter transfer with success rates up to 80%. Taken together, this work demonstrates that SMOAgent makes SMO integration practical, reliable, and accessible to biologists without programming},
}

@misc{panorama_9a7afcd2f866_7fa80c78f0eabd16,
  title = {SpikCommander: A High-performance Spiking Transformer with Multi-view Learning for Efficient Speech Command Recognition},
  author = {Jiaqi Wang and Liutao Yu and Xiongri Shen and Sihang Guo and Chenlin Zhou and Leilei Zhao and Yi Zhong and Zhiguo Zhang and Zhengyu Ma},
  year = {2026},
  doi = {10.1609/AAAI.V40I3.37194},
  url = {https://doi.org/10.1609/AAAI.V40I3.37194},
  howpublished = {AAAI},
  annotation = {中文辅助译名：SpikCommander：具有多视图学习功能的高性能尖峰Transformer，可实现高效的语音命令识别},
  abstract = {Spiking neural networks (SNNs) offer a promising path toward energy-efficient speech command recognition (SCR) by leveraging their event-driven processing paradigm. However, existing SNN-based SCR methods often struggle to capture rich temporal dependencies and contextual information from speech due to limited temporal modeling and binary spike-based representations. To address these challenges, we first introduce the multi-view spiking temporal-aware self-attention (MSTASA) module, which combines effective spiking temporal-aware attention with a multi-view learning framework to model complementary temporal dependencies in speech commands. Building on MSTASA, we further propose SpikCommander, a fully spike-driven transformer architecture that integrates MSTASA with a spiking contextual refinement channel MLP (SCR-MLP) to jointly enhance temporal context modeling and channel-wise feature integration. We evaluate our method on three benchmark datasets: the Spiking Heidelberg Dataset (SHD), the Spiking Speech Commands (SSC), and the Google Speech Commands V2 (GSC). Extensive experiments demonstrate that SpikCommander consistently outperforms state-of-the-art (SOTA) SNN approaches with fewer parameters under comparable time steps, highlighting its effectiveness and efficiency for robust speech command recognition.},
}

@misc{panorama_9a7afcd2f866_7bfb55f1053710d6,
  title = {SSVEP-freeTUNE: Sample-wise Domain Gating with Dual-Template Priors for Calibration-Free SSVEP Decoding},
  author = {Kaisong Hu and Leilei Zhao and Fengcheng Wu and Yuxin Liu and Zhiguo Zhang and Zhenxi Song},
  year = {2026},
  doi = {10.1109/IJCNN69854.2026.11728657},
  url = {https://doi.org/10.1109/IJCNN69854.2026.11728657},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：SSVEP-freeTUNE：具有双模板先验的样本域门控，用于免校准 SSVEP 解码},
  abstract = {Calibration-free decoding is essential for cross-subject use of steady-state visual evoked potential (SSVEP)-based brain–computer interfaces (BCIs). However, generalization is still constrained by inter-subject variability, likely reflecting insufficient exploitation of the EEG’s multi-domain character-istics. To address these challenges, we propose an adaptive domain-gated dual-template neural entrainment framework for calibration-free SSVEP decoding, termed SSVEP-freeTUNE. The gating mechanism adaptively balances spectral, temporal, and spatial representations. In parallel, neural entrainment priors implemented with dual templates combine explicit harmonic constraints and robust cross-subject response morphology, anchoring the model with physiologically grounded cues. At the decision level, frequency-locked correlation scores and fused multi-domain features are jointly integrated, bridging model-driven priors and data-driven representations. Experiments on the Benchmark and BETA datasets under leave-one-subject-out protocols demonstrate that SSVEP-freeTUNE achieves state-of-the-art accuracy and information transfer rate, advancing calibration-free SSVEP BCIs toward practical deployment.},
}

@misc{panorama_9a7afcd2f866_orcid_54b867fc8b692eb7,
  title = {STAMBRIDGE: Spectral-Temporal Amplitude-aware Mid-Feature Bridge for EEG Visual Decoding},
  author = {Jiahe Meng and Weiming Zeng and Yueyang Li and Bo Chai and Hongjie Yan and Zhiguo Zhang and Wai Ting Siok and Nizhuan Wang},
  year = {2026},
  doi = {10.1109/JSEN.2026.3737462},
  url = {https://doi.org/10.1109/JSEN.2026.3737462},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：STAMBRIDGE：用于脑电视觉解码的频谱—时间振幅感知中间特征桥},
  abstract = {Electroencephalography (EEG) visual decoding remains challenging due to the modality gap between low-SNR neural signals and highly structured vision--language spaces, making direct cross-modal alignment unstable. To address this, we propose STAMBRIDGE, a versatile two-stage framework that sequentially tackles feature conditioning and cross-modal alignment. First, we introduce a Spectral-Temporal Amplitude-aware Modulation (STAM) to extract well-conditioned EEG representations. By replacing hard frequency masking with amplitude-derived soft channel weighting and multi-scale temporal convolutions, STAM explicitly preserves frequency-aware transients while reducing the risk of time-domain ringing artifacts. Building upon these robust neural features, we further introduce a model-agnostic Mid-Feature Semantic Bridge (MFSB) that constructs a regularized intermediate space through directed cross-modal interactions, enabling staged distillation and more stable semantic alignment. Experiments on the THINGS-EEG benchmark show competitive 200-way zero-shot retrieval performance, with 34.50\% Top-1 and 65.95\% Top-5 accuracy. In addition, embeddings learned by STAMBRIDGE produce semantically coherent image reconstructions with a diffusion model, demonstrating robust EEG-to-vision semantic alignment. The code is available at: https://github.com/thabeatmjh/STAMBRIDGE.},
}

