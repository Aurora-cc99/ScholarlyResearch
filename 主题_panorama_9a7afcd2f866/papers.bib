@misc{panorama_9a7afcd2f866_b3967d16f94693d6,
  title = {Reference Segmentation Network Based on Feature Interaction Enhancement},
  author = {Yuhang Zhang and Zhiguo Zhang},
  year = {2025},
  doi = {10.1109/icivc66358.2025.11200270},
  url = {https://doi.org/10.1109/icivc66358.2025.11200270},
  howpublished = {International Conference on Image, Vision and Computing (ICIVC)},
  annotation = {中文辅助译名：基于特征交互增强的参考分割网络},
  abstract = {Reference segmentation is a fundamental task in image understanding, aiming to accurately recognize and classify each part of an image to achieve precise object-level segmentation. Despite the development of numerous segmentation approaches, challenges such as large-scale variations among objects, ambiguous category boundaries, and uneven object distributions persist, making it difficult to enhance the discriminative capability of models for complex categories. To address this problem in the context of fewshot image segmentation, we propose a reference-guided feature interaction enhancement module (RGFIM), along with a feature fusion module, to enhance the model's perception and representation of target regions. By incorporating support images and their corresponding masks, the proposed module guides the model to focus on feature regions that are semantically related to the reference objects. We integrate this module into the DINOv model 1 and introduce a novel evaluation protocol. Extensive experiments conducted on the COCO-20i dataset demonstrate that our approach significantly improves segmentation accuracy and yields promising results.},
}

