@misc{panorama_9a7afcd2f866_d50e242e2ee6a1e5,
  title = {Long-range infra-sound acoustic signaling in human in vivo},
  author = {Xiaoyue Chang and Li Zhang and Xiguang Wei and Zengfu Peng and Zhiguo Zhang and Zhong Liu and Pei-Wen Li and P. T. Lai and S. C. Chan and Edward S. Yang},
