@misc{panorama_shouyan_wang_3b8dfbe1d9476a3c,
  title = {EEG Responses to Transcranial Magnetic Stimulation with Different Intensities over the Motor Cortex *},
  author = {Chao Chen and Yong Zhang and Changbin Liu and Yishuang Zhao and Wenxuan Yang and Ximo Zhu and Shuang Qiu and Shengpei Wang and Huiguang He},
  year = {2025},
  doi = {10.1109/embc58623.2025.11253121},
  url = {https://doi.org/10.1109/embc58623.2025.11253121},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：运动皮层对不同强度经颅磁刺激的脑电图反应 *},
  abstract = {Transcranial Magnetic Stimulation (TMS) is a non-invasive brain stimulation technique that can modulate neural activity. While previous studies have primarily employed single-intensity TMS protocols, the impact of varying stimulation intensities (SI) on TMS-induced brain activity remains poorly understood. This study aims to investigate the characteristics of electroencephalogram (EEG) responses under different TMS intensities. Twenty-four healthy participants underwent TMS at varying intensities (sham stimulation, 80%, 100%, and 120% of the resting motor threshold (rMT)) over the left motor cortex, with concurrent EEG recording during stimulation. TMS-induced neural changes were comprehensively evaluated through multiple parameters, including EEG amplitude, oscillatory power, and phase characteristics, using TMS-evoked potentials (TEPs), event-related spectral perturbation (ERSP), and inter-trial coherence(ITC) analyses. The results revealed significant intensity-dependent changes in brain responses across multiple dimensions of analysis. Specifically, weaker stimulation (80% rMT) primarily induced phase-specific changes (ITC), whereas stronger stimulations (100% and 120% rMT) elicited more comprehensive neural responses, including significant alterations in TEP, ERSP and ITC. These findings demonstrate a clear dose-response relationship between TMS intensity and the magnitude of neural modulation, with higher intensities producing more pronounced changes in brain activity.},
}

@misc{panorama_shouyan_wang_c0c25f4b4a636e55,
  title = {Intensity-Dependent Alterations of EEG Functional Connectivity Networks Induced by Repetitive Transcranial Magnetic Stimulation},
  author = {Chao Chen and Yuheng Liu and Shengpei Wang and Kangning Wang and Shuang Qiu and Huiguang He},
  year = {2025},
  doi = {10.1088/1742-6596/3147/1/012021},
  url = {https://doi.org/10.1088/1742-6596/3147/1/012021},
  howpublished = {Journal of Physics Conference Series},
  annotation = {中文辅助译名：重复经颅磁刺激引起的脑电图功能连接网络的强度依赖性改变},
  abstract = {Abstract Repetitive transcranial magnetic stimulation (rTMS) is a non-intrusive approach that alters the responsiveness of the brain’s cortex. This research is designed to investigate the aftereffects on EEG following the application of low-frequency rTMS at different stimulation intensities. Twenty healthy subjects received rTMS at different intensities (sham, 80%, 100%, and 120% of the resting motor threshold (rMT)) over the left motor cortex. Resting-state EEG with eyes open and Nine-Hole Peg Test (NHPT) behavioral data were recorded before and after stimulation. Functional connectivity and network properties were assessed via the Phase Synchronization Index (PSI) to study the aftereffects of rTMS. We conducted a comprehensive assessment of the changes induced by rTMS, including brain network weights, the distribution of hub nodes, and the analysis of corresponding node efficiency (NE) and node clustering coefficients (NCC). The results showed that stronger stimulation (100% and 120% rMT) induced more comprehensive neural responses compared to weak stimulation (80% rMT) and sham, including significant changes in PSI weights, NE, NCC, and more pronounced correlations with behavioral outcomes. These findings indicate that the administration of high-intensity low-frequency rTMS produced more substantial changes in functional connectivity and network properties, and that functional connectivity can serve as a potential biomarker for different rTMS-evoked brain responses.},
}

