@misc{jufeng_yang_a54f0d1f892bfca1,
  title = {D2S: Dynamic Distribution Supervision for Multi-Label Facial Expression Recognition},
  author = {Lijuan Wang and Haiying Wu and Xin Zhang and Jufeng Yang and Ning Jiang},
  year = {2022},
  doi = {10.1109/ICME52920.2022.9859687},
  url = {https://doi.org/10.1109/ICME52920.2022.9859687},
  howpublished = {ICME},
  annotation = {中文辅助译名：D2S：多标签面部表情识别的动态分布监督},
  abstract = {Due to facial images usually evoking multiple emotions with different intensities, there exists much ambiguity in facial expression recognition (FER). Previous methods jointly optimize multi-label learning (MLL) and label distribution learning (LDL) to suppress ambiguity, which have achieved excellent performance. However, the different convergence speed of MLL and LDL make the model easily over-fitting. To address this problem, we propose a dynamic distribution supervision (D2S) method, where the label distribution information is introduced as auxiliary supervision for multilabel classification. Specifically, we develop a multi-task framework in which MLL and LDL are optimized simultaneously. The losses are dynamically weighted to overcome the inconsistency of inter-losses optimization between the two tasks. Extensive experiments on the largest benchmark dataset, i.e., RAF-ML, demonstrate the superiority of the proposed method.},
}

@misc{jufeng_yang_b318fffd64375d5c,
  title = {EASE: Robust Facial Expression Recognition via Emotion Ambiguity-SEnsitive Cooperative Networks},
  author = {Lijuan Wang and Guoli Jia and Haiying Wu and Jufeng Yang and Ning Jiang},
  year = {2022},
  doi = {10.1145/3503161.3548005},
  url = {https://doi.org/10.1145/3503161.3548005},
  howpublished = {ACM Multimedia},
  annotation = {中文辅助译名：EASE：通过情绪模糊-敏感合作网络进行鲁棒的面部表情识别},
  abstract = {Facial Expression Recognition (FER) plays a crucial role in the real-world applications. However, large-scale FER datasets collected in the wild usually contain noises. More importantly, due to the ambiguity of emotion, facial images with multiple emotions are hard to be distinguished from the ones with noisy labels. Therefore, it is challenging to train a robust model for FER. To address this, we propose Emotion Ambiguity-SEnsitive cooperative networks (EASE) which contain two components. First, the ambiguity-sensitive learning module divides the training samples into three groups. The samples with small-losses in both networks are considered as clean samples, and the ones with large-losses are noisy. Note for the conflict samples that one network disagrees with the other, we distinguish the samples conveying ambiguous emotions from the ones with noises, using the polarity cues of emotions. Here, we utilize KL divergence to optimize the networks, enabling them to pay attention to the non-dominant emotions. The second part of EASE aims to enhance the diversity of the cooperative networks. With the training epochs increasing, the cooperative networks would converge to a consensus. We construct a penalty term according to the correlation between the features, which helps the networks learn diverse representations from the images. Extensive experiments on 6 popular facial expression datasets demonstrate that EASE outperforms the state-of-the-art approaches.},
}

