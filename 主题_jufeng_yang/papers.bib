  author = {Yubeen Lee and SangEun Lee and Junyeop Cha and Jufeng Yang and Eunil Park},
  year = {2026},
  doi = {10.1145/3799682.3840715},
  url = {https://doi.org/10.1145/3799682.3840715},
  howpublished = {ACM International Conference on Information and Knowledge Management (CIKM)},
  annotation = {中文辅助译名：SAVER：视觉语言模型中视觉情感推理的选择性和自适应多视图路由},
  abstract = {Emotions elicited by visual content are formed through the interaction of multiple visual cues rather than a single visual element, and their importance varies depending on the context. This characteristic makes visual emotion analysis not merely a classification problem but a reasoning task that requires the selective integration of diverse visual cues. Existing approaches tend to represent images using a unified feature representation and fail to explicitly model the contributions of different visual cues. To capture the multifaceted nature of emotional cues, we propose SAVER, a framework for query-conditioned visual emotion reasoning. SAVER decomposes visual information into multiple view-specific representations corresponding to distinct aspects, such as facial expressions, scenes, objects, and colorfulness, enabling the explicit modeling of each cue. A semantic-aware routing mechanism dynamically selects and integrates the most relevant views by jointly considering the visual context and query semantics. This selective integration is combined with learnable soft prompts to enable structured emotion reasoning within a vision-language model. Extensive experiments on diverse emotion datasets demonstrate that the proposed method consistently outperforms both vision-based and VLM-based approaches. Qualitative analysis provides interpretable insights into how different visual cues contribute to emotion prediction, highlighting the effectiveness of SAVER in improving both its p},
}

