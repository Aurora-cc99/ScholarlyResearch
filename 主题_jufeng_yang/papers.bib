  abstract = {In this paper, we present one of the first deception detection frameworks that leverages audio-visual cognitive load features without requiring physiological sensors. We introduce AVDDCL, a fully automated pipeline that extracts cognitive load from videos and integrates it into a multimodal deception classifier. Furthermore, we propose a cognitive load aware loss that adaptively emphasizes cognitively demanding, hard-to-detect cases to better capture subtle deceptive cues. Experiments across benchmark datasets demonstrate state-of-the-art performance, confirming the effectiveness of audio-visual cognitive load features for robust deception detection.},
}

@misc{jufeng_yang_c10bdc2e18d61746,
  title = {Cross-Coordinate Correspondence Pruning for Image-to-Point Cloud Registration},
