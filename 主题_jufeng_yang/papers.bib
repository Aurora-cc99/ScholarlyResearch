@misc{jufeng_yang_6467c4e0333d1eb6,
  title = {Where You Focus Matters: High-Complexity Region-Aware Context Refining for Real-Time Semantic Segmentation},
  author = {Xin Zhang and Teodor Boyadzhiev and Jin Wu and Chi‐Man Vong and Jufeng Yang},
  year = {2026},
  doi = {10.1109/tmm.2026.3712893},
  url = {https://doi.org/10.1109/tmm.2026.3712893},
  howpublished = {IEEE Transactions on Multimedia},
  annotation = {中文辅助译名：您关注的重点是：用于实时语义分割的高复杂性区域感知上下文细化},
  abstract = {Image complexity has shown powerful potential in improving the trade-off between accuracy and efficiency of real-time semantic segmentation. Previous works integrate the complexity maps as loss weights or attention features for accuracy improvement. However, these methods fail to account for the varying demands of context modeling across regions with different complexity. In particular, excessive context refinement in low-complexity regions may overwhelm the weak local cues, resulting in mis-segmentation even within simple regions. To address the challenges above, we focus on high-complexity region awareness for context refining, and thereby develop a two-branch High-complexity Region-aware Context refining Network (HRCNet). A complexity branch accounts for exploring specific high-complexity regions through binary mask prediction. The predicted high-complexity region mask is then utilized in the segmentation branch to refine context features of corresponding regions through our proposed Region Masked Attention (RMA) module. Specifically, the binary mask is multiplied with context features in an element-wise manner to extract the corresponding high-complexity regions. These features are subsequently enhanced through a self-attention mechanism to enrich semantic information and feature interaction. The extensive experiments on the Cityscapes and CamViD datasets demonstrate the effectiveness and superiority of our method.},
}

