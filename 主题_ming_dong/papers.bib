  abstract = {Abnormal gamma oscillations in major depressive disorder (MDD) have been repeatedly reported. Auditory steady-state response (ASSR), induced by the periodic auditory stimuli with the frequency and phase synchronized response, is the most common brain response to gamma oscillations in mental disorders. However, such researches in MDD remain scarce. Here, we attempted to explored the abnormal neural oscillations in MDD by analyzing gamma Inter-trial phase coherence (ITC) and theta-phase/gamma-amplitude coupling (TGC) under the ASSR task. 40Hz-ASSR electroencephalography data were recorded from 30 MDD and 33 healthy controls (HC). Then we calculated gamma-ITC and TGC in bilateral temporal regions, finally confirmed the separability of these indicators with inter-group significance for MDD by Support Vector Machine (SVM). Compared with HC, our results demonstrated MDD exhibited a decreased right-lateralization of gamma-ITC, and a decreased right temporal TGC with a reversed hemispheric asymmetry, which may reveal temporal impairments of MDD, particularly the reduced right-side dominance, when they performing the auditory task. Besides, the joint feature of gamma-ITC and TGC showed the information complementarity with the classification sensitivity 90.0%, specificity 70.1% and accuracy 81.8%, comparing to the single feature. Our findings suggested the altered hemispheric lateralization under 40Hz-ASSR may be a neurophysiological feature of MDD, providing novel insights into pathol},
}

@misc{ming_dong_8e4dfdab1d42,
