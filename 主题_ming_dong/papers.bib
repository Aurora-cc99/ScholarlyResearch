  year = {2026},
  doi = {10.1016/j.neubiorev.2026.107093},
  url = {https://doi.org/10.1016/j.neubiorev.2026.107093},
  howpublished = {Neuroscience and biobehavioral reviews},
  annotation = {中文辅助译名：导航罗盘被破坏：空间导航缺陷的病理生理机制和临床干预},
  abstract = {Spatial navigation is a higher-order integrative cognitive ability that supports environmental orientation, goal-directed route selection, and adaptive locomotion by integrating spatial memory, multisensory cues, attention, and executive control. Neural systems supporting navigation are also vulnerable to aging and neurodegenerative disease, making navigation a useful domain for linking basic mechanisms with clinically measurable functional impairment. This review summarizes spatial-navigation mechanisms across multiple levels. At the cognitive level, navigation depends on interacting processes including spatial representation, path integration, reference-frame transformation, landmark use, and route planning. At the network level, hippocampal-entorhinal, retrosplenial-parietal, scene-selective, and prefrontal systems contribute complementary functions. At the cellular level, place-, grid-, head-direction-, speed-, and boundary-related representations encode position, heading, self-motion, environmental geometry, and prospective behavior. Clinical and neuroimaging studies indicate that navigation impairment is associated with structural and functional abnormalities, with the strongest diagnostic evidence currently arising from Alzheimer's disease and its prodromal stages. VR-based behavioral assessment and electrophysiological approaches provide complementary means of characterizing navigation phenotypes: VR enables controlled, repeatable, process-sensitive tasks, whereas int},
}

@misc{ming_dong_c3ca8ce639f5,
  title = {Circuit Topology Shapes the Mapping Between Excitatory-Inhibitory Input Composition and Aperiodic Spectral Slope},
  author = {Ziliang Cai and Yuan Chang and Xin Yu and Jiarong Liu and Jian Zhang and Xinmeng Guo and Shuang Liu and Dong Ming},
