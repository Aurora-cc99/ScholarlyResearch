@misc{ming_dong_5d26b96a9d9b,
  title = {Acupuncture and acupressure with improved cancer-related depression of retrospective studies},
  author = {Feiqing Wang and Jianing Zhao and Yanju Li and Xu Yang and Dan Wu and Bo Yang and Chike Zhang and Zhixu He and Liang Du and Xiaodong Zhu and Dong Ming and Yang Liu and Dongxin Tang},
