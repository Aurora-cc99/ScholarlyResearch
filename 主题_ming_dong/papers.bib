@misc{ming_dong_f2d7dcbae8f2,
  title = {The processing network of high-frequency acoustoelectric signal in the living rat brain},
  author = {Xizi Song and Peishan Huang and Xinrui Chen and Minpeng Xu and Dong Ming},
  year = {2022},
