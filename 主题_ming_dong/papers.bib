  annotation = {中文辅助译名：情绪信息招募特定的神经动力学来支持分层认知控制。Soc Cogn Affect Neurosci},
  abstract = {Hierarchical cognitive control supports flexible behavior guided by abstract goals; however, how emotional information modulates the underlying neural dynamics across hierarchy levels remains unclear. To fill this gap, we designed emotional and non-emotional hierarchical cognitive control paradigms, with hierarchical demands manipulated by varying abstraction levels of task rules. Forty-one participants performed the experiment, with electroencephalography (EEG) and eye-tracking data simultaneously recorded. By aligning EEG with eye-tracking data through time-locked analyses, we characterized oscillatory dynamics at each hierarchy level, integrating single-frequency (power spectral density, PSD) and cross-frequency (phase-amplitude coupling, PAC) features. Results showed that increasing hierarchical demands enhanced PSD across multiple frequency bands in both emotional and non-emotional contexts. Both contexts also exhibited enhanced narrowband delta-beta PAC with increasing abstraction. Importantly, emotional hierarchical demands additionally elicited PAC patterns beyond those in non-emotional contexts, such as delta-alpha and alpha-beta couplings. Topographical clustering revealed that emotion-related PAC activity predominated in fronto-parietal and temporo-occipital regions. These findings suggest that while the brain utilizes general neural dynamics for processing abstract goals, emotional demands recruit additional neural resources to support it. Beyond elucidating how t},
}

@misc{ming_dong_9d12bb763c64,
  title = {Altered Neural Oscillatory Coupling Reveals Cognitive Control Deficits with Hierarchical Characteristics and Emotional Specificity in Major Depressive Disorder},
  author = {Wenquan Zhang and Ying Gao and Xinyao Li and Meijuan Li and Yuan Liu and Jie Li and Sitong Chen and Shuang Liu and Dong Ming},
  year = {2026},
  doi = {10.1016/j.bpsc.2026.10.011},
  url = {https://doi.org/10.1016/j.bpsc.2026.10.011},
  howpublished = {Biological psychiatry. Cognitive neuroscience and neuroimaging},
  annotation = {中文辅助译名：神经振荡耦合的改变揭示了重度抑郁症中具有层次特征和情绪特异性的认知控制缺陷。 Biol 精神病学 Cogn Neurosci 神经影像学},
  abstract = {BACKGROUND: Cognitive control deficits are a prevalent feature of major depressive disorder (MDD) and are influenced by emotional contexts. However, it remains unclear whether these deficits specifically exist at particular hierarchical levels of cognitive control and whether they are selectively exacerbated under distinct emotional contexts. Furthermore, the neural mechanisms underlying such deficits and their association with depressive symptoms remain to be further elucidated. METHODS: To fill these gaps, two experiments were conducted. In Experiment 1, 54 MDDs and 41 healthy controls (HCs) performed emotional and non-emotional hierarchical cognitive control tasks. Hierarchical demands were manipulated using low- and high-abstraction rules. Based on hierarchy- and emotion-specific deficits identified in Experiment 1, Experiment 2 (34 MDDs; 28 HCs) introduced rule memory set-size manipulation to test whether the deficit generalized to other hierarchical cognitive control subprocesses. Electroencephalography and eye-tracking were simultaneously recorded. Phase-amplitude coupling (PAC) quantified cross-frequency interactions subserving cognitive control. RESULTS: Delta-beta PAC was selectively reduced in MDDs compared with HCs during high-abstraction conditions under negative emotional contexts, but not in low-abstraction conditions or other contexts. Under the same conditions, MDDs also failed to show the typical memory-related increase in theta-gamma PAC. Moreover, emotion },
}

@misc{ming_dong_09923c9d656771aa,
  title = {Impact of experimentally elevated CO₂ concentrations and temperature on cognitive function: An EEG-based study under constant ventilation},
  author = {Yukai Yang and Huajiang Dong and Nan Wang and Jiaxing Zhang and Zhen Zhang and Quan Sun and Weiran Zhang and Junchi Wang and Jing Liu and Yeming Liu and Dongbin Wang and Guangbo Qu and Guibin Jiang and Liqun Chen and Dong Ming},
  year = {2026},
  doi = {10.1016/j.ecoenv.2025.119578},
  url = {https://doi.org/10.1016/j.ecoenv.2025.119578},
  howpublished = {Ecotoxicology and environmental safety},
  annotation = {中文辅助译名：实验性升高的二氧化碳浓度和温度对认知功能的影响：持续通气条件下基于脑电图的研究},
  abstract = {Global warming is expected to alter indoor thermal environments and indoor air composition, yet the specific effects of these changes on learning and cognition remain insufficiently understood. In this climate chamber study, we examined the combined effects of experimentally elevated indoor CO₂ concentrations (500 and 5000 ppm, added from a gas cylinder under constant ventilation) and temperatures (22 °C and 28 °C) on cognitive-related outcomes. Twenty-four participants completed a within-subject protocol involving two neuropsychological tasks (Stroop and delayed-matching-to-sample), subjective evaluations, physiological measurements, and electroencephalography (EEG). EEG features were further used to construct a deep learning-based Cognitive Comfort Model (CCM). Significant interactions between CO₂ level and temperature were observed for noise acceptability, thermal comfort, and EEG power in the alpha, theta, and delta bands, whereas behavioral task performance showed only limited changes across conditions. These results suggest that combined thermal-CO₂ stress can modulate subjective comfort and neural indicators of cognitive load even when overt performance is largely preserved. Our findings help to clarify the specific effects of elevated CO₂ and temperature, independent of general poor ventilation, and support the refinement of indoor environmental control strategies aimed at protecting cognitive well-being in warming climates.},
}

