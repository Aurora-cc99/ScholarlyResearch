  abstract = {Aperiodic ([Formula: see text]) spectral components are widely interpreted as markers of excitation-inhibition (E/I) balance, but this interpretation spans levels from synaptic currents and microcircuit spiking to population field potentials. Whether macroscopic spectral slope can index microcircuit-level E/I input independently of circuit architecture remains unresolved. This study introduces a connectome- and morphology-constrained framework that embeds electron-microscopy-reconstructed cortical microcircuits in near-critical propagation dynamics and generates field potentials under fixed synaptic, membrane, and forward-modeling parameters. By linking controlled synaptic E/I input, microcircuit spiking propagation, and macroscopic spectra, the framework directly tests the explanatory level of the aperiodic exponent. Across matched E/I regimes, the strength of the E/I input-[Formula: see text] relationship differed between biological and topology-randomized networks, yielding a significant E/I input × topology interaction. To test whether this architecture-dependent mapping extends to biological systems, paired cortical ECoG and thalamic EThG recordings from juvenile pigs were analyzed. Under the same systemic propofol perturbation, exponent changes were stronger in thalamus than cortex and remained so after accounting for global state shifts, baseline spectra, and distance from criticality. These findings identify circuit architecture as a determinant of how microcircuit E/},
}

@misc{ming_dong_15405aae6e1c,
  title = {A multi-paradigm and longitudinal EEG dataset including the "sixth-finger" and "affected-hand" motor imagery of stroke patients},
  author = {Zhuang Wang and Yuan Liu and Shuaifei Huang and Wenlai Wu and Huimin Huang and Zhuolan Gui and Zhaoqi Li and Jun Guo and Hao Zhang and Minpeng Xu and Dong Ming},
  year = {2026},
  doi = {10.1038/s41597-026-07787-y},
  url = {https://doi.org/10.1038/s41597-026-07787-y},
  howpublished = {Scientific data},
  annotation = {中文辅助译名：多范式和纵向脑电图数据集，包括中风患者的“第六指”和“受影响的手”运动想象。 Sci Data},
  abstract = {Motor imagery-based brain-computer interface (MI-BCI) applications in stroke rehabilitation aim to match brain activity with real-time feedback, thereby establishing closed-loop neural pathways and providing a basis for evaluating patients' neuroplasticity changes. Thus, constructing EEG datasets under MI paradigms is crucial for optimizing MI-BCI systems and understanding the neural rehabilitation process. However, the current limitations of single MI paradigms and the lack of relevant EEG datasets may restrict the accurate interpretation and effective application in stroke rehabilitation. This study collected EEG data from 24 stroke patients during MI tasks, including a novel "sixth finger" MI and an affected-hand MI paradigm. The dataset comprehensively covers the complete longitudinal stages of stroke rehabilitation: pre-training, post-training, and follow-up periods. The data materials include: (1) raw EEG data, (2) preprocessed data, and (3) patient clinical information. Preliminary analysis using classical machine learning algorithms (CSP + SVM and CSP + LDA) demonstrated an average classification accuracy between the two MI paradigms maintained at approximately 85%~86%. We anticipate that this dataset will facilitate research on MI-BCI paradigms and neuroplasticity for stroke, and contribute to the development of high-efficiency MI-BCI systems in the field of stroke rehabilitation.},
}

@misc{ming_dong_c53a508ea59a721e,
  title = {Multiplexed Electrochemical Sensing of Single-Nucleotide Polymorphic Microribonucleic Acids in Liver Cancer},
  author = {Gabriel B K Sasa and Chong Chen and Baixun He and Wenxin Zhang and Allen J Borlay and Cherie S Tan and Dong Ming},
  year = {2026},
  doi = {10.1021/acs.analchem.5c03442},
  url = {https://doi.org/10.1021/acs.analchem.5c03442},
  howpublished = {Analytical chemistry},
  annotation = {中文辅助译名：肝癌中单核苷酸多态性微核糖核酸的多重电化学传感},
  abstract = {Liver cancer remains a highly lethal malignancy, primarily due to the limitations of current biomarkers like α-fetoprotein, which fail to detect many early-stage cases. MicroRNAs (miRNAs) have emerged as promising diagnostic biomarkers, particularly those influenced by single-nucleotide polymorphisms (SNPs). However, conventional electrochemical biosensors for miRNA detection often require complex probe modifications to achieve sufficient sensitivity and selectivity. Here, we present a multiplex electrochemical biosensor for the simultaneous detection of SNP-associated miRNAs (SNP-146a and SNP-122) linked to liver cancer. The biosensor leverages amino-rich polyethylenimine gold nanoparticles (PEI-AuNPs) to immobilize capture and signal probes efficiently, enabling robust signal amplification. Using metal ion tags (Pb2+ for SNP-146a and Ag+ for SNP-122) and differential pulse voltammetry (DPV), we achieved distinct, highly sensitive detection with limits of detection (LODs) of 0.39 and 0.23 pM, respectively, across a broad linear range (1 pM-100 nM). Clinical validation using serum samples yielded statistically significant discrimination (P = 0.0013 for SNP-146a, P = 0.0001 for SNP-122) and outstanding diagnostic performance (ROC-AUC = 0.98 and 0.96, respectively). Meanwhile, the platform's versatility was further demonstrated by detecting miR-181a and miR-155 with exceptional LODs of 0.34 and 0.02 pM. This multiplexed biosensor provides a powerful tool for early liver cancer },
}

@misc{ming_dong_018637fb5eb07862,
  title = {Gait assessment of osteosarcoma patients undergoing total knee arthroplasty: Influence of abduction-adduction angles in knee prostheses},
  author = {Rui Xu and Shiyu Zhang and Jingwen Chen and Mingyong Gu and Juan Du and Lin Meng and Jingyu Zhang and Dong Ming},
  year = {2026},
