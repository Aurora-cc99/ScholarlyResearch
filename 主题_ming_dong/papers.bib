  doi = {10.1109/ROBIO64047.2024.10907414},
  url = {https://doi.org/10.1109/ROBIO64047.2024.10907414},
  howpublished = {ROBIO},
  annotation = {中文辅助译名：大脑控制的多余机器人手指训练后皮质-皮质下感觉运动区域的功能连接增强：纵向功能磁共振成像研究},
  abstract = {Brain computer interface (BCI) technology can decode motion intentions to manipulate supernumerary robotic finger (SRF), facilitating direct human-machine control and enhancing limb motion capabilities. However, the longitudinal neuroplasticity mechanism of BCI-controlled SRF training using the sixth finger motor imagery paradigm remains unclear. In this study, we observed concurrent changes in behavior and brain activity following 4 weeks of BCI-controlled SRF training (BCI_SRF) or sham SRF training (Sham). The results demonstrated a 132% improvement in SRF-finger opposition accuracy with BCI_SRF training compared to Sham training. Resting-state fMRI analysis revealed a significant enhancement in functional connectivity between M1_ R and Cerebellum_8_L due to BCI-SRF training. These findings suggest that active brain involvement enhances the cortical-subcortical interaction of the sensorimotor network, thereby improving human-computer interaction performance. Our research provides valuable insights for enhancing human-computer interaction and exhibits significant potential in hand rehabilitation post-stroke.},
}

@misc{ming_dong_c58525097da8b007,
  title = {Low-intensity ultrasound ameliorates brain organoid integration and rescues microcephaly deficits},
  author = {Xiao-Hong Li and Di Guo and Li-Qun Chen and Zhe-Han Chang and Jian-Xin Shi and Nan Hu and Chong Chen and Xiao-Wang Zhang and Shuang-Qing Bao and Meng-Meng Chen and Dong Ming},
