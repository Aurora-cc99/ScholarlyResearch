}

@misc{ming_dong_ec240233f5bd6a3c,
  title = {Convergence and innovative applications of cutting-edge biomedical technologies in brain organoid research},
  author = {Zhen Zhang and Youwei Wang and Liqun Chen and Dong Ming},
  year = {2026},
