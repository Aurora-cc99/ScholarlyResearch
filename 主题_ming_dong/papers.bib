@misc{ming_dong_35641acb3c14c988,
  title = {The Effects of ERD Pattern Enhancement via the Sixth-Finger Motor Imagery in Stroke Patients},
  author = {Zhuang Wang and Yuan Liu and Shuaifei Huang and Huimin Huang and Wenlai Wu and Yuyang Wang and Xingwei An and Dong Ming},
