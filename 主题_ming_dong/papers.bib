  abstract = {BACKGROUND: Bone tumors often affect the knee, necessitating total knee arthroplasty for functional restoration. While rotating hinge prostheses enable biaxial movement, an ideal design should replicate natural multi-axis motion. A proposed ball-axis prosthesis with an open coronal plane has undergone in vitro finite element validation but lacks in vivo assessment. This study aims to deeply explore the influence of abduction-adduction freedom of the open prosthesis knee joint on the gait function of patients in vivo. METHODS: We recruited 8 patients with ball-axis prostheses, 8 with rotating hinge knee prostheses, and 8 healthy controls to collect three-dimensional motion data and ground reaction forces during normal gait. The joint angles and moments of the lower extremities were calculated using the musculoskeletal model. The characteristic parameters of the joint angle and moment curves were calculated, and one-way analysis of variance was used to evaluate the mean differences between groups. FINDINGS: Compared to the rotating hinge prosthesis, the ball-axis prosthesis exhibited significantly lower gait speed, peak knee flexion during the swing phase, and peak anterior ground reaction force (p = 0.030, p = 0.010, p = 0.018). Despite the opened coronal plane freedom, there was no significant difference in gait abduction-adduction range compared to the rotating hinge prosthesis or healthy controls. INTERPRETATION: This study indicates the patients with ball-axis prosthesis h},
}

@misc{ming_dong_1c95f9c7f1ec,
  title = {Mapping three decades of consciousness research in neuroscience: a scientometric synthesis of intellectual evolution and emerging frontiers},
  author = {Qiangfan Meng and Haiqing Yu and Jianghong He and Haibo Di and Steven Laureys and Yongzhi Huang and Minpeng Xu and Dong Ming},
  year = {2026},
  doi = {10.1515/revneuro-2026-0217},
  url = {https://doi.org/10.1515/revneuro-2026-0217},
  howpublished = {Reviews in the neurosciences},
  annotation = {中文辅助译名：绘制神经科学领域三十年的意识研究：智力进化和新兴前沿的科学计量综合。Rev Neurosci},
  abstract = {Over the past three decades, consciousness research in neuroscience has expanded into a broad and increasingly diverse field. Despite significant progress, a quantitative understanding of how these research areas have collectively evolved has remained limited. In this study, we conducted a large-scale scientometric analysis of consciousness research in neuroscience based on 22,836 publications and 639,975 cited references retrieved from the Web of Science Core Collection spanning 1998-2025. We identified three major research paths: neural correlates of conscious contents and states, internal awareness and self-consciousness, and integrative approaches bridging these two paths. Emerging hotspots included neural mechanisms of consciousness, subjective experience, disorders of consciousness (DoC), and interoception. Despite increasing boundary-spanning research across different areas, bibliometric connections between DoC and other major topics, particularly subjective experience and interoception, remain comparatively sparse. These findings provide a field-level synthesis of consciousness research in neuroscience, offering a quantitative framework for understanding its development and emerging research directions.},
}

