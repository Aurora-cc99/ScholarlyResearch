  abstract = {Abstract Recent years, researches on diagnosis of anesthesia status and postoperative recovery based on electroencephalogram (EEG) signals have become increasingly popular. Bispectral index (BIS) is the earliest and most effective indicator for monitoring the depth of clinical anesthesia, and the waveform of intraoperative EEG can be displayed in real time. Excessive anesthesia and other conditions will cause burst suppression (BS) of intraoperative EEG, which will prolong the operation time and ICU stay time, and increase the incidence of postoperative delirium. This study analyzes the changes of intraoperative BIS monitoring on real-time EEG waveform and spectrogram, the results showed that BIS can predict the occurrence of EEG BS and then reduce the operation time and the incidence of postoperative delirium through rational use of intraoperative drugs.},
}

@misc{ming_dong_3579aa2d8c61,
