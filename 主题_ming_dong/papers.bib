@misc{ming_dong_b02db046b656,
  title = {Nonlinear dynamics of a corticothalamic coupled neural mass model reproduce the mechanism of 40 Hz ASSR generation},
  author = {Mu Zhu and Xiaoya Liu and Xinmeng Guo and Yilin Zhang and Ziliang Cai and Shuang Liu and Dong Ming},
  year = {2027},
  doi = {10.1016/j.neunet.2026.109683},
  url = {https://doi.org/10.1016/j.neunet.2026.109683},
  howpublished = {Neural networks : the official journal of the International Neural Network Society},
  annotation = {中文辅助译名：皮质丘脑耦合神经质量模型的非线性动力学再现了 40 Hz ASSR 生成的机制。神经网络},
  abstract = {Auditory steady-state responses (ASSR) provide a powerful tool for investigating oscillatory dynamics and network synchronization along the auditory pathway. However, existing neural mass models of 40 Hz ASSR have largely focused on cortical microcircuits or macroscopic phenomenology, while neglecting the closed-loop regulation formed by thalamocortical feedforward transmission and thalamic reticular nucleus (TRN)-mediated feedback inhibition. To address this, we constructed an Auditory Corticothalamic Neural Mass Model (ACT-NMM) that investigates cortical pyramidal neurons (Pyr), parvalbumin-positive interneurons (PV), somatostatin-positive interneurons (SST), thalamocortical relay neurons (TCR), and TRN neurons within a delay-coupled corticothalamic loop. By reproducing the steady-state oscillatory patterns observed in the auditory cortex and analyzing parameter-dependent synchronization, phase locking, and frequency locking, the ACT-NMM quantitatively characterizes how thalamocortical interactions shape ASSR dynamics. The results suggest that the auditory cortex acts as the primary generator of the 40 Hz ASSR, whereas the thalamus mainly contributes phase alignment and relay modulation, rather than generating a strong ASSR response independently. These findings demonstrate that ACT-NMM captures the key dynamic features of ASSR generation, providing a physiologically interpretable framework for linking corticothalamic parameters to observed auditory oscillations.},
}

@misc{ming_dong_9e4f80da2bad,
  title = {40-Hz chirp auditory stimulation alleviates chronic restraint stress-induced depression-like behaviors and restores disrupted gamma oscillations},
  author = {Junling Wang and Xiaochen Zhang and Haikuo Shi and Wanting Guo and Shuang Liu and Dong Ming},
  year = {2026},
  doi = {10.1016/j.pnpbp.2026.111969},
  url = {https://doi.org/10.1016/j.pnpbp.2026.111969},
  howpublished = {Progress in neuro-psychopharmacology & biological psychiatry},
  annotation = {中文辅助译名：40 Hz 鸣叫听觉刺激可缓解慢性束缚应激诱发的抑郁样行为，并恢复中断的伽马振荡。 Prog Neuropsychopharmacol Biol Psychiatry},
  abstract = {Psychiatric disorders are increasingly treated using frequency-specific neuromodulation approaches. Our previous studies demonstrated impaired 40-Hz gamma oscillations in the temporal lobe of both patients with depression and depression-like animal models. Given that 40-Hz auditory stimulation can elicit robust frequency-specific neural responses in the auditory cortex, it may provide a contact-free means of modulating temporal-lobe gamma oscillations. Accordingly, this study aimed to establish a 40-Hz chirp auditory stimulation protocol and examine its effects on depression-like behaviors and gamma-band neural activity in a chronic restraint stress (CRS) rat model, providing a convenient intervention strategy for depression. Twenty-four rats were randomly assigned to a control group (n = 8) or a CRS group (n = 16), with CRS rats further receiving either 40-Hz chirp stimulation or sham stimulation for five consecutive days (20 min/day). Behavioral assessments were performed, followed by bilateral local field potential (LFP) recordings in the primary auditory cortex (A1). Results showed that 40-Hz chirp stimulation effectively alleviated CRS-induced depression- and anxiety-like behaviors, as reflected by increases in the sucrose preference index (SPI) and open-arm time. It selectively restored CRS-induced reductions in right A1 gamma activity, including task-rest gamma modulation, task-related narrowband gamma power and theta-gamma coupling. Moreover, right A1 gamma measures w},
}

@misc{ming_dong_43d0ced2d79c0e57,
  title = {Transdiagnostic homogeneity, and diagnostic-specific biomarkers among major depressive disorder, bipolar disorder and schizophrenia during 40 Hz auditory steady-state response: a normative modeling analysis},
  author = {Sitong Chen and Xinmeng Guo and Xiaoya Liu and Shuang Liu and Dong Ming},
  year = {2026},
  doi = {10.1016/j.jad.2025.120189},
  url = {https://doi.org/10.1016/j.jad.2025.120189},
  howpublished = {Journal of affective disorders},
  annotation = {中文辅助译名：40 Hz 听觉稳态反应期间重度抑郁症、双相情感障碍和精神分裂症的跨诊断同质性和诊断特异性生物标志物：规范模型分析},
  abstract = {BACKGROUND: Abnormal gamma-band auditory steady-state response (gamma-ASSR) power has been reported in major depressive disorder (MDD), bipolar disorder (BD), and schizophrenia (SZ), but distinguishing between these disorders based solely on power remains challenging. Directed functional connectivity (DFC), which captures topological patterns of causal information flow, may provide more diagnostic-specific markers. However, conventional case-control framework often disregards the substantial individual heterogeneity, yielding unreliable biomarkers. METHODS: An adapted framework integrating DFC heterogeneity with normative modeling was developed. 52 MDD, 33 BD, 39 SZ patients and 107 healthy controls (HC) participated in the 40 Hz-ASSR task. The normative model was established using data from 71 HC to define the population baseline. Thereafter, deviation Z-scores and the proportion of extreme deviations in DFC were calculated. RESULTS: The DFC deviations showed high individual heterogeneity at most DFCs, with fewer than 2.6 % of individuals exhibiting extreme deviations at the same time point. However, a small proportion of DFC deviations with high overlap were embedded within common connectivity pathways in three disorders, particularly in the frontal and parietal regions. Furthermore, distinct diagnostic-specific patterns were identified: MDD mainly exhibited right temporal-frontal alterations, BD showed a parietal-driven temporo-occipital loop, and SZ presented a midline-ce},
}

