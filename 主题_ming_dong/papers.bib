  abstract = {OBJECTIVE: Transcranial alternating current stimulation (tACS) can modulate brain oscillations in a frequency-specific manner, but strong stimulation artifacts severely contaminate concurrent electroencephalography (EEG), limiting direct assessment of ongoing neural activity. Conventional artifact suppression methods often lack adaptability to nonstationary and frequency-dependent artifacts, which may cause incomplete artifact removal and neural signal distortion. This study aimed to develop a dynamic adaptive stimulation artifact source separation framework to improve EEG recovery during amplitude-modulated tACS (AM-tACS). APPROACH: We proposed a dynamic adaptive stimulation artifact source separation framework, termed DASASS, integrating recursive covariance updating, adaptive component selection, and wavelet-based multiband processing. This framework was designed to suppress time-varying and frequency-dependent stimulation artifacts while preserving the spectrotemporal and spatial characteristics of neural signals. The method was evaluated on resting-state EEG recorded during AM-tACS and compared with stimulation artifact source separation (SASS), principal component analysis (PCA), independent component analysis (ICA), and adaptive noise cancellation (ANC). Performance was assessed using normalized root mean square error, band-power deviation, and demodulated residual modulation. Microstate analysis examined whether recovered EEG preserved canonical spatial topographies a},
}

@misc{ming_dong_3666619c79514670,
  title = {Multidimensional Acoustic-Prosodic Quantification Framework Using Unscripted Speech for Autism Spectrum Disorder Identification},
  author = {Minghao Du and Ping Shi and Zehao Liu and Xiaoyao Lu and Luling Cao and Beibei Liu and Xiaoya Liu and Wei Liu and Shuang Liu and Dong Ming},
  year = {2026},
  doi = {10.1002/aur.70206},
  url = {https://doi.org/10.1002/aur.70206},
  howpublished = {Autism research : official journal of the International Society for Autism Research},
  annotation = {中文辅助译名：使用即兴语音进行自闭症谱系障碍识别的多维声学韵律量化框架},
  abstract = {Although clinical observations have noted early speech abnormalities in children with autism spectrum disorder (ASD), automatic speech-based detection remains challenging. This is primarily due to the reliance on scripted tasks, which younger children often struggle to complete and which are not generalizable to large-scale, non-clinical screening. To address this, we developed an unscripted speech-based framework to quantify atypical acoustic-prosodic patterns for automatic ASD identification in naturalistic interactions. It processes free-flowing conversations, extracts multidimensional acoustic features from the time and frequency domains, and models ASD-related prosodic patterns for classification. For evaluation, we collected spontaneous speech from 88 children with ASD (3-10 years) and 82 typically developing (TD) children (3-9 years) during naturalistic interactions on daily topics (e.g., toys, animated movies, storybook reading). Group comparisons revealed atypical prosodic patterns in ASD, including reduced speech continuity, speech rate, and Formant 3, alongside increased zero-crossing rate, pitch, pitch variability, and Formant 1 (all p < 0.01). Using these features, a linear discriminant analysis classifier achieved robust performance (accuracy = 0.85 ± 0.07, F1 = 0.86 ± 0.07). Further analyses indicated no significant gender interaction (p > 0.05), but a pronounced effect of speech context (p < 0.01), with atypical patterns being more evident in open-ended dialog},
}

@misc{ming_dong_d83fef6b1219,
