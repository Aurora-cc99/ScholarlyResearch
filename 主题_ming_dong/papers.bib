  year = {2026},
  doi = {10.1063/5.0340348},
  url = {https://doi.org/10.1063/5.0340348},
  howpublished = {Physics of Fluids},
  annotation = {中文辅助译名：基于能量竞争的超临界异相结构形成机制的分子视角},
  abstract = {The formation of heterogeneous structures in supercritical fluids (SF) is important for understanding their density fluctuations and anomalous properties. In this paper, we classify liquid-like (LL) and gas-like (GL) molecules in SF using the Stillinger method based on the local structure. From the perspective of the competition between kinetic energy and potential energy, the evolution of heterogeneous structures and energy distribution characteristics in LL, GL, and two-phase-like (TPL) fluids are revealed. When kinetic energy and potential energy are comparable, the ratio of LL and GL molecules is nearly equal, and the energy barrier for their conversion is minimal. This paper proposes an energy-based definition of the Widom line, where the total energy is zero. Furthermore, the potential energy part dominates as SF crosses the TPL region, indicating that more energy is used to increase intermolecular distance than to raise the temperature. These results provide a molecular-level understanding of the formation of supercritical heterogeneous structures.},
}

@misc{ming_dong_c74c5b471179f0ba,
