@misc{ioannis_patras_fb5b11c295b47882,
  title = {ITI-CERTH participation in TRECVID 2017},
  author = {Stelios Andreadis and Ilias Gialampoukidis and Konstantinos Avgerinakis and Fotini Markatopoulou and Ioannis Patras and Damianos Galanopoulos and Vasileios Mezaris and Ioannis Kompatsiaris and Anastasia Moumtzidou and Stefanos Vrochidis and Stavros Tachos},
  year = {2017},
  doi = {10.5281/zenodo.1183439},
  url = {https://cris.maastrichtuniversity.nl/en/publications/ab919213-5221-4509-872b-ffefd645dda2},
  howpublished = {TRECVID},
  annotation = {中文辅助译名：ITI-CERTH 参加 TRECVID 2017},
  abstract = {This paper provides an overview of the runs submitted to TRECVID 2017 by ITI-CERTH. ITI-CERTH participated in the Ad-hoc Video Search (AVS), Multimedia Event Detection (MED), Instance Search (INS) and Surveillance Event Detection (SED) tasks. Our AVS task participation is based on a method that combines the linguistic analysis of the query with concept-based and semantic-embedding representations of video fragments. Regarding the MED task, this year we participate on Pre-Specied and Ah-Hoc sub-tasks exploiting both motion-based as well as DCNN-based features. The INS task is performed by employing VERGE, which is an interactive retrieval application that integrates retrieval functionalities that consider mainly visual information. For the SED task, we deploy a novel activity detection algorithm that is based on human detection in video frames, goal descriptors, dense trajectories, Fisher vectors and a discriminative action segmentation scheme.},
}

@misc{ioannis_patras_fb42411f4fca2845,
  title = {SmileNet: Registration-Free Smiling Face Detection In The Wild},
  author = {Ioannis Patras and Youngkyoon Jang and Hatice Gunes},
