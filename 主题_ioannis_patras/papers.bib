  annotation = {中文辅助译名：用于识别音乐视频诱发情绪的脑电图和周围生理信号的单次试验分类},
}

@misc{ioannis_patras_a67dc0e0cc339e7e,
  title = {Coupled Gaussian Process Regression for Pose-Invariant Facial Expression Recognition},
  author = {Ioannis Patras and Maja Pantic and Ognjen Rudovic},
