  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：用于基于 EEG 的连续运动轨迹重建的主题自适应 CNN-Transformer 框架},
  abstract = {Continuous reconstruction of motor trajectories from electroencephalographic (EEG) signals is crucial for brain-computer interface (BCI) applications. However, existing deep learning methods process multi-scale temporal features and long-range dependencies in isolation, failing to capture their inherent coupling in motor control. Motor planning and execution involve simultaneous coordination across vastly different timescales, while maintaining global coherence throughout movement sequences. Current approaches using single-scale CNNs or sequential RNNs cannot effectively capture this multi-scale, globally coordinated dynamics. To address this challenge, we propose SA-EEG2Traj, a hybrid framework that synergistically integrates parallel multi-scale CNNs with Transformer encoders for joint modeling of hierarchical temporal features and global dependencies, augmented with subject-adaptive embeddings to capture individual EEG characteristics within a unified architecture under subject-specific training. We validate SA-EEG2Traj on three public datasets encompassing distinct motor paradigms, employing rigorous preprocessing to prevent temporal leakage. The framework demonstrates competitive reconstruction performance across three datasets, with more pronounced improvements on BNCI 001-2017 and BNCI 002-2025 and comparable performance to the strongest baseline on WAY-EEG-GAL. Ablation studies suggest complementary roles of multi-scale feature extraction and global dependency modelin},
}

@misc{jing_jin_ecust_a9fa627d2885d5f8,
  title = {Multi-Domain Dynamic Weighting Network for Motor Imagery Decoding},
