@misc{jing_jin_ecust_2c20244106fdff6d,
  title = {The Spatio-Temporal Equalization Sliding-Window Distribution Distance Maximization Based on Unsupervised Learning for Online Event-Related Potential-Based Brain–Computer Interfaces},
