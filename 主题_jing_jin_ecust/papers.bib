  annotation = {中文辅助译名：探索不同声音的空间听觉 BCI 范式：音符与蜂鸣声},
}

@misc{jing_jin_ecust_b9f5933cc9eb1449,
  title = {Exploring motion visual-evoked potentials for multi-objective gaze-independent brain-computer interfaces},
  author = {Long Chen and Xingyu Wang and Jing Jin and Yu Zhang and Sijie Zhou},
  year = {2016},
  doi = {10.1109/ICSAI.2016.7810935},
  url = {https://doi.org/10.1109/ICSAI.2016.7810935},
  howpublished = {ICSAI},
  annotation = {中文辅助译名：探索多目标注视独立脑机接口的运动视觉诱发电位},
  abstract = {In order to improve information transfer rate, the gaze-independent Brain-computer Interfaces (BCIs) flash several stimuli at same time instead of just flashing one stimulus. Studies had reported that the performance of multi-objective gaze-independent BCIs under covert attention conditions were lower than Matrix speller BCIs under overt attention conditions. Motion visually evoked potentials (mVEPs) was recently introduced as stimuli for visual patterns in BCIs. Combination of motion-onset and color had been explored for a single-objective gaze-independent BCI. But the situation of multi-objective hadn't been discussed. Hence, it is needed to exploring whether or not mVEPs can enhance the performance of multi-objective gaze-independent BCIs. For exploration of the above problem, two spells developed from Geometric Speller (GeoSpell) have been built. Ten healthy participants had participated in this study. Results show that motion-onset cannot improve the performance of multi-objective gaze-independent BCIs in terms of event-related potentials (ERPs), when visual angle doesn't exceed 1 degree.},
}

@misc{jing_jin_ecust_f42ce4c7331b03de,
  title = {Exploring Combinations of Different Color and Facial Expression Stimuli for Gaze-Independent BCIs},
  author = {Ian Daly and Xingyu Wang and Long Chen and Andrzej Cichocki and Jing Jin and Yu Zhang},
  year = {2016},
  doi = {10.3389/FNCOM.2016.00005},
  url = {https://doi.org/10.3389/FNCOM.2016.00005},
  howpublished = {Frontiers Comput. Neurosci.},
  annotation = {中文辅助译名：探索与注视无关的 BCI 的不同颜色和面部表情刺激的组合},
  abstract = {BACKGROUND: Some studies have proven that a conventional visual brain computer interface (BCI) based on overt attention cannot be used effectively when eye movement control is not possible. To solve this problem, a novel visual-based BCI system based on covert attention and feature attention has been proposed and was called the gaze-independent BCI. Color and shape difference between stimuli and backgrounds have generally been used in examples of gaze-independent BCIs. Recently, a new paradigm based on facial expression changes has been presented, and obtained high performance. However, some facial expressions were so similar that users couldn't tell them apart, especially when they were presented at the same position in a rapid serial visual presentation (RSVP) paradigm. Consequently, the performance of the BCI is reduced. NEW METHOD: In this paper, we combined facial expressions and colors to optimize the stimuli presentation in the gaze-independent BCI. This optimized paradigm was called the colored dummy face pattern. It is suggested that different colors and facial expressions could help users to locate the target and evoke larger event-related potentials (ERPs). In order to evaluate the performance of this new paradigm, two other paradigms were presented, called the gray dummy face pattern and the colored ball pattern. COMPARISON WITH EXISTING METHOD(S): The key point that determined the value of the colored dummy faces stimuli in BCI systems was whether the dummy face },
}

@misc{jing_jin_ecust_7d55d39d10a546cd,
  title = {Motor imagery EEG classification via Bayesian extreme learning machine},
  author = {Yu Zhang and Jing Jin and Xingyu Wang and Yu Wang},
  year = {2016},
  doi = {10.1109/icist.2016.7483380},
  url = {https://doi.org/10.1109/icist.2016.7483380},
  howpublished = {International Conference on Information Science and Technology},
  annotation = {中文辅助译名：通过贝叶斯极限学习机进行运动想象脑电图分类},
  abstract = {Motor imagery is usually hard to be classified with a high accuracy, since the task-related electroencephalogram (EEG) responses are likely to be contaminated by some ongoing noises. Design of an efficient classifier is considerably important for the realization of a brain-computer interface (BCI) system based on motor imagery. This study introduces a Bayesian extreme learning machine (BELM) based method for accurate classification of motor imagery. By combing ELM and Bayesian inference, BELM achieves the smallest norm of output weights with automatically estimated regularization for alleviating the possible overfitting during calibration procedure. Effectiveness of the BELM-based method is validated on a public BCI dataset, in comparison with other two competing methods.},
}

@misc{jing_jin_ecust_68ba74d4297bbe25,
  title = {Concentrate your mind by counting the flashing point: A new P300 pattern in BCI},
  author = {Hanhan Zhang and Huiping Hu and Sijie Zhou and Xingyu Wang and Jing Jin},
  year = {2016},
  doi = {10.1109/icist.2016.7483382},
  url = {https://doi.org/10.1109/icist.2016.7483382},
  howpublished = {International Conference on Information Science and Technology},
  annotation = {中文辅助译名：通过计算闪光点来集中注意力：BCI 中的新 P300 模式},
  abstract = {Brain-computer interface (BCI) can help patients who lost control over most muscles but are still conscious to communicate or interact with the environment. In the offline experiment, all the subjects have to do is counting the target stimulus when they were using the visual-evoked event-related potential (ERP) based BCIs. The recorded electroencephalogram (EEG) data was used to train the classification mode. However, subjects may get distracted in counting the target stimulus when the non-target stimulus affected the subjects or subjects lost their attentions which may negatively affect the task performance. In this study, some green flashing points was added into the stimuli. The subjects have to focus on the target stimulus and count the number of the green points in target stimulus at the same time. In this way, it will make subjects concentrate more on the target to count the green points compared to the pattern without green points. The result showed that the performance of the BCI system could be improved using the method presented in this paper.},
}

@misc{jing_jin_ecust_caf586ca9e597f36,
  title = {An Online Gaze-Independent BCI System Used Dummy Face with Eyes Only Region as Stimulus},
  author = {Yu Zhang and Xingyu Wang and Jing Jin and Long Chen and Brendan Z. Allison},
  year = {2016},
  doi = {10.1007/978-3-319-39955-3_3},
