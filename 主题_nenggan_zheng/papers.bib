@misc{nenggan_zheng_17c0e5ad339a75dd,
  title = {A High-Efficiency Spike Sorting Cloud-Edge Computing System with DL-DFCM},
  author = {Zhengfei Zhu and Keming Chen and Nenggan Zheng and Yan Qi and Hui Hong and Shengyi Qian},
  year = {2019},
  doi = {10.1109/ITHINGS/GREENCOM/CPSCOM/SMARTDATA.2019.00025},
  url = {https://doi.org/10.1109/ITHINGS/GREENCOM/CPSCOM/SMARTDATA.2019.00025},
  howpublished = {iThings/GreenCom/CPSCom/SmartData},
  annotation = {中文辅助译名：采用 DL-DFCM 的高效尖峰分拣云边缘计算系统},
  abstract = {Spike sorting is crucial to the Brain computer interface (BCI) systems. In order to obtain high classify accuracy of spikes in less computing time, it is necessary to improve the algorithms' performance and achieve appropriate scheduling of the algorithms in cloud-edge computing system. In this paper, dictionary learning (DL) is utilized as feature extraction algorithm to sparsely represent the spikes. Based on the extracted feature by dictionary learning, density based fuzzy clustering method (DFCM) is employed to improve the clustering boundary. Due to the fast computation capability of cloud computing and low latency of edge computing, the spike sorting algorithm is decomposed into cloud and edge with the aim to achieve high efficiency. On the cloud server, learning of dictionary matrix and computing of cluster centers are executed. On the edge, the equipment can directly give out the classify results by using parameters computed out from cloud server. The experimental results show that the spike sorting algorithm putted on cloud-edge computing system has high accuracy and low time cost of the classification.},
}

