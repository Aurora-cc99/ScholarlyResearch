@misc{nenggan_zheng_f75ef0312bd6b7ba,
  title = {Locally Linear Approximation Approach for Incomplete Data},
  author = {Wei Huang and Qinghua Hu and Nenggan Zheng and Jianhua Dai and Liang Liu and Hu Hu},
  year = {2018},
  doi = {10.1109/TCYB.2017.2713989},
  url = {https://doi.org/10.1109/TCYB.2017.2713989},
  howpublished = {IEEE Trans. Cybern.},
  annotation = {中文辅助译名：不完整数据的局部线性逼近方法},
  abstract = {The matrix completion problem is restoring a given matrix with missing entries when handling incomplete data. In many existing researches, rank minimization plays a central role in matrix completion. In this paper, noticing that the locally linear reconstruction can be used to approximate the missing entries, we view the problem from a new perspective and propose an algorithm called locally linear approximation (LLA). The LLA method tries to keep the local structure of the data space while restoring the missing entries from row angle and column angle simultaneously. The experimental results have demonstrated the effectiveness of the proposed method.},
}

@misc{nenggan_zheng_18e709e187f3e70c,
  title = {Representation and Computation Method for Bumblebee's Abdomen Movements},
  author = {Nenggan Zheng and Yi Jiang and Yan Qi and Ruixia Guan},
  year = {2018},
  doi = {10.1109/CYBERMATICS_2018.2018.00149},
  url = {https://doi.org/10.1109/CYBERMATICS_2018.2018.00149},
  howpublished = {iThings/GreenCom/CPSCom/SmartData},
  annotation = {中文辅助译名：大黄蜂腹部运动的表示与计算方法},
  abstract = {The research of insect robots requires accurate behavioral characterization and quantitative methods to model the mapping relationship between control instructions and induced behaviors. We define a parametric bumblebee somatic body geometry model, using a Gaussian mixture model and the Mean-shift algorithm to calculate the motion parameters, establishing a computational framework for calculating the fine motion characterization of the main moving parts of the body. Experiments show that our method has achieved high accuracy. The method has low calculation overhead and can satisfy the behavioral experiment requirements.},
}

@misc{nenggan_zheng_e633b6fe0211fc5e,
  title = {Semi-Automatic Neuron Tracing in Electron Microscope Images: Preliminary Results},
  author = {Weijie Liu and Deli Wang and Ting Zhao and Nenggan Zheng},
  year = {2018},
  doi = {10.1109/CYBERMATICS_2018.2018.00146},
  url = {https://doi.org/10.1109/CYBERMATICS_2018.2018.00146},
  howpublished = {iThings/GreenCom/CPSCom/SmartData},
  annotation = {中文辅助译名：电子显微镜图像中的半自动神经元追踪：初步结果},
  abstract = {Reconstruction of high-resolution connectomes has been a key approach towards understanding how the brain functions. However, current methods of reconstructing neurons from electron microscope images are either computationally expensive or labor intensive. In this paper, we proposed a novel framework using interactive segmentation as a region extraction method and automatic skeletonization as a morphology fitting method to accelerate neuron tracing, especially for researchers with limited resources. Preliminary user experiments showed that our method could be at least six times more efficient than the manual method, while the cost of computation remains affordable to a small lab.},
}

@misc{nenggan_zheng_4df427d8569d94c7,
  title = {Smooth 3D Trajectory Segmentation for Flying Insects},
  author = {Lei Zhao and Qian Ma and Nenggan Zheng},
  year = {2018},
  doi = {10.1109/CYBERMATICS_2018.2018.00147},
  url = {https://doi.org/10.1109/CYBERMATICS_2018.2018.00147},
  howpublished = {iThings/GreenCom/CPSCom/SmartData},
  annotation = {中文辅助译名：飞行昆虫的平滑 3D 轨迹分割},
  abstract = {We focus on the computation methods for analyzing the bumblebee behavior. In this paper, we recover the smooth 3D trajectory for flying bumblebee by stereo vision by employing EKF. We also tackle the matching problem when more than one targets appeared in the views. A variable length sliding window method is proposed to segment the 3D trajectory into three basic types. In our experiment, we show our method has more accuracy result than the state art of work.},
}

@misc{nenggan_zheng_0ebefe1c4d256283,
  title = {Data-Driven Diagnosis of Nonlinearly Mixed Mechanical Faults in Wind Turbine Gearbox},
  author = {Chunzhi Hu and Nenggan Zheng and Qiang Yang},
  year = {2018},
  doi = {10.1109/JIOT.2017.2761891},
  url = {https://doi.org/10.1109/JIOT.2017.2761891},
  howpublished = {IEEE Internet Things J.},
  annotation = {中文辅助译名：风力发电机齿轮箱非线性混合机械故障的数据驱动诊断},
  abstract = {This letter proposes an efficient algorithmic solution to diagnose multiple mechanical faults in wind turbine gearbox through source number estimation using an empirical mode decomposition (EMD) and singular value decomposition (SVD) joint approach, and source signal recovery based on short-time Fourier transform (STFT), fuzzy C-means clustering and l1 norm decomposition. The effectiveness of the solution is validated using real wind turbine measurements under multifault scenarios.},
}

