  annotation = {中文辅助译名：基于强化学习的分级电奖励刺激仿生机器人自动导航},
}

@misc{nenggan_zheng_9712a3ea73e98f28,
  title = {Electroplated Nickel Multielectrode Microprobes With Flexible Parylene Cable for Neural Recording and Stimulation},
  author = {Huaiqiang Yu and Nenggan Zheng and Wei Wang and Shuo Wang and Xiaoxiang Zheng and Zhihong Li},
  year = {2013},
  doi = {10.1109/jmems.2013.2262591},
  url = {https://doi.org/10.1109/jmems.2013.2262591},
  howpublished = {Journal of Microelectromechanical Systems},
  annotation = {中文辅助译名：具有柔性聚对二甲苯电缆的电镀镍多电极微探针，用于神经记录和刺激},
  abstract = {We design, fabricate, and characterize nickel-based multielectrode microprobes integrated with flexible parylene cable employing low-cost nickel electroplating process, intended for multichannel recording and stimulation of neurons in the brain. Electroplated nickel microprobes, which are encapsulated with parylene for biocompatibility, are more mechanically robust than brittle silicon-based ones. The selectively integrated flexible parylene cable facilitates the connection with external circuits and reduces the packaging requirements. The mechanical and electrical characterizations have been performed. Using the microprobes, the spontaneous neural activity in rat's hippocampus is recorded and the wing beat of tethered worker honeybees is initiated by delivering the stimulating pulse into the optic lobes.},
}

@misc{nenggan_zheng_98624e6cde1514cc,
  title = {Automatic navigation for rat-robots with modeling of the human guidance},
  author = {Chao Sun and Nenggan Zheng and Xinlu Zhang and Weidong Chen and Xiaoxiang Zheng},
