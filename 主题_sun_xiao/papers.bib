@misc{sun_xiao_643509becdbb,
  title = {Context-Aware Toxicity-Adaptive Sampling for Affective Language Generation},
  author = {Xueyao Sun and Kaize Shi and Qika Lin and Qing Li and Guandong Xu},
  year = {2026},
  doi = {10.1109/taffc.2026.3685346},
  url = {https://doi.org/10.1109/taffc.2026.3685346},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：用于情感语言生成的上下文感知毒性自适应采样},
  abstract = {Large language models are increasingly deployed in emotionally sensitive settings such as empathetic dialogue and mentalhealth support, where generating safe and contextually appropriate responses is important. Ensuring emotional safety during generation is essential for maintaining trust, reducing harm, and facilitating reliable affective interaction in artificial intelligence systems. Existing safety mechanisms that prevent the generation of emotional risks or toxicity often rely on static thresholds or posthoc moderation, which cannot account for the evolving conversational context and may not prevent the production of subtle but harmful content. To address these limitations, we introduce an adaptive and context-aware generation framework that proactively regulates toxicity during token sampling. Our core contribution is a dynamic safety mechanism that adjusts risk thresholds in real-time, enabling fine-grained control over emotionally sensitive output while preserving expressive capability. The proposed method, Context-Aware Toxicity-Adaptive Samping, integrates tokenlevel toxicity deltas, an adaptive probability threshold, and toxicityaware reweighting directly into the sampling process, forming a safe vocabulary at each decoding step that reflects the current emotional context and a generation pipeline that anticipates and suppresses harmful content before it appears. Experiments demonstrate that our approach significantly reduces contextdependent toxicity and emotional},
}

