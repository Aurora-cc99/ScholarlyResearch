@misc{sun_xiao_e9ba71d94245eab8,
  title = {Phase III, randomized controlled trial in girls 9-15 years old to evaluate lot consistency of a novel nine-valent human papillomavirus L1 virus-like particle vaccine},
  author = {Alain T. Luxembourg and Edson Duarte Moreira and Rudiwilai Samakoses and Kyung‐Hyo Kim and Xiao Na Sun and Roger Maansson and Erin Moeller and Susan Christiano and Joshua Chen},
  year = {2015},
  doi = {10.1080/21645515.2015.1009819},
  url = {https://doi.org/10.1080/21645515.2015.1009819},
  howpublished = {Human Vaccines & Immunotherapeutics},
  annotation = {中文辅助译名：III 期随机对照试验，针对 9-15 岁女孩进行，评估新型九价人乳头瘤病毒 L1 病毒样颗粒疫苗的批次一致性},
  abstract = {A 9-valent human papillomavirus (6/11/16/18/31/33/45/52/58) VLP (9vHPV) vaccine has recently been proven highly efficacious in preventing disease associated with vaccine HPV types in a pivotal Phase III study. The demonstration of lot-to-lot consistency to confirm the reliability of the manufacturing process is a regulatory requirement for vaccine licensure in the United States. A randomized trial was conducted to demonstrate that three lots of 9vHPV vaccine elicit equivalent antibody response for all 9 vaccine types. The study required thorough planning because it required success on 27 separate statistical comparisons. An innovative statistical approach was used taking into account between-lot variance for more conservative power calculations. The study demonstrated equivalence of three lots of 9vHPV vaccine for all 9 vaccine types.},
}

@misc{sun_xiao_9a1b7d8ee6cd8e90,
  title = {Performance Study on ST/JT Hybrid Cryocoolers Working at Liquid Helium Temperature},
  author = {Dongli Liu and Xuan Tao and Xiao Na Sun and Gan Zhihua},
  year = {2015},
  doi = {10.1016/j.phpro.2015.06.060},
