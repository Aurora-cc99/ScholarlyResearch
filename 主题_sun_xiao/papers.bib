@misc{sun_xiao_af90e3a29c855cae,
  title = {Sentiment Classification And Personality Detection Via Galvanic Skin Response Based on Deep Learning Models},
  author = {Tao Hong and Xiao Sun and Fang Tian and Fuji Ren},
