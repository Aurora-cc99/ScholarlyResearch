@misc{sun_xiao_445b3f746727,
  title = {ERMoV: Modeling Affective Mental States via Emotion Regulation for Dialogue Emotion Recognition},
  author = {Xiao Sun and Xuxiong Liu and Yueqi Jiang},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3696654},
  url = {https://sxhfut.github.io/publications/},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：ERMoV：通过对话情绪的情绪调节对情感心理状态进行建模识别},
  abstract = {To enable machines to engage in human-like emotional interactions, it is crucial to move beyond mere pattern recognition towards modeling the underlying cognitive processes. A key component of this is Affective Theory of Mind (ToM)—the ability to reason about one's own and others' emotional states. However, existing models for dialogue emotion recognition often simulate emotional dynamics (e.g., contagion, persistence) at a phenomenological level, without explicitly modeling the mental istic reasoning that drives these phenomena. To bridge this gap, this paper proposes ERMoV, a framework that operationalizes principles from cognitive science to build a computational model of Affective ToM. At its core, ERMoV introduces a graph based reasoning module, EmoGNN, which simulates the interplay between self-oriented emotion regulation (intra-personal mental modeling) and other-oriented emotional influence (inter-personal mental modeling). To ground this reasoning process in conversa tional context, ERMoV integrates discourse structure to capture relational cues and employs a multi-view fusion mechanism to synthesize diverse sources of evidence. Experiments on four public datasets demonstrate the effectiveness of our ToM-driven approach. ERMoV achieves competitive performance, obtaining an F1 score of 40.93% on EmoryNLP and a macro-F1 of 62.51% on DailyDialog, validating that modeling the underlying mentalistic dynamics improves recognition accuracy. Our work provides a new paradigm },
}

