@misc{sun_xiao_46d9449daca10d64,
  title = {New word detection and emotional tendency judgment based on mixed model},
  author = {Xiao Sun and Chongyuan Sun and Fuji Ren},
  year = {2014},
  doi = {10.1109/CCIS.2014.7175714},
