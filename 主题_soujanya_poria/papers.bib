@misc{louis_philippe_morency_b50037281812a1ff,
  title = {Context-Dependent Sentiment Analysis in User-Generated Videos},
  author = {Soujanya Poria and Devamanyu Hazarika and Navonil Majumder and Amir Zadeh and Louis-Philippe Morency and Erik Cambria},
