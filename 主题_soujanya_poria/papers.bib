@misc{soujanya_poria_63211b2268daae85,
  title = {Beyond Small Talk: Modeling Disclosure Trajectories in Human-AI Conversation},
  author = {Keith Kwok and Wanting Ning and Tej Deep Pala and Desmond C. Ong and S. Supraja and Renwen Zhang and Soujanya Poria},
  year = {2026},
  doi = {10.48550/arxiv.2610.29413},
  url = {https://arxiv.org/abs/2610.29413},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：超越闲聊：对人类与人工智能对话中的披露轨迹进行建模},
  abstract = {Recently, we see a rise in conversational agents as a form of social and emotional support, where disclosure will unfold over time. Yet, current evaluations of these agents typically examine isolated conversational states. In analyses of naturally occurring conversations, disclosure history and current disclosure are confounded which tends to make their effects difficult to isolate. We thus introduce Trajectory-based Disclosure Evaluation (TraDE), an evaluation framework grounded in Social Penetration Theory that utilizes predefined disclosure trajectories and evaluates how preceding disclosure history shapes model behavior under matched current disclosure. Through the use of TraDE, we demonstrate across multiple models and relational behavior benchmarks that responses to disclosures matched on depth can differ depending on the preceding trajectory, particularly in whether models accept or challenge the user's framing. We also observed that these differences track accumulated exposure to deeper disclosure rather than any single moment of vulnerability or the order of disclosures. It also tends to persists for several turns after disclosure returns to shallow levels. For several behaviors, we also demonstrate that models diverge most consistently from human supporters in the Emotional Support Conversation corpus (ESConv) not when users open up but rather when they step back in their disclosure. TraDE thus provides a systematic way to expose history-dependent relational behavio},
}

@misc{soujanya_poria_f138da1f472b6cbc,
  title = {Beyond What to Select: A Plug-and-play Oscillatory Data-Volume Scheduling for Efficient Model Training},
  author = {Soujanya Poria and Guang Li and Hanqi Zhu and Suorong Yang and Hai Gan and Fangjian Su and Furao Shen},
  year = {2026},
  doi = {10.48550/ARXIV.2605.14773},
  url = {https://doi.org/10.48550/ARXIV.2605.14773},
  howpublished = {CoRR},
  annotation = {中文辅助译名：超越选择：用于高效模型训练的即插即用振荡数据量调度},
  abstract = {Data selection accelerates training by identifying representative training data while preserving model performance. However, existing methods mainly focus on designing sample-importance criteria, i.e., deciding what to select, while typically fixing the selected data volume as the target ratio throughout training. Thus, they are often dynamic in sample identity but static in data volume. In this work, we revisit data selection from an optimization perspective and show that selected-data training induces an implicit regularization effect modulated by the instantaneous selection ratio. This reveals a key trade-off: lower ratios amplify selection-induced regularization, whereas higher ratios preserve data coverage and optimization fidelity. Motivated by this insight, we propose PODS, a Plug-and-play Oscillatory Data-volume Scheduling framework. Rather than introducing another sample-scoring metric, PODS serves as a lightweight module that dynamically schedules how much data to select over training. Under the target selection ratio, PODS alternates between low-ratio regularization phases and high-ratio recovery phases to exploit selection-induced regularization without sacrificing optimization stability. With its lightweight, ratio-level, and task-agnostic design, PODS is compatible with existing static and dynamic selection methods and broadly applicable across training paradigms. Experiments across various datasets, architectures, and tasks show that PODS consistently improves },
}

