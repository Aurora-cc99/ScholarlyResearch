@misc{suge_wang_d2501eb47bf8091d,
  title = {Sufficiency-Aware Adversarial Evidence Masking for Textual Emotion-Cause Pair Extraction in Conversations},
  author = {Mengqiang Hu and Qian Chen and Xin Guo and Suge Wang},
  year = {2026},
  doi = {10.18653/2026.emnlp-main.971},
  url = {https://doi.org/10.18653/2026.emnlp-main.971},
  howpublished = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  annotation = {中文辅助译名：用于对话中文本情感-原因对提取的充分感知对抗性证据屏蔽},
  abstract = {Textual Emotion-Cause Pair Extraction in Conversations (TECPE) requires identifying emotion utterances, their categories, and the textual cause spans that explain them.Although recent systems improve aggregate scores, clean supervision can induce evidence bias: models exploit explicit emotion cues, cause-emotion proximity, and speaker/discourse priors rather than evidence sufficient for causal explanation.We introduce SAAM-EC, a sufficiencyaware adversarial evidence masking framework for span-grounded TECPE.SAAM-EC adversarially masks high-impact conversational evidence units during training, but treats masking as a semantic intervention rather than a label-preserving perturbation.When masking removes the cause span or necessary bridge context, the span may become unextractable or the relation unsupported.SAAM-EC therefore combines adversarial masking with a sufficiency gate and an extractability guard, training masked examples to recover the original span only when the remaining dialogue still supports the emotion-cause relation and preserves the annotated span; otherwise, it trains the model with an unanswerability objective.All auxiliary components are discarded at inference, leaving the backbone unchanged.Experiments on spanlevel TECPE and utterance-level ECPE benchmarks show consistent performance gains over clean backbones and masking-based alternatives.Diagnostics further show better recovery on distant and cross-speaker causes and stronger abstention under destructive},
}

