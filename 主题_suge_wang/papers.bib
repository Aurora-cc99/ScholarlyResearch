@misc{suge_wang_6ad0738a611dedb0,
  title = {Segment-Level Evidence-Based Selection for Long-Context Emotion Recognition in Conversations},
  author = {Zhengqi Yan and Qian Chen and Jian Liao and Xin Guo and Suge Wang},
  year = {2026},
  doi = {10.1109/IJCNN69854.2026.11729027},
  url = {https://doi.org/10.1109/IJCNN69854.2026.11729027},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：对话中长上下文情感识别的分段级基于证据的选择},
  abstract = {Emotion recognition in long conversations is challenging because crucial emotional cues are sparse and easily diluted by noisy full-context aggregation. We propose an evidence-based selection framework that treats long-context ERC as evidence identification: utterances are encoded with speaker-aware representations, grouped into coherent dialogue segments, and each segment is scored for target-conditioned relevance. The model then performs hard top-M evidence selection and predicts the target emotion using only the selected evidence subset with lightweight evidence-level reasoning. This design improves robustness under extended histories and yields human-inspectable rationales. Experiments on DailyDialog and MELD improve Macro-F1 over RoBERTa-Flat by 1.27 and 1.91 points when averaging over all seven classes. We further assess the interpretability with counterfactual faithfulness tests based on sufficiency and comprehensiveness and with human–model evidence agreement.},
}

