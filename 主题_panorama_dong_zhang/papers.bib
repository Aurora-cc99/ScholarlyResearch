@misc{panorama_dong_zhang_a4d37b5bbdbbf791,
  title = {Distortion estimation for two-step view synthesis},
  author = {Dong Zhang and Jie Liang and Xiangyang Gong},
  year = {2013},
  doi = {10.1109/pcs.2013.6737691},
  url = {https://doi.org/10.1109/pcs.2013.6737691},
  howpublished = {Picture Coding Symposium},
  annotation = {中文辅助译名：两步视图合成的畸变估计},
  abstract = {In depth-image-based-rendering (DIBR), the quality of the synthesized virtual view depends on that of the depth maps in the reference views. In this paper, we develop a framework to estimate the distortion of the synthesized view when a simplified two-step warping algorithm is used and when there are random errors in the reference depth maps. A graph-based method is developed to obtain the depth and texture distributions in the synthesized view. Experimental results demonstrate the accuracy of the estimated distortion.},
}

