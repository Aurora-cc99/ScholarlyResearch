@misc{panorama_dong_zhang_ed31a3e1776ef9de,
  title = {A gated leaky integrate-and-fire spiking neural network based on attention mechanism for multi-modal emotion recognition},
  author = {Guoming Chen and Zhuoxian Qian and Shuang Qiu and Dong Zhang and Ruqi Zhou},
  year = {2025},
  doi = {10.1016/J.DSP.2025.105322},
  url = {https://doi.org/10.1016/J.DSP.2025.105322},
  howpublished = {Digit. Signal Process.},
  annotation = {中文辅助译名：基于注意力机制的多模态情感识别门控漏积分激发脉冲神经网络},
  abstract = {Multi-modal emotion recognition is a key research area in human-computer interaction. It involves processing heterogeneous multi-modal signals, which present challenges in signal alignment while aiming to enhance accuracy and reduce computational complexity. To address these challenges, we apply swarm decomposition to EEG signals to reduce noise and extract Short-Time Fourier Transform features. Heatmap features are then derived from these signals, as well as from other non-physiological signals such as facial expressions, voice, and text. These features from various sources are aligned using Discrete Wavelet Transform. We propose a Gated Leaky Integrate-and-Fire Spiking Convolutional Vision Transformer(GLIFCVT) framework for multimodal emotion recognition. This framework utilizes visual features as the primary modality and incorporates a spiking gated attention mechanism to enhance multimodal fusion and classification. In addition, we propose a novel loss function that integrates Focal and Dice losses to address class imbalance. Experiments demonstrate our proposed model consistently outperforms state-of-the-art methods in both accuracy and energy efficiency.},
}

