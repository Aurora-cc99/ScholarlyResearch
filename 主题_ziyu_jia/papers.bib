@misc{ziyu_jia_7fff72f92d396e1c,
  title = {Enhancing Few-Channel EEG Model via Multichannel Multiview Heterogeneous Knowledge Distillation for Motor Imagery},
  author = {Heng Liang and Fengming Zhao and Peiliang Gong and Yucheng Liu and Ziyu Jia},
  year = {2026},
  doi = {10.1109/tnnls.2026.3732213},
  url = {https://doi.org/10.1109/tnnls.2026.3732213},
  howpublished = {IEEE Transactions on Neural Networks and Learning Systems},
  annotation = {中文辅助译名：通过运动想象的多通道多视图异质知识蒸馏增强少通道脑电图模型},
  abstract = {Motor imagery is an important experimental paradigm in brain–computer interfaces (BCIs), with significant application potential and research value. Existing research primarily focuses on multichannel electroencephalography (EEG) signals, achieving strong performance. However, multichannel EEG models require high computational costs, making them challenging to deploy on wearable devices. In contrast, few-channel EEG models are more suitable for wearables, but their limited feature information hinders model performance. Knowledge distillation is an effective method for transferring knowledge. By utilizing the feature information from multichannel EEG models, we have effectively improved the performance of few-channel EEG models. Specifically, we design the multichannel multiview heterogeneous knowledge distillation (MMHKD) framework, which includes three modules: the multichannel knowledge distillation module, the mutual information (MI)-based knowledge distillation module, and the multiview knowledge distillation module. The multichannel knowledge distillation module transfers rich multichannel EEG feature information based on an adaptive attention mechanism. The MI-based knowledge distillation module maximizes the MI between heterogeneous models, alleviating the feature gap between them. The multiview knowledge distillation module transfers vital relational knowledge between views, further enhancing the effectiveness of knowledge distillation. Experimental results demonstrate},
}

@misc{ziyu_jia_7064b8aff32d5004,
  title = {A Low-Rank Approximation Based Multi-Modal Multi-Level Disentangling Network for Efficient Emotion Recognition},
  author = {Hairong Chen and Ziyu Jia and Tianzi Jiang},
  year = {2026},
  doi = {10.1109/taffc.2026.3691107},
  url = {https://doi.org/10.1109/taffc.2026.3691107},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：一种基于低秩逼近的多模态多级解缠网络，用于高效情绪识别},
  abstract = {Emotion recognition based on multi-modal physiological signals has recently attracted significant attention. However, challenges remain in multimodal fusion, handling individual differences, and managing the large model sizes in this domain. To address these challenges, we propose a lightweight cross-subject multi-modal emotion recognition model, tiny-MMDNet. This model reduces model parameters by employing a dynamic low-rank approximation technique within a multi-level disentangling framework. Specifically, tiny-MMDNet consists of a modality-level disentangling module and a subject-level disentangling module. The modality-level disentangling module projects the raw multi-modal physiological signals into modality-invariant and modality-specific subspaces, capturing both modality-invariant and modality-specific features. Meanwhile, the subject-level disentangling module separates subject-shared and subject-private features within the modality-level features to enhance cross-subject emotion recognition. Furthermore, tiny-MMDNet dynamically compresses the model through dynamic low-rank approximation, reducing model parameters while maintaining performance. Experimental results demonstrate that tiny-MMDNet achieves superior cross-subject recognition accuracy and effective model compression on public available multi-modal emotion datasets, outperforming current state-of-the-art models.},
}

@misc{ziyu_jia_c33186f76824f1aa,
  title = {A New Dual-Attention Multi-Node Fusion Network for EEG-fNIRS Motor Imagery Classification},
  author = {Lufeng Feng and Baomin Xu and D Li and Shifan Jia and Ziyu Jia and Wei Ni},
  year = {2026},
  doi = {10.1109/jbhi.2026.3706103},
  url = {https://doi.org/10.1109/jbhi.2026.3706103},
  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：用于 EEG-fNIRS 运动意象分类的新型双注意多节点融合网络},
  abstract = {Brain-computer interface (BCI) based on motor imagery (MI) can realize the direct control of external devices by decoding different signals. The decoding of MI based on electroencephalogram (EEG) suffers from low spatial resolution and is susceptible to noise. Functional near-infrared spectroscopy (fNIRS) has attracted increasing attention as a complementary modality. There have been attempts to fuse the two types of signals, but their spatio-temporal characteristics have not been fully explored. We propose a new multimodal EEG-fNIRS fusion MI classification and recognition model based on a dual attention mechanism. The model comprises two feature extraction branches and a central fusion network. We set two fusion layers in the central fusion network to exploit the spatio-temporal features of EEG and fNIRS. To reduce redundancy and mine correlation characteristics of multiple sensors, the features are fused in the filter dimension to prevent adverse effects between signals during fusion, thereby enabling the deep network to learn cross modal correlations while reducing mutual interference. The method is evaluated on two multimodal datasets. Experiments show that DAMFNet outperforms STA-Net and M2NN by 4.49% and 2.88% on Dataset1, respectively, and shows competitive performance on Dataset2. The code is available at https://github.com/useflf/DAMFNet.},
}

@misc{ziyu_jia_115f158e6358a7e0,
  title = {Robust Low-Rank Sparse Framework for Video-Based Affective Computing},
  author = {Feng-Qi Cui and Jinyang Huang and Sirui Zhao and Xinyu Li and Xin Yan and Ziyu Jia and Xiaokang Zhou},
  year = {2026},
  doi = {10.1109/tce.2026.3697969},
  url = {https://doi.org/10.1109/tce.2026.3697969},
  howpublished = {IEEE Transactions on Consumer Electronics},
  annotation = {中文辅助译名：用于基于视频的情感计算的鲁棒低秩稀疏框架},
  abstract = {Video-based Affective Computing (VAC) is central to emotion understanding and emerging consumer electronics applications, yet it often suffers from unstable optimization and representational degradation under complex, non-stationary affective dynamics in the wild. A key challenge is that short-term behavioral fluctuations can convey different affective meanings under different long-term emotional contexts, whereas most existing VAC models entangle heterogeneous factors in a single latent space, leading to component mixing and cross-scale inconsistency. We propose the Low-Rank Sparse Emotion Understanding Framework (LSEF), a plug-and-play framework grounded in the low-rank sparse principle that models affective dynamics as the composition of long-term emotional bases and sparse transient perturbations. Specifically,LSEFconsists of four modules: the Stability Encoding Module (SEM) extracts low-rank bases by emphasizing slow-varying context patterns; the Dynamic Decoupling Module (DDM) isolates sparse transients via temporal routing and orthogonalized relational propagation; and the Consistency Integration Module (CIM) restores multi-scale coherence between stability and reactivity under hierarchical aggregation. We further propose a Rank Aware Optimization (RAO) strategy that adaptively modulates perturbation strength according to rank- and sparsity-sensitive structure to improve training stability and generalization. Experiments on discrete and continuous VAC benchmarks show c},
}

@misc{ziyu_jia_723ee16fac6d,
  title = {CodeBrain: Bridging Decoupled Tokenizer and Multi-Scale Architecture for EEG Foundation Model},
  author = {Jingying Ma and Feng Wu and Qika Lin and Yucheng Xing and Chenyu Liu and Ziyu Jia and Mengling Feng},
  year = {2026},
  doi = {10.48550/arxiv.2506.09110},
  url = {https://openreview.net/forum?id=msJgEkjwh5},
  howpublished = {The Fourteenth International Conference on Learning Representations ( ICLR ), 2026 [OpenReview]},
  annotation = {中文辅助译名：CodeBrain：桥接解耦分词器和 EEG 基础模型的多尺度架构},
  abstract = {Electroencephalography (EEG) provides real-time insights into brain activity and supports diverse applications in neuroscience. While EEG foundation models (EFMs) have emerged to address the scalability issues of task-specific models, current approaches still yield clinically uninterpretable and weakly discriminative representations, inefficiently capturing global dependencies and neglecting important local neural events. We present CodeBrain, a two-stage EFM designed to fill this gap. In the first stage, we introduce the TFDual-Tokenizer, which decouples heterogeneous temporal and frequency EEG signals into discrete tokens, quadratically expanding the representation space to enhance discriminative power and offering domain-specific representation-level interpretability by suggesting potential links to neural events and spectral rhythms. In the second stage, we propose the multi-scale EEGSSM architecture, which combines structured global convolution with sliding window attention to efficiently capture both sparse long-range and local dependencies, reflecting the brain's small-world topology. Pretrained on the largest public EEG corpus, CodeBrain achieves strong generalization across eight downstream tasks and ten datasets under distribution shifts, supported by comprehensive ablations, scaling-law analyzes, and interpretability evaluations. The code and the pretrained weights are available at https://github.com/jingyingma01/CodeBrain.},
}

