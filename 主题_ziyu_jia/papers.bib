@misc{xiaoli_li_051b9150959a,
  title = {Foundation Model Guided Dual-Branch Co-Adaptation for Source-Free EEG Decoding},
  author = {Peiliang Gong and Han Zhang and Zhen Jiang and Chenyu Liu and Ziyu Jia and Xinliang Zhou and Daoqiang Zhang and Xiaoli Li},
  year = {2026},
  doi = {10.1145/3767308.3835689},
  url = {https://doi.org/10.1145/3767308.3835689},
  howpublished = {arXiv preprint},
  annotation = {中文辅助译名：基础模型引导双分支协同适应无源脑电图解码},
  abstract = {Source-free domain adaptation (SFDA) provides a practical solution to cross-subject EEG decoding by adapting source-pretrained models to unlabeled target domains without accessing source data. However, existing SFDA methods rely solely on the limited internal knowledge of source-pretrained models, leading to inferior cross-domain generalization and unreliable pseudo-labels. Although EEG Foundation Models (FMs) pretrained on large-scale data exhibit strong generalizability, their potential in SFDA remains largely unexplored. To this end, we propose FUSED, a Foundation-gUided Source-free EEG Decoding framework that integrates a large-scale FM with a compact Specialist Model (SM) via dual-branch co-adaptation. Specifically, we introduce a Co-adaptation mechanism equipping both branches with linear and prototype views, enabling cross-branch pseudo-label generation. Additionally, we design a Consensus Filtering Mechanism that exploits the FM's inherent stability to identify high-quality samples, along with a Two-Stage Pseudo-Label Refinement scheme to suppress error accumulation through cross-branch arbitration. Finally, we calibrate the FM's decision boundaries via mutual information maximization with the SM, followed by knowledge distillation from FM to SM, forming a principled calibrate-then-distill pipeline. To our knowledge, FUSED is the first work to leverage EEG FMs within the SFDA framework for cross-subject EEG decoding. Extensive experiments across three EEG paradigms, i},
}

@misc{ziyu_jia_ce93a0a5adc4e6e7,
  title = {Motor Imagery Spatial–Temporal Cross-Fusion Classification Based on fNIRS-Informed EEG Source Space and Brain-Atlas Constraints},
  author = {Lufeng Feng and Baomin Xu and Bihai Lin and Jun Bai and D Li and Shifan Jia and Ziyu Jia and Wei Ni},
  year = {2026},
  doi = {10.1109/tce.2026.3697375},
  url = {https://doi.org/10.1109/tce.2026.3697375},
  howpublished = {IEEE Transactions on Consumer Electronics},
  annotation = {中文辅助译名：基于 fNIRS 信息的脑电图源空间和脑图谱约束的运动想象时空交叉融合分类},
  abstract = {Due to the inherent volume conduction effect, EEG-based motor imagery (MI) decoding is limited by the low spatial resolution of scalp recordings. To improve MI decoding, we propose a brain atlas-constrained EEG source-space spatial-temporal cross-fusion framework assisted by functional near-infrared spectroscopy (fNIRS). In the source-imaging stage, task-relevant spatial priors derived from fNIRS are used to regularize EEG source imaging, yielding more reliable source-space signals. In the spatial-temporal fusion stage, a lightweight temporal branch is constructed to capture multi-scale temporal dynamics. Spatially, ROI nodes are defined under a brain-atlas constraint, and a correlation-based functional connectivity graph is built among nodes. To better model MI-related spatial laterality and inter-regional cooperation, a spatial branch that combines approximate personalized propagation (APPNP) and a graph attention network (GAT) is employed to learn long-range dependencies and adaptive connection weights. Finally, a cross-attention fusion module is used to enable dynamic interactions between temporal features and spatial node representations. The proposed method achieves an accuracy of 72.81% ± 7.23 on Dataset 1 and 34.97% ± 5.39 on Dataset 2, outperforming representative EEG–fNIRS multimodal baselines. The code is available at https://github.com/useflf/MI-ESI.},
}

