  annotation = {中文辅助译名：基于自动编码器和循环神经网络特征融合的行为识别研究},
  abstract = {Under the impact of COVID-19, research on behavior recognition are highly needed. In this paper, we combine the algorithm of self-adaptive coder and recurrent neural network to realize the research of behavior pattern recognition. At present, most of the research of human behavior recognition is focused on the video data, which is based on the video number. At the same time, due to the complexity of video image data, it is easy to violate personal privacy. With the rapid development of Internet of things technology, it has attracted the attention of a large number of experts and scholars. Researchers have tried to use many machine learning methods, such as random forest, support vector machine and other shallow learning methods, which perform well in the laboratory environment, but there is still a long way to go from practical application. In this paper, a recursive neural network algorithm based on long and short term memory (LSTM) is proposed to realize the recognition of behavior patterns, so as to improve the accuracy of human activity behavior recognition.},
}

@misc{panorama_jiahui_pan_486e1c881c5e778f,
  title = {Enhancing BCI-Based Emotion Recognition Using an Improved Particle Swarm Optimization for Feature Selection},
  author = {Zina Li and Lina Qiu and Ruixin Li and Zhipeng He and Jun Xiao and Yan Liang and Fei Wang and Jiahui Pan},
  year = {2020},
  doi = {10.3390/S20113028},
  url = {https://doi.org/10.3390/S20113028},
