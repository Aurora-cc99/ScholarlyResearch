@misc{panorama_9c77620f2fcd_0fd261f8b5c14e3c,
  title = {A review on method framework construction of Chinese Information Science},
  author = {Bowen Li and Liang Tian and Yingyi Zhang and Heng Zhang and Chengzhi Zhang},
  year = {2022},
  doi = {10.1016/j.dim.2022.100023},
  url = {https://doi.org/10.1016/j.dim.2022.100023},
