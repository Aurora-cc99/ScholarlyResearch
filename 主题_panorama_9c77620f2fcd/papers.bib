  annotation = {中文辅助译名：使用多种混合策略从百科全书资源中提取中文同义词},
  abstract = {Automatic extraction of Chinese synonyms plays an important role in information retrieval and semantic resource construction. Based on the analyzing and comparing the different technologies of synonyms extraction, this paper proposes multi-strategy method including literal similarity algorithm, pattern matching algorithm and PageRank algorithm to extraction Chinese synonyms from encyclopedia resource. The method is language-independent and supports any domain. In addition, it can be able to extract synonyms in various types of expressions. The experiment result shows that the method is feasible and practical.},
}

@misc{panorama_9c77620f2fcd_ce81c59fc05125f6,
