  author = {Jiashu Hao and Chengzhi Zhang and Huilin Wang},
  year = {2009},
  doi = {10.1109/wi-iat.2009.274},
  url = {https://doi.org/10.1109/wi-iat.2009.274},
  howpublished = {IEEE/WIC/ACM International Conference on Web Intelligence and Intelligent Agent Technology (WI-IAT)},
  annotation = {中文辅助译名：使用关键词聚类构建本体层次结构},
  abstract = {Hierarchy is the basic framework of Ontology, and hierarchies construction is key point in the Ontology construction. Ontology hierarchy can be generated by the method of keywords clustering. In this paper, we use EM algorithm to cluster the keywords and constructs hierarchy in the domain of library and information science. After selecting the appropriate clustering numbers, each cluster description is generated. Then, each cluster is re-clustered and the next levels are generated. The experiments results show that the proposed method can construct the Chinese domain Ontological hierarchies efficiently.},
}

