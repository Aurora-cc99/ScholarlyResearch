@misc{panorama_9c77620f2fcd_668514341771cba9,
  title = {Joint Modeling of Characters, Words, and Conversation Contexts for Microblog Keyphrase Extraction},
  author = {Yingyi Zhang and Chengzhi Zhang and Jing Li},
  year = {2019},
  doi = {10.1002/asi.24279},
