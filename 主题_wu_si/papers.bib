  doi = {10.1109/IJCNN.2000.857897},
  url = {https://doi.org/10.1109/IJCNN.2000.857897},
  howpublished = {IJCNN (2)},
  annotation = {中文辅助译名：不忠实的人口解码},
  abstract = {Unfaithful population decoding is a paradigm of the maximum likelihood inference based on a model, which is not feasible to describe the encoding process (UMLI) (Wu et al., 1999). The present paper studies the performance of UMLI, through investigating an unfaithful decoding model which neglects the multiplicative correlation between neural activities. It shows that UMLI is a good compromise between computational complexity and decoding accuracy.},
}

