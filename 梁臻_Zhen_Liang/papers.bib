@misc{liang_zhen_a00219d930ed,
  title = {Integrating EEG and fMRI in naturalistic paradigms: Advances in understanding mental disorders-a decade study in review (2014-2024)},
  author = {Anam Mehmood and Shuyue Xu and Sultan Mehmood Siddiqi and Li Zhang and Gan Huang and Zhen Liang and Yongjie Zhou},
