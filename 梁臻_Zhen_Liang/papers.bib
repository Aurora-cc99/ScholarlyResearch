}

@misc{liang_zhen_83a59ae2006453ac,
  title = {RNA sequencing identified specific circulating miRNA biomarkers for early detection of diabetes retinopathy},
  author = {Zhen Liang and Kai Gao and Yi X. Wang and Zi C. Liu and Li Tian and Xin Yang and Jing Y. Ding and Wei Wu and Wen Yang and Yi L. Li and Ze B. Zhang and Ri H. Zhai},
