  author = {Martin Wöllmer and Michel F. Valstar and Etienne de Sevin and Elisabetta Bevacqua and Dirk Heylen and Björn W. Schuller and Hatice Gunes and Sathish Pammi and Catherine Pelachaud and Mark ter Maat and Marc Schröder and Florian Eyben and Maja Pantic},
