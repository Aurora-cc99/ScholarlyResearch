  title = {DEIRA: A Dynamic Engaging Intelligent Reporter Agent (Demo Paper)},
  author = {François L.A. Knoppel and Almer S. Tigelaar and Danny Oude Bos and Thijs Alofs and Anton Nijholt and Maja Pantić and Mannes Poel and Hendri Hondorp},
  year = {2008},
  url = {https://research.utwente.nl/en/publications/f9cc7bc5-7ab7-47dc-b3af-b26c2ba6b8ca},
  howpublished = {University of Twente Research Information},
  annotation = {中文辅助译名：DEIRA：动态参与的智能报告代理（演示论文）},
  abstract = {DEIRA is an embodied agent with a highly modular design, supporting several domains such as real time virtual horse race commentary, robosoccer commentary and virtual storytelling. Domain-specific information is processed to have the agent act on emotion and produce a compelling report on the situation, using synthesized speech and facial expressions. This paper briefly describes the features of the agent.},
