  author = {Bo Yang and Shibo Zhou and Chaohui Lin and Qingao Chai and Rui Yan and De Ma and Gang Pan and Huajin Tang},
  year = {2025},
  doi = {10.1109/ICRA55743.2025.11128063},
  url = {https://doi.org/10.1109/ICRA55743.2025.11128063},
  howpublished = {ICRA},
  annotation = {中文辅助译名：HSRL：基于脉冲深度强化学习的机器人导航分层控制系统},
  abstract = {Reinforcement Learning (RL) has shown promise in robotic navigation tasks, yet applying it to real-world environments remains challenging due to dynamic complexities and the need for dynamically feasible actions. We propose a hierarchical control framework based on Spiking Deep Reinforcement Learning (SDRL) for robust robot navigation in real environments. Our approach utilizes a two-layer architecture: a high-level decision layer powered by a Spiking GRU network for handling partially observable environments, and a low-level executive layer employing Continuous Attractor Neural Networks (CANNs) to ensure precise and continuous actions. This hierarchical structure allows real-time decisionmaking that respects the physical constraints of the robot. Experimental results show that our method adapts effectively to new environments without fine-tuning and surpasses existing methods in performance. We also explore the implementation on the Darwin3 chip, paving the way for biologically inspired motion control in future robotic applications.},
}

@misc{pan_gang_c0cc5062d267,
