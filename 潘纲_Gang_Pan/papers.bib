@misc{pan_gang_e46511b598aa,
  title = {Pervasive Service Bus: Smart SOA Infrastructure for Ambient Intelligence},
  author = {Gang Pan and Li Zhang and Zhaohui Wu and Shijian Li and Laurence T. Yang and Man Lin and Yuanchun Shi},
  year = {2014},
  doi = {10.1109/MIS.2012.119},
  url = {https://doi.org/10.1109/MIS.2012.119},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：普适服务总线:用于环境智能的智能SOA基础设施。},
  abstract = {Ambient intelligence (AmI) aims to make our everyday environments intelligent--that is, sensitive, adaptive, and responsive to the presence of people--in a transparent manner. Several challenges exist to building an efficient infrastructure for AmI, including interoperation of heterogeneous systems, intelligence for anticipatory user assistance, adaptability to dynamic environments for good user experience, and scalability to additional users and spaces. Here, the authors propose Pervasive Service Bus (PSB), a smart service-oriented architecture (SOA) framework for AmI spaces that models all computing activities as unified pervasive services. They present an online planning algorithm to adapt service flows to contexts and user tasks. PSB employs a sub-bus-based layout to maintain efficiency in large-scale service interactions. They also discuss their results in evaluating PSB's performance in a Smart Home testbed.},
}

@misc{pan_gang_63c84196a3ff,
  title = {Counting moving people in crowds using motion statistics of feature-points},
