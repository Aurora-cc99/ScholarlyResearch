@misc{pan_gang_16300a7ca5b7,
  title = {Semantic Device Bus for Internet of Things},
  author = {Kun Yang and Shijian Li and Li Zhang and Gang Pan},
  year = {2010},
  doi = {10.1109/EUC.2010.57},
  url = {https://doi.org/10.1109/EUC.2010.57},
  howpublished = {EUC},
  annotation = {中文辅助译名：物联网的语义设备总线。},
  abstract = {The vision of the Internet of things is very appealing, and gains more and more attention. Since mobile devices in the Internet become more complex and heterogeneous, device collaboration will be full of technical challenges. How to integrate different systems and heterogeneous devices is a big problem. In order to overcome the problem, it is very important to describe and match the heterogeneous device services with semantics. We use web service interface specification to wrap device, and OWL to describe services in semantic. In this paper we introduce a semantic device bus for Internet of things, which will allow service creation of different devices, management of device services, semantic description and matching of device services, and complex collaboration of device services. The bus provides a fundamental platform for large-scale applications of the Internet of things.},
}

@misc{pan_gang_0c23b3ea9785,
