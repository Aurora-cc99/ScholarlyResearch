@misc{pan_gang_20e0e23624b1a301,
  title = {HD-tACS at 40 Hz improves consciousness and brain connectivity in prolonged disorders of consciousness: a randomized sham-controlled clinical trial},
  author = {Jun Hu and Chenye Mou and Xiaoyi Jiang and Li Zhang and Yi Ling and Jiajia Zhao and Fanxia Meng and Fangping He and Hanxiao Wang and Fujing Peng and Jing Ning and Jian Gao and Chuan Xu and Jun Xiao and Sha Zhao and Jie Yu and Gang Pan and Benyan Luo},
  year = {2026},
  doi = {10.1016/J.NEUROIMAGE.2026.122274},
  url = {https://doi.org/10.1016/J.NEUROIMAGE.2026.122274},
  howpublished = {NeuroImage},
  annotation = {中文辅助译名：40 Hz 的 HD-tACS 可改善长期意识障碍中的意识和大脑连接：一项随机假对照临床试验},
  abstract = {BACKGROUND: Frequency-specific high-definition transcranial alternating current stimulation (HD-tACS) may facilitate recovery in patients with prolonged disorders of consciousness (pDoC), but predictive biomarkers and mechanistic insights are limited. OBJECTIVE: To investigate the therapeutic efficacy of 40 Hz or 4 Hz HD-tACS in pDoC. METHODS: Sixty pDoC patients were randomized into four groups receiving 40 Hz or 4 Hz HD-tACS, each with a corresponding sham condition. Behavioral recovery was assessed via Coma Recovery Scale-Revised (CRS-R), network connectivity was analyzed with electroencephalography (EEG), and baseline 40 Hz auditory steady-state response (ASSR) was explored as a predictive biomarker. RESULTS: Five days of 40 Hz HD-tACS yielded greater improvements of total CRS-R scores than 4 Hz or sham, particularly in visual and arousal subscales. EEG revealed strengthened short- and long-range connectivity quantified by phase-locking value (PLV), correlating with behavioral gains. At six months, 37.5% of 40 Hz patients got a good outcome with Glasgow Outcome Scale-Extended (GOS-E) score ≥ 4, which was significantly higher than that observed in the sham group (P = 0.019). Higher baseline ASSR predicted stronger network enhancement and clinical improvement. CONCLUSIONS: 40 Hz HD-tACS promotes recovery and network reorganization in pDoC. Baseline ASSR may provide complementary information for understanding individual variability in responses to frequency-specific neuromod},
}

@misc{pan_gang_0611aea00d2ce7c1,
  title = {Low-power differencing feature extracts spiking-band activities for high-performance intracortical brain-computer interfaces},
  author = {Guangxiang Xu and 郁陈彬 and Gengrong Shao and Gang Pan and Yueming Wang and Yaoyao Hao},
  year = {2026},
  doi = {10.1038/s42003-026-10144-9},
  url = {https://doi.org/10.1038/s42003-026-10144-9},
  howpublished = {Communications Biology},
  annotation = {中文辅助译名：低功耗差分功能提取高性能皮层内脑机接口的尖峰带活动},
  abstract = {Intracortical brain-computer interfaces (iBCIs) demand computationally efficient feature extraction methods to process high-bandwidth neural signals in resource-constrained implantable systems. We present the mean absolute of n-th difference (MAND), a feature extraction technique that utilizes optimized differencing operations to isolate spiking-band activity with minimal computational overhead. Through theoretical and empirical validation across multiple datasets encompassing human handwriting, primate reaching/grasping, and rodent cognitive tasks, MAND demonstrated superior performance compared to state-of-the-art features, significantly reducing velocity reconstruction error and improving classification accuracy. An extended MAND variant, incorporating a weighted sum of dual-differencing, achieved additional performance gains through enhanced spectral alignment with neural spiking activity. Hardware implementation on FPGA/MCU platforms confirmed MAND's exceptional efficiency - processing 10-second neural recordings in just 6 ms while consuming only 3 mW of power - representing orders-of-magnitude improvements in both speed and energy efficiency compared to conventional methods. These results establish MAND as a breakthrough solution that enables superior decoding performance with exceptional computational efficiency, paving the way for next-generation, fully implantable iBCI systems.},
}

