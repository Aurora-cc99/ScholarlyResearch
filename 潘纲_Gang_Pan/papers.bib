@misc{pan_gang_f979d4334204,
  title = {Domain Adaptation for Infrared-Radar Cross-Scene Multimodal Detection},
  author = {Bosong Chai and Qian Zheng and Xuan Nie and Jianchao Jia and Gang Pan},
  year = {2024},
  doi = {10.1109/CIS-RAM61939.2024.10673131},
