@misc{pan_gang_cc2648aed3e7,
  title = {3D Face Recognition in the Presence of Expression: A Guidance-based Constraint Deformation Approach},
  author = {Yueming Wang and Gang Pan and Zhaohui Wu},
  year = {2007},
  doi = {10.1109/CVPR.2007.383277},
  url = {https://doi.org/10.1109/CVPR.2007.383277},
  howpublished = {CVPR},
  annotation = {中文辅助译名：存在表情时的3D人脸识别:基于指导的约束变形方法。},
  abstract = {Three-dimensional human face recognition in the presence of expression is a big challenge, since the shape distortion caused by facial expression greatly weakens the rigid matching. This paper proposes a guidance-based constraint deformation(GCD) model to cope with the shape distortion by expression. The basic idea is that, the face model with non-neutral expression is deformed toward its neutral one under certain constraint so that the distortion is reduced while inter-class discriminative information is preserved. The GCD model exploits the neutral 3D face shape to guide the deformation, meanwhile applies a rigid constraint on it. Both steps are smoothly unified in the Poisson equation framework. The GCD approach only needs one neutral model for each person in the gallery. The experimental results, carried out on the large 3D face databases-FRGC v2.0, demonstrate that our method significantly outperforms ICP method for both identification and authentication mode. It shows the GCD model is promising for coping with the shape distortion in 3D face recognition.},
}

@misc{pan_gang_87519a228f80,
  title = {Eyeblink-based Anti-Spoofing in Face Recognition from a Generic Webcamera},
  author = {Gang Pan and Lin Sun and Zhaohui Wu and Shihong Lao},
  year = {2007},
  doi = {10.1109/ICCV.2007.4409068},
  url = {https://doi.org/10.1109/ICCV.2007.4409068},
  howpublished = {ICCV},
  annotation = {中文辅助译名：来自通用网络摄像头的人脸识别中基于眨眼的反欺骗。},
  abstract = {We present a real-time liveness detection approach against photograph spoofing in face recognition, by recognizing spontaneous eyeblinks, which is a non-intrusive manner. The approach requires no extra hardware except for a generic webcamera. Eyeblink sequences often have a complex underlying structure. We formulate blink detection as inference in an undirected conditional graphical framework, and are able to learn a compact and efficient observation and transition potentials from data. For purpose of quick and accurate recognition of the blink behavior, eye closity, an easily-computed discriminative measure derived from the adaptive boosting algorithm, is developed, and then smoothly embedded into the conditional model. An extensive set of experiments are presented to show effectiveness of our approach and how it outperforms the cascaded Adaboost and HMM in task of eyeblink detection.},
}

