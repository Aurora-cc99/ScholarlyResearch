@misc{pan_gang_83110f6fb16a,
  title = {Brain Connectivity Mediates Heartbeat-Evoked Potential Alterations Between Children With ADHD and Comorbid ADHD-ASD},
  author = {Jiajing Zhao and Chenyu Yan and Mengyi Bao and Qing Zhou and Haifeng Li and Gang Pan and Lin Yao and Yueming Wang},
