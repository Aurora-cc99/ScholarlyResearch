@misc{louis_philippe_morency_195553e37a0c080f,
  title = {MultiIoT: Towards Large-scale Multisensory Learning for the Internet of Things},
  author = {Paul Pu Liang and Louis-Philippe Morency and Shentong Mo and Ruslan Salakhutdinov},
  year = {2023},
  doi = {10.48550/ARXIV.2311.06217},
  url = {https://doi.org/10.48550/ARXIV.2311.06217},
  howpublished = {CoRR},
  annotation = {中文辅助译名：MultiIoT：迈向物联网的大规模多感官学习},
  abstract = {The next generation of machine learning systems must be adept at perceiving and interacting with the physical world through a diverse array of sensory channels. Commonly referred to as the `Internet of Things (IoT)' ecosystem, sensory data from motion, thermal, geolocation, depth, wireless signals, video, and audio are increasingly used to model the states of physical environments and the humans inside them. Despite the potential for understanding human wellbeing, controlling physical devices, and interconnecting smart cities, the community has seen limited benchmarks for building machine learning systems for IoT. Existing efforts are often specialized to a single sensory modality or prediction task, which makes it difficult to study and train large-scale models across many IoT sensors and tasks. To accelerate the development of new machine learning technologies for IoT, this paper proposes MultiIoT, the most expansive and unified IoT benchmark to date, encompassing over 1.15 million samples from 12 modalities and 8 real-world tasks. MultiIoT introduces unique challenges involving (1) generalizable learning from many sensory modalities, (2) multimodal interactions across long temporal ranges, (3) extreme heterogeneity due to unique structure and noise topologies in real-world sensors, and (4) complexity during training and inference. We evaluate a comprehensive set of models on MultiIoT, including modality and task-specific methods, multisensory and multitask supervised model},
}

@misc{louis_philippe_morency_fca1c0783e40b752,
  title = {MultiViz: Towards User-Centric Visualizations and Interpretations of Multimodal Models},
  author = {Zihao Deng and Paul Pu Liang and Nihal Jain and Louis-Philippe Morency and Yiwei Lyu and Gunjan Chhablani and Ruslan Salakhutdinov and Xingbo Wang},
  year = {2023},
  doi = {10.1145/3544549.3585604},
  url = {https://doi.org/10.1145/3544549.3585604},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：MultiViz：迈向以用户为中心的多模态模型的可视化和解释},
  abstract = {The nature of human and computer interactions are inherently multimodal, which has led to substantial interest in building interpretable, interactive, and reliable multimodal interfaces. However, modern multimodal models and interfaces are typically black-box neural networks, which makes it challenging to understand their internal mechanics. How can we visualize their internal workings in order to empower stakeholders to visualize model behavior, perform model debugging, and promote trust in these models? Our paper proposes MultiViz, a method for analyzing the behavior of multimodal models via 4 stages: (1) unimodal importance, (2) cross-modal interactions, (3) multimodal representations and (4) multimodal prediction. MultiViz includes modular visualization tools for each stage before combining outputs from all stages through an interactive and human-in-the-loop API. Through user studies with 21 participants on 8 trained models across 6 real-world tasks, we show that the complementary stages in MultiViz together enable users to (1) simulate model predictions, (2) assign interpretable concepts to features, (3) perform error analysis on model misclassifications, and (4) use insights from error analysis to debug models. MultiViz is publicly available at https://github.com/pliang279/MultiViz, will be regularly updated with new visualization tools and metrics, and welcomes input from the community1.},
}

