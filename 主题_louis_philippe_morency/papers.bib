  title = {Who is persuasive?: the role of perceived personality and communication modality in social multimedia},
  author = {Alessandro Vinciarelli and Kenji Sagae and Louis-Philippe Morency and Gelareh Mohammadi and Sunghyun Park},
  year = {2013},
