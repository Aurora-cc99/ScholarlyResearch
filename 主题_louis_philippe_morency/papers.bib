@misc{louis_philippe_morency_ef381c9ed2a9d572,
  title = {A Discriminative Nonparametric Bayesian Model: Inﬁnite Hidden Conditional Random Fields},
  author = {Konstantinos Bousmalis and Louis‐Philippe Morency and Stefanos P. Zafeiriou and Maja Pantić},
  year = {2011},
  url = {http://ict.usc.edu/pubs/A%20Discriminative%20Nonparametric%20Bayesian%20Model-%20In%EF%AC%81nite%20Hidden%20Conditional%20Random%20Fields.pdf},
  howpublished = {neural information processing systems},
  annotation = {中文辅助译名：判别性非参数贝叶斯模型：无限隐藏条件随机场},
  abstract = {Finite Hidden Conditional Random Fields (HCRFs) [5] are discriminative models that learn the joint distribution of a class label and a sequence of latent variables conditioned on a given observation sequence, with dependencies among latent variables expressed by an undirected graph. A limitation of the finite HCRFs is that finding the optimal number of hidden states for a given classification problem is not always intuitive, and involves cross–validation, that can be very computationally expensive. This limitation motivated our nonparametric HCRF model that automatically learns the optimal number of hidden states given a specific dataset. This is achieved by using Hierarchical Dirichlet Processes (HDPs) to allow for an infinite number of hidden states for the HCRF. The reader is encouraged to look at [6] for a complete description of Hierarchical Dirichlet Processes [6].},
}

@misc{louis_philippe_morency_507a42be0eb8f555,
