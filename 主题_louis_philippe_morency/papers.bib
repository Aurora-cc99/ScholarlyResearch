@misc{louis_philippe_morency_cd812de457609faa,
  title = {PANEL: Challenges for Multimedia/Multimodal Research in the Next Decade},
  author = {Hayley Hung and Louis-Philippe Morency and Alex Hauptmann and Alberto Del Bimbo and Shih-Fu Chang and Heng Ji and Cathal Gurrin and Alan F. Smeaton},
  year = {2019},
  doi = {10.1145/3343031.3351494},
  url = {https://doi.org/10.1145/3343031.3351494},
