@misc{louis_philippe_morency_c8ed2d530292529d,
  title = {3D Iconic Gesture Dataset},
  author = {Amir Sadeghipour and Louis‐Philippe Morency},
  year = {2011},
  doi = {10.4119/unibi/2683224},
