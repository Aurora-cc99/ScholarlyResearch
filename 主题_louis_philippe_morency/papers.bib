  author = {Louis-Philippe Morency and Derya Ozkan},
  year = {2011},
  url = {http://ict.usc.edu/pubs/Modeling%20Wisdom%20of%20Crowds%20Using%20Latent%20Mixture%20of%20Experts.pdf},
  howpublished = {ACL (2)},
  annotation = {中文辅助译名：使用判别性专家的潜在混合物对群体智慧进行建模},
  abstract = {In many computational linguistic scenarios, training labels are subjectives making it necessary to acquire the opinions of multiple annotators/experts, which is referred to as ”wisdom of crowds”. In this paper, we propose a new approach for modeling wisdom of crowds based on the Latent Mixture of Discriminative Experts (LMDE) model that can automatically learn the prototypical patterns and hidden dynamic among different experts. Experiments show improvement over state-of-the-art approaches on the task of listener backchannel prediction in dyadic conversations. 1},
}

