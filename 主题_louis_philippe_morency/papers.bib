@misc{louis_philippe_morency_5a1fe8372fe395d8,
  title = {Proceedings of the 3rd international workshop on Affective interaction in natural environments},
  author = {Ginevra Castellano and Kostas C. Karpouzis and Jean‐Claude Martin and Louis‐Philippe Morency and Christopher Peters and Laurel D. Riek},
