  author = {Gale M. Lucas and Arno Hartholt and Kallirroi Georgila and Fabrizio Morbini and Louis-Philippe Morency and Stacy Marsella and Albert A. Rizzo and David DeVault and Edward Fast and Giota Stratou and Margot Lhommet and Stefan Scherer and David R. Traum and Jonathan Gratch},
