@misc{louis_philippe_morency_a00c08249981a646,
  title = {MultiBench: Multiscale Benchmarks for Multimodal Representation Learning},
  author = {Yuke Zhu and Michelle A. Lee and Paul Pu Liang and Zetian Wu and Yiwei Lyu and Louis-Philippe Morency and Xiang Fan and Leslie Chen and Ruslan Salakhutdinov and Jason Wu and Peter Wu and Yun Cheng},
  year = {2021},
  doi = {10.48550/arxiv.2107.07502},
  url = {https://pubmed.ncbi.nlm.nih.gov/38774625},
  howpublished = {NeurIPS Datasets and Benchmarks},
  annotation = {中文辅助译名：MultiBench：多模态表示学习的多尺度基准},
  abstract = {Learning multimodal representations involves integrating information from multiple heterogeneous sources of data. It is a challenging yet crucial area with numerous real-world applications in multimedia, affective computing, robotics, finance, human-computer interaction, and healthcare. Unfortunately, multimodal research has seen limited resources to study (1) generalization across domains and modalities, (2) complexity during training and inference, and (3) robustness to noisy and missing modalities. In order to accelerate progress towards understudied modalities and tasks while ensuring real-world robustness, we release MultiBench, a systematic and unified large-scale benchmark for multimodal learning spanning 15 datasets, 10 modalities, 20 prediction tasks, and 6 research areas. MultiBench provides an automated end-to-end machine learning pipeline that simplifies and standardizes data loading, experimental setup, and model evaluation. To enable holistic evaluation, MultiBench offers a comprehensive methodology to assess (1) generalization, (2) time and space complexity, and (3) modality robustness. MultiBench introduces impactful challenges for future research, including scalability to large-scale multimodal datasets and robustness to realistic imperfections. To accompany this benchmark, we also provide a standardized implementation of 20 core approaches in multimodal learning spanning innovations in fusion paradigms, optimization objectives, and training approaches. Simpl},
}

@misc{louis_philippe_morency_aa9cecf66eeffc7d,
  title = {StarNet: Gradient-free Training of Deep Generative Models using Determined System of Linear Equations},
  author = {Amir Zadeh and Santiago Benoit and Louis-Philippe Morency},
  year = {2021},
  doi = {10.48550/ARXIV.2101.00574},
  url = {https://doi.org/10.48550/ARXIV.2101.00574},
  howpublished = {CoRR},
  annotation = {中文辅助译名：StarNet：使用确定的线性方程组进行深度生成模型的无梯度训练},
  abstract = {In this paper we present an approach for training deep generative models solely based on solving determined systems of linear equations. A network that uses this approach, called a StarNet, has the following desirable properties: 1) training requires no gradient as solution to the system of linear equations is not stochastic, 2) is highly scalable when solving the system of linear equations w.r.t the latent codes, and similarly for the parameters of the model, and 3) it gives desirable least-square bounds for the estimation of latent codes and network parameters within each layer.},
}

