@misc{panorama_peng_xu_16749114d7a6,
  title = {Changes of EEG phase synchronization and EOG signals along the use of steady state visually evoked potential-based brain computer interface},
  author = {Yufan Peng and Ze Wang and Chi Man Wong and Wenya Nan and Agostinho C. Rosa and Peng Xu and Feng Wan and Yong Sheng Hu},
  year = {2020},
