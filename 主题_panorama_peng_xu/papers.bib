@misc{panorama_peng_xu_feec8c04e2aa0332,
  title = {Transcranial Magnetic Stimulation to the Middle Frontal Gyrus During Attention Modes Induced Dynamic Module Reconfiguration in Brain Networks},
  author = {Penghui Song and Hua Lin and Chunyan Liu and Yuanling Jiang and Yicong Lin and Qing Xue and Peng Xu and Yuping Wang},
