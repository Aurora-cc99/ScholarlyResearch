@misc{panorama_peng_xu_6226eb3029f87d65,
  title = {Prognostic variables for temporal lobe injury after intensity modulated‐radiotherapy of nasopharyngeal carcinoma},
  author = {Mei Feng and Yecai Huang and Xigang Fan and Peng Xu and Jinyi Lang and Dian Wang},
  year = {2018},
  doi = {10.1002/cam4.1291},
