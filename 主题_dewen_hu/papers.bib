@misc{dewen_hu_b32ba1e32b2c42ef,
  title = {Generalized Controllability of Quantum Systems: Beyond the Limitation of Open-loop Controllability},
  author = {Dewen Hu and Hong-Wei Xie and Ming Zhang and Hong-Yi Dai},
  year = {2007},
  doi = {10.1109/ACC.2007.4282257},
  url = {https://doi.org/10.1109/ACC.2007.4282257},
  howpublished = {ACC},
  annotation = {中文辅助译名：量子系统的广义可控性：超越开环可控性的限制},
  abstract = {To control a quantum system, not only may an ancillary system be introduced, but unitary operations and quantum projective measurement can also be performed on the quantum system or the resulting composite system. As a quantum system may be "physically" controllable even if the quantum system is not open-loop controllable, it is, therefore, necessary to go beyond the limitation of open-loop controllability for quantum systems. By studying the link between quantum generalized measurement and generalized pure state reachability, we further clarify the rationality of redefining the concept of generalized controllability from a view point of physical operation. It is also demonstrated that applying unitary operations, performing quantum projective measurement and introducing ancillary systems can play important roles in controlling quantum systems. Therefore, instead of adopting the concept of open-loop controllability for quantum systems, we need to define and discuss the concept of generalized controllability from a view point of physical operation. This is in marked contrast to the fact that the "physical" controllability for classical systems can only be discussed in the sense of open- loop control.},
}

@misc{dewen_hu_6dfd4338b496f50a,
  title = {Focal cerebral ischemia in rats by photothrombosis of cortical microvessels},
  author = {Xiaolu Deng and Fayi Liu and Yu-Cheng Wang and Ming Li and Yadong Liu and Dewen Hu},
  year = {2007},
  doi = {10.1109/iccme.2007.4381785},
  url = {https://doi.org/10.1109/iccme.2007.4381785},
  howpublished = {ICME International Conference on Complex Medical Engineering (CME)},
  annotation = {中文辅助译名：皮质微血管光血栓形成大鼠局灶性脑缺血},
  abstract = {Among the available animal models of brain ischemia, it is broadly considered that cerebral cortex microvessels thrombosis induced by photochemical method is similar to human cerebral thrombosis. The brain tissues are damaged by the lack of blood and oxygen induced by thrombosis of the microvessels region. In this study, optical intrinsic signal imaging (OISI, at 546plusmn10 nm) was used to investigate the evolution of a photothrombotic lesion to somatosensory cortex. During illumination, we observed clots flow several times in illuminated region vessels, and vessels turned vague, which indicated occlusion is forming. The result of TTC staining shows that the illuminated area was infarct.},
}

@misc{dewen_hu_5ee5e564993b67e8,
  title = {Manifold Learning using Growing Locally Linear Embedding},
  author = {Dewen Hu and Junsong Yin and Zongtan Zhou},
  year = {2007},
  doi = {10.1109/CIDM.2007.368855},
  url = {https://doi.org/10.1109/CIDM.2007.368855},
  howpublished = {CIDM},
  annotation = {中文辅助译名：使用增长的局部线性嵌入进行流形学习},
  abstract = {Locally linear embedding (LLE) is an effective nonlinear dimensionality reduction method for exploring the intrinsic characteristics of high dimensional data. This paper mainly proposes a hierarchical framework manifold learning method, based on LLE and growing neural gas (GNG), named growing locally linear embedding (GLLE). First, we address the major limitations of the original LLE: intrinsic dimensionality estimation, neighborhood number selection and computational complexity. Then by embedding the topology learning mechanism in GNG, the proposed GLLE algorithm is able to preserve the global topological structures and hold the geometric characteristics of the input patterns, which make the projections more stable and robust. Theoretical analysis and experimental simulations show that GLLE with global topology preservation tackles the three limitations, gives faster learning procedure and lower reconstruction error, and stimulates the wide applications of manifold learning},
}

