@misc{dewen_hu_8b6efb733ed9ef4d,
  title = {The Evolution of Brain-Computer Interfaces Towards Collaborative Intelligence},
  author = {Yang Yu and Yingxin Liu and Zhipeng Fan and Zongtan Zhou and Ling‐Li Zeng and Dewen Hu},
  year = {2026},
  doi = {10.1093/nsr/nwag667},
  url = {https://doi.org/10.1093/nsr/nwag667},
  howpublished = {National Science Review},
  annotation = {中文辅助译名：脑机接口向协作智能的演变},
  abstract = {Brain-computer interfaces (BCIs) are evolving from unidirectional control toward deeper integration of biological and machine intelligence. This transition is constrained by two complementary bottlenecks: Intent Mismatch, or Brain-to-Machine Underreach, in which user intentions cannot be sufficiently decoded, represented, or executed by the machine; and State Mismatch, or Machine-to-Brain Overload, in which system demands exceed the user’s current cognitive, affective, or neural resources. This review uses these two mismatches as an organizing framework for examining the evolution of BCIs toward brain-machine collaborative intelligence, while distinguishing non-invasive and invasive modalities according to their signal characteristics and translational constraints. We review neural decoding, generative artificial intelligence, and shared control as approaches for reducing Intent Mismatch, and passive BCIs, adaptive interaction, neurofeedback, and neuromodulation as approaches for reducing State Mismatch. By integrating these solution paths, this review outlines a pathway toward adaptive, bidirectional, and human-centered BCI systems.},
}

@misc{dewen_hu_0ec92c14d63659d4,
  title = {Transfer learning from 2D natural images to 4D fMRI brain images via geometric mapping},
  author = {Peng Xie and Yan-Kun Wu and Kai Gao and Wei Zhang and Dewen Hu and Zihan Wang and Qian Huang and Hua Yu and Liang Li and Xiao Chen and Tao Lian and Yu-Wei Wang and Xin-Ran Wu and Qing-Lin Gao and Shi-Xian Cui and Jian-Ping Lu and Zhao-Yu Deng and Xiao-Ping Wu and Xue Li and Chuan-Yue Wang and Xin-Lei Ji and Jing-Ping Zhao and Zi-Jing Zhang and Tian-Mei Si and Bin Lu and Zheng-Jia-Yi Hu and Guang-Rong Xie and Jian-Shan Chen and Qi-Yong Gong and Jiang Qiu and Hong Yang and Xiang Wang and Wen-Bin Guo and Xi-Long Cui and Jia-Jia Zhu and Zhe-Ning Liu and Peng-Feng Sun and Chun-Ming Xie and Xiao-Yun Liu and Xiu-Feng Xu and Zhen-Peng Xue and Yong-Qiang Yu and Xiao-Xiao Shan and Ai-Xia Zhang and Tao-Lin Chen and Yong-Gui Yuan and Xue-Ying Li and Yi-Cheng Long and Chen-Nan Wu and Han-Lin Wang and Feng-Nan Jia and Bao-Juan Li and Li-Ping Cao and Yan-Song Liu and Ke-Rang Zhang and Xi-Nian Zuo and Yu-Qi Cheng and Min-Lan Yuan and Yan-Rong Chen and Zhao-Song Chu and Can-Can He and Guan-Mao Chen and Ying Wang and Li Kuang and Tao Chen and Feng Li and Jian Yang and Lubin Wang and Tao Li and Chaogan Yan and Yufeng Zang and Hua-Ning Wang and Hui-Xian Li and Yi-Fan Liao},
  year = {2026},
  doi = {10.1016/J.MEDIA.2026.103949},
  url = {https://doi.org/10.1016/J.MEDIA.2026.103949},
  howpublished = {Medical Image Anal.},
  annotation = {中文辅助译名：通过几何映射从 2D 自然图像到 4D fMRI 大脑图像的迁移学习},
  abstract = {Functional magnetic resonance imaging (fMRI) allows real-time observation of brain activity through blood oxygen level-dependent (BOLD) signals and is extensively used in studies related to sex classification, age estimation, behavioral measurements prediction, and mental disorder diagnosis. However, the application of deep learning techniques to brain fMRI analysis is hindered by the small sample size of fMRI datasets. Transfer learning offers a solution to this problem, but most existing approaches are designed for large-scale 2D natural images. The heterogeneity between 4D fMRI data and 2D natural images makes direct model transfer infeasible. This study proposes a novel geometric mapping-based fMRI transfer learning method that enables transfer learning from 2D natural images to 4D fMRI brain images, bridging the transfer learning gap between fMRI data and natural images. The proposed Multi-scale Multi-domain Feature Aggregation (MMFA) module extracts effective aggregated features and reduces the dimensionality of fMRI data to 3D space. By treating the cerebral cortex as a folded Riemannian manifold in 3D space and mapping it into 2D space using surface geometric mapping, we make the transfer learning from 2D natural images to 4D brain images possible. Moreover, the topological relationships of the cerebral cortex are maintained with our method, and calculations are performed along the Riemannian manifold of the brain, effectively addressing signal interference problems. },
}

