  author = {Meijie Liu and Lubin Wang and Hui Shen and Zhening Liu and Dewen Hu},
  year = {2011},
  doi = {10.1016/j.proenv.2011.10.109},
  url = {https://doi.org/10.1016/j.proenv.2011.10.109},
  howpublished = {Procedia Environmental Sciences},
  annotation = {中文辅助译名：精神分裂症患者及其未受影响的兄弟姐妹在静息态功能连接方面表现出类似的异常},
  abstract = {Functional connectivities throughout the whole brain were examined in schizophrenic patients (Sch), their unaffected siblings (Usib) and healthy controls (HC) using resting-state functional magnetic resonance imaging. The abnormalities in functional connectivity were identified both in schizophrenic patients and in their unaffected siblings via two-sample T-test at the threshold of P<0.05 between 24 Sch and 25 HC, 25 Usib and 25 HC, respectively. From the results of the two-sample T-test, it was found that schizophrenic patients and their unaffected siblings show similar abnormalities in resting-state functional connectivity, including 97 decreased functional connectivities and 22 increased functional connectivities. The experiment results, to some extent, provided a powerful support for inheritance characteristic of schizophrenia.},
}

