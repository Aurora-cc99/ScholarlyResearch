@misc{dewen_hu_f2f363362743ff22,
  title = {Toward Brain-Actuated Mobile Platform},
  author = {Dewen Hu and Yang Yu and Zongtan Zhou and Yadong Liu and Jun Jiang and Jingsheng Tang},
  year = {2019},
  doi = {10.1080/10447318.2018.1502000},
