  author = {Dewen Hu and Zirui Guo and Haoran Xiao and Zhiwen Zeng and Ce Guo and Xieyuanli Chen and Yihong Li and Huimin Lu},
  year = {2025},
  doi = {10.1109/TRO.2025.3613541},
