@misc{dewen_hu_bd2867dcb5b43fd6,
  title = {The Combination of Univariate and Multivariate Method for fMRI Data Analysis},
  author = {Weiwei Xia and Lirong Yan and Zongtan Zhou and Yadong Liu and Dewen Hu},
  year = {2006},
  doi = {10.1109/icnnb.2005.1614931},
