  author = {Yang Yu and Jun Jiang and Zongtan Zhou and Erwei Yin and Yading Liu and Jingjun Wang and Nannan Zhang and Dewen Hu},
  year = {2016},
  doi = {10.1109/ihmsc.2016.80},
