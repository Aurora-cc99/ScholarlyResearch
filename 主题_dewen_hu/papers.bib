@misc{dewen_hu_a8316270092fdeed,
  title = {Neural spike irregularity in adjacent cells of the same visual cortical column are unrelated despite other shared properties},
  author = {David K. Chelvanayagam and Dewen Hu and Trichur Raman Vidyasagar},
  year = {2010},
