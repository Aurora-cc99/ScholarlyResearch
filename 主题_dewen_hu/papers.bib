  author = {Saisai Zhong and Yadong Liu and Zongtan Zhou and Dewen Hu},
  year = {2019},
  doi = {10.1109/icaica.2019.8873522},
  url = {https://doi.org/10.1109/icaica.2019.8873522},
  howpublished = {IEEE International Conference on Artificial Intelligence and Computer Applications (ICAICA)},
  annotation = {中文辅助译名：基于脑电图的循环神经网络视觉分类},
  abstract = {Decoding the content of the viewed object from brain activity has always been an interesting topic in Brain-Computer Interface (BCI). Featuring a high temporal resolution, electroencephalograph (EEG) is often used to analyze the brain activity. Even though there are many methods for measuring the EEG signal, it is still difficult to identify the content of the stimuli because of its low Signal-Noise-Ratio (SNR). In this paper, we introduce a classification system based on Recurrent Neural Networks (RNNs) to identify the content of the image stimuli. The system is applied to a single-trial EEG data recorded while the subject was watching the object image. The result shows that the classification accuracy reaches 98.24% over 40 categories. The classification accuracy of the 10-fold cross-validation also reaches 95.14%.},
}

@misc{jing_jin_ecust_79329af795a3568f,
