  annotation = {中文辅助译名：视频的前景分割},
  abstract = {For the problems of background noise and shadow interference in the object segmentation,this paper proposed an improved target segmentation method.After using the codebook background model segmented the video,it constrained the segmentation results for further by combining the gradient factor and the Sobel operator.Experimental results show that the method can effectively segment the foreground targets and has strong anti-interference ability.},
}

@misc{panorama_xun_gong_b536d28c87e7728a,
  title = {A Novel Initial Contour Approximation Method for Face Contour Evolution},
  author = {Xinxin Li and Xun Gong},
  year = {2012},
  doi = {10.1109/icecc.2012.281},
  url = {http://dl.acm.org/citation.cfm?id=2417502.2418715},
  howpublished = {International Conference on Electronics, Communications and Control},
  annotation = {中文辅助译名：一种新颖的人脸轮廓演化初始轮廓逼近方法},
  abstract = {When applying Chan-Vese (C-V) model to segment a face from an image, the evolving result is always influenced by the initial position, especially in a real scenarios with complex background. An improved initial face position approximation method is proposed based on ellipse fitting from skin color. We first use a skin color model to compute the candidate of the face region, and then fit an ellipse according to the set of face region by lest squares method. Tests conducted on two face dataset have demonstrated that the accuracy of the detected initial face region at ratio above 95%, which lays a good foundation for face segmentation by the C-V model. Experimental results show that, with our estimated contour, C-V model could converge quickly and precisely.},
}

