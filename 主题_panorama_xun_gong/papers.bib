@misc{panorama_xun_gong_cad274fecdda09ae,
  title = {Carbon Emission Trends and Driving Mechanisms of Transportation Sector in Western China},
  author = {Zhixiao Zhang and Yugang Wang and Xun Gong and Zilin Ye and Dongmei Wang and Zhengjun Gong},
  year = {2025},
  doi = {10.2991/978-94-6463-902-5_52},
  url = {https://doi.org/10.2991/978-94-6463-902-5_52},
  howpublished = {Advances in engineering research/Advances in Engineering Research},
  annotation = {中文辅助译名：中国西部地区交通运输业碳排放趋势及驱动机制},
  abstract = {This study examines transportation carbon emission characteristics and driving factors in Western China from 2000-2022 using LMDI decomposition analysis.Results show transportation carbon emissions increased four-fold from 56.05 to 248.31 million tons, with 8.2% average annual growth, following a "sustained growth then stabilization" pattern.Notably, energy structure optimization achieved remarkable progress, with coal consumption declining dramatically from 8.29% to 0.44% while clean energy adoption increased substantially from 5.39% to 13.31%, demonstrating significant decarbonization achievements.LMDI analysis reveals economic development level as the dominant driver (+316.03 million tons cumulatively), while transportation energy intensity provided the strongest mitigation effect (-159.45 million tons).Temporal analysis identifies four distinct phases: rapid growth (2000-2010), policy intervention (2010-2015), green transformation (2015-2020), and post-pandemic adjustment (2021-2022).The 2010-2015 period marked crucial policy success, with transportation intensity achieving peak mitigation effects during the 12th Five-Year Plan.Findings suggest prioritizing transportation efficiency improvements, accelerating clean energy transition, and implementing differentiated regional policies for sustainable transportation development in Western China.},
}

@misc{panorama_xun_gong_3b1a82b1ebca9ce2,
  title = {AGA: An adaptive group alignment framework for structured medical cross-modal representation learning},
  author = {Wei Li and Xun Gong and Jiao Li and Xiaobin Sun},
  year = {2025},
  doi = {10.48550/ARXIV.2507.23402},
  url = {https://doi.org/10.48550/ARXIV.2507.23402},
  howpublished = {CoRR},
  annotation = {中文辅助译名：AGA：用于结构化医学跨模式表示学习的自适应组对齐框架},
  abstract = {Learning medical visual representations from paired images and reports is a promising direction in representation learning. However, current vision-language pretraining methods in the medical domain often simplify clinical reports into single entities or fragmented tokens, ignoring their inherent structure. In addition, contrastive learning frameworks typically depend on large quantities of hard negative samples, which is impractical for small-scale medical datasets. To tackle these challenges, we propose Adaptive Grouped Alignment (AGA), a new framework that captures structured semantics from paired medical images and reports. AGA introduces a bidirectional grouping mechanism based on a sparse similarity matrix. For each image-report pair, we compute fine-grained similarities between text tokens and image patches. Each token selects its top-matching patches to form a visual group, and each patch selects its most related tokens to form a language group. To enable adaptive grouping, we design two threshold gating modules, called Language Grouped Threshold Gate and Vision Grouped Threshold Gate, which learn grouping thresholds dynamically. Group representations are computed as weighted averages based on similarity scores. To align each token with its group representation, we introduce an Instance Aware Group Alignment loss that operates within each image-text pair, removing the need for external negatives. Finally, a Bidirectional Cross-modal Grouped Alignment module is applied},
}

@misc{panorama_xun_gong_ab463f10eb84f346,
  title = {BR-ASR: Efficient and Scalable Bias Retrieval Framework for Contextual Biasing ASR in Speech LLM},
  author = {Xun Gong and Anqi Lv and Wangyou Zhang and Zhiming Wang and Huijia Zhu and Yanmin Qian},
  year = {2025},
  doi = {10.21437/interspeech.2025-326},
  url = {https://doi.org/10.21437/interspeech.2025-326},
  howpublished = {Interspeech (USB)},
  annotation = {中文辅助译名：BR-ASR：用于语音大语言模型中上下文偏差 ASR 的高效且可扩展的偏差检索框架},
  abstract = {While speech large language models (SpeechLLMs) have advanced standard automatic speech recognition (ASR), contextual biasing for named entities and rare words remains challenging, especially at scale. To address this, we propose BR-ASR: a Bias Retrieval framework for large-scale contextual biasing (up to 200k entries) via two innovations: (1) speech-and-bias contrastive learning to retrieve semantically relevant candidates; (2) dynamic curriculum learning that mitigates homophone confusion which negatively impacts the final performance. The is a general framework that allows seamless integration of the retrieved candidates into diverse ASR systems without fine-tuning. Experiments on LibriSpeech test-clean/-other achieve state-of-the-art (SOTA) biased word error rates (B-WER) of 2.8%/7.1% with 2000 bias words, delivering 45% relative improvement over prior methods. BR-ASR also demonstrates high scalability: when expanding the bias list to 200k where traditional methods generally fail, it induces only 0.3 / 2.9% absolute WER / B-WER degradation with a 99.99% pruning rate and only 20ms latency per query on test-other.},
}

