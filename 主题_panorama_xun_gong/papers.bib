@misc{panorama_xun_gong_d18d5dc21ab23f17,
  title = {Method of Web Discovery Based on Immunity},
  author = {Xun Gong},
  year = {2007},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=JSJC200703051},
