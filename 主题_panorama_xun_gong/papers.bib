@misc{panorama_xun_gong_3a2d18f0c92f494e,
  title = {Human motion detection based on Transformer spatiotemporal feature fusion},
  author = {Cai Wei Wei and Xun Gong},
  year = {2022},
  doi = {10.1109/cis58238.2022.00036},
  url = {http://dx.doi.org/10.1109/cis58238.2022.00036},
  howpublished = {International Conference on Computational Intelligence and Security (CIS)},
  annotation = {中文辅助译名：基于Transformer时空特征融合的人体运动检测},
  abstract = {For the problems of insufficient extraction and fusion of spatio-temporal features in short video sequences and large number of model parameters, this paper proposes a Transformer-based spatio-temporal feature fusion method. First, the method combines the motion information of multiframe images to compensate for the problem of insufficient motion information extraction under single-frame spatial features. Secondly, the attention mechanism in Transformer is used to fully fuse the spatio-temporal information from the mutual anisotropic features, analyze the dependencies between local and global features existing in the image, and improve the recognition accuracy while reducing the number of parameters of the fusion model. Experiments show that the method outperforms the benchmark method on two publicly available datasets, JHMDB-21 and UCFI0l-24, and exhibits some applicability and robustness.},
}

