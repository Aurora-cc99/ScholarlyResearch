@misc{junlong_chen_1e11152b5152c549,
  title = {Solving Imbalanced Problems With Multilayer Ensemble Balanced Fuzzy Inference Broad Network},
  author = {Wuxing Chen and Zhiwen Yu and Kaixiang Yang and Jun Jiang and Fan Zhang and C. L. Philip Chen},
  year = {2026},
  doi = {10.1109/tfuzz.2026.3717303},
  url = {https://doi.org/10.1109/tfuzz.2026.3717303},
  howpublished = {IEEE Transactions on Fuzzy Systems},
  annotation = {中文辅助译名：利用多层集成平衡模糊推理宽网络解决不平衡问题},
  abstract = {Broad learning system (BLS) exhibits excellent generalization ability due to its computational efficiency, but it often performs poorly when dealing with imbalanced data, as it tends to generate decision boundaries biased toward the majority class. Meanwhile, BLS generates hidden layer features through random projection, which may lead to the loss of complex features. To enhance BLS’s feature representation capability and its ability to recognize minority classes, this article proposes a multilayer ensemble balanced fuzzy inference broad network. We first design an influence-based balanced broad network as the base learner, which can adaptively assign lower weights to samples that exert excessive influence, thereby rebalancing the learning process. In addition, we introduce a fuzzy inference mechanism to transform the original input into a more discriminative high-order feature space, effectively capturing complex nonlinear relationships. Subsequently, these two components are integrated into a multilayer ensemble architecture, where the enhanced features of each layer are cascaded to the next layer. The final prediction is obtained by aggregating the outputs of all base learners via a majority voting scheme, a process that ensures the robustness of the multilayer ensemble. In comparative experiments with various existing advanced methods, the proposed overall framework shows significant superiority in multiple key evaluation metrics.},
}

