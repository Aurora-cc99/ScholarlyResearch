@misc{junlong_chen_4b761230790006da,
  title = {Adaptive Actuator Backlash Compensation Scheme For Noncanonical Recurrent High‐Order Neural Networks‐based Nonlinear Systems},
  author = {Guanyu Lai and Tao Zhang and Jianjun Fan and Jianing Tang and Hanzhen Xiao and Xiaohang Su and C. L. Philip Chen},
  year = {2026},
  doi = {10.1002/rnc.70566},
  url = {https://doi.org/10.1002/rnc.70566},
  howpublished = {International Journal of Robust and Nonlinear Control},
  annotation = {中文辅助译名：基于非规范循环高阶神经网络的非线性系统的自适应执行器间隙补偿方案},
  abstract = {ABSTRACT Most existing adaptive control schemes for uncertain nonlinear systems with unknown input backlash are developed within the Lyapunov‐based backstepping framework, which is applicable to systems in canonical form with explicitly known relative degrees. However, such schemes are not applicable to nonlinear systems in noncanonical form because of implicit relative degrees. This paper aims to develop a comprehensive solution framework for adaptive tracking control in uncertain noncanonical nonlinear systems with unknown input backlash. A novel parameterizable smoothing inverse model is proposed, and combined with recurrent high‐order neural networks to handle system uncertainties, based on which a gradient‐based adaptive control scheme is developed. The proposed control scheme is theoretically proven to guarantee signal boundedness and achieve the desired tracking performance of the closed‐loop system. Its effectiveness is demonstrated through a numerical example. Moreover, the proposed control scheme can be extended to accommodate general noncanonical nonlinear systems with unknown input backlash of arbitrary relative degree.},
}

