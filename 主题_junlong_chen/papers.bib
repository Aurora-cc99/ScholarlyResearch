  abstract = {Abstract This chapter examines the role of affective computing in student emotion recognition and its integration into personalized education. It reviews physiological signals such as EEG, ECG, and GSR, alongside traditional and deep learning methods, highlighting multimodal fusion for improved reliability. Case studies demonstrate applications in engagement monitoring, classroom interventions, and wearable-based feedback systems. The chapter further explores how emotional signals can guide adaptive content delivery, optimize teaching pace, and support resilience, while addressing privacy and ethical challenges. Future directions emphasize edge computing, multimodal integration, and Brain–AI closed-loop systems to create more human-centered, emotionally responsive learning environments.},
}

@misc{junlong_chen_ae389538e3d8,
