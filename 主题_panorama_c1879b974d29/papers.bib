@misc{panorama_c1879b974d29_ae734605fb865ed7,
  title = {Grid Diagram Features for Automatic Pipa Fingering Technique Classification},
  author = {Yijia Liu and Jingjing Zhang and Zhongzhe Xiao},
  year = {2019},
  doi = {10.1109/iscid.2019.00013},
  url = {https://doi.org/10.1109/iscid.2019.00013},
  howpublished = {International Symposium on Computational Intelligence and Design},
  annotation = {中文辅助译名：琵琶指法自动分类的网格图特征},
  abstract = {Automatic classification on 7 typical playing techniques of Pipa is taken out in this paper. First, the Pipa spectrogram is normalized according to its fundamental frequency; then, 3 types of grid diagrams are generated from the normalized spectrogram; finally, different computation zones are assigned to the grid diagrams for feature extraction with their statistical values. In the automatic classification based on machine learning, with recognition accuracies up to 95.8% with very few number of features.},
}

@misc{panorama_c1879b974d29_6fcfc04d604f8ef5,
  title = {Datasets column: predicting the emotional impact of movies},
  author = {Emmanuel Dellandréa and Martijn Huigsloot and Liming Chen and Yoann Baveye and Zhongzhe Xiao and Mats Sjöberg},
  year = {2019},
  doi = {10.1145/3310195.3310201},
  url = {https://doi.org/10.1145/3310195.3310201},
  howpublished = {ACM SIGMultimedia Records},
  annotation = {中文辅助译名：数据集专栏：预测电影的情感影响},
  abstract = {Affective video content analysis aims at the automatic recognition of emotions elicited by videos. It has a large number of applications, including mood based personalized content recommendation, video indexing, and efficient movie visualization and browsing. Beyond the analysis of existing video material, affective computing techniques can also be used to generate new content, e.g., movie summarization, personalized soundtrack recommendation to make user-generated videos more attractive. Affective techniques can furthermore be used to enhance the user engagement with advertising content by optimizing the way ads are inserted inside videos.},
}

@misc{panorama_c1879b974d29_f802b2b89371c1cd,
  title = {DSTL: Solution to Limitation of Small Corpus in Speech Emotion Recognition},
  author = {Ying Chen and Zhongzhe Xiao and Xiaojun Zhang and Zhi Tao},
  year = {2019},
  doi = {10.1613/jair.1.11729},
  url = {https://doi.org/10.1613/jair.1.11729},
  howpublished = {Journal of Artificial Intelligence Research},
  annotation = {中文辅助译名：DSTL：解决语音情感识别中小语料库的局限性},
  abstract = {Traditional machine learning methods share a common hypothesis: training and testing datasets must be in a common feature space with the same distribution. However, in reality, the labeled target data may be rare, so that target space does not share the same feature space or distribution as an available training set (source domain). To address the mismatch of domains, we propose a Dual-Subspace Transfer Learning (DSTL) framework that considers both the common and specific information of the two domains. In DSTL, a latent common subspace is first learned to preserve the data properties and reduce the discrepancy of domains. Then, we propose a mapping strategy to transfer the sourcespecific information to the target subspace. The integration of the domain-common and specific information constructs the proposed DSTL framework. In comparison to the stateart-of works, the main contribution of our work is that the DSTL framework not only considers the commonalities, but also exploits the specific information. Experiments on three emotional speech corpora verify the effectiveness of our approach. The results show that the methods which include both domain-common and specific information perform better than the baseline methods which only exploit the domain commonalities.},
}

