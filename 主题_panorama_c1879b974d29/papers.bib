@misc{panorama_c1879b974d29_5a13cc984ce79bf4,
  title = {Perception auditory factor for speaker recognition in noisy environment},
  author = {Di Wu and Heming Zhao and Di Wu and Zhe Feng and Liyuan Chen and Zhongzhe Xiao and Xiaojun Zhang and Zhi Tao},
  year = {2016},
  doi = {10.1109/fskd.2016.7603472},
  url = {https://doi.org/10.1109/fskd.2016.7603472},
  howpublished = {International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)},
  annotation = {中文辅助译名：噪声环境下说话人识别的感知听觉因素},
  abstract = {Speaker recognition plays an important role in speech processing and classification. In this paper, we propose a features extraction method using Perception Auditory Factor to improve the performance of speaker recognition in noisy environment. After the speech enhancement based on auditory perception characteristic and the 2-dimension enhancement for spectrogram, speech distribution is obtained from noisy speech, which is combined with perception speech content to extract Perception Auditory Factor. Speech features are extracted by using Perception Auditory Factor for speaker recognition. The experiments prove that, in four different noisy environments, the proposed method improves the robustness to the compared method in a wide range of SNR from −10 dB to 20 dB. Thanks to the proposed method, the average recognition correctness rates increase 25.2%, 19.1% and 9.7% to the three compared methods respectively. The proposed method is more suitable for speaker recognition in noisy environment.},
}

@misc{panorama_c1879b974d29_738d803ac534f0e8,
