@misc{panorama_c1879b974d29_f5ae2976fa5043e2,
  title = {Automatic Hierarchical Classification of Emotional Speech},
  author = {Zhongzhe Xiao and Emmanuel Dellandréa and Weibei Dou and Liming Chen},
  year = {2007},
  doi = {10.1109/ism.workshops.2007.56},
  url = {https://doi.org/10.1109/ism.workshops.2007.56},
  howpublished = {IEEE International Symposium on Multimedia Workshops (ISMW)},
  annotation = {中文辅助译名：情感语音自动分层分类},
  abstract = {Speech emotion is high semantic information and its automatic analysis may have many applications such as smart human-computer interactions or multimedia indexing. As a pattern recognition problem, the feature selection and the structure of the classifier are two important aspects for automatic speech emotion classification. In this paper, we propose a novel feature selection scheme based on the evidence theory. Furthermore, we also present a new automatic approach for constructing a hierarchical classifier, which allows better performance than a global classifier as it is mostly used in the literature. Experimented on the Berlin database, our approach showed its effectiveness, scoring a recognition rate up to 78.64%.},
}

@misc{panorama_c1879b974d29_3c5a0dda3044e6f8,
  title = {Two-stage Classification of Emotional Speech},
  author = {Zhongzhe Xiao and Emmanuel Dellandréa and Weibei Dou and Liming Chen},
  year = {2006},
  doi = {10.1109/icdt.2006.76},
  url = {https://doi.org/10.1109/icdt.2006.76},
  howpublished = {International Conference on Digital Telecommunications (ICDT)},
  annotation = {中文辅助译名：情感言语的两阶段分类},
  abstract = {The purpose of this paper is to make an automatic classification of speech into seven emotional classes as anger, boredom, disgust, fear, gladness, neutral and sadness. A two-stage classification composed of several sub-classifiers is proposed. A feature set with 68 features has been computed over 286 speech samples from the Berlin database. The Sequential Forward Selection method (SFS) has been used for each classifiers of the two stages in order to decide the feature subsets in each step. The result for the first stage as three-state classification is 87%, and the global result of the seven emotional classes is 78%, where the correct recognition rate of random classification by chance is about 15%.},
}

@misc{panorama_c1879b974d29_6dd1ec3b43710c8f,
  title = {Features extraction and selection for emotional speech classification},
  author = {Zhongzhe Xiao and Emmanuel Dellandréa and Weibei Dou and Liming Chen},
  year = {2006},
  doi = {10.1109/avss.2005.1577304},
  url = {https://doi.org/10.1109/avss.2005.1577304},
  howpublished = {IEEE International Conference on Advanced Video and Signal Based Surveillance (AVSS)},
  annotation = {中文辅助译名：情感语音分类的特征提取和选择},
  abstract = {The classification of emotional speech is a topic in speech recognition with more and more interest, and it has giant prospect in applications in a wide variety of fields. It is an important preparation for automatic classification and recognition of emotions to select a proper feature set as a description to the emotional speech, and to find a proper definition to the emotions in speech. The speech samples used in this paper come from Berlin database which contains 7 kinds of emotions, with 207 speech samples of male voice and 287 speech samples of female voice. A feature set of 50 potentially features is extracted and analyzed, and the best features are selected. A definition of emotions as 3-states emotions is also proposed in this paper.},
}

@misc{panorama_c1879b974d29_a0b19be875942133,
  title = {Improved GIB synchronization method for OFDM systems},
  author = {Zhongzhe Xiao and Zaiwang Dong},
  year = {2003},
  doi = {10.1109/ictel.2003.1191642},
  url = {https://doi.org/10.1109/ictel.2003.1191642},
  howpublished = {来源待核},
  annotation = {中文辅助译名：改进的 OFDM 系统 GIB 同步方法},
  abstract = {This paper deals with the estimation of the frequency synchronization in orthogonal frequency division multiplexed (OFDM) systems. In particular, we focus on GIB (Guard Interval Based) frequency error detection algorithm. The advantage of the GIBFD is that it is simple to implement, and it needs no information of particular signal format and it needs less time in frequency error tracing. Theoretical analysis and computer simulations are presented in this paper.},
}
