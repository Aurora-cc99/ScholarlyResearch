@misc{panorama_c1879b974d29_5fb796f2b19b652f,
  title = {Synergistic ensemble class-aware domain adaptation for underwater target detection},
  author = {Chenyang Liu and Jiaxin Liu and Zhongzhe Xiao and Min Huang},
  year = {2026},
  doi = {10.1088/1361-6501/ae507c},
  url = {https://doi.org/10.1088/1361-6501/ae507c},
  howpublished = {Measurement Science and Technology},
  annotation = {中文辅助译名：用于水下目标检测的协同集成类感知域适应},
  abstract = {Abstract To address the formidable challenges in underwater acoustic target detection arising from the absence of target domain labels and significant feature distribution disparities across sea areas, this paper proposes a synergistic ensemble class-aware domain adaptation (SECADA) strategy. This approach leverages labeled source domain data to achieve efficient and robust detection in the target domain. First, a pre-trained ResNet-50 backbone integrated with a multi-scale feature enhancement module is utilized to rigorously mine deep time–frequency features from spectrograms. Subsequently, in the feature alignment phase, tailored to binary nature of underwater target tasks, conditional maximum mean discrepancy is introduced as a class-aware domain adaptation loss function to surmount the distribution misalignment issues prevalent in traditional approaches. Furthermore, the framework incorporates a parallel ensemble learning strategy, which calibrates target domain pseudo-labels through multi-scale feature fusion, thereby significantly enhancing intra-class compactness and system robustness. Experimental results demonstrate that, under unsupervised conditions, SECADA achieves a detection accuracy of 92.63%, trailing the supervised learning baseline by a mere 2.97%. This method effectively alleviates the bottleneck of zero-shot transfer in heterogeneous marine environments, offering a novel technical perspective for underwater acoustic target detection.},
}

