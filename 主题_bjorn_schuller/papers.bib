  annotation = {中文辅助译名：稳健机器学习的统计设计和分析：COVID-19 案例研究},
}

@misc{bin_hu_f53d96f90105,
  title = {Psychological Field Versus Physiological Field: From Qualitative Analysis to Quantitative Modeling of the Mental Status},
  author = {Bin Hu and Kun Qian and Qunxi Dong and Yuejia Luo and Yoshiharu Yamamoto and Bjorn W. Schuller},
  year = {2022},
