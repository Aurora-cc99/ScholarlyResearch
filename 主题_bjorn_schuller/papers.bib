@misc{bjorn_schuller_8afe0b2ce0651909,
  title = {“Hey Smartphone, Am I Ill?” Detecting Diseases From The Voice},
  author = {Katrin D. Bartl-Pokorny and Adria Mallol-Ragolta and Anika A. Spiesberger and Anastasia Semertzidou and Johanna Löchner and Florian B. Pokorny and Björn Wolfgang Schuller},
  year = {2025},
  doi = {10.3389/frym.2025.1509215},
  url = {https://doi.org/10.3389/frym.2025.1509215},
  howpublished = {Frontiers for Young Minds},
  annotation = {中文辅助译名：“嘿智能手机，我有病吗？”从声音检测疾病},
  abstract = {As humans, we learn from what we perceive with our senses in our daily lives. Computers can have similar learning capabilities, allowing them to learn from what they “see” and “hear” and to use the knowledge they learn to solve future tasks. This ability is called artificial intelligence (AI). Devices equipped with AI, such as smartphones, smartwatches, or smart speakers, have now become our everyday companions. Among other things, they can listen to us and answer our questions. This type of technology is also playing a growing role in medicine. In this article, we explain how a computer can figure out whether the sound of a person’s voice or the way they speak indicates a certain disease. We demonstrate this using the example of detecting COVID-19, and discuss both problems and opportunities that arise when using AI for diagnosis.},
}

@misc{bjorn_schuller_11870f31df3f5247,
  title = {[RETRACTED] Urban Soundscapes and Their Impact on Global Mental Health: A Systematic Review v2},
  author = {Ziwen Sun and Tian Zhong and Chenxiao Liu and Lin Shen and Yue Qi and Zeyu Chen and Yuchen Du and Enze Li and Kun Qian and Bin Hu and Björn Wolfgang Schuller and Yoshiharu Yamamoto and Simon Bell and Jian Kang},
  year = {2025},
  doi = {10.17504/protocols.io.4r3l2pk5pg1y/v2},
  url = {https://doi.org/10.17504/protocols.io.4r3l2pk5pg1y/v2},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：[撤回] 城市声景及其对全球心理健康的影响：系统回顾 v2},
  abstract = {[RETRACTED] While global life expectancy continues to rise, urban populations face growing mental health challenges. Although extensive studies haveexamined the health impacts of natural and built environments, a comprehensive understanding of how urban soundscapes affect mental health remains insufficiently understood.To address this question, wesystematically reviewed 217 studies from 34 countries by screening 5,887 articles with titles and abstracts. Our reviewfound: (1) the common research methods in soundscape-mental health studies; (2) emerging global trends, including declining focus on negative sound sources (r = -0.31) and increasing international collaboration (r = +0.14), with larger cities showing greater attention to outdoor soundscapes (r = +0.23); (3) integrated implications across sound sources, propagation pathways, mental health outcomes, and urban interventions; and (4) spatiotemporaldisparitiesof countries, cities, and the COVID-19 pandemic, with European nations leading diverse investigations while developing countries (except China) primarily focus on noise mitigation. We further proposestate-of-the-art technologies of artificial intelligence and the Internet of Things for designing therapeutic urban soundscapes to promote mental wellbeing in future cities.},
}

