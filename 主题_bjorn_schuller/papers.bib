  title = {Patterns, Prototypes, Performance},
  author = {Anton M. Batliner and Dino Seppi and Björn Wolfgang Schuller and S. Steidl and T. Vogt and J. Wagner and Laurence Y. Devillers and Laurence Vidrascu and N. Amir and V. Aharonson},
