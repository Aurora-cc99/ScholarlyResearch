@misc{bjorn_schuller_b704504df7673af2,
  title = {The INTERSPEECH 2013 computational paralinguistics challenge: social signals, conflict, emotion, autism},
  author = {Anna Polychroniou and Alessandro Vinciarelli and Felix Weninger and Hugues Salamin and Stefan Steidl and Erik Marchi and Fabien Ringeval and Mohamed Chetouani and Samuel Kim and Marcello Mortillaro and Fabio Valente and Björn W. Schuller and Anton Batliner and Florian Eyben and Klaus R. Scherer},
