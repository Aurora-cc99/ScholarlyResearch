  title = {Learning Optimal Time-Frequency Representations for Heart Sound: A Comparative Study},
  author = {Zhihua Wang and Zhihao Bao and Kun Qian and Bin Hu and Björn Wolfgang Schuller and Yoshiharu Yamamoto},
