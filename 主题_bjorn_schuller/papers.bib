@misc{bjorn_schuller_b9e988ec90403eef,
  title = {Humane Anthropomorphic Agents : the Quest for the Outcome Measure},
  author = {Elisabeth André and Sarah Bayer and Ivo Benke and Alexander Benlian and Nicholas Cummins and Henner Gimpel and Oliver Fast Hinz and Kristian Kersting and Alexander Maedche and Max Müehlhäeuser and Jan Riemann and Björn Wolfgang Schuller and Klaus Weber},
