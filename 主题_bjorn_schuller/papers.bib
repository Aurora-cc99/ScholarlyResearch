  url = {https://opus.bibliothek.uni-augsburg.de/opus4/frontdoor/index/index/docId/76672},
  howpublished = {OPUS (Augsburg University)},
  annotation = {中文辅助译名：韵律在情感言语、语言学见解、语言与交流研究中的作用},
}

@misc{bjorn_schuller_3637a6d16b3730f6,
  title = {GMs in On-Line Handwritten Whiteboard Note Recognition: The Influence of Implementation and Modeling},
  author = {Artur Braun and Björn W. Schuller and Benedikt Hörnler and Gerhard Rigoll and Joachim Schenk},
  year = {2009},
  doi = {10.1109/ICDAR.2009.127},
  url = {https://doi.org/10.1109/ICDAR.2009.127},
  howpublished = {ICDAR},
  annotation = {中文辅助译名：在线手写白板笔记识别中的总经理：实施和建模的影响},
  abstract = {We present a comparison of two state-of-the-art toolboxes for implementing Graphical Models (GMs), namely the HTK and the GMTK, and their use for discrete on-line handwritten whiteboard note recognition. We then motivate a GM that is capable of modeling the statistical dependencies between the pen’s pressure information and the remaining features after vector quantization. Since the number of variable parameters rises when more codebook entries are used for quantization, the proposed model outperforms standard HMMs for low numbers of codebook entries.},
}

@misc{bjorn_schuller_bf65d8774ea958eb,
  title = {Recognition of Noisy Speech: A Comparative Survey of Robust Model Architecture and Feature Enhancement},
  author = {Martin Wöllmer and Tobias Moosmayr and Björn W. Schuller and Gerhard Rigoll},
  year = {2009},
  doi = {10.1155/2009/942617},
  url = {https://doi.org/10.1155/2009/942617},
  howpublished = {EURASIP J. Audio Speech Music. Process.},
  annotation = {中文辅助译名：噪声语音识别：鲁棒模型架构和特征增强的比较调查},
  abstract = {Performance of speech recognition systems strongly degrades in the presence of background noise, like the driving noise inside a car. In contrast to existing works, we aim to improve noise robustness focusing on all major levels of speech recognition: feature extraction, feature enhancement, speech modelling, and training. Thereby, we give an overview of promising auditory modelling concepts, speech enhancement techniques, training strategies, and model architecture, which are implemented in an in-car digit and spelling recognition task considering noises produced by various car types and driving conditions. We prove that joint speech and noise modelling with a Switching Linear Dynamic Model (SLDM) outperforms speech enhancement techniques like Histogram Equalisation (HEQ) with a mean relative error reduction of 52.7 % over various noise types and levels. Embedding a Switching Linear Dynamical System (SLDS) into a Switching Autoregressive Hidden Markov Model (SAR-HMM) prevails for speech disturbed by additive white Gaussian noise. Copyright © 2009 Björn Schuller et al. This is an open access article distributed under the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited. 1.},
}

