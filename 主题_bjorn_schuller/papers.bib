@misc{wenming_zheng_fc7371b4f69c,
  title = {ChameleonVoice: A Contextual Prosody Perception Network for Emotional Voice Conversion},
  author = {Tianhua Qi and Cheng Lu and Yuan Zong and Wenming Zheng and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3735290},
  url = {https://doi.org/10.1109/TAFFC.2026.3735290},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：ChameleonVoice：用于情感语音转换的语境韵律感知网络},
  abstract = {Emotional voice conversion (EVC) has progressed rapidly, yet generating speech with natural prosody remains a core unsolved problem. The primary reason is that existing approaches rely heavily on static emotion categories, pseudo-labeled prosodic attributes, or reference-driven transfer mechanisms, which fail to model emotional prosody in a contextually aligned manner. Consequently, current systems often exhibit over-templated rhythmic patterns, misplaced emphasis, and limited perceptual naturalness. To address these challenges, we propose ChameleonVoice, a contextual prosody perception network that models emotional prosody as a temporally evolving process jointly shaped by linguistic structure and continuous affective state. The framework incorporates a contextual prosody perception mechanism that learns how rhythm, stress, and intonation unfold across the utterance based on semantic cues, and integrates valence-arousal emotion descriptors to capture intra-category variability and support fine-grained prosody modulation without requiring additional attributes or reference utterances. This design enables ChameleonVoice to adaptively reshape prosodic contours while preserving intelligibility and speaker identity. Comprehensive experiments across multiple emotions, speakers, and languages demonstrate that ChameleonVoice substantially improves prosodic naturalness, emotional expressiveness, and contextual coherence over state-of-the-art EVC systems.},
}

@misc{bjorn_schuller_ad627771119c7312,
  title = {CHARM: Charge Calibration and Acoustic Rescue for LLM-based Multimodal Sarcasm Detection},
  author = {Xi Shao and Zixing Zhang and Qiyang Sun and Yi Chang and Yupei Li and Björn W. Schuller},
  year = {2026},
  doi = {10.48550/ARXIV.2607.11102},
  url = {https://doi.org/10.48550/ARXIV.2607.11102},
  howpublished = {CoRR},
  annotation = {中文辅助译名：CHARM：基于 LLM 的多模态讽刺检测的电荷校准和声学救援},
  abstract = {Sarcasm detection, the identification of discrepancies between literal and intended meaning, is a fundamental task in affective computing. However, zero-shot instruction-tuned Large Language Models (LLMs) systematically over-predict the positive (sarcastic) class across the entire capability spectrum, while the prosodic cues humans rely on remain underexploited and transfer unevenly across languages. We introduce CHARM (Charge Calibration and Acoustic Rescue for Multimodal Sarcasm Detection), a training-free framework that couples two modules. Bidirectional Charge Calibration (BiCAL) steers the LLM toward opposing sarcastic and literal verdicts along a symmetric axis of charged prompts; the induced directional biases cancel by construction, and a simple aggregation recovers an unbiased pragmatic signal. Acoustic Late-Fusion Rescue (ALFR) then fuses the calibrated votes with prosodic descriptors and LLM-generated auditory-perception probes through a shallow classifier, actively down-weighting saturated text votes in favour of acoustic evidence. Without fine-tuning any backbone, BiCAL attains the highest reported zero-shot text-only Macro-F1 of 0.787 on MUStARD, while ALFR lifts weak backbones by up to +0.382 Macro-F1 on CMMA. A Stouffer meta-analysis confirms statistical significance on MUStARD and CMMA (Z = 13.89 and Z = 34.64, respectively; p < 10^-43). Our analysis further uncovers a cross-cultural prosodic decoupling: low-level acoustics fail to transfer across languages, },
}

@misc{bjorn_schuller_b0a643389efbfa63,
  title = {CLASH: Counterfactual Auditing of Lexical and Prosodic Reliance in Spoken Sarcasm Detection},
  author = {Jiabin Xue and Yuhang Dai and Xudong Li and Jiaming Li and Qiyang Sun and Yupei Li and Björn W. Schuller},
  year = {2026},
  doi = {10.48550/ARXIV.2609.16582},
  url = {https://doi.org/10.48550/ARXIV.2609.16582},
  howpublished = {CoRR},
  annotation = {中文辅助译名：CLASH：言语讽刺检测中词汇和韵律依赖的反事实审计},
  abstract = {Spoken sarcasm detectors may exploit lexical content, prosody, or their interaction, yet conventional evaluation cannot reveal which cues drive their predictions. We introduce CLASH (Controlled Lexical-Acoustic Separation Harness), a bilingual counterfactual diagnostic framework that evaluates each utterance under original, lexical-preserving, prosody-preserving, and approximately neutralised conditions. We evaluate handcrafted acoustic-feature systems, self-supervised learning (SSL) probes, and large audio language models (LALMs) on CMMA and MUStARD. For target-only Qwen3-Omni, lexical-preserving speech retains a 0.135--0.148 AUROC advantage over prosody-preserving speech after duration balancing, with cluster-bootstrap intervals above zero; alternative lexical resynthesis preserves this advantage. Acoustic interventions shift scores without consistently improving discrimination or changing binary predictions under the evaluated conditions. Context and interaction estimates vary across corpora. These findings distinguish acoustic sensitivity from sarcasm discrimination while exposing duration, identity, and transformation effects.},
}

@misc{bjorn_schuller_c29acc32cc1ef3c5,
  title = {CoarseSoundNet: Building a reliable model for ecological soundscape analysis},
  author = {Andreas Triantafyllopoulos and Svenja Schmidt and Sandra Mueller and Alexander Gebhard and Dominik Arend and Michael Scherer-Lorenzen and Björn W. Schuller},
  year = {2026},
  doi = {10.48550/ARXIV.2605.21143},
  url = {https://doi.org/10.48550/ARXIV.2605.21143},
  howpublished = {CoRR},
  annotation = {中文辅助译名：CoarseSoundNet：构建可靠的生态声景分析模型},
  abstract = {A soundscape is composed of three types of sound: biophony (sounds made by animals), geophony (natural abiotic sounds) and anthropophony (sounds made by humans). A key research question in the field of soundscape ecology is how these components interact with each other, specifically how biophony responds to geophony and anthropophony. Nevertheless, as of today, there are not many analytical instruments that enable the distinct quantification of these elements. Recent machine learning (ML) approaches aim to support automated analysis but often rely on task-specific or clean data, limiting generalisation to noisy passive acoustic monitoring (PAM) recordings. This study presents a reproducible framework to build ML models for coarse soundscape classification and introduces CoarseSoundNet , a deep learning model trained to distinguish biophony, geophony, and anthropophony under realistic terrestrial PAM conditions. We systematically investigate model architectures, the influence of an additional training class, data composition, and evaluation strategies. Our findings suggest that model performance improves with additional PAM data, especially when similar to the target domain, and by introducing an explicit silence class during training. Post-hoc target-domain calibration employing class-specific decision thresholds further enhance performance, while incorporating minimum annotation durations yields higher scores for anthropophony and geophony. Error analyses exhibit challenges },
}

