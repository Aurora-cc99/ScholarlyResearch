@misc{bjorn_schuller_d134a9edaf0cb8fa,
  title = {Unsupervised learning in cross-corpus acoustic emotion recognition},
  author = {Felix Weninger and Martin Wöllmer and Zixing Zhang and Björn W. Schuller},
  year = {2011},
  doi = {10.1109/ASRU.2011.6163986},
  url = {https://doi.org/10.1109/ASRU.2011.6163986},
  howpublished = {ASRU},
  annotation = {中文辅助译名：跨语料库声学情感识别中的无监督学习},
  abstract = {One of the ever-present bottlenecks in Automatic Emotion Recognition is data sparseness. We therefore investigate the suitability of unsupervised learning in cross-corpus acoustic emotion recognition through a large-scale study with six commonly used databases, including acted and natural emotion speech, and covering a variety of application scenarios and acoustic conditions. We show that adding unlabeled emotional speech to agglomerated multi-corpus training sets can enhance recognition performance even in a challenging cross-corpus setting; furthermore, we show that the expected gain by adding unlabeled data on average is approximately half the one achieved by additional manually labeled data in leave-one-corpus-out validation.},
}

@misc{bjorn_schuller_484d4edb814cc40c,
  title = {Come and have an emotional workout with sensitive artificial listeners!},
  author = {Martin Wöllmer and Gary McKeown and Michel F. Valstar and Hatice Gunes and Etienne de Sevin and Dirk Heylen and Elisabetta Bevacqua and Björn W. Schuller and Maja Pantic and Mark ter Maat and Marc Schröder and Catherine Pelachaud and Florian Eyben and Roddy Cowie and Sathish Pammi},
  year = {2011},
  doi = {10.1109/FG.2011.5771472},
  url = {https://doi.org/10.1109/FG.2011.5771472},
  howpublished = {FG},
  annotation = {中文辅助译名：快来和敏感的人工聆听者一起进行情感锻炼吧！},
  abstract = {This demonstration aims to showcase the recently completed SEMAINE system. The SEMAINE system is a publicly available, fully autonomous Sensitive Artificial Listeners (SAL) system that consists of virtual dialog partners based on audiovisual analysis and synthesis (see http://semaine.opendfki.de/wiki). The system runs in real-time, and combines incremental analysis of user behavior, dialog management, and synthesis of speaker and listener behavior of a SAL character, displayed as a virtual agent. The SAL characters intend to engage the user in a conversation by paying attention to the user's emotions and nonverbal expressions. The characters have their own emotionally defined personality. During an interaction, the characters attempt to create an emotional workout for the user by drawing her/him towards their dominant emotion, through a combination of verbal and nonverbal expressions.},
}

