@misc{bjorn_schuller_db878431bd329fdb,
  title = {Automatic Emotion Modelling in Written Stories},
  author = {Shahin Amiriparian and Manuel Milling and Lukas Christ and Ilhan Aslan and Björn W. Schuller},
