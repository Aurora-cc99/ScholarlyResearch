@misc{bjorn_schuller_a2372fed0653e631,
  title = {Social and Affective Robotics Tutorial},
  author = {Vanessa Evers and Marc Peter Deisenroth and Björn W. Schuller and Maja Pantic and Luis Merino},
  year = {2016},
  doi = {10.1145/2964284.2986914},
