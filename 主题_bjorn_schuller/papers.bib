  title = {Combining Efforts for Improving Automatic Classification of Emotional User States},
  author = {Anton M. Batliner and Stefan Steidl and Björn Wolfgang Schuller and Dino Seppi and Kornel Laskowski and Vogt, Thurid and Laurence Y. Devillers and Laurence Vidrascu and Noam Amir and Loïc Kessous and Vered Aharonson},
