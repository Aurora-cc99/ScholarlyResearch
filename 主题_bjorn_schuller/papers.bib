  author = {Shahin Amiriparian and Florian B. Pokorny and Anastasia Semertzidou and Katrin D. Bartl-Pokorny and Markus Wehler and Rainer Schönweiler and Elena Kramer and Björn W. Schuller and Florian Schmidt and Florian Eyben and Anton Batliner},
