  title = {The ACII 2022 Affective Vocal Bursts Workshop & Competition},
  author = {Alice Baird and Jeffrey A. Brooks and Dacher Keltner and Panagiotis Tzirakis and Björn W. Schuller and Alan Cowen and Christopher B. Gregory and Anton Batliner},
