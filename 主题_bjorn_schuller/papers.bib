@misc{bjorn_schuller_183349f3525830d9,
  title = {Check Your Audio Data: Nkululeko for Bias Detection},
  author = {Bagus Tris Atmaja and Felix Burkhardt and Anna Derington and Björn W. Schuller and Florian Eyben},
  year = {2024},
