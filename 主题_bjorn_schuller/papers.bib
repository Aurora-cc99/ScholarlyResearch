  annotation = {中文辅助译名：用于与说话人无关的语音情感识别的通用动态域适应},
  abstract = {Speaker attributes (e. g., age, accent, and expression habits) are typically confused with emotional cues in the speech feature space, which can impair the emotional discriminability of speech features that are robust to speakers, thereby degrading the generalization of speech emotion recognition (SER). To overcome this issue, we propose a Generalizable Dynamic Domain Adaptation (GDDA) framework for learning speaker-invariant speech emotion representations. GDDA transforms the speaker-independent SER task into an extension of domain adaptation from a single-source domain to multi-source domains to address the impact of multiple speakers on speech emotion representations. For this purpose, we first construct a GDDA under theSingleSource domain adaptation (i. e., GDDA-SS), which consists of two parts: a joint distribution adaptation (JDA) measuring the speech emotion feature distributions caused by speakers between the training and testing domains, and a dynamic balance factor (DBF) that enables the recognition model to adaptively handle unseen speaker data distributions. Specifically, JDA combines global marginal distribution adaptation (MDA) with local class-aware conditional distribution adaptation (CDA), and DBF uses$\mathcal A$-divergence to automatically quantify the contributions of MDA and CDA in JDA. In DJDA-SS, the training and testing data are considered as a source domain and a target domain, respectively, from a coarse-grained perspective. Considering the multi-d},
}

@misc{bjorn_schuller_7d54352fcde1fc2d,
  title = {Acoustic Cue Alignment in Audio Language Models for Speech Emotion Recognition},
  author = {Andreas Triantafyllopoulos and Iosif Tsangko and Björn W. Schuller},
  year = {2026},
  doi = {10.48550/ARXIV.2606.07309},
  url = {https://doi.org/10.48550/ARXIV.2606.07309},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于语音情感识别的音频语言模型中的声学提示对齐},
  abstract = {Instruction-following audio language models (ALMs) can be augmented with explicit acoustic cues, yet it remains unclear whether such cues are used in a grounded way when the raw audio is already available. We study this question in speech emotion recognition (SER) by deriving six interpretable acoustic concept tokens from the standardised eGeMAPS paralinguistic feature set. These tokens summarise energy, pitch, dynamics, brightness, formants, and voice quality, and are appended to the textual prompt while the audio input is kept unchanged. Across the widely used FAU-Aibo and IEMOCAP benchmarks, aligned tokens improve unweighted average recall (UAR), whereas shuffled, conflicting, or corrupted tokens reduce performance relative to aligned tokens and shift confusions toward neutral. Importantly, predictions do not collapse under strong token perturbations, suggesting that the models are sensitive to the symbolic cue channel but remain partly anchored to the audio signal. We argue that token-only interventions provide a practical way to probe audio-grounded cue use, robustness, and interpretability in ALM-based affective computing.},
}

@misc{jianhua_tao_88b892cfbd790669,
  title = {Multimodal Local Global Interaction Networks for Automatic Depression Severity Estimation},
  author = {Mingyue Niu and Zhuhong Shao and Yongjun He and Jianhua Tao and Björn W. Schuller},
  year = {2026},
