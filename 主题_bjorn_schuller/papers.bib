@misc{bin_hu_b5ec6cafc4dd3ab2,
  title = {Similarity as Evidence: An Explainable Siamese Framework for Snore Sound Classification},
  author = {Boyang Meng and Mengkai Sun and Haojie Zhang and Kun Qian and Wei Xue and Bin Hu and Björn W. Schuller},
  year = {2026},
