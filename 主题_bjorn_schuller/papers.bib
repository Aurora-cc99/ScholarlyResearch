@misc{bjorn_schuller_b080e696ae94ab9c,
  title = {AI-Generated Content Detection: A Cross-Modal Survey of Methods, Challenges, and Future Directions},
  author = {Mohamed Mady and Yupei Li and Björn Wolfgang Schuller and Berrak Şişman and Johannes Reschke},
  year = {2026},
  doi = {10.21203/rs.3.rs-10864156/v1},
  url = {https://doi.org/10.21203/rs.3.rs-10864156/v1},
  howpublished = {Research Square},
  annotation = {中文辅助译名：人工智能生成的内容检测：方法、挑战和未来方向的跨模式调查},
  abstract = {The explosive growth of generative artificial intelligence (AI) has dramatically accelerated the production of increasingly realistic synthetic text, images, audio, and video, unlocking new creative and operational capabilities while introducing acute risks to information integrity, digital security, and societal trust. This survey provides a comprehensive, up-to-date synthesis of AI-generated content detection research across text, image, audio, and video. Rather than treating each modality in isolation, we organise the literature around six shared families of detection techniques: likelihood-based scoring, frequency-domain analysis, artefact and fingerprint forensics, transformer-based representation learning, consistency and semantic checks, and active watermarking and cryptographic provenance, showing, for each family, where the technique transfers cleanly across modalities and where modality-specific assumptions cause it to break. We then instantiate this view in a unified four-axis cross-modal taxonomy (objective, paradigm, signal type, and generalisation regime), operationalised through a master classification of representative methods. We further quantify the laboratory-to-deployment gap, critically assess adversarial robustness, cross-model and cross-domain generalisation, dataset scarcity, and fairness, and distil open research gaps toward robust, generalisable, and interpretable detection.},
}

@misc{bjorn_schuller_ab8a100315e75424,
  title = {Artificial Intelligence for Ebola Disease Preparedness and Response: Public Health Priorities (Preprint)},
  author = {Simon Pistrosch and Sunil Munthumoduku Krishna Murthy and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.2196/preprints.114211},
  url = {https://doi.org/10.2196/preprints.114211},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：人工智能用于埃博拉疾病的防备和应对：公共卫生优先事项（预印本）},
  abstract = {UNSTRUCTURED Ebola disease causes recurrent humanitarian and public-health emergencies that demand rapid decisions under uncertainty. Outbreak control is complicated by incomplete surveillance, limited diagnostic and treatment capacity, mistrust, and constrained healthcare infrastructure. Artificial intelligence (AI) could support preparedness and response, but its value depends on reliable data, disease-specific validation, and adaptation to local conditions. This viewpoint examines five application areas: zoonotic surveillance, adaptive outbreak management, public health communication and education, clinical decision support, and therapeutics discovery. We review AI and related computational research, separating Ebola disease–specific findings from opportunities inferred from other diseases and settings. Existing studies have investigated applications in ecological risk mapping, outbreak forecasting, social-media sentiment analysis, clinical prognostic modeling, and drug and vaccine candidate prioritization. However, many proposed applications remain unvalidated in Ebola disease settings, and evidence of improved clinical or public-health outcomes is limited. Using the 2026 Bundibugyo virus disease emergency in the Democratic Republic of the Congo and Uganda as context, we distinguish research priorities relevant to the ongoing response from longer-term priorities in zoonotic surveillance and countermeasure development. We outline the challenges of integrating outbreak data},
}

@misc{bjorn_schuller_d110876e803ea65f,
  title = {AI-Enhanced Conversational Agents for Personalized Asthma Support in People With Asthma: Factors for Engagement, Value, and Efficacy in a Cross-Sectional Survey Study},
