  annotation = {中文辅助译名：副语言学的计算建模：概述},
  abstract = {This chapter provides an overview on the usual steps and building blocks involved in computational modelling of paralinguistics. The chapter describes the steps such as preprocessing, low-level descriptor extraction, and optional steps such as chunking, and (Hierarchical) functional extraction. It outlines the feature reduction, and the training/adaptation phase of feature selection/generation, parameter selection, and model learning. The chapter gives a detailed account of the classification/regression, and optional steps such as fusion, encoding, and the training/adaptation phase of audio databases. Finally it describes the acoustic model (AM) and language model (LM).},
}

@misc{bing_liu_uic_d2dfa0dd79738ff1,
