  annotation = {中文辅助译名：人工智能增强对话代理为哮喘患者提供个性化哮喘支持：横断面调查研究中参与度、价值和功效的因素},
  abstract = {Background: Asthma-related deaths in the United Kingdom are the highest in Europe, and only 30% of patients access basic care. There is a need for alternative approaches to reaching people with asthma to provide health education, self-management support, and better bridges to care. Objective: This study aimed to examine patients' interest in using a chatbot for asthma and to identify factors that influence engagement. Automated conversational agents (specifically, mobile chatbots) present opportunities for providing alternative and individually tailored access to health education, self-management support, and risk self-assessment. But would patients engage with a chatbot, and what factors influence engagement? Methods: We present results from a patient survey (N=1257) developed by a team of asthma clinicians, patients, and technology developers, conducted to identify optimal factors for efficacy, value, and engagement with an asthma chatbot. Results: Results indicate that most adults with asthma (53%) are interested in using a chatbot. The patients most likely to do so are those who believe their asthma is more serious and are less confident in their self-management. Results also indicate enthusiasm for 24/7 access, personalization, and for WhatsApp (Meta) as the preferred access method (compared to app, voice assistant, SMS text messaging, or website). Conclusions: Obstacles to uptake include security and privacy concerns and skepticism of technological capabilities. We pres},
}

@misc{bin_hu_13a9fac486326358,
  title = {A Gradient-based yet Spike-Timing-Dependent Solution to the Feedback Learning Problem in Neural Microcircuits},
  author = {Xiangnan Zhang and Jingxin Liu and Ranqi Lu and Jingyu Liu and Qunxi Dong and Fuze Tian and Lixian Zhu and Bin Hu and Björn W. Schuller},
  year = {2026},
  doi = {10.48550/ARXIV.2609.08070},
  url = {https://doi.org/10.48550/ARXIV.2609.08070},
  howpublished = {CoRR},
  annotation = {中文辅助译名：神经微电路中反馈学习问题的基于梯度但与尖峰时序相关的解决方案},
  abstract = {The brain uses discrete spikes for dynamic computation, yet in the fields of computational neuroscience and brain-inspired computing, how neural microcircuits (NMCs) solve temporal credit assignment using local spike timing remains a fundamental open question. Dominant spiking neural network (SNN) approaches circumvent this by approximating backpropagation through surrogate gradients, decoupling learning from biological spike timing. In order to integrate seemingly incompatible spike timing and continuous gradients, we reformulate temporal credit assignment as a state separation problem: extracting task-required components induced by historical perturbations directly from the current neural state. This enables an online feedback learning framework for NMCs through a gradient tunneling (GT) algorithm and the lead-lag expansion technique that derives credit assignment from local synaptic spike timing, while remaining compatible with ANN-SNN hybrid architectures. Experimentally, GT-trained NMCs excel at long-timescale evidence integration and noise-robust memory retention, and perform comparably to leading SNN online learning methods on real-world benchmarks with far fewer parameters. The proposed framework addresses the two-decade-old NMC feedback learning problem and suggests a computational theory for the brain's temporal credit assignment mechanisms.},
}

@misc{bjorn_schuller_8e997878c6a3fb7c,
  title = {The Birth of Voice: Acoustic Baselines of Newborn Vocalizations in the First Minutes of Extrauterine Life},
  author = {Marlene Holzer and Katrin D. Bartl-Pokorny and Claudia Zitta and Johanna Schuller and Björn Wolfgang Schuller and Bernhard Schwaberger and Herbert Fluhr and Gerhard Pichler and Florian B. Pokorny},
  year = {2026},
  doi = {10.1016/j.jvoice.2026.10.002},
  url = {https://doi.org/10.1016/j.jvoice.2026.10.002},
  howpublished = {Journal of Voice},
  annotation = {中文辅助译名：声音的诞生：新生儿在宫外生命最初几分钟发声的声学基线},
  abstract = {OBJECTIVES: Newborn crying immediately after birth has traditionally been regarded as a key sign of vitality, reflecting basic cardiovascular and respiratory function. However, initial postnatal vocal behavior not only limited to crying and its underlying mechanisms are not yet fully understood, and systematic acoustic analyses of birth vocalizations (BiVo) are lacking. This study addresses this gap by providing indicative values for established vocalization parameters to comprehensively characterize the very first vocalizations of newborns in a largely homogeneous non-pathological sample. STUDY DESIGN: We analyzed publicly available birth videos of 60 vaginally delivered newborns (35 female, 25 male), who exhibited an unremarkable health status. METHODS: In each video, we manually segmented BiVo during the first 3 minutes after birth, yielding a total of 7681 vocalizations. Each segment was subsequently assigned to one of three predefined vocalization types. On a per-newborn basis, we extracted the number of vocalizations and the time from birth to the respective first vocalization. On a per-vocalization basis, we calculated duration and five standard acoustic parameters, namely mean loudness, harmonics-to-noise ratio, fundamental frequency, jitter, and shimmer. In addition to descriptive analysis, we applied linear mixed-effects models to examine potential sex differences. All analyses were performed both across all vocalizations and separately by vocalization type. RESULTS},
}

@misc{bjorn_schuller_5bd32afabe8d304f,
  title = {Motion Estimation for Cable-Driven Surgical-Robotic Continuum Joints Using a Multibranch Coattention Recurrent Network},
  author = {Fan Shen and Yongfa Chen and Xinzhou Xu and Ziqian Li and Zhengyu Wang and Franz Pernkopf and Björn Wolfgang Schuller},
