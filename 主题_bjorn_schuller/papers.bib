@misc{bjorn_schuller_6f4d978a22ba9656,
  title = {Establishing the reliability of metrics extracted from long-form recordings using LENA and the ACLEW pipeline},
  author = {Alejandrina Cristià and Lucas Gautheron and Zixing Zhang and Björn Wolfgang Schuller and Camila Scaff and Caroline F. Rowland and Okko Johannes Räsänen and Loann Peurey and Marvin Lavechin and William N. Havard and Caitlin M. Fausey and Margaret Cychosz and Elika Bergelson and Heather A. Anderson and Najla D. Al Futaisi and Mélanie Söderström},
