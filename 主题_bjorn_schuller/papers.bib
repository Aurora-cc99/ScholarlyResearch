@misc{bjorn_schuller_0d506b4aa4a3f37a,
  title = {Mixture-of-Experts Based Soft-Label Learning for Multi-Label Speech Emotion Recognition},
  author = {Yandi Zheng and Xinzhou Xu and Ziping Zhao and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11460912},
  url = {https://doi.org/10.1109/icassp55912.2026.11460912},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：基于专家混合的多标签语音情感识别软标签学习},
  abstract = {Multi-label Speech Emotion Recognition (SER) aims to recognise one or more co-occurring emotions from speech, due to emotional ambiguity and human-perception subjectivity. Existing endeavors usually rely on Majority Rule (MR) and Plurality Rule (PR) to obtain a consensus single label for each sample, which fails to capture the correlation between multiple emotional categories. In this regard, we propose a Mixture-of-Experts (MoE) based soft-label learning for multi-label SER. The proposed approach contains a speech representation extracting module and an MoE module, which captures discriminative information among multiple annotators’ annotations. Experimental results on emotional speech datasets demonstrate that, the proposed approach outperforms compared state-of-the-art ones, showcasing its effectiveness for multi-label SER tasks.},
}

@misc{bjorn_schuller_d7907616a9788db4,
  title = {Daily Affect Inference from Longitudinal Speech-based Journals: A Comparison of Acoustic and Linguistic Models},
  author = {Andreas Triantafyllopoulos and Nadine N. Schmitt and Michelle Schlicher and Johanna Schuller and Björn W. Schuller},
  year = {2026},
  doi = {10.21437/INTERSPEECH.2026-2383},
  url = {https://doi.org/10.21437/INTERSPEECH.2026-2383},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：基于纵向语音的期刊的日常情感推断：声学模型和语言模型的比较},
  abstract = {Speech-based journaling provides both acoustic cues and semantically rich content, offering strong potential for mental health monitoring.But how well do current models infer indicators such as mood and stress from naturalistic data?We introduce a longitudinal corpus of 61 speakers and 769 daily recordings, labeled with the Multidimensional Mood Questionnaire and Perceived Stress Scale, to compare eGeMAPS and wav2vec2 models with GBERT-large and zero-shot Mistral-7B-Instruct.We reveal that linguistic models clearly dominate at the population-level: GBERT reaches .122concordance for arousal, and Mistral .466for valence and .360for stress, whereas acoustic results are near zero.Mistral, however, is geared towards inferring trait-like differences rather than daily speaker variations.The acoustics indicate a relation between pause variations and valence at the speaker-level.We conclude that our models are limited in their ability to monitor individuals and require personalization.},
}

@misc{bjorn_schuller_2fb132b3ea731eab,
  title = {Diffusion Models for Stroke Outcome Prediction from Acute CT Perfusion Slices: A Preliminary Study},
  author = {Björn W. Schuller and Mina A. Nessiem},
  year = {2026},
  doi = {10.1109/CBMS69103.2026.00319},
  url = {https://doi.org/10.1109/CBMS69103.2026.00319},
  howpublished = {CBMS},
  annotation = {中文辅助译名：急性 CT 灌注切片预测中风结果的扩散模型：初步研究},
  abstract = {Predicting final infarct extent from acute CT perfusion imaging is critical for stroke treatment decisions, yet remains challenging due to extreme class imbalance and the complex relationship between acute hemodynamics and tissue fate. While discriminative approaches dominated the recent ISLES'24 challenge, diffusion probabilistic models have not yet been evaluated for final infarct prediction from CT perfusion parameter maps. We evaluate MedSegDiff, a conditional diffusion architecture, on the ISLES'24 dataset using Tmax and CBF inputs (2D slice-based evaluation on fold 0, foreground slices only). With threshold optimization, our approach with 5-sample mean ensembling achieves 13.2% Dice, a 38% relative improvement over a 2D nnU-Net baseline (9.6% Dice), with notably higher sensitivity (0.221 vs 0.086). At a fixed threshold$\tau=0.5$, the diffusion model still outperforms nnU-Net (11.0% vs 9.6% Dice). The stochastic nature of diffusion sampling enables effective test-time ensembling, with AUC improving from 0.670 (single sample) to 0.740 (5 samples).},
}

@misc{bjorn_schuller_ad5af6d3aa960414,
  title = {Speech analysis for acute decompensated heart failure: reporting a pilot study in Germany},
  author = {Andreas Triantafyllopoulos and Wolfgang Mayr and Anton Batliner and Lana Lempkens and Björn Wolfgang Schuller and Thomas M. Berghaus},
  year = {2026},
  doi = {10.3389/fdgth.2026.1885715},
  url = {https://doi.org/10.3389/fdgth.2026.1885715},
  howpublished = {Frontiers in Digital Health},
  annotation = {中文辅助译名：急性失代偿性心力衰竭的言语分析：报告德国的一项试点研究},
  abstract = {Acute decompensated heart failure (ADHF) has been shown to affect breathing and speech production. We present a new German speech dataset and conduct a pilot study to show the feasibility of using speech to distinguish between decompensated and recompensated ADHF. We achieve accuracy rates of 77 % for this binary classification using read speech, with the use of segmented phrases scoring at 75% and sustained vowels trailing far behind at 52%. Our feature analysis shows a reduction in breathiness and an increase in articulation stability during recompensation. Overall, our results show the promise of speech analysis in the monitoring of ADHF and demonstrate that further efforts should be invested to obtain large-scale data and replicate our results in more heterogeneous populations.},
}

@misc{bjorn_schuller_dfae0124841b2f8d,
  title = {Concentrated Causal Influence, Distributed Diagnostic Information: Cognitive Impairment Decisions in Large Audio-Language Models},
  author = {Xiutian Zhao and Luqi Sun and Björn Wolfgang Schuller and Berrak Sisman},
  year = {2026},
  doi = {10.48550/arxiv.2610.32061},
  url = {https://arxiv.org/abs/2610.32061},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：集中的因果影响，分布式的诊断信息：大型音频语言模型中的认知障碍决策},
  abstract = {Large audio-language models (LALMs) can assess cognitive impairment (CI) from speech, yet their answers reveal neither which internal components control the decision nor how much CI information is accessible in their representations. We investigate both questions through CI-contrast neurons (CICNs), selected by class-contrastive activation frequency in decoder MLPs. Across eight open LALMs and two corpora (Pitt and PROCESS-2), we causally test CICNs against size- and layer-matched random masks and activity-matched controls. In three of the five models that meet our eligibility criteria, ablation of small CICN sets causes large, class-directed prediction shifts; speech-identified masks also control transcript-only decisions, and three of four primary Pitt masks retain specificity on PROCESS-2. Position-restricted interventions locate the influence before the final answer position, most strongly after the speech or transcript evidence under letter-labeled options, largely as a decision-direction shift. Beyond causal localization, supervised linear readouts of frozen CICN activations achieve 0.92--0.97 AUC within Pitt, versus 0.67--0.84 for the models' direct answers. Matched random and all-neuron readouts reach comparable performance; top-ranked CICNs show only an exploratory advantage at very small unit budgets. These results distinguish concentrated causal control over output decisions from broadly distributed diagnostic information for CI detection in LALMs.},
}

@misc{bjorn_schuller_f5d1db7949e58a52,
  title = {Towards a non-invasive bioacoustic indicator of avian health: Linking song performance traits to physiological condition},
  author = {Andreas Triantafyllopoulos and Sandra Mueller and Swen C. Renner and Dominik Arend and Björn W. Schuller},
  year = {2026},
  doi = {10.1016/J.ECOINF.2026.103976},
  url = {https://doi.org/10.1016/J.ECOINF.2026.103976},
  howpublished = {Ecol. Informatics},
  annotation = {中文辅助译名：建立鸟类健康的非侵入性生物声学指标：将歌曲表现特征与生理状况联系起来},
  abstract = {Birdsong performance traits offer a mechanistically grounded route for developing non-invasive indicators of avian physiological condition at ecologically relevant scales. Sexual selection and honest signalling theory predict that complex, energetically costly song traits should be condition-dependent and thus sensitive to stressors such as parasitism and physiological stress. However, it remains unclear whether these relationships scale beyond individuals or single species to the plot level that would matter for monitoring programs. Here, we explicitly frame birdsong traits as a candidate state indicator and ask whether variation in health metrics across forest plots is reflected in corresponding changes in performance-related acoustic traits. We combined blood-derived health metrics with passive acoustic recordings from 17 forest plots in south-west Germany, focusing on five common songbirds ( Erithacus rubecula , Fringilla coelebs , Parus major , Sylvia atricapilla , Turdus merula ). For each species-by-plot combination, we quantified median haemosporidian infection intensity and heterophil-to-lymphocyte ratio. We extracted performance-related song traits using automated acoustic metrics (peak frequency, spectral bandwidth, number of spectral peaks, chroma variance, tonnetz variance) from species-specific, BirdNET-based classifications. Using mixed-effects models at the species-by-plot scale, we tested whether variation in these health metrics correlates with acoustic feat},
}

@misc{bjorn_schuller_d19b93657b5c662d,
  title = {Outside the healthy bounds: reference intervals for population and individual-level medical speech analysis},
  author = {Pascal Hecker and Monica Gonzalez-Machorro and Catarina Botelho and Helly Noemi Hammer and Hesam Sagha and Matthias Kahlau and Robert Hoepner and Florian Eyben and Björn Wolfgang Schuller and Bert Arnrich A},
  year = {2026},
  doi = {10.3389/fdgth.2026.1870061},
  url = {https://doi.org/10.3389/fdgth.2026.1870061},
  howpublished = {Frontiers in Digital Health},
  annotation = {中文辅助译名：健康界限之外：人群和个人层面医学言语分析的参考区间},
  abstract = {Reference intervals (RIs) are a well-established clinical tool for defining healthy bounds of laboratory measures. Recently, they have been applied to acoustic features extracted from speech to provide a transparent and disorder-agnostic perspective on symptomatic speakers. We evaluate the potential and limitations of RIs across three datasets: clean, laboratory recordings from people with multiple sclerosis (pwMS) and two noisy datasets targeting respiratory symptoms and work-related stress, collected under everyday-life conditions. At the population level, we compare the proportion of features outside the RI bounds between control and symptomatic groups, test noise augmentation of the RI-estimation corpus for improved robustness, and identify the most indicative acoustic features for each health condition. At the individual level, we derive a per-speaker deviation score that quantifies how far each speaker’s acoustic profile deviates from the healthy reference, and assess its discriminative ability using the area under the receiver operating characteristic curve (AUC). Noise augmentation of the healthy reference corpus yields similar population-level separation; the continuous DS Q 123 deviation score yielded 12 features that remained significant after global Benjamini–Hochberg false discovery rate (FDR) correction. The individual-level deviation score achieves promising discrimination for male pwMS ( AUC = 0.97 for read speech), even in a clinically mild cohort, while resu},
}

@misc{bjorn_schuller_a28cf35ff173c18f,
  title = {Bringing Multimodal Foundation Models to Hearing Aids},
  author = {Andreas Triantafyllopoulos and Iosif Tsangko and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464213},
  url = {https://doi.org/10.1109/icassp55912.2026.11464213},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：将多模态基础模型引入助听器},
  abstract = {Recent work has shown that adaptive speech denoising can reduce the computational overhead of deep learning models that run on hearing aid devices by leveraging information regarding the acoustic scene to condition the main denoising model. This is typically done through an auxiliary encoder that processes fingerprints of the noise background and is trained along with the main denoising network. This work explores the hypothesis that the use of multimodal foundation models (FMs) as pre-trained feature extractors instead of randomly initialised encoders can further improve performance. This would allow us to unleash the promise of FMs to the domain of hearing aids by offloading their execution to external device (e. g., smartphones) which are queried periodically to analyse the background acoustic scene. We present a series of experiments that aim to put this hypothesis to the test. Our results show that FMs do not bring any additional benefits compared to randomly initialised encoders. Our accompanying analysis showcases how the introduction of fingerprints does not affect the denoising as expected, showcasing the need for more research in this promising direction.},
}

@misc{bjorn_schuller_9de83d913712fb4a,
  title = {Decoding nature's melody: significance and challenges of machine learning in assessing bird diversity via soundscape analysis},
  author = {Xin Jing and Mengkun Zhu and Shanshan Xie and Junguo Zhang and Jiangjian Xie and Linlin Xie and Yang Liu and Björn W. Schuller and Kun Qian},
  year = {2026},
  doi = {10.1007/S10462-025-11414-4},
  url = {https://doi.org/10.1007/S10462-025-11414-4},
  howpublished = {Artif. Intell. Rev.},
  annotation = {中文辅助译名：解码自然旋律：机器学习通过音景分析评估鸟类多样性的意义和挑战},
  abstract = {The broad application of passive acoustic monitoring provides a critical data foundation for studying soundscape ecology, necessitating automated analysis methods to accurately extract ecological information from vast soundscape data. This review comprehensively and cohesively examines two predominant approaches in soundscape analysis: soundscape component recognition and acoustic indices methods. Focusing on machine learning (ML)-based analysis methods for bird diversity assessment over the past five years, this review surveys representative research within each category, outlining their respective strengths and limitations. This not only addresses the growing interest in this field but also identifies research gaps and poses key questions for future studies. The insights from this review are anticipated to significantly enhance the understanding of ML applications in soundscape analysis, guiding subsequent investigative efforts in this rapidly evolving discipline, and thereby better supporting long-term biodiversity monitoring and conservation initiatives.},
}

