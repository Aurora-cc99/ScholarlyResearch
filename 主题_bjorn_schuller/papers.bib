  abstract = {MRAC 2026 marks the fourth edition of this workshop. The official website is available at: https://react-ws.github.io/2026_mrac/. Centered on affective computing, the workshop emphasizes multimodal, generative, and responsible AI technologies. This year, we received 40 submissions, a new milestone that underscores the growing interest in our workshop within the research community. The workshop has two tracks: Track 1 hosts the MER 2026 Challenge, comprising four tracks: MER-Cross focuses on emotion recognition in dyadic interactions; MER-FG targets fine-grained emotion recognition; MER-Prefer centers on human emotion preferences; and MER-PS integrates physiological signals for emotion recognition. MER 2026 has attracted approximately 300 registered teams, with 108 participating in MER-Cross, 64 in MER-FG, 82 in MER-Prefer, and 111 in MER-PS. We also invite participants to submit their challenge solutions to our workshop. Track 2 mainly focuses on the multimodal, generative, and responsible Affective Computing area. The creation, evaluation, and deployment of emotion-AI models require large amounts of multimodal data spanning RGB images, video, audio, text, and physiological signals. In principle, the development of any AI system must be guided by a concern for its impact on humans. The aim should be to augment and enhance human capabilities, not replace them, while drawing inspiration from human intelligence and prioritizing safety. MRAC 2026 aims to bring together affective },
}

@misc{bjorn_schuller_0cae8293bc105208,
  title = {MReactor: Offline Multiple Appropriate Facial Reaction Generation with Hierarchical Cognitive Disentanglement},
  author = {Jiachen Luo and Jiajun He and Shuai Shen and Lin Wang and Huy Phan and Joshua D. Reiss and Haijun Lin and Björn Wolfgang Schuller and Zeyu Fu and Siyang Song},
  year = {2026},
  doi = {10.1109/cvprf71909.2026.00326},
  url = {https://doi.org/10.1109/cvprf71909.2026.00326},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：MReactor：离线生成多种适当的面部反应，并分层认知解开},
  abstract = {Facial reactions are central to dyadic communication, revealing how listeners perceive and respond to speakers' behaviours. Unlike traditional facial reaction generation methods that assume a one-to-one mapping, human reactions are inherently one-to-many, motivating the Multiple Appropriate Facial Reaction Generation (MAFRG) task. Despite the significant advances achieved in recent years, existing approaches still face challenges in noisy multimodal perception, entangled local and global dynamics, and limited semantic controllability. To tackle these problems, we present MReactor in this work, which is the novel offline and cognitively grounded MAFRG framework inspired by the Human Model Processor. Specifically, the MReactor integrates (i) multi-modal behaviour perception for stable cue extraction, (ii) hierarchical cognition disentanglement for fine- and coarse-grained cues, and (iii) multiple appropriate generation for diverse and contextually coherent reactions via contextual behaviour and recovery expression. Extensive experiments on the MARS dataset show that our MReactor achieved state-of-the-art results in synchrony, appropriateness and diversity, producing natural and human-like facial reactions.},
}

@misc{bjorn_schuller_ec32cd4e881fcde0,
  title = {NeuReasoner: Theory-grounded Mapping of Reasoning Elicitation Boundaries},
  author = {Florian von Wangenheim and Joseph Ollier and Shyngys Aitkazinov and Aydin Javadov and Tobias Hoesli and Björn W. Schuller},
