@misc{bjorn_schuller_5549cf0ef4b841d3,
  title = {Emotion-Awareness for Intelligent Vehicle Assistants: A Research Agenda},
  author = {Thomas Hubregtsen and Ronee Chadowitz and Raphaël Troncy and Viviane S. Ghaderi and Susanne Muller and Jacques M. B. Terken and Adlen Ksentini and Samer Al Moubayed and Björn W. Schuller and Jérôme Härri and Alexander Zadorojniy and Melek Önen and Elisabeth André and Jonas Beskow and Ann Morrison and Benoit Huet and Nicholas Cummins and Kynan Eng and Jörg Conradt and Asaf Adi and Christian Süß and Florian Eyben and Hans-Jörg Vögel},
  year = {2018},
  doi = {10.1145/3194085.3194094},
  url = {https://doi.org/10.1145/3194085.3194094},
  howpublished = {SEFAIAS@ICSE},
  annotation = {中文辅助译名：智能车辆助手的情感意识：研究议程},
  abstract = {EVA1 is describing a new class of emotion-aware autonomous systems delivering intelligent personal assistant functionalities. EVA requires a multi-disciplinary approach, combining a number of critical building blocks into a cybernetics systems/software architecture: emotion aware systems and algorithms, multimodal interaction design, cognitive modelling, decision making and recommender systems, emotion sensing as feedback for learning, and distributed (edge) computing delivering cognitive services.},
}

@misc{bjorn_schuller_90e2fa8f75e1df98,
  title = {Early Vocal Development in Autism Spectrum Disorder, Rett Syndrome, and Fragile X Syndrome: Insights from Studies Using Retrospective Video Analysis},
  author = {Laura Roche and Dajie Zhang and Katrin D. Bartl-Pokorny and Florian B. Pokorny and Björn Wolfgang Schuller and Gianluca Esposito and Sven Bölte and Herbert Roeyers and Luise Poustka and Markus Gugatschka and Hannah L. Waddington and Ralf Vollmann and Christa Einspieler and Peter B. Marschik},
  year = {2018},
  doi = {10.1007/s41252-017-0051-3},
  url = {https://doi.org/10.1007/s41252-017-0051-3},
  howpublished = {Advances in Neurodevelopmental Disorders},
  annotation = {中文辅助译名：自闭症谱系障碍、雷特综合征和脆性 X 综合征的早期发声发育：回顾性视频分析研究的见解},
  abstract = {This article provides an overview of studies assessing the early vocalisations of children with autism spectrum disorder (ASD), Rett syndrome (RTT), and fragile X syndrome (FXS) using retrospective video analysis (RVA) during the first two years of life. Electronic databases were systematically searched and a total of 23 studies were selected. These studies were then categorised according to whether children were later diagnosed with ASD (13 studies), RTT (8 studies), or FXS (2 studies), and then described in terms of (a) participant characteristics, (b) control group characteristics, (c) video footage, (d) behaviours analysed, and (e) main findings. This overview supports the use of RVA in analysing the early development of vocalisations in children later diagnosed with ASD, RTT or FXS, and provides an in-depth analysis of vocalisation presentation, complex vocalisation production, and the rate and/or frequency of vocalisation production across the three disorders. Implications are discussed in terms of extending crude vocal analyses to more precise methods that might provide more powerful means by which to discriminate between disorders during early development. A greater understanding of the early manifestation of these disorders may then lead to improvements in earlier detection.},
}

