  howpublished = {Wiley eBooks},
  annotation = {中文辅助译名：分类法},
  abstract = {This chapter presents a ‘taxonomic skeleton’ for paralinguistic events. Taxonomies deal with the same-different problem which we could call the ‘which box(es) game’. The chapter deals with inherent characteristics of paralinguistic phenomena apart from aspects of modelling. The idea behind it is not necessarily to establish the ultimate taxonomy for paralinguistics but to make it possible to answer to the question as to what phenomena, such as emotions, personality traits, or types of deviant speech, can be described within which taxonomy, and how relevant is this for the different stages of computational paralinguistics? In the chapter, the authors often have more to say on emotion and personality than on biological or cultural traits primitives, or on the other phenomena. This is simply due to the nature of these different paralinguistic phenomena.},
}

@misc{bjorn_schuller_f5f919fc4b0c5e29,
