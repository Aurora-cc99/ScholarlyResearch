  author = {Zhao Ren and Björn W. Schuller and Sofiane Laridi and Marco Fisichella and Yi Chang and Gregory Palmer},
  year = {2026},
  doi = {10.21437/INTERSPEECH.2026-1125},
  url = {https://doi.org/10.21437/INTERSPEECH.2026-1125},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：鲁棒联合语音情感识别的两阶段防御},
  abstract = {With machine learning and speech processing advancements, speech emotion recognition has gained popularity recently.However, speech data cannot be protected when it is uploaded and processed on servers in the internet-of-things applications of speech emotion recognition.Further, deep neural networks have proven to be vulnerable to human-indistinguishable adversarial perturbations.The adversarial attacks generated from the perturbations may result in deep neural networks wrongly predicting the emotional states.We propose a novel federated adversarial learning framework for protecting both data and deep neural networks.The proposed framework consists of i) federated learning for data privacy, and ii) adversarial training at the training stage and randomisation at the testing stage for model robustness.The experiments show our proposed framework effectively protects speech data locally and improve model robustness against a series of adversarial attacks.},
}

@misc{bjorn_schuller_bc492d9eebf51e29,
  title = {Towards friendly AI: a comprehensive review and new perspectives on human-AI alignment},
  author = {Yupei Li and Qiyang Sun and Emran Alturki and Sunil Munthumoduku Krishna Murthy and Björn W. Schuller},
  year = {2026},
  doi = {10.1007/S43681-026-01070-X},
  url = {https://doi.org/10.1007/S43681-026-01070-X},
  howpublished = {AI Ethics},
  annotation = {中文辅助译名：迈向友好的人工智能：人类与人工智能协调的全面回顾和新视角},
  abstract = {As Artificial Intelligence (AI) continues to advance rapidly, Friendly Artificial Intelligence (FAI) has been proposed to advocate for more equitable and fair development of AI. Despite its importance, there is a lack of comprehensive reviews examining FAI from an ethical perspective, as well as limited discussion on its potential applications and future directions. This paper addresses these gaps by providing a thorough review of FAI, focusing on theoretical perspectives both for and against its development, and presenting a formal definition in a clear and accessible format. Key technical subfields are discussed from the perspectives of eXplainable AI (XAI), privacy, fairness and Affective Computing (AC). Additionally, the paper identifies challenges in current technological advancements and explores future research avenues. The findings emphasise the significance of developing FAI and advocate for its continued advancement to ensure ethical and beneficial AI development.},
}

@misc{bjorn_schuller_a5cd2ed0a1a3f33a,
  title = {Charting 15 Years of Progress in Deep Learning for Speech Emotion Recognition: A Replication Study},
  author = {Andreas Triantafyllopoulos and Anton Batliner and Björn W. Schuller},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3680663},
  url = {https://doi.org/10.1109/TAFFC.2026.3680663},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：描绘语音情感识别深度学习 15 年的进展：一项复制研究},
  abstract = {Speech emotion recognition (SER) has long benefited from the adoption of deep learning methodologies. Deeper models– with more layers and more trainable parameters are generally perceived as being ‘better’ by the SER community. This raises the question– how much better are modern-era deep neural networks compared to their earlier iterations? Beyond that, the more important question of how to move forward remains as poignant as ever. SER is far from a solved problem; therefore, identifying the most prominent avenues of future research is of paramount importance. In the present contribution, we attempt a quantification of progress in the 15 years of research beginning with the introduction of the landmark 2009 INTERSPEECH Emotion Challenge. We conduct a large scale investigation of model architectures, spanning both audio-based models that rely on speech inputs and text-based models that rely solely on transcriptions. Our results point towards diminishing returns and reaching a plateau after the recent introduction of transformers. Moreover, we demonstrate how perceptions of progress are conditioned on the particular selection of models that are compared. Our findings demonstrate that new methods should compare with an adequate selection of standard baselines and ensure that hyperparameters are properly tuned to not disadvantage older methods. Moreover, they cast a shadow of doubt to the premise that bigger models necessarily lead to an improvement in performance.},
}

@misc{bjorn_schuller_840609f8b8bd731c,
  title = {Does the Definition of Difficulty Matter? Scoring Functions and their Role for Curriculum Learning},
  author = {Andreas Triantafyllopoulos and Manuel Milling and Björn W. Schuller and Simon David Noel Rampp},
  year = {2026},
  doi = {10.1109/IJCNN69854.2026.11729720},
  url = {https://doi.org/10.1109/IJCNN69854.2026.11729720},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：难度的定义重要吗？评分函数及其在课程学习中的作用},
  abstract = {Curriculum learning (CL) describes a machine learning training strategy in which samples are gradually introduced into the training process based on their difficulty. Despite a partially contradictory body of evidence in the literature, CL finds popularity in deep learning research due to its promise of leveraging human-inspired curricula to achieve higher model performance. Yet, the subjectivity and biases that follow any necessary definition of difficulty, especially for those found in orderings derived from models or training statistics, have rarely been investigated. To shed more light on the underlying unanswered questions, we conduct an extensive study on the robustness and similarity of the most common scoring functions for sample difficulty estimation, as well as their potential benefits in CL, using the popular benchmark dataset CIFAR-10 and the acoustic scene classification task from the DCASE2020 challenge as representatives of computer vision and computer audition, respectively. We report a strong dependence of scoring functions on the training setting, including randomness, which can partly be mitigated through ensemble scoring. While we do not find a general advantage of CL over uniform sampling, we observe that the ordering in which data is presented for CL-based training plays an important role in model performance. Furthermore, we find that the robustness of scoring functions across random seeds positively correlates with CL performance. Finally, we uncover t},
}

