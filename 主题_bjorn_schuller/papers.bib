@misc{bjorn_schuller_f74665f6e291f041,
  title = {The INTERSPEECH 2012 Speaker Trait Challenge},
  author = {Felix Weninger and Felix Burkhardt and Alessandro Vinciarelli and Stefan Steidl and Elmar Nöth and R. J. J. H. van Son and Gelareh Mohammadi and Björn W. Schuller and Benjamin Weiss and Florian Eyben and Anton Batliner and Tobias Bocklet},
