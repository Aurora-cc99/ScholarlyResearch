@misc{bjorn_schuller_813868ab358027be,
  title = {Perspectives from sound engineering on music and language},
  author = {Florian B. Pokorny and Björn Wolfgang Schuller},
  year = {2025},
  doi = {10.1093/oxfordhb/9780192894700.013.0008},
  url = {https://doi.org/10.1093/oxfordhb/9780192894700.013.0008},
  howpublished = {Oxford University Press eBooks},
  annotation = {中文辅助译名：声音工程对音乐和语言的看法},
  abstract = {Sound engineering is a broad discipline that deals with the scientific conceptualization and the practical implementation of technologies for generating, recording, processing, and analysing sound data. Spoken language, i.e. speech, and music represent specific types of sound data. This chapter explains basic properties of speech and music data from an engineer’s perspective, and presents common strategies for speech and music data collection alongside their respective pros and cons. The evolution of speech and music applications since the roots of sound engineering until today is outlined on the basis of pioneering milestones. A special focus is set on the current trend of artificial intelligence in sound engineering using the example of intelligent speech analysis, which is a combination of advanced audio signal processing and machine learning methodology for an automatic derivation of information from speech signals. Current applications range from automatic speech recognition in voice-controlled personal assistant services via speech emotion recognition to the automatic detection of diseases from a patient’s voice. This chapter reveals the traditional pipeline of a machine learning system as well as the latest deep learning concepts for resolving a speech-based classification task, such as the automatic differentiation of a healthy speaker and a speaker with a certain disease. Finally, relevant legal and ethical issues in the context of speech and music engineering in gen},
}

