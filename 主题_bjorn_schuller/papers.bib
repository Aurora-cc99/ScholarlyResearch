@misc{bjorn_schuller_4f5eb3b3f5eb79b4,
  title = {Tandem decoding of children's speech for keyword detection in a child-robot interaction scenario},
  author = {Dino Seppi and Martin Wöllmer and Stefan Steidl and Anton Batliner and Björn W. Schuller},
  year = {2011},
  doi = {10.1145/1998384.1998386},
  url = {https://doi.org/10.1145/1998384.1998386},
