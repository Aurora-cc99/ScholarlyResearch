@misc{bjorn_schuller_50c948405d464358,
  title = {COVID-19 detection from audio: seven grains of salt},
  author = {Harry Coppock and Lyn Isobel Jones and Ivan Kiskin and Björn Wolfgang Schuller},
  year = {2021},
  doi = {10.1016/s2589-7500(21)00141-2},
  url = {https://doi.org/10.1016/s2589-7500(21)00141-2},
  howpublished = {The Lancet Digital Health},
  annotation = {中文辅助译名：通过音频检测 COVID-19：七粒盐},
  abstract = {Digital mass testing for COVID-19 via a mobile phone application could be made possible through machine learning and its ability to identify patterns in data. COVID-19 appears to confer unique features in the audio produced by infected individuals,1 and machine learning COVID-19 detection from breath, cough, and speech audio recordings has yielded promising results.2–4 In this critique, we present seven major issues with this research and argue that further investigation is needed before conclusions about the detectability of COVID-19 from audio can be made.},
}

