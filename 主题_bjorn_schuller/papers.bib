@misc{bjorn_schuller_aaf34bc0d86f17f4,
  title = {Comparison of speech elicitation tasks for machine learning-based depression classification},
  author = {Jonathan F. Bauer and Maurice Gerzcuk and Björn Wolfgang Schuller and Matthias Berking},
  year = {2024},
  doi = {10.53375/imhsc.2024.126},
