@misc{bjorn_schuller_4ec1e165944c4928,
  title = {LOW-LEVEL FUSION OF AUDIO AND VIDEO FEATURE FOR MULTI-MODAL EMOTION RECOGNITION},
  author = {Matthias Wimmer and Björn Wolfgang Schuller and Dejan Arsić and Gerhard Rigoll and Bernd Radig},
  year = {2008},
  doi = {10.5220/0001082801450151},
  url = {https://doi.org/10.5220/0001082801450151},
  howpublished = {International Conference on Computer Vision Theory and Applications},
  annotation = {中文辅助译名：用于多模态情感识别的音频和视频特征的低级融合},
  abstract = {Bimodal emotion recognition through audiovisual feature fusion has been shown superior over each individual modality in the past. Still, synchronization of the two streams is a challenge, as many vision approaches work on a frame basis opposing audio turn- or chunk-basis. Therefore, late fusion schemes such as simple logic or voting strategies are commonly used for the overall estimation of underlying affect. However, early fusion is known to be more effective in many other multimodal recognition tasks. We therefore suggest a combined analysis by descriptive statistics of audio and video Low-Level-Descriptors for subsequent static SVM Classification. This strategy also allows for a combined feature-space optimization which will be discussed herein. The high effectiveness of this approach is shown on a database of 11.5h containing six emotional situations in an airplane scenario. 1},
}

