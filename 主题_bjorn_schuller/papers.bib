@misc{bjorn_schuller_635e808dbabfdc6a,
  title = {Convolutive Non-Negative Sparse Coding and New Features for Speech Overlap Handling in Speaker Diarization},
  author = {Björn W. Schuller and Jürgen T. Geiger and Simon Bozonnet and Gerhard Rigoll and Ravichander Vipperla and Nicholas W. D. Evans},
  year = {2012},
  doi = {10.21437/INTERSPEECH.2012-575},
  url = {https://doi.org/10.21437/INTERSPEECH.2012-575},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：卷积非负稀疏编码和说话人二值化中语音重叠处理的新特征},
  abstract = {The effective handling of overlapping speech is at the limits of the current state of the art in speaker diarization.This paper presents our latest work in overlap detection.We report the combination of features derived through convolutive nonnegative sparse coding and new energy, spectral and voicingrelated features within a conventional HMM system.Overlap detection results are fully integrated into our top-down diarization system through the application of overlap exclusion and overlap labeling.Experiments on a subset of the AMI corpus show that the new system delivers significant reductions in missed speech and speaker error.Through overlap exclusion and labelling the overall diarization error rate is shown to improve by 6.4 % relative.},
}

