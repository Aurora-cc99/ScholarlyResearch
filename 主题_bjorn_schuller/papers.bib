  year = {2026},
  doi = {10.5281/zenodo.21907057},
  url = {https://doi.org/10.5281/zenodo.21907057},
  howpublished = {Zenodo (CERN European Organization for Nuclear Research)},
  annotation = {中文辅助译名：CoarseSoundNet：用于粗略音景分类的训练和目标域数据},
  abstract = {This repository contains the BEsound target-domain dataset and additional passive acoustic monitoring (PAM) datasets used in our paper CoarseSoundNet: Building a reliable model for ecological soundscape analysis (paper). CoarseSoundNet is an audio-based multi-label machine learning (ML) model which enables automated prediction of the three coarse soundscape components anthropophony, biophony, and geophony in passive acoustic monitoring (PAM) recordings. It aims to support the analysis of terrestrial ecological soundscapes. The BEsound dataset provides annotated environmental audio recordings used to evaluate the model in its target domain. The additional PAM datasets (BrPAM, BE-Ambient, and HTS-Forest) provide recordings from various terrestrial environments, while PublicMix contains synthetic soundscapes generated by mixing audio samples from publicly available sound datasets. These additional datasets were utilised to investigate the effects of different training data compositions on model performance. Dataset splits: Each dataset archive contains the audio recordings and corresponding annotation files defining the train, development, and test splits. For CoarseSoundNet, only the train and development splits of the additional PAM datasets and PublicMix were used for model training and development; their test splits are provided for completeness. The BEsound data contains the strongly labelled annotations as well as the recording-level aggregated annotations. Citation: If yo},
}

@misc{bjorn_schuller_2bfe4adeab80f729,
  title = {CoughPhase-CLR: Designing an acoustics-informed foundation model for coughing sound classification},
  author = {Marius Moldovan and Andreas Triantafyllopoulos and Thomas M. Berghaus and Björn W. Schuller and Anton Batliner},
  year = {2026},
  doi = {10.48550/ARXIV.2606.21411},
  url = {https://doi.org/10.48550/ARXIV.2606.21411},
  howpublished = {CoRR},
  annotation = {中文辅助译名：CoughPhase-CLR：设计用于咳嗽声音分类的声学基础模型},
  abstract = {In this work, we introduce CoughPhase-CLR, a self-supervised learning framework designed to leverage the physiological phases of a cough for robust representation learning. Unlike generic contrastive frameworks, CoughPhase-CLR constructs positive pairs based on these specific acoustic phases. We pre-trained our model on approximately 40 hours of public cough audio and evaluated it across five downstream tasks, including COVID-19 detection, chronic obstructive pulmonary disease (COPD) state classification, and smoker status prediction. Our results demonstrate that cough-specific pre-training consistently outperforms standard random-cropping techniques when training on cough recordings. Additionally, we benchmarked a diverse set of state-of-the-art models on COPD state classification, highlighting the difficulty of this task. The best-performing models, pretrained on either general audio or respiratory sounds, achieved a UAR of 57\%, failing to outperform the state-of-the-art performance of 84\% UAR achieved using speech analysis.},
}

@misc{bjorn_schuller_6e195299271e18a8,
