@misc{bjorn_schuller_7d81f94244a23a0c,
  title = {Developing a digital game to support cultural learning amongst immigrants},
  author = {Ian Dunwell and Petros Lameras and Craig D. Stewart and Pangiotis Petridis and Sylvester Arnab and Maurice Hendrix and Sara de Freitas and Mark Gaved and Björn Wolfgang Schuller and Lucas Paletta},
  year = {2013},
  url = {http://curve.coventry.ac.uk/open/items/91d3db93-4cf5-4b46-9efd-afaf36636cb8/1},
  howpublished = {Coventry University Open Collections (Coventry university)},
  annotation = {中文辅助译名：开发数字游戏以支持移民的文化学习},
  abstract = {Immigrants entering the European Community face a range of challenges in adapting to and understanding the culture of their host nation. Failure to address these challenges can lead to isolation and difficulties integrating into the society of the host country, leading to fragmented communities and a range of social issues. As part of a comprehensive suite of services for immigrants, the European-funded Mobile Assistance for Social Inclusion and Empowerment of Immigrants with Persuasive Learning Technologies and Social Network Services (MASELTOV) project seeks to provide both practical tools and learning services via mobile devices, providing a readily usable resource for immigrants. In this workshop paper, the game-based learning aspect of the MASELTOV project is introduced, with the rationale behind its design presented. In doing so, the benefits and implications of mobile platforms and emergent data capture techniques for game-based learning are discussed, as are the methods for putting engaging gameplay at the forefront of the experience whilst relying on rich data capture and analysis to provide an effective learning solution. Through comparison to several other projects, a number of recommendations are put forward for games deployed in contexts similar to that of MASELTOV: a focus on establishing a significant audience with which to conduct ethical research into efficacy, the need for robust pedagogical frameworks suited to the learning context, and the evolution of met},
}

@misc{bjorn_schuller_b79037528bf895b7,
