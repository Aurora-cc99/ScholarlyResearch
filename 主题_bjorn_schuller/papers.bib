}

@misc{bjorn_schuller_b8412be3acb5e78e,
  title = {Functional Aspects},
  author = {Björn Wolfgang Schuller and Anton M. Batliner},
  year = {2013},
  doi = {10.1002/9781118706664.ch5},
  url = {https://doi.org/10.1002/9781118706664.ch5},
  howpublished = {Wiley eBooks},
  annotation = {中文辅助译名：功能方面},
  abstract = {This chapter starts with the basic phenomena, which the authors have subdivided into biological trait primitives and cultural trait primitives. Then, it addresses personality and emotion. Sentiment analysis is similar to the modelling of emotion and affect in speech and language; until recently, it has been confined to written language, and has evolved rather independently of approaches used for speech. Deviant speech/language is different, due to factors such as idiosyncrasies or pathology, or to the use of a language variety that is not one's native language; another umbrella term is atypical speech. Social signals are constituted and used within communicative settings; in the default case, they are used in an honest way, that is, as agreed upon in society. However, there are different ways of discrepant communication, such as irony, sarcasm, and deceptive speech (lying).},
}

@misc{bjorn_schuller_262476602bbf0e52,
  title = {A comparative study on sparsity penalties for NMF-based speech separation: Beyond LP-norms},
  author = {Felix Weninger and David Virette and Björn W. Schuller and Cyril Joder},
  year = {2013},
  doi = {10.1109/ICASSP.2013.6637770},
  url = {https://doi.org/10.1109/ICASSP.2013.6637770},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：基于 NMF 的语音分离稀疏性惩罚的比较研究：超越 LP 范数},
  abstract = {In this work, we study the usefulness of several types of sparsity penalties in the task of speech separation using supervised and semi-supervised Nonnegative Matrix Factorization (NMF). We compare different criteria from the literature to two novel penalty functions based on Wiener Entropy, in a large-scale evaluation on spontaneous speech overlaid by realistic domestic noise, as well as music and stationary environmental noise corpora. The results show that enforcing the sparsity constraint in the separation phase does not improve the perceptual quality. In the learning phase however, it yields a better estimation of the base spectra, especially in the case of supervised NMF, where the proposed criteria delivered the best results.},
}

@misc{bjorn_schuller_4070ec699c031297,
