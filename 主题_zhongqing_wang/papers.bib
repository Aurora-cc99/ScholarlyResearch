@misc{zhongqing_wang_839a58e21a7f07e7,
  title = {Integrating Order Information and Event Relation for Script Event Prediction},
  author = {Yue Zhang and Zhongqing Wang and Ching-Yun Chang},
  year = {2017},
  doi = {10.18653/V1/D17-1006},
  url = {https://doi.org/10.18653/V1/D17-1006},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：集成订单信息和事件关系以进行脚本事件预测},
  abstract = {There has been a recent line of work automatically learning scripts from unstructured texts, by modeling narrative event chains.While the dominant approach group events using event pair relations, L-STMs have been used to encode full chains of narrative events.The latter has the advantage of learning long-range temporal orders 1 , yet the former is more adaptive to partial orders.We propose a neural model that leverages the advantages of both methods, by using LSTM hidden states as features for event pair modelling.A dynamic memory network is utilized to automatically induce weights on existing events for inferring a subsequent event.Standard evaluation shows that our method significantly outperforms both methods above, giving the best results reported so far.},
}

