@misc{guodong_zhou_3aa45f3bca23508a,
  title = {Aspect-based Sentiment Analysis via Synthetic Image Generation},
  author = {Zhongqing Wang and Guodong Zhou and Ge Chen},
  year = {2025},
  doi = {10.18653/V1/2025.FINDINGS-EMNLP.1190},
  url = {https://doi.org/10.18653/V1/2025.FINDINGS-EMNLP.1190},
  howpublished = {EMNLP (Findings)},
  annotation = {中文辅助译名：通过合成图像生成进行基于方面的情感分析},
  abstract = {Recent advancements in Aspect-Based Sentiment Analysis (ABSA) have shown promising results, yet the semantics derived solely from textual data remain limited.To overcome this challenge, we propose a novel approach by venturing into the unexplored territory of generating sentimental images.Our method introduce a synthetic image generation framework tailored to produce images that are highly congruent with both textual and sentimental information for aspect-based sentiment analysis.Specifically, we firstly develop a supervised image generation model to generate synthetic images with alignment to both text and sentiment information.Furthermore, we employ a visual refinement technique to substantially enhance the quality and pertinence of the generated images.After that, we propose a multimodal model to integrate both the original text and the synthetic images for aspect-based sentiment analysis.Extensive evaluations on multiple benchmark datasets demonstrate that our model significantly outperforms state-of-theart methods.These results highlight the effectiveness of our supervised image generation approach in enhancing ABSA.},
}

@misc{zhongqing_wang_cf45d9461498f031,
  title = {Revisiting Classical Chinese Event Extraction with Ancient Literature Information},
  author = {Xiaoyi Bao and Chu-Ren Huang and Jinghang Gu and Zhongqing Wang},
  year = {2025},
  doi = {10.18653/V1/2025.ACL-LONG.414},
  url = {https://doi.org/10.18653/V1/2025.ACL-LONG.414},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：用古代文献信息重温中国古典事件提取},
  abstract = {The research on classical Chinese event extraction trends to directly graft the complex modeling from English or modern Chinese works, neglecting the utilization of the unique characteristic of this language.We argue that, compared with grafting the sophisticated methods from other languages, focusing on classical Chinese's inimitable source of Ancient Literature could provide us with extra and comprehensive semantics in event extraction.Motivated by this, we propose a Literary Vision-Language Model (VLM) for classical Chinese event extraction, integrating with literature annotations, historical background and character glyph to capture the inner-and outer-context information from the sequence.Extensive experiments build a new state-of-the-art performance in the GuwenEE, CHED datasets, which underscores the effectiveness of our proposed VLM, and more importantly, these unique features can be obtained precisely at nearly zero cost.Our code is publicly available at https://github.com/HoraceXIaoyiBao/ ACL25-CCEE.},
}

@misc{guodong_zhou_f4a383a8451356a5,
  title = {One-Dimensional Object Detection for Streaming Text Segmentation of Meeting Dialogue},
  author = {Zhongqing Wang and Rui He and Guodong Zhou and Hua Xu and Minjie Qiang and Shuai Fan and Hongling Wang and Yifan Zhang},
  year = {2025},
  doi = {10.18653/V1/2025.FINDINGS-ACL.213},
  url = {https://doi.org/10.18653/V1/2025.FINDINGS-ACL.213},
  howpublished = {ACL (Findings)},
  annotation = {中文辅助译名：用于会议对话流文本分割的一维对象检测},
  abstract = {Dialogue text segmentation aims to partition dialogue content into consecutive paragraphs based on themes or logic, enhancing its comprehensibility and manageability.Current text segmentation models, when applied directly to STS (Streaming Text Segmentation), exhibit numerous limitations, such as imbalances in labels that affect the stability of model training, and discrepancies between the model's training tasks (sentence classification) and the actual text segmentation that limit the model's segmentation capabilities.To address these challenges, we first implement STS for the first time using a sliding window-based segmentation method.Secondly, we employ two different levels of sliding window-based balanced label strategies to stabilize the training process of the streaming segmentation model and enhance training convergence speed.Finally, by adding a one-dimensional bounding-box regression task for text sequences within the window, we restructure the training approach of STS tasks, shifting from sentence classification to sequence segmentation, thereby aligning the training objectives with the task objectives, which further enhanced the model's performance.1 Extensive experimental results demonstrate that our method is robust, controllable, and achieves state-of-the-art performance.},
}

@misc{guodong_zhou_38449751bdfa71d2,
  title = {Natural Language Explanation Generation for Question Answering},
  author = {Zhongqing Wang and Guodong Zhou and Jinghong Qu},
  year = {2025},
  doi = {10.1109/IJCNN64981.2025.11227945},
  url = {https://doi.org/10.1109/IJCNN64981.2025.11227945},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：用于问答的自然语言解释生成},
  abstract = {Large language models have achieved remarkable performance on various question answering (QA) tasks, but the explainability of their output remains challenging. To address this issue, recent work has proposed symbolic explanations called entailment trees as a way to explain and inspect a QA system’s answer. In order to improve the generation of such symbolic explanations and enhance the interpretability of the model, we introduce a new task called Question Answering Explanation Generation. This task retains the tree structure and maps symbols to natural language, aiming to generate natural language explanations from question-answer pairs. The advantage is that by generating natural language explanations, the reasoning process of the model becomes more explicit. Additionally, it abandons the requirement to precisely match relevant knowledge for all question-answer pairs, with only the question and answer considered as inputs. This makes the framework more general and applicable to real-world scenarios. Furthermore, we collected some question-answer data and used a bidirectional generation framework to construct a pseudo-dataset, which allows the model to gain a more comprehensive understanding of the association between QA and explanation. Moreover, we integrated context generation into the model’s generation process instead of providing the context directly as input to consider broader aspects and domain-specific knowledge relevant to the question and answer pair. Applying ou},
}

