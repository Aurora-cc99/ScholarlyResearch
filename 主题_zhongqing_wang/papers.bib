@misc{zhongqing_wang_7fb5e29a335c892c,
  title = {Exploring Context-Free Opinion Grammar for Aspect-Based Sentiment Analysis},
  author = {Jinghang Gu and Xiaotong Jiang and Chu-Ren Huang and Xiaoyi Bao and Zhongqing Wang},
  year = {2026},
  doi = {10.1109/TKDE.2025.3632628},
  url = {https://doi.org/10.1109/TKDE.2025.3632628},
  howpublished = {IEEE Trans. Knowl. Data Eng.},
  annotation = {中文辅助译名：探索基于方面的情感分析的上下文无关意见语法},
  abstract = {Utilizing pre-trained generative models for sentiment element extraction has recently significantly enhanced aspect-based sentiment analysis benchmarks. Nonetheless, these models have two significant drawbacks: 1) high-computational cost in both the inference time and hardware requirement. 2) Lack of explicit modeling as they model the connections between sentiment elements with fragile natural or notational language target sequence. To overcome these challenges, we present a novel opinion tree parsing model designed to swiftly parse sentiment elements from an opinion tree. This approach not only accelerates the process but also explicitly unveils a more comprehensive and fully articulated aspect-level sentiment structure. Our method begins by introducing a pioneering context-free opinion grammar to standardize the opinion tree structure. Subsequently, we leverage a neural chart-based opinion tree parser to thoroughly explore the interconnections among sentiment elements and parse them into a structured opinion tree. Extensive experiments underscore the effectiveness of our proposed model and the capability of the opinion tree parser, particularly when coupled with the introduced context-free opinion grammar. Crucially, the results confirm the superior speed of our model compared to the SOTA baselines.},
}

@misc{guodong_zhou_03234f2a416753d5,
  title = {Exploring Knowledge Filtering for Retrieval-Augmented Question Answering},
  author = {Minjie Qiang and Zhongqing Wang and Shoushan Li and Guodong Zhou},
  year = {2026},
  doi = {10.1109/taslpro.2026.3658957},
  url = {https://doi.org/10.1109/taslpro.2026.3658957},
  howpublished = {IEEE Transactions on Audio Speech and Language Processing},
  annotation = {中文辅助译名：探索检索增强问答的知识过滤},
  abstract = {Retrieval-Augmented Generation significantly enhances the performance of Large Language Models on knowledge-intensive tasks by incorporating external knowledge. However, retrieval is not always beneficial, as the presence of harmful knowledge in retrieved documents can degrade generation quality. While existing methods attempt to mitigate this by either assessing the necessity of retrieval or by compressing retrieved documents, they struggle to reject entirely harmful documents selectively. To address this, we propose a novel two-stage framework. First, we establish an annotation strategy to label the harmfulness of a document based on its impact on downstream task performance. Subsequently, our Knowledge Filtering module utilizes this annotated data to learn to identify and eliminate harmful knowledge. For this module, we develop and evaluate four distinct strategies, ranging from methods that leverage LLM self-evaluation and lightweight proxy models to those based on preference alignment. Experiments conducted on three diverse question answering datasets demonstrate that our approach effectively purges harmful knowledge, leading to more reliable and accurate responses.},
}

