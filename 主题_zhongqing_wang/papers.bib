@misc{zhongqing_wang_6e2be534da541f82,
  title = {Employing Glyphic Information for Chinese Event Extraction with Vision-Language Model},
  author = {Chu-Ren Huang and Zhongqing Wang and Minjie Qiang and Jinghang Gu and Xiaoyi Bao},
  year = {2024},
  doi = {10.18653/V1/2024.FINDINGS-EMNLP.58},
  url = {https://doi.org/10.18653/V1/2024.FINDINGS-EMNLP.58},
  howpublished = {EMNLP (Findings)},
  annotation = {中文辅助译名：利用视觉语言模型的字形信息进行中文事件提取},
  abstract = {As a complex task that requires rich information input, features from various aspects have been utilized in event extraction.However, most of the previous works ignored the value of glyph, which could contain enriched semantic information and can not be fully expressed by the pre-trained embedding in hieroglyphic languages like Chinese.We argue that, compared with combining the sophisticated textual features, glyphic information from visual modality could provide us with extra and straight semantic information in extracting events.Motivated by this, we propose a glyphic multi-modal Chinese event extraction model with hieroglyphic images to capture the intra-and inter-character morphological structure from the sequence.Extensive experiments build a new state-of-the-art performance in the ACE2005 Chinese and KBP Eval 2017 dataset, which underscores the effectiveness of our proposed glyphic event extraction model, and more importantly, the glyphic feature can be obtained at nearly zero cost.Code and data can be found at https://github.com/HoraceXIaoyiBao/ GlyphicVLM-for-ChineseEE.},
}

