@misc{guodong_zhou_b0524460ec0fa2ea,
  title = {Cross-Domain Aspect-Based Sentiment Classification With Tripartite Graph Modeling},
  author = {Ruirui Bai and Zhongqing Wang and Xiaotong Jiang and Guodong Zhou},
  year = {2024},
  doi = {10.1109/TASLP.2024.3365975},
  url = {https://doi.org/10.1109/TASLP.2024.3365975},
  howpublished = {IEEE ACM Trans. Audio Speech Lang. Process.},
  annotation = {中文辅助译名：使用三方图建模的跨域基于方面的情感分类},
  abstract = {Previous studies on cross-domain aspect-based sentiment classification depend on the pivot features or utilize the target data for representation learning, which ignores the correlations between instances and words. In this study, we employ two strategies to connect different domains through tripartite graphs. Firstly, we employ aword-topic-instance tripartite graphto bridge the gap between different domains with the cross-domain topic distribution. The cross-domain topic distribution is learned by a neural topic model on different domains. Secondly, we use aword-pivot-instance tripartite graphto connect instances and words in different domains. The pivot clauses are generated from the instances, and are domain-independent and sentimentally aligned with the original text. Afterward, we employ graph convolutional networks to model over these tripartite graphs for cross-domain sentiment classification respectively. The experimental result shows that our model with tripartite graphs outperforms several competitive models. The result also indicates the effectiveness of the proposed tripartite graphs for cross-domain aspect-based sentiment classification.},
}

@misc{zhongqing_wang_71b432c7b3b944a0,
  title = {Exploring Chain-of-Thought for Multi-modal Metaphor Detection},
  author = {Zhongqing Wang and Shichen Li and Yueying Hua and Yanzhi Xu},
  year = {2024},
  doi = {10.18653/V1/2024.ACL-LONG.6},
  url = {https://doi.org/10.18653/V1/2024.ACL-LONG.6},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：探索多模态隐喻检测的思想链},
  abstract = {Metaphors are commonly found in advertising and internet memes.However, the free form of internet memes often leads to a lack of high-quality textual data.Metaphor detection demands a deep interpretation of both textual and visual elements, requiring extensive common-sense knowledge, which poses a challenge to language models.To address these challenges, we propose a compact framework called C4MMD, which utilizes a Chain-of-Thought(CoT) method for Multi-modal Metaphor Detection.Specifically, our approach designs a three-step process inspired by CoT that extracts and integrates knowledge from Multi-modal Large Language Models(MLLMs) into smaller ones.We also developed a modality fusion architecture to transform knowledge from large models into metaphor features, supplemented by auxiliary tasks to improve model performance.Experimental results on the MET-MEME dataset demonstrate that our method not only effectively enhances the metaphor detection capabilities of small models but also outperforms existing models.To our knowledge, this is the first systematic study leveraging MLLMs in metaphor detection tasks.The code for our method is publicly available at https: //github.com/xyz189411yt/C4MMD.},
}

@misc{zhongqing_wang_1d1fac211acf447e,
  title = {Exploring Sensory Knowledge and Pre-training Language Models for Chinese Metaphor Detection},
  author = {Zhongqing Wang and Qingqing Zhao and Xue Xiang},
  year = {2024},
  doi = {10.1109/IALP63756.2024.10661181},
  url = {https://doi.org/10.1109/IALP63756.2024.10661181},
  howpublished = {IALP},
  annotation = {中文辅助译名：探索汉语隐喻检测的感官知识和预训练语言模型},
  abstract = {Processing of metaphorical languages has been one of the most challenging tasks in Natural Language Processing (NLP). Recent work utilizing neural models has received notable results on metaphor detection. However, the characteristic of metaphorical languages showing an intimate relationship with sensory experiences has not been given enough attention in NLP. This study proposes an innovative model for the task of Chinese metaphor detection by incorporating the conceptual knowledge of sensory experiences into a neural network model. Experiments show that our model outperforms the state-of-the-art baseline models significantly, hence contributing to the ongoing efforts to incorporate neuro-cognitive data in NLP tasks. In addition, the effectiveness of our model helps to deepen our understanding of metaphor that sensory experiences form the crucial part of the embodied nature of metaphorical languages.},
}

@misc{guodong_zhou_3cf41113735b34af,
  title = {Exploring Scope Detection for Aspect-Based Sentiment Analysis},
  author = {Xiaotong Jiang and Zhongqing Wang and Peiwen You and Chen Chen and Guodong Zhou},
  year = {2024},
  doi = {10.1109/TASLP.2023.3323136},
  url = {https://doi.org/10.1109/TASLP.2023.3323136},
  howpublished = {IEEE ACM Trans. Audio Speech Lang. Process.},
  annotation = {中文辅助译名：探索基于方面的情感分析的范围检测},
  abstract = {Aspect-based sentiment analysis (ABSA) aims to extract the aspect terms from review text, and to predict the polarity towards the aspect term. Although neural models have achieved competitive results, there are still many challenges in this task. Firstly, there is irrelevant and noise information in the review text, and the offsets of aspect term boundary are hard to decide. In addition, sentiment is usually either expressed implicitly or shifted due to the occurrence of negation and rhetorical words. To tackle the above limitations, we propose a scope detection model to distinguish whether the words from the review text are relevant with the aspect term, and to filter irrelevant and noise information. In addition, we investigate a biaffine-based model to constrain the scope detection process of aspect term extraction. We further generate a simplified clause based on the scope of aspect term, and predict the polarity based on the simplified clause. Empirical studies show the effectiveness of our proposed model over several strong baselines. These also justify the importance of scope detection for aspect-based sentiment analysis.},
}

@misc{zhongqing_wang_e7ef4e33c5f2c65a,
  title = {Improving Related Work Generation through Knowledge Aggregation from Citation Networks},
  author = {Mengling Han and Zhongqing Wang and Hongling Wang and Kaixin Niu},
  year = {2024},
  doi = {10.1109/IJCNN60899.2024.10650144},
  url = {https://doi.org/10.1109/IJCNN60899.2024.10650144},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：通过引文网络的知识聚合改进相关工作的生成},
  abstract = {The related work section is important in academic papers, synthesizing current research progress and contextualizing new studies. However, it is challenging to automatically generate such a section due to the complexity of citation networks and domain-specific differences. Addressing this, we introduce a novel method that employs contrastive learning to utilize the rich domain information from citation networks. Specifically, we design a Domain-Aware Related Work Generator (DAG) to aggregate domain information based on an advanced attention mechanism. This mechanism is essential for the effective combination of the related domain knowledge to the current research, ensuring that the related work generation is not only based on direct citations but also rich in contextual domain insights. Based on this mechanism, we can effectively identify and aggregate essential domain information related to the research topic. We construct a comprehensive dataset comprising various related work sections and their corresponding citation networks to validate our methodology. Our experimental results demonstrate a notable improvement over existing state-of-the-art methods, emphasizing the effectiveness of our model in generating more accurate and contextually enriched related work sections. These findings represent a significant advance in the automated generation of academically related work.},
}

@misc{guodong_zhou_a9363eda56455206,
  title = {Linguistic synesthesia detection: Leveraging culturally enriched linguistic features},
  author = {Qingqing Zhao and Yunfei Long and Xiaotong Jiang and Zhongqing Wang and Chu‐Ren Huang and Guodong Zhou},
  year = {2024},
  doi = {10.1017/nlp.2024.9},
  url = {https://doi.org/10.1017/nlp.2024.9},
  howpublished = {Natural language processing.},
  annotation = {中文辅助译名：语言联觉检测：利用文化丰富的语言特征},
  abstract = {Linguistic synesthesia as a productive figurative language usage has received little attention in the field of Natural Language Processing (NLP). Although linguistic synesthesia is similar to metaphor concerning involving conceptual mappings and showing great usefulness in the NLP tasks such as sentiment analysis and stance detection, the well-studied methods of metaphor detection cannot be applied to the detection of linguistic synesthesia directly. This study incorporates comprehensive linguistic features (i.e., character and radical information, word segmentation information, and part-of-speech tagging) into a neural model to detect linguistic synesthetic usages in a sentence automatically. In particular, we employ a span-based boundary detection model to extract sensory words. In addition, a joint model is proposed to detect the original and synesthetic modalities of the sensory words collectively. Based on the experiments, our model is shown to achieve state-of-the-art results on the dataset for linguistic synesthesia detection. The results prove that leveraging culturally enriched linguistic features and joint learning are effective in linguistic synesthesia detection. Furthermore, as the proposed model leverages non-language-specific linguistic features, the model would be applied to the detection of linguistic synesthesia in other languages.},
}

