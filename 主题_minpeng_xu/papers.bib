@misc{minpeng_xu_206569d320a1,
  title = {The Effects of the Structural and Acoustic Parameters of the Skull Model on Transcranial Focused Ultrasound},
  author = {Hao Zhang and Yanqiu Zhang and Minpeng Xu and Xizi Song and Shanguang Chen and Xiqi Jian and Dong Ming},
  year = {2021},
  doi = {10.3390/s21175962},
  url = {https://doi.org/10.3390/s21175962},
