@misc{xia_wu_cfd7b08a48d4,
  title = {CTR-Gait: Semantic-Aware Contrastive Learning for Fine-Grained Gait Emotion Recognition},
  author = {Aoshuang Ye and Chunjie Chen and Zhuo Wang and Zhujin Chen and Zhi Zhang and Rong Zhang and Wujing Cao and Xinyu Wu},
  year = {2026},
  doi = {10.1109/taffc.2026.3723033},
  url = {https://doi.org/10.1109/taffc.2026.3723033},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：CTR-Gait：用于细粒度步态情感识别的语义感知对比学习},
  abstract = {As a spontaneous non-intrusive biometric cue, gait conveys reliable affective information. However, the subtle and fine-grained motion of joints makes gait emotion recognition more challenging than general emotion recognition, particularly under the constraints of dataset scarcity and the high complexity of extracting discriminative cues from subtle motions. While existing models demonstrate competitive performance, they often do not account for the inherent heterogeneity of the dataset. Specifically, data from different acquisition devices exhibit clear cross-modality variations, which complicate the development of a unified emotion representation. In this work, we present CTR-Gait, a single-stream network designed for semantic-aware and fine-grained gait emotion recognition. The backbone integrates Channel-wise Topology Refined graph convolutions with Temporal Transformers to capture dynamic spatial correlations and global temporal dependencies. To structure the affective feature space, we introduce Emotion-Semantic Contrastive Learning (ESCL), which utilizes learnable Valence-Arousal centers to achieve semantically consistent emotion clustering. Furthermore, to tackle the inherent ambiguity in distinguishing subtle negative emotions, we design a specialized SadExpert module that dynamically refines predictions for the minority class. With 3.76 M parameters and 0.56 GFLOPs, CTR-Gait achieves 92.66% accuracy on the Emotion-Gait benchmark, surpassing existing state-of-the-art},
}

@misc{xia_wu_27036fbf12c9,
