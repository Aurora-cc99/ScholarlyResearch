@misc{xia_wu_71ae6e63c6f62da2,
  title = {Reduced Connexin26 in the Mature Cochlea Increases Susceptibility to Noise-Induced Hearing Loss in Mice},
  author = {Xingxing Zhou and Sen Chen and Le Xie and Yu-Zi Ji and Xia Wu and Wenwen Wang and Qi Yang and Jintao Yu and Yu Sun and Xi Lin and Weijia Kong},
  year = {2016},
  doi = {10.3390/ijms17030301},
  url = {https://doi.org/10.3390/ijms17030301},
  howpublished = {International Journal of Molecular Sciences},
  annotation = {中文辅助译名：成熟耳蜗中连接蛋白26的减少会增加小鼠对噪音引起的听力损失的敏感性},
  abstract = {Connexin26 (Cx26, encoded by GJB2) mutations are the most common cause of non-syndromic deafness. GJB2 is thought to be involved in noise-induced hearing loss (NIHL). However, the role of Cx26 in NIHL is still obscure. To explore the association between Cx26 and NIHL, we established a Cx26 knockdown (KD) mouse model by conditional knockdown of Cx26 at postnatal day 18 (P18), and then we observed the auditory threshold and morphologic changes in these mice with or without noise exposure. The Cx26 KD mice did not exhibit substantial hearing loss and hair cell degeneration, while the Cx26 KD mice with acoustic trauma experienced higher hearing loss than simple noise exposure siblings and nearly had no recovery. Additionally, extensive outer hair cell loss and more severe destruction of the basal organ of Corti were observed in Cx26 KD mice after noise exposure. These data indicate that reduced Cx26 expression in the mature mouse cochlea may increase susceptibility to noise-induced hearing loss and facilitate the cell degeneration in the organ of Corti.},
}

@misc{bin_hu_c97e5ae8fbf630c4,
  title = {Multimodal Classification of Mild Cognitive Impairment Based on Partial Least Squares},
  author = {Pingyue Wang and Alzheimer’s Disease Neuroimaging Initiative and Kewei Chen and Li Yao and Bin Hu and Xia Wu and Jiacai Zhang and Qing Ye and Xiaojuan Guo},
