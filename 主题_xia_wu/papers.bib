  abstract = {Driven by the increasing needs for condition monitoring and maintaining stable operation using process data, a multi-sensor data fusion method based on adaptive weighting strategy using analytic hierarchy process (AHP) algorithm and cross-correlation function fusion (CCFF) algorithm is proposed in this paper. On this basis, a health index (HI) is developed based on the distance using the time-domain characteristic value of the fused vibration signals. By considering the location of sensors and data relevance, the weight coefficients could be more reasonable. The effectiveness of the proposed condition monitoring method is demonstrated by a case study from a three-plunger reciprocating pump in the industrial field, and the test results show its advantage in operation monitoring and abnormal detection},
}

@misc{xia_wu_3e32de7a8026,
  title = {Supervised Feature Selection With Orthogonal Regression and Feature Weighting},
  author = {Xia Wu and Xueyuan Xu and Jianhong Liu and Hailing Wang and Bin Hu and Feiping Nie},
  year = {2021},
  doi = {10.1109/tnnls.2020.2991336},
