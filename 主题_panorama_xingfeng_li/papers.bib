@misc{panorama_xingfeng_li_c5cc265a10cdf3ed,
  title = {A two-tiered reliable application layer multicast},
  author = {Zhang Xinchang and Meihong Yang and Guanggang Geng and Wanming Luo and Xingfeng Li},
  year = {2011},
  doi = {10.2298/csis101223034x},
  url = {https://doi.org/10.2298/csis101223034x},
  howpublished = {Computer Science and Information Systems},
  annotation = {中文辅助译名：两层可靠应用层组播},
  abstract = {This paper presents a two-tiered reliable application layer multicast (ALM) solution, called HRALM, to provide lossless ALM services. HRALM builds a domain-based multicast tree, and divides the members into two transport planes (i.e., Plane 1 and Plane 2) in terms of the tree. In any domain, the distance between each member and the domain header is below a given threshold, which improves the capability of topology-awareness. According to the loss detected by members in different planes, HRALM adopts different but correlated recovery solutions. In HRALM, a member duplicates and forwards the received recovery packet to each of its children if it has not received the data unit carried by the recovery packet before receiving the recovery packet, which can actively recover the loss at the downstream nodes. The simulation experiments show that HRALM has desirable transport and recovery performance.},
}

@misc{panorama_xingfeng_li_02fa82d13e4ef2e8,
  title = {TCP Performance Analysis and Improvement in FMIPv6},
  author = {Wang Yi-zhi and Xingfeng Li},
  year = {2008},
  doi = {10.1109/icact.2008.4494072},
  url = {https://doi.org/10.1109/icact.2008.4494072},
  howpublished = {International Conference on Advanced Communication Technology},
  annotation = {中文辅助译名：FMIPv6 中的 TCP 性能分析和改进},
  abstract = {TCP is a popular Internet protocol for reliable end-to-end data delivery. However, the protocol is designed based on wired link, so it is not suitable for mobile network. The main problem is that the frequent handover of mobile nodes may cause poor TCP performance. In order to eliminate the inefficiency of TCP in mobile environment, a modified TCP scheme for improving its performance, named as MTCP, is proposed in great detail. Experimental evaluation shows that the modified TCP algorithm can improve the throughout and the utilization of network bandwidth with good friendliness.},
}

@misc{panorama_xingfeng_li_ac956f9975add6ec,
  title = {A Novel IPv6 Networks Measuring Algorithm for Locating Available Bandwidth Bottleneck},
  author = {Xingfeng Li and Wang Yi-zhi and Wanming Luo},
  year = {2007},
  doi = {10.1109/icact.2007.358573},
  url = {https://doi.org/10.1109/icact.2007.358573},
  howpublished = {International Conference on Advanced Communication Technology},
  annotation = {中文辅助译名：一种用于定位可用带宽瓶颈的新型 IPv6 网络测量算法},
  abstract = {Available bandwidth is an important metric for fast, accurate, and effective estimation of current network conditions. Accurate measurement of the network available bandwidth characteristic has been an active area for the Internet researchers and telecom operators. Generally, the researchers pay more attention to the end-to-end available bandwidth, while neglecting the study on locating available bandwidth bottleneck. In addition, although there are many existing methods for measuring available bandwidth in IPv4 networks, few of them are related to the next generation Internet. In the last few years, the rapid development and extensive deployment of IPv6 networks make it important to accurately characterize the available bandwidth property of IPv6 networks. This paper proposes an IPv6 networks measurement algorithm for locating available bandwidth bottleneck, which allows end users to efficiently and accurately locate the IPv6 networks bottleneck link. Experimental evaluation shows that our algorithm is accurate, flexible and able to work in uncooperative environments. We are currently experimenting over different network environments to gain more experience and to further validate and improve the measurement technique.},
}

@misc{panorama_xingfeng_li_d4cd803fb7b54baa,
  title = {Identification of Tritileymus Translocation Line with Stripe Rust Resistance},
  author = {Lu Wen and Xiaohu Lin and Xingfeng Li and Liming Wang and Chen Yinchu and Honggang Wang},
  year = {2005},
  url = {https://europepmc.org/abstract/CBA/466334},
  howpublished = {Europe PMC (PubMed Central)},
  annotation = {中文辅助译名：抗条锈病小麦易位系的鉴定},
  abstract = {A Tritileymus germplasm line, Shannong 0096, with useful agronomic characteristics and good resistance to stripe rust, was selected from the progeny of Octoploid Tritileymus and common wheat.The cytological results showed that the chromosome number of Shannong 0096 in root tip cell was 2n=42, its chromosome configuration at PMC MⅠ was 2n=21Ⅱ, and mean chromosome configuration of hybrids F 1 between it and wheat parent at PMC MⅠ was 2n=19Ⅱ+ 1Ⅳ. The random amplified polymorphic DNA (RAPD) analysis was made in the Shannong 0096.Among 100 random primers, 3 primers were revealed specific DNA bands of Leymus mollis designated as S24 1250 ,S38 750 ,S42 640 respectively.Therefore Shannong 0096 can be primarily identified as a Tritileymus translocation Line.The results of genome in situ hybridization(GISH) with the probe of Leymus mollis genome DNA, further proved that Shannong 0096 is a wheat-Leymus mollis translocation line with small fragment.},
}

