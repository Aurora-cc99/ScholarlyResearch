}

@misc{ming_liu_3af54b0fb70040c7,
  title = {Formation and annihilation of Cu conductive filament in the nonpolar resistive switching Cu/ZrO2: Cu/Pt ReRAM},
  author = {Ming Liu and Qi Liu and Shibing Long and Weihua Guan},
  year = {2010},
  doi = {10.1109/ISCAS.2010.5537156},
  url = {https://doi.org/10.1109/ISCAS.2010.5537156},
  howpublished = {ISCAS},
  annotation = {中文辅助译名：非极性阻变Cu/ZrO2：Cu/Pt ReRAM中Cu导电丝的形成与湮灭},
  abstract = {We report a ZrO2-based resistive memory composed of a thin Cu doped ZrO2layer sandwiched between Pt bottom and Cu top electrode. The Cu/ZrO2:Cu/Pt shows excellent nonpolar resistive switching behaviors, such as free-electroforming, high ON/OFF resistance ratio (106), fast Set/Reset speed (50 ns/100 ns), and reliable data retention (>10 years). The temperature-dependent switching characteristics show that a metallic filamentary channel is responsible for the low resistance state. Further analysis reveals that the physical origin of this metallic filament is the nanoscale Cu conductive filament. On this basis, we propose that the set process and the reset process stem from the electrochemical reactions in the filament, in which a thermal effect is greatly involved.},
}

@misc{ming_liu_dd3cec87f45f6003,
  title = {Highly Stable Radiation-Hardened Resistive-Switching Memory},
  author = {Yan Wang and Hangbing Lv and Wei Wang and Qi Liu and Shibing Long and Qin Wang and Zongliang Huo and Sen Zhang and Yingtao Li and Qingyun Zuo and Wen-Tai Lian and Jianhong Yan and Ming Liu},
  year = {2010},
  doi = {10.1109/led.2010.2081340},
  url = {https://doi.org/10.1109/led.2010.2081340},
  howpublished = {IEEE Electron Device Letters},
  annotation = {中文辅助译名：高度稳定的抗辐射电阻开关存储器},
  abstract = {In this letter, the resistive random access memory (RRAM) with metal–insulator–metal structure is investigated for the first time under radiation conditions. The fabricated Cu-doped$\hboxHfO_2$-based RRAM devices are found to have immunity from$^60\hboxCo\ \gamma$ray of various dose ranges. The basic RRAM parameters such as high-resistance state, low-resistance state, SET/RESET voltages, operation speed, and endurance have nearly no degradation after$^60\hboxCo\ \gamma$ray treatment with a total dose as high as$\hbox3.6 \times \hbox10^5\ \hboxrad$(Si). Furthermore, a retention characteristic of$\hbox10^5$s is also achieved during radiation. The highly stable characteristics of Cu-doped$\hboxHfO_2$-based RRAM devices under radiation provide RRAM a great potential for aerospace and nuclear applications.},
}

@misc{ming_liu_71b74f1130f24f2b,
  title = {Low-Power and Highly Uniform Switching in $ \hboxZrO_2$-Based ReRAM With a Cu Nanocrystal Insertion Layer},
  author = {Qi Liu and Shibing Long and Wei Wang and Sansiri Tanachutiwat and Yingtao Li and Qin Wang and Manhong Zhang and Zongliang Huo and Junning Chen and Ming Liu},
  year = {2010},
  doi = {10.1109/led.2010.2070832},
  url = {https://doi.org/10.1109/led.2010.2070832},
  howpublished = {IEEE Electron Device Letters},
  annotation = {中文辅助译名：具有 Cu 纳米晶体插入层的基于 $ \hboxZrO_2$ 的 ReRAM 中的低功耗和高度均匀开关},
  abstract = {In this letter, the insertion of a Cu nanocrystal (NC) layer between the Pt electrode and$\hboxZrO_2$film is proposed as an effective method to improve resistive switching properties in the$\hboxZrO_2$-based resistive switching memory. This Cu/$\hboxZrO_2$:Cu/Cu NC/Pt memory exhibits asymmetric nonpolar resistive switching behavior, low operating voltage ($<$1.2 V), low Reset current$(< \hbox50\ \mu\hboxA)$, and high uniformity of resistance switching. The switching mechanism is believed to be related with the formation and rupture of conductive filament. The NC-induced electrical field enhancement has the benefit to accelerate and control the CF formation process, thus leading to low-switching threshold voltage and high uniformity.},
}

@misc{ming_liu_d0a4da33239eca98,
  title = {Controllable Growth of Nanoscale Conductive Filaments in Solid-Electrolyte-Based ReRAM by Using a Metal Nanocrystal Covered Bottom Electrode},
  author = {Qi Liu and Shibing Long and Hangbing Lv and Wei Wang and Jiebin Niu and Zongliang Huo and Junning Chen and Ming Liu},
  year = {2010},
  doi = {10.1021/nn1017582},
  url = {https://doi.org/10.1021/nn1017582},
  howpublished = {ACS Nano},
  annotation = {中文辅助译名：使用金属纳米晶体覆盖底部电极在基于固体电解质的 ReRAM 中控制纳米级导电丝的生长},
  abstract = {Resistive memory (ReRAM) based on a solid-electrolyte insulator is a promising nanoscale device and has great potentials in nonvolatile memory, analog circuits, and neuromorphic applications. The underlying resistive switching (RS) mechanism of ReRAM is suggested to be the formation and rupture of nanoscale conductive filament (CF) inside the solid-electrolyte layer. However, the random nature of the nucleation and growth of the CF makes their formation difficult to control, which is a major obstacle for ReRAM performance improvement. Here, we report a novel approach to resolve this challenge by adopting a metal nanocrystal (NC) covered bottom electrode (BE) to replace the conventional ReRAM BE. As a demonstration vehicle, a Ag/ZrO(2)/Cu NC/Pt structure is prepared and the Cu NC covered Pt BE can control CF nucleation and growth to provide superior uniformity of RS properties. The controllable growth of nanoscale CF bridges between Cu NC and Ag top electrode has been vividly observed by transmission electron microscopy (TEM). On the basis of energy-dispersive X-ray spectroscopy (EDS) and elemental mapping analyses, we further confirm that the chemical contents of the CF are mainly Ag atoms. These testing/metrology results are consistent with the simulation results of electric-field distribution, showing that the electric field will enhance and concentrate on the NC sites and control location and orientation of Ag CFs.},
}

@misc{ming_liu_094c7924debf7d1f,
  title = {Performance enhancement of multilevel cell nonvolatile memory by using a bandgap engineered high-κ trapping layer},
  author = {Chenxin Zhu and Zongliang Huo and Zhongguang Xu and Manhong Zhang and Qin Lin Wang and Jing Liu and Shibing Long and Ming Liu},
  year = {2010},
  doi = {10.1063/1.3531559},
  url = {https://doi.org/10.1063/1.3531559},
  howpublished = {Applied Physics Letters},
  annotation = {中文辅助译名：通过使用带隙工程高κ捕获层增强多级单元非易失性存储器的性能},
  abstract = {A high-κ based charge trap flash (CTF) memory structure using bandgap engineered trapping layer HfO2/Al2O3/HfO2 (HAH) has been demonstrated for multilevel cell applications. Compared to a single HfO2 trapping layer, a CTF memory device based on the HAH trapping layer exhibits a larger memory window of 9.2 V, faster program/erase speed, and significantly improved data retention. Enhancements of memory performance and reliability are attributed to the modulation of charge distribution by bandgap engineering in trapping layer. The findings provide a guide for future design of CTF.},
}

@misc{ming_liu_57a0ea4eb6c07a77,
  title = {A low power single ended input differential output low noise amplifier for L1/L2 band},
  author = {Yonghui Ji and Ming Liu and Qin Wang and Shibing Long and Zhaoan Yu and Manhong Zhang},
  year = {2010},
  doi = {10.1109/ISCAS.2010.5537957},
  url = {https://doi.org/10.1109/ISCAS.2010.5537957},
  howpublished = {ISCAS},
  annotation = {中文辅助译名：一种用于L1/L2频段的低功耗单端输入差分输出低噪声放大器},
  abstract = {A 1.2~1.6 GHz low power single-ended input to differential output low noise amplifier for Global Navigation Satellite System (GNSS, such as GPS, Galileo, China Compass, etc.) is proposed in the paper. A new current-reused technique with mismatch adjustment is adopted to achieve low power, low noise factor, high voltage gain and low mismatch simultaneously. The LNA is fabricated in TSMC 0.18 μm RF CMOS process, with only 2 mA current consumption under 1.8 V supply. The LNA exhibits a differential voltage gain of 27-30 dB, a noise figure of 2.4-3.0 dB and gain mismatch less than 0.5 dB.},
}

@misc{ming_liu_5dd8cf23f6869a4a,
  title = {Spiral photon sieves apodized by digital prolate spheroidal window for the generation of hard-x-ray vortex},
  author = {Changqing Xie and Xiaoli Zhu and Lina Shi and Ming Liu},
  year = {2010},
  doi = {10.1364/ol.35.001765},
  url = {https://doi.org/10.1364/ol.35.001765},
  howpublished = {Optics Letters},
  annotation = {中文辅助译名：用于产生硬 X 射线涡旋的数字长球体窗口变迹螺旋光子筛},
  abstract = {We extend the work of photon sieves to spiral photon sieves (SPSs) for the generation of a hard-x-ray vortex. A robust digital prolate spheroidal window, which has an optimal energy concentration at low frequencies, was used to adjust the number of pinholes on each ring of the SPS. It was demonstrated that an SPS has better spatial resolution and lower background than a spiral zone plate using the specified smallest structures condition. The intensity at the center of the dark core is difficult to damp to true zero, primarily owing to current limitations of high-aspect-ratio metal nanostructures. The diameter of the dark core increases as the charge value increases. However, the FWHM of the doughnut-shaped ring and background will also increase. Our results pave the way toward the design of high-performance SPSs for the generation of a hard-x-ray vortex.},
}

@misc{ming_liu_e1102a29c5383dd2,
  title = {A metal/Al2O3/ZrO2/SiO2/Si (MAZOS) structure for high-performance non-volatile memory application},
  author = {Jing Liu and Qin Lin Wang and Shibing Long and Manhong Zhang and Ming Liu},
  year = {2010},
  doi = {10.1088/0268-1242/25/5/055013},
  url = {https://doi.org/10.1088/0268-1242/25/5/055013},
  howpublished = {Semiconductor Science and Technology},
  annotation = {中文辅助译名：用于高性能非易失性存储器应用的金属/Al2O3/ZrO2/SiO2/Si (MAZOS)结构},
  abstract = {In this paper, we report a metal/Al2O3/ZrO2/SiO2/Si (MAZOS) structure with a ZrO2 charge-trapping layer for non-volatile memory application. The superiority of this device over the traditional metal/Al2O3/Si3N4/SiO2/Si (MANOS) devices is much better data retention and enhanced program/erase efficiency. The MAZOS device exhibits excellent memory characteristics, including a large memory window of 7.1 V under ±11 V capacitance–voltage sweep, and a greatly improved data retention (only 16% charge loss for 10 years time) along with good endurance. The MAZOS device has a strong potential for future high-performance non-volatile memory application.},
}

