@misc{ming_liu_eceebd7e99488f9f,
  title = {14.1 THz-TSI: A 0.33pJ/b 264Gb/s Through-Silicon Interconnect Module for 3D Integration Utilizing Terahertz Coupling},
  author = {Chen Jiang and Xiaodi Feng and Xiaohan Shen and Chixiao Chen and Qi Liu and Ming Liu and Ningsheng Xu},
  year = {2026},
  doi = {10.1109/ISSCC49663.2026.11409040},
  url = {https://doi.org/10.1109/ISSCC49663.2026.11409040},
  howpublished = {ISSCC},
  annotation = {中文辅助译名：14.1 THz-TSI：0.33pJ/b 264Gb/s 硅通互连模块，利用太赫兹耦合进行 3D 集成},
  abstract = {A through-silicon interconnect module for 3D integration utilizing THz coupling is presented, which achieves a record high data rate of$264 ~\textGb / \mathrms$and efficiency of$0.33 \textpJ / \mathrmb$. Both bidirectional point-to-point link and broadcast mode are successfully demonstrated. This scheme offers highly competitive bandwidth and density with significantly simpler fabrication and lower cost. Furthermore, its high flexibility enables real-time adjustable interconnect topology to effectively reduce latency.},
}

@misc{ming_liu_20477d66e4c422df,
  title = {30.6 A 16Mb 166.8TOPS/W Near-Memory Phase-Domain-Computing Ferroelectric NAND Flash for Approximate Nearest Neighbor Search on Edge Devices},
  author = {Weizeng Li and Bohan Wang and Zhidao Zhou and Junyu Zhu and Zhi Li and Junzhe Shen and Wenfeng Zha and Zhongze Han and Yiman Wang and Linfang Wang and Hongyang Hu and Qing Luo and Chunmeng Dou and Ming Liu},
  year = {2026},
  doi = {10.1109/ISSCC49663.2026.11409218},
  url = {https://doi.org/10.1109/ISSCC49663.2026.11409218},
  howpublished = {ISSCC},
  annotation = {中文辅助译名：30.6 A 16Mb 166.8TOPS/W 近内存相域计算铁电 NAND 闪存，用于边缘设备上的近似最近邻搜索},
  abstract = {Previous near-memory computing (NMC) or in-memory-computing (IMC) NANDs suffers from limited IO width, large energy-delay-product, and an inability to support diverse vector formats. This work presents a fabricated 16Mb near-memory phase-domain-computing (NM-PDC) FeNAND chip can compute the 512 similarity distances between 256-dimensional 4b vectors in a single search operation, achieving 166.8TOPS/W energy efficiency and a$12.8 \times$reduction in end-to-end search latency.},
}

@misc{ming_liu_b2e0815d844339f2,
  title = {A 96 × 64 SPAD LiDAR Sensor With 6× Imaging FoM Promotion by AI-Assisted Fusion of 2-D and Edge-Guided Sparse 3-D Detection},
  author = {Bu Chen and Qi Zheng and Zikun Cai and Hankun Lv and Jingyi Wang and Jun Han and Zhangcheng Huang and Jianlu Wang and Qi Liu and Ming Liu},
  year = {2026},
  doi = {10.1109/JSSC.2026.3714508},
  url = {https://doi.org/10.1109/JSSC.2026.3714508},
  howpublished = {IEEE J. Solid State Circuits},
  annotation = {中文辅助译名：96 × 64 SPAD LiDAR 传感器，通过 AI 辅助融合 2D 和边缘引导稀疏 3D 检测，实现 6 倍成像 FoM 提升},
  abstract = {Flash-mode direct time-of-flight (dToF) light detection and ranging (LiDAR) is widely adopted in autonomous systems and robotics due to its capability for accurate depth measurement and robustness under challenging lighting conditions. However, scaling single-photon avalanche diode (SPAD)-based dToF pixel arrays toward higher resolution 3-D imaging introduces significant challenges in power consumption and on-chip data handling, particularly when large-volume time-correlated single-photon counting (TCSPC) data are uniformly acquired and processed. This work presents a$96\times 64$SPAD-based flash LiDAR sensor employing a dual-mode sensing architecture that combines full-resolution 2-D intensity detection with on-chip edge-guided sparse 3-D depth detection. An on-chip edge extraction circuit (EEC) identifies structurally salient regions from the 2-D intensity map and guides pixel-level skipping during 3-D detection, thereby concentrating time-of-flight (ToF) measurements on informative areas while avoiding unnecessary full-array activation and excessive TCSPC readout. The resulting sparse 3-D depth maps are fused with dense 2-D intensity maps using a multi-modal, AI-assisted reconstruction network, demonstrating that the retained measurements are sufficient to recover full-field depth information. By co-designing on-sensor data acquisition and AI-assisted reconstruction, the proposed architecture reduces the effective 3-D data volume by 87.5% and significantly lowers readout a},
}

@misc{ming_liu_0eedd6be0941753e,
  title = {A 128×96 Multimodal Flash LiDAR SPAD Imager with Object Segmentation Latency of 18μs Based on Compute-Near-Sensor Ising Annealing Machine},
  author = {Jingyi Wang and Tao Hong and Bu Chen and Zhangcheng Huang and Qi Liu and Ming Liu},
  year = {2026},
  doi = {10.1109/ISSCC49663.2026.11409325},
  url = {https://doi.org/10.1109/ISSCC49663.2026.11409325},
  howpublished = {ISSCC},
  annotation = {中文辅助译名：基于计算近传感器 Ising 退火机的 128×96 多模态 Flash LiDAR SPAD 成像仪，目标分割延迟为 18μs},
  abstract = {This paper presents a$128 \times 96$multimodal flash LiDAR SPAD imager integrated with a compute-near-sensor Ising-model annealing processor for dynamic object segmentation, framed as a combinatorial optimization problem (COP). The system enables real-time updates of Hamiltonian coefficients using a high-bandwidth output-while-write scheme, and accelerates Ising spin iterations by exploiting multimodal SPAD information, achieving a segmentation latency of$18 \mu \mathrms$.},
}

@misc{ming_liu_ca304c4325091095,
  title = {A Fully Integrated Constant-Current Switch-Capacitor Neuromodulator with 2.5D-Integrated Spike Sorting ASIC for Responsive Neurostimulation},
  author = {Youzhi Huang and Hao Jiang and Chixiao Chen and Yingping Chen and Qi Liu and Ming Liu},
  year = {2026},
  doi = {10.1109/CICC65509.2026.11509534},
  url = {https://doi.org/10.1109/CICC65509.2026.11509534},
  howpublished = {CICC},
  annotation = {中文辅助译名：具有 2.5D 集成尖峰排序 ASIC 的完全集成恒流开关电容器神经调节器，用于响应性神经刺激},
  abstract = {A fully integrated constant-current switch-capacitor (FICS) neuromodulator is presented for responsive neuromodulation (RNS). To break the bottleneck encountered in traditional switch-capacitor (SC) stimulation, FICS neuromodulator is constructed with soft-charging SC topology, achieving efficient constant-current modulation. An automatic low-voltage/high-voltage mode transition is realized to enhance the charge injection capacity. Further, an active charge balancing scheme swiftly mitigates the charge accumulation effect, improving the safety. Fabricated in a 180nm high-voltage process, the in-vitro measurements demonstrate that the design accomplishes 10V-compliant 3mA constant-current stimulation with a peak efficiency of 84.1%, attaining a real-time charge balance with an error of ±10mV. Moreover, the designed FICS neuromodulator is 2.5D integrated with a spike sorting ASIC, achieving online neuromodulation with a response latency of 185µs.},
}

@misc{ming_liu_df55b55d60658cac,
  title = {A 28-nm Computing-in-Memory Processor With Zig-Zag Backbone-Systolic CIM and Block-/Self-Gating CAM for NN/Recommendation Applications},
  author = {Shengzhe Yan and Zhuoyu Dai and Zhaori Cong and Zeyu Guo and Yifan He and Wenyu Sun and Chunmeng Dou and Feng Zhang and Jinshan Yue and Yongpan Liu and Ming Liu},
