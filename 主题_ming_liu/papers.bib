  year = {2017},
  doi = {10.1109/CICC.2017.7993685},
  url = {https://doi.org/10.1109/CICC.2017.7993685},
  howpublished = {CICC},
  annotation = {中文辅助译名：0.13μm 64Mb HfOx ReRAM 采用可配置的斜坡电压写入和低读取干扰传感技术来提高可靠性},
  abstract = {This paper presents a 0.13μm 64Mb HfOxReRAM for embedded storage in IoT device. The configurable ramped voltage write and low read-disturb sensing techniques are proposed to address the reliability challenges in ReRAM. Experimental results show that, the ReRAM chip achieves more than 107 cycles' endurance and 10 years' retention at 75°C. In addition, its full function and superior random write performance are demonstrated on a developed evaluation board.},
}

@misc{ming_liu_1b6920a05941caab,
  title = {A 130nm 1Mb HfOx embedded RRAM macro using self-adaptive peripheral circuit system techniques for 1.6X work temperature range},
  author = {Feng Zhang and Dongyu Fan and Yuan Duan and Jin Li and Cong Fang and Yun Li and Xiaowei Han and Lan Dai and Cheng-Ying Chen and Jinshun Bi and Ming Liu and Meng-Fan Chang},
