@misc{panorama_a0790557b9ad_9aa68bc17a5f2a0a,
  title = {MHCL: Multi-modal Hierarchical Contrastive Learning for Physiological Signal-Based Vigilance Detection},
  author = {Yucheng Liu and Gaoyan Zhang},
  year = {2026},
  doi = {10.1109/jbhi.2026.3695698},
  url = {https://doi.org/10.1109/jbhi.2026.3695698},
