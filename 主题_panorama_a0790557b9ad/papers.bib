@misc{panorama_a0790557b9ad_6b1b8a58e360,
  title = {CIRE: A Chinese EEG Dataset for decoding speech intention modulated by prosodic emotion},
  author = {Shengrui He and Zhongjie Li and Jianwu Dang and Yingyi Luo and Gaoyan Zhang},
  year = {2025},
  doi = {10.1038/s41597-025-05957-y},
  url = {https://doi.org/10.1038/s41597-025-05957-y},
  howpublished = {Scientific Data},
  annotation = {中文辅助译名：CIRE：用于解码由韵律情感调制的语音意图的中国脑电图数据集.. Sci Data},
  abstract = {Neural decoding of speech intention could advance the development and application of brain-computer interface (BCI) technology. Currently, lack of dataset limited the research on decoding the true speech intention, especially the diverse intentions expressed by the same text when no context is given. This study provides an EEG dataset, CIRE, on spoken language interaction intention featuring aligned textual expressions with divergent intentional meanings due to the differences in prosodic emotion. The dataset comprises preprocessed high-density (128-channel) EEG recordings from 38 participants engaged in comprehension of attitude-conveying speech stimuli, accompanied by Wav2vec2-derived acoustic embeddings of the listening materials. To validate our dataset through cognitive neuroscience studies and binary intent classification, we applied signal processing pipelines, cognitive analysis frameworks, and machine learning (ML) approaches. Our baseline model achieved a cross-subject classification accuracy of 68.2%, with differences exhibiting interpretable neurophysiological correlates. The high-density and high temporal resolution EEG data offer broader application areas, both in cognitive neuroscience and speech BCI, and can also contribute to the brain-inspired algorithms.},
}

@misc{panorama_a0790557b9ad_18f5f3ebde133635,
  title = {Bi-Directional Oscillatory Interaction in the Neural Networks Engaged in Sentence Oral Reading},
  author = {Bin Zhao and Gaoyan Zhang and Jianwu Dang and Aijun Li},
  year = {2024},
  doi = {10.1109/iscslp63861.2024.10800174},
  url = {https://doi.org/10.1109/iscslp63861.2024.10800174},
  howpublished = {International Symposium on Chinese Spoken Language Processing (ISCSLP)},
  annotation = {中文辅助译名：句子口语阅读中神经网络的双向振荡相互作用},
  abstract = {This study delves into the neural oscillatory dynamics accountable for the bidirectional interaction in oral sentence reading. Through a multifaceted methodology encompassing EEG, eye-tracking, and speech data analyses, it examines the functional networks related to visual processing, semantic interpretation, speech production, and auditory feedback. The key findings spotlight a rhythmic oscillatory architecture that synchronizes with the initiation of eye movements and speech articulation, characterized by specific temporal onsets. Theta-gamma coupling emerges as crucial in the neural synchronization process between visual stimuli and semantic interpretation, governing the interaction of bottom-up and top-down signals in both directions. Alpha and beta band inhibitory activity is also conspicuous, especially in the dorsal stream, which is involved in speech motor planning and execution. The delineated oscillatory profiles facilitate the bidirectional exchange of information between the ventral and dorsal streams, providing a holistic model for understanding the neural substrates of oral sentence reading.},
}

@misc{panorama_a0790557b9ad_1497aba8a0629c56,
  title = {Enhancing Major Depressive Disorder Diagnosis With Dynamic-Static Fusion Graph Neural Networks},
  author = {Tianyi Zhao and Gaoyan Zhang},
  year = {2024},
  doi = {10.1109/jbhi.2024.3395611},
  url = {https://doi.org/10.1109/jbhi.2024.3395611},
  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：利用动静态融合图神经网络增强重度抑郁症的诊断},
  abstract = {Major Depressive Disorder (MDD) is a debilitating, complex mental condition with unclear mechanisms hindering diagnostic progress. Research links MDD to abnormal brain connectivity using functional magnetic resonance imaging (fMRI). Yet, existing fMRI-based MDD models suffer from limitations, including neglecting dynamic network traits, lacking interpretability, and struggling with small datasets. We present DSFGNN, a novel graph neural network framework addressing these issues for improved MDD diagnosis. DSFGNN employs a graph isomorphism encoder to model static and dynamic brain networks, achieving effective fusion of temporal and spatial information through a spatiotemporal attention mechanism, thereby enhancing interpretability. Furthermore, we incorporate a causal disentangling module and orthogonal regularization module to augment the model's expressiveness. We evaluate DSFGNN on the Rest-meta-MDD dataset, yielding superior results compared to the best baseline. Besides, extensive ablation studies and interpretability analysis confirm DSFGNN's effectiveness and potential for biomarker discovery.},
}

@misc{panorama_a0790557b9ad_c899a34bd1cb83d9,
  title = {EEG-Based Fast Auditory Attention Detection in Real-Life Scenarios Using Time-Frequency Attention Mechanism},
  author = {Zhuang Xie and Jianguo Wei and Wenhuan Lu and Zhongjie Li and Chunli Wang and Gaoyan Zhang},
  year = {2024},
  doi = {10.1109/icassp48485.2024.10445805},
  url = {https://doi.org/10.1109/icassp48485.2024.10445805},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：使用时频注意力机制在现实场景中基于脑电图的快速听觉注意力检测},
  abstract = {Auditory attention detection (AAD) based on electroencephalogram (EEG) helps recognize the target speaker in a cocktail party scenario, advancing auditory brain-computer interface development. Previous EEG studies on AAD were largely based on data collected in laboratory settings. In this study, we investigated the AAD with EEG data collected when subjects were walking and sitting in real-life scenarios. To improve the detection accuracy, we proposed the time-frequency attention mechanism to the convolution neural network on EEG data. Experimental results show that the proposed model outperforms the state-of-the-art models, with an accuracy of 98.1% on a decision window of 2s. When we used a 0.1s time window for fast decoding, the accuracy remained at 91.8%, suggesting the potential for real application. Further study on ablation experiments demonstrates the effectiveness of the proposed time-frequency attention mechanism. Analysis of the key EEG features indicates that the β band plays a vital role in AAD.},
}

@misc{panorama_a0790557b9ad_c319d949a4d70669,
  title = {CEDNet: A Continuous Emotion Detection Network for Naturalistic Stimuli Using MEG Signals},
  author = {Zeming He and Gaoyan Zhang},
  year = {2024},
  doi = {10.1109/icassp48485.2024.10447779},
  url = {https://doi.org/10.1109/icassp48485.2024.10447779},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：CEDNet：使用 MEG 信号进行自然刺激的连续情绪检测网络},
  abstract = {Emotional detection is important for brain-computer interface or diagnosis of affective disorders. Traditional methods mainly focused on the recognition of brief stimuli evoked emotion, which cannot fully represent the complexity of real-life emotional changes. In this study, we proposed a continuous emotion detection network (CEDNet) based on magnetoencephalography (MEG) to detect the time-varying emotions evoked by a 2-hour movie. Two brain graphs constructed by functional connectivity and spatial location of brain regions were input as two views of the brain. An adaptive spatio-temporal graph convolutional network with an attention mechanism was adopted to extract the emotion-related high-level features. Considering the impact of unbalanced emotion labels, a label distribution smoother was introduced. Furthermore, we added a domain discriminator to enhance the generalization capability of the model. Experimental results show that the proposed model outperforms the state-of-the-art baselines and provides a deep insight into the human emotional processes.},
}

