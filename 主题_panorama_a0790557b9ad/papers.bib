@misc{panorama_a0790557b9ad_93afac007ee542b5,
  title = {Enhancing HMI Security with Physiological Trustworthiness: A Study on EEG-HRV Synergy for Behavioral and Cognitive State Discrimination},
  author = {Bin Zhao and Jianwu Dang and Gaoyan Zhang and Zhongjie Li and Wanping Xu and Aijun Li},
  year = {2025},
  doi = {10.1109/icbctis66509.2025.11387341},
  url = {https://doi.org/10.1109/icbctis66509.2025.11387341},
  howpublished = {International Conference on Blockchain Technology and Information Security (ICBCTIS)},
  annotation = {中文辅助译名：通过生理可信度增强 HMI 安全性：针对行为和认知状态歧视的 EEG-HRV 协同作用研究},
  abstract = {To address the security needs of multimodal human-machine interaction (MM-HMI) systems against the threat of deepfake-based spoofing attacks, endogenous physiological signals with inherent anti-tampering properties have emerged as a new paradigm for building highly robust MM-HMI systems. Given the vulnerability of exogenous interactions mediated by voice and images, the present study validated the potential of endogenous signals as tamper-resistant interfaces by examining the discriminative efficacy of electroencephalography (EEG) and heart rate variability (HRV) for emotional-cognitive state discrimination across three prototypical scenarios: resting (baseline), auditory perception (listening), and vocalization (singing). Key findings demonstrated that during the task transition from passive listening to active vocalization, the autonomic nervous system (ANS) regulatory mode shifted from parasympathetic dominance to sympathetic dominance, whereas subjective stress levels decreased paradoxically. These results unveiled a nonlinear mapping among behavior, physiology, and psychology, while confirming the core potential of EEG and HRV biomarkers for deployment as embodied cognitive signals in next-generation MM-HMI architectures.},
}

