@misc{sophia_ananiadou_a293cd7f5b9c6f02,
  title = {Bilingual term alignment from comparable corpora in English discharge summary and Chinese discharge summary},
  author = {Yubo Fan and Eric I-Chao Chang and Luoxin Chen and Yan Xu and Junsheng Wei and Sophia Ananiadou and Yi Qian and Jun'ichi Tsujii},
