@misc{sophia_ananiadou_fbe62d48c62c5ae8,
  title = {Extracting semantically enriched events from biomedical literature},
  author = {John McNaught and Makoto Miwa and Douglas B. Kell and Sophia Ananiadou and Paul Thompson},
  year = {2012},
  doi = {10.1186/1471-2105-13-108},
  url = {https://doi.org/10.1186/1471-2105-13-108},
  howpublished = {BMC Bioinform.},
  annotation = {中文辅助译名：从生物医学文献中提取语义丰富的事件},
  abstract = {BACKGROUND: Research into event-based text mining from the biomedical literature has been growing in popularity to facilitate the development of advanced biomedical text mining systems. Such technology permits advanced search, which goes beyond document or sentence-based retrieval. However, existing event-based systems typically ignore additional information within the textual context of events that can determine, amongst other things, whether an event represents a fact, hypothesis, experimental result or analysis of results, whether it describes new or previously reported knowledge, and whether it is speculated or negated. We refer to such contextual information as meta-knowledge. The automatic recognition of such information can permit the training of systems allowing finer-grained searching of events according to the meta-knowledge that is associated with them. RESULTS: Based on a corpus of 1,000 MEDLINE abstracts, fully manually annotated with both events and associated meta-knowledge, we have constructed a machine learning-based system that automatically assigns meta-knowledge information to events. This system has been integrated into EventMine, a state-of-the-art event extraction system, in order to create a more advanced system (EventMine-MK) that not only extracts events from text automatically, but also assigns five different types of meta-knowledge to these events. The meta-knowledge assignment module of EventMine-MK performs with macro-averaged F-scores in the ran},
}

