  annotation = {中文辅助译名：分段事件提取：解决未见语料库上的部分事件识别问题},
  abstract = {Biomedical event extraction systems have the potential to provide a reliable means of enhancing knowledge resources and mining the scientific literature.However, to achieve this goal, it is necessary that current event extraction models are improved, such that they can be applied confidently to unseen data with a minimal rate of error.},
}

@misc{sophia_ananiadou_7cb34dcbe2f84c96,
  title = {Tackling the partial event identification problem on unseen corpora},
  author = {Chrysoula Zerva and Sophia Ananiadou},
  year = {2015},
  url = {https://aclweb.org/anthology/W/W15/W15-3804.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：解决未见语料库上的部分事件识别问题},
  abstract = {Biomedical event extraction systems have the potential to provide a reliable means of enhancing knowledge resources and mining the scientific literature. However, to achieve this goal, it is necessary that current event extraction models are improved, such that they can be applied confidently to unseen data with a minimal rate of error. Motivated by this requirement, this work targets a particular type of error, namely partial events, where an event is missing one or more arguments. Specifically, we attempt to improve the performance of a state-of-the-art event extraction tool, EventMine, when applied to a new cancer pathway curation corpus. We propose a post-processing ranking approach based on relaxed constraints, in order to reconsider the candidate arguments for each event trigger, and suggest possible new arguments. The proposed methodology, applicable to the output of any event extraction system, achieves an improvement in argument recall of 2%-4% when applied to EventMine output, and thus constitutes a promising direction for further developments.},
}

