@misc{sophia_ananiadou_646859afb6c8dbe3,
  title = {APLenty: annotation tool for creating high-quality datasets using active and proactive learning},
  author = {Minh-Quoc Nghiem and Sophia Ananiadou},
  year = {2018},
  doi = {10.18653/V1/D18-2019},
  url = {https://doi.org/10.18653/V1/D18-2019},
