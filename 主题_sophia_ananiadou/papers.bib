@misc{sophia_ananiadou_a121589452fe44dd,
  title = {NERO: a biomedical named-entity (recognition) ontology with a large, annotated corpus reveals meaningful associations through text embedding},
  author = {Kanix Wang and Robert Stevens and Halima Alachram and Yu Li and Larisa Soldatova and Ross D. King and Sophia Ananiadou and Annika Marie Schoene and Maolin Li and Fenia Christopoulou and José Luis Ambite and Joel Matthew and Sahil Garg and Ulf Hermjakob and Daniel Marcu and Emily Sheng and Tim Beißbarth and Edgar Wingender and Aram Galstyan and Xin Gao and Chambers Brendan and Weidi Pan and Bohdan B. Khomtchouk and James A. Evans and Andrey Rzhetsky},
  year = {2021},
  doi = {10.1038/s41540-021-00200-x},
  url = {https://doi.org/10.1038/s41540-021-00200-x},
  howpublished = {npj Systems Biology and Applications},
  annotation = {中文辅助译名：NERO：生物医学命名实体（识别）本体，具有大型带注释的语料库，通过文本嵌入揭示有意义的关联},
  abstract = {Machine reading (MR) is essential for unlocking valuable knowledge contained in millions of existing biomedical documents. Over the last two decades1,2, the most dramatic advances in MR have followed in the wake of critical corpus development3. Large, well-annotated corpora have been associated with punctuated advances in MR methodology and automated knowledge extraction systems in the same way that ImageNet4was fundamental for developing machine vision techniques. This study contributes six components to an advanced, named entity analysis tool for biomedicine: (a) a new, Named Entity Recognition Ontology (NERO) developed specifically for describing textual entities in biomedical texts, which accounts for diverse levels of ambiguity, bridging the scientific sublanguages of molecular biology, genetics, biochemistry, and medicine; (b) detailed guidelines for human experts annotating hundreds of named entity classes; (c) pictographs for all named entities, to simplify the burden of annotation for curators; (d) an original, annotated corpus comprising 35,865 sentences, which encapsulate 190,679 named entities and 43,438 events connecting two or more entities; (e) validated, off-the-shelf, named entity recognition (NER) automated extraction, and; (f) embedding models that demonstrate the promise of biomedical associations embedded within this corpus.},
}

@misc{sophia_ananiadou_c982bb5114278bb7,
  title = {Paladin: an annotation tool based on active and proactive learning},
  author = {Minh-Quoc Nghiem and Paul Baylis and Sophia Ananiadou},
  year = {2021},
  doi = {10.18653/V1/2021.EACL-DEMOS.28},
