@misc{sophia_ananiadou_3cfa81e87d4b4edf,
  title = {brat: a Web-based Tool for NLP-Assisted Text Annotation},
  author = {Sampo Pyysalo and Tomoko Ohta and Pontus Stenetorp and Sophia Ananiadou and Goran Topic and Jun'ichi Tsujii},
