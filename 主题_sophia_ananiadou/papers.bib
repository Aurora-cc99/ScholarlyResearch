  title = {Sustainability strategy and plans beyond the end of the project},
  author = {Diana Trandaba and Dan Cristea and António Branco and Amália Mendes and Thomas Pellegrini and Sophia Ananiadou and Paul Banks Thompson and Dan Ioan Tufis and Georgiana Gilmenau and Mike Rosner and M. Asunción Moreno Bilbao and Núria Bel},
