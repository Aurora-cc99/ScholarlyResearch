  title = {FinNLP-FNP-LLMFinLegal-2025 Shared Task: Financial Misinformation Detection Challenge Task},
  author = {Rui Xing and Qianqian Xie and Jiping Dong and Sophia Ananiadou and Seongchan Park and Kailai Yang and Zhuo Bao and Polydoros Giannouris and Mohsinul Kabir and Keyi Wang and Jaehong Kim and Zhiwei Liu and Xin Zhang and Dong Li},
