@misc{sophia_ananiadou_9f431c762f9df373,
  title = {The Strategic Impact of META-NET on the Regional, National and International Level},
  author = {Asunción Moreno and Bernardo Magnini and Maciej Ogrodniczuk and Joseph Mariani and Jolanta Zabarskaite and Audroné Bieleviciené and Núria Bel and Mike Rosner and John McNaught and Bolette S. Pedersen and Marko Grobelnik and Inguna Skadina and Andrejs Vasiljevs and John Judge and Hans Uszkoreit and Adam Przepiórkowski and Dan Tufis and Monica Monachini and Jan Hajic and Sophia Ananiadou and Simon Krek and Inma Hernáez Rioja and Georg Rehm and Jan Odijk and Cvetana Krstev and Marko Tadic and Stelios Piperidis and Nicoletta Calzolari and Radovan Garabík and Tamás Váradi and Svetla Koeva and Josef van Genabith and Koenraad De Smedt and Krister Lindén and Walter Daelemans and Piotr Pezik and António Branco and Gerhard Budin and Lars Borin and Eiríkur Rögnvaldsson and Kadri Vider and Paul Thompson and Maite Melero and Carmen García-Mateo},
  year = {2014},
  doi = {10.63317/24qt97sjr5ty},
  url = {https://doi.org/10.63317/24qt97sjr5ty},
  howpublished = {LREC},
  annotation = {中文辅助译名：META-NET 对区域、国家和国际层面的战略影响},
  abstract = {This article provides an overview of the dissemination work carried out in META-NET from 2010 until 2015; we describe its impact on the regional, national and international level, mainly with regard to politics and the funding situation for LT topics. The article documents the initiative’s work throughout Europe in order to boost progress and innovation in our field.},
}

@misc{sophia_ananiadou_e68c4a48bc700cdf,
  title = {"Mining events from the literature for bioinformatics applications" by S. Ananiadou, P. Thompson, and R. Nawaz; with Martin Vesely as coordinator},
  author = {Raheel Nawaz and Sophia Ananiadou and Paul Thompson},
  year = {2013},
  doi = {10.1145/2528272.2528277},
  url = {https://doi.org/10.1145/2528272.2528277},
  howpublished = {SIGWEB Newsl.},
  annotation = {中文辅助译名：“生物信息学应用文献中的挖掘事件”作者：S. Ananiadou、P. Thompson 和 R. Nawaz；马丁·韦塞利 (Martin Vesely) 担任协调员},
  abstract = {The ever-increasing rate at which scientific articles are being published means that text mining (TM) is becoming a necessary technology to allow information relevant to a user's search to be isolated from the potential mountain of irrelevant information. Whilst the extraction of named entities, such as genes, proteins and phenotypes, is a well-studied topic, researchers are usually interested in discovering information about specific types of biomedical reactions in which these entities are involved. In order to facilitate efficient searching for such reactions, TM systems need to account for the fact that various types of relationships and links exist between entities in texts. In this article, we describe how the identification of such relationships, together with interpretative information from their textual contexts, can help to create structured representations of biomedical reactions (called events) from unstructured text. We detail the various challenges of extracting events from text, and explain how various tools, resources and infrastructures can help in the development of event extraction systems. Finally, we describe some concrete applications that make use of event extraction technology, i.e., semantic search systems and linking biological pathways with textual evidence.},
}

@misc{sophia_ananiadou_5cb8492ef8b7ae18,
  title = {Dealing with Data Sparsity in Drug Named Entity Recognition},
  author = {Dimitrios Piliouras and Sophia Ananiadou and Ioannis Korkontzelos and Andrew W. Dowsey},
  year = {2013},
  doi = {10.1109/ICHI.2013.9},
  url = {https://doi.org/10.1109/ICHI.2013.9},
  howpublished = {ICHI},
  annotation = {中文辅助译名：处理药物命名实体识别中的数据稀疏性},
  abstract = {Drug Named Entity Recognition (drug-NER) is a critical step for complex Biomedical Natural Language Processing (BioNLP) tasks such as the extraction of pharmaco-genomic, pharmaco-dynamic and pharmaco-kinetic parameters. Large quantities of high quality training data are almost always a prerequisite for employing supervised machine-learning (ML) techniques to achieve high classification performance. However, the human labour needed to produce and maintain such resources is a detrimental limitation. In this study, we attempt to improve the performance of drug NER without relying exclusively on manual annotations. Instead, we use either a small gold-standard corpus (120 abstracts) or no corpus at all. In our approach, we use a \emphvoting system to combine a number of heterogeneous models to enhance performance. Moreover, 11 regular-expressions that capture common drug suffixes were evolved via genetic-programming. We evaluate our approach against state-of-the-art recognisers trained on manual annotations, automatic annotations and a mixture of both. Aggregate classifiers are shown to improve performance, achieving a maximum F-score of 95%. In addition, combined models trained on mixed data are shown to achieve comparable performance to models trained exclusively on gold-standard data.},
}

