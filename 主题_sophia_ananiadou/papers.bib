@misc{sophia_ananiadou_8c960dc34a41610b,
  title = {Three BioNLP Tools Powered by a Biological Lexicon},
  author = {John McNaught and Sophia Ananiadou and Yutaka Sasaki and Paul Thompson},
  year = {2009},
  doi = {10.3115/1609049.1609065},
  url = {https://doi.org/10.3115/1609049.1609065},
  howpublished = {EACL (Demos)},
  annotation = {中文辅助译名：由生物词典提供支持的三种 BioNLP 工具},
  abstract = {In this paper, we demonstrate three NLP applications of the BioLexicon, which is a lexical resource tailored to the biology domain. The applications consist of a dictionary-based POS tagger, a syntactic parser, and query processing for biomedical information retrieval. Biological terminology is a major barrier to the accurate processing of literature within biology domain. In order to address this problem, we have constructed the BioLexicon using both manual and semiautomatic methods. We demonstrate the utility of the biology-oriented lexicon within three separate NLP applications.},
}

