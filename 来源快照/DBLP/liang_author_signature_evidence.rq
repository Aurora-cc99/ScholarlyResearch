PREFIX dblp: <https://dblp.org/rdf/schema#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?paper ?title ?name ?orcid ?institution ?institutionLabel WHERE { ?paper dblp:authoredBy <https://dblp.org/pid/96/7972>; dblp:title ?title; dblp:hasSignature ?sig . ?sig dblp:signatureCreator <https://dblp.org/pid/96/7972>; dblp:signatureDblpName ?name . OPTIONAL {?sig dblp:signatureOrcid ?orcid} OPTIONAL {?sig dblp:signatureInstitution ?institution . OPTIONAL{?institution rdfs:label ?institutionLabel}} } ORDER BY ?paper