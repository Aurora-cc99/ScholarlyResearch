@misc{panorama_huicheng_zheng_8268f62c1b8b9411,
  title = {Nonlinear auto disturbance rejection control for vibration displacement system of continuous cast mold driven by servo motor},
  author = {Huicheng Zheng and Le Liu and Yiming Fang and Qiang Li},
  year = {2016},
  doi = {10.1109/chicc.2016.7553197},
  url = {https://doi.org/10.1109/chicc.2016.7553197},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：伺服电机驱动连铸结晶器振动位移系统非线性自抗扰控制},
  abstract = {Aiming at the problem about the nonlinear function and the mechanical zero offset in the vibration system of continuous casting mold driven by servo motor, a discrete auto disturbance rejection control (ADRC) with nonlinear function processing algorithm is proposed. Firstly, for the nonlinear multi solutions problem existing between rotation angle and displacement of mold, a nonlinear algorithm is proposed to get the practical phase difference of eccentric shaft. The algorithm is achieved by calculating the time difference between ideal time of arrival and actual time of arrival at the same position. Secondly, the mathematical model of vibration system is discretized by using the Euler method, and an ADRC is designed to estimate the eccentric shaft mechanical zero offset and load disturbance, and then compensate and weaken the position error. Finally, the simulation results demonstrate the feasibility of the proposed method.},
}

