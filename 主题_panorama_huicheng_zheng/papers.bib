@misc{panorama_huicheng_zheng_f584ec3395ef854c,
  title = {GLOD-RIS: Zero-Shot Referring Image Segmentation with Gaussian Localization and Orthogonal Decoupling},
  author = {Jingjun Wu and Huicheng Zheng and Yun Lan and Zehua Liu and Jiawen Fang and Jisheng Dang},
  year = {2026},
  doi = {10.1109/tcsvt.2026.3735214},
  url = {https://doi.org/10.1109/tcsvt.2026.3735214},
  howpublished = {IEEE Transactions on Circuits and Systems for Video Technology},
  annotation = {中文辅助译名：GLOD-RIS：具有高斯定位和正交解耦的零样本参考图像分割},
  abstract = {Zero-shot referring image segmentation (RIS) aims to segment a target specified by a referring expression without pixel-level supervision. Recent approaches typically leverage pretrained vision-language models for region-text alignment. However, models such as CLIP are generally trained for global image-text alignment, causing region-level features to be dominated by global context and thus reducing feature discriminability. Moreover, current approaches for modeling referential spatial localization struggle to capture the flexibility and diversity of natural language, limiting precise target localization and hindering fine-grained image-text alignment. To address these issues, we propose GLOD-RIS, a novel zero-shot RIS framework consisting of a dynamic orthogonal decoupling (DOD) module and a grid-guided Gaussian localization (G3L) module. DOD enhances feature discriminability by decoupling region-specific representations from global context via orthogonal projection. G3L module introduces a grid-based visual prompting strategy to guide multi-modal large language model (MLLM) in inferring object locations, which are further refined with Gaussian masks to mitigate spatial ambiguity. Extensive experiments on RefCOCO, RefCOCO+, and RefCOCOg demonstrate that GLOD-RIS consistently outperforms state-of-the-art zero-shot RIS methods, achieving up to about 11% improvement in both oIoU and mIoU. Code will be available at https://github.com/Wujj440/GLOD-RIS.},
}

@misc{bin_hu_fd915a51d8c21be2,
  title = {External Memory Matters: Generalizable Object-Action Memory for Retrieval-Augmented Long-Term Video Understanding},
  author = {Jisheng Dang and Huicheng Zheng and Xudong Wu and Jingmei Jiao and Bimei Wang and Jun Yang and Bin Hu and Jianhuang Lai and Tat-Seng Chua},
  year = {2025},
  doi = {10.24963/IJCAI.2025/97},
  url = {https://doi.org/10.24963/IJCAI.2025/97},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：外部记忆很重要：用于检索增强长期视频理解的通用对象动作记忆},
  abstract = {Long video understanding with Large Language Models (LLMs) enables the description of objects that are not explicitly present in the training data. However, continuous changes in known objects and the emergence of new ones require up-to-date knowledge of objects and their dynamics for effective understanding of the open world. To alleviate this, we propose an efficient Retrieval-Enhanced Video Understanding method, dubbed REVU, which leverages external knowledge to enhance the performance of open-world learning. First, REVU introduces an extensible external text-object memory with minimal text-visual mapping, involving static and dynamic multimodal information to help LLMs-based models align text and vision features. Second, REVU retrieves object information from external databases and dynamically integrates frame-specific data from videos, enabling effective knowledge aggregation to comprehend the open world. We conducted experiments on multiple benchmark datasets, and our model demonstrates strong adaptability to out-of-domain data without requiring additional fine-tuning or re-training. Experiments on benchmark video understanding datasets reveal that our model achieves state-of-the-art performance and robust generalization.},
}

@misc{panorama_huicheng_zheng_2e9dfd9f5582ca34,
  title = {Adaptive Motion Feature Integration for Action Recognition},
  author = {Yi Xiao and Huicheng Zheng},
  year = {2025},
  doi = {10.1109/iccc68654.2025.11437583},
  url = {https://doi.org/10.1109/iccc68654.2025.11437583},
  howpublished = {IEEE International Conference on Computer and Communications (ICCC)},
  annotation = {中文辅助译名：用于动作识别的自适应运动特征集成},
  abstract = {Extracting comprehensive spatio-temporal representations and effectively modeling motion information from intricate video data remain central challenges in action recognition. Current methods employ temporal difference operations, temporal shift operations, or customized attention mechanisms to enhance the representation of motion information. However, they still fail to effectively capture fine-grained interactions across multiple feature dimensions. In this paper, we propose adaptive motion feature integration (AMFI) network, which explicitly incorporates motion cues into spatio-temporal representation learning. Specifically, our AMFI network contains two main components: the fine-grained local context aggregation (FLCA) module for capturing robust local spatio-temporal patterns, and the adaptive motion excitation (AME) module that leverages motion cues to adaptively guide and enhance attention-based feature integration. Experimental results on the large-scale SomethingSomething V1 and Kinetics-400 datasets demonstrate that the proposed AMFI achieves state-of-the-art performance.},
}

@misc{panorama_huicheng_zheng_9debf9b66f4093fa,
  title = {Multiscale Strip Module and Aspect Ratio Sensitive Loss for Remote Sensing Object Detection},
  author = {Guobin Zheng and Huicheng Zheng},
  year = {2025},
  doi = {10.1109/iscait64916.2025.11010605},
  url = {https://doi.org/10.1109/iscait64916.2025.11010605},
  howpublished = {International Symposium on Computer Applications and Information Systems (ISCAIS)},
  annotation = {中文辅助译名：用于遥感物体检测的多尺度条带模块和纵横比敏感损失},
  abstract = {The aspect ratio and orientation sensitivity of objects in remote sensing images make object detection under the traditional framework face great challenges. To address these issues, we propose two methods: multiscale strip module (MSM) and aspect ratio sensitive angle loss (ARS Loss). MSM uses parallel strip convolutions with different receptive fields to enhance long-range feature extraction of slender objects, while ARS Loss dynamically adjusts the angle regression penalty according to the target aspect ratio to alleviate the IoU degradation caused by angular bias. Experiments on DIOR-R dataset demonstrate the effectiveness of our proposed method, which achieves 69.75% of the highest mAP under single-scale training. Compared with the baseline model, the proposed framework improves the detection accuracy of slender objects (such as bridges and harbors) by up to 1.57%, while maintaining robustness to near-square objects. This work provides a comprehensive solution for dealing with different geometric targets in remote sensing scenes.},
}

@misc{panorama_huicheng_zheng_15a448e32e8b852a,
  title = {Beyond Appearance: Multi-Frame Spatio-Temporal Context Memory Networks for Efficient and Robust Video Object Segmentation},
  author = {Jisheng Dang and Huicheng Zheng and Xiaohao Xu and Longguang Wang and Yulan Guo},
  year = {2024},
  doi = {10.1109/tip.2024.3423390},
  url = {https://doi.org/10.1109/tip.2024.3423390},
  howpublished = {IEEE Transactions on Image Processing},
  annotation = {中文辅助译名：超越外观：用于高效、鲁棒视频对象分割的多帧时空上下文记忆网络},
  abstract = {Current video object segmentation approaches primarily rely on frame-wise appearance information to perform matching. Despite significant progress, reliable matching becomes challenging due to rapid changes of the object's appearance over time. Moreover, previous matching mechanisms suffer from redundant computation and noise interference as the number of accumulated frames increases. In this paper, we introduce a multi-frame spatio-temporal context memory (STCM) network to exploit discriminative spatio-temporal cues in multiple adjacent frames by utilizing a multi-frame context interaction module (MCI) for memory construction. Based on the proposed MCI module, a sparse group memory reader is developed to enable efficient sparse matching during memory reading. Our proposed method is generic and achieves state-of-the-art performance with real-time speed on benchmark datasets such as DAVIS and YouTube-VOS. In addition, our model exhibits robustness to sparse videos with low frame rates.},
}

@misc{panorama_huicheng_zheng_ce4c563dcd0f6ba8,
  title = {High-Precision Main Shaft Displacement Measurement for Wind Turbines Using an Optimized Position-Sensitive Detector},
  author = {Weitong Zhang and Lingyun Wang and Guangxi Li and Huicheng Zheng and Chengwei Pang},
  year = {2024},
  doi = {10.3390/electronics13245055},
  url = {https://doi.org/10.3390/electronics13245055},
  howpublished = {Electronics},
  annotation = {中文辅助译名：使用优化的位置敏感探测器对风力涡轮机进行高精度主轴位移测量},
  abstract = {The main shaft of a wind turbine is a critical component that ensures the normal operation of the turbine, and its axial displacement directly impacts its efficiency and safety. The inaccurate measurement of axial displacement may lead to severe issues such as shaft fractures, causing turbine shutdowns. Correcting measurement errors related to axial displacement is essential to prevent potential accidents. This study proposes an improved error correction method for measuring the axial displacement of wind turbine main shafts. Using a position-sensitive detector (PSD) and laser triangulation, the axial and radial displacements of the main shaft are measured to address environmental interference and cost constraints. Additionally, a Sparrow Search Algorithm- Backpropagation (SSA-BP) model is constructed based on operational data from the wind turbine’s main shaft to correct the system’s nonlinear errors. The Sparrow Search Algorithm (SSA) is employed to optimize the weights and thresholds of the Backpropagation (BP) neural network, enhancing prediction accuracy and model stability. Initially, a main shaft displacement measurement system based on a precision displacement stage was developed, and system stability tests and displacement measurement experiments were conducted. The experimental results demonstrate that the system stability error is ±0.025 mm, which is lower than the typical error of 0.05 mm in contact measurement. After model correction, the maximum nonlinear errors},
}

