@misc{panorama_huicheng_zheng_314d41365458b2a6,
  title = {Monocular 3D Face Reconstruction Via Coarse-to-Fine Landmark Representation},
  author = {Z Z Wu and Huicheng Zheng and Zhuo Geng and Wu He and Ziwei Hu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11460534},
  url = {https://doi.org/10.1109/icassp55912.2026.11460534},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：通过粗到细的地标表示进行单目 3D 人脸重建},
  abstract = {Model-based monocular 3D face reconstruction methods employ 3D Morphable Models (3DMMs) to reconstruct facial shape, expression and pose by predicting corresponding parameters. However, we observe an insufficient utilization of the pose-related visual cues inherent in image features, limiting head pose estimation performance, especially for extreme orientations. Moreover, jointly estimating multiple attributes introduces coupling effects that degrade reconstruction accuracy. Since landmarks offer fine-grained facial representation, we propose a Coarse-to-Fine Landmark Representation Network (CFLRNet) to enhance pose awareness and achieve face disentanglement. The network enhances pose awareness by explicitly correlating 2D features and 3D poses through a hierarchical landmark representation, and introduces feature-level disentanglement to separately model facial shape and expression. Experiments show our pose estimation method surpasses state-of-the-art methods. Meanwhile, our shape-expression disentanglement significantly lowers reconstruction errors.},
}

@misc{panorama_huicheng_zheng_7015f002379441ea,
  title = {Fast Track Anything With Sparse Spatio-Temporal Propagation for Unified Video Segmentation},
  author = {Jisheng Dang and Huicheng Zheng and Zhixuan Chen and Zhang Li and Yulan Guo and Tat‐Seng Chua},
  year = {2026},
  doi = {10.1109/tip.2025.3649365},
  url = {https://doi.org/10.1109/tip.2025.3649365},
  howpublished = {IEEE Transactions on Image Processing},
  annotation = {中文辅助译名：通过稀疏时空传播快速跟踪任何内容以实现统一视频分割},
  abstract = {Recent advances in "track-anything" models have significantly improved fine-grained video understanding by simultaneously handling multiple video segmentation and tracking tasks. However, existing models often struggle with robust and efficient temporal propagation. To address these challenges, we propose the Sparse Spatio-Temporal Propagation (SSTP) method, which achieves robust and efficient unified video segmentation by selectively leveraging key spatio-temporal features in videos. Specifically, we design a dynamic 3D spatio-temporal convolution to aggregate global multi-frame spatio-temporal information into memory frames during memory construction. Additionally, we introduce a spatio-temporal aggregation reading strategy to efficiently aggregate the relevant spatio-temporal features from multiple memory frames during memory retrieval. By combining SSTP with an image segmentation foundation model, such as the segment anything model, our method effectively addresses multiple data-scarce video segmentation tasks. Our experimental results demonstrate state-of-the-art performance on five video segmentation tasks across eleven datasets, outperforming both task-specific and unified methods. Notably, SSTP exhibits strong robustness in handling sparse, low-frame-rate videos, making it well-suited for real-world applications.},
}

@misc{panorama_huicheng_zheng_f1d1f9355b871ca7,
  title = {Reliability-Aware Multimodal Fusion for Multimodal Sentiment Analysis},
  author = {Ran Wang and Huicheng Zheng},
  year = {2026},
  doi = {10.1109/iscait69154.2026.11477216},
  url = {https://doi.org/10.1109/iscait69154.2026.11477216},
  howpublished = {International Symposium on Computer Applications and Information Systems (ISCAIS)},
  annotation = {中文辅助译名：用于多模态情感分析的可靠性感知多模态融合},
  abstract = {Multimodal Sentiment Analysis (MSA) aims to infer human sentiment by jointly modeling linguistic, acoustic, and visual signals. Due to the subtle and complex nature of sentiment, different modalities often convey inconsistent sentiment signals, which introduces biased supervision for unimodal representation learning and leads to unreliable multimodal fusion. To address these challenges, we propose a reliability-aware multimodal sentiment analysis framework that explicitly models sentiment-level inconsistency from both unimodal learning and multimodal fusion perspectives. First, we propose a Unimodal Feature Enhancement module that treats multimodal annotations as noisy labels and generate reliable unimodal pseudo-labels for discriminative feature learning. Second, we propose a Deviation-Guided Fusion module that quantifies sentiment deviation between unimodal predictions and multimodal labels as modality reliability and dynamically guides sentiment fusion through reliability-aware cross-modal interaction. Extensive experiments on our MSA benchmark datasets indicate that our method outperforms competitive baselines.},
}

@misc{bin_hu_f39c6dd6a062,
  title = {Video Decoupling Networks for Accurate, Efficient, Generalizable, and Robust Video Object Segmentation},
  author = {Jisheng Dang and Huicheng Zheng and Yulan Guo and Jianhuang Lai and Bin Hu and Tat-Seng Chua},
  year = {2026},
  doi = {10.1109/tip.2025.3649360},
  url = {https://doi.org/10.1109/tip.2025.3649360},
  howpublished = {IEEE Transactions on Image Processing},
  annotation = {中文辅助译名：用于准确、高效、可推广和鲁棒视频对象分割的视频解耦网络},
  abstract = {Video object segmentation (VOS) is a fundamental task in video analysis, aiming to accurately recognize and segment objects of interest within video sequences. Conventional methods, relying on memory networks to store single-frame appearance features, face challenges in computational efficiency and capturing dynamic visual information effectively. To address these limitations, we present a Video Decoupling Network (VDN) with a per-clip memory updating mechanism. Our approach is inspired by the dual-stream hypothesis of the human visual cortex and decomposes multiple previous video frames into fundamental elements: scene, motion, and instance. We propose the Unified Prior-based Spatio-temporal Decoupler (UPSD) algorithm, which parses multiple frames into basic elements in a unified manner. UPSD continuously stores elements over time, enabling adaptive integration of different cues based on task requirements. This decomposition mechanism facilitates comprehensive spatial-temporal information capture and rapid updating, leading to notable enhancements in overall VOS performance. Extensive experiments conducted on multiple VOS benchmarks validate the state-of-the-art accuracy, efficiency, generalizability, and robustness of our approach. Remarkably, VDN demonstrates a significant performance improvement and a substantial speed-up compared to previous state-of-the-art methods on multiple VOS benchmarks. It also exhibits excellent generalizability under domain shift and robustness },
}

