@misc{panorama_huicheng_zheng_2fb3c62088356eae,
  title = {From Coarse to Fine: Hierarchical Multi-scale Temporal Information Modeling via Sub-group Convolution for Video Action Recognition},
  author = {Fengwen Cheng and Huicheng Zheng and Zehua Liu},
  year = {2021},
  doi = {10.1109/ijcnn52387.2021.9534414},
  url = {https://doi.org/10.1109/ijcnn52387.2021.9534414},
  howpublished = {International Joint Conference on Neural Networks (IJCNN)},
  annotation = {中文辅助译名：从粗到细：通过子组卷积进行视频动作识别的分层多尺度时间信息建模},
  abstract = {In the video action recognition task, it is essential to model the temporal information. Since different actions have different durations, capturing multi-scale temporal features is very crucial. In this paper, we propose a multi-scale modeling (MSM) module to exploit temporal information for action recognition, which is composed of a multi-scale temporal convolution (MTC) block and a multi-scale hierarchical convolution (MHC) block. MTC uses convolutions of multiple temporal depths to capture features of different temporal scales to enhance the connection between frames. MHC employs group convolution to obtain more fine-grained multi-scale features in the channel dimension. In MHC, the convolutions are formulated as a hierarchical structure to expand the receptive fields as well as help implement a series of sub-group convolutions, which can help to realize the modeling of distinctive and long-term information. The two components of MSM are complementary in temporal modeling. Finally, we evaluated our method on several action recognition benchmarks including Kinetics, UCF10l, and HMDB51, and obtained competitive results, which verified the effectiveness of the proposed method in temporal modeling,},
}

