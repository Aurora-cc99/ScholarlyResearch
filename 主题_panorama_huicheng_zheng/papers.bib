@misc{panorama_huicheng_zheng_b1134200f5042587,
  title = {Correcting Perspective Distortion In Incremental Video Stitching},
  author = {Yinqi Chen and Huicheng Zheng and Junyu Lin},
  year = {2021},
  doi = {10.1109/icmew53276.2021.9455966},
  url = {https://doi.org/10.1109/icmew53276.2021.9455966},
  howpublished = {IEEE International Conference on Multimedia & Expo Workshops (ICMEW)},
  annotation = {中文辅助译名：纠正增量视频拼接中的透视失真},
  abstract = {In video stitching, only incremental video stitching technology can typically be used due to the limitations of computer memory and processing speeds. However, if frames with perspective distortion are selected as reference planes, perspective distortion will accumulate continuously during incremental video stitching, making the resulting panorama image appear unnatural. Existing solutions to correct perspective distortion rely on the content of scenes or external hardware, which lack generalization and yield poor performance when stitching UAV (unmanned aerial vehicle) videos. This paper proposes a novel type of feature called “displacements of matching feature points” to correct perspective distortion. A displacement vector composed of matching feature points on two adjacent frames contains the information of perspective distortion, which allows us to correct any perspective distortion. We correct the displacements of matching feature points with perspective distortion in a reference plane to one without perspective distortion. Then, this plane is taken as a global reference plane in incremental video stitching to further correct the panorama. Using the proposed method, correction of perspective distortion is no longer dependent on image content or computational hardware. Experimentally, the proposed method performs better than other state-of-the-art methods, yielding more natural panoramas.},
}

@misc{panorama_huicheng_zheng_6b1e5149c9e74680,
  title = {Dense Video Captioning with Hierarchical Attention-Based Encoder-Decoder Networks},
  author = {Mingjing Yu and Huicheng Zheng and Zehua Liu},
  year = {2021},
  doi = {10.1109/ijcnn52387.2021.9534164},
  url = {https://doi.org/10.1109/ijcnn52387.2021.9534164},
  howpublished = {International Joint Conference on Neural Networks (IJCNN)},
  annotation = {中文辅助译名：具有基于分层注意力的编码器-解码器网络的密集视频字幕},
  abstract = {Dense video captioning is a challenging task with the goal of localizing and describing all events in an untrimmed video, taking into account both visual and text information. Although existing methods have made some achievements, most of them suffer from missing details and inferior captioning. Recent progress has been made in using object features to supplement more detailed information. However, due to the considerable number of objects in the video, the representation of learning objects is often noisy, which may interfere with the generation of correct captions. We also notice that realworld video-text data involve different granularity levels, such as objects/words and events/sentences. Therefore, we propose the hierarchical video-text attention-based encoder-decoder networks for dense video captioning. The proposed method successfully considers the hierarchy in the video and text and exploits the most relevant visual and text features when generating caption. Specially, we design a hierarchical attention encoder for learning complex visual information: an object attention module focusing on the most relevant objects and an event attention module modeling the long-range temporal context. A corresponding decoder has been built for translating multi-level features into the linguistic description, i.e., a word attention module to exploit the most correlated text features and a sentence attention module to leverage high-level semantic information. The proposed hierarchical },
}

