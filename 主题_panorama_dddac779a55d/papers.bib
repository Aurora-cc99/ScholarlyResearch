@misc{panorama_dddac779a55d_0c824c55c6e4333f,
  title = {Similarity of Speech Emotion in Different Languages Revealed by a Neural Network with Attention},
  author = {Changzeng Fu and Thilina Dissanayake and Kazufumi Hosoda and Takuya Maekawa and Hiroshi Ishiguro},
