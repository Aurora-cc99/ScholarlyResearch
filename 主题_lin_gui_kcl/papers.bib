@misc{lin_gui_kcl_27960564c8b170d6,
  title = {A multi-center, open-label, randomized, parallel-controlled phase II study comparing pharmacokinetic, pharmacodynamics and safety of ripertamab (SCT400) to rituximab (MabThera� in patients with CD20-positive B-cell non-Hodgkin lymphoma},
