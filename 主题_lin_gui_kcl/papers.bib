@misc{xu_ruifeng_ea4cf15657631668,
  title = {A convolutional attentional neural network for sentiment classification},
  author = {Jiachen Du and Lin Gui and Yulan He and Ruifeng Xu},
  year = {2017},
  doi = {10.1109/SPAC.2017.8304320},
  url = {https://doi.org/10.1109/SPAC.2017.8304320},
  howpublished = {SPAC},
  annotation = {中文辅助译名：用于情感分类的卷积注意力神经网络},
  abstract = {Neural network models with attention mechanism have shown their efficiencies on various tasks. However, there is little research work on attention mechanism for text classification and existing attention model for text classification lacks of cognitive intuition and mathematical explanation. In this paper, we propose a new architecture of neural network based on the attention model for text classification. In particular, we show that the convolutional neural network (CNN) is a reasonable model for extracting attentions from text sequences in mathematics. We then propose a novel attention model base on CNN and introduce a new network architecture which combines recurrent neural network with our CNN-based attention model. Experimental results on five datasets show that our proposed models can accurately capture the salient parts of sentences to improve the performance of text classification.},
}

@misc{lin_gui_kcl_1494749ad6307717,
  title = {The role of histone 4 acetylation in loss of CD28 on CD4+ CD28-T cells in patients with acute coronary syndrome},
  author = {Lin Gui and Lei Ren and Jun Liu and Ying Cui and Wenying Sun},
  year = {2017},
  doi = {10.3760/cma.j.issn.1673-4394.2017.06.004},
  url = {http://rs.yiigle.com/CN231535201706/1013538.htm},
  howpublished = {Int J Immunol},
  annotation = {中文辅助译名：组蛋白 4 乙酰化在急性冠状动脉综合征患者 CD4+ CD28-T 细胞上 CD28 缺失中的作用},
  abstract = {Objective To investigate the role of histone 4 acetylation in CD28 expression in patients with acute coronary syndrome(ACS) by detecting the level of CD28 mRNA and the H4 acetylation status of CD28 promoter. Methods CD4+ T cells were isolated with magnetic activated cell sorting(MACS). The mRNA levels of CD28 were determined by real time-PCR after reverse transcription.The H4 acetylation status of CD28 promoter regulatory sequences was detected by chromatin Immunoprecipitation and real time-PCR(ChIP-qPCR). Results Compared with normal control, the mRNA levels of CD28 in CD4+ T cells were significantly lowered in patients with ACS (Control vs ACS: 1.063±0.131 vs 0.739±0.065, t=2.65, P<0.05). The H4 acetylation status of CD28 gene promoter region was lower than that of normal control (Control vs ACS: 3.115±0.545 vs 1.275±0.168), t=3.222, P<0.05). A positive correlation was found between CD28 promoter H4 acetylation and CD28 mRNA level(P=0.03, r=0.582). Conclusion CD28 gene promoter H4 deacetylation regulated the CD28 transcriptional repression in CD4+ T cells of ACS patients. Key words: Acute Coronary Syndrome; CD4+ CD28-T cells; Histone 4; Acetylation; CD28 gene promoter},
}

@misc{lin_gui_kcl_8b38c0f743165f42,
  title = {Role of DNA methylation in loss of CD28 on CD4+ CD28-T cells in patients with acute coronary syndrome},
  author = {Lin Gui and Lei Ren and Jun Liu and Ying Cui and Wenying Sun},
  year = {2017},
  doi = {10.3760/cma.j.issn.1673-4394.2017.05.003},
  url = {http://rs.yiigle.com/CN231535201705/1008112.htm},
  howpublished = {Int J Immunol},
  annotation = {中文辅助译名：DNA 甲基化在急性冠脉综合征患者 CD4+ CD28-T 细胞上 CD28 缺失中的作用},
  abstract = {Objective To investigate the role of abnormal DNA methylation in CD28 expression in patients with acute coronary syndrome(ACS). Methods CD4+ T cells were isolated with MACS.The mRNA levels of CD28 were determined by Real time-PCR after reverse transcription.The methylation status of CD28 promoter regulatory sequences was detected by bisulfite sequencing. Results Compared with normal control, the mRNA levels of CD28 in CD4+ T cells were significantly lowered in patients with ACS[Control vs ACS: (1.066±0.162)vs(0.7401±0.069), P<0.05]. The methylation status of CD28 gene promoter region was significantly higher than that of normal control[Control vs ACS: (24.47±3.17)%vs(43.33±1.52)%, P<0.05]. A negative correlation was found between CD28 promoter methylation and CD28 mRNA level(P=0.01, r=-0.579). Conclusion CD28 gene promoter hypermethylation regulated the CD28 transcriptional repression in CD4+ T cells of ACS patients.DNA methylation is involved in the formation of CD4+ CD28- T cells. Key words: Acute coronary syndrome; CD4+ CD28-T cells; DNA methylation; CD28 gene promoter},
}

