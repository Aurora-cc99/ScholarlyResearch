  author = {Arno Hartholt and T. J. Muller and Jonathan Gratch and David R. Traum and Stacy Marsella},
  year = {2004},
  doi = {10.1007/978-3-540-24842-2_18},
  url = {https://doi.org/10.1007/978-3-540-24842-2_18},
