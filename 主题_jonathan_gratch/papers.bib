  author = {Jonathan S. Gratch and Anna Okhmatovskaia and Susan Duncan},
  year = {2006},
  url = {http://ict.usc.edu/pubs/VIRTUAL%20HUMANS%20FOR%20THE%20STUDY%20OF%20RAPPORT%20IN%20CROSS%20CULTURAL%20SETTINGS.pdf},
