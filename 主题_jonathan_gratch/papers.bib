@misc{jonathan_gratch_8942a72e64d1b36d,
  title = {Assessing the validity of appraisal-based models of emotion},
  author = {B. Stankovic and Ning Wang and Jonathan Gratch and Stacy Marsella},
  year = {2009},
  doi = {10.1109/ACII.2009.5349443},
  url = {https://doi.org/10.1109/ACII.2009.5349443},
  howpublished = {ACII},
  annotation = {中文辅助译名：评估基于评估的情绪模型的有效性},
  abstract = {We describe an empirical study comparing the accuracy of competing computational models of emotion in predicting human emotional responses in naturalistic emotion-eliciting situations. The results find clear differences in models' ability to forecast human emotional responses, and provide guidance on how to develop more accurate models of human emotion.},
}

@misc{jonathan_gratch_abcd6ab6163b7d59,
  title = {Assessing the validity of a computational model of emotional coping},
  author = {B. Stankovic and Jonathan Gratch and Ning Wang and Stacy Marsella},
  year = {2009},
  doi = {10.1109/ACII.2009.5349584},
  url = {https://doi.org/10.1109/ACII.2009.5349584},
  howpublished = {ACII},
  annotation = {中文辅助译名：评估情绪应对计算模型的有效性},
  abstract = {In this paper we describe the results of a rigorous empirical study evaluating the coping responses of a computational model of emotion. We discuss three key kinds of coping, Wishful Thinking, Resignation and Distancing that impact an agent's beliefs, intentions and desires, and compare these coping responses to related work in the attitude change literature. We discuss the EMA computational model of emotion and identify several hypotheses it makes concerning these coping processes. We assess these hypotheses against the behavior of human subjects playing a competitive board game, using monetary gains and losses to induce emotion and coping. Subject's appraisals, emotional state and coping responses were indexed at key points throughout a game, revealing a pattern of subject's al-tering their beliefs, desires and intentions as the game unfolds. The results clearly support several of the hypotheses on coping responses but also identify (a) extensions to how EMA models Wishful Thinking as well as (b) individual differences in subject's coping responses.},
}

