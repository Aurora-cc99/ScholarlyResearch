@misc{jonathan_gratch_297eabd9f30ca8be,
  title = {Steal and Smile: Impact of Emotion Regulation and Social Values on Smiles in Social Conflicts},
  author = {Mirella Hladký and Jonathan Gratch and Bin Han and Tanja Schneeberger and Patrick Gebhard},
  year = {2025},
  doi = {10.1109/ACII67994.2025.11771818},
  url = {https://doi.org/10.1109/ACII67994.2025.11771818},
  howpublished = {ACII},
  annotation = {中文辅助译名：偷窃与微笑：情绪调节和社会价值观对社会冲突中微笑的影响},
  abstract = {Emotion recognition models primarily rely on observable expressions. However, expressions may be shaped by individual traits such as emotion regulation strategies and social versus self-focused orientation, particularly in social conflicts. This incongruence between emotional experience and expression can lead to misinterpretations, for example, in the case of smiles. We provide detailed annotations of an existing corpus of 300 smiles derived from recordings of 132 participants in 431 social conflict situations, present a novel computational model that predicts these expressive reactions from the nature of the conflict and individual traits, and use explainable AI methods to uncover insights. The results highlight the strong impact of individual traits and offer insights into the intricate relationships between internally experienced and externally displayed emotions. This work contributes to a deeper understanding of human emotions, and has implications for the development of more accurate emotion recognition systems.},
}

@misc{jonathan_gratch_13200aeb7dd48cd2,
  title = {How Collaboration Context and Personality Traits Shape the Social Norms of Human-to-Avatar Identity Representation},
  author = {Seoyoung Kang and Boram Yoon and Kangsoo Kim and Woontack Woo and Jonathan Gratch},
  year = {2025},
  doi = {10.1109/TVCG.2025.3549904},
  url = {https://doi.org/10.1109/TVCG.2025.3549904},
  howpublished = {IEEE Trans. Vis. Comput. Graph.},
  annotation = {中文辅助译名：协作环境和个性特征如何塑造人与阿凡达身份表征的社会规范},
  abstract = {As avatars have evolved from simple digital representations into extensions of our identities, they offer unprecedented opportunities for self-expression and customization beyond the physical world limitations. While virtual platforms foster new forms of identity exploration, social norms still play a crucial role in defining what is considered appropriate in these environments. In this study, we surveyed 150 participants to investigate social norms surrounding avatar modifications, examining how perspectives, contexts, and personality traits influence attitudes toward appropriateness. Our findings reveal that avatar modifications are generally viewed as more appropriate when considered from a partner's perspective, especially for changeable attributes. However, these modifications are perceived as less acceptable in professional settings such as workplaces. Additionally, individuals with high self-monitoring tendencies tend to be more resistant to changes, while those scoring higher on Machiavellianism are more accepting of changes, particularly regarding unchangeable attributes and emotional expressions. These findings provide valuable insights for platform developers and designers, highlighting the importance of implementing context-aware customization options that balance core identity elements with personality-driven preferences, thereby enhancing user experiences while respecting social norms.},
}

@misc{jonathan_gratch_c40e4bed937467cc,
  title = {Aware Yet Biased: Investigating Emotional Reasoning and Appraisal Bias in Large Language Models},
  author = {Ala Nekouvaght Tak and Jonathan Gratch and Klaus R. Scherer},
  year = {2025},
  doi = {10.1109/TAFFC.2025.3581461},
  url = {https://doi.org/10.1109/TAFFC.2025.3581461},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：意识到但有偏见：研究大型语言模型中的情感推理和评估偏差},
  abstract = {This paper reports two studies investigating the emotional reasoning of Large Language Models (LLM). Previous research has suggested that LLMs are surprisingly accurate at predicting human emotions from text descriptions of situations and reason in a way that is consistent with appraisal theory—a leading theory of emotion. Study 1 tests this claim with a large multilingual corpus (English, French, and German) of autobiographical descriptions of emotionally charged events. We confirm that GPT-4, one of the most advanced and widely studied LLMs, shows a remarkable ability to predict emotion and appraisals. We further show this ability is language-independent, with accuracy being consistent across languages and unaffected by the language of the prompt. However, GPT-4 struggles to accurately predict certain emotions (shame, fear, and irritation) and fails to understand appraisal dimensions related to control and power. We repeat the experiments with Gemini-2.0-Flash and find a remarkably similar pattern of strengths and weaknesses, although it consistently outperforms GPT-4. Study 2 examines a possible mechanism for these failures based on the idea of cognitive appraisal bias. In psychological appraisal theory, appraisal bias is the idea that people evaluate situations in biased, often unrealistic ways. By testing both models on a set of situations designed to identify appraisal bias, we find they exhibit strong—but similar—appraisal bias; for example, evaluating situations as if},
}

