@misc{jonathan_gratch_24cdd5e5e329e05c,
  title = {Virtual Learning Environments. The oLTECx: A Study of Participant Attitudes and Experiences},
  author = {Anjum Najmi and Jonathan Gratch and Adriana D'Alba and Chris Bigenho},
  year = {2011},
  doi = {10.4018/JGCMS.2011010103},
  url = {https://doi.org/10.4018/JGCMS.2011010103},
  howpublished = {Int. J. Gaming Comput. Mediat. Simulations},
  annotation = {中文辅助译名：虚拟学习环境。 oLTECx：参与者态度和经验研究},
  abstract = {The rapid development in new technologies and media and widespread access to the Internet is changing how people teach and learn. Recognizing the potential of technology, schools and universities are placing more content online from fully deliverable courses to course catalogs, course registration, and college admissions. People are able to gain access to a multitude of information with one click. Online learning environments range from authentic, real-time environments to simulations, as well as 2D and 3D virtual environments. This paper explores the use of a 2-dimensional, narrative-based, virtual learning environment (VLE) created by doctoral students to orient potential students to their university departments’ degree programs, faculty, and course offerings. After exploring the environment, participants were surveyed about their experiences. Findings include validation of the instrument, possible correlations relating to learning through games, engagement, and game design. Emerging themes and suggestions for future research are presented in this paper.},
}

