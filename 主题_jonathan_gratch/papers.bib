@misc{jonathan_gratch_b8a874d5917afc42,
  title = {Soar-RWA: Planning, Teamwork, and Intelligent Behavior for Synthetic Rotary Wing Aircraft},
  author = {Jr . Randall W. Hill and Johnny Chen and Jonathan S. Gratch and Paul S. Rosenbloom and Milind Tambe},
  year = {1998},
  url = {http://ict.usc.edu/~hill/hill-publications/CGF-98.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：Soar-RWA：合成旋翼飞机的规划、团队合作和智能行为},
  abstract = {We have constructed a team of intelligent agents that perform the tasks of an Army attack helicopter company and a Marine transport/escort combined team for a synthetic battlefield environment used for running largescale military exercises. We have used the Soar integrated architecture to develop: (1) pilot agents for a company of helicopters, (2) a command agent that makes decisions and plans for the helicopter company, and (3) an approach to teamwork that enables the pilot agents to coordinate their activities in accomplishing the goals of the company. This case study describes the task domain and architecture of our application, as well as the benefits and lessons learned from applying AI technology to this domain.},
}

