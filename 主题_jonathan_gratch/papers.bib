@misc{jonathan_gratch_951d7fe1fefec757,
  title = {The avatar will see you now: Support from a virtual human provides socio-emotional benefits},
  author = {Lisanne S. Pauw and Gerben A. van Kleef and Gale M. Lucas and Disa A. Sauter and Agneta H. Fischer and Jonathan Gratch},
