@misc{jonathan_gratch_b6ea169bcdbcbfae,
  title = {IAGO: Interactive Arbitration Guide Online (Demonstration)},
  author = {Johnathan Mell and Jonathan Gratch},
  year = {2016},
  doi = {10.5555/2936924.2937230},
  url = {https://dblp.uni-trier.de/db/conf/atal/aamas2016.html#MellG16},
  howpublished = {AAMAS},
  annotation = {中文辅助译名：IAGO：在线互动仲裁指南（演示）},
  abstract = {Automated negotiation between two agents has been the subject of much research focused on optimization and efficiency. However, human-agent negotiation represents a field in which real-world considerations can be more fully explored. Furthermore, teaching negotiation and other interpersonal skills requires long periods of practice with open-ended dialogues and partners. The API presented in this paper represents a novel platform on which to conduct human-agent research and facilitate teaching negotiation tactics in a longitudinal way. We present a prototype demonstration that is real-time, rapidly distributable, and allows more actions than current platforms of negotiation.},
}

@misc{jonathan_gratch_f68d2bcb6ac26133,
  title = {Niki and Julie: a robot and virtual human for studying multimodal social interaction},
  author = {Jill Boberg and Alesia Gainer and Emmanuel Dorley and David R. Traum and Mikio Nakano and Anton Leuski and Jonathan Gratch and Ron Artstein},
  year = {2016},
  doi = {10.1145/2993148.2998532},
  url = {https://doi.org/10.1145/2993148.2998532},
  howpublished = {ICMI},
  annotation = {中文辅助译名：Niki 和 Julie：用于研究多模式社交互动的机器人和虚拟人},
  abstract = {We demonstrate two agents, a robot and a virtual human, which can be used for studying factors that impact social influence. The agents engage in dialogue scenarios that build familiarity, share information, and attempt to influence a human participant. The scenarios are variants of the classical “survival task,” where members of a team rank the importance of a number of items (e.g., items that might help one survive a crash in the desert). These are ranked individually and then re-ranked following a team discussion, and the difference in ranking provides an objective measure of social influence. Survival tasks have been used in psychology, virtual human research, and human-robot interaction. Our agents are operated in a “Wizard-of-Oz” fashion, where a hidden human operator chooses the agents’ dialogue actions while interacting with an experiment participant.},
}

