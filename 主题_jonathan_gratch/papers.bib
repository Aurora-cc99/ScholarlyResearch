@misc{jonathan_gratch_0e77f51770450ce8,
  title = {Gender Stereotype Threat in AI-Assisted Negotiation},
  author = {James Hale and Mehran Bahmani and Jonathan Gratch},
  year = {2026},
  doi = {10.1145/3806774.3827990},
  url = {https://doi.org/10.1145/3806774.3827990},
  howpublished = {IVA},
  annotation = {中文辅助译名：人工智能辅助谈判中的性别刻板印象威胁},
  abstract = {Researchers have long used negotiation as a testbed for intelligent virtual agents – studying social intelligence, creating training paradigms for human negotiators, and leveraging IVAs as methodological tools to study bias. In this study, we analyze a collection of negotiation dialogues, wherein participants negotiated against an opponent presenting as male or female; further, we manipulated whether participants were told their counterpart used AI to assist them. We investigate whether AI-assistant use may impact stereotype threat in three ways: 1) Through self-reported feelings; 2) In the language they use against their opponent; and 3) Whether their objective performance at the task shows signs of threat. First, through self-reports, we see evidence consistent with stereotype threat, where women report higher discomfort than men. Next, a textual analysis of the dialogues suggests the AI-assistance intervention, gender matching, and one’s own gender interact to influence the language one uses during the task – specifically, influencing whether they speak more or less cautiously. Lastly, we find an interaction between whether one’s opponent purportedly used AI and one’s gender, reflected in their negotiated agreement.},
}

@misc{jonathan_gratch_247efd8b99f03079,
  title = {Multilevel dynamics of the brain, hormones, mind, and behavior in social human-robot interaction},
  author = {Shawn Joshi and Hasan Ayaz and Xingnan Li and Nina J. Rothstein and Yigit Topoglu and Adrian A. Franke and Frank Krueger and Ewart de Visser and Jonathan Gratch},
  year = {2026},
  doi = {10.1126/SCIROBOTICS.AEC1762},
  url = {https://doi.org/10.1126/SCIROBOTICS.AEC1762},
  howpublished = {Sci. Robotics},
  annotation = {中文辅助译名：社会人机交互中大脑、激素、思维和行为的多级动力学},
  abstract = {As robots enter homes, workplaces, and health care settings, sustaining trust during social interaction becomes a central challenge for human-robot interaction. However, relatively little is known about how humans integrate signals across the brain, hormones, mind, and behavior when robots violate expectations or display social expressiveness. Addressing this gap, we examined how robot performance (congruent versus erroneous) and expressiveness (animated versus stationary) shape multilevel human responses during face-to-face decision-making with an embodied humanoid robot. Participants engaged with the robot in person while neural activity was monitored using functional near-infrared spectroscopy, alongside salivary oxytocin assays, self-reported trust, and behavioral influence measures. Robot errors, implemented as cooperative norm violations, reliably reduced trust and influence, establishing performance reliability as the foundation of trust. Expressiveness amplified these effects: Animated robots elicited stronger prefrontal engagement and cross-level neural-hormonal coupling. Elevated oxytocin was most strongly linked to reduced trust during expressive robot errors, alongside diminished behavioral influence. This pattern is consistent with a context-sensitive vigilance response, indicating that oxytocin in human-robot interaction may heighten sensitivity to norm violations rather than reliably promote bonding. Validation analyses provided small, directionally consistent },
}

