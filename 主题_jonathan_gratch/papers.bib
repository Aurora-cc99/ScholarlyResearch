@misc{jonathan_gratch_8ed4803ede6cd34a,
  title = {Affective Computing, Emotional Development, and Autism},
  author = {Rafael A. Calvo and Sidney D'Mello and Jonathan S. Gratch and Arvid Kappas and Daniel S. Messinger and Leticia Lobo Duvivier and Zachary E. Warren and Mohammad H. Mahoor and Jason K. Baker and Anne S. Warlaumont and Paul Ruvolo},
