  author = {Lili Guo},
  year = {2006},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=YYKJ200603001},
  howpublished = {Applied science and technology},
  annotation = {中文辅助译名：漏泄同轴电缆单模辐射频段扩展技术研究},
  abstract = {By analyzing the modes of the radiation of leaky coaxial cable using Floquet Theorem,the condition of the single-mode radiation is obtained.Then,the restraint of high-order mode radiation is examined,and the particular methods to realize the frequency expansion of the single-mode radiation of leaky coaxial cable with vertical and inclined slots are discussed respectively.These methods provide a basis for the application of leaky coaxial cable to the broadband communication.},
}

@misc{panorama_2f5d281f71cb_8e9e393fe9735234,
  title = {Research on the Radiation Characteristics of Leaky Coaxial Cable and Spiral Antenna in the Blind Zone},
  author = {Xin Zhang and Zixin Zhao and Xiaodong Yang and Lili Guo and Wenxing Li},
  year = {2006},
  doi = {10.1109/icccas.2006.284776},
  url = {https://doi.org/10.1109/icccas.2006.284776},
  howpublished = {International Conference on Communications, Circuits and Systems},
  annotation = {中文辅助译名：漏泄同轴电缆和螺旋天线盲区辐射特性研究},
  abstract = {As an instrument to realize mobile communication in the blind zone, leaky coaxial cable (LCX) is recently widely used in communication systems of tunnels, mines, subways and so on. In this paper, beginning with the radiation theory of LCX and antenna, by the use of ray-tracing method, we take a tunnel for example to analyze its radiated field produced by both LCX and spiral antenna. By comparison, LCX shows advantages in the coverage of the radiated field in such special areas-the distribution of the radiated field is more uniform. The theories and results in this paper can be extended in other blind zones and have referenced values in further research on solving the problems of communication in the blind zone},
}

@misc{panorama_2f5d281f71cb_bdf0aa4dbc4592b3,
  title = {Research on the Radiated Field's Distribution of Leaky Coaxial Cable in the Blind Zone},
  author = {Xin Zhang and Xiaodong Yang and Lili Guo and Zixin Zhao},
  year = {2006},
  doi = {10.1109/isscaa.2006.1627688},
  url = {https://doi.org/10.1109/isscaa.2006.1627688},
  howpublished = {International Symposium on Systems and Control in Aeronautics and Astronautics},
  annotation = {中文辅助译名：漏泄同轴电缆盲区辐射场分布研究},
  abstract = {The path of electric waves of leaky coaxial cable (LCX) in the blind zone is analyzed in the ray-tracing method on the assumption that the bind zone is rectangular, and the distribution of the radiated field in the blind zone is calculated. Further, the effect of the period of the slots of LCX on the magnitude fluctuation is also discussed: a proper period can decrease the magnitude fluctuation of the radiated field. The method used in this paper can be generalized in other zones with different shapes. The theoretical basis is provided for the application of LCX in the blind zone},
}

@misc{panorama_2f5d281f71cb_6d916d248cd2c49f,
  title = {Narrow-Band Interference Suppression in DSSS Using Adaptive Least-Square Lattice Interpolators},
  author = {Zhiguo Sun and Lili Guo and Lin Qi},
  year = {2006},
  doi = {10.1109/icosp.2006.344519},
  url = {https://doi.org/10.1109/icosp.2006.344519},
  howpublished = {International Conference on Signal Processing},
  annotation = {中文辅助译名：使用自适应最小二乘点阵插值器抑制 DSSS 中的窄带干扰},
  abstract = {To improve the validity of narrow-band interference (NBI) suppression in DSSS, this paper uses LSL interpolators as the NBI suppression algorithms which are based on the method of least-squares and lattice structure. Utilizing the discrepancy in the predictability between NBI and the spread spectrum (SS) signal, a linear interpolation of the received signal can so accurately estimate NBI in the input signal of the receiver and suppress it availably. The convergence rate and robustness performance of LSL interpolators outperforms ones of LSL predictors, because the former fully utilizes the correlation characteristic of signal samples. It was shown that it can obtain more 3 dB~6 dB process gain than LSL predictors},
}

@misc{panorama_2f5d281f71cb_b8fd08d93e5e7b52,
  title = {An Improved LSL Interpolator to Suppress Narrow-Band Interference forDirect-Sequence Spread-Spectrum Systems},
  author = {Zhiguo Sun and Lili Guo},
  year = {2006},
  doi = {10.1109/chinacom.2006.344717},
  url = {https://doi.org/10.1109/chinacom.2006.344717},
  howpublished = {International Conference on Communications and Networking in China (ChinaCom)},
  annotation = {中文辅助译名：一种改进的 LSL 内插器来抑制直接序列扩频系统的窄带干扰},
  abstract = {An improved interpolator based on QR-decomposition is proposed to suppress narrow-band interference (NBI) in direct-sequence spread-spectrum (DS/SS) systems. This interpolator is based on the discrepancy in the predictability between NBI and the spread spectrum signal (SS), and then uses a linear interpolation of the received signal to estimate NBI. Because of QR-decomposition operation instead of inverting the correlation matrix and a novel variable with a small dynamic range, the performances of QRD-LSL interpolators outperform ones of LSL predictors and LSL interpolators. It was shown that the QRD-LSL interpolators can obtain more 4 dB processing gain than LSL predictors and LSL predictors, and its total computational complexity scales linearly with the interpolation order.},
}

