@misc{panorama_2f5d281f71cb_3c126d6ca13c92b7,
  title = {Feature Analysis for Incomplete Time Series Classification},
  author = {Lili Guo and Jianmin Wang and Yu He and Lei Song and Xin Qin and Xu Cheng},
  year = {2024},
  doi = {10.1145/3653644.3653661},
  url = {https://doi.org/10.1145/3653644.3653661},
  howpublished = {FAIML},
  annotation = {中文辅助译名：不完全时间序列分类的特征分析},
  abstract = {This study introduces an innovative imputation-free framework for time series classification amidst missing values, challenging traditional imputation-based approaches. By integrating GRU-based imputation with a noisy-robust feature learning module, our model adeptly navigates the complexities of incomplete data, reducing reliance on assumptions and harnessing the informational essence of missingness. Tested across 20 univariate time series datasets and one multivariate time series data under various missing ratios, the proposed framework not only outperforms conventional methods but also marks a paradigm shift in handling missing data, illustrating the potential for imputation-free strategies to enhance analysis accuracy and reliability in critical data-intensive applications.},
}

@misc{panorama_2f5d281f71cb_067e12efde5e2b92,
  title = {Robust Classification of Incomplete Time Series with Noisy Labels},
  author = {Xin Qin and Pengshuai Yao and Mengna Liu and Xu Cheng and Fan Shi and Lili Guo},
  year = {2024},
  doi = {10.1109/CSCWD61410.2024.10580639},
  url = {https://doi.org/10.1109/CSCWD61410.2024.10580639},
  howpublished = {CSCWD},
  annotation = {中文辅助译名：带有噪声标签的不完整时间序列的鲁棒分类},
  abstract = {Missing data and noisy labeling are common problems in time series analysis. The traditional approach to deal with missing data is to separate interpolation and classification, which is not interactive and provides unsatisfactory performance. While advanced methods can learn features from missing information, feature representation is limited due to the accumulation of interpolation errors. For noisy label interference, a robust loss function is a simpler and more general solution for robust learning. This study proposes an end-to-end neural network that unifies data interpolation and feature learning within a single framework. The focus is placed on extracting useful information from incomplete time series data, and for the computation of classification loss, a robustness loss function is used which effectively reduces the impact of noisy labels. The model is evaluated on 20 univariate time series from the UCR archive after noise processing. The results show that the model outperforms state-of-the-art methods in classifying incomplete time series under noisy labels, especially at high missing rates with high noise rates.},
}

