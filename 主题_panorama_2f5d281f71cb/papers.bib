  abstract = {In this paper, the spatial correlation analysis was based on a circular antenna arrays. The antenna was placed on the circle equably. So, the distance between antenna elements was considered in the analysis. At the same time, the formula of spatial correlation at the receiver was educed, which was aimed at circular antenna arrays. The correlation between antenna elements changed due to the changed antenna distance, the angle spread and the average angle of arrival direction of the signal. The antenna correlation changed with the angle spread changed. At this paper, the equality distributing of angle spread was considered. Each parameter that influenced spatial correlation was analyzed, the simulation figure demo the results derived by the formula. It was important to the analysis of the MIMO systems estimation and design.},
}

@misc{panorama_2f5d281f71cb_8c0211d60982701d,
  title = {Optical taper of polymer optical fiber used in laser communication system},
  author = {Lili Guo and Yi Wang and Kejia Wang},
  year = {2006},
  doi = {10.1117/12.678580},
  url = {https://doi.org/10.1117/12.678580},
  howpublished = {Proceedings of SPIE, the International Society for Optical Engineering/Proceedings of SPIE},
  annotation = {中文辅助译名：激光通信系统用聚合物光纤光锥},
  abstract = {The key technique of optical wireless communication is Acquisition, Pointing and Tracking (APT). Owing to very large distance of optical wireless communication, all these factors such as equipment joggling, the scintillation will cause drift of facula. Traditional solution consists of acquisition system and tracking and pointing system. The acquisition system means that the acquisition of target in large scope of range of response. The tracking and pointing system means that accurate pointing to the communicative target. The function of system is to accurately point the target and to real-time track it after the acquisition of the target. This paper presents an innovative solution. The main idea proposed in this paper is to take the diameter of the light beam emitted by the optical taper in control, using the piezoelectric ceramic to adjust the smaller diameter of the optical taper of polymer optical fiber. This can make the facula larger when the system proceed to acquire and track, and make it smaller when the system proceed to communicate. The larger the facula is, the lower the energy density and SNR become. However, because of the lower precision requirement of information in tracking than in communication, the technique can fulfill the request generally. Meanwhile, the adopting of the OCDMA technique can greatly reduce the power request of the laser equipment. This new technique combines the communication system and the beacon system together, resulting in the smart dec},
}

@misc{panorama_2f5d281f71cb_28ea3ba288e3681e,
