}

@misc{panorama_2f5d281f71cb_557196313a1be652,
  title = {The Improved Detection Algorithms of Parallel Combinatory Spread Spectrum Signal},
  author = {Xiaodong Qi and Qian Luo and Di Zhao and Lili Guo},
  year = {2008},
  doi = {10.1109/wicom.2008.376},
  url = {https://doi.org/10.1109/wicom.2008.376},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：并行组合扩频信号的改进检测算法},
  abstract = {To reduce the influence of imperfect correlation characteristic between the spread sequences and noise in the channel on the performance of detection algorithms, two improved algorithms used to detect parallel combinatory spread spectrum (PCSS) signal are proposed. The improved detection algorithms based on cyclic correlation apply the cyclic correlation characteristic of PCSS signals to suppress inner-interference and noise as well as jamming in the channel. And the other ones based on multi-user detection (MUD) use the configuration characteristic of PCSS signal to improve the performance of the detection. The mathematics models of improved detection algorithms are provided and the performances are analyzed. Theoretic analysis and experimental results indicate that the improved algorithms based on cyclic correlation have the better performance to suppress noise and jamming in the channel and the improved algorithms based on MUD have the better performance to suppress inner-interference as the result of imperfect correlation characteristic between the spread sequences. At the same time, the complexities of the algorithms are increased that limit their applied occasion except for abrupt communication systems.},
}

@misc{panorama_2f5d281f71cb_f499b50a2fd1cd4a,
  title = {Adaptive Backstepping Sliding-Mode Synchronization of Uncertain Multi-Scroll Chaotic System},
  author = {Yuye Wang and Xu Hongzhen and Lili Guo},
  year = {2008},
  doi = {10.1109/iccee.2008.154},
  url = {https://doi.org/10.1109/iccee.2008.154},
  howpublished = {International Conference on Computer and Electrical Engineering},
  annotation = {中文辅助译名：不确定多涡旋混沌系统的自适应反步滑模同步},
  abstract = {A synchronization method of adaptive backstepping sliding-mode control is presented based on the multiscroll chaotic systems with hysteresis nonlinear function and unknown parameters. The strategy is designed by a step-by-step procedure interlacing. At each step, a coordinate transformation, the design of a virtual control via a Lyapunov technique and the definition of a tuning function are derived, then, the globally control of the system is obtained. As a result, synchronization of the chaotic systems is achieved by controller. The synchronization error system arrives at the sliding-mode in finite time. Then, the controller can drive the error system to reach the origin. The identification of the unknown parameters is obtained at the same time. Because of using the adaptive arithmetic and sliding-mode control, the controller is robustness of parameter uncertainties and disturbances. The analyses and simulation results proved the effectiveness and feasibility of the method.},
}

@misc{panorama_2f5d281f71cb_723673036f87d9a8,
  title = {Modulation Recognition Method Based on High Order Cyclic Cumulants for Time-Frequency Overlapped Two-Signal in the Single-Channel},
  author = {Kuang-dai Li and Lili Guo and Rong Shi and Dan Wu},
  year = {2008},
  doi = {10.1109/cisp.2008.484},
  url = {https://doi.org/10.1109/cisp.2008.484},
  howpublished = {International Congress on Image and Signal Processing (CISP)},
  annotation = {中文辅助译名：单通道时频重叠两信号高阶循环累积量调制识别方法},
  abstract = {To solve the problems in modulation recognition of time-frequency overlapped two-signal in the single-channel, an algorithm based on cyclic cumulants used modulation recognition is presented. Through computing the fourth-order cyclic cumulants of pretreated band signals, the feature vector for classification was extracted, and then use the minimum-error criterion to classify time-frequency overlapped two-signal automaticly. Theoretical analysis and experiment results both verify that the algorithm is correct and efficient.},
}

@misc{panorama_2f5d281f71cb_599a0229cfaa8c74,
  title = {Study on Algorithms of Keyword Confusion Network Generation},
  author = {Lei Zhang and Meimei Jia and Lili Guo},
  year = {2008},
  doi = {10.2991/jcis.2008.43},
  url = {https://doi.org/10.2991/jcis.2008.43},
  howpublished = {Joint Conference on Information Sciences (JCIS)},
  annotation = {中文辅助译名：关键词混淆网络生成算法研究},
  abstract = {Keyword spotting based on large vocabulary continuous speech recognition (LVCSR) is the main researching direction of keyword spotting field.Lattice as the middle result of LVCSR, is often used in this system.But because of its big size, the performance is not efficient as we expect to be.In this paper, lattice was optimized by confusion network (CN) to achieve higher recall rate and lower error rate.And the study on algorithms of keyword confusion network generation was expanded.In the system, the proposed algorithm increased the recall rate of confusion network to 87.11%, while it was 65.46% with N-best.},
}

@misc{panorama_2f5d281f71cb_ce9759e96f0fdede,
  title = {Study of GPS Adaptive Antenna Technology Based on Complex Number AACA},
  author = {Jianhong Xiang and Lili Guo and Ying Chen and Jianjun Zhang},
  year = {2008},
  doi = {10.1109/wicom.2008.534},
  url = {https://doi.org/10.1109/wicom.2008.534},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：基于复数AACA的GPS自适应天线技术研究},
  abstract = {Global position system (GPS) adaptive array antenna forms null beam to suppress the interference in order to communicate normally. The nulling beamforming model is actually an optimization technique. Because the traditional adaptive algorithms usually obtain the partial optimum solution, in this letter, we propose adaptive ant colony algorithm (AACA) can find the desired solution which is a global search method. The article explains AACA and it can work well in the complex number space. Some examples demonstrate the availability of this algorithm.},
}

@misc{panorama_2f5d281f71cb_a2a1f20ce481cdb3,
  title = {Study and application of FLMS recursive algorithm based on Space-time Adaptive Processing},
  author = {Jianhong Xiang and Lili Guo and Limin Wang and Jianjun Zhang},
  year = {2008},
  doi = {10.1109/isscaa.2008.4776170},
  url = {https://doi.org/10.1109/isscaa.2008.4776170},
  howpublished = {International Symposium on Systems and Control in Aeronautics and Astronautics},
  annotation = {中文辅助译名：基于时空自适应处理的FLMS递归算法研究与应用},
  abstract = {Space-time Adaptive Processing (STAP) is usually applied to adaptive anti-jam system of Global Positioning System (GPS). It is the most effective way to reject the broadband interference. But STAP often dose matrix compute, which has a huge computational complexity. Paper investigates a recursive algorithm-Frost Least-Mean-Square (FLMS) algorithm. FLMS can reduce the workload of array signal processing and achieve real-time processing. By simulation, FLMS algorithm can not only well suppress the broadband jammer, but also suppress the number of interference more than that of the sensor elements of array antenna. FLMS algorithm makes it possibility that hardware achieves STAP.},
}

@misc{panorama_2f5d281f71cb_9179e43a2b37247e,
  title = {Spatial Correlation in Three-dimensional Receiver Antenna Array Channel Model},
  author = {Lili Guo},
  year = {2008},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=JSJC200812006},
  howpublished = {Jisuanji gongcheng},
  annotation = {中文辅助译名：三维接收机天线阵列信道模型中的空间相关性},
  abstract = {Three-dimensional antenna array channel model is set up in this article.The channel model setting is extended to space.The general mathematics expression of channel model is given.According to the 3-D antenna array,the describing of the arrival angle is extended to pitching angle and azimuth angle.The spatial correlation based on this channel model is given too.The relation between the antenna array and the spatial correlation is showed.The correlations with the uniform,Gaussian and Laplacian power azimuth spectrum distributions are derived in this article.The computer simulations are given.},
}

@misc{panorama_2f5d281f71cb_a32f9a9945275e81,
  title = {Study and simulating of adaptive array processing with effect of channel uniformity},
  author = {Jianhong Xiang and Lili Guo and Heping Li},
  year = {2008},
  doi = {10.1109/isscaa.2008.4776169},
  url = {https://doi.org/10.1109/isscaa.2008.4776169},
  howpublished = {International Symposium on Systems and Control in Aeronautics and Astronautics},
  annotation = {中文辅助译名：通道均匀性影响的自适应阵列处理研究与仿真},
  abstract = {Adaptive anti-jam processing used by Global Positioning System (GPS) usually works in an environment where interferences exist. The Power-Inversion (PI) algorithm is often applied to suppress interferences in the system. But variance of amplitude and phase which exists among antenna channel takes bad effect on adaptive anti-jam processing and PI algorithm, so we do our best to research the relation between channel uniformity and adaptive processing. When variance of amplitude and phase is limited under the definite condition, paper proves PI algorithm can not only reject interferences, but also conquer channel uniformity on a certain degree by academic researching and simulating. The conclusion has the advantage to engineering applications.},
}

@misc{panorama_2f5d281f71cb_879ae17a3bccbce8,
  title = {ZF Code-Aided Narrow-Band Interference Suppression for Synchronous DS-CDMA Systems},
  author = {Fulian Yin and Lili Guo},
  year = {2008},
  doi = {10.1109/wicom.2008.500},
  url = {https://doi.org/10.1109/wicom.2008.500},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：同步 DS-CDMA 系统的 ZF 编码辅助窄带干扰抑制},
  abstract = {This paper analyzes zero-forcing (ZF) code-aided narrow-band interference (NBI) rejection in synchronous direct-sequence code-division multiple access (DS-CDMA) systems of complex channel circumstance. The performance of decoding is badly affected based on general ZF code-aided techniques because of the phase of complex gain accounting for channel effects. The system based on modified ZF code-aided technique could cancellate or relieve the effects but attend by high computational complexity. So this paper designs a new optimal restrictive ZF code-aided technique to solve this problem without the increasing of computational complexity. The conclusion is approved by experiments.},
}

@misc{panorama_2f5d281f71cb_8ccae792ac838aa3,
