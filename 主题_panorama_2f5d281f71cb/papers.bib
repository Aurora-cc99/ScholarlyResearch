}

@misc{panorama_2f5d281f71cb_b97e66628eb285ef,
  title = {Transmission efficiency of code shift keying},
  author = {Lili Guo and Noriyoshi Kuroyanagi and N. Suehiro},
  year = {2002},
  doi = {10.1109/milcom.1993.408550},
  url = {https://doi.org/10.1109/milcom.1993.408550},
  howpublished = {IEEE Military Communications Conference (MILCOM)},
  annotation = {中文辅助译名：码移键控的传输效率},
  abstract = {The authors determine the frequency utilization efficiency of code shift keying (CSK) under practical design parameters. If an ideal bit-position discriminating function for M-sequence is used, the information conveyed by one frame of M chips (the length of M-sequence) increases to log/sub 2/M bits. This is the principle of CSK. However, it is more vulnerable to noise than the conventional spread spectrum system, DS-BPSK. The authors compare the transmission capacities of CSK and BPSK under identical conditions of receiving signal power, Gaussian and interfering noise power, frequency bandwidth, and bit error rate. The result shows that CSK is capable of transmitting 2/spl sim/4.5 times the capacity of BPSK.>},
}

