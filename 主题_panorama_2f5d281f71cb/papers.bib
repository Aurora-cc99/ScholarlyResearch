@misc{panorama_2f5d281f71cb_75e3b35d860f7c86,
  title = {Improved parallel combinatory spread spectrum communication system},
  author = {Ming-Duo Liu and Zhaowei Qu and Lili Guo and Xiao-Jie Qi},
  year = {2016},
  doi = {10.1109/iccwamtip.2016.8079855},
  url = {https://doi.org/10.1109/iccwamtip.2016.8079855},
  howpublished = {International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)},
  annotation = {中文辅助译名：改进的并行组合扩频通信系统},
  abstract = {Based on Parallel Combinatory Spread Spectrum (PCSS) communication system, an improved PCSS system is proposed with PN sequences serial-parallel combinatory connecting. Using the character of internal memory between information data, optimization treatment is done in the receiver. The system model is built and simulated in AWGN channel, and the properties and error bit probability are discussed. The simulation results show that the transmission efficiency of improved PCSS system is higher than present PCSS system. More importantly, the possibility of error in improved PCSS system is decreased because of using of weighted average of the correlators output values in the receiver.},
}

