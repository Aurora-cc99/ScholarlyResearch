  doi = {10.1109/wcsp.2012.6542893},
  url = {https://doi.org/10.1109/wcsp.2012.6542893},
  howpublished = {International Conference on Wireless Communications and Signal Processing (WCSP)},
  annotation = {中文辅助译名：LFM 信号窗口长度的估计},
  abstract = {An adaptive approach is proposed to select analysis window parameters for LFM signals. After analyzing the instantaneous frequency and instantaneous bandwidth to deduce the relation between window length and deviation of the Gaussian window, high-order statistics is used to select the appropriate window length for STFT and get the optimal SNR with the right time-frequency resolution according to the signal characteristic under a fixed sampling rate.},
}

@misc{panorama_2f5d281f71cb_e92e7bf6907aec4b,
  title = {Narrow-band Interference Suppression in DSSS by Side Correlation Replacement Algorithm},
  author = {Xiaolin Zhang and Lili Guo},
  year = {2011},
  doi = {10.3724/sp.j.1146.2006.00805},
  url = {https://doi.org/10.3724/sp.j.1146.2006.00805},
  howpublished = {JOURNAL OF ELECTRONICS INFORMATION TECHNOLOGY},
  annotation = {中文辅助译名：边相关替换算法抑制DSSS中的窄带干扰},
  abstract = {摘要: 论文提出了一种新的窄带干扰抑制算法，基于信号边带相关性的边带相关置换算法，通过计算接收信号频谱的边带相关函数确定载频和干扰中心频率，然后利用直扩信号频谱的对称性，用相对于窄带干扰的边带对称值代替干扰值达到消除干扰的目的。该算法对频谱具有对称性的调制方式都适用。计算机仿真结果表明边带相关置换算法的性能要优于变换域干扰置零的常规算法。 关键词: 窄带干扰; 抑制; 边带相关置换; 直扩通信},
}

@misc{panorama_2f5d281f71cb_c6198c191c5b653c,
  title = {Symmetric raised cosine keying modulation and performance analysis},
  author = {Lili Guo and Bin Zhou and Zhiguo Sun and Fei Gao},
  year = {2011},
  doi = {10.1109/iccsnt.2011.6181915},
  url = {https://doi.org/10.1109/iccsnt.2011.6181915},
  howpublished = {International Conference on Computer Science and Network Technology (ICCSNT)},
  annotation = {中文辅助译名：对称升余弦键控调制和性能分析},
  abstract = {A new binary digital modulation method is proposed, this is symmetric raised cosine keying (SRCK) modulation method. The temporal expressions of the SRCK modulated sample waveforms are deduced, and the PSD of the SRCK modulated signals are simulated and analyse. Compare with MSK modulated signals on the bandwidth efficiency and communication performance, the SRCK modulated signals have the advantages about high energy concentration, high bandwidth efficiency and good resistance to amplitude fading. The SRCK modulation method provides a way for next generation high efficiency modulaion communication system.},
}

@misc{panorama_2f5d281f71cb_08489c51837a997a,
  title = {BER performance study of non-equal probability UWB system based on parallel combinatory spread spectrum},
  author = {Lili Guo},
  year = {2011},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=XTYD201103040},
  howpublished = {Systems engineering and electronics},
  annotation = {中文辅助译名：基于并行组合扩频的非等概率UWB系统误码率性能研究},
  abstract = {This paper gives an ultra wideband(UWB) communication system based on parallel combinatory spread spectrum,which composites the advantages of the security and the high efficiency of UWB communication system and parallel combinatory spread spectrum communication system.So the new system can possess the high efficiency and the fine security simultaneously.In the new system the signal output from the part of the parallel combinatory spread spectrum has the property of non-equal probability.And the error probability of demodulation is presented for non-equal probability time hopping M-ary pulse amplitude modulation(TH M-PAM),and the equation is proved to be correct by means of simulation.Under the background of the additive white Gaussian noise,the paper gives the simulation of the bit error rate(BER) performance of the system.The results show that the new system is better than the normal parallel combinatory spread spectrum system and normal UWB communication system of the BER performance.},
}

@misc{panorama_2f5d281f71cb_ab23c30053f3310a,
  title = {Adaptive beamforming method for arc length based virtual antenna array},
  author = {Wenxing Li and Yipeng Li and Lili Guo and Wenhua Yu},
  year = {2011},
  doi = {10.1109/iwem.2011.6021492},
  url = {https://doi.org/10.1109/iwem.2011.6021492},
  howpublished = {IEEE International Workshop on Electromagnetics: Applications and Student Innovation Competition},
  annotation = {中文辅助译名：基于弧长的虚拟天线阵列自适应波束形成方法},
  abstract = {There exists angle sensitivity problem in the interpolated virtual antenna array proposed by Friedlander, the representative method solving this problem is multi transformation areas approach, but via this approach it will bring combined error ulteriorly, furthermore, it is unease to inhibit burst interference. In this paper, we introduce arc length based virtual antenna design method into adaptive beam forming, it allows virtual transformation in the whole array scanning area and moreover, it can suppress burst interference. The validity of our method is verified by computer simulation results.},
}

