@misc{panorama_2f5d281f71cb_b3c280ab0e6b50db,
  title = {A narrowband multi-ary FSK transmission principle using sampling function waveform modulation},
  author = {Noriyoshi Kuroyanagi and N. Suehiro and Kohei Ohtake and Masahiro Tomita and Lili Guo},
  year = {2002},
  doi = {10.1109/isssta.1996.563254},
  url = {https://doi.org/10.1109/isssta.1996.563254},
  howpublished = {IEEE International Symposium on Spread Spectrum Techniques and Applications (ISSSTA)},
  annotation = {中文辅助译名：采用采样函数波形调制的窄带多进制FSK传输原理},
  abstract = {Conventional FSK uses shift frequencies of integer times the frame rate. If shift frequencies using non-integers (NIFSK) could be used, the frequency utilization efficiency would improve due to the capability of multi-ary transmission. However, since a framed sequence consisting of NIFSK includes abrupt transients, the waveform suffers from considerable distortion when it is transmitted via a bandlimited path. To solve this problem, we propose sampling function waveform modulation system (SAFWM). SAFWM uses a modified sampling function waveform that is immune to intersymbol interference generated in the process of conveying each sampled value of an FSK signal. The transmission bandwidth is only slightly larger than that of zero to the maximum shift frequency. At the receiver, the sampled values are restored by correlation detection with the same waveforms, and are transformed into the original FSK. To accurately restore a waveform of transmitted NIFSK signals, frame extension is introduced. Distortionless transmission performed with this method is confirmed by computer simulation. This principle can be applied not only for FSK/PSK but also for FSK-SS (spread spectrum) and FH-SS, resulting in improving their frequency utilization efficiencies.},
}

