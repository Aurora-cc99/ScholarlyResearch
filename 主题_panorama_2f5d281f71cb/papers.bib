  author = {Xiaoyan Ning and Lili Guo and Xuejun Sha},
  year = {2012},
  doi = {10.1109/ictc.2012.6386849},
  url = {https://doi.org/10.1109/ictc.2012.6386849},
  howpublished = {International Conference on Information and Communication Technology Convergence (ICTC)},
  annotation = {中文辅助译名：基于分数阶傅里叶变换的联合时延和频偏估计},
  abstract = {Time delay is an important issue in signal processing. In this paper, we propose an approach to joint time delay and frequency offset estimation by parameters detection on the Fractional Fourier Transform (FRFT) domain with fractional correlation. We analyze the selection of transmitted signal, transform order and complexity of computation, after which simulation results are given for validation.},
}

@misc{panorama_2f5d281f71cb_a15f2416c82a71e0,
  title = {A Novel Channel Multiplexing Scheme Based on Fractional Fourier Transform},
  author = {Xiaoyan Ning and Lili Guo and Zhiguo Sun and Xuejun Sha},
  year = {2012},
  doi = {10.1109/imccc.2012.348},
  url = {https://doi.org/10.1109/imccc.2012.348},
  howpublished = {International Conference on Instrumentation and Measurement, Computer, Communication and Control (IMCCC)},
  annotation = {中文辅助译名：基于分数阶傅立叶变换的新型通道复用方案},
  abstract = {The paper proposed a novel channel multiplexing scheme, in which the fractional Fourier transform (FRFT) domain channel division takes the place of traditional time- or frequency-division. With the help of proper signal design, the time-frequency aliasing is eliminated by FRFT domain filtering. The simulation results show that the proposed scheme will reduce the inter symbol interference and improve the bit error ratio performance compared to the single channel scheme with the same bit rate.},
}

@misc{panorama_2f5d281f71cb_a1de595ba2c9c953,
  title = {Eigenvalue-Based Cooperative Spectrum Sensing Algorithm},
  author = {Shibing Zhang and Jiaojiao Yang and Lili Guo},
  year = {2012},
  doi = {10.1109/imccc.2012.92},
  url = {https://doi.org/10.1109/imccc.2012.92},
  howpublished = {International Conference on Instrumentation and Measurement, Computer, Communication and Control (IMCCC)},
  annotation = {中文辅助译名：基于特征值的协同频谱感知算法},
  abstract = {Accurate spectrum sensing is the key technique of cognitive networks. According to characteristic of random matrix, a cooperative spectrum sensing algorithm is proposed, which is based the eigenvalue of the signals covariance matrix. Regarded the average eigenvalue of the signals received at the different nodes as the average noise power, the ratio of maximum eigenvalue to average eigenvalue is used to decide whether the primary signal is present. It reduces the sensing period and improves the performance of spectrum sensing. Simulation results show that the cooperative algorithm has about 2 dB margin over other algorithms in signal-to-noise ratio.},
}

@misc{panorama_2f5d281f71cb_8b6c0eee519d4ad1,
  title = {Performance Studies of Improved PCSS UWB Communication System Based on TH MPPM},
  author = {Lin Qi and Lili Guo},
  year = {2012},
  doi = {10.1109/icecc.2012.621},
  url = {https://dl.acm.org/citation.cfm?id=2417502.2418387},
  howpublished = {International Conference on Electronics, Communications and Control},
  annotation = {中文辅助译名：基于TH MPPM的改进型PCSS UWB通信系统性能研究},
  abstract = {Ultra wideband communication system based on parallel combinatory spread spectrum (PCSS UWB) is a novel system, which fuses the advantages of parallel combinatory spread spectrum and UWB technology, therefore PCSS UWB system can gain the fine performances of security and high efficiency at the same time. And PCSS UWB communication system outperforms the conventional UWB communication system for the bit error rate (BER) performance. The output signals from the part of PCSS have the features of multivalued and non-equal probability, so the multi-ary pulse modulation mode generally used in the system. This paper takes the PCSS UWB communication system based on TH MPPM as the research object, performances of demodulation and de-spread are analyzed and studied deeply, and the improvement of the system is also given as well. In the improved system, the probability of the PCSS signals is equalized in order to matching the characteristic of the demodulation of TH MPPM signals, which could improve the system performance. The results of the simulation indicate that the improved PCSS UWB communication system has the better de-spread and BER performance than that of the original one.},
}

@misc{panorama_2f5d281f71cb_1ea0ecde5bb76ced,
  title = {A Closed-loop Cross-Layer Scheme for Wireless Multiuser Transmissions},
  author = {Lili Guo and Yang Wang},
  year = {2012},
  doi = {10.1016/j.phpro.2012.05.131},
  url = {https://doi.org/10.1016/j.phpro.2012.05.131},
  howpublished = {Physics Procedia},
  annotation = {中文辅助译名：无线多用户传输的闭环跨层方案},
  abstract = {To improve transmission efficiency of wireless communication systems, cross-layer design is investigated, which can adapt to the dynamically variable wireless channel characters. In this paper, a novel cross-layer design for multi-user system is proposed to improve system performance. The Beamforming-MIMO cross-layer system is scheduled through combining multilevel adaptive modulation (AM) at physical layer with truncated automatic repeat request (ARQ) protocol at data link layer, and feed backing modulation mode, ARQ request and transmit weight vector from receiver, in order to improve multi-antennas system performance. This paper derives close-form expressions of the system spectral efficiency and the outage probability for wireless multiuser MIMO transmissions. It shows by simulation that, compared to Alamouti's cross-layer system and SISO cross-layer system, this cross-layer system can achieve better performance. And we analyze the impact of the transmit antenna number and mobile user number on the performance.},
}

@misc{panorama_2f5d281f71cb_b6bcd8c1c6f7cf40,
  title = {Parameter estimation for linear FM signal},
  author = {Liran Shen and Qingbo Yin and Tian'en Shen and Lili Guo},
  year = {2012},
  doi = {10.1109/cisp.2012.6470027},
  url = {https://doi.org/10.1109/cisp.2012.6470027},
  howpublished = {International Congress on Image and Signal Processing (CISP)},
  annotation = {中文辅助译名：线性调频信号的参数估计},
  abstract = {A new method is introduced for parameter estimation of linear frequency modulated (LFM) signals, which consists of a coarse search and a fine search. In the initial stage, the window length for short time Fourier transform (STFT) is selected to get the right time-frequency resolution and concentrate the energy to a line in spectrogram according to the LFM signal characteristic, then the line of ridge energy is tracked in the spectrogram, and the parameters of LFM signal can be estimated coarsely. In the second stage, the fine search for correct parameters is implemented in the fractional Fourier transform (FRFT) domain using Gaussian model to fit the impulse response of the LFM signals under the guidance from the above stage by the property of monotonicity in the limited neighborhood of the optimal value. Computer simulations have verified the effectiveness of the new method.},
}

@misc{panorama_2f5d281f71cb_72a8d812bdc1ab6a,
  title = {Research on Blind Narrow-Band Interference Suppression Based on Subspace Code-Aided Technique for DS-CDMA Systems},
  author = {Lili Guo},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=DZXU201207026},
  howpublished = {Dianzi xuebao},
  annotation = {中文辅助译名：DS-CDMA系统基于子空间编码辅助技术的盲窄带干扰抑制研究},
  abstract = {A blind subspace code-aided technique for narrow-band interference(NBI) suppression of direct sequence-code division multiple access(DS-CDMA) systems is proposed.This technique is to improve the performance of direct matrix inverse(DMI) code-aided technique.The rejection of this technique is against three type of NBI,namely,sinusoidal tones,data NBI and autoregressive(AR) stochastic process by jointly estimating character space of virtual CDMA formed by CDMA and NBI.In this paper,signal to noise and interference rate(SINR) performance of blind subspace code-aided is addressed and revealed superiority with blind DMI codeaided.The feasibility of proposed technique is proved through simulations.},
}

@misc{panorama_2f5d281f71cb_c9996896af1db2b5,
