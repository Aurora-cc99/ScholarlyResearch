@misc{panorama_2f5d281f71cb_bf6949d0b8a1922a,
  title = {Weighted decision fusion algorithm in cooperative spectrum sensing},
  author = {Lili Guo and Shibing Zhang},
  year = {2011},
  doi = {10.1109/icecc.2011.6067761},
  url = {https://doi.org/10.1109/icecc.2011.6067761},
  howpublished = {International Conference on Electronics, Communications and Control},
  annotation = {中文辅助译名：协作频谱感知中的加权决策融合算法},
  abstract = {Due to the geographical locations of cognitive users (namely secondary users, SUs) and the effect of shadowing and fading in channel, the primary user (PU) signal power received at SU is different from each other. In this paper, a weighted decision fusion (WDF) algorithm is proposed to improve the detection reliability. The weighted factors are calculated according to their received PU signal powers instead of their received signal-to-noise ratios (SNRs). Simulation results show that WDF algorithm performs better than traditional decision fusion schemes.},
}

@misc{panorama_2f5d281f71cb_94937a47d5768d7f,
  title = {An iterative sphere decoding detection algorithm in a MIMO-OFDM system},
  author = {Lili Guo},
  year = {2011},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=HEBG201104022},
  howpublished = {Harbin Gongcheng Daxue Xuebao/Journal of Harbin Engineering University},
  annotation = {中文辅助译名：MIMO-OFDM系统中的迭代球解码检测算法},
  abstract = {In a MIMO-OFDM system,the coding and the diversity gains can be obtained easily by using the BICM-ID method.However,the increase in complexity is especially significant for higher order constellations and transmitting antennas.The complexity of detection will increase exponentially with the numbers of constellations and transmitting antennas.In the following research,in order to reduce the complexity due to the iteration,the decoding process was replaced with MAX-LOG-MAP to approximate the original MAP decoding performance,and posteriori information was applied from the decoder to modify a list of candidate points in the constellation.The simulation result shows that,compared to the conventional algorithm,the iterative sphere decoding detection algorithm can obviously reduce the complexity of the iterative decoding algorithm,the spherical radius of the proposed algorithm can adaptively change with the channel parameters and the size of the modulation order;it can efficiently reduce the complexity of decoding with only a slight loss in performance.},
}

@misc{panorama_2f5d281f71cb_3ba29065fac7a2a5,
  title = {Performance of adaptive Multi-user MIMO system with imperfect feedback},
  author = {Lili Guo and Ruichun Wang and Dian‐Wu Yue},
  year = {2010},
  doi = {10.1109/cmce.2010.5610122},
  url = {https://doi.org/10.1109/cmce.2010.5610122},
  howpublished = {International Conference on Computer, Mechatronics, Control and Electronic Engineering},
  annotation = {中文辅助译名：不完善反馈的自适应多用户MIMO系统性能},
  abstract = {Cross-layer breaks away from traditional network design, which can adapt to the dynamically variable wireless channel characters to improve the wireless communication system performance. In this paper, an adaptive cross-layer scheme (Beamforming-MIMO) for multi-user system is proposed, which combine multilevel adaptive modulation (AM) at physical layer with truncated automatic repeat request (ARQ) and multi-user diversity at data link layer, and feed backing modulation mode, ARQ request and transmit weight vector from receiver. This paper derives close-form expressions of the system spectral efficiency under outdated feedback. It shows by simulation that for single-user system, compared to other cross-layer schemes, the proposed cross-layer scheme can achieve better performance. And under outdated feedback, we also analyze the impact of delay-time; transmit antenna and number of mobile user on the performance of the multi-user system.},
}

@misc{panorama_2f5d281f71cb_f844b1a2db550cfc,
  title = {Modeling intensity-modulated characteristics of inclined-fiber receiving distance sensor with single mode illumination},
  author = {Zhi Zhong and Huan Peng and Mingguang Shan and Lili Guo},
  year = {2010},
  doi = {10.1117/12.869395},
  url = {https://doi.org/10.1117/12.869395},
  howpublished = {Proceedings of SPIE, the International Society for Optical Engineering/Proceedings of SPIE},
  annotation = {中文辅助译名：单模照明倾斜光纤接收距离传感器的强度调制特性建模},
  abstract = {In order to study the reflective intensity-modulated characteristics of a two fiber distance sensor with one normal single mode fiber for illuminating and one inclined multimode fiber for receiving, a rigorous theoretical mode using approximating the illumination light exiting the single mode fiber as having a Gaussian intensity profile is established to describe the influence of the inclination angle of receiving fiber on the intensity-modulated characteristics of the sensor. Numerical simulation results indicate that the distance sensitivity of the sensor gets higher as the inclination angle increases and the sensitivity at an angle of 4° is nearly 7.65 times that of the sensitivity with 0°. Meanwhile, the blind region, linear range and peak position also get shifted in comparison with the parallel fiber distance sensor, and the performance of the fiber distance sensor can be optimized by adjusting the inclination angle of the receiving fiber.},
}

@misc{panorama_2f5d281f71cb_883ab451775ed015,
  title = {A frequency domain algorithm of UWB channel estimation based on Recursive Least Squares},
  author = {Lili Guo and Zhuo Yang and Zhiguo Sun},
  year = {2010},
  doi = {10.1109/icct.2010.5689175},
  url = {https://doi.org/10.1109/icct.2010.5689175},
  howpublished = {IEEE International Conference on Communication Technology (ICCT)},
  annotation = {中文辅助译名：基于递归最小二乘的UWB信道估计频域算法},
  abstract = {We propose an ultra-wide band channel estimation algorithm which is applicable to TH-PPM modulation. The algorithm is based on features of the frequency domain and Recursive Least Squares to estimate channel parameters. The algorithm has low complexity and can easily be applied to engineering. The algorithm can estimate multiple channels with no ambiguity in either the amplitude or the phase of the estimated channel. Simulation results show an SNR gain of 2dB around the BER of 10−4, compared to ML channel estimation.},
}

@misc{panorama_2f5d281f71cb_c54db55335d52806,
  title = {Automatic generation of test cases for payload system based on improved OOPN},
  author = {Lili Guo},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=XTYD201011047},
  howpublished = {Systems engineering and electronics},
  annotation = {中文辅助译名：基于改进OOPN的有效载荷系统测试用例自动生成},
  abstract = {In order to generate the test cases of payload system automatically,a new reasoning method based on improved object oriented Petri net(IOOPN) model is proposed,which is based on a deep investigation of mission characteristics and the developing tendency of test technology.This method presents the rules of identifying work modes of objects,generates the test sequences of a single object by heuristic search,and realizes the algorithm of generating systematic test sequences by introducing a time staff.Thus it can meet the requirement of the payload system test and improve the efficiency and level of test.It has been successfully applied to the scientific practice of a certain satellite.},
}

@misc{panorama_2f5d281f71cb_4dddea8a030e23f4,
  title = {A rewinding approach to motion planning for acrobot based on virtual friction},
  author = {Jinhua She and Xuzhi Lai and Xin Xin and Lili Guo},
  year = {2010},
  doi = {10.1109/icit.2010.5472756},
  url = {https://doi.org/10.1109/icit.2010.5472756},
  howpublished = {IEEE International Conference on Industrial Technology (ICIT)},
  annotation = {中文辅助译名：基于虚拟摩擦力的杂技机器人运动规划倒带方法},
  abstract = {Based on the concept of kinematical controllability, we can decouple the trajectory planning of an acrobot into two steps: finding a path in a configuration space and time-scaling it. In this paper, we apply this concept and plan the swing-up motion of an acrobot based on its falling-down motion. First, the initial state of the acrobot is set to the unstable upright equilibrium position, and the movement from this state to the stable downward equilibrium position is produced by introducing an artificial damping torque. A method to obtaining an optimal damping torque is presented. Then, the reference trajectory for the swing-up motion is taken to be the reverse of the falling-down motion. The validity of this method is demonstrated through simulations.},
}

@misc{panorama_2f5d281f71cb_1b94bf2759240507,
  title = {Effect of structural parameters on the performance of fiber distance sensor with single mode illumination and inclined-fiber receiving},
  author = {Zhi Zhong and Huan Peng and Mingguang Shan and Lili Guo},
  year = {2010},
  doi = {10.1117/12.870099},
  url = {https://doi.org/10.1117/12.870099},
  howpublished = {Proceedings of SPIE, the International Society for Optical Engineering/Proceedings of SPIE},
  annotation = {中文辅助译名：结构参数对单模照明斜光纤接收光纤距离传感器性能的影响},
  abstract = {In order to study the effect of structural parameters on the performance of fiber distance sensor with one normal single mode fiber for illuminating and one inclined multimode fiber for receiving, a theoretical power-distance model is established to describe the influence of the inclination fiber angle, the separation distance between the two fiber tips, the offset distance between the two fiber tips and/or reflector angle on the modulation performance of the fiber distance sensor. Numerical simulation results indicate that for the sensitivity of the sensor, it increases as the inclination fiber angle increases, the separation distance decreases, the offset distance decreases and/or the reflector angle increases. For the linear region, it increases as the separation distance increases, and/or the reflector angle decreases, however, it change less obviously as the inclination fiber angle increases, and even remains unchanged as the offset distance is changeable. For the dead zone, it decreases as the separation distance decreases, and/or the offset distance increases, and the study would help the design of the inclined-fiber receiving distance sensor to the desired modulation performance.},
}

@misc{panorama_2f5d281f71cb_37b63c8b010c4b3d,
  title = {Multi-objective Optimization of Cognitive Radio in Clonal Selection Quantum Genetic Algorithm},
  author = {Huan Wang and Lili Guo},
  year = {2010},
  doi = {10.1109/icmtma.2010.19},
  url = {https://doi.org/10.1109/icmtma.2010.19},
  howpublished = {International Conference on Measuring Technology and Mechatronics Automation (ICMTMA)},
  annotation = {中文辅助译名：克隆选择量子遗传算法中认知无线电的多目标优化},
  abstract = {In this paper, the authors make optimization to multi-objective function of cognitive radio with the help of quantum genetic algorithm(QGA) based on clonal selection. And a clonal selection quantum (CSQ) has been put forward by quantum genetic algorithm and immune clonal selection, and the algorithm have been improved. It produces encouraging results when we apply the algorithm to the function optimization of cognitive radio with the introduction of simulation in the dynamic parameter set-up.},
}

@misc{panorama_2f5d281f71cb_a9e6e8d05dbcf6dc,
  title = {Research on gas image detection sensor using optical fiber interference cavity},
  author = {Lili Guo},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=CGQJ201006016},
  howpublished = {Transducer and Microsystem Technologies},
  annotation = {中文辅助译名：利用光纤干涉腔的气体图像检测传感器的研究},
  abstract = {Aimed at the difficult problem of infrared absorption gas sensor that the tunable lights is expensive,modulation and demodulation scheme is complex and reliability is low.Mach-Zehnder interferometer with fiber air cavity is adopted to detect gas.The principle is CH4 cause air index of refraction change,interference lights take shape interference stripes on white board by Young's interference,the parameter of stripe changes proportional to the volume fraction.To analyze change in stripes,information are collected by camera in high-accuracy measurement,gas volume fraction is calculated by image analysis software and proceeds to long-range data transmission by wireless and fiber-optic network.The experiment results show that the method is of high sensitivity and precision,good reliability,so that optical gas sensor can be used widely.},
}

@misc{panorama_2f5d281f71cb_d22e578fd2445a10,
  title = {Performance analysis for UWB system based on Parallel Combinatory Spread Spectrum using different pseudo-noise sequences},
  author = {Xiaofei Jiang and Lili Guo and Bailing Wang and Lin Qi},
  year = {2010},
  doi = {10.1109/icetc.2010.5529700},
  url = {https://doi.org/10.1109/icetc.2010.5529700},
  howpublished = {International Conference on Education Technology and Computer},
  annotation = {中文辅助译名：使用不同伪噪声序列的基于并行组合扩频的UWB系统性能分析},
  abstract = {Ultra Wide Bandwidth (UWB) system based on Parallel Combinatory Spread Spectrum (PCSS-UWB), combined low interception Probability of UWB system with high data transmission efficiency of Parallel Combinatory Spread Spectrum System, can fulfill the needs of modern communication system in efficiency and security. Through the simulation, it shows that PCSS-UWB system has a better bit error rate (BER) Performance under the additive white Gaussian noise (AWGN) background. Furthermore, the BER performance of PCSS-UWB system by using different pseudo-noise sequences is analyzed and the result proves the BER performance is related to the period of pseudo-noise sequences, but not the categories of pseudo-noise sequence.},
}

@misc{panorama_2f5d281f71cb_f037a523cdc1b036,
  title = {Complex Position Code Parallel Combinatory Spread Spectrum Communication System with FEC Technique},
  author = {Beiming Li and Lili Guo and Qi Xiao-Dong},
  year = {2009},
  doi = {10.1109/cmc.2009.145},
  url = {https://doi.org/10.1109/cmc.2009.145},
  howpublished = {来源待核},
  annotation = {中文辅助译名：采用FEC技术的复位置码并行组合扩频通信系统},
  abstract = {Complex position code parallel combinatory spread spectrum (CPC/PC/SS) communication system with forward error correction (FEC) coding scheme is proposed in this paper, and performances are analyzed. CPC/PC/SS system with FEC coding scheme can be designed to have higher data transmission capability, even several times compared to ordinary PC/SS system on Gaussian channel.The proposed FEC coding is separately applied to the combination data of orthogonal codes and the state data of their transmitting orthogonal code, and less redundant FEC code is enough to the state data of orthogonal codes by this coding scheme. Therefore, the total information rate exceeds that offered by the conventional overall FEC coding is applied. Simulation results show that the error rate performance of the CPC/PC/SS systems equipped with the proposed FEC coding is lower than conventional PC/SS system.},
}

@misc{panorama_2f5d281f71cb_024b7e96cdb7ba7f,
  title = {Improved detection algorithm for parallel combinatory spread spectrum signals},
  author = {Lili Guo},
  year = {2009},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=HEBG200902019},
  howpublished = {Harbin Gongcheng Daxue Xuebao/Journal of Harbin Engineering University},
  annotation = {中文辅助译名：改进的并行组合扩频信号检测算法},
  abstract = {An improved algorithm was proposed to detect parallel combinatory spread spectrum(PCSS) signals.It was designed to reduce the influence on the performance of detection algorithms of imperfect correlation characteristics between the spread sequences and noise,as well as of interference in the channel.Improvements were made in the algorithms by using a cyclic correlation value instead of a correlation value as a decision variable in common algorithms.The algorithm apply the cyclic correlation characteristic discrepancy between parallel combinatory spread spectrum(PCSS) signals and noise as well as interference to suppress their influence on the performance of detection algorithms.Theoretical analysis and experimental results indicate that the improved algorithm based on cyclic correlation detection have better performance.However,the complexity of the algorithm is increased,limiting its applicability to burst communication systems.It is more suited for use in non-real-time communication systems based on the store-processing model.},
}

@misc{panorama_2f5d281f71cb_2eab47053fdd18de,
  title = {Performance Studies of UWB Communication System Based on Parallel Combinatory Spread Spectrum},
  author = {Lin Qi and Lili Guo and Xiaofei Jiang},
  year = {2009},
  doi = {10.1109/wicom.2009.5305792},
  url = {https://doi.org/10.1109/wicom.2009.5305792},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：基于并行组合扩频的UWB通信系统性能研究},
  abstract = {A new ultra wideband (UWB) communication system based on parallel combinatory spread spectrum (PCSS) is proposed in this paper. The proposed system have the advantages both of PCSS system and UWB system, such as the high efficiency of information transmission and excellent secret property. Thus, the proposed system can meet the needs of efficiency and security as the same time in the modern communication system. The simulation model is provided and the performance is analyzed. The simulation results indicate that the UWB system based on PCSS has a better bit error rate (BER) performance.},
}

@misc{panorama_2f5d281f71cb_89148cb360f4f216,
  title = {Blind Estimation of Multicarrier CDMA Sub-Carrier Frequencies Based on the High-Order Cyclic Cumulants},
  author = {Zhiming Yu and Lili Guo and Lin Qi},
  year = {2009},
  doi = {10.1109/wicom.2009.5304958},
  url = {https://doi.org/10.1109/wicom.2009.5304958},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：基于高阶循环累积量的多载波CDMA子载波频率盲估计},
  abstract = {This paper proposed a method to estimate sub-carriers frequencies of multi-carrier CDMA signals utilizing higher-order cyclic cumulants, based on the cyclic stationary characteristic of multi-carrier CDMA signals. Because higher-order cyclic cumulants can effectively suppress stationary noise and non-stationary Gaussian noise, through theoretical analysis, we can prove that the higher-order cyclic cumulant of the multi-carrier CDMA signal using BPSK/QPSK modulation only exist in the cycle frequency of sub-carrier frequency under the above noise background, so it can estimate the sub-carrier frequencies of multi-carrier CDMA signals by detecting the peaks of cyclic frequencies. Theoretical analysis and simulation results have verified the correctness and effectiveness of the algorithm.},
}

@misc{panorama_2f5d281f71cb_1eb80b597d299378,
  title = {Study of GPS Nulling Antenna Based on Space-Time Processing Algorithm},
  author = {Jianhong Xiang and Lili Guo and Qingling Liu},
  year = {2009},
  doi = {10.1109/wicom.2009.5302363},
  url = {https://doi.org/10.1109/wicom.2009.5302363},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：基于时空处理算法的GPS调零天线研究},
  abstract = {Global Positioning System (GPS) receiver is confronted with the serious problem what is the bad electromagnetism environment, especially, the wideband interference. Currently, nulling antenna technology is the most effective way to reject the broadband interference. The FLMS algorithm of space-time adaptive processor (STAP) is developed for the robust array antenna, and is used to estimate the beamformer weighting vector adaptively with a low computational complexity. The result of simulation demonstrates the FLMS algorithm can well suppress the broadband jammer and improve the performance of GPS receiver.},
}

@misc{panorama_2f5d281f71cb_32242e3397d39d84,
  title = {Iterative Channel Estimation Algorithm for OFDM Systems with Bit-Interleaving},
  author = {Chi Zhang and Lili Guo and Zhongmin Zhang},
  year = {2009},
  doi = {10.1109/wicom.2009.5302148},
  url = {https://doi.org/10.1109/wicom.2009.5302148},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：具有比特交织的 OFDM 系统的迭代信道估计算法},
  abstract = {A new iterative channel estimation algorithm for orthogonal frequency division multiplexing (OFDM) systems was proposed based on maximum-likelihood (ML) by using a specially designed training symbol.The proposed channel estimation utilizes the hard-decision information provided by the decoder of bit-interleaved coded modulation (BICM) to exchange the information between the channel estimator and the decoder. In BICM-OFDM systems, the simulation results show that the proposed algorithm not only reduces the number of the training symbols but also improves the accuracy of communication system comparing with conventional algorithms.},
}

@misc{panorama_2f5d281f71cb_21e595ce63b59c78,
  title = {Narrow-band Interference Suppression in DSSS Systems Using Efficient Adaptive Filters},
  author = {Jiangzhi Fu and Lili Guo and Hongqiao Yang and Zhixue Han},
  year = {2009},
  doi = {10.1109/cmc.2009.355},
  url = {https://doi.org/10.1109/cmc.2009.355},
  howpublished = {来源待核},
  annotation = {中文辅助译名：使用高效自适应滤波器抑制 DSSS 系统中的窄带干扰},
  abstract = {In this paper, we present a novel adaptive interference suppression method by combining with time-domain filters and frequency-domain filters. Demonstrated by simulation results, the method can significantly improve the performance of DSSS receiver serving at the narrow-band interference environment. The improvement of resulting SNR after NBI suppression will further enhance along with the increasing of interference intensities. Compared with the simple interference nulling and amplitude limiting processing, the proposed method has less complexity and better real-time performance without losing much signal performance.},
}

@misc{panorama_2f5d281f71cb_512afc418556bd6f,
  title = {A New Design for Improving BER Performance for CI/MC-CDMA},
  author = {Zhongmin Zhang and Lili Guo and Yongzhi Yu},
  year = {2009},
  doi = {10.1109/cit.2009.24},
  url = {https://doi.org/10.1109/cit.2009.24},
  howpublished = {IEEE International Conference on Computer and Information Technology (CIT)},
  annotation = {中文辅助译名：提高 CI/MC-CDMA BER 性能的新设计},
  abstract = {The CI/MC-CDMA systems is an adoption to Carrier Interferometry and actions to spreading codes in the MC-CDMA systems,CI codes can raise the capacity of system, lower peak average power ratio. In this paper use offset CI codes to transmit redundancy bits generated via channel coder, It is shown that BER performance of CI/MC-CDMA systems can be dramatically improved via channel coder, while still maintaining high throughputs.},
}

@misc{panorama_2f5d281f71cb_0bc5db0313007cb2,
  title = {A back-off smoothing algorithm of language model based on mutual information},
  author = {Lili Guo},
  year = {2009},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=YYKJ200904011},
  howpublished = {Applied science and technology},
  annotation = {中文辅助译名：一种基于互信息的语言模型退避平滑算法},
  abstract = {A back-off smoothing algorithm based on mutual information for bigram model was presented. This algorithm not only analyzes the coupling relations between words from the perspective of mutual information, discounts the probabilities differently according to the mutual information of each bigram in the model, but also takes advantage of the low-order model to compensate for zero-probability case. Based on a very small degree of confusion principle, this algorithm was proved to be reasonable. For unseen events, the probabilities were back off to low-order model. Furthermore, the model parameters were estimated by minimizing the perplexity. In testing corpus of different domains, all the perplexities of the proposed smoothing algorithm decline more than 20% compared with the traditional Katz algorithm.},
}

@misc{panorama_2f5d281f71cb_4813a98cc2bb85c0,
