  annotation = {中文辅助译名：基于OFDM的中压电力线通信更低峰均比设计},
  abstract = {The main disadvantage of OFDM system is the high ratio of Peak to Average Power,which is usually concluded to PAPR problem.To solve the problem,it is necessary for the part in the system to posses a high linear dynamic range,on the purpose to avoid the spectrum diffuse caused by the signal distortion,and the miscoding rate increase caused by the band-in distortion,thereby the complexity of the design and the cost will be increased.To take the problems of engineering implementation complexity and the resources utilization into consideration,a novel chip design method is studied to reduce the PAPR of OFDM signals using the OFDM technique in medium-voltage power line communication.This design not only costs less expense but also efficiently lowers the PAPR,and is as well as easy to be implemented.},
}

@misc{panorama_2f5d281f71cb_1a629d2298c156a7,
