@misc{panorama_7dab343da17a_f6e6b1c1825176d8,
  title = {Can We Forecast Daily Oil Futures Prices? Experimental Evidence from Convolutional Neural Networks},
  author = {Zhaojie Luo and Xiaojing Cai and Katsuyuki Tanaka and Tetsuya Takiguchi and Takuji Kinkyo and Shigeyuki Hamori},
  year = {2019},
  doi = {10.3390/jrfm12010009},
  url = {http://dx.doi.org/10.3390/jrfm12010009},
  howpublished = {Journal of risk and financial management},
  annotation = {中文辅助译名：我们可以预测每日石油期货价格吗？卷积神经网络的实验证据},
  abstract = {This paper proposes a novel approach, based on convolutional neural network (CNN) models, that forecasts the short-term crude oil futures prices with good performance. In our study, we confirm that artificial intelligence (AI)-based deep-learning approaches can provide more accurate forecasts of short-term oil prices than those of the benchmark Naive Forecast (NF) model. We also provide strong evidence that CNN models with matrix inputs are better at short-term prediction than neural network (NN) models with single-vector input, which indicates that strengthening the dependence of inputs and providing more useful information can improve short-term forecasting performance.},
}

