@misc{panorama_7dab343da17a_9c4fa1f5267b8ebe,
  title = {MPDD-AVG: Multimodal Personality-Aware Depression Detection via Audio-Visual Interview and Gait Analysis},
  author = {Changzeng Fu and Yiming Zhang and Ming Shang and Shiqi Zhao and Alexis Meneses and Zhaojie Luo and Chaoran Liu and Yuichiro Yoshikawa and Hiroshi Ishiguro and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.1145/3767308.3836616},
  url = {https://doi.org/10.1145/3767308.3836616},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：MPDD-AVG：通过视听访谈和步态分析进行多模式人格感知抑郁症检测},
  abstract = {Despite growing interest in automated depression detection, existing benchmarks largely rely on conversational modalities, overlooking gait-based psychomotor cues and individual heterogeneity. The MPDD-AVG 2026 Challenge addresses these limitations by combining audio-visual interviews, wearable IMU-based gait sequences, personality and demographic annotations across Young and Elderly cohorts, each comprising 110 participants. We present the official baseline which independently encodes audio, visual, and gait sequences and fuses them with participant-level contextual representations. The benchmark includes three settings, i.e., Audio-Visual with Personality (A-V+P), Audio-Visual-Gait with Personality (A-V-G+P), and Gait with Personality (G+P), for binary/ternary classification, and PHQ-9 regression under a shared evaluation protocol. Results show that gait provides complementary information in several binary-classification settings and that modality effectiveness varies across age groups.},
}

