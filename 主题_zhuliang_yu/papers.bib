@misc{zhuliang_yu_6e39c2a5f9ce6b5d,
  title = {DOA estimation using two closely spaced microphones},
  author = {Zhuliang Yu and Susanto Rahardja},
  year = {2003},
  doi = {10.1109/iscas.2002.1010957},
  url = {https://doi.org/10.1109/iscas.2002.1010957},
  howpublished = {IEEE International Symposium on Circuits and Systems proceedings},
  annotation = {中文辅助译名：使用两个间隔很近的麦克风进行 DOA 估计},
  abstract = {A new method of estimation of DOA (direction of arrival) using an array of two closely spaced microphones is proposed in this paper. The differential properties of the propagating sound wave and adaptive signal processing are used to form a back-to-back cardioid pattern which is an adaptive first-order differential microphone array to estimate the DOA and track the moving source. Unlike other DOA technologies, the distance between the two microphones is very small. As such, the method is useful for DOA applications that have strict space constraints.},
}

