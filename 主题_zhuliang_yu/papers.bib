  annotation = {中文辅助译名：用于运动图像信号分类的权重共享的注意力时间卷积网络},
  abstract = {Objective: Brain-computer interfaces (BCIs) offer a non-muscular communication pathway by enabling users to interact with external devices through brain signals alone. A widely adopted BCI paradigm is based on motor imagery (MI), where individuals imagine specific limb movements without actual muscle activity. Electroencephalography (EEG) is commonly employed to capture these MI-induced neural signals, which are then processed and classified to infer the user's intended action. However, the inherent low signal-to-noise ratio of EEG data, along with significant intersubject variability, poses substantial challenges for accurate and robust classification. Methods: Deep learning approaches, particularly convolutional neural networks (CNNs), have recently demonstrated promising results in MI EEG decoding. Among them, the Attention Temporal Convolutional Network (ATCNet) has shown notable classification performance. In this work, we propose ATCNet with Weight Sharing (ATCNet-WS), an improved architecture that incorporates techniques including weight sharing and cosine annealing learning rate schedule with warm restarts to enhance classification accuracy. Results: Experimental evaluation demonstrates that ATCNet-WS achieves a subjectdependent four-class classification accuracy of 87.06% on the BCI Competition IV 2a dataset, and subject-dependent two-class classification accuracy of 87.85% on the BCI Competition IV 2b dataset, both outperforming current state-of-the-art methods. Con},
}

@misc{panorama_xiaofen_xing_81ed5e430ef30b2d,
