@misc{zhuliang_yu_c961065fc12d8676,
  title = {Supervised Contrastive Learning Enables High Performance P300 Spelling with Minimal Calibration},
  author = {Tianyou Yu and Jiaoyang Xin and Wei Gao and Zhuliang Yu and Yuanqing Li and Zhenghui Gu and Jun Xiao},
  year = {2026},
  doi = {10.1109/jbhi.2026.3712320},
  url = {https://doi.org/10.1109/jbhi.2026.3712320},
  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：监督对比学习可通过最少的校准实现高性能 P300 拼写},
  abstract = {The P300 speller is a widely adopted brain computer interface (BCI) paradigm that enables hands free character selection based on event-related potentials elicited through an oddball stimulus paradigm. Despite its utility, the system's performance is often constrained by the low signal-to-noise ratio and complex spatiotemporal characteristics of EEG signals, especially when only a limited number of repetitions or labeled samples are available. Moreover, substantial within-session calibration is typically required to achieve reliable decoding before online spelling, posing a major practical barrier. To tackle these challenges, we propose SCL-EEGMixer, a lightweight, end to-end neural architecture that combines a convolutional mixer network with supervised contrastive learning. The model extracts discriminative spatiotemporal representations via the convolutional mixer and enhances learning with a hybrid loss that fuses cross-entropy and supervised contrastive objectives. This design promotes intra-class compactness and inter-class separability, enabling robust learning from scarce labeled data. Extensive evaluations on both a public benchmark and a self-collected dataset demonstrate that SCL-EEGMixer consistently outperforms representative baselines in both binary P300 classification and character recognition tasks under a within-session protocol. Notably, it maintains high accuracy and information transfer rate even when trained with as few as one or two calibration character},
}

@misc{yuanqing_li_6921708d2326c7e1,
  title = {Efficient Sleep Staging With Bayesian Uncertainty-Guided Active Learning},
  author = {Tianyou Yu and Rui Huang and Fei Wang and Jun Zhang and Wei Wu and Zhuliang Yu and Yuanqing Li and Jun Xiao and Zhenghui Gu},
  year = {2026},
  doi = {10.1109/JBHI.2026.3678608},
  url = {https://doi.org/10.1109/JBHI.2026.3678608},
  howpublished = {IEEE J. Biomed. Health Informatics},
  annotation = {中文辅助译名：利用贝叶斯不确定性引导的主动学习进行有效的睡眠分期},
  abstract = {Automated sleep staging is essential for large-scale and home-based sleep monitoring; however, in routine clinical practice, sleep annotation remains largely dependent on experienced experts performing time-consuming and labor-intensive manual scoring. Existing automatic systems often struggle to adapt reliably to new subjects, limiting their clinical adoption and reinforcing the reliance on expert review. This creates a strong demand for adaptive and efficient sleep staging systems that can substantially reduce annotation workload while preserving expert-level accuracy. We propose BayesSleepNet, a novel framework that integrates Bayesian uncertainty quantification with active learning for adaptive sleep staging. BayesSleepNet employs principled Bayesian modeling by placing distributions over network weights and performing Monte Carlo sampling at inference, enabling explicit quantification of model (epistemic) uncertainty. These uncertainty estimates drive a two-stage sample selection strategy that first fine-tunes the model using representative epochs and subsequently prioritizes persistently uncertain samples for expert review. Across four public sleep datasets, BayesSleepNet consistently improves performance-by 7.60% in accuracy, 8.27% in macro-F1, and 0.104 in Cohen's $\kappa$-while requiring manual annotation of only 20% of data from new subjects. Despite its adaptive learning capability, BayesSleepNet remains computationally lightweight, using substantially fewer parame},
}

@misc{zhuliang_yu_ef0bbc6006d09af1,
  title = {Fault-Tolerant Control for Redundant Manipulators via Feasible Space Expansion Strategy: A Dynamic Desensitization Approach},
  author = {Huanwei Zhang and Zhuliang Yu and Zhenghui Gu and Siyuan Chen},
  year = {2026},
  doi = {10.1109/tii.2026.3728132},
  url = {https://doi.org/10.1109/tii.2026.3728132},
  howpublished = {IEEE Transactions on Industrial Informatics},
  annotation = {中文辅助译名：通过可行的空间扩展策略实现冗余机械臂的容错控制：动态脱敏方法},
  abstract = {To address the infeasibility issue of conventional fault-tolerant control methods for redundant manipulators under joint lockup, this article proposes a fault-tolerant recurrent neural network based on a feasible space expansion strategy fault-tolerant recurrent neural network based on a feasible space expansion strategy (FSES-FTRNN). By introducing a virtual scaling variable, the proposed method dynamically reconstructs task constraints, transforming the original infeasible optimization problem into a feasible one while strictly preserving safety constraints. Compared with traditional approaches that rely solely on residual redundancy and fail when constraint spaces become disjoint, the proposed method preserves the intended geometric path through adaptive constraint-space expansion and online execution-rate scaling. Experiments on a six-degree-of-freedom (6-DOF) Kinova Jaco$^2$manipulator under progressive multijoint lockup scenarios demonstrate complete geometric-path execution in cases where conventional quadratic programming methods lose feasibility, while maintaining high path-tracking accuracy under varying constraint intensities. These results indicate that the proposed approach provides a practical velocity-level fault-tolerant command-generation scheme for redundant manipulators under high-impact joint-lockup conditions.},
}

@misc{zhuliang_yu_bf27fa356aa7a488,
  title = {A Hybrid Periodic Decomposition-Based Network for MI-EEG Decoding},
  author = {Zhenghui Gu and Tianyou Yu and Jun Zhang and Zhu Liang Yu and Zexiong Shao},
  year = {2026},
  doi = {10.1109/LSP.2026.3721440},
  url = {https://doi.org/10.1109/LSP.2026.3721440},
  howpublished = {IEEE Signal Process. Lett.},
  annotation = {中文辅助译名：用于 MI-EEG 解码的混合周期性分解网络},
  abstract = {Motor imagery-electroencephalogram (MI-EEG) decoding plays a crucial role in the development of motor imagery-brain computer interfaces (MI-BCIs). The superposition of multiple frequency components gives rise to hybrid periodicity in MI-EEG signals. However, most existing decoding methods cannot effectively disentangle MI-related periodic patterns from such signals and lack a unified framework for extracting temporal features across arbitrary temporal distances, thereby limiting further improvements in decoding performance. To address these limitations, this study proposes Hybrid Periodic Seasonal-Trend Decomposition Network (HPSTDNet). HPSTDNet introduces a novel 2D image perspective for the seasonal–trend decomposition of MI-EEG signals, thereby disentangling MI-related temporal patterns from MI-EEG signals with hybrid periodicity. Subsequently, HPSTDNet introduces a novel parallel three-branch architecture tailored to the resulting 2D MI-EEG representations to extract temporal features across arbitrary temporal distances. HPSTDNet achieved decoding accuracies of 81.17%, 88.35%, and 72.19% on the three public MI-EEG datasets: BCI Competition IV 2a, BCI Competition IV 2b, and OpenBMI, respectively, outperforming all representative baselines. These results support the effectiveness of disentangling MI-related periodic patterns from signals with complex temporal dynamics.},
}

