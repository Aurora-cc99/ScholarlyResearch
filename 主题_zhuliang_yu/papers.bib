  abstract = {The goal of class incremental learning (CIL) is to adapt the model to the emergence of new classes without forgetting the old classes. The pre training model (PTM) has a high degree of generalization, which can better overcome the forgetting of knowledge in incremental learning. This paper studies how to better balance the adaptability and stability of the PTM. Firstly, we propose a feature classifier decoupling fine-tuning (FCDFT) method. Experimental results show that in the PTM fine-tuning, in one epoch, the two ways of training the classifier twice and improving the learning rate of the classifier can greatly accelerate the speed of model training, while reducing the learning rate of the feature extractor can greatly improve the stability of the model. Secondly, we propose a pseudo feature generation method based on feature translation. This method uses the architecture of fixed feature extractor and pseudo feature generator to effectively solve the problem of old knowledge forgetting in incremental learning. Finally, two PTMs based on Vision Transformer (ViT) are tested in Split Cifar-100 and Split Imagenet-R, and the effect of image classification is better than other incremental methods based on PTM.},
}

@misc{zhuliang_yu_fe2fdab1e7d51e18,
