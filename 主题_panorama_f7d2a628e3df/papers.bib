@misc{panorama_f7d2a628e3df_8c5dbc24c77bfe48,
  title = {Customizing General-Purpose Foundation Models for Medical Report Generation},
  author = {Bang Yang and Asif Raza and Yuexian Zou and Tong Zhang},
  year = {2023},
