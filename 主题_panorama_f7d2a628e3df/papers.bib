  year = {2025},
  doi = {10.1016/j.imed.2024.11.006},
  url = {https://doi.org/10.1016/j.imed.2024.11.006},
  howpublished = {Intelligent Medicine},
  annotation = {中文辅助译名：人工智能在冠状动脉CT血管造影研究与应用共识},
  abstract = {Coronary computed tomography angiography (CCTA) enables noninvasively assessment of the luminal stenosis and atherosclerotic plaque components, which has become the first-line technique for evaluating coronary artery disease. Artificial intelligence (AI) has the potential to revolutionize the entire CCTA workflow. However, it is crucial to evaluate the effectiveness and feasibility of AI algorithms before their deployment in practice. This expert consensus proposes three fundamental elements of research designs of AI in the CCTA field and offers corresponding recommendations. The consensus also reviews the existing evidence on AI applications in CCTA and provides recommendations on the current clinical applications of AI, including image acquisition and reconstruction, post-processing, diagnosis, prognostic prediction, guiding prevention and treatment, and cardiovascular disease prevention.},
}

