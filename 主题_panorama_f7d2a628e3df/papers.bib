@misc{panorama_f7d2a628e3df_6e76ba9be5f9689e,
  title = {Regional Tourism Resilience under Crisis Impacts: The Cases of Yangtze River Delta and Pearl River Delta},
  author = {Yi Liu and Liaofan Chen and Fangfei Han and Tong Zhang},
