@misc{panorama_f7d2a628e3df_8d1ce43583b3563b,
  title = {Statistical computational methods for mixed-signal performance metrics under process variations and noise models},
  author = {Mani Soma and Tong Zhang and Jacques Christophe Rudell},
  year = {2016},
  doi = {10.1109/newcas.2016.7604798},
  url = {https://doi.org/10.1109/newcas.2016.7604798},
  howpublished = {IEEE International New Circuits and Systems Conference (NEWCAS)},
  annotation = {中文辅助译名：过程变化和噪声模型下混合信号性能指标的统计计算方法},
  abstract = {This paper presents a method to compute the combined effects of process variations and various noise models in predicting performance metrics of analog and mixed-signal integrated circuits and subsystems. Without resorting to the traditional Monte Carlo simulation and specialized noise simulators, the method incorporates both behavioral simulation and statistical simulation to gain speed while ensuring reasonable accuracy in the performance predictions. A case study based on a published 60-GHz polyphase filter illustrates the method. The computed results are compared to the measured chip data to demonstrate the prediction accuracy. The method is intended to be used in the early design stages to select appropriate system architecture and blocks for lower-level circuit implementations.},
}

