@misc{panorama_f7d2a628e3df_17682920f3bef3f8,
  title = {A data pre-processing method for testability modeling based on first-order dependency integrated model},
  author = {Junyou Shi and Tong Zhang and Fengwu Wang},
  year = {2012},
  doi = {10.1109/phm.2012.6228920},
