@misc{rosalind_picard_ad3108483cef7a9e,
  title = {Empatica E3 - A wearable wireless multi-sensor device for real-time computerized biofeedback and data acquisition},
  author = {Maurizio Garbarino and Matteo Lai and Simone Tognetti and Daniel Bender and Rosalind W. Picard},
  year = {2014},
