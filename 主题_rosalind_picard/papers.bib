@misc{rosalind_picard_7f3578343ecfd689,
  title = {Designing an Affective Mobile Probe to Measure Smile Dynamics in Depression},
  author = {Craig Ferguson and Richard Davidson and Christine D. Wilson-Mendenhall and Hahrin Jung and Nelson Hidalgo Julia and Gabriela Valdivia and Simon Goldberg and Caroline Swords and Wendy Lau and Raquel Tatar and Molly Schaefer and Joshua Angulo Lopez and Robert Lewis and Rosalind W. Picard},
  year = {2026},
  doi = {10.1145/3772318.3791208},
  url = {https://doi.org/10.1145/3772318.3791208},
  howpublished = {CHI},
  annotation = {中文辅助译名：设计情感移动探针来测量抑郁症患者的微笑动态},
  abstract = {Depression is a complex disorder for which there is growing interest in identifying objective behavioral markers that measure precise symptoms, such as anhedonia and blunted emotional reactivity. This study explores the feasibility of using smile and smirk expression dynamics, captured through our novel stimulus-based mobile affective probe, as candidate digital biomarkers of depression severity within a large-scale mobile health intervention trial, BeWell. Data from 684 BeWell participants (2,702 observations) are analyzed longitudinally for 16 weeks, comparing their PHQ-8 survey scores with their facial responses to short videos intended to elicit smiles. Mixed-effects models reveal that higher maximum Duchenne smile intensity in reaction to liked stimuli is associated with lower depression scores over time at both within- and between-person levels. We additionally share insights from our tool, including ease of use, perceptions of the stimulus, and technical challenges, which offer considerations for the future development of stimulus-based affect probes in real-world settings.},
}

