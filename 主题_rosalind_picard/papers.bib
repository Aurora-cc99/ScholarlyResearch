  howpublished = {ICMI},
  annotation = {中文辅助译名：面部反应的众包数据收集},
  abstract = {In the past, collecting data to train facial expression and affect recognition systems has been time consuming and often led to data that do not include spontaneous expressions. We present the first crowdsourced data collection of dynamic, natural and spontaneous facial responses as viewers watch media online. This system allowed a corpus of 3,268 videos to be collected in under two months.},
}

