@misc{rosalind_picard_690aeac0bc261a6f,
  title = {Improving Domain Generalization in Contrastive Learning using Adaptive Temperature Control},
  author = {Katie Matton and Robert A. Lewis and John V. Guttag and Rosalind W. Picard},
  year = {2026},
  doi = {10.48550/ARXIV.2601.07748},
  url = {https://doi.org/10.48550/ARXIV.2601.07748},
  howpublished = {CoRR},
  annotation = {中文辅助译名：使用自适应温度控制提高对比学习中的领域泛化},
  abstract = {Self-supervised pre-training with contrastive learning is a powerful method for learning from sparsely labeled data. However, performance can drop considerably when there is a shift in the distribution of data from training to test time. We study this phenomenon in a setting in which the training data come from multiple domains, and the test data come from a domain not seen at training that is subject to significant covariate shift. We present a new method for contrastive learning that incorporates domain labels to increase the domain invariance of learned representations, leading to improved out-of-distribution generalization. Our method adjusts the temperature parameter in the InfoNCE loss -- which controls the relative weighting of negative pairs -- using the probability that a negative sample comes from the same domain as the anchor. This upweights pairs from more similar domains, encouraging the model to discriminate samples based on domain-invariant attributes. Through experiments on a variant of the MNIST dataset, we demonstrate that our method yields better out-of-distribution performance than domain generalization baselines. Furthermore, our method maintains strong in-distribution task performance, substantially outperforming baselines on this measure.},
}

@misc{rosalind_picard_740c75ad4e7c3224,
  title = {Counterfactual Test-Time Augmentation for Shortcut Removal in Language Models},
  author = {Katie Matton and Rosalind W. Picard and John V. Guttag and Maggie Makar},
  year = {2026},
  doi = {10.48550/arxiv.2610.33904},
  url = {https://arxiv.org/abs/2610.33904},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：用于语言模型中快捷方式删除的反事实测试时间增强},
  abstract = {Large language models (LLMs) can exploit shortcuts, i.e., correlations present in training data that may not hold at test time. This can lead to poor predictions when correlations shift. Most existing solutions for removing shortcuts operate at training time, requiring labeled training data, model weight access, and significant computational resources. Here, we study the problem of test-time shortcut removal. We propose a family of counterfactual test-time augmentation (CTTA) methods: given an example, each method uses an auxiliary model to generate counterfactual edits in which the shortcut value is changed, and then takes a weighted average of the LLM's predictions across these edits. We prove that the optimal shortcut-invariant predictor is a member of this CTTA family, and we characterize its weights. The weights depend on the training distribution, and therefore are, in general, not identifiable from the trained model and unlabeled test data. However, we present assumptions under which the weights can be obtained using the token probabilities of the trained LLM, and propose tests to detect violations of these assumptions. We use these tests to develop Select-CTTA, an aggregate method that selects among CTTA methods. Empirically, we find that Select-CTTA outperforms test-time baselines and approaches the performance of models fine-tuned on shortcut-balanced data.},
}

