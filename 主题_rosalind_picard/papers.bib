@misc{rosalind_picard_6d14614760ec955f,
  title = {Cultivating a Supportive Sphere: Designing Technology to Increase Social Support for Foster-Involved Youth},
  author = {Craig Ferguson and Ila Krishna Kumar and Jiayi Wu and Rosalind W. Picard},
  year = {2025},
  doi = {10.1145/3710952},
  url = {https://doi.org/10.1145/3710952},
  howpublished = {Proc. ACM Hum. Comput. Interact.},
  annotation = {中文辅助译名：培养支持性领域：设计技术以增加对寄养青少年的社会支持},
  abstract = {Approximately 400,000 youth in the US are living in foster care due to experiences with abuse or neglect at home[17]. For multiple reasons, these youth often don't receive adequate social support from those around them. Despite technology's potential, very little work has explored how these tools can provide more support to foster-involved youth. To begin to fill this gap, we worked with current and former foster-involved youth to develop the first digital tool that aims to increase social support for this population, creating a novel system in which users complete reflective check-ins in an online community setting. We then conducted a pilot study with 15 current and former foster-involved youth, comparing the effect of using the app for two weeks to two weeks of no intervention. We collected qualitative and quantitative data, which demonstrated that this type of interface can provide youth with types of social support that are often not provided by foster care services and other digital interventions. The paper details the motivation behind the app, the trauma-informed design process, and insights gained from this initial evaluation study. Finally, the paper concludes with recommendations for designing digital tools that effectively provide social support to foster-involved youth.},
}

@misc{rosalind_picard_f474308fc9e47fcc,
  title = {Assessing the Emotional Impact of Live Music and Interactive Lighting During Stadium Concerts},
  author = {Kimaya H Lecamwasam and Rosalind W. Picard},
  year = {2025},
  doi = {10.17605/osf.io/nmyd9},
  url = {https://osf.io/nmyd9},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：评估体育场音乐会期间现场音乐和互动照明的情感影响},
  abstract = {The purpose of this research is to understand how audience members experience large-scale live music events, both emotionally and physiologically. Live music has a powerful ability to evoke strong emotional reactions, creating shared experiences that connect audiences and performers. These effects may be amplified in large-scale concerts, where music, staging, and collective energy combine to shape moments of excitement, joy, or reflection. While many people recognize how moving these experiences can be, there has been very little scientific research that directly measures how live music affects people emotionally and physiologically on such a large scale. We aim to learn how specific musical and production elements contribute to emotional resonance during two stadium concerts for a well-known band. The results will help researchers better understand how live music creates powerful shared experiences and may inform future concert design, audience engagement strategies, and health-related applications of music. Audience members attending at least one of two specific nights of this band's tour were invited to participate. Participants were asked to download the Empatica Care app, put on an EmbracePlus sensor alongside their normal PixMob light up bracelet, and scan a study-QR code that will make sure their sensor data goes to the cloud securely with no identifying info. Participants were also assigned an anonymous ID and were provided with a card that includes this information },
}

@misc{rosalind_picard_b095ebcb1af94dfc,
  title = {Classifying Phonotrauma Severity from Vocal Fold Images with Soft Ordinal Regression},
  author = {S. Mazdak Abulnaga and Hamzeh Ghasemzadeh and Robert E. Hillman and Jarrad H. Van Stan and Katie Matton and Jameson C. Cooper and Purvaja Balaji and Daryush D. Mehta and John V. Guttag and Rosalind W. Picard},
  year = {2025},
  doi = {10.48550/ARXIV.2511.09702},
  url = {https://doi.org/10.48550/ARXIV.2511.09702},
  howpublished = {CoRR},
  annotation = {中文辅助译名：使用软序数回归对声带图像中的声损伤严重程度进行分类},
  abstract = {Phonotrauma refers to vocal fold tissue damage resulting from exposure to forces during voicing. It occurs on a continuum from mild to severe, and treatment options can vary based on severity. Assessment of severity involves a clinician's expert judgment, which is costly and can vary widely in reliability. In this work, we present the first method for automatically classifying phonotrauma severity from vocal fold images. To account for the ordinal nature of the labels, we adopt a widely used ordinal regression framework. To account for label uncertainty, we propose a novel modification to ordinal regression loss functions that enables them to operate on soft labels reflecting annotator rating distributions. Our proposed soft ordinal regression method achieves predictive performance approaching that of clinical experts, while producing well-calibrated uncertainty estimates. By providing an automated tool for phonotrauma severity assessment, our work can enable large-scale studies of phonotrauma, ultimately leading to improved clinical understanding and patient care.},
}

