@misc{rosalind_picard_9ca8d1b90aa3b649,
  title = {Probabilistic Combination of Multiple Modalities to Detect Interest},
  author = {Yuri Ivanov and Rosalind W. Picard and Ashish Kapoor},
  year = {2004},
  doi = {10.1109/ICPR.2004.1334690},
  url = {https://doi.org/10.1109/ICPR.2004.1334690},
  howpublished = {ICPR (3)},
  annotation = {中文辅助译名：多种方式的概率组合来检测兴趣},
  abstract = {This paper describes a new approach to combine multiple modalities and applies it to the problem of affect recognition. The problem is posed as a combination of classifiers in a probabilistic framework that naturally explains the concepts of experts and critics. Each channel of data has an expert associated that generates the beliefs about the correct class. Probabilistic models of error and the critics, which predict the performance of the expert on the current input, are used to combine the expert's beliefs about the correct class. The method is applied to detect the affective state of interest using information from the face, postures and task the subjects are performing. The classification using multiple modalities achieves a recognition accuracy of 67.8%, outperforming the classification using individual modalities. Further, the proposed combination scheme achieves the greatest reduction in error when compared with other classifier combination methods.},
}

@misc{rosalind_picard_32ff284a2df952fc,
  title = {Affective sensors, privacy, and ethical contracts},
  author = {Carson Reynolds and Rosalind W. Picard},
  year = {2004},
  doi = {10.1145/985921.985999},
  url = {https://doi.org/10.1145/985921.985999},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：情感传感器、隐私和道德契约},
  abstract = {Sensing affect raises critical privacy concerns, which are examined here using ethical theory, and with a study that illuminates the connection between ethical theory and privacy. We take the perspective that affect sensing systems encode a designer's ethical and moral decisions: which emotions will be recognized, who can access recognition results, and what use is made of recognized emotions. Previous work on privacy has argued that users want feedback and control over such ethical choices. In response, we develop ethical contracts from the theory of contractualism, which grounds moral decisions on mutual agreement. Current findings indicate that users report significantly more respect for privacy in systems with an ethical contract when compared to a control.},
}

