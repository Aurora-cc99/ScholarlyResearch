@misc{rosalind_picard_b18cd43af3354810,
  title = {Holistic Affect Recognition Using PaNDA: Paralinguistic Non-Metric Dimensional Analysis},
  author = {Felix Weninger and Björn W. Schuller and Yue Zhang and Rosalind W. Picard},
  year = {2022},
