@misc{rosalind_picard_55bb96e1bb0fa579,
  title = {0019 Influence of Caffeine and Alcohol Use on Phase Angle in Young Adults},
  author = {Katie S. McCullar and Andrew W. McHill and Laura K. Barger and Akane Sano and Rebecca Robbins and Melissa St. Hilaire and Rosalind W. Picard and Andrew Phillips and Elizabeth B. Klerman},
  year = {2026},
  doi = {10.1093/sleep/zsag091.0019},
  url = {https://doi.org/10.1093/sleep/zsag091.0019},
  howpublished = {SLEEP},
  annotation = {中文辅助译名：0019 咖啡因和酒精的使用对年轻人相位角的影响},
  abstract = {Introduction Alignment between circadian and sleep timing (“phase angle of entrainment”, PAE) is defined as the difference in time between dim light melatonin onset (DLMO) and sleep onset. We and others have identified significant sex differences in PAE. It is important to determine whether modifiable behavioral factors, like caffeine and alcohol use, contribute to these sex differences. Caffeine and alcohol use differ by sex and influence circadian rhythms and sleep timing, making them plausible mechanisms through which sex differences in PAE may arise. In this study, we examined the extent to which self-reported caffeine and alcohol use in young adults contribute to variations in PAE and whether these associations differ by sex. Methods 118 college students (54% female) from a single university participated in this hybrid, in-laboratory/at-school ~30-day study. Sleep timing and Sleep Regularity Index (SRI) were calculated using actigraphy and sleep diaries. During the 30 days, circadian timing (salivary DLMO) was assessed once, and caffeine and alcohol use were determined using ~7-day photographic food diaries. Multiple linear regression models were performed with PAE as the outcome variable, and sex (M or F), caffeine use (yes/no), alcohol use (yes/no), and SRI as predictor variables. Results There were no sex differences in caffeine or alcohol use in this dataset. Caffeine use was associated with larger PAE (β=0.96, p=0.045; Yes Caffeine=3.4 h±1.4 h; No Caffeine=2.5 h±1.3},
}

@misc{rosalind_picard_3e6f8bc448146f85,
