@misc{rosalind_picard_2086354102bdc295,
  title = {Computational Empathy Counteracts the Negative Effects of Anger on Creative Problem Solving},
  author = {Matthew Groh and Craig Ferguson and Robert Lewis and Rosalind W. Picard},
