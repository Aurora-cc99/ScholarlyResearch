@misc{rosalind_picard_850350139d199240,
  title = {Prospective clinical validation of the Empatica EmbracePlus wristband as a reflective pulse oximeter},
  author = {Giulia Regalia and Marisa Cruz and Matteo Migliorini and Weixuan 'Vincent' Chen and Giulia Gerboni and Giulia Comunale and Jessie Lever Taylor and Rosalind W. Picard},
