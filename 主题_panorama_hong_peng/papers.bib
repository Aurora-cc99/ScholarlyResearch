@misc{bin_hu_ef82acfcef6d,
  title = {Reducing Spatio-Temporal Redundancy for Efficient Long-Term Video Understanding via Prototype-Guided Memory-Augmented Large Multimodal Models},
  author = {Jisheng Dang and Liang Tan and Haijiang Li and Fan Wen and Bimei Wang and Yichu Liu and Hong Peng and Bin Hu and Qi Tian and Tat-Seng Chua},
  year = {2026},
  doi = {10.1109/tcsvt.2026.3743402},
  url = {https://doi.org/10.1109/tcsvt.2026.3743402},
  howpublished = {IEEE Transactions on Circuits and Systems for Video Technology},
  annotation = {中文辅助译名：通过原型引导的记忆增强大型多模态模型实现高效长期视频理解的时空冗余},
  abstract = {With the advancement of large language models (LLMs), multimodal large language models (MLLMs) have emerged, driving long-term video understanding to the forefront of research. However, applying MLLMs to video processing remains challenging due to inherent redundancy in video data and high computational costs, leading to inefficiencies. We propose a novel Prototype Guided Memory (PGM) to enhance video understanding efficiency in MLLMs. Our PGM introduces a dual strategy: (1) Question-aware prototype selection performs global prototype screening based on dataset-wide question priors to preserve task-critical information. It extracts universally task-relevant visual primitives as prototypes to eliminate intra-frame redundant backgrounds, and achieves task-level question awareness guided by the statistical semantics of training questions, and (2) Question-agnostic prototype selection, which mines globally representative general visual features in video frames, stores them as prototypes in the memory bank and fully retains the core information of video scenes. Experimental results show that our method outperforms traditional frame-level processing techniques, improving accuracy and reducing GPU memory usage. This provides an efficient and scalable solution for video processing in MLLMs, advancing long-term video understanding.},
}

