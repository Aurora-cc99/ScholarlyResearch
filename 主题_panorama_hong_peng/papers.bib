@misc{panorama_hong_peng_5beaf7d15df0af41,
  title = {Fault Discrimination of Bearings Based on Modular Neural Network Method},
  author = {Hong Peng},
  year = {2004},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=KMLG200402005},
  howpublished = {Journal of Kunming University of Science and Technology},
  annotation = {中文辅助译名：基于模块化神经网络方法的轴承故障判别},
  abstract = {A hybrid modular neural network method is presented, which is used for fault diagnosis of rolling bearings. The method is hierarchically implemented with fault filtering net module and ranking fault type classifying net modules. After that the fault eigenvector is left by passing filtering net module, which is trained to classify whether the samples are faulty or not by a modified BP algorithm, and the classification net modules are used to sort out different fault types. The separated fault samples are presented to every different sub-module to learn. Compared with the results of single neural networks, the fault discrimination results by the proposed approach are more correct, and the method is more applicable.},
}

