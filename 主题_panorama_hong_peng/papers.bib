@misc{panorama_hong_peng_c95bdc3894a91720,
  title = {A Tone Mapping Algorithm Based on Multi-scale Decomposition},
  author = {Weizhong Li and Benshun Yi and Taiqi Huang and Weiqing Yao and Hong Peng},
