@misc{panorama_f935450f3502_a1bfdec8a965be83,
  title = {A Research on Emotion Recognition of the Elderly Based on Transformer and Physiological Signals},
  author = {Guohong Feng and Hongen Wang and Mengdi Wang and Xiao Zheng and Runze Zhang},
  year = {2024},
  doi = {10.3390/electronics13153019},
  url = {https://doi.org/10.3390/electronics13153019},
  howpublished = {Electronics},
  annotation = {中文辅助译名：基于Transformer和生理信号的老年人情绪识别研究},
  abstract = {Aiming at problems such as the difficulty of recognizing emotions in the elderly and the inability of traditional machine-learning models to effectively capture the nonlinear relationship between physiological signal data, a Recursive Map (RM) combined with a Vision Transformer (ViT) is proposed to recognize the emotions of the elderly based on Electroencephalogram (EEG), Electrodermal Activity (EDA), and Heart Rate Variability (HRV) signals. The Dung Beetle Optimizer (DBO) is used to optimize the variational modal decomposition of EEG, EDA, and HRV signals. The optimized decomposed time series signals are converted into two-dimensional images using RM, and then the converted image signals are applied to the ViT for the study of emotion recognition of the elderly. The pre-trained weights of ViT on the ImageNet-22k dataset are loaded into the model and retrained with the two-dimensional image data. The model is validated and compared using the test set. The research results show that the recognition accuracy of the proposed method on EEG, EDA, and HRV signals is 99.35%, 86.96%, and 97.20%, respectively. This indicates that EEG signals can better reflect the emotional problems of the elderly, followed by HRV signals, while EDA signals have poorer effects. Compared with Support Vector Machine (SVM), Naive Bayes (NB), and K-Nearest Neighbors (KNN), the recognition accuracy of the proposed method is increased by at least 9.4%, 11.13%, and 12.61%, respectively. Compared with ResNet},
}

@misc{panorama_f935450f3502_69ba78ff5318aff5,
  title = {A Back Propagation Neural Network Model for Postharvest Blueberry Shelf-Life Prediction Based on Feature Selection and Dung Beetle Optimizer},
  author = {Runze Zhang and Yujie Zhu and Zhongshen Liu and Guohong Feng and Pengfei Diao and Hongen Wang and Shenghong Fu and Shuo Lv and Chen Zhang},
  year = {2023},
  doi = {10.3390/agriculture13091784},
  url = {https://doi.org/10.3390/agriculture13091784},
  howpublished = {Agriculture},
  annotation = {中文辅助译名：基于特征选择和粪甲虫优化器的采后蓝莓保质期预测的反向传播神经网络模型},
  abstract = {(1) Background: Traditional kinetic-based shelf-life prediction models have low fitting accuracy and inaccurate prediction results for blueberries. Therefore, this study aimed to develop a blueberry shelf-life prediction method based on a back propagation neural network (BPNN) optimized by the dung beetle optimizer using an elite pool strategy and a Gaussian distribution estimation strategy (GDEDBO); (2) Methods: The “Liberty” blueberry cultivar was used as the research object, and 23 quality indicators, including color parameters, weight loss rate, decay rate, and texture parameters, were measured under storage temperatures of 0, 4, and 25 °C. Based on the maximum relevance minimum redundancy (MRMR) algorithm, seven key influencing factors of shelf life were selected as the input parameters of the model, and then the MRMR-GDEDBO-BPNN prediction model was established; (3) Results: the results showed that the model outperformed the baseline model at all three temperatures, with strong generalization ability, high prediction accuracy, and reliability; and (4) Conclusions: this study provided a theoretical basis for the shelf-life determination of blueberries under different storage temperatures and offered technical support for the prediction of remaining shelf life.},
}

@misc{panorama_f935450f3502_200e291aa09e4c59,
  title = {Construction of Blueberry Hardness Prediction Nutrient Content Model Based on Heterogeneous Stacking Ensemble Learning},
  author = {Shenghong Fu and Guohong Feng and Yujie Zhu and Pengfei Diao},
  year = {2022},
  doi = {10.21203/rs.3.rs-1821375/v1},
  url = {https://doi.org/10.21203/rs.3.rs-1821375/v1},
  howpublished = {学术期刊/会议},
  annotation = {中文辅助译名：基于异构堆叠集成学习的蓝莓硬度预测营养成分模型构建},
  abstract = {Abstract In order to effectively control the storage quality of blueberries, a prediction model between physical and chemical indicators of blueberries based on heterogeneous Stacking ensemble learning was proposed for the current situation of blueberry quality detection. Firstly, through the correlation analysis of blueberry hardness、mass with the vitamin C, and soluble solid content, a prediction model of the vitamin C and soluble solid content based on one-dimensional features of hardness and mass was established. Secondly, multi-dimensional features were added to the hardness to do the dimensional lift and the same study was carried out in the same dimension. Finally, the prediction effects of Stacking ensemble learning with a single model and the addition of multi-dimensional features were compared (The correlation coefficient and root mean square error of validation of the optimal models were 0.890、0.889 and 0.250、0.232). The results show that heterogeneous Stacking combined with the addition of multi-dimensional features has good predictive potential and provides a new way for blueberry quality detection.},
}

@misc{panorama_f935450f3502_16c448849e766dec,
  title = {Manufacturing Technology of Strengthened Poplar Veneers},
  author = {Xiao Dong Zhu and Feng Hu Wang and Jun Cao and Jian Ping Sun},
  year = {2010},
  doi = {10.4028/www.scientific.net/amr.129-131.149},
  url = {https://doi.org/10.4028/www.scientific.net/amr.129-131.149},
  howpublished = {Advanced Materials Research},
  annotation = {中文辅助译名：强化杨木单板制造技术},
  abstract = {Three mixed liquids, Styrene, Methylmethacrylate and Vinyl acetate were used to soak poplar veneer to obtain strengthen poplar veneers. The optimal molar ratio was fixed on 1:2:1.Soaking and polymerization technology were obtained as pressure 0.4Mpa, packing time 60 minutes, polymerization temperature 80°C, polymerization time 6 hours, cobalt naphthenate 2%, zinc chloride 6%, and azobisisobutyronitrile 3%. The impact of high temperature on the conversion was significant in the chosen level, other factors on the conversion rate was not significant.},
}
