  doi = {10.1016/j.future.2020.12.027},
  url = {https://doi.org/10.1016/j.future.2020.12.027},
  howpublished = {Future Generation Computer Systems},
  annotation = {中文辅助译名：基于融合3D CNN和浅层特征的图像/视频美学质量管理},
