  url = {https://doi.org/10.1002/jcal.70347},
  howpublished = {Journal of Computer Assisted Learning},
  annotation = {中文辅助译名：生成式人工智能支持小学生创意写作：创意写作表现、写作自我效能和心流状态研究},
  abstract = {ABSTRACT Background The integration of Generative Artificial Intelligence (GenAI) into creative writing is a growing trend. However, few studies have examined primary school students' interactions with GenAI alongside their writing experiences and resulting writing products. Objectives This study compared creative writing performance, writing self‐efficacy, and flow state across GenAI‐supported, peer‐collaborative and individual writing conditions. It also descriptively examined patterns of student–AI interaction during the writing activity. Methods An experiment involved 78 primary school students in China assigned to three conditions: GenAI‐supported writing ( n = 20), peer collaboration ( n = 38; 19 pairs), and individual writing ( n = 20). Results and Conclusions Students in the GenAI‐supported writing group obtained higher creative writing performance scores than those in the peer‐collaborative and individual writing groups. Interaction analysis showed that students mainly used GenAI to generate and elaborate ideas. Among episodes with observable uptake, adapted or selective incorporation was more common than direct incorporation, and no complete GenAI response was reproduced verbatim. In addition, students in the GenAI‐supported writing group also reported higher writing self‐efficacy than those in the individual writing group, although the difference from the peer‐collaborative writing group was not significant. However, they reported the lowest flow state. Writing sel},
}

@misc{xin_liu_a1d383f86c9e74bc,
  title = {Insights from Visual Cognition: Understanding Human Action Dynamics with Overall Glance and Refined Gaze Transformer},
  author = {Bohao Xing and Deng Li and Rong Gao and Xin Liu and Heikki Kälviäinen},
  year = {2026},
  doi = {10.48550/ARXIV.2604.06783},
  url = {https://doi.org/10.48550/ARXIV.2604.06783},
  howpublished = {CoRR},
  annotation = {中文辅助译名：视觉认知的见解：通过整体目光和精致的目光变换器了解人类行为动力学},
  abstract = {Recently, Transformer has made significant progress in various vision tasks. To balance computation and efficiency in video tasks, recent works heavily rely on factorized or window-based self-attention. However, these approaches split spatiotemporal correlations between regions of interest in videos, limiting the models' ability to capture motion and long-range dependencies. In this paper, we argue that, similar to the human visual system, the importance of temporal and spatial information varies across different time scales, and attention is allocated sparsely over time through glance and gaze behavior. Is equal consideration of time and space crucial for success in video tasks? Motivated by this understanding, we propose a dual-path network called the Overall Glance and Refined Gaze (OG-ReG) Transformer. The Glance path extracts coarse-grained overall spatiotemporal information, while the Gaze path supplements the Glance path by providing local details. Our model achieves state-of-the-art results on the Kinetics-400, Something-Something v2, and Diving-48, demonstrating its competitive performance. The code will be available at https://github.com/linuxsino/OG-ReG.},
}

@misc{xin_liu_f3d0537a3a7e54eb,
  title = {Zero-Shot Video Restoration and Enhancement with Assistance of Video Diffusion Models},
  author = {Cong Cao and Huanjing Yue and Shangbin Xie and Xin Liu and Jingyu Yang},
  year = {2026},
  doi = {10.48550/ARXIV.2601.21922},
  url = {https://doi.org/10.48550/ARXIV.2601.21922},
  howpublished = {CoRR},
  annotation = {中文辅助译名：视频扩散模型辅助下的零镜头视频恢复和增强},
  abstract = {Although diffusion-based zero-shot image restoration and enhancement methods have achieved great success, applying them to video restoration or enhancement will lead to severe temporal flickering. In this paper, we propose the first framework that utilizes the rapidly-developed video diffusion model to assist the image-based method in maintaining more temporal consistency for zero-shot video restoration and enhancement. We propose homologous latents fusion, heterogenous latents fusion, and a COT-based fusion ratio strategy to utilize both homologous and heterogenous text-to-video diffusion models to complement the image method. Moreover, we propose temporal-strengthening post-processing to utilize the image-to-video diffusion model to further improve temporal consistency. Our method is training-free and can be applied to any diffusion-based image restoration and enhancement methods. Experimental results demonstrate the superiority of the proposed method.},
}

@misc{xin_liu_defd70e505808b6e,
