@misc{panorama_bochao_zou_6c216841ca998517,
  title = {Spatial-Frequency Awareness for Low-Light Instance Segmentation},
  author = {Chang Liu and Junbao Zhuo and Bochao Zou and Jiansheng Chen and Qianchuan Zhao and Huimin Ma},
  year = {2026},
  doi = {10.1109/TCSVT.2026.3710188},
  url = {https://doi.org/10.1109/TCSVT.2026.3710188},
  howpublished = {IEEE Trans. Circuits Syst. Video Technol.},
  annotation = {中文辅助译名：低光实例分割的空间频率感知},
  abstract = {The low-light instance segmentation task tends to suffer from degraded performance due to contrast deficiency and noise interference. Most existing methods primarily rely on image enhancement preprocessing or spatial-domain architectures, which suffer from semantic representation deficiency and cross-frequency noise issues. To address these issues, we propose SFNet, which innovatively integrates spatial-frequency awareness cues into the low-light instance segmentation task. Specifically, for the semantic representation deficiency issue, we introduce a cross-frequency fusion unit (CFU) that decomposes spatial features into high- and low-frequency components via the stationary wavelet transform (SWT) and then fuses them with frequency-aware attention to enrich the semantic representation. Furthermore, we design a multi-domain mixer (MDM) for complementary spatial-frequency feature fusion and enhancement. To tackle the cross-frequency noise issue, we design a learnable adaptive frequency-domain filtering mechanism after the SWT in the CFU, which effectively suppresses noise in both low- and high-frequency domains. In addition, we design a novel frequency consistency constraint (FCC) to reduce noise interference across different frequency bands. Our method effectively suppresses noise interference while enhancing the complementarity between spatial and frequency features. Extensive experiments on the LIS dataset demonstrate substantial accuracy improvements, and ablation studies },
}

@misc{panorama_bochao_zou_6bac382f087f1631,
  title = {Research on breast cancer image segmentation method based on improved ResNet34-UNet hybrid loss function},
  author = {Bochao Zou and Shuangde Li and Yerong Zhang},
  year = {2026},
  doi = {10.1117/12.3119516},
  url = {https://doi.org/10.1117/12.3119516},
  howpublished = {International Conference on Digital Image Processing},
  annotation = {中文辅助译名：基于改进ResNet34-UNet混合损失函数的乳腺癌图像分割方法研究},
  abstract = {Breast cancer ultrasound images present challenges such as heterogeneous lesion morphologies, indistinct boundaries, and class imbalance. To overcome these difficulties, we propose an improved U-Net-based deep learning model for image segmentation. Specifically, we employ ResNet-34 as the encoder to form a ResNet34-UNet, which enhances multi-scale feature extraction and facilitates gradient flow through residual connections. In this architecture, the initial 7×7 convolution is replaced by three cascaded 3×3 convolutions. This preserves the original receptive field size but achieves gains in parameter efficiency and nonlinear modeling capacity. Furthermore, a hybrid loss function combining Weighted Binary Cross-Entropy and Dice loss is introduced to improve the detection of small lesions and the precision of boundary segmentation. The proposed method is evaluated on two public breast ultrasound datasets. Experimental results show that it significantly outperforms the standard U-Net and the original ResNet baseline in terms of accuracy, precision, recall, and Intersection over Union (IoU). The proposed approach provides an effective solution for automated, high-precision segmentation of breast ultrasound images, demonstrating considerable potential for clinical translation.},
}

