@misc{jean_remi_king_5fe82f1f2b9a7ffd,
  title = {BindsNET/bindsnet: 0.3.4},
  author = {Hananel Hazan and Daniel J. Saunders and Kenneth Chaney and coopersigrist and Huizerd and Devdhar Patel and n_shevko and Simon Caby and Hafez Ghaemi and Mahbod Nouri and Rollin M. Omari and Daniel Gafni and Sharath Ramkumar and Peter Marathas and Erik Lanning and Sam and chaterate and Saksham Goyal and Christopher Earl and Youdon and Weihao Tan and Rute Souza de Abreu and bmosk54 and Valerio1988 and Thomas King and Malinda and Justin Riddiough and Jean-Rémi King},
  year = {2026},
  doi = {10.5281/zenodo.20695115},
  url = {https://doi.org/10.5281/zenodo.20695115},
  howpublished = {Zenodo (CERN European Organization for Nuclear Research)},
  annotation = {中文辅助译名：BindsNET/bindsnet: 0.3.4},
  abstract = {Read "Results changes" before upgrading. This release fixes 40+ bugs. Most were crashes, and those fixes change nothing that ran before. A few fix code that ran without error but computed the wrong thing, so the numbers it produces change. pip install bindsnet==0.3.5 · Python 3.11 to 3.13 · PyTorch 2.14.1 Results changes reset_state_variables() now clears the traces that MSTDP, MSTDPET and Rmax carry across time steps. Before, each trial continued the previous trial's traces. This affects reward-modulated learning with resets between trials, for example examples/breakout/breakout_stdp.py and examples/dotTracing/dot_tracing.py. CSRMNodes and the connections into them now clear their spike history on reset (#815). DiehlAndCook2015(sparse=True) now learns. Before, its input weights never changed. MeanFieldConnection now applies weight_decay (it was silently ignored), and uses each sample's own mean rate instead of mixing samples across the batch. Batch size 1 is unchanged. Sparse MulticompartmentConnection weights now learn as dense ones do at batch size > 1. Rmax.eligibility_trace and the state of MCC_learning.MSTDPET now have a batch dimension first: [batch, source, target]. Checkpoints: state_dict() now saves MulticompartmentConnection feature values. A checkpoint from an earlier version fails load_state_dict(..., strict=True); load it with strict=False. The published results in REPRODUCING.md use code whose outputs are bit-identical before and after this release: dense Diehl},
}

@misc{jean_remi_king_0fef8f800e680df8,
