@misc{jean_remi_king_be326cec5f93e123,
  title = {Opportunities and challenges for a maturing science of consciousness},
  author = {Matthias Michel and Diane M. Beck and Ned J. Block and Hal Blumenfeld and Richard Brown and David Carmel and Marisa Carrasco and Mazviita Chirimuuta and Marvin M. Chun and Axel Cleeremans B and Stanislas Dehaene and Stephen M. Fleming and Chris Frith and Patrick Haggard and Biyu Jade He and Cecilia M. Heyes and Melvyn Alan Goodale and Liz Irvine and Mitsuo Kawato and Robert William Kentridge and Jean-Rémi King and Robert Thomas Knight and Sid Kouider and Victor A. F. Lamme and Dominique Lamy and Hakwan C. Lau and Steven Laureys and Joseph E. LeDoux and Ying-Tung Lin and Kayuet Liu and Stephen L. Macknik and Susana Martínez‐Conde and George A. Mashour and Lucía Melloni and Lisa J. Miracchi and Myrto I. Mylopoulos and Lionel Naccache and Adrian Mark Owen and Richard Edward Passingham and Luiz Pessoa and Megan A. K. Peters and Dobromir Rahnev and Tony Ro and DAVID M. ROSENTHAL and Yuka Sasaki and Claire Sergent and Guillermo Solovey and Nicholas D. Schiff and Anil K. Seth and Catherine Tallon‐Baudry and Marco Tamietto and Frank Tong and Simon van Gaal and Alexandra Vlassova and Takeo Watanabe and Josh Weisberg and Karen Yan and Masatoshi Yoshida},
