@misc{xun_chen_ustc_76615be8b9f6c120,
  title = {Muscle Force Estimation Based on Neural Drive Information From Individual Motor Units},
  author = {Xu Zhang and Ge Zhu and Maoqi Chen and Xun Chen and Xiang 'Anthony' Chen and Ping Zhou},
