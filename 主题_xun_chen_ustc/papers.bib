@misc{xun_chen_ustc_8b5400adef9626aa,
  title = {Multi-source domain generalization and adaptation toward cross-subject myoelectric pattern recognition},
  author = {Xuan Zhang and Le Wu and Xu Zhang and Xiang 'Anthony' Chen and Chang Li and Xun Chen},
  year = {2023},
  doi = {10.1088/1741-2552/acb7a0},
  url = {https://doi.org/10.1088/1741-2552/acb7a0},
  howpublished = {Journal of Neural Engineering},
  annotation = {中文辅助译名：跨学科肌电模式识别的多源领域泛化和适应},
  abstract = {Objective. Myoelectric pattern recognition (MPR) has shown satisfactory performance under ideal laboratory conditions. Nevertheless, the individual variances lead to dramatic performance degradation in cross-user MPR applications. It is crucial to enable the myoelectric interface to adapt to multiple users’ surface electromyography (sEMG) distributions in practical. Approach. Domain adaptation (DA) is a promising approach to tackle cross-user challenges due to its ability to diminish the divergence between individual users’ EMG distributions and escalate model generalization performance. However, existing DA methods in sEMG control are based on single-source domain adaptation (SDA). SDA solely mixes multiple training users’ data as a combined source domain and attempts to align with a novel user. This simple data mixing manner ignores the sEMG distribution variations between disparate training users, leading to an insufficient variance elimination and lower performance. To this end, this paper proposes a multi-source synchronize domain adaptation framework with both DA and domain generalization (DG) capability. This multi-source framework aligns each source user and the new user in individual feature spaces, which better transfers the knowledge of existing users to the new user. Moreover, we retain the source-combined data to preserve the effectiveness of SDA. The property was further confirmed by evaluating the performance of the proposed method on data from nine subjects pe},
}

@misc{xun_chen_ustc_08cd623f656b0463,
  title = {Increasing the resolution of clinical PET systems by the principle of structured illumination microscopy},
  author = {Yaning Lang and Chien-Min Kao and Xun Chen and Qingguo Xie},
  year = {2023},
  doi = {10.1109/nssmicrtsd49126.2023.10338700},
  url = {http://dx.doi.org/10.1109/nssmicrtsd49126.2023.10338700},
  howpublished = {IEEE Nuclear Science Symposium and Medical Imaging Conference (NSS/MIC)},
  annotation = {中文辅助译名：利用结构照明显微镜原理提高临床 PET 系统的分辨率},
  abstract = {We investigate applying the theory of super-resolution (SR) structured illumination microscopy (SIM) for increasing the resolution of clinical positron emission tomography (PET) imaging. The theory of SIM is based on modulating the image field to encode its high-frequency content above the bandwidth of the imaging device, and hence unobservable, into lower-frequency, detectable signals. Subsequently, high-resolution images are produced from a number of resolution-limited images that however encode the high-frequency content of the image field under examination by computationally restoring signals to their correct frequencies. In this work, we propose using a partially attenuating rotating ring, referred to as the modulator, in front of a stationary PET detector ring to create intensity modulation of the coincidence photons before detection. Using computer simulation data, we demonstrate a proof-of-concept for this SIM-inspired SR PET: We show that images reconstructed from multiple noise-free projection data obtained with the modulator at various rotational positions and a PET system made of 576 4.2 mm-width crystals can resolve 0.9 mm diameter sources. In practice, the characteristics of PET imaging physics and data noise will limit resolution recovery, but we also obtain promising initial results when using the ordered-subset expectation-maximization algorithm that is known to be relatively susceptible to noise. Further systematic studies are needed to better understand the},
}

@misc{xun_chen_ustc_8a57617e030f3dd7,
  title = {Feasibility study on the application of a spiking neural network in myoelectric control systems},
  author = {Antong Sun and Xiang 'Anthony' Chen and Mengjuan Xu and Xu Zhang and Xun Chen},
  year = {2023},
