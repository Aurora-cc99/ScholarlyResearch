@misc{xun_chen_ustc_37ab514905cbecba,
  title = {Gait synergetic neuromuscular control in children with cerebral palsy at different gross motor function classification system levels},
  author = {Yi Yu and Xiang 'Anthony' Chen and Shuai Cao and De Wu and Xu Zhang and Xun Chen},
