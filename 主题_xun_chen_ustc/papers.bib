@misc{xun_chen_ustc_f52fc61d2bb30f61,
  title = {Transformer-Based End-to-End Anatomical and Functional Image Fusion},
  author = {Z. Jane Wang and Dan Wang and Jing Zhang and Xun Chen and Aiping Liu and Yu Liu},
  year = {2022},
  doi = {10.1109/TIM.2022.3200426},
