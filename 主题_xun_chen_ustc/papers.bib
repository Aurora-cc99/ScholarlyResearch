@misc{xun_chen_ustc_19751ee3a5b308ca,
  title = {Striatal Subdivisions Estimated via Deep Embedded Clustering With Application to Parkinson's Disease},
  author = {Taomian Mi and Feng Wu and Yu Li and Martin J. McKeown and Xun Chen and Runyu Yang and Piu Chan and Aiping Liu},
