@misc{xun_chen_ustc_c690c6277d3622c9,
  title = {GZSL-Lite: A Lightweight Generalized Zero-Shot Learning Network for SSVEP-Based BCIs},
  author = {Xietian Wang and Xingui Chen and Xun Chen and Heng Cui and Kai Wang and Aiping Liu},
  year = {2025},
  doi = {10.1109/TBME.2025.3553204},
  url = {https://doi.org/10.1109/TBME.2025.3553204},
  howpublished = {IEEE Trans. Biomed. Eng.},
  annotation = {中文辅助译名：GZSL-Lite：用于基于 SSVEP 的 BCI 的轻量级广义零样本学习网络},
  abstract = {Generalized zero-shot learning (GZSL) networks offer promising avenues for the development of user-friendly steady-state visual evoked potential (SSVEP) based brain-computer interfaces (BCIs), aiming to alleviate the training burden on users. These networks only require the user to provide training data from partial classes during training, yet they demonstrate the capability to classify all classes during testing. However, these GZSL networks have a large number of trainable parameters, resulting in long training times and difficulty to practicalize. In this study, we proposed a dual-attention structure to construct a lightweight GZSL network, termed GZSL-Lite. We first embedded the input training data-constructed class templates, manually constructed sine templates, and electroencephalogram (EEG) signals using convolution-based networks. The embedding part uses the same network weights to embed the features across different stimulus frequencies while reducing the depth of the network. After embedding, two branches of the dual-attention use class and sine templates to guide the feature extraction of the EEG signal with the attention mechanism, respectively. Compared to the networks that extract all features equally, dual-attention focuses only on EEG features relative to templates, which helps classification with fewer parameters. Finally, we used depthwise convolutional blocks to output classification results. Experimental evaluations conducted on two publicly available dat},
}

@misc{xun_chen_ustc_867c3ebe82a159b6,
  title = {ICFusion: Multimodal Image Fusion via Invertible Feature Enhancement and Cross-Modal Feature Balance},
  author = {Xiaojiu Xu and Gang Yang and Xiaowen Zhang and Jing Zhang and Xun Chen and Aiping Liu},
  year = {2025},
  doi = {10.1109/jsen.2025.3575460},
  url = {https://doi.org/10.1109/jsen.2025.3575460},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：ICFusion：通过可逆特征增强和跨模态特征平衡进行多模态图像融合},
  abstract = {Multi-modal image fusion (MMIF) integrates information from multiple imaging modalities to produce images with comprehensive information and detailed textures. In recent years, deep learning-based MMIF methods have made significant advancements. However, existing methods frequently encounter high-frequency detail loss and insufficient texture representation, resulting in inadequate scene detail representation. Moreover, current image fusion methods lack sufficient interaction to balance complementary information, leading to the loss of modality-specific information in the fused results. To overcome these challenges, we propose an invertible feature enhancement and cross-modal information balance network called ICFusion, which aims to enhance texture details and strengthen the interaction between multi-modal features. Specifically, we present the invertible Mamba module (IMM), which leverages an invertible structure for feature lossless transmission and extracts global multi-modal features to inject long-range pixel dependencies, thereby enhancing the representation of high-frequency details in global information modeling. Additionally, we introduce the cross-modal feature balance module (CFBM), which maps cross-modal features into space state models (SSMs) for interaction and adaptively fuses the interacted features with individual modality features to enhance the unique information of each modality, achieving the balance of complementary information across modalities. Extens},
}

@misc{xun_chen_ustc_8e4a89f38f1e2c8c,
  title = {MGMAP-Net: A Multi-Graph Modality-Aware Network for Enhanced Fluid Intelligence Prediction Using Multimodal Brain Connectivity},
  author = {Chong Cheng and Yu Li and Jie Wen and Xun Chen and Aiping Liu},
  year = {2025},
  doi = {10.1109/embc58623.2025.11254345},
  url = {https://doi.org/10.1109/embc58623.2025.11254345},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：MGMAP-Net：使用多模态大脑连接增强流体智能预测的多图模态感知网络},
  abstract = {Predicting fluid intelligence using neuroimaging data is crucial for understanding the neural mechanisms underlying complex cognitive functions. Multimodal brain connectivity networks, such as functional connectivity (FC) and structural connectivity (SC), provide a comprehensive framework for analyzing inter-regional relationships from both functional and structural perspectives. While the effective fusion of FC and SC offers complementary information with the potential to improve fluid intelligence prediction, the coupling between multimodal connectivity graphs often result in overlapping features, leading to information redundancy and reduced predictive performance. To address these challenges, we propose a Multi-Graph Modality-Aware Predictive Network (MGMAPNet) for fluid intelligence prediction. This model incorporates private and shared feature extraction modules to disentangle modality-specific and shared information derived from FC and SC data. Furthermore, we design specialized loss functions to facilitate the feature separation process. Experiments conducted on the UK Biobank Dataset demonstrate that our proposed method outperforms both unimodal and multimodal approaches. Additionally, t-SNE visualization confirms that MGMAP-Net effectively isolates private and shared features of each modality, indicating its ability to capture the unique and complementary contributions of functional and structural connectivity graphs.},
}

@misc{xun_chen_ustc_4058f190a7187985,
  title = {MIF: Multi-Shot Interactive Fusion Model for Cancer Survival Prediction Using Pathological Image and Genomic Data},
  author = {Honglei Liu and Yi Shi and Ao Li and Xun Chen and Minghui Wang and Fang Zhao},
  year = {2025},
  doi = {10.1109/JBHI.2024.3363161},
  url = {https://doi.org/10.1109/JBHI.2024.3363161},
  howpublished = {IEEE J. Biomed. Health Informatics},
  annotation = {中文辅助译名：MIF：使用病理图像和基因组数据预测癌症生存的多镜头交互式融合模型},
  abstract = {Accurate cancer survival prediction is crucial for oncologists to determine therapeutic plan, which directly influences the treatment efficacy and survival outcome of patient. Recently, multimodal fusion-based prognostic methods have demonstrated effectiveness for survival prediction by fusing diverse cancer-related data from different medical modalities, e.g., pathological images and genomic data. However, these works still face significant challenges. First, most approaches attempt multimodal fusion by simple one-shot fusion strategy, which is insufficient to explore complex interactions underlying in highly disparate multimodal data. Second, current methods for investigating multimodal interactions face the capability-efficiency dilemma, which is the difficult balance between powerful modeling capability and applicable computational efficiency, thus impeding effective multimodal fusion. In this study, to encounter these challenges, we propose an innovative multi-shot interactive fusion method named MIF for precise survival prediction by utilizing pathological and genomic data. Particularly, a novel multi-shot fusion framework is introduced to promote multimodal fusion by decomposing it into successive fusing stages, thus delicately integrating modalities in a progressive way. Moreover, to address the capacity-efficiency dilemma, various affinity-based interactive modules are introduced to synergize the multi-shot framework. Specifically, by harnessing comprehensive affinit},
}

@misc{xun_chen_ustc_ac4f7caabca634d4,
