  author = {Dongdong Zhou and Qi Xu and Jian Wang and Hongming Xu and Lauri Kettunen and Zheng Chang and Fengyu Cong},
  year = {2022},
  doi = {10.1109/tim.2022.3191710},
  url = {https://doi.org/10.1109/tim.2022.3191710},
  howpublished = {IEEE Transactions on Instrumentation and Measurement},
  annotation = {中文辅助译名：缓解自动睡眠阶段分类中的类别不平衡问题},
  abstract = {For real-world automatic sleep stage classification tasks, various existing deep learning based models are biased towards the majority with high proportion. Because of the unique sleep structure, most of the current polysomnography datasets suffer an inherent class imbalance problem (CIP), in which the number of each sleep stage is severely unequal. In this study, we first define the class imbalance factor (CIF) to describe the level of CIP quantitatively. Afterwards, we propose two balancing methods to alleviate this problem from the dataset quantity and the relationship between the class distribution and the applied model respectively. The first one is to employ the data augmentation (DA) with the generative adversarial network (GAN) model and different intensities Gaussian white noise to balance samples, thereinto, Gaussian white noise addition is specifically tailored to deep learning based models, which can work on raw electroencephalogram (EEG) data while preserving their properties. In addition, we try to balance the relationship between the imbalanced class and biased network model to achieve a balanced state with the help of class distribution and neuroscience principles. We further propose an effective deep convolutional neural network (CNN) model utilizing bidirectional Long Short-Term Memory (Bi-LSTM) with single-channel EEG as the Baseline. It is used for evaluating the efficiency of two balancing approaches on three imbalanced polysomnography datasets (CCSHS, Sl},
}

@misc{panorama_0f9dc04a8f60_27418a3924f4a005,
