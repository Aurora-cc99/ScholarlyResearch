@misc{panorama_0f9dc04a8f60_16b7a07722263199,
  title = {MULTI-DOMAIN FEATURE EXTRACTION FOR SMALL EVENT-RELATED POTENTIALS THROUGH NONNEGATIVE MULTI-WAY ARRAY DECOMPOSITION FROM LOW DENSE ARRAY EEG},
  author = {Fengyu Cong and Anh Huy Phan and Piia Astikainen and Qibin Zhao and Qiang Wu and Jari K. Hietanen and Tapani Ristaniemi and Andrzej S Cichocki},
  year = {2013},
