@misc{panorama_0f9dc04a8f60_0bdec34e7075302c,
  title = {An adaptive fixed-point IVA algorithm applied to multi-subject complex-valued FMRI data},
  author = {Li‐Dan Kuang and Qiu‐Hua Lin and Xiao‐Feng Gong and Fengyu Cong and Vince D. Calhoun},
  year = {2016},
  doi = {10.1109/icassp.2016.7471768},
  url = {https://doi.org/10.1109/icassp.2016.7471768},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：一种应用于多对象复值FMRI数据的自适应定点IVA算法},
  abstract = {Independent vector analysis (IVA) has exhibited great potential for the group analysis of magnitude-only fMRI data, but has rarely been applied to native complex-valued fMRI data. We propose an adaptive fixed-point IVA algorithm by taking into account the extremely noisy nature, large variability of the source component vector (SCV) distribution, and non-circularity of the complex-valued fMRI data. The multivariate generalized Gaussian distribution (MGGD) is exploited to match the SCV distribution based on nonlinearity, the shape parameter of MGGD is estimated using maximum likelihood estimation, and the nonlinearity is updated in the dominant SCV subspace to achieve denoising goal. In addition, the pseudo-covariance matrix is incorporated into the algorithm to represent the non-circularity. Experimental results from simulated and actual fMRI data demonstrate significant improvements of our algorithm over a complex-valued IVA-G algorithm and several circular and noncircular fixed-point IVA variants.},
}

