@misc{panorama_0f9dc04a8f60_b19eff0b4cab3ab6,
  title = {Neurocognitive Dynamics of Icon Design: EEG Evidence from Style and Activation Effects on Visual Search Efficiency},
  author = {Limin Hou and Guanghui Zhang and Xiawen Li and Dong Tang and Tiina M. Parviainen and Fengyu Cong and Tommi Kärkkäinen},
  year = {2026},
  doi = {10.1080/10447318.2026.2622574},
  url = {https://doi.org/10.1080/10447318.2026.2622574},
  howpublished = {International Journal of Human-Computer Interaction},
  annotation = {中文辅助译名：图标设计的神经认知动力学：风格和激活对视觉搜索效率影响的脑电图证据},
  abstract = {Existing studies have examined icon size, brightness contrast, and design style in combination with other factors. However, how these features are represented across distinct neural stages from early perceptual encoding to late cognitive updating, and how they influence cognitive efficiency and user preference, remains largely unexamined. To address this gap, we collected behavioral, electroencephalography (EEG), and subjective preference data from 30 adults to investigate whether variations in icon style and activation mode affect visual search efficiency. Results showed that linear icons elicited faster responses, whereas flat and skeuomorphic icons evoked larger P2 and P3 amplitudes and were preferred subjectively. Magnified activation was associated with shorter P1 and P2 latencies and higher preference ratings. Time-frequency analyses revealed interaction effects across delta, theta, and alpha bands. Together, the findings support a multi-stage processing account in which icon style primarily influences perceptual and cognitive updating processes, while activation mode modulates early attentional allocation.},
}

