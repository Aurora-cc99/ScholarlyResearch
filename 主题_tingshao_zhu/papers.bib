@misc{tingshao_zhu_a0faa6b61a346f38,
  title = {Using Data Mining To Learn The Patterns OfPitch Variation In Chinese Speech},
  author = {Tingshao Zhu and Wen Gao},
  year = {1970},
  doi = {10.2495/data980231},
  url = {https://www.witpress.com/Secure/elibrary/papers/DATA98/DATA98023FU.pdf},
  howpublished = {WIT transactions on information and communication technologies},
  annotation = {中文辅助译名：使用数据挖掘来学习汉语语音中的音高变化模式},
  abstract = {Pitch model is very important in speech synthesis, and it mainly describes the variation of pitch. In order to synthesize speech with high intelligibility and naturalness, a system should be with an appropriate pitch model. We try to find the pitch model from actual speech samples by data mining. A prototype system called SpeechDM has been implemented to extract patterns from two-word phrase of Chinese. Dataset is used for data management, and multi-thread training tasks are controlled by training manager. This paper gives the process firstly, then each step is introduced in detail. Some results and conclusions are given at last.},
}
