@misc{tingshao_zhu_54388a5f50501d26,
  title = {Examining the Impact of COVID-19 Lockdown in Wuhan and Lombardy: A Psycholinguistic Analysis on Weibo and Twitter},
  author = {Yue Su and Jia Xue and Xiaoqian Liu and Peijing Wu and Junxiang Chen and Chen Chen and Tianli Liu and Weigang Gong and Tingshao Zhu},
  year = {2020},
  doi = {10.3390/ijerph17124552},
  url = {http://dx.doi.org/10.3390/ijerph17124552},
