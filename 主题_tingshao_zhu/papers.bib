@misc{tingshao_zhu_eb08cc4580cf090a,
  title = {Detecting suicide ideation from Sina microblog},
  author = {Yuanbo Gao and Baobin Li and Tingshao Zhu and Xuefei Wang and Yang Zhou and Jingying Wang and Shuotian Bai},
  year = {2017},
  doi = {10.1109/SMC.2017.8122599},
