}

@misc{tingshao_zhu_41807fc20e1d7e32,
  title = {Facial Feature Analysis for Anxiety Detection in People with Drug Addiction: Establishment and Validation of Machine Learning Models},
  author = {Xiaoming Zhong and Ang Li and Xiangyang Zhang and Tingshao Zhu},
  year = {2024},
  doi = {10.1109/icsp62122.2024.10743536},
  url = {https://doi.org/10.1109/icsp62122.2024.10743536},
  howpublished = {International Conference on Intelligent Computing and Signal Processing (ICSP)},
  annotation = {中文辅助译名：毒瘾患者焦虑检测的面部特征分析：机器学习模型的建立和验证},
  abstract = {Dynamic monitoring of anxiety levels of drug addicts can help improve the effectiveness of drug addiction treatment. However, traditional psychological measurement methods have limitations and cannot effectively meet these needs. There is an urgent need to explore novel measurement methods. In view of this, this study collected and analyzed facial movements and anxiety level data of 279 male drug addicts using image sensor devices and psychological questionnaires, respectively. The aim was to establish and validate prediction models of anxiety levels in drug addicts based on facial feature analysis using machine learning methods. Results showed that prediction models had good predictive effects (the highest split-half reliability level: r=0.976; the highest criterion-related validity level: r=0.390). The results of this study can provide novel and reliable research methods and measurement tools for dynamic monitoring of the mental health of drug addicts.},
}

@misc{tingshao_zhu_7ecc249fd747d66e,
  title = {Development and Validation of Machine Learning Models for Predicting Big Five Personality Traits in Drug Addicts Based on Facial Movement Analysis},
  author = {Ang Li and Yanzhu Chen and Tingshao Zhu and Xiangyang Zhang},
  year = {2024},
  doi = {10.1145/3690407.3690501},
  url = {https://doi.org/10.1145/3690407.3690501},
  howpublished = {CAIBDA},
  annotation = {中文辅助译名：基于面部运动分析预测吸毒者大五人格特征的机器学习模型的开发和验证},
  abstract = {Real-time non-intrusive assessment of personality traits in drug addicts is crucial for enhancing the effectiveness of treatment efforts. Previous studies have demonstrated that characteristics of facial movements can be used to measure personality traits in the general population. However, the facial movements of drug addicts may be quite different from those of the general population, so it remains uncertain whether similar findings can be observed in drug addicts. In this study, data from 336 drug addicts were collected and analyzed by using Sony video camera (recording facial movement) and NEO-FFI questionnaire (measuring Big Five personality traits). After that, by using six different machine learning algorithms, classification models for predicting Big Five personality traits in drug addicts were developed and validated based on facial movement analysis. Results showed that, among different models, the Random Forest model obtained the best overall classification performance (validity: the accuracy values ranged from 0.60 to 0.72, and the F1 values ranged from 0.65 to 0.78; reliability: the split-half reliability values ranged from 0.81 to 0.93). Findings of this study confirm the potential of facial movement analysis in predicting personality traits for drug addicts.},
}

@misc{tingshao_zhu_6b60f0bcd951c104,
  title = {Research on suicide risk identification technology based on social media},
  author = {Yun Gu and Deyuan Chen and Tingshao Zhu},
  year = {2024},
  doi = {10.1117/12.3037705},
  url = {http://dx.doi.org/10.1117/12.3037705},
  howpublished = {International Conference on Information Science, Electrical and Automation Engineering (ISEAE)},
  annotation = {中文辅助译名：基于社交媒体的自杀风险识别技术研究},
  abstract = {Suicide has become one of the severe global social issues. This study focuses on users' social media text data and adopts natural language processing techniques to conduct research on suicide risk identification, proposing a suicide risk recognition model based on dynamic segmentation and Transformer architecture. Users' social media posts over a period can often reach chapter length, but traditional Transformer-based models have input limitations concerning text length. To address this, the paper introduces a dynamic segmentation algorithm that minimizes cost to split all user posts within a month, sequentially inputs them into the RoBERTa model for feature extraction, and then utilizes a bidirectional Long Short-Term Memory network to extract features between segments that include contextual associations. The model also embeds its own attention mechanism to capture important local feature information. Eventually, it achieves an overall representation of the user's posting content, thus enabling effective identification of users' suicide risks. Compared to baseline models, there is a significant improvement in both F1 score and accuracy, reaching 73.1% and 74.67%, respectively.},
}

@misc{tingshao_zhu_a2095c96cb881c87,
  title = {Anxiety state recognition based on speech emotional features and ECAPA-TDNN},
  author = {Ying Liu and Xiaoqian Liu and Tingshao Zhu},
  year = {2024},
  doi = {10.1117/12.3034286},
  url = {http://dx.doi.org/10.1117/12.3034286},
  howpublished = {International Conference on Image, Signal Processing and Pattern Recognition (ISPP)},
  annotation = {中文辅助译名：基于语音情感特征和ECAPA-TDNN的焦虑状态识别},
  abstract = {Anxiety disorders not only have negative effects on patient health, social and social interactions but also place a significant burden on society. This paper proposes a anxiety state recognition method based on speech emotional features and ECAPA-TDNN (emphasized channel attention, propagation, and aggregation based TDNN), aiming to explore the feasibility of large-scale screening of anxiety states using voice data. 152 participants have been recruited and collected their speech data. Meanwhile, each participant was asked to complete the anxiety scales (GAD-7). Subsequently, 6125 acoustic features were extracted from each participant’s speech and the f-regression (a method for Linear Regression with One Variable) was used to screen the features for each group. Then the embedded features are extracted through ECAPA-TDNN, concatenated with the acoustic features above to form a new emotional representation. Moreover, various machine learning algorithms including Random forests, ExtraTrees regression, linear regression and Multi-Layer Perceptron (MLP) regression were used to develop anxiety recognition models. The results showed that the best Pearson Correlation Coefficient (PCC) between the predicted score and the GAD-7 score was 0.515. Notably, the reliability of the model surpassed 0.657, further reinforcing its credibility.},
}

@misc{tingshao_zhu_5ad3828d0519bdda,
  title = {Research on constructing post competency level prediction model in video recruitment based on XGBoost classification algorithm},
  author = {Yuman Hu and Xiaoyang Wang and Tingshao Zhu and Daopeng Zhang},
  year = {2024},
  doi = {10.1109/nnice61279.2024.10498593},
  url = {http://dx.doi.org/10.1109/nnice61279.2024.10498593},
  howpublished = {International Conference on Neural Networks, Information and Communication Engineering (NNICE)},
  annotation = {中文辅助译名：基于XGBoost分类算法构建视频招聘岗位能力水平预测模型的研究},
  abstract = {Currently, 80% of companies still rely on traditional recruitment methods such as expert evaluations and scales to build their talent pool. However, these methods not only rely on past experience in job competency but are also susceptible to subjective evaluations and experiential biases, leading to potential loss or misplacement of talent. Recent research indicates that individual competency levels are correlated with facial expression changes, while machine learning methods have shown significant advancements in facial feature recognition. This provides a theoretical basis for using machine learning to process facial features and predict competency levels. This study primarily focuses on establishing the mapping relationship and predictive model between facial action units (AUs) captured during the recruitment process and competency levels evaluated by experts, using the XGBoost classification algorithm. Various data mining techniques and machine learning models, including grid search, XGBoost trees, five-fold cross-validation, and confusion matrix, were employed to evaluate the performance of the model using both predicted and real data. The experimental results demonstrate a satisfactory accuracy score of 0.61 for the three-level competency rating recognition model, indicating the feasibility of constructing a competency level prediction model based on facial action units in video-based recruitment. Compared to conventional recruitment methods, this competency recognition},
}

@misc{tingshao_zhu_f13e3ad35ca0a6d9,
  title = {Uncovering the heterogeneous effects of depression on suicide risk conditioned by linguistic features: A double machine learning approach},
  author = {Jing Wang and Tingshao Zhu and Sijia Li and Wei Pan and Wenwei Zhou and Paul Siu Fai Yip},
