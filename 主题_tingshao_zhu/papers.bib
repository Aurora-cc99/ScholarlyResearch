  title = {Identifying comorbidities from depressed people via voice analysis},
  author = {Jonathan Flint and Jingying Wang and Tingshao Zhu and Xiaoyun Sui},
  year = {2017},
  doi = {10.1109/BIBM.2017.8217791},
