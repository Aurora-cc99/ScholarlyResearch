  annotation = {中文辅助译名：公众对加拿大总理每日 COVID-19 简报的意见和担忧：使用机器学习技术对 YouTube 评论进行纵向研究},
  abstract = {BACKGROUND: During the COVID-19 pandemic in Canada, Prime Minister Justin Trudeau provided updates on the novel coronavirus and the government's responses to the pandemic in his daily briefings from March 13 to May 22, 2020, delivered on the official Canadian Broadcasting Corporation (CBC) YouTube channel. OBJECTIVE: The aim of this study was to examine comments on Canadian Prime Minister Trudeau's COVID-19 daily briefings by YouTube users and track these comments to extract the changing dynamics of the opinions and concerns of the public over time. METHODS: We used machine learning techniques to longitudinally analyze a total of 46,732 English YouTube comments that were retrieved from 57 videos of Prime Minister Trudeau's COVID-19 daily briefings from March 13 to May 22, 2020. A natural language processing model, latent Dirichlet allocation, was used to choose salient topics among the sampled comments for each of the 57 videos. Thematic analysis was used to classify and summarize these salient topics into different prominent themes. RESULTS: We found 11 prominent themes, including strict border measures, public responses to Prime Minister Trudeau's policies, essential work and frontline workers, individuals' financial challenges, rental and mortgage subsidies, quarantine, government financial aid for enterprises and individuals, personal protective equipment, Canada and China's relationship, vaccines, and reopening. CONCLUSIONS: This study is the first to longitudinally inve},
}

@misc{tingshao_zhu_4cd30d4c45abf659,
  title = {Research on the psychology of historical figures based on big data analysis and data mining : Taking Zeng Guofan's diary as an example},
  author = {Jingyi Zhou and Tingshao Zhu},
  year = {2021},
  doi = {10.1109/iaecst54258.2021.9695512},
  url = {https://doi.org/10.1109/iaecst54258.2021.9695512},
  howpublished = {International Academic Exchange Conference on Science and Technology Innovation (IAECST)},
  annotation = {中文辅助译名：基于大数据分析与数据挖掘的历史人物心理研究——以曾国藩日记为例},
  abstract = {In recent years, big data analysis and data mining technologies play an irreplaceable role in all walks of life. In the general psychological research of historical figures, there are often the tendencies of pragmatism, subjectivism, absolutism, simplification and formulaic. Reasons for these phenomena are the lack of confirmation research of quantitative analysis. The application of big data analysis and data mining technology can analyze and mine the left real historical data. After using the big data analysis, we can scientifically summarize and discover the hidden laws. Therefore, we select the complete works of Zeng Guofan(Revised Version) as the original data. These articles are the most psychological representative in all Zeng Guofan’s articles. Then we use LIWC Ancient Chinese Dictionary and CC- LIWC analysis 3.6 system as the tools of big data analysis to quantify the psychological significance of natural language. We also deeply discuss the changes of specific keywords in Zeng Guofan's diary, and objectively restore the real psychological changes of Zeng Guofan in the two important historical periods. This study expands the application of big data analysis and mining, and provides scientific data support for the research of the psychology of historical figures.},
}

