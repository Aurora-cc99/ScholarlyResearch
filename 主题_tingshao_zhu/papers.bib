}

@misc{tingshao_zhu_087dd59956e27335,
  title = {Constructing the Internet Behavior Ontology: Projection from Psychological Phenomena with Qualitative and Quantitative Methods},
  author = {Ang Li and Wei-Chen Zhang and Yu-Xi Pei and Jiu-Ling Xin and Tingshao Zhu and Shan Tang and Zhuo-Hong Zhu and Qi Zhang and Yi-Lin Li and Shu-Juan Wang},
  year = {2011},
