@misc{tingshao_zhu_9782d4684e57a9b1,
  title = {Behavior-Based Recommender Systems for Web Content : Workshop on the Next Stage of Recommender Systems Research (Beyond Personalization 2005)},
  author = {Tingshao Zhu and Russell Greiner and Gerald Häubl and Bob Price and Kevin Jewell},
  year = {2005},
  url = {http://www.alexandria.unisg.ch/220747/},
