  annotation = {中文辅助译名：光流传感器：方向选择性仿生视网膜设计},
  abstract = {We present a pixel-level optical flow sensor integrated circuit, combining dynamic vision sensor ON/OFF event comparison with time-difference measurement An optical flow-specific address-event representation interface supports low-power, high-throughput readout. We further propose an optical memristor-based optical flow sensor to reduce sensor power consumption and area overhead.},
}

@misc{yuchao_yang_7797268ebdccf927,
  title = {A Logic-Assisted Hybrid-Mode Ising Machine Based on a 3D Topology for 3D Path Planning},
  author = {Runhong Tang and Xiangrui Wang and Yuchao Yang and Yuqi Su},
  year = {2026},
  doi = {10.1109/ISCAS66217.2026.11562168},
  url = {https://doi.org/10.1109/ISCAS66217.2026.11562168},
  howpublished = {ISCAS},
  annotation = {中文辅助译名：基于 3D 拓扑的逻辑辅助混合模式 Ising 机，用于 3D 路径规划},
  abstract = {Path planning is a fundamental task in robotics, autonomous systems, and spatial optimization, in which real-time and energy-efficient computations are crucial. Conventional digital architectures exhibit limited parallelism when exploring large search spaces, leading to challenges in power efficiency, latency, and scalability. The Ising model offers a promising hardware framework for addressing such problems through energy-minimization dynamics. The spins that represent obstacles and paths in an Ising model update simultaneously, providing substantial acceleration in large-scale pathfinding. However, existing implementations are constrained by inefficient problem mapping and are typically limited to two-dimensional (2D) scenarios. To address these challenges, this work presents a CMOS Ising machine with a three-dimensional (3D) lattice topology for efficient 3D path planning, achieving a 91.3% reduction in transistor count compared with prior work. CMOS simulations verify that the proposed system correctly solves a 16 × 16 × 16 maze within 45 iterations, consuming 8.625 μW per spin and occupying 496.31 μm2per spin.},
}

@misc{yuchao_yang_ddc0973389ae4164,
  title = {A sub–10-millisecond neural dynamical system based on phase-change memristors},
  author = {Lei Cai and Yaoyu Tao and Chenchen Xie and Longhao Yan and S B Li and Ruihong Shen and Zelun Pan and Xile Wang and Bowen Wang and Daijing Shi and Yihang Zhu and Teng Zhang and Yixin Zhu and Xi Li and Zhitang Song and Ru Huang and Yuchao Yang},
  year = {2026},
  doi = {10.1126/science.aee6277},
  url = {https://doi.org/10.1126/science.aee6277},
  howpublished = {Science},
  annotation = {中文辅助译名：基于相变忆阻器的亚 10 毫秒神经动力系统},
  abstract = {High-fidelity geometry for physical-world modeling demands real-time, dense, and differentiable deformation fields on manifolds. Neural dynamical systems (NDSs) using adaptive stepsize integration with embedded neural networks excel at these tasks but still suffer latency on the order of hundreds of milliseconds. In this work, we report a sub–10-millisecond NDS hardware leveraging the precisely controlled conductance drift of phase-change memristors and their multilevel compute-in-memory capabilities. We fabricated a 40-nanometer NDS chip for the challenging surface reconstruction tasks. Compared with state-of-the-art NDS hardware, our NDS design achieves a latency of 2.12 milliseconds (below 10 milliseconds) for single-iteration NDS computations with an error tolerance of 10 −7 and delivers 3.82× to 36.27× faster speed while consuming 11.75× to 24.73× less power. The end-to-end NDS latency through hardware measurements and simulations outperformed graphics processing unit A100 by 50.38× to 478.18×.},
}

