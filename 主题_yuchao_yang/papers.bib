  author = {Zhen Yang and Teng Zhang and Keqin Liu and Yuchao Yang},
  year = {2024},
  doi = {10.1109/edtm58488.2024.10512321},
  url = {https://doi.org/10.1109/edtm58488.2024.10512321},
