  title = {Roadmap to Neuromorphic Computing with Emerging Technologies},
  author = {Adnan Mehonic and Daniele Ielmini and Kaushik Roy and Onur Mutlu and Shahar Kvatinsky and Teresa Serrano-Gotarredona and Bernabé Linares-Barranco and Sabina Spiga and Sergey Savelev and Alexander G. Balanov and Nitin Chawla and Giuseppe Desoli and Gerardo Malavena and Christian Monzio Compagnoni and Zhongrui Wang and J. Joshua Yang and Syed Ghazi Sarwat and Abu Sebastian and Thomas Mikolajick and Beatriz Noheda and Stefan Slesazeck and Bernard Dieny and Tuo-Hung Hou and Akhil Varri and Frank Brückerhoff-Plückelmann and Wolfram H. P. Pernice and Xixiang Zhang and Sebastian Pazos and Mario Lanza and Stefan Wiefels and Regina Dittmann and Wing H. Ng and Mark Buckwell and Horatio Cox and Daniel J. Mannion and Anthony J. Kenyon and Yingming Lu and Yuchao Yang and Damien Querlioz and Louis Hutin and Elisa Vianello and Sayeed Shafayet Chowdhury and Piergiulio Mannocci and Yimao Cai and Zhong Sun and Giacomo Pedretti and John Paul Strachan and Dmitri B. Strukov and Manuel Le Gallo and Stefano Ambrogio and Ilia Valov and Rainer Waser},
