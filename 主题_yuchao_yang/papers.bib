  annotation = {中文辅助译名：电介质中纳米级金属夹杂物的电化学动力学},
}

@misc{yuchao_yang_d48d7383893c1b5f,
  title = {Resistive switching effects in CeO2/La0.7(Sr0.1Ca0.9)0.3MnO3/Pt heterostructures prepared by pulse laser deposition method},
