@misc{yuchao_yang_d3b1a9ef128438a9,
  title = {Nonvolatile resistive switching in single crystalline ZnO nanowires},
  author = {Yuchao Yang and Xiaoxian Zhang and Min Gao and Fei Zeng and Weiya Zhou and Sishen Xie and Feng Pan},
  year = {2011},
  doi = {10.1039/c1nr10096c},
