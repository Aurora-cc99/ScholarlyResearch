@misc{panorama_54c22415633b_a3679dde0cde6e81,
  title = {Predicting escitalopram monotherapy response in depression: The role of anterior cingulate cortex},
  author = {Shui Tian and Yurong Sun and Junneng Shao and Siqi Zhang and Zhaoqi Mo and Xiaoxue Liu and Qiang Wang and Li Wang and Peng Zhao and Mohammad Ridwan Chattun and Zhijian Yao and Tianmei Si and Qing Lü},
