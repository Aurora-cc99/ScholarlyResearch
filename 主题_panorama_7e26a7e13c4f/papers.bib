@misc{panorama_7e26a7e13c4f_1348b0ee20ff1275,
  title = {Effective method for fusing infrared and visible images},
  author = {Yu Fu and Xiao-Jun Wu and Josef Kittler},
  year = {2021},
  doi = {10.1117/1.jei.30.3.033013},
  url = {https://doi.org/10.1117/1.jei.30.3.033013},
  howpublished = {Journal of Electronic Imaging},
  annotation = {中文辅助译名：融合红外与可见光图像的有效方法},
  abstract = {Recently, deep learning has become a rapidly developing tool in the field of image fusion. An innovative image fusion method for fusing infrared images and visible-light images is proposed. The backbone network is an autoencoder. Different from previous autoencoders, the information extraction capability of the encoder is enhanced, and the ability to select the most effective channels in the decoder is optimized. First, the features of the source image are extracted during the encoding process. Then, a new effective fusion strategy is designed to fuse these features. Finally, the fused image is reconstructed by the decoder. Compared with the existing fusion methods, the proposed algorithm achieves state-of-the-art performance in both objective evaluation and visual quality.},
}

@misc{panorama_7e26a7e13c4f_8e54da776f82206f,
  title = {Weak sub-network pruning for strong and efficient neural networks},
  author = {Xiao-Jun Wu},
  year = {2021},
  doi = {10.1016/j.neunet.2021.09.015},
  url = {https://doi.org/10.1016/j.neunet.2021.09.015},
  howpublished = {Neural networks : the official journal of the International Neural Network Society},
  annotation = {中文辅助译名：弱子网络剪枝以获得强大而高效的神经网络},
  abstract = {Pruning methods to compress and accelerate deep convolutional neural networks (CNNs) have recently attracted growing attention, with the view of deploying pruned networks on resource-constrained hardware devices. However, most existing methods focus on small granularities, such as weight, kernel and filter, for the exploration of pruning. Thus, it will be bound to iteratively prune the whole neural networks based on those small granularities for high compression ratio with little performance loss. To address these issues, we theoretically analyze the relationship between the activation and gradient sparsity, and the channel saliency. Based on our findings, we propose a novel and effective method of weak sub-network pruning (WSP). Specifically, for a well-trained network model, we divide the whole compression process into two non-iterative stages. The first stage is to directly obtain a strong sub-network by pruning the weakest one. We first identify the less important channels from all the layers and determine the weakest sub-network, whereby each selected channel makes a minimal contribution to both the feed-forward and feed-backward processes. Then, a one-shot pruning strategy is executed to form a strong sub-network enabling fine tuning, while significantly reducing the impact of the network depth and width on the compression efficiency, especially for deep and wide network architectures. The second stage is to globally fine-tune the strong sub-network using several epochs},
}

@misc{panorama_7e26a7e13c4f_3c2bfb79140f6cd8,
  title = {Blind image deblurring via enhanced sparse prior},
  author = {Dayi Yang and Xiao-Jun Wu and Hefeng Yin},
  year = {2021},
  doi = {10.1117/1.jei.30.2.023031},
  url = {https://doi.org/10.1117/1.jei.30.2.023031},
  howpublished = {Journal of Electronic Imaging},
  annotation = {中文辅助译名：通过增强稀疏先验进行盲图像去模糊},
  abstract = {We present an effective blind image deblurring method based on the reweighted L1 norm prior. The prior is motivated by that the traditional L1 norm highly depends on the pixel itself, that is, the larger the pixel value, the greater the penalty. However, the blur reduces the high-frequency components of the clear image, and minimizing the high-frequency part will result in a blur solution or delta function kernel. To overcome this limitation, we employ the reweighted L1 norm and it eliminates this dependence within wisely weighting. The image prior compensates for the degeneration of high intensities and greatly stabilizes the intermediate image estimation process. However, the prior proposed introduces a challenging optimization problem. We develop an efficient optimization scheme to obtain a reliable intermediate image for estimating the blur kernel. Extensive experiments on different kinds of challenging blurry images demonstrate the superiority of our proposed method over the state-of-the-art blind deblurring methods. Moreover, our blind deblurring algorithm is effective in various scenarios, such as natural, text, and low-light images.},
}

