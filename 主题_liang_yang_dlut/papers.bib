@misc{hongfei_lin_5fb46665d1bf695d,
  title = {Mechanistic Insights into Deferred Semantic Drift in LLMs},
  author = {Liang Yang and Shaowu Zhang and Hongfei Lin and Yuanyuan Sun and Jingjie Zeng and Huayang Li},
  year = {2026},
  doi = {10.18653/V1/2026.FINDINGS-ACL.57},
  url = {https://doi.org/10.18653/V1/2026.FINDINGS-ACL.57},
  howpublished = {ACL (Findings)},
  annotation = {中文辅助译名：对大语言模型延迟语义漂移的机制见解},
  abstract = {Large Language Models (LLMs) face a fundamental challenge with delayed disambiguation: How is the meaning of an ambiguous word updated when clarifying context arrives only after it has been processed?While LLMs possess the latent capacity to resolve such ambiguities-as revealed when a full, non-causal context is provided-their unidirectional architecture prevents immediate updates.We investigate the underlying computational mechanism and show this semantic re-evaluation is deferred to subsequent tokens in a process we term "Deferred Semantic Drift (DSD)".Through targeted analysis of attentional pathways, we find that later tokens actively retrieve context-dependent "informational packets" from the ambiguous word's value vector to steer the final interpretation.We demonstrate this mechanism in metaphor comprehension and provide causal validation by steering model outputs towards literal or metaphorical meanings via targeted activation interventions.This research uncovers a key computational strategy for meaning construction, offering crucial insights for understanding and guiding the behavior of LLMs 1 .},
}

