@misc{panorama_25bd4cdce72c_5aaf7fc053183353,
  title = {Multirapid Serial Visual Presentation Framework for EEG-Based Target Detection},
  author = {Zhimin Lin and Ying Zeng and Hui Gao and Li Tong and Chi Zhang and Xiaojuan Wang and Qunjian Wu and Bin Yan},
  year = {2017},
  doi = {10.1155/2017/2049094},
  url = {https://doi.org/10.1155/2017/2049094},
  howpublished = {BioMed Research International},
  annotation = {中文辅助译名：用于基于脑电图的目标检测的多快速串行视觉呈现框架},
  abstract = {Target image detection based on a rapid serial visual presentation (RSVP) paradigm is a typical brain-computer interface system with various applications, such as image retrieval. In an RSVP paradigm, a P300 component is detected to determine target images. This strategy requires high-precision single-trial P300 detection methods. However, the performance of single-trial detection methods is relatively lower than that of multitrial P300 detection methods. Image retrieval based on multitrial P300 is a new research direction. In this paper, we propose a triple-RSVP paradigm with three images being presented simultaneously and a target image appearing three times. Thus, multitrial P300 classification methods can be used to improve detection accuracy. In this study, these mechanisms were extended and validated, and the characteristics of the multi-RSVP framework were further explored. Two different P300 detection algorithms were also utilized in multi-RSVP to demonstrate that the scheme is universally applicable. Results revealed that the detection accuracy of the multi-RSVP paradigm was higher than that of the standard RSVP paradigm. The results validate the effectiveness of the proposed method, and this method can provide a whole new idea in the field of EEG-based target detection.},
}

@misc{panorama_25bd4cdce72c_de2b6c75a6c2b05f,
  title = {基于UPLC-MS/MS分析技术的姜黄素纳米粒大鼠体内药动学研究},
  author = {潘雯 and Pan Wen and 赵锐帆 and Zhao Rui-fan and 王济 and Wang Ji and 王莹 and Ying Wang and 雷丸 and Lei Wan and 王晓娟 and Xiaojuan Wang},
  year = {2016},
  doi = {10.7501/j.issn.0253-2670.2016.21.014},
  url = {https://www.tiprpress.com/zcy/article/abstract/20162114},
  howpublished = {Zhongcaoyao},
  annotation = {中文辅助译名：基于UPLC-MS/MS分析技术的姜黄素纳米粒大鼠体内药动学研究},
  abstract = {目的研究磷脂酰丝氨酸（PS）修饰的姜黄素纳米粒（Cur-mNLC）在大鼠体内的药动学特点，并与无PS修饰的姜黄素纳米粒（Cur-NLC）及游离姜黄素（Cur）溶液在大鼠体内的药动学特征进行比较。 方法SD大鼠ip给予Cur-mNLC、Cur-NLC和Cur溶液（剂量以Cur计均为10mg/kg），于给药后不同时间点大鼠眼眶取血，采用UPLC-MS/MS法测定血浆中Cur的量，并采用DAS软件计算其药动学参数。 结果Cur溶液组、Cur-NLC组和Cur-mNLC组的达峰浓度（Cmax）分别为（29.453±1.146）、（20.045±0.818）、（15.865±0.409）μg/L，平均滞留时间（MRT0~∞）分别为（18.196±1.456）、（18.196±1.456）、（89.252±12.049）h，Cur-mNLC的药时曲线下面积（AUC0~∞）为（933.014±106.766）μg·h/L，分别是Cur溶液[（362.193±17.574）μg·h/L]和Cur-NLC[（632.026±145.224）μg·h/L]的AUC0~∞的2.58倍和1.48倍。 结论与Cur溶液组相比，Cur-NLC和Cur-mNLC组大鼠血浆Cmax值较低，但Cur-NLC和Cur-mNLC中药物清除比游离药物组慢；与Cur-NLC相比，Cur-mNLC具有更好的缓释作用，极大提高了Cur的生物利用度。},
}

@misc{panorama_25bd4cdce72c_c076f1c7e52af9dc,
  title = {Glucocorticoids Enhance Muscle Proteolysis through a Myostatin-Dependent Pathway at the Early Stage},
  author = {Ruxia Wang and Hongchao Jiao and Jingpeng Zhao and Xiaojuan Wang and Hai Lin},
  year = {2016},
  doi = {10.1371/journal.pone.0156225},
  url = {https://doi.org/10.1371/journal.pone.0156225},
