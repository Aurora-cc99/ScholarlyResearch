  author = {Dongliang Chen and Guihua Wen and Pengcheng Wen and Huihui Li and Pei Yang and Chuyun Chen and Bao Wang},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3680134},
  url = {https://doi.org/10.1109/TAFFC.2026.3680134},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：通过样本图关系自蒸馏的基于视频的跨域情感识别},
  abstract = {Facial expression recognition (FER) under cross-domain scenarios is a challenging task due to the datasets bias and distribution variation. However, existing cross-domain FER models are limited to the static images, less attention has been given to dynamic facial videos. The presence of domain discrepancies at both the spatial frames and temporal sequence levels further complicates the emotion recognition. To this end, this paper proposes a novel unsupervised video-based cross-domain FER method called Sample-graph Relations Self-distillation (SRS). Specifically, SRS first constructs a dual sample-graph transformer (DSGT) by integrating a frame-based optimal transport graph (FOTG) and a video-based hyperbolic-geometry graph (VHG) to capture critical inter- and intra-domain sample relations from both frame-level and video-level perspectives, which facilitates the interaction of similar emotion videos under two domains. Then, a domain graphs alignment is designed to align the intra-domain graphs in both frame and video views, respectively. This enables the consistency of topological structures of two domains to enhance similar emotion videos capturing across domains. Furthermore, to effectively improve the domain generalization ability of base network, SRS adapts a self-distillation manner based on selective source and target emotion soft labels to transfer the reliably sample-graph relations from DSGT to base network. Experimental results on cross-domain settings based on sever},
}

