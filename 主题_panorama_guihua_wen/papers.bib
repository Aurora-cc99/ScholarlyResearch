@misc{panorama_guihua_wen_27d6f041c3c884ec,
  title = {Curriculum-Guided Contrastive Self-Supervised Learning Approach for Rare Disease Recognition in Dermatoscopic and Clinical Skin Imaging},
  author = {Ikebetobong Peter Udoessiet and Guihua Wen},
  year = {2025},
  doi = {10.1109/access.2025.3624376},
  url = {https://doi.org/10.1109/access.2025.3624376},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：课程引导的对比自我监督学习方法用于皮肤镜和临床皮肤成像中罕见疾病的识别},
  abstract = {Accurate diagnosis of rare skin diseases from dermatoscopic and clinical images remains a significant challenge due to limited annotated data and class imbalance. These limitations often lead to misdiagnosis and delayed treatment, especially for rare conditions. To address this, we propose a Curriculum-Guided Contrastive Self-Supervised Learning (CG-CSSL) framework that leverages both labeled and unlabeled skin images to improve rare disease recognition. Our method integrates curriculum learning with contrastive self-supervision to progressively adapt the model from common to rare disease patterns. Evaluations on the ISIC 2019 dataset (with over 25,000 dermatoscopic images) and the Dermofit Image Library (1,300 clinical images across 10 classes) show that CG-CSSL outperforms traditional supervised learning and leading self-supervised methods including SimCLR and BYOL, achieving a 7.3% mean F1-score improvement on rare disease classes. The framework significantly enhances generalization on limited samples by learning robust and discriminative feature representations. This study lays the groundwork for integrating curriculum-guided self-supervised learning into clinical decision support pipelines and extending its application to other low-data medical domains involving multimodal imaging and longitudinal patient data.},
}

@misc{panorama_guihua_wen_8b5ccd5fc1a07ad6,
