@misc{panorama_e8981be47f6c_27596d5a814e5c54,
  title = {Multi-Class Object Counting Network With Adaptive Class Alignment Loss for Remote Sensing Images},
  author = {Zhiwei Zhu and Li Zhang and Hao-Yuan Ma and Xiang-Yi Wei and Yan Zhang},
  year = {2026},
  doi = {10.1109/LSP.2025.3630090},
