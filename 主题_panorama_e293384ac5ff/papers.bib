  annotation = {中文辅助译名：MAPLE：基于 Mamba 的自适应原型学习，用于顺序推荐中的意图解开},
  abstract = {Sequential recommender systems struggle to simultaneously capture persistent long-term preferences and volatile short-term intentions, while existing dual-stream architectures are computationally inefficient when handling long sequences and suffer from feature entanglement between the two interest streams. To address these issues, we propose a Mamba-based Adaptive Prototype LEarning and cross-intent contrastive alignment framework (MAPLE). MAPLE employs Mamba as the long-term encoder; its selective state space mechanism selectively retains important historical signals across the entire interaction sequence, making it well-suited for capturing stable long-term interest features with linear computational complexity. Meanwhile, the GRU-based short-term encoder focuses on a local tail window to model recent preference shifts. To decouple these two interest streams, we maintain a set of global semantic prototypes for each interest type and extract soft proxies as personalized semantic anchors through attention-weighted aggregation, thereby leveraging global intent consensus to enrich individual user representations. These proxies are further applied as contrastive anchors in a novel cross-intent InfoNCE loss, which treats proxies of the complementary intent stream as cross-intent contrastive anchors to promote semantic differentiation between long and short-term representations. Finally, we introduce an asymmetric dynamic gated fusion module that prioritizes long-term features as },
}

@misc{panorama_e293384ac5ff_b3b7bb0c09330a5c,
  title = {SIAM: Towards Generalizable Articulated Object Modeling via Single Robot-Object Interaction},
  author = {Yuyan Liu and Li Zhang and Di Wu and Yan Zhang and Anran Huang and Zhi Wang and Liu Liu and Dan Guo},
  year = {2026},
  doi = {10.1609/AAAI.V40I22.38913},
  url = {https://doi.org/10.1609/AAAI.V40I22.38913},
  howpublished = {AAAI},
  annotation = {中文辅助译名：SIAM：通过单个机器人与对象交互实现通用铰接对象建模},
  abstract = {Articulated object modeling, which represents interconnected rigid bodies with their geometry, part segmentation, articulation tree, and physical properties, is crucial for robotic perception and manipulation. Recently existing methods like SAGCI leverage Interactive Perception (IP) to refine models through robot interaction. However, SAGCI suffers from prior-dependency (requiring initialization), neglects kinematic/dynamic constraints, and generates non-watertight meshes. To overcome these limitations, we propose SIAM, a novel framework for efficient and generalizable Single-Interaction Articulated Modeling. Given an initial point cloud, SIAM first enables minimal robot interaction to trigger object motion. It then precisely segments parts by analyzing point cloud differences pre- and post-interaction. For joint parameter estimation, we introduce an optimization incorporating novel kinematic energy constraints, enhancing physical consistency. Finally, we reconstruct a high-quality, topologically watertight mesh by learning 3D Gaussian Primitives from multi-view RGB-D observations under deformation. Extensive experiments on the PartNet-Mobility benchmark demonstrate state-of-the-art articulation modeling performance. Successful real-world deployment with an xArm robot further validates the framework's practicality and transferability. SIAM achieves accurate, prior-free modeling with significantly reduced interaction cost.},
}

@misc{panorama_e293384ac5ff_9d90871b0d45cd84,
