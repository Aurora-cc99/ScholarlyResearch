@misc{huiguang_he_b06ca6350ea6,
  title = {Characterizing Functional Clusters of V4 Neurons in Digital Twins},
  author = {Rendong Tang and Qiongyi Zhou and Wenghao Zhao and Zhuoyue Dai and Rui Zhang and Jiayu Wang and Gongting Wang and Changde Du and Huiguang He and Haidong D. Lu},
  year = {2026},
  doi = {10.64898/2026.07.25.740202},
  url = {https://doi.org/10.64898/2026.07.25.740202},
  howpublished = {bioRxiv (Cold Spring Harbor Laboratory)},
  annotation = {中文辅助译名：表征数字孪生中 V4 神经元的功能集群},
  abstract = {Abstract Neurons in primate visual cortical area V4 display tuning for multiple visual features, including color, shape, texture, and depth. Whether and how these neurons are organized into functional architectures remains largely unknown. Using two-photon calcium imaging in anesthetized macaques, we recorded responses of hundreds of V4 neurons to natural images and used these data to train deep convolutional neural network models (digital twins), obtaining synthetic images (SI) that maximized neuronal responses. Based on their SIs, these neurons clustered into classes that spatially matched the orientation, color, and curvature maps from intrinsic signal imaging. Furthermore, lesion study in digital twins revealed different integration rules for different neuron classes. Thus, digital twins of V4 neurons can be applied as a promising tool to characterize neurons’ fundamental features, which underlie the functional clustering in this area. Highlights Neurons in V4 are examined with two-photon calcium imaging and DCNN modeling (digital twins) Synthetic images derived from neurons’ digital twins reveal distinct neuron groups These groups match functional types defined by intrinsic signal optical imaging Lesion study in digital twins demonstrates neural mechanisms underlying feature tuning},
}

@misc{huiguang_he_a6055d65d087e6eb,
  title = {Quantization and disentanglement for cross-modal alignment in neural speech reconstruction from brain activity},
  author = {Che Liu and Changde Du and Xiaoyu Chen and Huiguang He},
  year = {2026},
  doi = {10.1016/J.PATCOG.2026.114499},
  url = {https://doi.org/10.1016/J.PATCOG.2026.114499},
  howpublished = {Pattern Recognit.},
  annotation = {中文辅助译名：大脑活动神经语音重建中跨模态对齐的量化和解缠},
  abstract = {Understanding and reconstructing speech from brain activity is central to advancing neuroscience and brain–computer interface (BCI) research. Despite recent progress, current brain-to-speech approaches remain limited by entangled neural representations, overly fine-grained decoding targets, and poor generalization. To address these challenges, we propose a novel framework that integrates quantization with representation disentanglement. Instead of learning brain-specific discrete units, we directly align magnetoencephalography (MEG) signals with the codebook of a pretrained neural audio codec. To balance representational capacity and decoding complexity, we introduce a discrete contrastive loss combining codebook clustering and temporal pooling. Furthermore, we factorize speech into prosody, content, and timbre, and decode these subspaces separately, simplifying learning and enhancing decoding precision. Experiments on two public MEG datasets demonstrate strong performance in both intra- and cross-subject settings, yielding substantial improvements in prosody-related and perceptual metrics. Our findings highlight a principled pathway towards more reliable brain-to-speech decoding, with potential applications in assistive communication and BCI technologies.},
}

@misc{huiguang_he_e25c6e3732ca,
  title = {The semantic geometry of action: convergence across foundation models, human behaviour and the brain},
  author = {Huiguang He and Changde Du and Yi Sun and Yizhuo Lu and Shuang Qiu and Kun Zhao and Yaozhi Wen and Chen Hu},
  year = {2026},
  doi = {10.21203/rs.3.rs-10930847/v1},
  url = {https://doi.org/10.21203/rs.3.rs-10930847/v1},
  howpublished = {Research Square},
  annotation = {中文辅助译名：动作的语义几何：基础模型、人类行为和大脑的融合},
  abstract = {Abstract Interpreting dynamic human actions is central to biological intelligence and essential for embodied artificial intelligence. Although foundation models achieve robust accuracy in action recognition, it remains unclear whether they organize naturalistic actions within a representational geometry aligned with human perception. Here, we evaluated the semantic organization of action representations across foundation models, human behaviour, and the human cortex. By analyzing over two million triplet similarity judgements, we extracted stable, low-dimensional semantic spaces from both text-only large language models and multimodal models. These model-derived spaces predicted human behavioral judgements of action similarity more accurately than baseline spatiotemporal video encoders. To evaluate the functional relevance of these extracted spaces, we demonstrated that modulating individual dimensions within a generative pipeline produced predictable, corresponding semantic shifts in synthesized video content. Furthermore, when transferred without retraining to an independent, large-scale video-fMRI dataset, these model-derived action dimensions successfully predicted stimulus-evoked cortical responses across higher-order visual, temporal, and sensorimotor networks. Together, these findings demonstrate a convergent semantic organization for naturalistic actions across artificial foundation models, human cognitive judgements, and cortical representations.},
}

