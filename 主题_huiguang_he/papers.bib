@misc{huiguang_he_ad0971340508bcbd,
  title = {MFD: Modality-Aware Fusion of FMRI and MEG for Noninvasive Speech Decoding},
  author = {Pengfei Yun and Che Liu and Changde Du and Huiguang He and Dinggang Shen},
  year = {2026},
  doi = {10.1109/ISBI61048.2026.11515359},
  url = {https://doi.org/10.1109/ISBI61048.2026.11515359},
  howpublished = {ISBI},
  annotation = {中文辅助译名：MFD：FMRI 和 MEG 的模态感知融合，用于无创语音解码},
  abstract = {Restoring speech from noninvasive brain signals is crucial for practical language brain-computer interfaces and understanding cortical language representation. However, noninvasive recordings still face a fundamental spatial-temporal trade-off: functional magnetic resonance imaging (fMRI) provides fine spatial localization but slow hemodynamics, whereas magnetoencephalography (MEG) captures rapid neural dynamics with lower spatial resolution. To boost decoding accuracy, we exploit their complementarity and propose MFD, a modalityaware, two-stage fusion framework for continuous Mandarin speech decoding. MFD adaptively integrates fMRI and MEG representations, enabling cross-modal compensation between spatial and temporal features. Results on a public multimodal Mandarin dataset show that MFD consistently outperforms unimodal baselines in retrieval tasks, achieving 61.7 % top10 accuracy among 553 candidates. Further analysis indicates MEG representations better capture temporal-acoustic structure, while fMRI correlates more strongly with semantic content. These results highlight the complementary nature of fMRI and MEG and demonstrate the potential of multimodal fusion frameworks for neural speech decoding.},
}

@misc{huiguang_he_0f3616f46fbf3ec2,
  title = {Mind-Omni: A Unified Multi-Task Framework for Brain-Vision-Language Modeling via Discrete Diffusion},
  author = {Yizhuo Lu and Changde Du and Qingyu Shi and Hang Chen and Jie Peng and Liuyun Jiang and Shuangchen Zhao and Huiguang He},
  year = {2026},
  doi = {10.48550/ARXIV.2605.29591},
  url = {https://doi.org/10.48550/ARXIV.2605.29591},
  howpublished = {CoRR},
  annotation = {中文辅助译名：Mind-Omni：通过离散扩散进行脑视觉语言建模的统一多任务框架},
  abstract = {Modeling the interplay between external stimuli and internal neural representations is a pivotal research area for Brain-Computer Interfaces (BCIs). A major limitation of prior work is the prevailing paradigm of specialized, single-task models, which curtails versatility and neglects inter-task synergies. To address this, we propose Mind-Omni, the first versatile framework that unifies seven distinct encoding and decoding tasks through a discrete diffusion paradigm. At its core is a novel Brain Tokenizer that transforms heterogeneous, continuous brain signals into standardized, discrete tokens. This enables direct, token-level interactions for mutual understanding and generation between any two or more modalities within a shared semantic space. To unlock advanced reasoning capabilities, we further curate a specialized Brain Question Answering (BQA) instruction-tuning dataset. Our model not only establishes a new state-of-the-art among multi-task unified frameworks but also provides strong evidence for multi-task synergy. By demonstrating performance competitive with, and at times superior to, larger specialized models, our work offers a powerful new paradigm for neural modeling and paves the way for foundation models of neural activity. The code is publicly available at https://github.com/ReedOnePeck/Mind-Omni.},
}

