@misc{xu_ruifeng_06298a8bee7a,
  title = {PITA: Prompting Task Interaction for Argumentation Mining},
  author = {Yang Sun and Muyi Wang and Jianzhu Bao and Bin Liang and Xiaoyan Zhao and Caihua Yang and Min Yang and Ruifeng Xu},
