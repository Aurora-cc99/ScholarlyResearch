  annotation = {中文辅助译名：通过跨模态图卷积网络进行多模态讽刺检测},
  abstract = {Bin Liang, Chenwei Lou, Xiang Li, Min Yang, Lin Gui, Yulan He, Wenjie Pei, Ruifeng Xu. Proceedings of the 60th Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers). 2022.},
}

@misc{xu_ruifeng_a58e5b763794a7e4,
  title = {Aspect-based sentiment analysis via affective knowledge enhanced graph convolutional networks},
  author = {Bin Liang and Hang Su and Lin Gui and Erik Cambria and Ruifeng Xu},
  year = {2022},
  doi = {10.1016/J.KNOSYS.2021.107643},
