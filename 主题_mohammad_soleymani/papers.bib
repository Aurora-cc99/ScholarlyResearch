@misc{mohammad_soleymani_1ec9a33e5fda154d,
  title = {ARIA: Affect-Responsive Interaction Alignment for Emotional Support Policies via Implicit Multimodal Affective Feedback},
  author = {Deuksin Kwon and Kevin Joo and Elena Hayoung Lee and Mohammad Soleymani and Gale Lucas},
  year = {2026},
  doi = {10.18653/2026.findings-emnlp.814},
  url = {https://doi.org/10.18653/2026.findings-emnlp.814},
  howpublished = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  annotation = {中文辅助译名：ARIA：通过隐式多模态情感反馈进行情感支持策略的情感响应交互调整},
  abstract = {Effective emotional-support dialogue requires more than fluent empathy: responses must adapt to the support seeker's evolving state.Existing emotional-support systems are largely optimized at the response level and may therefore learn the form of supportive counseling without reliably adapting to client-side change.We introduce ARIA, Affect-Responsive Interaction Alignment, a client-centered alignment framework that constructs DPO preference pairs from the support seeker's subsequent multimodal affective trajectories observed in human interactions.ARIA distills audio-and visualderived valence trajectories into text-based predictors and uses cross-modal consensus and uncertainty-aware filtering to identify highconfidence preferences associated with delayed client-side valence improvement.Experiments show that ARIA improves process-oriented measures of client progress beyond surface compliance and produces support that is more timely and calibrated to the seeker's evolving openness.Behavioral analyses further show a phase-sensitive shift from restrained pre-open support toward more active support after openness emerges.Human and counseling-expert evaluations provide evidence that ARIA's responses are more timely, targeted, and supportive of the client's own process.},
}

@misc{mohammad_soleymani_ebf978b74c4abc86,
  title = {AVERE: Improving Audiovisual Emotion Reasoning with Preference Optimization},
  author = {Jiacheng Pang and Maksim Siniukov and Ashutosh Chaubey and Mohammad Soleymani},
  year = {2026},
  doi = {10.48550/arxiv.2602.07054},
  url = {https://pubmed.ncbi.nlm.nih.gov/42801257},
  howpublished = {ICLR},
  annotation = {中文辅助译名：AVERE：通过偏好优化改善视听情感推理},
  abstract = {, a preference optimization technique that aligns model responses with both audiovisual inputs and emotion-centric queries. Specifically, we construct preferences over (i) responses exhibiting spurious associations or hallucinations and (ii) audiovisual input pairs guided by textual prompts. We also include a regularization term that penalizes reliance on text priors, thereby mitigating modality-specific cue hallucinations. Experimental results on DFEW, RAVDESS and EMER demonstrate that our method significantly improves the performance of the reference baseline models (6-19% of relative performance) in zero-shot settings. By providing both a rigorous benchmark and a robust optimization framework, this work enables principled evaluation and improvement of MLLMs for emotion understanding and social AI. Code, models and benchmark at our project page - avere-iclr.github.io.},
}

@misc{mohammad_soleymani_087b328d1cb8cc46,
  title = {Face-LLaVA: Facial Expression and Attribute Understanding through Instruction Tuning},
  author = {Xulang Guan and Ashutosh Chaubey and Mohammad Soleymani},
  year = {2026},
  doi = {10.1109/WACV61042.2026.00260},
  url = {https://doi.org/10.1109/WACV61042.2026.00260},
  howpublished = {WACV},
  annotation = {中文辅助译名：Face-LLaVA：通过指令调整理解面部表情和属性},
  abstract = {The human face plays a central role in social communication, necessitating the use of performant computer vision tools for human-centered applications. We propose Face-LLaVA, a multimodal large language model for face-centered, in-context learning, including facial expression and attribute recognition. Additionally, Face-LLaVA is able to generate natural language descriptions that can be used for reasoning. Leveraging existing visual databases, we first developed FaceInstruct-1M, a face-centered database for instruction tuning MLLMs for face processing. We then developed a novel face-specific visual encoder powered by Face-Region Guided Cross-Attention that integrates face geometry with local visual features. We evaluated the proposed method across nine different datasets and five different face processing tasks, including facial expression recognition, action unit detection, facial attribute detection, age estimation and deepfake detection. Face-LLaVA achieves superior results compared to existing open-source MLLMs and competitive performance compared to commercial solutions. Our model output also receives a higher reasoning rating by GPT under a zero-shot setting across all the tasks. Both our dataset and model wil be released at https://face-llava.github.io to support future advancements in social AI and foundational vision-language research.},
}

@misc{mohammad_soleymani_c187270b79abb576,
  title = {GDPO-Listener: Expressive Interactive Head Generation via Auto-Regressive Flow Matching and Group reward-Decoupled Policy Optimization},
  author = {Maksim Siniukov and Ashutosh Chaubey and Deuksin Kwon and Mohammad Soleymani and Zhangyu Jin},
  year = {2026},
  doi = {10.48550/ARXIV.2603.25020},
  url = {https://doi.org/10.48550/ARXIV.2603.25020},
  howpublished = {CoRR},
  annotation = {中文辅助译名：GDPO-Listener：通过自回归流量匹配和组奖励解耦策略优化生成富有表现力的交互式头},
  abstract = {Generating realistic 3D head motion for dyadic interactions is a significant challenge in virtual human synthesis. While recent methods achieve impressive results with speaking heads, they frequently suffer from the `Regression-to-the-Mean' problem in listener motions, collapsing into static faces, and lack the parameter space for complex nonverbal motions. In this paper, we propose GDPO-Listener, a novel framework that achieves highly expressive speaking and listening motion generation. First, we introduce an Auto-Regressive Flow Matching architecture enabling stable supervised learning. Second, to overcome kinematic stillness, we apply the Group reward-Decoupled Policy Optimization (GDPO). By isolating reward normalization across distinct FLAME parameter groups, GDPO explicitly incentivizes high variance expressive generations. Finally, we enable explicit semantic text control for customizable responses. Extensive evaluations across the Seamless Interaction and DualTalk datasets demonstrate superior performance compared to existing baselines on long-term kinematic variance, visual expressivity and semantic controllability.},
}

