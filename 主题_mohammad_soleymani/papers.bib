@misc{mohammad_soleymani_f30133ea9232d5c4,
  title = {Proceedings of the 1st International Workshop on Affect & Sentiment in Multimedia},
  author = {Mohammad Soleymani and MM '15: ACM Multimedia Conference 2015 Brisbane Australia and Association for Computing Machinery-Digital Library and ACM Special Interest Group on Multimedia Systems and ACM SIGs},
  year = {2015},
  doi = {10.1145/2813524},
  url = {https://doi.org/10.1145/2813524},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：第一届多媒体情感与情感国际研讨会论文集},
  abstract = {It is our great pleasure to welcome you to the 2015 ACM Workshop on Affect and Sentiment in Multimedia -- ASM'15. This is the first workshop on affect and sentiment in multimedia with a focus on multimedia content analysis. The aim of the workshop is to provide a forum to present and discuss the recent advancement in affective analysis in multimedia. ASM'15 gives researchers a unique opportunity to share their ideas in an interdisciplinary workshop. For this reason, we invited two keynote speakers from related fields, namely, psychology of emotion and recommendation systems to bring their perspectives to this multimedia related venue. The call for papers attracted 16 submissions from all over the world. The program committee reviewed and accepted 9 submissions. We also encourage attendees to attend the following keynote talk: "Blending Users, Content, and Emotions for Movie Recommendations," Shlomo Berkovsky, (CSIRO, Australia)},
}

@misc{mohammad_soleymani_b3d866ce882dc3be,
  title = {The Quest for Visual Interest},
  author = {Mohammad Soleymani},
  year = {2015},
  doi = {10.1145/2733373.2806364},
  url = {https://doi.org/10.1145/2733373.2806364},
  howpublished = {ACM Multimedia},
  annotation = {中文辅助译名：对视觉兴趣的追求},
  abstract = {In this paper, we report on identifying the underlying factors that contribute to the visual interest in digital photos. A set of 1005 digital photos covering different topics and of different qualities was collected from Flickr. Images were annotated by a pool of diverse participants on a crowdsourcing platform. 12 bipolar ratings were collected for each photo on 7-point semantic differential scale, including dimensions related to interest, emotions and image quality. Every image received 20 annotations from unique participants. The most important appraisals and visual attributes for visual interest in photos was identified. We found that intrinsic pleasantness, arousal, visual quality and coping potential are the most important factors contributing to visual interest in digital photos. We developed a system that automatically detects the important visual attributes from low level visual features and demonstrated their significance in predicting interest at individual level.},
}

@misc{mohammad_soleymani_523a302c2e8abfa1,
  title = {Multimodal emotion recognition in response to videos (Extended abstract)},
  author = {Thierry Pun and Mohammad Soleymani and Maja Pantic},
  year = {2015},
  doi = {10.1109/ACII.2015.7344615},
  url = {https://doi.org/10.1109/ACII.2015.7344615},
  howpublished = {ACII},
  annotation = {中文辅助译名：对视频的多模态情感识别（扩展摘要）},
  abstract = {We present a user-independent emotion recognition method with the goal of detecting expected emotions or affective tags for videos using electroencephalogram (EEG), pupillary response and gaze distance. We first selected 20 video clips with extrinsic emotional content from movies and online resources. Then EEG responses and eye gaze data were recorded from 24 participants while watching emotional video clips. Ground truth was defined based on the median arousal and valence scores given to clips in a preliminary study. The arousal classes were calm, medium aroused and activated and the valence classes were unpleasant, neutral and pleasant. A one-participant-out cross validation was employed to evaluate the classification performance in a user-independent approach. The best classification accuracy of 68.5% for three labels of valence and 76.4% for three labels of arousal were obtained using a modality fusion strategy and a support vector machine. The results over a population of 24 participants demonstrate that user-independent emotion recognition can outperform individual self-reports for arousal assessments and do not underperform for valence assessments.},
}

