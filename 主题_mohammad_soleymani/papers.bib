@misc{mohammad_soleymani_a6edafd949c403fa,
  title = {Affective Characterization of Movie Scenes Based on Content Analysis and Physiological Changes},
  author = {Thierry Pun and Joep J. M. Kierkels and Mohammad Soleymani and Guillaume Chanel},
  year = {2009},
  doi = {10.1142/S1793351X09000744},
  url = {https://doi.org/10.1142/S1793351X09000744},
  howpublished = {Int. J. Semantic Comput.},
  annotation = {中文辅助译名：基于内容分析和生理变化的电影场景情感表征},
  abstract = {In this paper, we propose an approach for affective characterization of movie scenes based on the emotions that are actually felt by spectators. Such a representation can be used to characterize the emotional content of video clips in application areas such as affective video indexing and retrieval, and neuromarketing studies. A dataset of 64 different scenes from eight movies was shown to eight participants. While watching these scenes, their physiological responses were recorded. The participants were asked to self-assess their felt emotional arousal and valence for each scene. In addition, content-based audio- and video-based features were extracted from the movie scenes in order to characterize each scene. Degrees of arousal and valence were estimated by a linear combination of features from physiological signals, as well as by a linear combination of content-based features. We showed that a significant correlation exists between valence-arousal provided by the spectator's self-assessments, and affective grades obtained automatically from either physiological responses or from audio-video features. By means of an analysis of variance (ANOVA), the variation of different participants' self assessments and different gender groups self assessments for both valence and arousal were shown to be significant (p-values lower than 0.005). These affective characterization results demonstrate the ability of using multimedia features and physiological responses to predict the expected},
}

@misc{mohammad_soleymani_969f5512f0a14fe2,
  title = {Queries and tags in affect-based multimedia retrieval},
  author = {Thierry Pun and Mohammad Soleymani and Joep J. M. Kierkels},
  year = {2009},
  doi = {10.1109/ICME.2009.5202772},
  url = {https://doi.org/10.1109/ICME.2009.5202772},
  howpublished = {ICME},
  annotation = {中文辅助译名：基于情感的多媒体检索中的查询和标签},
  abstract = {An approach for implementing affective information as tags for multimedia content indexing and retrieval is presented. The approach can be used for implicit as well as explicit tags and is presented here using data recorded during the viewing of movie fragments containing annotations and physiological signal recordings. For retrieval based on affective queries, a representation of the query-words is defined in the arousal-valence space in the form of a Gaussian probability distribution and a retrieval method based on this representation is presented. Validation of retrieval accuracy is performed using Precision and Recall parameters. Results show that the use of arousal and valence as affective tags can improve retrieval results.},
}

@misc{mohammad_soleymani_5d9724f500bf597f,
  title = {A Bayesian framework for video affective representation},
  author = {Joep J. M. Kierkels and Mohammad Soleymani and Guillaume Chanel and Thierry Pun},
  year = {2009},
  doi = {10.1109/ACII.2009.5349563},
  url = {https://doi.org/10.1109/ACII.2009.5349563},
  howpublished = {ACII},
  annotation = {中文辅助译名：视频情感表示的贝叶斯框架},
  abstract = {Emotions that are elicited in response to a video scene contain valuable information for multimedia tagging and indexing. The novelty of this paper is to introduce a Bayesian classification framework for affective video tagging that allows taking contextual information into account. A set of 21 full length movies was first segmented and informative content-based features were extracted from each shot and scene. Shots were then emotionally annotated, providing ground truth affect. The arousal of shots was computed using a linear regression on the content-based features. Bayesian classification based on the shots arousal and content-based features allowed tagging these scenes into three affective classes, namely calm, positive excited and negative excited. To improve classification accuracy, two contextual priors have been proposed: the movie genre prior, and the temporal dimension prior consisting of the probability of transition between emotions in consecutive scenes. The f1 classification measure of 54.9% that was obtained on three emotional classes with a nai¿ve Bayes classifier was improved to 63.4% after utilizing all the priors.},
}

@misc{mohammad_soleymani_131828c4d7eea0cf,
  title = {A collaborative personalized affective video retrieval system},
  author = {J. Davis and Mohammad Soleymani and Thierry Pun},
  year = {2009},
  doi = {10.1109/ACII.2009.5349526},
  url = {https://doi.org/10.1109/ACII.2009.5349526},
  howpublished = {ACII},
  annotation = {中文辅助译名：协作个性化情感视频检索系统},
  abstract = {In this demonstration, a collaborative personalized affective video retrieval is introduced. A dataset of 155 video clips extracted from Hollywood movies were annotated by the emotion felt by participants. More than 1300 annotations from 40 participants were gathered in a database to be used for affective retrieval system. The retrieval system is able to retrieve videos based on emotional keyword query as well as arousal and valence query. The user's personal profile (gender, age, cultural background) was employed to improve the collaborative filtering in retrieval.},
}

@misc{mohammad_soleymani_37afeee43615e71c,
  title = {Affective Characterization of Movie Scenes Based on Multimedia Content Analysis and User's Physiological Emotional Responses},
  author = {Thierry Pun and Mohammad Soleymani and Joep J. M. Kierkels and Guillaume Chanel},
  year = {2008},
  doi = {10.1109/ISM.2008.14},
  url = {https://doi.org/10.1109/ISM.2008.14},
  howpublished = {ISM},
  annotation = {中文辅助译名：基于多媒体内容分析和用户生理情绪反应的电影场景情感表征},
  abstract = {In this paper, we propose an approach for affective representation of movie scenes based on the emotions that are actually felt by spectators. Such a representation can be used for characterizing the emotional content of video clips for e.g. affective video indexing and retrieval, neuromarketing studies, etc. A dataset of 64 different scenes from eight movies was shown to eight participants. While watching these clips, their physiological responses were recorded. The participants were also asked to self-assess their felt emotional arousal and valence for each scene. In addition, content-based audio- and video-based features were extracted from the movie scenes in order to characterize each one. Degrees of arousal and valence were estimated by a linear combination of features from physiological signals, as well as by a linear combination of content-based features. We showed that a significant correlation exists between arousal/valence provided by the spectator's self-assessments, and affective grades obtained automatically from either physiological responses or from audio-video features. This demonstrates the ability of using multimedia features and physiological responses to predict the expected affect of the user in response to the emotional video content.},
}

@misc{mohammad_soleymani_6584a6cd5c1e131a,
  title = {Affective ranking of movie scenes using physiological signals and content analysis},
  author = {Joep J. M. Kierkels and Guillaume Chanel and Thierry Pun and Mohammad Soleymani},
  year = {2008},
  doi = {10.1145/1460676.1460684},
  url = {https://doi.org/10.1145/1460676.1460684},
  howpublished = {MS},
  annotation = {中文辅助译名：利用生理信号和内容分析对电影场景进行情感排序},
  abstract = {In this paper, we propose an approach for affective ranking of movie scenes based on the emotions that are actually felt by spectators. Such a ranking can be used for characterizing the affective, or emotional, content of video clips. The ranking can for instance help determine which video clip from a database elicits, for a given user, the most joy. This in turn will permit video indexing and retrieval based on affective criteria corresponding to a personalized user affective profile.},
}

