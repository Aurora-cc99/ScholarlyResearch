@misc{mohammad_soleymani_4a5ca7ddca177101,
  title = {Travelogue Boredom Detection with Content Features},
  author = {Mohammad Soleymani},
  year = {2010},
  url = {http://www.multimediaeval.org/worknotes2010/Geneva_Affect.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：带有内容特征的游记无聊检测},
  abstract = {this working note, a set of features are proposed for ranking videos according to the felt boredom in users or boredom ranking. The boredom ranking can be used as a feature for video recommendation. A series of travelogue videos was used as the dataset. The features were from different modalities, namely, video, audio, and speech transcript. The amount of information that a given episode brings and the fame of places are proposed as relevant features. The boredom scores were estimated using a linear regression and relevance vector machine (RVM.). It is shown that the amount of information a video delivers to a viewer can decrease the perceived boredom.},
}

