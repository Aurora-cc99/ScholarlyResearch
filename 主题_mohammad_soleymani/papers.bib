@misc{mohammad_soleymani_c0d1e671a53965e9,
  title = {Discrete Facial Encoding: A Framework for Data-driven Facial Display Discovery},
  author = {Maksim Siniukov and Zhangyu Jin and Minh Tran and Mohammad Soleymani},
  year = {2026},
  doi = {10.1109/WACV61042.2026.00232},
  url = {https://doi.org/10.1109/WACV61042.2026.00232},
  howpublished = {WACV},
  annotation = {中文辅助译名：离散面部编码：数据驱动的面部显示发现框架},
  abstract = {Facial expression analysis is central to understanding human behavior, yet existing coding systems such as the Facial Action Coding System (FACS) are constrained by limited coverage and costly manual annotation. In this work, we introduce Discrete Facial Encoding (DFE), an unsupervised, data-driven alternative of compact and interpretable dictionary of facial expressions from 3D mesh sequences learned through a Residual Vector Quantized Variational Autoencoder (RVQ-VAE). Our approach first extracts identity-invariant expression features from images using a 3D Morphable Model (3DMM), effectively disentangling factors such as head pose and facial geometry. We then encode these features using an RVQ-VAE, producing a sequence of discrete tokens from a shared codebook, where each token captures a specific, reusable facial deformation pattern that contributes to the overall expression. Through extensive experiments, we demonstrate that Discrete Facial Encoding captures more precise facial behaviors than FACS and other facial encoding alternatives. We evaluate the utility of our representation across three high-level psychological tasks: stress detection, personality prediction, and depression detection. Using a simple Bag-of-Words model built on top of the learned tokens, our system consistently outperforms both FACS-based pipelines and strong image and video representation learning models such as Masked Autoencoders. Further analysis reveals that our representation covers a wider },
}

@misc{mohammad_soleymani_6ba27e8d60f3b7ca,
  title = {Embodied Agent-Facilitated Virtual Support Groups for University Students},
  author = {Zongjian Li and Maja J. Mataric and Abhyuday Singh and Wallace Browning and Shriya Upadhyay and Pau Sang and Mohammad Soleymani and Mallory North and Yunwen Wang and Yuanfeixue Nan and Jessica Wang and Mina Kian and Kaitlin Zareno and Lynn C. Miller},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3693987},
  url = {https://doi.org/10.1109/TAFFC.2026.3693987},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：面向大学生的具体代理促进的虚拟支持小组},
  abstract = {Facilitator-guided support groups allow individuals facing similar challenges to meet and discuss their experiences. With the rising demand for mental health resources and therapist burnout, technology-facilitated support groups may offer a supplementary mechanism for supporting individuals while fostering peer support. Through a between- and within-subjects Wizard of-Oz study, we investigated how embodied conversational agent (ECA)-guided support groups using a robot embodiment and Large Language Model (LLM)-generated responses impact participant pre- to post-session 1) anxiety, 2) positive affect, and 3) negative affect, when participants perceive the ECA to be human-operated vs. when they are led to believe it is autonomous. Results showed significant decreases in participants' levels of anxiety and negative affect, and no significant change in positive affect before and after they participated in the support group. There were no statistically significant differences between the two conditions in these change patterns as well as participants' perceived trust and evaluation of the ECA's competence as a facilitator. Analysis of objective LIWC-22 (Linguistic Inquiry and Word Count) measures agreed with results from self-reported data: there were also no significant differences in the participants' expressed emotions in language between the two conditions. The implications of this study on ECA-facilitated support group interactions for mental health are discussed.},
}

@misc{mohammad_soleymani_2933c4d8f24a4fb8,
  title = {Toward Distinguishing Cybersickness, Visual fatigue, Cognitive load and Acute Stress in Virtual Reality: Two Randomized and Controlled Studies},
  author = {Alexis D. Souchet and Diallo Mamadou Lamarana and Mohammad Soleymani and Domitile Lourdeaux},
  year = {2026},
  doi = {10.31234/osf.io/grfm3_v1},
  url = {https://doi.org/10.31234/osf.io/grfm3_v1},
  howpublished = {PsyArXiv (OSF Preprints)},
  annotation = {中文辅助译名：区分虚拟现实中的晕眩症、视觉疲劳、认知负荷和急性压力：两项随机对照研究},
  abstract = {Virtual Reality (VR) is increasingly used to study Cognitive load and Acute Stress. But VR comes with side effects such as Cybersickness and Visual fatigue. It remains unclear if we can dissociate psychophysiological responses due to confounding effects. Hence, we conducted two experiments to study and distinguish them. Participants fulfilled a Baseline, Stroop task under four different experimental conditions, Relaxation and Endline. We recorded Stroop performances, Eye tracking (ET), Electrocardiography (ECG), Electrodermal activity (EDA), self-reported Cognitive load, Stress, Cybersickness, Visual fatigue, and Disorientation. Pupil diameter, Blink frequency, Fixations, HR, HRV, and Skin Conductance Response derived between the different conditions. Most of the extracted features from ET, ECG, and EDA showed no differences between states. Despite relaxation steps, Saccade ratio, Blink frequency, Blink duration and Pupil size for ET, Heart rate for ECG, Rise time of the mean skin conductance level, the Arc length of the skin conductance level for EDA were still not back equivalent to baseline. Cognitive load differs from Acute stress based on the Heart rate feature from the ECG sensor. Cognitive load provoked more response with EDA features than Visual fatigue / Cybersickness with the ALSC feature. However, most of those differences have small effect sizes. We underline a 60 minutes immersion “limit.” ET was more sensitive to Visual fatigue / Cybersickness compared to Cognit},
}

