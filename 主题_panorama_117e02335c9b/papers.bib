@misc{zheng_lian_680e95ebee09,
  title = {The NVVSpeech Challenge 2026: Overview and Lessons for Speech Understanding and Generation with Nonverbal Vocalizations},
  author = {Liumeng Xue and Yuang Cao and Jingbin Hu and Qirui Zhan and Huakang Chen and Yibin Zheng and Yunxiang Chen and Houdun Liu and Su Feng and Haibin Wu and Zheng Lian and Wei Xue and Bengu Wu and Hui Bu and Lei Xie},
  year = {2026},
  doi = {10.48550/arxiv.2610.16076},
  url = {https://arxiv.org/abs/2610.16076},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：2026 年 NVVSpeech 挑战赛：非语言发声的语音理解和生成的概述和教训},
  abstract = {Nonverbal vocalizations (NVVs), such as laughter and sighs, convey meaning alongside words. NVV-aware speech systems must recognize and generate these events while preserving lexical accuracy and perceptual quality. Yet differences in annotation, resources, and evaluation complicate comparisons, and aggregate scores can obscure specific weaknesses. We review ten system descriptions from the NVVSpeech Challenge 2026, covering understanding and generation in Chinese and English across 16 event categories. Our analysis examines supervision construction, task adaptation, and inference-time or preference-based feedback. Results reveal persistent recognition difficulties with breath and gasp and trade-offs between event recognition and lexical accuracy, as well as between generation intelligibility and acoustic quality, with human listening providing complementary evaluation evidence. These findings identify priorities for advancing NVV-aware speech understanding, controllable generation, and comparable evaluation.},
}

@misc{panorama_117e02335c9b_24d835664ea9e4b4,
  title = {Summary of the ChinaVoices Challenge 2026: Data, Tasks, Baseline, and Methods},
  author = {Yujie Liao and Bingshen Mu and Shuiyuan Wang and Liumeng Xue and Hexin Liu and Xian Shi and Jie Hu and Lei Xie},
  year = {2026},
  doi = {10.48550/arxiv.2609.03471},
  url = {https://arxiv.org/abs/2609.03471},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：2026中国之声挑战赛总结：数据、任务、基线和方法},
  abstract = {This paper summarizes the ChinaVoices Challenge 2026, which aims to establish unified task definitions and evaluation conditions for Chinese dialect speech processing and to advance multi-dialect identification and automatic speech recognition. The challenge covers 16 dialect categories and defines two tasks: Chinese Multi-Dialect Identification and Chinese Multi-Dialect Automatic Speech Recognition (ASR). It uses approximately 320 hours of speech across the Reference Set, Open Evaluation Set, and Hidden Evaluation Set. The two tasks use the same evaluation audio, and each includes restricted-data and open-data tracks. We describe the task settings, data, evaluation metrics, and Qwen3-ASR-1.7B baseline, and analyze the leaderboard results and submitted systems. In total, 28 teams submit results, 17 provide system reports, and systems from 15 teams pass the compliance review and are included in the analysis. Most eligible systems outperform the baseline, and the official top-three order remains unchanged on the Hidden Evaluation Set for both tasks. Dialect-level results show that categories with higher identification accuracy generally have lower ASR error rates, although the tasks assess related but distinct capabilities. Leading identification systems commonly exploit dialect-discriminative acoustic representations, whereas leading ASR systems emphasize data normalization, augmentation, and auxiliary CTC objectives. These results provide practical guidance for developing and},
}

