@misc{panorama_117e02335c9b_1811746dcef6710a,
  title = {An Investigation of Time-Frequency Representation Discriminators for High-Fidelity Vocoders},
  author = {Yicheng Gu and Xueyao Zhang and Liumeng Xue and Haizhou Li and Zhizheng Wu},
  year = {2024},
