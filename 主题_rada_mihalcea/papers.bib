@misc{rada_mihalcea_9e01c0375884fdf3,
  title = {The Use of Rescue Insulin in the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE)},
  author = {Priscilla A. Hollander and Heidi J Krause-Steinrauf and Nicole M. Butera and Erin J. Kazemi and Andrew Ahmann and Basma N. Fattaleh and Mary Lynn Johnson and Tina Killean and Violet S. Lagari and Mary Larkin and Elizabeth A. Legowski and Neda Rasouli and Holly J Willis and Catherine L. Martin and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and Philip Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather},
  year = {2023},
  doi = {10.2337/dc23-0516},
  url = {https://doi.org/10.2337/dc23-0516},
  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：救援胰岛素在糖尿病降血糖方法中的应用：比较有效性研究 (GRADE)},
  abstract = {OBJECTIVE: To describe rescue insulin use and associated factors in the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE). RESEARCH DESIGN AND METHODS: GRADE participants (type 2 diabetes duration <10 years, baseline A1C 6.8%-8.5% on metformin monotherapy, N = 5,047) were randomly assigned to insulin glargine U-100, glimepiride, liraglutide, or sitagliptin and followed quarterly for a mean of 5 years. Rescue insulin (glargine or aspart) was to be started within 6 weeks of A1C >7.5%, confirmed. Reasons for delaying rescue insulin were reported by staff-completed survey. RESULTS: Nearly one-half of GRADE participants (N = 2,387 [47.3%]) met the threshold for rescue insulin. Among participants assigned to glimepiride, liraglutide, or sitagliptin, rescue glargine was added by 69% (39% within 6 weeks). Rescue aspart was added by 44% of glargine-assigned participants (19% within 6 weeks) and by 30% of non-glargine-assigned participants (14% within 6 weeks). Higher A1C values were associated with adding rescue insulin. Intention to change health behaviors (diet/lifestyle, adherence to current treatment) and not wanting to take insulin were among the most common reasons reported for not adding rescue insulin within 6 weeks. CONCLUSIONS: Proportionately, rescue glargine, when required, was more often used than rescue aspart, and higher A1C values were associated with greater rescue insulin use. Wanting to use noninsulin strategies to improve glycemia},
}

