@misc{rada_mihalcea_609d002abcddab75,
  title = {Rationale and Design for a GRADE Substudy of Continuous Glucose Monitoring},
  author = {Mary Larkin and David M. Nathan and Ionut Bebu and Heidi J Krause-Steinrauf and William H. Herman and John M. Higgins and Margaret Tiktin and Robert M. Cohen and Claire Lund and Richard M. Bergenstal and Mary Lynn Johnson and Valerie L. Arends and Jill P. Crandall and Melissa Diane McKee and Janet Brown-Friday and Entila Xhori and Keisha Ballentine-Cargill and Sally Duran and Jennifer Lukin and Stephanie Beringher and S. Gonzalez de la torre and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and Mary K. Rhee and Peter W.F. Wilson and Tasha Stephanie Raines and Julie Costello and Chona Gullett and Maxine Maher-Albertelli and Folayan Morehead and Radhika Mungara and Saranjit Person and Louise Savoye and Mabil Sibymon and Sridhar Tanukonda and Carol Ann White and Leah Holloway and Cynthia Adams and April Ross and Ashok Balasubramanyam and ERICA V. GONZALEZ and Charlyne Wright and Priscilla Hollander and Erin D. Roe and Analyn Uy and Polly Burt and Lorie Estrada and Kris Chionh and Faramarz Ismail‐Beigi and Corinna Falck-Ytter and Laure Sayyed Kassem and Ajay Sood and Bethany Cramer and Jacalyn Iacoboni and Maria V. Kononets and Tanya Kulow and Cynthia Newman and Katherine A. Stancil and Cristina Sanders and Lisa Tucker and Amanda Werner and Adrienne Krol and Gloria McPhee and Christine Patel and Linda Colosimo and Robin Goland and James Pring and Patricia Kringas and Jéssica Tejada and Camille Hausheer and Harvey A. Schneier and Kelly Gumpel and Amanda Kirpitch and Jennifer B. Green and Hiba AbouAssi and Ranee Chatterjee and Mark N. Feinglos and Jennifer English Jones and Shubi A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and Connie R. Thacker and Kathryn Evans Kreider and Kieren J. Mather and Amale A. Lteif and Tonya Hamilton and Nick Patel and Gabriela Riera and Marcia J. Jackson and Vivian Pirics and Devin Howard and Danielle Aguillar and Sloan Hurt and Richard M. Bergenstal and Anders L. Carlson and Thomas Martens and Mary Lynn Johnson},
  year = {2019},
  doi = {10.1089/dia.2019.0202},
  url = {https://doi.org/10.1089/dia.2019.0202},
  howpublished = {Diabetes Technology & Therapeutics},
  annotation = {中文辅助译名：连续血糖监测 GRADE 子研究的基本原理和设计},
  abstract = {Background: The G lycemia R eduction A pproaches in D iabetes: A Comparative E ffectiveness (GRADE) study has enrolled a racially and ethnically diverse population with type 2 diabetes, performed extensive phenotyping, and randomly assigned the participants to one of four second-line diabetes medications. The continuous glucose monitoring (CGM) substudy has been added to determine whether there are racial/ethnic differences in the relationship between average glucose (AG) and hemoglobin A1c (HbA1c). CGM will also be used to compare time in target range, glucose variability, and the frequency and duration of hypoglycemia across study groups. Methods: The observational CGM substudy will enroll up to 1800 of the 5047 GRADE study participants from the four treatment groups, including as many as 450 participants from each of 4 racial/ethnic minority groups to be compared: Hispanic White, non-Hispanic White, non-Hispanic African American, and non-Hispanic Other. CGM will be performed for 2 weeks in proximity to a GRADE annual visit, during which an oral glucose tolerance test will be performed and HbA1c and glycated albumin measured. Indicators of interindividual variation in red blood cell turnover, based on specialized erythrocyte measurements, will also be measured to explore the potential causes of interindividual HbA1c variations. Conclusions: The GRADE CGM substudy will provide new insights into whether differences exist in the relationship between HbA1c and AG among differen},
}

