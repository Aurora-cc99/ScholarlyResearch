@misc{saif_mohammad_033db8a74a52e732,
  title = {A reporting checklist for large language models in behavioural science},
  author = {Stefan Feuerriegel and Christopher Barrie and Molly J. Crockett and Laura K. Globig and Killian Lorcan McLoughlin and Dan-Mircea Mirea and Arthur Spirling and Diyi Yang and Tim Althoff and Maria Antoniak and Lisa P. Argyle and Ashwini Ashokkumar and Mohammad Atari and Hannah E. Bailey and Kevin Bauer and Umang Bhatt and Yidong Chai and Tanmoy Chakraborty and Yanto Chandra and Huimin Chen and Hal Daumé and Gianmarco De Francisci Morales and Morteza Dehghani and Danica Dillion and johannes Christopher Eichstaedt and Kerstin Förster and Dominique Geissler and Kurt J. Gray and Thomas L. Griffiths and Hartmann Jochen and Oliver Hauser and James Kunling He and Rahul Hemrajani and Felix Holzmeister and Angel Hsing‐Chi Hwang and Tiancheng Hu and Anna Aleksandrovna Ivanova and Nils Köbis and Yara Kyrychenko and Himabindu Lakkaraju and Jia Liu and Abdurahman Maarouf and Sebastian Maier and Lennart Meincke and Rada F. Mihalcea and Brent Mittelstadt and Saif M. Mohammad and Mor Naaman and Oded Netzer and Alice Oh and Desmond C. Ong and Francesco Pierri and Barbara Plank and Iyad Rahwan and Talal Rahwan and Pooja S. B. Rao and Claire Elizabeth Robertson and David M. Rothschild and Matthew Salganik and Eric Schulz and Chirag Shah and Yash Raj Shrestha and Ekaterina Shutova and Alexandra Arons Siegel and Almog Simchon and Huan Sun and Malte Toetzke and Jay Joseph Van Bavel and Michelle Anna Vaccaro and J. Vaughan and Effy Vayena and Pedro O. S. Vaz-de-Melo and Briana Vecchione and Anni Wang and Robert West and Robb Willer and Dirk U. Wulff and Renwen Zhang and Simone Zhang and Steve Rathje and Manoel Horta Ribeiro},
