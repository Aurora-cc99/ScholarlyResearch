@misc{rada_mihalcea_72756dc1964233fc,
  title = {CuriousTogether: Implications of Curiosity and Cultural Grounding in Multi-Agent LLM Interactions},
  author = {Angana Borah and Zoha Hayat Bhatti and Zhijing Jin and Rada F. Mihalcea},
  year = {2026},
  doi = {10.48550/arxiv.2611.01301},
  url = {https://arxiv.org/abs/2611.01301},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：CuriousTogether：好奇心和文化基础在多主体大语言模型互动中的影响},
  abstract = {Large Language Models (LLMs) are increasingly deployed in multi-agent settings, exhibiting emergent collective behaviors, yet the role of curiosity as a driver of such dynamics remains understudied. We introduce CuriousTogether, a framework evaluating curiosity-driven multi-agent LLM interactions across three complementary dimensions: novelty-seeking, epistemic and social curiosity. Across eight tasks spanning reasoning, creative generation, and social bias mitigation, curiosity-guided multi-agent settings yield improvements over non-curious ones on seven out of eight tasks, with gains of up to 20.6% in story generation (semantic diversity) and a 14.9 pp reduction in stereotype rates. Furthermore, country-conditioned cultural grounding show benefits for story generation and social tasks, but can hurt precision-oriented reasoning. Finally, we show that inference-time multi-agent curiosity-based approach offers favorable quality-token trade-offs, compared with single-agent baselines. Together, these findings support curiosity-guided interaction as a practical mechanism for improving multi-agent collaboration, with downstream benefits for reasoning, creative, and societal tasks.},
}

@misc{rada_mihalcea_0e2075d7be1dcfae,
  title = {DOTRAG: Retrieval-Time Reasoning Along Paths},
  author = {Farnaz Jahanbakhsh and Larnell Moore and Naihao Deng and Rada Mihalcea},
  year = {2026},
  doi = {10.48550/ARXIV.2605.18760},
  url = {https://doi.org/10.48550/ARXIV.2605.18760},
  howpublished = {CoRR},
  annotation = {中文辅助译名：DOTRAG：沿路径的检索时间推理},
  abstract = {Graph Retrieval-Augmented Generation (GraphRAG) faces significant challenges in complex relational retrieval tasks, particularly in densely connected knowledge graphs where the number of possible paths grows rapidly with reasoning depth. Existing GraphRAG retrieval algorithms either rely on rigid, predefined heuristics to identify relevant graph context or employ costly LLM-based reasoning to guide graph traversal. To address these limitations, we propose DotRAG, a lightweight, training-free GraphRAG retrieval algorithm that uses large language model (LLM) reasoning to narrow the search space and recover task-relevant relational paths. During indexing, DotRAG constructs an entity-relation knowledge graph, generates a graph-wide overview summarizing its contents, and leverages graph reachability indexing to avoid expensive online graph traversals. At query time, the LLM uses this overview to identify promising graph regions and hypothesizes relationship sequences connecting graph information to the query. The LLM then performs targeted relational searches, using graph constraints to restrict the candidate pool progressively. On MetaQA 2-hop queries, DotRAG achieves 97.78% retrieval recall and 51.27% F1, compared to the best baseline scores of 34.74% and 6.33%, respectively. On STaRK-MAG, DotRAG achieves 85.07% recall on 2-hop queries while demonstrating greater computational efficiency than reasoning-based GraphRAG baselines, with 12.2x lower retrieval latency than HopRAG.},
}

