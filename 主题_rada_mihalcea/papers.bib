  annotation = {中文辅助译名：使用多模态信息进行结果预测：集成大型语言模型提取的临床信息和图像分析},
  abstract = {Survival prediction post-cystectomy is essential for the follow-up care of bladder cancer patients. This study aimed to evaluate artificial intelligence (AI)-large language models (LLMs) for extracting clinical information and improving image analysis, with an initial application involving predicting five-year survival rates of patients after radical cystectomy for bladder cancer. Data were retrospectively collected from medical records and CT urograms (CTUs) of bladder cancer patients between 2001 and 2020. Of 781 patients, 163 underwent chemotherapy, had pre- and post-chemotherapy CTUs, underwent radical cystectomy, and had an available post-surgery five-year survival follow-up. Five AI-LLMs (Dolly-v2, Vicuna-13b, Llama-2.0-13b, GPT-3.5, and GPT-4.0) were used to extract clinical descriptors from each patient's medical records. As a reference standard, clinical descriptors were also extracted manually. Radiomics and deep learning descriptors were extracted from CTU images. The developed multi-modal predictive model, CRD, was based on the clinical (C), radiomics (R), and deep learning (D) descriptors. The LLM retrieval accuracy was assessed. The performances of the survival predictive models were evaluated using AUC and Kaplan-Meier analysis. For the 163 patients (mean age 64 ± 9 years; M:F 131:32), the LLMs achieved extraction accuracies of 74%~87% (Dolly), 76%~83% (Vicuna), 82%~93% (Llama), 85%~91% (GPT-3.5), and 94%~97% (GPT-4.0). For a test dataset of 64 patients, the CR},
}

@misc{rada_mihalcea_5181ef55c663a304,
  title = {Does Emotional Distress Predict Worse Glycemic Control Over Time? Results From the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE)},
  author = {Andrea Cherrington and Ionut Bebu and Heidi J Krause-Steinrauf and Claire J. Hoogendoorn and Gladys Crespo-Ramos and Caroline A. Presley and Aanand Dinkar Naik and Ashok Balasubramanyam and Michaela R. Gramzinski and Tina Killean and Valerie L. Arends and Jeffrey S. Gonzalez and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and Philip Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather and Heba M. Ismail and Amale A. Lteif},
