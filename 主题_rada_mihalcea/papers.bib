@misc{soujanya_poria_4b9209b5cc46b6a4,
  title = {The Nitty-GRITties of Success: Computational Analysis of Grit From Language},
  author = {Soujanya Poria and Tushar Maheshwari and Aishwarya N. Reganti and Rada Mihalcea},
  year = {2019},
  doi = {10.1109/ACCESS.2019.2951683},
  url = {https://doi.org/10.1109/ACCESS.2019.2951683},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：成功的本质：语言毅力的计算分析},
  abstract = {Grit is a prominent personality trait that measures an individuals passion and perseverance for long-term goals. Grit entails that zeal and persistence of motive play a key role in determining an individuals success in the long run, as opposed to natural talent. But how does one identify and distinguish between gritty and non-gritty individuals? Do they use language differently? In this paper, we seek to answer these questions using a social media setting. We build a new crowd-sourced Twitter corpus that contains the posts of 464 users along with their grit scores, and explore how grit correlates with other major behavioural and personality traits. We then train machine learning classification models to predict the grit level of an individual using his/her Twitter posts, and show that language can be effectively used to infer this personality trait.},
}

@misc{rada_mihalcea_b020fe6de7643a0c,
  title = {Learning From Personal Longitudinal Dialog Data},
  author = {Charles Welch and Verónica Pérez-Rosas and Erik Cambria and Jonathan K. Kummerfeld and Rada Mihalcea},
  year = {2019},
  doi = {10.1109/MIS.2019.2916965},
  url = {https://doi.org/10.1109/MIS.2019.2916965},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：从个人纵向对话数据中学习},
  abstract = {We explore the use of longitudinal dialog data for two dialog prediction tasks: next message prediction and response time prediction. We show that a neural model using personal data that leverages a combination of message content, style matching, time features, and speaker attributes leads to the best results for both tasks, with error rate reductions of up to 15% compared to a classifier that relies exclusively on message content and to a classifier that does not use personal data.},
}

