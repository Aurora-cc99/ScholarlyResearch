@misc{rada_mihalcea_14d1ad601f8e6644,
  title = {Porting Multilingual Subjectivity Resources across Languages},
  author = {Janyce Wiebe and Rada Mihalcea and Carmen Banea},
  year = {2013},
  doi = {10.1109/T-AFFC.2013.1},
