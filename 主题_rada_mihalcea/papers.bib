@misc{rada_mihalcea_7153b4bad341e8a0,
  title = {Differences in Prevalence and Incidence of Electrocardiogram Abnormalities and Cardiovascular Autonomic Neuropathy Among Randomized Glucose-Lowering Treatments in Early Type 2 Diabetes: The Glycemia Reduction Approaches in Diabetes (GRADE) Cohort},
  author = {Rodica Pop‐Busui and Samuel P. Rosin and Nicole M. Butera and Heidi J Krause-Steinrauf and Hiba Abou Assi and Rajesh Garg and Silvio E. Inzucchi and Aimee M. Katona and Janet B. McGill and Sunder Raj D. Mudaliar and David S. Schade and Elizabeth R. Seaquist and Margaret Tiktin and Elsayed Z. Soliman and Jennifer B. Green and Jill P. Crandall and M. D. McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and Peter W.F. Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C. A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and C. Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and C. Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and A. Sood and M. Tiktin and Tanya Kulow and C. Newman and Kimani A. Stancil and Benvon C. Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and Adam D. Maxwell and G. McPhee and C. Patel and L. Colosimo and A. Krol and Robin Goland and J. Pring and L. Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J. B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and SA Khan and Jeanne B. Kimpel and Ronna P. Zimmer and M. Furst and Barbara M. Satterwhite and Connie R. Thacker and K. Evans Kreider and Cary N. Mariash},
  year = {2025},
  doi = {10.2337/dc25-1087},
  url = {https://doi.org/10.2337/dc25-1087},
  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：早期 2 型糖尿病随机降糖治疗中心电图异常和心血管自主神经病变的患病率和发生率的差异：糖尿病 (GRADE) 队列中的降血糖方法},
  abstract = {OBJECTIVE: To describe the prevalence and incidence of electrocardiogram (ECG) abnormalities and ECG-derived cardiovascular autonomic neuropathy (CAN) in the GRADE cohort of adults with type 2 diabetes (T2D) <10 years. RESEARCH DESIGN AND METHODS: Individuals with T2D taking metformin alone were randomly assigned to add insulin glargine, glimepiride, liraglutide, or sitagliptin. Resting ECGs were completed at the baseline, 2-year, and 4-year study visits and analyzed for minor and major abnormalities and CAN assessed with heart rate variability (HRV) in 4,769 participants. Incidence of new major, minor, and any ECG abnormalities and CAN by treatment group was analyzed using logistic repeated-measures models at years 2 and 4 adjusted for baseline risk factors. RESULTS: At baseline, participants were a mean age of 57.2 ± 10.0 years, 36.3% were women, mean diabetes duration was 4.3 ± 2.8 years, and mean HbA1c was 7.5 ± 0.5%. Participants with ECG abnormalities at baseline (57.1%) and ECG-derived CAN (52.8%) were older and had more severe cardiovascular risk factors. The incidence of minor and major ECG abnormalities was similar among all treatment groups. However, at year 4, major ECG abnormalities were fewer in the liraglutide versus nonliraglutide groups (9% vs. 13%; P = 0.03). The incidence of CAN did not differ between the liraglutide and nonliraglutide groups across visits (P = 0.42); however, one measure of HRV (SD of normal-to-normal R-R intervals) was higher at year 2 in},
}

