@misc{rada_mihalcea_88a73d70c9f89436,
  title = {Voted Co-Training for Bootstrapping Sense Classifiers},
  author = {Rada Mihalcea},
  year = {2004},
  url = {https://dblp.uni-trier.de/db/conf/ecai/ecai2004.html#Mihalcea04},
  howpublished = {ECAI},
  annotation = {中文辅助译名：投票联合训练引导感知分类器},
  abstract = {This paper introduces voted co-training, a bootstrapping method that combines co-training with majority voting, with the effect of smoothing the learning curves, and improving the average performance. Voted co-training was evaluated on a word sense classification problem, with significant improvements observed over basic co-training algorithms. Various empirical parameter selection methods for co-training are investigated, with various degrees of error reduction.},
}

@misc{rada_mihalcea_28b0c4e619defa5f,
  title = {An algorithm for open text semantic parsing},
  author = {Lei Shi and Rada F. Mihalcea},
  year = {2004},
  doi = {10.3115/1621445.1621453},
  url = {https://doi.org/10.3115/1621445.1621453},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：一种开放文本语义解析算法},
  abstract = {This paper describes an algorithm for open text shallow semantic parsing. The algorithm relies on a frame dataset (FrameNet) and a semantic network (WordNet), to identify semantic relations between words in open text, as well as shallow semantic features associated with concepts in the text. Parsing semantic structures allows semantic units and constituents to be accessed and processed in a more meaningful way than syntactic parsing, moving the automation of understanding natural language text to a higher level.},
}

@misc{rada_mihalcea_1bed2ba3e2f15e15,
  title = {PageRank on Semantic Networks, with Application to Word Sense Disambiguation},
  author = {Elizabeth Figa and Rada Mihalcea and Paul Tarau},
  year = {2004},
  doi = {10.3115/1220355.1220517},
  url = {https://doi.org/10.3115/1220355.1220517},
  howpublished = {COLING},
  annotation = {中文辅助译名：语义网络上的 PageRank 及其在词义消歧中的应用},
  abstract = {This paper presents a new open text word sense disambiguation method that combines the use of logical inferences with PageRank-style algorithms applied on graphs extracted from natural language documents. We evaluate the accuracy of the proposed algorithm on several sense-annotated texts, and show that it consistently outperforms the accuracy of other previously proposed knowledge-based word sense disambiguation methods. We also explore and evaluate methods that combine several open-text word sense disambiguation algorithms.},
}

@misc{rada_mihalcea_8be378f47f038215,
  title = {Finding Semantic Associations on Express Lane},
  author = {Vivi Nastase and Rada Mihalcea},
  year = {2004},
  doi = {10.63317/52wv2es2kv7z},
