@misc{rada_mihalcea_85eb92f08944a464,
  title = {R3: “This is My SQL, Are You With Me?” A Consensus-Based Multi-Agent System for Text-to-SQL Tasks},
  author = {Hanchen Xia and Feng Jiang and Naihao Deng and Cunxiang Wang and Guojiang Zhao and Rada F. Mihalcea and Yue Zhang},
  year = {2025},
  doi = {10.18653/v1/2025.trl-1.4},
  url = {https://doi.org/10.18653/v1/2025.trl-1.4},
  howpublished = {Table Representation Learning Workshop (TRL)},
  annotation = {中文辅助译名：R3：“这是我的 SQL，你和我在一起吗？”用于文本到 SQL 任务的基于共识的多智能体系统},
  abstract = {Large Language Models (LLMs) have demonstrated exceptional performance across diverse tasks.To harness their capabilities for Textto-SQL, we introduce R 3 (Review-Rebuttal-Revision), a consensus-based multi-agent system for Text-to-SQL tasks.R 3 achieves the new state-of-the-art performance of 89.9 on the Spider test set.In the meantime, R 3 achieves 61.80 on the Bird development set.R 3 outperforms existing single-LLM and multi-agent Text-to-SQL systems by 1.3% to 8.1% on Spider and Bird, respectively.Surprisingly, we find that for Llama-3-8B, R 3 outperforms chain-ofthought prompting by over 20%, even outperforming GPT-3.5 on the Spider development set.We open-source our codebase at https: //github.com/1ring2rta/R3.},
}

@misc{rada_mihalcea_ad66b7459c529d67,
  title = {SocialHarmBench: Revealing LLM Vulnerabilities to Socially Harmful Requests},
  author = {Hai Son Le and Zhijing Jin and Punya Syon Pandey and Devansh Bhardwaj and Rada Mihalcea},
  year = {2025},
  doi = {10.48550/ARXIV.2510.04891},
  url = {https://doi.org/10.48550/ARXIV.2510.04891},
  howpublished = {CoRR},
  annotation = {中文辅助译名：SocialHarmBench：揭示大语言模型对社会有害请求的漏洞},
  abstract = {Large language models (LLMs) are increasingly deployed in contexts where their failures can have direct sociopolitical consequences. Yet, existing safety benchmarks rarely test vulnerabilities in domains such as political manipulation, propaganda and disinformation generation, or surveillance and information control. We introduce SocialHarmBench, a dataset of 585 prompts spanning 7 sociopolitical categories and 34 countries, designed to surface where LLMs most acutely fail in politically charged contexts. Our evaluations reveal several shortcomings: open-weight models exhibit high vulnerability to harmful compliance, with Mistral-7B reaching attack success rates as high as 97% to 98% in domains such as historical revisionism, propaganda, and political manipulation. Moreover, temporal and geographic analyses show that LLMs are most fragile when confronted with 21st-century or pre-20th-century contexts, and when responding to prompts tied to regions such as Latin America, the USA, and the UK. These findings demonstrate that current safeguards fail to generalize to high-stakes sociopolitical settings, exposing systematic biases and raising concerns about the reliability of LLMs in preserving human rights and democratic values. We share the SocialHarmBench benchmark at https://huggingface.co/datasets/psyonp/SocialHarmBench.},
}

@misc{rada_mihalcea_725244c85e4019a0,
  title = {Comparative Effects of Randomized Second-line Therapy for Type 2 Diabetes on a Composite Outcome Incorporating Glycemic Control, Body Weight, and Hypoglycemia: An Analysis of the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE)},
  author = {Marian Sue Kirkman and Mark Tripputi and Heidi J Krause-Steinrauf and Ionut Bebu and Hiba AbouAssi and Henry B. Burch and Elizabeth Duran-Valdez and Hermes J. Florez and William Timothy Garvey and Daniel S. Hsia and Maamoun Salam and Rodica Pop‐Busui and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and P. Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather and Heba M. Ismail and Amale A. Lteif},
  year = {2024},
  doi = {10.2337/dc23-1332},
  url = {https://doi.org/10.2337/dc23-1332},
  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：2 型糖尿病随机二线治疗对血糖控制、体重和低血糖综合结果的比较效果：糖尿病降血糖方法的分析：比较有效性研究 (GRADE)},
  abstract = {OBJECTIVE: In Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE) (5,047 participants, mean follow-up 5.0 years), differences in glycemic control were demonstrated over time among four randomized therapies added to metformin. Weight gain and hypoglycemia are also important outcomes for people with type 2 diabetes. We compared the effects of the four randomized GRADE medications on a composite outcome incorporating glycemic deterioration, weight gain, and hypoglycemia. RESEARCH DESIGN AND METHODS: The composite outcome was time to first occurrence of any of the following: HbA1c >7.5%, confirmed; ≥5% weight gain; or severe or recurrent nonsevere hypoglycemia. Secondary analyses included examination of individual components of the composite outcome, subgroup effects and potential mediators, and treatment satisfaction. Cumulative incidence was estimated with the Kaplan-Meier estimator. Cox proportional hazards models were used to assess pairwise group differences in risk of an outcome. RESULTS: Risk of reaching the composite outcome (events per 100 participants per treatment year [PTYs]) was lowest with liraglutide (19 per 100 PTYs) followed by sitagliptin (26 per 100 PTYs), glargine (29 per 100 PTYs), and glimepiride (40 per 100 PTYs); all pairwise comparisons were statistically significant. The order was the same for risk of weight gain and hypoglycemia, but risk of glycemic deterioration was lowest with glargine, followed by liraglutide, glimep},
}

