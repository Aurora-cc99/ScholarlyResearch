  annotation = {中文辅助译名：SenseLearner：对开放文本中所有单词进行最少监督的词义消歧},
  abstract = {This paper introduces SENSELEARNER – a minimally supervised sense tagger that attempts to disambiguate all content words in a text using the senses from WordNet. SENSELEARNER participated in the SENSEVAL-3 English all words task, and achieved an average accuracy of 64.6%. 1},
}

@misc{rada_mihalcea_5db6d5faf4ef7c8e,
  title = {The Senseval-3 Multilingual English-­Hindi lexical sample task},
  author = {Ted Pedersen and Amruta Purandare and Timothy Chklovski and Rada Mihalcea},
  year = {2004},
  url = {https://digital.library.unt.edu/ark:/67531/metadc30964/},
  howpublished = {SENSEVAL@ACL},
  annotation = {中文辅助译名：Senseval-3 多语言英语-印地语词汇示例任务},
  abstract = {This paper describes the English--Hindi Multilingual lexical sample task in SENSEVAL--3. Rather than tagging an English word with a sense from an English dictionary, this task seeks to assign the most appropriate Hindi translation to an ambiguous target word. Training data was solicited via the Open Mind Word Expert (OMWE) from Web users who are fluent in English and Hindi.},
