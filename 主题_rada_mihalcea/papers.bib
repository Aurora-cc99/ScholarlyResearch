  abstract = {We introduce a new codification scheme for efficient computation of measures in semantic networks.The scheme is particularly useful for fast computation of semantic associations between words and implementation of an informational retrieval operator for efficient search in semantic spaces.Other applications may also be possible.},
}

@misc{rada_mihalcea_597826461190841b,
  title = {RSDNET: A WEB-BASED COLLABORATIVE FRAMEWORK FOR BUILDING MULTILINGUAL SEMANTIC NETWORKS},
  author = {Nathaniel Ayewah and Rada F. Mihalcea and Vivi Năstase and And Doina Tătar},
  year = {2004},
  url = {https://www.cs.umd.edu/~ayewah/web/pubs/RSDNet-Journal2004.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：RSDNET：用于构建多语言语义网络的基于 Web 的协作框架},
  abstract = {We present a system (RSDnet) that allows non-expert Web users to contribute towards building a multilingual lexical resource. Our study focuses on the Romanian-English language pair, and the target resource is a Romanian WordNet strongly connected to the English WordNet. We use a bilingual dictionary, a monolingual definition dictionary and documents on the Web to build synsets, attach them a gloss, and provide some examples. The results of our semi-automatic acquisition system are judged by two human judges, and they are compared to automatic approaches to building a Romanian WordNet.},
}

@misc{rada_mihalcea_971cde90eb636ff2,
  title = {SenseLearner: Minimally supervised Word Sense Disambiguation for all words in open text},
  author = {Ehsanul Faruque and Rada Mihalcea},
  year = {2004},
  url = {https://digital.library.unt.edu/ark:/67531/metadc30961/},
