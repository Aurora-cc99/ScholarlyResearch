@misc{rada_mihalcea_1b9def59a8f8a3f8,
  title = {The Structure and Performance of an Open-Domain Question Answering System},
  author = {Sanda M. Harabagiu and Vasile Rus and Marius Pasca and Roxana Girju and Rada Mihalcea and Richard Goodrum and Dan I. Moldovan},
