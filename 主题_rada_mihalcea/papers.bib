  year = {2024},
  doi = {10.63317/2bw7xfcwyeq3},
  url = {https://doi.org/10.63317/2bw7xfcwyeq3},
  howpublished = {LREC/COLING},
  annotation = {中文辅助译名：一切都解决了吗？大型语言模型无法解决的开放 NLP 研究问题},
  abstract = {Recent progress in large language models (LLMs) has enabled the deployment of many generative NLP applications.At the same time, it has also led to a misleading public discourse that "it's all been solved."Not surprisingly, this has, in turn, made many NLP researchers -especially those at the beginning of their careers -worry about what NLP research area they should focus on.Has it all been solved, or what remaining questions can we work on regardless of LLMs?To address this question, this paper compiles NLP research directions rich for exploration.We identify fourteen different research areas encompassing 45 research directions that require new research and are not directly solvable by LLMs.While we identify many research areas, many others exist; we do not cover areas currently addressed by LLMs, but where LLMs lag behind in performance or those focused on LLM development.We welcome suggestions for other research directions to include: https://bit.},
}

@misc{rada_mihalcea_cbd8afacc383e3f2,
  title = {Impact of Insulin Sensitivity and β-Cell Function Over Time on Glycemic Outcomes in the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE): Differential Treatment Effects of Dual Therapy},
  author = {Kristina M. Utzschneider and Naji Younes and Nicole M. Butera and Ashok Balasubramanyam and Richard M. Bergenstal and Joshua I. Barzilay and Cyrus V Desouza and Ralph Anthony DeFronzo and Tom A. Elasy and Jonathan A. Krakoff and Steven E. Kahn and Neda Rasouli and Willy Marcos Valencia and William I. Sivitz and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and P. Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather},
  year = {2024},
  doi = {10.2337/dc23-1059},
  url = {https://doi.org/10.2337/dc23-1059},
  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：胰岛素敏感性和 β 细胞功能随时间变化对糖尿病降血糖方法中血糖结果的影响：比较有效性研究 (GRADE)：双重疗法的差异治疗效果},
  abstract = {OBJECTIVE: To compare the effects of insulin sensitivity and β-cell function over time on HbA1c and durability of glycemic control in response to dual therapy. RESEARCH DESIGN AND METHODS: GRADE participants were randomized to glimepiride (n = 1,254), liraglutide (n = 1,262), or sitagliptin (n = 1,268) added to baseline metformin and followed for mean ± SD 5.0 ± 1.3 years, with HbA1c assessed quarterly and oral glucose tolerance tests at baseline, 1, 3, and 5 years. We related time-varying insulin sensitivity (HOMA 2 of insulin sensitivity [HOMA2-%S]) and early (0-30 min) and total (0-120 min) C-peptide (CP) responses to changes in HbA1c and glycemic failure (primary outcome HbA1c ≥7% [53 mmol/mol] and secondary outcome HbA1c >7.5% [58 mmol/mol]) and examined differential treatment responses. RESULTS: Higher HOMA2-%S was associated with greater initial HbA1c lowering (3 months) but not subsequent HbA1c rise. Greater CP responses were associated with a greater initial treatment response and slower subsequent HbA1c rise. Higher HOMA2-%S and CP responses were each associated with lower risk of primary and secondary outcomes. These associations differed by treatment. In the sitagliptin group, HOMA2-%S and CP responses had greater impact on initial HbA1c reduction (test of heterogeneity, P = 0.009 HOMA2-%S, P = 0.018 early CP, P = 0.001 total CP) and risk of primary outcome (P = 0.005 HOMA2-%S, P = 0.11 early CP, P = 0.025 total CP) but lesser impact on HbA1c rise (P = 0.175 HOMA2},
}

