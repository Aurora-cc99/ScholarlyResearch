  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：糖尿病降血糖方法中 2 型糖尿病治疗方案对糖尿病困扰和抑郁症状的不同影响：比较有效性研究 (GRADE)},
  abstract = {OBJECTIVE: We evaluated whether adding basal insulin to metformin in adults with early type 2 diabetes mellitus (T2DM) would increase emotional distress relative to other treatments. RESEARCH DESIGN AND METHODS: The Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE) of adults with T2DM of <10 years' duration, HbA1c 6.8-8.5%, and taking metformin monotherapy randomly assigned participants to add insulin glargine U-100, sulfonylurea glimepiride, the glucagon-like peptide-1 receptor agonist liraglutide, or the dipeptidyl peptidase 4 inhibitor sitagliptin. The Emotional Distress Substudy enrolled 1,739 GRADE participants (mean [SD] age 58.0 [10.2] years, 32% female, 56% non-Hispanic White, 18% non-Hispanic Black, 17% Hispanic) and assessed diabetes distress and depressive symptoms every 6 months. Analyses examined differences at 1 year and over the 3-year follow-up. RESULTS: Across treatments, diabetes distress (-0.24, P < 0.0001) and depressive symptoms (-0.67, P < 0.0001) decreased over 1 year. Diabetes distress was lower at 1 year for the glargine group than for the other groups combined (-0.10, P = 0.002). Diabetes distress was also lower for liraglutide than for glimepiride or sitagliptin (-0.10, P = 0.008). Over the 3-year follow-up, there were no significant group differences in total diabetes distress; interpersonal diabetes distress remained lower for those assigned to liraglutide. No significant differences were observed for depressive },
}

@misc{rada_mihalcea_93ec4f5c38b917cf,
  title = {Impact of Glucose-Lowering Medications on Health-Related Quality of Life in the Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE)},
  author = {Andrea Cherrington and Mark Tripputi and Naji Younes and William H. Herman and Aimee M. Katona and Erik J. Groessl and Jacqueline Craig and Jeffrey S. Gonzalez and Rajesh Garg and Sabina Casula and Shihchen Kuo and Hermes J. Florez and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and Philip Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather and Heba M. Ismail and Amale A. Lteif},
