  abstract = {This paper introduces a new email dataset, consisting of both single and thread emails, manually annotated with summaries and keywords.A total of 349 emails and threads have been annotated.The dataset is our first step toward developing automatic methods for summarization and keyword extraction from emails.We describe the email corpus, along with the annotation interface, annotator guidelines, and agreement studies.},
}

@misc{rada_mihalcea_5653680bd3ffa0d9,
  title = {Cross-cultural Deception Detection},
  author = {Verónica Pérez-Rosas and Rada Mihalcea},
  year = {2014},
  doi = {10.3115/V1/P14-2072},
