@misc{rada_mihalcea_741f1f196e468976,
  title = {Association of Baseline Factors With Glycemic Outcomes in GRADE: A Comparative Effectiveness Randomized Clinical Trial},
  author = {William Timothy Garvey and Robert M. Cohen and Nicole M. Butera and Erin J. Kazemi and Naji Younes and Samuel P. Rosin and Colleen E. Suratt and Andrew Ahmann and Priscilla A. Hollander and Jonathan A. Krakoff and Catherine L. Martin and Elizabeth R. Seaquist and Michael W. Steffes and John M. Lachin and Jill P. Crandall and Melissa Diane McKee and Stephanie Behringer-Massera and J. Brown-Friday and Entila Xhori and K. Ballentine-Cargill and S. Duran and H. Estrella and S. Gonzalez de la torre and J. Lukin and Lawrence S. Phillips and Elizabeth Burgess and Darin E. Olson and M. Rhee and Philip Wilson and Tasha Stephanie Raines and J. Boers and J. Costello and Maxine Maher-Albertelli and Radhika Mungara and L. Savoye and C.A. White and Chona Gullett and Leah Holloway and F. Morehead and S. Person and Mabil Sibymon and Sridhar Tanukonda and Cynthia Adams and A. Ross and A. Balasubramanyam and Ruchi Gaba and E. Gonzalez Hattery and Adrienne Ideozu and J. Jimenez and G. Montes and Charlyne Wright and Priscilla A. Hollander and E. Roe and A. Jackson and Ashley Smiley and Polly Burt and Lorie Estrada and Kris Chionh and F. Ismail-Beigi and C. Falck-Ytter and L. Sayyed Kassem and Anil K. Sood and M. Tiktin and Tanya Kulow and C. Newman and Katherine A. Stancil and Bethany Cramer and J. Iacoboni and Maria V. Kononets and C. Sanders and Lisa Tucker and A. Werner and A. Maxwell and G. McPhee and C. Patel and L. Colosimo and Adrienne Krol and Robin Goland and J. Pring and Lucia Alfano and Patricia Kringas and Camille Hausheer and J. Tejada and Kelly Gumpel and A. Kirpitch and H. Schneier and J.B. Green and H. AbouAssi and Ranee Chatterjee and Mark N. Feinglos and J. English Jones and S.A. Khan and Jeanne B. Kimpel and Ronna P. Zimmer and Mary Furst and Barbara M. Satterwhite and C.R. Thacker and K. Evans Kreider and Cary N. Mariash and Kieren J. Mather},
  year = {2024},
  doi = {10.2337/dc23-1782},
  url = {https://doi.org/10.2337/dc23-1782},
  howpublished = {Diabetes Care},
  annotation = {中文辅助译名：GRADE 中基线因素与血糖结果的关联：比较有效性随机临床试验},
  abstract = {OBJECTIVE: To describe the individual and joint associations of baseline factors with glycemia, and also with differential effectiveness of medications added to metformin. RESEARCH DESIGN AND METHODS: Glycemia Reduction Approaches in Diabetes: A Comparative Effectiveness Study (GRADE) participants (with type 2 diabetes diagnosed for <10 years, on metformin, and with HbA1c 6.8-8.5%; N = 5,047) were randomly assigned to a basal insulin (glargine), sulfonylurea (glimepiride), glucagon-like peptide 1 agonist (liraglutide), or dipeptidyl peptidase 4 inhibitor (sitagliptin). The glycemic outcome was HbA1c ≥7.0%, subsequently confirmed. Univariate and multivariate regression and classification and regression tree (CART) analyses were used to assess the association of baseline factors with the glycemic outcome at years 1 and 4. RESULTS: In univariate analyses at baseline, younger age (<58 years), Hispanic ethnicity, higher HbA1c, fasting glucose, and triglyceride levels, lower insulin secretion, and relatively greater insulin resistance were associated with the glycemic outcome at years 1 and/or 4. No factors were associated with differential effectiveness of the medications by year 4. In multivariate analyses, treatment group, younger age, and higher baseline HbA1c and fasting glucose were jointly associated with the glycemic outcome by year 4. The superiority of glargine and liraglutide at year 4 persisted after multiple baseline factors were controlled for. CART analyses indicated},
}

