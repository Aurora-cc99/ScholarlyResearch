@misc{rada_mihalcea_32ff3f9230da1086,
  title = {Tables as Texts or Images: Evaluating the Table Reasoning Ability of LLMs and MLLMs},
  author = {Yulong Chen and Zhenjie Sun and Lin Ma and Ruiqi He and Aman Sikka and Yue Zhang and Naihao Deng and Rada Mihalcea},
  year = {2014},
  doi = {10.18653/V1/2024.FINDINGS-ACL.23},
  url = {https://doi.org/10.18653/V1/2024.FINDINGS-ACL.23},
  howpublished = {ACL (Findings)},
  annotation = {中文辅助译名：作为文本或图像的表格：评估 LLM 和 MLLM 的表格推理能力},
  abstract = {In this paper, we investigate the effectiveness of various LLMs in interpreting tabular data through different prompting strategies and data formats.Our analyses extend across six benchmarks for table-related tasks such as questionanswering and fact-checking.We introduce for the first time the assessment of LLMs' performance on image-based table representations.Specifically, we compare five text-based and three image-based table representations, demonstrating the role of representation and prompting on LLM performance.Our study provides insights into the effective use of LLMs on table-related tasks.},
}

