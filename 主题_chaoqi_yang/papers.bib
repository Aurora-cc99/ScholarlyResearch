  annotation = {中文辅助译名：基于时间序列数据特征结合长短期记忆模型的用电量预测},
}

@misc{chaoqi_yang_02b516957539aabd,
  title = {A Graph-Convolutional Ranking Approach to Leverage the Relational Aspects of User-Generated Content},
