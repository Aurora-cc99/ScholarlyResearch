  title = {Influence Pathway Discovery on Social Media},
  author = {Xinyi Liu and Ruijie Wang and Dachun Sun and Jinning Li and Christina Youn and You Lyu and Jianyuan Zhan and Dayou Wu and Xinhe Xu and Mingjun Liu and Xinshuo Lei and Zhihao Xu and Yutong Zhang and Zehao Li and Qikai Yang and Tarek Abdelzaher},
