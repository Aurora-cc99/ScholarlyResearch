  title = {A Ring-Type Digital Spiking Neural Network and Spike-Train Approximation},
  author = {Hiroaki Uchida and Toshimichi Saito and Kouji Kimura and Y. Yamane and Hiroshi Tamura and Kô Sakai and Yating Huang and Jiaming Xu and Bo Xu and Zhongting Jiang and Dong Wang and Huijie Shang and Yuehui Chen and Gouhei Tanaka and Ryosho Nakane and Akira Hirose and Shaojie Qu and Kan Li and Bo Lin Wu and Kai Tang and Weimin Liu and Liqing Zhao and Bo Cheng and Junliang Chen and Zeping Yu and Linqing Shi and Gongshen Liu and Jakub Nowak and Marcin Korytkowski and Marcin Woźniak and Rafał Scherer and Mauajama Firdaus and Ankit Kumar and Asif Ekbal and Pushpak Bhattacharyya and Katalin Tünde Jánosi-Rancz and Zoltán Kátai and Dávid Iclănzan and Jinxin Chang and Ruifang He and Longbiao Wang and Ruifang Wang and Xiangyu Zhao and Ting Yang and Anil Kumar Donthagani and V Susheela Devi and Yongyu Jiang and Peng Zhang and Hui Gao and Xindian Ma and Donghao Zhao and Zeting Hu and Junyan Wang and Mei-xian Song and Kai Chen and Baotian Hu and Qingcai Chen and Yu Hong and Danyang Liu and Naveen Saini and Rahul Grover and Sriparna Saha and Lingtong Kong and Jie Yang and Nicoleta Rogovschi and Sarah Zouinina and Basarab Mateï and Issam Falih and Nistor Grozavu and SeiichiOzawa and Timothy R. McIntosh and Julian Jang‐Jaccard and Paul Watters and Teo Sušnjak and Yong Yuan and Chen Chen and Xiyuan Hu and Silong Peng and Mansoor Ali Halari and Jo Plested and Ibtissam Brahmi and Guénaël Cabanes and Younès Bennani and Abdelfettah Touzani and Kasumi Nishi and Osamu Araki and Tomokazu Urakawa and Tianyuan Niu and Yuexian Hou and Junwei Zhang and Pengqing Zhang and Seiji Takeda and Toshiyuki Yamane and Hidetoshi Numata and Naoki Kanazawa and JeanBenoit Heroux and Daiju Nakano and Anwesha Law and Balasubramanyam Evani and Ashish Kumar Ghosh},
  year = {2019},
