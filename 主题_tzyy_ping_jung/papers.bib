@misc{tzyy_ping_jung_894aacbe811f6a90,
  title = {Task performance and eye activity: predicting behavior relating to cognitive workload},
  author = {Yi-Fang D. Tsai and Erik Viirre and Christopher Strychacz and Bradley Chase and Tzyy‐Ping Jung},
