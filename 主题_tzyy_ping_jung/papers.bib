  author = {Yu‐Yi Chien and Fang‐Cheng Lin and Ching‐Chi Chou and John Kar-Kin Zao and Heng‐Yuan Kuo and Yi‐Pai Huang and Yijun Wang and Tzyy‐Ping Jung and Han‐Ping D. Shieh},
