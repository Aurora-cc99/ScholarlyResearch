  title = {Brain order disorder 2ndgroup report of f-EEG},
  author = {François M. Lalonde and Nitin Gogtay and Jay N. Giedd and N. Vydelingum and David Brown and Binh Q. Tran and Charles Chia-chuen Hsu and Ming-Kai Hsu and Jae Cha and Jeffrey Jenkins and Lien Ma and Jefferson M. Willey and Jerry C. Wu and Kenneth Oh and Joseph Landa and C. T. Lin and Tzyy‐Ping Jung and Scott Makeig and Francesco Carlo Morabito and Qyu Moon and Takeshi Yamakawa and Soo-Young Lee and Jong‐Hwan Lee and Harold H Szu and Balvinder Kaur and Kenneth A. Byrd and Karen Dang and Alan T. Krzywicki and Babajide O. Familoni and Louis Larson and Susan Harkrider and Keith A. Krapels and Liyi Dai},
