  year = {2026},
  doi = {10.1145/3833873},
  url = {https://doi.org/10.1145/3833873},
  howpublished = {ACM Computing Surveys},
  annotation = {中文辅助译名：脑机接口软件生态：开源工具、跨领域应用和未来挑战},
  abstract = {Open-source software platforms have revolutionized brain-computer interface (BCI) development. This comprehensive review examines the ecosystem for non-invasive EEG-based BCIs through four dimensions: technological foundations, tool taxonomy, scenario adaptation, and future evolution. The study demonstrates how open-source software enables complete BCI workflows from signal acquisition to real-time interaction. A systematic framework categorizes tools for applications in healthcare, education, and entertainment. Technical challenges and breakthrough opportunities in the ecosystem are identified. The study offers developers methodologies to select open-source BCI tools. Collectively, these insights aim at accelerating the transition of BCI technologies from research settings to real-world deployment.},
}

@misc{minpeng_xu_0b48160b6cce,
