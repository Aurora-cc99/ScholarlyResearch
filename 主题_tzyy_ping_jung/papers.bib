  howpublished = {IEEE Transactions on Computational Social Systems},
  annotation = {中文辅助译名：社会决策过程中额叶阿尔法不对称神经反馈后的大脑网络可塑性},
  abstract = {Self-regulating social decision-making holds promise for promoting equitable outcomes in human interactions. Neurofeedback training (NFT) targeting frontal alpha asymmetry (FAA) has been shown to successfully modulate fairness-related decisions as a self-regulation tool. Yet, the neuroplastic mechanisms that enable individuals to voluntarily modulate brain activity and thereby influence fairness-related decisions remain poorly understood. To address this, we investigated whether FAA NFT alters intrinsic resting- and task-state functional brain networks and whether such alterations relate to subsequent social decision-making. Using phase lag index (PLI) connectivity analysis, we found that successful FAA downregulation weakened right-hemispheric resting connectivity, particularly in frontal–temporal and frontal–centroparietal circuits, consistent with a withdrawal-related affective state. During fairness evaluation (proposal phase), up- and down-regulation learners exhibited opposite patterns of anterior–posterior reorganization: whereas up-regulation weakened frontal–parietal coupling, and down-regulation strengthened it. Such network alterations during the proposal phase could serve as physiological markers of individual FAA learning success. Feedback phase showed less differentiated NFT effects. These findings demonstrate that FAA NFT induces state-dependent network plasticity that extends from intrinsic baseline circuits to active social decision networks. By mapping the n},
}

