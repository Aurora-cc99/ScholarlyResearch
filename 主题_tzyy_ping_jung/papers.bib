@misc{minpeng_xu_976950be6b7f,
  title = {A High-DOF BCI Control Strategy Mapping Discrete Commands to Continuous Motion for a Drone},
  author = {Jie Mei and Weize Chen and Ang Li and Yongzhi Huang and Xiaolin Xiao and Kun Wang and Weibo Yi and Tzyy-Ping Jung and Minpeng Xu and Dong Ming},
