  url = {https://doi.org/10.1109/embc58623.2025.11251651},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：听节拍器声音和音乐时的脑体耦合},
  abstract = {Wearables continue to expand their ability to sample more signals from the brain and body while reducing form factors and limiting on-device computing to meet real-world comfort and power constraints. Where evolving multimodal sensing platforms can combine electrophysiological (ExG), optical, chemical, and mechanical sensors for holistic brain-body state estimation, understanding of cross-modal coupling mechanisms remains limited. Here, we collect and analyze bio-signals in a brain-body coupling experiment using simultaneous electroencephalogram (EEG), electrocardiogram (ECG), and respiratory measurements. Our experimental paradigm contrasted listening to self-selected music, preceded by tempo-matched isochronous cues. The results show a clear entrainment of cardiac rhythms with the underlying beat of auditory stimuli for both metronome cues and subject-selected music. Magnitude-Squared coherence analysis showed frequency coupling across recorded modalities, with ECG, EEG, and breath, exhibiting peak coherence near heard or underlying musical beat or its harmonics. We present minimally pre-processed data to motivate future methodological explorations of multiscale brain-body entrainment to rhythmic stimuli.Clinical relevance-These findings have implications for designing music therapy and biofeedback interventions that could adapt to ongoing brain-body rhythms. Understanding brain-body entrainment mechanisms and validating simplified measurement approaches could enable more a},
}

@misc{tzyy_ping_jung_e99a45382876583d,
  title = {Extracting Interpretable Features from EEG Signals through Attention and Sparse Autoencoders},
  author = {ChiaEn Lu and Yuhong Zhang and Ying Choon Wu and Tzyy‐Ping Jung},
  year = {2025},
  doi = {10.1109/ner61569.2025.11588984},
  url = {https://doi.org/10.1109/ner61569.2025.11588984},
  howpublished = {International IEEE/EMBS Conference on Neural Engineering},
  annotation = {中文辅助译名：通过注意力和稀疏自动编码器从脑电图信号中提取可解释的特征},
  abstract = {The lack of interpretability in deep learning models for electroencephalogram (EEG) analysis remains a significant obstacle to their application in trustworthy neuroscience, where understanding model decision-making processes is crucial for validating theoretical frameworks and generating scientific insights. We introduce a three-stage pipeline that integrates spatialtemporal graph attention networks with sparse autoencoders to produce interpretable features for EEG-based emotion recognition. The method generates two forms of interpretable output: dynamic spatial attention matrices that reveal the relative contributions of electrodes to brain regions implicated in emotion processing and sparse feature representations that enable direct analysis of emotion-related cortical activities. The learned features align with existing neuroscience findings on emotion-related brain activity, demonstrating how deep model representations can be grounded in established theoretical understandings of neural emotion processing.},
}

