  howpublished = {IEEE Transactions on Biomedical Engineering},
  annotation = {中文辅助译名：脑机接口中小样本和不平衡ERP解码的联合收缩模式匹配},
  abstract = {Event-related potential (ERP)-based brain-computer interface (BCI) systems are approaching sub-microvolt-level resolution, enabling detailed decoding of sophisticated cognitive processes. This progress has increased the demand for robust classifiers. Current algorithms encounter two fundamental challenges when decoding ERPs: data scarcity and class imbalance. To address these challenges, we propose a joint-shrinkage pattern matching (JSPM) algorithm consisting of two modules. First, a novel joint-shrinkage spatial filter is constructed by integrating shrinkage-based regularization with the $\mathcall_2,\bmp$-norm. This regularization approach effectively bridges the gap between complex structured regularization and implementation simplicity, which introduces automated regularization to enhance module robustness under data-scarce conditions. The $\mathcall_2,\bmp$-norm provides a flexible feature distance measurement, enabling adaptation to data quality variability. Second, a weighted template matching module mitigates decision boundary shift caused by class imbalance. Using error-related potentials (ErrPs) as representative signals, we validated the algorithm through comprehensive comparisons. JSPM significantly outperformed 14 state-of-the-art classifiers on one self-collected and two public ErrP datasets. With only 40 imbalanced training samples, it achieved up to 14.84% higher average balanced accuracy (bAcc) than competing methods, maintaining a 4.88% },
}

@misc{tzyy_ping_jung_ab9d1332ffa46585,
  title = {Metacognition Prediction in Human-AI Collaboration},
  author = {Xuan-The Tran and Thomas Do and Nikhil Ranjan Pal and Tzyy‐Ping Jung and Chin-Teng Lin},
  year = {2026},
  doi = {10.1109/tai.2026.3750820},
  url = {https://doi.org/10.1109/tai.2026.3750820},
  howpublished = {IEEE Transactions on Artificial Intelligence},
  annotation = {中文辅助译名：人机协作中的元认知预测},
  abstract = {Accurate prediction of human confidence in AI-assisted tasks is critical for enhancing human-AI collaboration. This study investigates metacognitive confidence prediction during a challenging, time-constrained camouflaged object detection task, where participants received both accurate and misleading suggestions from two AI agents. Leveraging behavioural data, such as decision accuracy and response time, together with EEG signals recorded during decision-making, we predict human confidence levels in this dynamic setting. Across 18 behavioural and 14 EEG participants, integrating EEG with behavioural data improves prediction to 83% accuracy under intra-subject validation, outperforming either modality alone. These insights can contribute to developing AI systems that adapt their assistance based on user confidence and decision-making processes.},
}

@misc{tzyy_ping_jung_95232ae23dc35623,
  title = {Brain Network Plasticity Following Frontal Alpha Asymmetry Neurofeedback During Social Decision-Making},
  author = {Lu Shen and Ze Wang and Xucheng Liu and Wenya Nan and Tzyy‐Ping Jung and Feng Wan},
  year = {2026},
  doi = {10.1109/tcss.2026.3729774},
