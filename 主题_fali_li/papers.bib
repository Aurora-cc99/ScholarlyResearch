@misc{fali_li_ad67ba11dc91eb25,
  title = {An automated approach for predicting HAMD-17 scores via divergent selective focused multi-heads self-attention network},
  author = {Jing Qin and Zhiguang Qin and Zhen Qin and Fali Li and Yueheng Peng and Yue Zhang and Yutong Yao},
  year = {2024},
