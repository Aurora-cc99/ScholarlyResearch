@misc{jianfeng_feng_c1bf9082eea547d9,
  title = {Blunted ventral striatal responses to anticipated rewards foreshadow problematic drug use in novelty-seeking adolescents},
  author = {Christian Büchel and Jan Peters and Tobias Banaschewski and Arun L.W. Bokde and Uli Bromberg and Patricia Conrod and Herta Flor and Dimitri Papadopoulos Orfanos and Hugh Garavan and Penny Anne Gowland and Andreas Heinz and Henrik Walter and Bernd Ittermann and Karl F Mann and J. L. Martinot and Marie‐Laure Paillère Martinot and Frauke Nees and Tomáš Paus and Zdenka Pausová and Luise Poustka and Marcella Rietschel and Trevor William Robbins and Michael N. Smolka and Jürgen Gallinat and Günter Schumann and Brian D Knutson and Mercedes Arroyo and Éric Artiges and Semiha Aydın and Christine Bach and Alexis Barbot and Gareth J. Barker and Rüdiger Brühl and Anna Cattrell and Patrick Constant and Hans S. Crombag and Katharina Czech and Jeffrey W. Dalley and Benjamin Decideur and Sylvane Desrivières and Tahmine Fadai and Mira Fauth‐Bühler and Jianfeng Feng and Irinia Filippi and Vincent Frouin and Birgit Fuchs and Isabel Gemmeke and Alexander Genauck and Éanna Hanratty and Bert Heinrichs and Nadja Heym and Thomas Hübner and Albrecht Ihlenfeld and Alex Ing and James Ireland and Tianye Jia and Jennifer Lynn Jones and Sarah Jurk and Mehri Kaviani and Arno Klaassen and Johann Kruschwitz and Christophe Lalanne and Dirk Lanzerath and Mark G. Lathrop and Claire Lawrence and Hervé Lemaître and Christine Macare and Catherine Mallik and Adam C. Mar and Lourdes Martinez-Medina and Eva Mennigen and Fabiana Mesquita de Carvahlo and Xavier Mignon and Sabina Millenet and Rubén Miranda and Kathrin Müller and Charlotte Nymberg and Caroline Parchetka and Yolanda Peña‐Oliver and Jani Pentillä and Jean‐Baptiste Poline and Erin Burke Quinlan and Michael A. Rapp and Stephan Ripke and Tamzin L. Ripley and Gabriel Robert and John Rogers and Alexander Romanowski and Barbara Ruggeri and Christine Schmäl and Dirk Schmidt and Sophia Schneider and Florian Schubert and Yannick Schwartz and Wolfgang H. Sommer and Rainer Spanagel and Claudia Speiser and Tade Matthias Spranger and Alicia Stedman and Dai N. Stephens},
  year = {2017},
  doi = {10.1038/ncomms14140},
  url = {https://doi.org/10.1038/ncomms14140},
  howpublished = {Nature Communications},
  annotation = {中文辅助译名：腹侧纹状体对预期奖励的反应迟钝预示着寻求新奇的青少年可能会出现药物使用问题},
  abstract = {Novelty-seeking tendencies in adolescents may promote innovation as well as problematic impulsive behaviour, including drug abuse. Previous research has not clarified whether neural hyper- or hypo-responsiveness to anticipated rewards promotes vulnerability in these individuals. Here we use a longitudinal design to track 144 novelty-seeking adolescents at age 14 and 16 to determine whether neural activity in response to anticipated rewards predicts problematic drug use. We find that diminished BOLD activity in mesolimbic (ventral striatal and midbrain) and prefrontal cortical (dorsolateral prefrontal cortex) regions during reward anticipation at age 14 predicts problematic drug use at age 16. Lower psychometric conscientiousness and steeper discounting of future rewards at age 14 also predicts problematic drug use at age 16, but the neural responses independently predict more variance than psychometric measures. Together, these findings suggest that diminished neural responses to anticipated rewards in novelty-seeking adolescents may increase vulnerability to future problematic drug use.},
}

