@misc{jianfeng_feng_16d92824d96d,
  title = {Role of tonic inhibition in associative reward conditioning in Lymnaea. Frontiers in Behaviour Neuroscience, 4},
  author = {Vincenzo Marra and Ildikó Kemenes and Dimitris Vavoulis and Jianfeng Feng and Michael O'Shea and Paul R Benjamin},
