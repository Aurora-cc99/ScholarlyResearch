@misc{jianfeng_feng_42a5850e7471,
  title = {Invariance principles allowing of non-lyapunov functions for estimating attractor of discrete dynamical systems},
  author = {Tian Ge and Wei Lin and Jianfeng Feng},
  year = {2012},
  doi = {10.1109/TAC.2011.2164013},
