@misc{jianfeng_feng_5f58ab09b6f2,
  title = {Dynamic changes in brain lateralization correlate with human cognitive performance},
  author = {Xinran Wu and Xiangzhen Kong and Deniz Vatansever and Zhaowen Liu and Kai Zhang and Barbara Jacquelyn Sahakian and Trevor William Robbins and Jianfeng Feng and Paul M. Thompson and Jie Zhang},
