@misc{jianfeng_feng_676992282f7b,
  title = {Severe nausea and vomiting in pregnancy: psychiatric and cognitive problems and brin structure in children},
  author = {Hui Wang and Edmund T. Rolls and Xiujuan Du and Jingnan Du and Dexin Yang and Jiong Li and Fei Ran Li and Wei Cheng and Jianfeng Feng},
  year = {2020},
  doi = {10.1186/s12916-020-01701-y},
