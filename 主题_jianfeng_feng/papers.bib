@misc{jianfeng_feng_9e1b131caf7b,
  title = {“Brain Connectivity Deviates by Sex and Hemisphere in the First Episode of Schizophrenia” —A Route to the Genetic Basis of Language and Psychosis?},
  author = {Qiang Wang and Jie Zhang and Zhaowen Liu and T. J. Crow and Kai Zhang and Lena K. Palaniyappan and Mingli Li and Liansheng Zhao and Xiaojing Li and Wei Deng and Wanjun Guo and Xiaohong Ma and Wei Cheng and Liang Ma and Lin Wan and Guangming Lu and Zhening Liu and Jijun Wang and Jianfeng Feng and Tao Li},
