@misc{saif_mohammad_66935d21c35a2a10,
  title = {What Makes Sentences Semantically Related? A Textual Relatedness Dataset and Empirical Study},
  author = {Krishnapriya Vishnubhotla and Mohamed Abdalla and Saif M. Mohammad},
  year = {2023},
