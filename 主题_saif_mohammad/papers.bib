  author = {Stefan Feuerriegel and Abdurahman Maarouf and Dominik Bär and Dominique Geissler and Jonas Schweisthal and Nicolas Pröllochs and Claire Elizabeth Robertson and Steve Rathje and Jochen Hartmann and Saif M. Mohammad and Oded Netzer and Alexandra Arons Siegel and Barbara Plank and Jay Joseph Van Bavel},
