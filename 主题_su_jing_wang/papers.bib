@misc{su_jing_wang_e7f1e5de1a8bd739,
  title = {Combined effects and potential mechanisms of phthalate metabolites on serum sex hormones among reproductive-aged women: An integrated epidemiology and computational toxicology study},
  author = {Xiaoqian Li and Na Zheng and Wenhui Zhang and Yan Yu and Yunyang Li and Siyu Sun and Yining Ji and Sujing Wang},
