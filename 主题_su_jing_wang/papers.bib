@misc{fu_xiaolan_94824debb0011ef7,
  title = {A General Exponential Framework for Dimensionality Reduction},
  author = {Sujing Wang and Shuicheng Yan and Jian Jun Yang and Chunguang Zhou and Xiaolan Fu},
  year = {2014},
  doi = {10.1109/tip.2013.2297020},
  url = {https://doi.org/10.1109/tip.2013.2297020},
  howpublished = {IEEE Transactions on Image Processing},
  annotation = {中文辅助译名：降维的通用指数框架},
  abstract = {As a general framework, Laplacian embedding, based on a pairwise similarity matrix, infers low dimensional representations from high dimensional data. However, it generally suffers from three issues: 1) algorithmic performance is sensitive to the size of neighbors; 2) the algorithm encounters the well known small sample size (SSS) problem; and 3) the algorithm de-emphasizes small distance pairs. To address these issues, here we propose exponential embedding using matrix exponential and provide a general framework for dimensionality reduction. In the framework, the matrix exponential can be roughly interpreted by the random walk over the feature similarity matrix, and thus is more robust. The positive definite property of matrix exponential deals with the SSS problem. The behavior of the decay function of exponential embedding is more significant in emphasizing small distance pairs. Under this framework, we apply matrix exponential to extend many popular Laplacian embedding algorithms, e.g., locality preserving projections, unsupervised discriminant projections, and marginal fisher analysis. Experiments conducted on the synthesized data, UCI, and the Georgia Tech face database show that the proposed new framework can well address the issues mentioned above.},
}

