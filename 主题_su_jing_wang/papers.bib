@misc{su_jing_wang_b3bada7ff2d66327,
  title = {Social Media Analysis for Mental Health using Large Language Models},
  author = {Nirmal Bhandari and Sujing Wang},
  year = {2025},
  doi = {10.1109/icbda65366.2025.11211318},
  url = {https://doi.org/10.1109/icbda65366.2025.11211318},
  howpublished = {IEEE International Conference on Big Data Analytics (ICBDA)},
  annotation = {中文辅助译名：使用大型语言模型进行心理健康社交媒体分析},
  abstract = {Mental health is a global issue in modern society. Social media has become an integral part of people's lives, where users share moments and feelings through posts rich in emotional content. Social content has been widely used to study mental health issues. Social media platforms such as Reddit and Twitter provide anonymous space for users to discuss stigmatic topics and self-report personal issues. In this paper, we introduced a comprehensive evaluation of several large language models (LLMs) for mental health analysis based on social media data, including Bidirectional Encoder Representations from Transformers (BERT), robustly optimized BERT (RoBERT), MentalBERT, Microsoft/Phi-2, and MentalLLAMa, etc. We discussed their capabilities to categorize mental health conditions and provided insights into mental health analysis based on the corpus collected from social forums. Our experiments were conducted on the Reddit Suicide Watch and Mental Health (SWMH) data collected from several Reddit mental health communities. The results suggest that fine-tuning and instruction fine-tuning have significant potential for advancing mental health analysis using LLMs.},
}

