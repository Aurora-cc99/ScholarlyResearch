@misc{su_jing_wang_1e253a6b2fd139a0,
  title = {Solved Environmental/Economic Dispatch Based on Multi-objective PSO},
  author = {Libiao Zhang and Xiangli Xu and Sujing Wang and Ming Ma and Chunguang Zhou and Caitang Sun},
  year = {2010},
  doi = {10.1109/icicta.2010.470},
  url = {https://doi.org/10.1109/icicta.2010.470},
  howpublished = {International Conference on Intelligent Computation Technology and Automation},
  annotation = {中文辅助译名：基于多目标粒子群算法解决环境/经济调度},
  abstract = {A new multi-objective evolutionary algorithm for Environmental/Economic power Dispatch (EED) problem based on Particle Swarm Optimization (PSO) is proposed in this paper. The new algorithm has adopted the maintenance method of Pareto candidate solution set based on the max-min distance density. The algorithm effectively guarantees the convergence of the algorithm and the diversity solutions. The performance of algorithm has been examined over the standard IEEE 30-bus six-generator test system, and other multi-objective evolutionary algorithm are compared. Testing and comparing results showed this paper algorithm is feasible and efficient.},
}

@misc{su_jing_wang_ecd3e9c253eeb542,
  title = {Tensor analysis and multi-scale features based multi-view human action recognition},
  author = {Chengcheng Jia and Sujing Wang and Xiangli Xu and Chunguang Zhou and Libiao Zhang},
  year = {2010},
  doi = {10.1109/iccet.2010.5485732},
  url = {https://doi.org/10.1109/iccet.2010.5485732},
  howpublished = {International Conference on Computer Engineering and Technology},
  annotation = {中文辅助译名：基于张量分析和多尺度特征的多视角人体动作识别},
  abstract = {A method of multi-view human action recognition based on multi-scale features via tensor analysis is proposed. A series of silhouettes are transformed to a Serials-Frame image, from which the multi-scale features are extracted to construct the eigenSpace of a tensor, which named Serials-Frame Tensor(SF-Tensor). The SF-Tensor subspace analysis is applied to separate the variable views and people information to recognize different actions. Experiment results obtained show that the proposed method attains a good recognition rate and improves the efficiency significantly.},
}

@misc{su_jing_wang_8cfbf0a8b9c38abc,
  title = {A polygon-based methodology for mining related spatial datasets},
  author = {Vadeerat Rinsurongkawong and Su-Jing Wang and Chun-Sheng Chen and Christoph F. Eick and Fatih Akdag},
  year = {2010},
  doi = {10.1145/1869890.1869891},
  url = {https://doi.org/10.1145/1869890.1869891},
  howpublished = {GIS-DMG},
  annotation = {中文辅助译名：一种基于多边形的相关空间数据集挖掘方法},
  abstract = {Polygons can serve an important role in the analysis of geo-referenced data as they provide a natural representation for particular types of spatial objects and in that they can be used as models for spatial clusters. This paper claims that polygon analysis is particularly useful for mining related, spatial datasets. A novel methodology for clustering polygons that have been extracted from different spatial datasets is proposed which consists of a meta clustering module that clusters polygons and a summary generation module that creates a final clustering from a polygonal meta clustering based on user preferences. Moreover, a density-based polygon clustering algorithm is introduced. Our methodology is evaluated in a real-world case study involving ozone pollution in Texas; it was able to reveal interesting relationships between different ozone hotspots and interesting associations between ozone hotspots and other meteorological variables.},
}

@misc{su_jing_wang_a6e26e22b7308732,
  title = {A Sign Language Recognition Based on Tensor},
  author = {Sujing Wang and Zhang De-cai and Chengcheng Jia and Na Zhang and Chunguang Zhou and Libiao Zhang},
  year = {2010},
  doi = {10.1109/mmit.2010.21},
  url = {https://doi.org/10.1109/mmit.2010.21},
  howpublished = {International Conference on Multimedia and Information Technology},
  annotation = {中文辅助译名：一种基于张量的手语识别},
  abstract = {The hand gesture recognition plays a key role in many appealing applications. The sign language recognition is one of the important applications of hand gesture recognition. The existing methods on sign language recognition are limited to certain view. In this paper, we use tensor subspace analysis to model a multi-view hand gesture to recognize 26 manual alphabetical letters. In our experiment, each hand gesture is captured from 5 different views. Two experiments are conducted on gray-scale images and binary images, respectively. The results show the proposed method has a good performance on multi-view.},
}

