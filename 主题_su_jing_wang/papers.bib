@misc{su_jing_wang_9e4883a94a0b3344,
  title = {Long-Term and Real-Time High-Speed Underwater Wireless Optical Communications in Deep Sea},
  author = {Fei Zhang and Shanguo Huang and Ziqi Ma and Guanjun Gao and Yonggang Guo and Jialiang Zhang and Jie Zhang and Su-Jing Wang},
