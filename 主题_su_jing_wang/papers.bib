@misc{su_jing_wang_340fe1b9a6cad291,
  title = {A Pest Control Model with Periodic Coefficients and Impulses},
  author = {Sujing Wang and Jiawei Dou and Lala Lu},
  year = {2011},
  doi = {10.1016/j.proenv.2011.10.079},
  url = {https://doi.org/10.1016/j.proenv.2011.10.079},
  howpublished = {Procedia Environmental Sciences},
  annotation = {中文辅助译名：具有周期系数和脉冲的害虫控制模型},
  abstract = {In this paper, we consider a pest control model with natural enemy releases. The mathematical problem involves a predator-prey system with periodic coefficients and pulse conditions. First, we show that the system has a unique pest-free periodic solution, which is globally asymptotically stable under certain condition. Furthermore, we prove that the system is permanent if the pest-free periodic solution is unstable. The results generalize some conclusions in [8,9] for the system with constant coefficients. Some computer simulations are made to demonstrate the main results.},
}

