  title = {Machine Learning for Affective Computing},
  author = {Mohammed E. Hoque and Louis-Philippe Morency and Daniel McDuff and Rosalind W. Picard},
  year = {2011},
  doi = {10.1007/978-3-642-24571-8_70},
  url = {https://doi.org/10.1007/978-3-642-24571-8_70},
  howpublished = {ACII (2)},
  annotation = {中文辅助译名：情感计算的机器学习},
  abstract = {This chapter is from the forthcoming The Oxford Handbook of Affective Computing edited by Rafael Calvo, Sidney K. D’Mello, Jonathan Gratch, and Arvid Kappas. The ability to recognize affect is one of the fundamental requirements in building a computerized affectively intelligent system. Although the ideas from traditional machine learning constitute the core of an affect recognition methodology, there are significant additional considerations that must be observed. These considerations include aspects of data collection and annotation, feature selection, algorithm design, and system evaluation. This chapter aims to highlight such deviations and provide an overview of how some of the current research has attempted to solve these problems.},
