@misc{rafael_calvo_57e0f156957aa437,
  title = {Front-End Ethics for Sensor-Fused Health Conversational Agents: An Ethical Design Space for Biometrics},
  author = {Rafael A. Calvo and Hansoo Lee},
  year = {2026},
  doi = {10.48550/ARXIV.2604.06203},
  url = {https://doi.org/10.48550/ARXIV.2604.06203},
  howpublished = {CoRR},
  annotation = {中文辅助译名：传感器融合健康对话代理的前端伦理：生物识别技术的伦理设计空间},
  abstract = {The integration of continuous data from built-in sensors and Large Language Models (LLMs) has fueled a surge of "Sensor-Fused LLM agents" for personal health and well-being support. While recent breakthroughs have demonstrated the technical feasibility of this fusion (e.g., Time-LLM, SensorLLM), research primarily focuses on "Ethical Back-End Design for Generative AI", concerns such as sensing accuracy, bias mitigation in training data, and multimodal fusion. This leaves a critical gap at the front end, where invisible biometrics are translated into language directly experienced by users. We argue that the "illusion of objectivity" provided by sensor data amplifies the risks of AI hallucinations, potentially turning errors into harmful medical mandates. This paper shifts the focus to "Ethical Front-End Design for AI", specifically, the ethics of biometric translation. We propose a design space comprising five dimensions: Biometric Disclosure, Monitoring Temporality, Interpretation Framing, AI Stance, and Contestability. We examine how these dimensions interact with context (user- vs. system-initiated) and identify the risk of biofeedback loops. Finally, we propose "Adaptive Disclosure" as a safety guardrail and offer design guidelines to help developers manage fallibility, ensuring that these cutting-edge health agents support, rather than destabilize, user autonomy.},
}

@misc{rafael_calvo_d3470db1f5560bfd,
  title = {Conversational Care: Designing Responsible Human-AI Care Coordination},
  author = {Marco Da Re and Pablo A. Fonseca and Minseo Cho and Javier Sanchez and Alina‐Irina Serban and Francisco Diez-Canseco and María Sofía Cuba-Fuentes and Ravi Vaidyanathan and Rafael A. Calvo},
  year = {2026},
  doi = {10.14236/ewic/britchi26.17},
  url = {https://doi.org/10.14236/ewic/britchi26.17},
  howpublished = {Electronic workshops in computing},
  annotation = {中文辅助译名：对话式护理：设计负责任的人类与人工智能护理协调},
  abstract = {Healthcare systems worldwide face demand they cannot meet, and conversational artificial intelligence (CAI) is one of the pathways to scale provisions. But doing so responsibly requires addressing safety, fairness, effectiveness, accessibility, and several other criteria at once. Few projects have the resources to build a system that meets all of them from scratch. We followed a 2-year Research through Design process to iteratively build Conversational Care: a customisable platform that integrates AI agents into care-team workflows, automating routine tasks and escalating to humans when oversight is needed. The platform embeds nine responsible-AI criteria drawn from the literature. It has been designed with, and to support, community health workers, nurses, and families of people living with dementia in Peru and the UK; health coaches and link workers in London; with early exploration of care home monitoring in Singapore. Working across such varied scenarios surfaced the design trade-offs and recurring patterns that emerge when CAI is integrated into real care systems – contributions that other teams can adapt to their own contexts.},
}

@misc{rafael_calvo_936b96fecb08eee7,
  title = {Integration of an Automated Conversational Service incorporating Speech analysis in Dementia Care Pathways: Protocol for the staged development and feasibility evaluation (Preprint)},
  author = {Alina‐Irina Serban and Marco Da Re and Maria Raposo De Lima and Julio Amador and Pablo Fonseca Arroyo and Matthew Harrison and Jessica True and Ramin Nilforooshan and Rafael A. Calvo and Ravi Vaidyanathan},
  year = {2026},
  doi = {10.2196/99729},
  url = {https://doi.org/10.2196/99729},
  howpublished = {JMIR Research Protocols},
  annotation = {中文辅助译名：将自动化对话服务与痴呆症护理途径中的语音分析相结合：分阶段开发和可行性评估协议（预印本）},
  abstract = {BACKGROUND Operational teams supporting people living with dementia in smart homes face growing workloads from routine tasks, technical troubleshooting, and responding to alerts. Calling participants is time-consuming, and without additional context, prioritising tasks is challenging. These calls also represent an opportunity to enhance monitoring by analysing speech as a potential marker of dementia progression. Scalable technological solutions are therefore needed to augment human monitoring while capturing clinically meaningful signals from everyday interactions. OBJECTIVE This study aims to develop, integrate and evaluate a scalable conversational service with embedded speech analysis that is used in smart homes within the UK Dementia Research Institute Care Research and Technology Centre. This system will provide support for routine tasks and facilitate daily communication with participants while reducing the workload of the operational teams. METHODS This study aims to develop, integrate and evaluate an automated conversational platform with embedded speech analysis in existing smart home systems for dementia. This is a novel study which adopts a staged, mixed-methods approach for early co-design, system development, technical integration, and real-world participant testing. The service will enable routine communication with households to help with managing simple queries and reduce the workload of operational teams. Initial deployment will focus on core functionalities},
}

@misc{rafael_calvo_a66c89317e4ff63e,
  title = {Understanding Workplace Relatedness Support among Healthcare Professionals: A Four-Layer Model and Implications for Technology Design},
  author = {Jingjing Sun and Dorian Peters and Zheyuan Zhang and Lan Xiao and Andrew Hall and Laura Moradbakhti and Rafael A. Calvo},
  year = {2026},
  doi = {10.1145/3772318.3790900},
  url = {https://doi.org/10.1145/3772318.3790900},
  howpublished = {CHI},
  annotation = {中文辅助译名：了解医疗保健专业人员之间的工作场所相关性支持：四层模型及其对技术设计的影响},
  abstract = {Healthcare professionals (HCPs) face increasing occupational stress and burnout. Supporting HCPs’ need for relatedness is fundamental to their psychological wellbeing and resilience. However, how technologies could support HCPs’ relatedness in the workplace remains less explored. This study incorporated semi-structured interviews (n = 15) and co-design workshops (n = 21) with HCPs working in the UK National Health Service (NHS), to explore their current practices and preferences for workplace relatedness support, and how technology could be utilized to benefit relatedness. Qualitative analysis yielded a four-layer model of HCPs’ relatedness need, which includes Informal Interactions, Camaraderie and Bond, Community and Organizational Care, and Shared Identity. Workshops generated eight design concepts (e.g., Playful Encounter, Collocated Action, and Memories and Stories) that operationalize the four relatedness need layers. We conclude by highlighting the theoretical relevance, practical design implications, and the necessity to strengthen relatedness support for HCPs in the era of digitalization and artificial intelligence.},
}

@misc{rafael_calvo_f1e94b0a8ca9feb7,
  title = {To Stay or to Step Back? Relational Transitions in AI Companionship: Preliminary Insights from a Pilot Scoping Review},
  author = {Xiao Yao and Zheyuan Zhang and Hu Ling and Rafael A. Calvo},
  year = {2026},
  doi = {10.14236/ewic/britchi26.69},
  url = {https://doi.org/10.14236/ewic/britchi26.69},
  howpublished = {Electronic workshops in computing},
  annotation = {中文辅助译名：留下还是退一步？人工智能陪伴中的关系转变：试点范围界定审查的初步见解},
  abstract = {AI companions are conversational or embodied systems that users engage with in sustained relational roles, yet they are often evaluated through retention-orientated metrics that treat continued interaction as a marker of success. Human-AI relational involvement can change or end, and how such transitions should be understood and designed remains unclear. We report a pilot scoping synthesis of relational transitions in AI companionship, drawing on a preliminary corpus of 51 charted papers from an ongoing PRISMA-ScR review and iterative qualitative synthesis. Across the evidence, companion relationships evolve through distinct transition pathways, reflecting changes in user needs, relational value, safety considerations, and platform conditions. We develop a preliminary working framework for mapping relational presence pathways (not mutually exclusive): (1) appropriate continuation, (2) protective withdrawal, (3) supported graduation, (4) imposed discontinuation, (5) user-initiated exit, and (6) gradual fade. We further examine continuity work after transition, including user attempts to restore disrupted AI relationships and platform efforts to shape relational continuity. Current evidence clusters around user retention, risk management, and externally imposed changes, while adaptive and user-centred relational transitions remain insufficiently studied. Informed by psychotherapy termination literature and self-determination theory, we argue for a shift from retention-orientate},
}

@misc{rafael_calvo_9d2fe11155d54c34,
  title = {The patient journey for people with dementia and their carers in Peru: From first symptoms to diagnosis and treatment},
  author = {Daniela Rossini-Vilchez and Francisco Jose Tateishi-Serruto and Christopher Butler and María Sofía Cuba-Fuentes and Silvana Pérez-León and Miriam Lúcar-Flores and Guillermo Almeida-Huanca and L. Carolina Olaya‐Silva and J. Jaime Miranda and María Kathia Cárdenas and José Carlos Vera Tudela and Antonio Bernabé‐Ortiz and Rafael A. Calvo and Francisco Diez-Canseco and Filipa Landeiro and G. Hunter Moore and Lee White and William Whiteley and María Lazo‐Porras and Jemma L. Hawkins},
  year = {2026},
  doi = {10.1002/alz.71581},
  url = {https://doi.org/10.1002/alz.71581},
  howpublished = {Alzheimer s & Dementia},
  annotation = {中文辅助译名：秘鲁痴呆症患者及其护理人员的患者历程：从最初的症状到诊断和治疗},
  abstract = {INTRODUCTION: We explored how people with dementia (PwD) and their carers navigate Peru's health system for diagnosis and treatment. METHODS: We interviewed PwD (n = 4), carers (n = 18), and healthcare workers (n = 17) from four sites. We developed a patient journey map using thematic analysis and participant validation. RESULTS: Three journey stages emerged. Pre-diagnosis: Families seek care across different sub-health systems and facilities 2-4 years after symptom onset. DIAGNOSIS: Specialist consultation is sought in major cities and diagnosis occurs in hospitals based on clinical presentation. Continuity of care: Care focuses on controlling behavioral and psychological symptoms, with limited access to dementia-specific drugs and non-pharmacological interventions, and heavy reliance on carers' resources. Community mental health centers (CMHCs) are preferred facilities due to geographical and specialist accessibility and perceived care quality. DISCUSSION: Without a formal entry point to dementia care, families navigate fragmented pathways, whereas CMHCs emerge as facilities with adequate care procedures for PwD.},
}

@misc{rafael_calvo_757a011915851430,
  title = {Evaluating Reflective Fidelity in Motivational Interviewing Informed Conversational Agents: Architecture Comparison Study (Preprint)},
  author = {Minseo Cho and Raquel Rodríguez‐Carvajal and Amani Malik and Martina C. Di Simplicio and Rafael A. Calvo},
  year = {2026},
  doi = {10.2196/preprints.116715},
  url = {https://doi.org/10.2196/preprints.116715},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：评估动机访谈知情对话代理中的反思保真度：架构比较研究（预印本）},
  abstract = {BACKGROUND Large language model (LLM)-based conversational agents may support reflection between formal care encounters, potentially promoting continued motivation and accountability. Although motivational interviewing (MI) provides a framework for reflective conversations, incorporating MI principles into prompts does not ensure that agents consistently enact motivationally sensitive behaviours. While agent architecture has been recognised as an important factor shaping agent behaviour, how prompt architecture relates to MI-relevant behaviours remains underexplored. OBJECTIVE This study examined whether single-prompt and multi-node architectures were associated with different MI-relevant behavioural profiles in a Reflective Companion developed for youth social prescribing. METHODS Of 20 participants in the broader study, 11 produced paired conversations eligible for the present analysis, yielding 22 conversations. Each participant completed one approximately 5-minute conversation with each architecture in a counterbalanced within-participant design. Two annotators independently coded agent responses using a framework adapted from the Motivational Interviewing Treatment Integrity (MITI) manual. Conversation-level behavioural indicators were compared between architectures using two-sided Wilcoxon signed-rank tests conducted separately for each annotator. RESULTS Both annotators descriptively observed more reflections with the single-prompt agent and more information-giving wit},
}

@misc{rafael_calvo_9b30b83cbd3479f2,
  title = {Ethics at the Front-End: Responsible User-Facing Design for AI Systems},
  author = {Nadia Piet and Sai Shruthi Chivukula and Christian Dindler and Dorian Peters and Naseem Ahmadpour and Tomasz Hollanek and Gizem Öz and Shaimaa Y. Lazem and Colin M. Gray and Rafael A. Calvo},
  year = {2026},
  doi = {10.1145/3772363.3778769},
  url = {https://doi.org/10.1145/3772363.3778769},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：前端道德：人工智能系统负责任的面向用户的设计},
  abstract = {AI ethics discourse typically centers on the design of algorithms and back-end systems, but the design of what users experience at the ‘front-end’ of AI systems also engages with values-laden ethical decisions. Deceptive patterns, distorted data visualization, and exclusionary interfaces represent unethical practices within the purview of interface, interaction and user experience design. In this workshop we seek to better understand and articulate what we believe to be an under-valued area of AI Ethics: front-end design. Through a combination of cross-disciplinary and collaborative hands-on activities, we aim to map a landscape of ethical front-end design for AI including an initial round-up of critical issues for practice, policy implications, and pressing areas for future research. The workshop will host a keynote by human-centered AI trailblazer, Ben Shneiderman and follow-up will include a written synthesis of outcomes for sharing with the HCI community.},
}

@misc{bjorn_schuller_d110876e803ea65f,
  title = {AI-Enhanced Conversational Agents for Personalized Asthma Support in People With Asthma: Factors for Engagement, Value, and Efficacy in a Cross-Sectional Survey Study},
  author = {Laura Moradbakhti and Dorian Peters and Jennifer Kathleen Quint and Björn Wolfgang Schuller and Darren Cook and Rafael A. Calvo},
  year = {2026},
  doi = {10.2196/80979},
  url = {https://doi.org/10.2196/80979},
  howpublished = {JMIR Human Factors},
  annotation = {中文辅助译名：人工智能增强对话代理为哮喘患者提供个性化哮喘支持：横断面调查研究中参与度、价值和功效的因素},
  abstract = {Background: Asthma-related deaths in the United Kingdom are the highest in Europe, and only 30% of patients access basic care. There is a need for alternative approaches to reaching people with asthma to provide health education, self-management support, and better bridges to care. Objective: This study aimed to examine patients' interest in using a chatbot for asthma and to identify factors that influence engagement. Automated conversational agents (specifically, mobile chatbots) present opportunities for providing alternative and individually tailored access to health education, self-management support, and risk self-assessment. But would patients engage with a chatbot, and what factors influence engagement? Methods: We present results from a patient survey (N=1257) developed by a team of asthma clinicians, patients, and technology developers, conducted to identify optimal factors for efficacy, value, and engagement with an asthma chatbot. Results: Results indicate that most adults with asthma (53%) are interested in using a chatbot. The patients most likely to do so are those who believe their asthma is more serious and are less confident in their self-management. Results also indicate enthusiasm for 24/7 access, personalization, and for WhatsApp (Meta) as the preferred access method (compared to app, voice assistant, SMS text messaging, or website). Conclusions: Obstacles to uptake include security and privacy concerns and skepticism of technological capabilities. We pres},
}

@misc{rafael_calvo_6feeb8d4f20eea04,
  title = {AI as Relational Translator: Rethinking Belonging and Mutual Legibility in Cross-Cultural Contexts},
  author = {Yao Xiao and Rafael A. Calvo},
  year = {2026},
  doi = {10.1145/3772363.3798628},
  url = {https://doi.org/10.1145/3772363.3798628},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：人工智能作为关系翻译：重新思考跨文化背景下的归属感和相互可读性},
  abstract = {Against rising global loneliness, AI companions promise connection, yet accumulating evidence suggests that, for some users and contexts, intensive companion-style use can correlate with increased loneliness and reduced offline socialisation. This position paper challenges the dominant “AI as companion” paradigm by proposing a shift: from AI that simulates relationships with humans to AI that supports relationships between humans. We introduce Relational AI Translation, positioning AI as cultural-relational infrastructure that scaffolds human connection across cultural, generational, and geographical divides. Using first-generation East Asian migrants as a theoretically productive critical case, we outline a multi-agent architecture instantiating three translation operations: emotion-intent decoding, contextual reframing, and relational scaffolding. We articulate design provocations around measurement, safety architecture, and the tension between technological intervention and structural justice, and explicitly frame success as graduation toward renewed human-to-human support rather than sustained engagement with the system.},
}

@misc{rafael_calvo_386174ecc8ffcf5c,
  title = {Self-determination theory in HCI: advancing the field},
  author = {Dorian Peters and Rafael A. Calvo and Elisa D. Mekler and Nick Ballou and Sebastian Deterding and Gabriela Villalobos-Zúñiga},
  year = {2026},
  doi = {10.1093/IWC/IWAG019},
  url = {https://doi.org/10.1093/IWC/IWAG019},
  howpublished = {Interact. Comput.},
  annotation = {中文辅助译名：人机交互中的自我决定理论：推进该领域},
  abstract = {Self-determination theory (SDT) has been widely successful in human–computer interaction (HCI). It offers ready concepts, measures, and theoretical propositions for third wave HCI topics such as user experience, fun, wellbeing, motivation, or user autonomy. Still, HCI applications of SDT have been partial, at times superficial, and disconnecting—leaving great unfulfilled potential which motivated the present special issue. In this introduction, we present SDT to interested scholars, chart its use across HCI to date, and outline six advances to move HCI toward more intentional applications of SDT. As the articles from this issue illustrate, future growth areas of SDT in HCI are in extending domain-specific models and applications, harnessing underused parts of theory, computational formalization, extending levels of analysis, facilitating design translation, and engaging in a cross-disciplinary dialogue on autonomy.},
}

@misc{rafael_calvo_1b121e72c550d3cc,
  title = {Conversational Artificial Intelligence in Community Care: A Scoping Review},
  author = {Minseo Cho and Marco Da Re and Tori Simpson and Matthew Harrison and Rafael A. Calvo},
  year = {2026},
  doi = {10.1080/10447318.2026.2751902},
  url = {https://doi.org/10.1080/10447318.2026.2751902},
  howpublished = {International Journal of Human-Computer Interaction},
  annotation = {中文辅助译名：社区护理中的对话式人工智能：范围界定审查},
  abstract = {The strategic shift toward community-based healthcare, away from hospital settings, is a policy priority internationally. Conversational artificial intelligence (CAI) may support this transition, yet its practical applications remain underexplored. This scoping review maps CAI capabilities and their configuration within community care. We searched PubMed, the ACM Digital Library, and selected grey-literature sources for studies published from January 2023 to June 2025. Of 551 records identified, 29 studies were included. We identified 20 capabilities across five functional domains: Understand (n = 5), Transform (n = 3), Remember (n = 3), Generate (n = 5), and Act (n = 4). Findings suggest that CAI extends rather than replaces human care, supporting access, ongoing engagement, and care coordination. Multi-party and expert-in-the-loop designs emerged as recurring implementation strategies. They also surface design tensions, including tradeoffs between reliability and conversational flexibility, and between the benefits of long-term memory and associated privacy risks. The resulting capability-centered taxonomy offers accessible framework for integrating CAI into community care settings.},
}

@misc{rafael_calvo_1c6afb57e473aafb,
  title = {The Role of Generative Summarisation in Agent-Mediated Reflection for Youth Social Prescribing},
  author = {Minseo Cho and Martina C. Di Simplicio and Rafael A. Calvo},
  year = {2026},
  doi = {10.1145/3816046.3816262},
  url = {https://doi.org/10.1145/3816046.3816262},
  howpublished = {ACM Conference on Conversational User Interfaces (CUI)},
  annotation = {中文辅助译名：生成总结在代理介导的青少年社会处方反思中的作用},
  abstract = {Social prescribing offers a promising approach to supporting youth mental health through community resources. However, challenges remain in sustaining engagement and adapting care to the ongoing participation. To address these gaps, we developed Reflective Companion, a conversational agent that facilitates reflection through generative dialogue and provides structured summaries. Through user testing with 12 young people and 8 link workers, we examined the role of agent-generated summaries in social prescribing context. Our findings reveal that summaries function as interactional artefacts rather than mere recaps. They showed potential to transform reflection from a temporal interaction into a cumulative process, potentially fostering longitudinal continuity across broader care journey. Furthermore, the summary may strengthen data agency, establish relational bond based on functional trust, and provide mediated visibility, offering clinical oversight without compromising personal privacy. These findings reframe the role of generative summaries in reflective systems and demonstrate their potential for effective and responsible technology use within human-led care.},
}

@misc{rafael_calvo_455e287e85b492f2,
  title = {All four leading LLMs talk more than they listen to personality-verified synthetic help-seekers},
  author = {Rafael A. Calvo and Raquel Rodríguez-Carvajal and Pablo A. Fonseca},
  year = {2026},
  doi = {10.48550/ARXIV.2608.22425},
  url = {https://doi.org/10.48550/ARXIV.2608.22425},
  howpublished = {CoRR},
  annotation = {中文辅助译名：所有四位领先的大语言模型谈论的都多于他们倾听经过个性验证的合成寻求帮助者的话},
  abstract = {Large language models are increasingly consulted at moments of distress, yet single-turn benchmarks neither test sustained exchanges nor distinguish between users. We built a personality-aware evaluation in which four widely used models advised several synthetic help-seekers, each given a psychometrically specified profile, in an acute crisis: a caregiver learning of a relative's dementia diagnosis. Auditors blind to the profile prompt recovered the specified bands from dialogue alone with high agreement on every instrument (ICC(2,4) = 0.91; 0.79-0.96 by instrument; band-score r = 0.78), as expected for the Big Five but equally for coping style, coping self-efficacy, resilience and reactance, which the lexical approach never covered. Such evaluation therefore reaches beyond the Five Factor Model to motivational, regulatory and self-appraisal dispositions. The four models were not distinguishable on emotion stabilisation and failed alike, sharing three modes: verbosity, a talk-to-listen ratio above one, and problem-solving before the situation had been explored.},
}

@misc{rafael_calvo_0b56f4eb3b1c5631,
  title = {Making Architectural Decisions Traceable in the Participatory Design of LLM Agents},
  author = {Minseo Cho and Pablo A. Fonseca and Martina C. Di Simplicio and Rafael A. Calvo},
  year = {2026},
  doi = {10.14236/ewic/britchi26.88},
  url = {https://doi.org/10.14236/ewic/britchi26.88},
  howpublished = {Electronic workshops in computing},
  annotation = {中文辅助译名：在 LLM 智能体的参与式设计中使架构决策可追溯},
  abstract = {Participatory design enables HCI researchers to involve stakeholders in shaping interactive systems that reflect their values and contextual needs. In LLM-based conversational agents, however, user experience is shaped not only by visible dialogue or interface features, but also by behind-the-scenes elements such as underlying models and architectures. While participatory design is well-suited to eliciting descriptive user needs, the translation from qualitative design themes to internal agent architectures often remains implicit, distributed across teams, and difficult to trace. This lack of traceability makes it challenging to verify whether the resulting system remains aligned with stakeholder expectations, especially in high-stakes domains like mental health. To address this challenge, this paper explores how to make architectural decisions traceable in the participatory design of LLM-based agents. We present a reflective case situated in the design of an agent for mental health. Through this case, we articulate a translation process shaped by four forms of design judgment: making operations visible, identifying database needs, consolidating overlapping logics, and assigning architectural roles. We show that the same qualitative theme can yield different technical structures, each carrying distinct interactional and ethical consequences. By examining this interpretive translation layer, we illustrate through a reflective case how the movement from participatory insights t},
}

@misc{rafael_calvo_0e0b0afe8e6126b3,
  title = {Towards culturally-appropriate AI for health in the majority world: insights from participatory work in Latin America},
  author = {Guido Ivetta and Luciana Benotti and Dorian Peters and Rafael A. Calvo and Marco Da Re and Fernanda Espinoza},
  year = {2026},
  doi = {10.1007/S43681-026-01196-Y},
  url = {https://doi.org/10.1007/S43681-026-01196-Y},
  howpublished = {AI Ethics},
  annotation = {中文辅助译名：在大多数世界实现文化上适宜的人工智能健康：来自拉丁美洲参与性工作的见解},
  abstract = {There is mounting interest in leveraging conversational AI (CAI) for health across the world, including in underserved regions, but to be effective, CAI must respond appropriately within culturally and linguistically diverse contexts. Therefore, we need ways to address the fact that current LLMs exclude many lived experiences globally. Various advances are underway which focus on top-down approaches and increasing training data. In this paper, we aim to complement these with a bottom-up locally-grounded approach based on qualitative data collected during participatory workshops in Latin America. Our goal is to construct a rich and human-centred understanding of: (a) potential areas of cultural misalignment in digital health; (b) regional perspectives on chatbots for health and (c) strategies for creating culturally-appropriate CAI, with a focus on the understudied Latin American context. Our findings show that academic boundaries on notions of culture lose meaning at the ground level and technologies will need to engage with a broader framework; one that encapsulates the way economics, politics, geography and local logistics are entangled in cultural experience. To this end, we introduce a framework for ‘Pluriversal Conversational AI for Health’ which allows for the possibility that more relationality and tolerance , rather than just more data , may be called for.},
}

@misc{rafael_calvo_97c4552101445bf3,
  title = {DignityAI: Prototyping and Evaluating Community-based Preventive Care Solutions for Ageing Populations in Singapore},
  author = {Kate Sangwon Lee and Rafael A. Calvo and Li Hong Idris Lim and Ying Jiang and Wenru Wang and Raquel Rodríguez‐Carvajal and Marco Da Re and Pablo Alejandro Fonseca Arroyo},
  year = {2026},
  doi = {10.14236/ewic/britchi26.45},
  url = {https://doi.org/10.14236/ewic/britchi26.45},
  howpublished = {Electronic workshops in computing},
  annotation = {中文辅助译名：DignityAI：针对新加坡老龄化人口的基于社区的预防保健解决方案的原型设计和评估},
  abstract = {In Singapore, a fast-ageing society, the community care apartment (CCA) is a public-housing model through which the Singapore government facilitates community-based care for older adults. CCA faces challenges including understaffing and the absence of intelligent monitoring, which limits its ambitions to prevent illness and support independent living. We conducted a four-day hybrid hackathon between Singapore and the United Kingdom in which around thirty interdisciplinary students and researchers built four prototypes that pair passive ambient sensing with AI-powered conversational agents, targeting the pre-crisis window across a client–monitor–AI triad. We then evaluated the prototypes through an expert review grounded in Value Sensitive Design (VSD) using five values — autonomy, dignity, well-being, transparency and trust, and care fit — and identified their central value tension. The four prototypes showed complementary, near-mirror value profiles: the monitor-facing digital twin scored highest on care fit but lowest on autonomy, while the resident-facing coaching agent showed the inverse pattern. Three cross-cutting tensions emerged: watching over people versus the feeling of being watched; design restraint that protects dignity at the cost of the residents’ own voice; and the inference of social intent from sensor data without explicit consent. We contribute the prototypes, the evaluation protocol, and design recommendations for dignified preventive care.},
}

@misc{rafael_calvo_14e4755fb790bd93,
  title = {SAGE: Sensor-Augmented Grounding Engine for LLM-Powered Sleep Care Agent},
  author = {Sonya S. Kwak and Hansoo Lee and Yoonjae Cho and Rafael A. Calvo},
  year = {2026},
  doi = {10.1145/3772363.3798959},
  url = {https://doi.org/10.1145/3772363.3798959},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：SAGE：用于 LLM 驱动的睡眠护理智能体的传感器增强接地引擎},
  abstract = {Sleep is vital for health, yet access to data alone does not guarantee improvement. While wearables and health apps enable tracking, users face a "Data-Action Gap," struggling to interpret metrics and translate them into action. Current interventions fail to bridge this: static dashboards lack context, rule-based agents rely on rigid scripts, and LLM-agents lack grounding in personal data, causing trust issues. We propose SAGE (Sensor-Augmented Grounding Engine) for an LLM-powered sleep care agent. SAGE normalizes continuous sleep, physiological, and activity data from the sensors into a queryable time-series layer. It supports (1) selective system-initiated monitoring that triggers notifications only upon detecting meaningful deviations against personal baselines to reduce alert fatigue, and (2) user-initiated Q&A where natural language is translated into executable database queries. By ensuring responses are grounded in precise period, comparison, and metric data, SAGE aims to enhance personalization, traceability, and trust, articulating a novel design space for evidence-based messaging in sleep care.},
}

@misc{rafael_calvo_a57e5fb21fd242e5,
  title = {Beyond Wellbeing Apps: Co-Designing Immersive, Embodied, and Collective Digital Wellbeing Interventions for Healthcare Professionals},
  author = {Dorian Peters and Rafael A. Calvo and Jingjing Sun and Zheyuan Zhang},
  year = {2025},
  doi = {10.1145/3715336.3735681},
  url = {https://doi.org/10.1145/3715336.3735681},
  howpublished = {Conference on Designing Interactive Systems},
  annotation = {中文辅助译名：超越健康应用程序：为医疗保健专业人员共同设计沉浸式、具体化和集体数字健康干预措施},
  abstract = {Healthcare professionals (HCPs) face increasing levels of stress and burnout. Technological wellbeing interventions provide accessible and flexible support for HCPs. While most studies have focused on mobile- and web-based programs, alternative technologies like virtual reality (VR), augmented reality (AR), tangible interfaces, and embodied technologies are emerging as engaging and effective tools for wellbeing interventions. However, there is still a lack of research on how such technologies are perceived among HCPs. This study explored HCPs' perceptions and preferences for various types of wellbeing technologies, by conducting a 2-phase co-design study involving 26 HCPs in idea generation, concept evaluation, prototype testing, and design iteration. From our findings, HCPs highly valued the potential of technologies to support mental health with immersive, embodied, and collective experiences. Furthermore, we provided design recommendations for wellbeing technologies for HCPs that sustain user engagement by meeting their needs for autonomy, competence, and relatedness in the experiences.},
}

@misc{rafael_calvo_d8b884183db44fea,
  title = {Challenges of responsible AI in practice: scoping review and recommended actions},
  author = {Rafael A. Calvo and Stephen Cave and Céline Mougenot and Emma Kallina and Malak Sadek and Thomas Bohné},
  year = {2025},
  doi = {10.1007/S00146-024-01880-9},
  url = {https://doi.org/10.1007/S00146-024-01880-9},
  howpublished = {AI Soc.},
  annotation = {中文辅助译名：负责任的人工智能在实践中面临的挑战：范围审查和建议的行动},
  abstract = {Responsible AI (RAI) guidelines aim to ensure that AI systems respect democratic values. While a step in the right direction, they currently fail to impact practice. Our work discusses reasons for this lack of impact and clusters them into five areas: (1) the abstract nature of RAI guidelines, (2) the problem of selecting and reconciling values, (3) the difficulty of operationalising RAI success metrics, (4) the fragmentation of the AI pipeline, and (5) the lack of internal advocacy and accountability. Afterwards, we introduce a number of approaches to RAI from a range of disciplines, exploring their potential as solutions to the identified challenges. We anchor these solutions in practice through concrete examples, bridging the gap between the theoretical considerations of RAI and on-the-ground processes that currently shape how AI systems are built. Our work considers the socio-technical nature of RAI limitations and the resulting necessity of producing socio-technical solutions.},
}

