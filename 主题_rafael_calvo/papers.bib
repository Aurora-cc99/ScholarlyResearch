@misc{rafael_calvo_7e2d7cfb21eeca58,
  title = {The Utility of a Mental Health App in Apprentice Workers: A Pilot Study},
  author = {Mark Deady and Nick Glozier and Daniel Collins and Rochelle Einboden and Isobel Lavender and Alexis Wray and Aimée Gayed and Rafael A. Calvo and Helen M Christensen and Samuel B. Harvey and Isabella Choi},
