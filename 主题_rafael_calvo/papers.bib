  abstract = {In this work we investigate some technical questions related to the application of neural networks in document classification. First, we discuss the effects of different averaging protocols for the χ 2 statistic used to remove non-informative terms.},
}

@misc{rafael_calvo_96aac194503c1911,
  title = {Fast Dimensionality Reduction and Simple PCA},
  author = {Matthew Partridge and Rafael A. Calvo},
  year = {1998},
  doi = {10.1016/S1088-467X(98)00024-9},
  url = {https://doi.org/10.1016/S1088-467X(98)00024-9},
  howpublished = {Intell. Data Anal.},
  annotation = {中文辅助译名：快速降维和简单 PCA},
  abstract = {A fast and simple algorithm for approximately calculating the principal components (PCs) of a dataset and so reducing its dimensionality is described. This Simple Principal Components Analysis (SPCA) method was used for dimensionality reduction of two high-dimensional image databases, one of handwritten digits and one of handwritten Japanese characters. It was tested and compared with other techniques. On both databases SPCA shows a fast convergence rate compared with other methods and robustness to the reordering of the samples.},
}

@misc{rafael_calvo_548085926fd298ae,
  title = {Factor Semantics for Document Retrieval},
  author = {Rafael A. Calvo},
  year = {1998},
  doi = {10.1109/SBRN.1998.731028},
  url = {https://doi.org/10.1109/SBRN.1998.731028},
  howpublished = {SBRN},
  annotation = {中文辅助译名：文档检索的因子语义},
  abstract = {Principal component analysis is a useful technique for reducing the dimensionality of datasets, a paramount need in high dimensional term spaces. We study three neural networks with Hebbian-like learning that approximately produce the principal components of a document database. The explained variance of the solutions shows how much information the reduced space retains. In this database the first factor is strongly described by words that are usually included in a stop-word list, other factors show high loadings in content specific terms; this indicates that the networks are learning the semantic space. The retrieval performance on the reduced space is compared with other methods.},
}

@misc{rafael_calvo_c6536a7a1a2144e9,
  title = {Neural network prediction of solar activity},
  author = {Rafael A. Calvo and H. A. Ceccato and Rubén Darío Piacentini},
  year = {1995},
  doi = {10.1086/175661},
  url = {https://doi.org/10.1086/175661},
  howpublished = {The Astrophysical Journal},
  annotation = {中文辅助译名：太阳活动的神经网络预测},
  abstract = {The neural network technique is used to analyze the time series of solar activity, as measured through the relative Wolf number. First, the embedding dimension of the time series characteristic attractor is obtained. Second, after describing the design and training of the net, the performance of the present approach in forecasting yearly mean sunspot numbers is favorably compared to that of conventional statistical methods. Finally, predictions for the remaining part of the 22d and the whole 23d cycle are presented.},
}

@misc{rafael_calvo_6b55b721b63f48fc,
  title = {CONTROL NO LINEAL CON COMPENSACIÓN "FEEDFORWARD" EMPLEANDO REDES NEURONALES},
  author = {Basualdo, Marta Susana and Rafael A. Calvo and Hermenegildo Alejandro Ceccatto},
  year = {1994},
  url = {https://hdl.handle.net/20.500.12110/afa_v06_n01_p457},
  howpublished = {LA Referencia (Red Federada de Repositorios Institucionales de Publicaciones Científicas)},
  annotation = {中文辅助译名：控制无线性补偿“前馈”EMPLEANDO REDES 神经元},
  abstract = {En este trabajo se presenta una aplicación de redes neuronales al control de un sistema con distinto grado de no linealidad dependiendo del punto de operación en que se encuentra. Se utiliza una red neuronal del tipo "feedforward", entrenada para reconocer la correlación entre la variable manipulada y la controlada. El banco de datos necesario para el entrenamiento de la red se obtiene a partir de la simulación dinámica rigurosa del comportamiento del sistema. La generación, vía redes neuronales, de un modelo aproximado de la inversa del mismo permite la implementación de un compensador "feedforward" de no-linealidades. Este esquema de control, asociado a estructuras "feedback" convencionales, proporciona importantes ventajas en la performance de las respuestas dinámicas bajo control. El trabajo concluye con un ejemplo de aplicación en el cual se hace un estudio comparativo de los diversos tipos de controladores "feedback" convencionales que pueden asociarse al compensador "feedforward". Los resultados se obtienen por medio de la simulación digital dinámica del sistema conjunto planta-controlador},
}

@misc{rafael_calvo_8d77dbea2025733b,
  title = {Predicción de la actividad solar utilizando redes neuronales},
  author = {Rafael A. Calvo and H. A. Cecatto and Rubén Darío Piacentini},
  year = {1992},
  url = {http://sedici.unlp.edu.ar/handle/10915/145396},
  howpublished = {El Servicio de Difusión de la Creación Intelectual (National University of La Plata)},
  annotation = {中文辅助译名：神经元太阳能利用活动预测},
  abstract = {The neural network technique is used for describing the time series of solar activity a: measured by the relative Wolf number. The 1700-1991 data is described rather well reproducing the extrema and the oscillations with varying periods. So, it is possible to extrapolate the Wolf number up to the year 2003, in order to predict the mean annual variation and to determine the time position and amplitude of the next minimum and maximum. Results are compared with other empirical techniques.},
}
