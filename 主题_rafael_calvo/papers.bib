@misc{rafael_calvo_5986c302c26980e1,
  title = {Effectiveness of training workplace managers to understand and support the mental health needs of employees: a systematic review and meta-analysis},
  author = {Aimée Gayed and Josie S. Milligan-Saville and Jennifer Nicholas and Bridget T. Bryan and Anthony Daniel LaMontagne and Allison Joy Milner and Ira Madan and Rafael A. Calvo and Helen M Christensen and Arnstein Mykletun and Nick Glozier and Samuel B. Harvey},
