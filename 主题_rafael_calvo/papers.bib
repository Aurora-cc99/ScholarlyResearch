@misc{rafael_calvo_3045c0850b8712b3,
  title = {EQClinic: a platform for learning communication skills in clinical consultations},
  author = {Chunfeng Liu and Karen M. Scott and Renee Lim and Silas Taylor and Rafael A. Calvo},
  year = {2016},
  doi = {10.3402/meo.v21.31801},
