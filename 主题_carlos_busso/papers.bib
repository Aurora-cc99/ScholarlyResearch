@misc{carlos_busso_69f37968d5e168b9,
  title = {Joint Learning Using Mixture-of-Expert-Based Representation for Speech Enhancement and Robust Emotion Recognition},
  author = {Jing-Tong Tzeng and Carlos Busso and Chi-Chun Lee},
  year = {2026},
  doi = {10.1109/taslpro.2026.3688928},
  url = {https://doi.org/10.1109/taslpro.2026.3688928},
  howpublished = {IEEE Transactions on Audio Speech and Language Processing},
  annotation = {中文辅助译名：使用基于专家混合的表示进行联合学习以实现语音增强和强大的情绪识别},
  abstract = {Speech emotion recognition (SER) plays a critical role in building emotion-aware speech systems, but its performance degrades significantly under noisy conditions. Although speech enhancement (SE) can improve robustness, it often introduces artifacts that obscure emotional cues and adds computational overhead to the pipeline. Multi-task learning (MTL) offers an alternative by jointly optimizing SE and SER tasks. However, conventional shared-backbone models frequently suffer from gradient interference and representational conflicts between tasks. To address these challenges, we propose the Sparse Mixture-of-Experts Representation Integration Technique (Sparse MERIT), a flexible MTL framework that applies frame-wise expert routing over self-supervised speech representations. Sparse MERIT incorporates task-specific gating networks that dynamically select from a shared pool of experts for each frame, enabling parameter-efficient and task-adaptive representation learning. Experiments on the MSP-Podcast corpus show that Sparse MERIT consistently outperforms baseline models on both SER and SE tasks. Under the most challenging condition of -5 dB signal-to-noise ratio (SNR), Sparse MERIT improves SER F1-macro by an average of 12.0% over a baseline relying on a SE pre-processing strategy, and by 3.4% over a naive MTL baseline, with statistical significance on unseen noise conditions. For SE, Sparse MERIT improves segmental SNR (SSNR) by 28.2% over the SE pre-processing baseline and by },
}

@misc{carlos_busso_ad5a28352b46ccc4,
  title = {Embracing Multi-Label Speech Emotion Recognition Using the All-Inclusive Aggregation Rule},
  author = {Huang-Cheng Chou and Haibin Wu and Lucas Goncalves and Seong-Gyun Leem and Ali N. Salman and Carlos Busso and Hung-yi Lee and Chi-Chun Lee},
  year = {2026},
  doi = {10.5281/zenodo.21616027},
  url = {https://doi.org/10.5281/zenodo.21616027},
  howpublished = {Zenodo (CERN European Organization for Nuclear Research)},
  annotation = {中文辅助译名：使用全包聚合规则拥抱多标签语音情感识别},
  abstract = {Initial public release of the code accompanying: Huang-Cheng Chou et al., "Embracing Ambiguity and Subjectivity Using the All-Inclusive Aggregation Rule for Evaluating Multimodal Emotion Recognition Systems," IEEE Spoken Language Technology Workshop (SLT), 2024. What this release contains Implementation of the all-inclusive aggregation rule, which retains every annotator rating instead of collapsing them into a single consensus label Training and evaluation for multi-label speech emotion recognition on IEMOCAP, MSP-IMPROV, MSP-PODCAST, and BIIC-PODCAST Comparison against majority and plurality voting baselines Links Paper: https://doi.org/10.1109/SLT61566.2024.10832302},
}

@misc{carlos_busso_376da96c5950c2fc,
  title = {Recovering Performance in Speech Emotion Recognition from Discrete Tokens via Multi-Layer Fusion and Paralinguistic Feature Integration},
  author = {Abinay Reddy Naini and Esther Sun and Carlos Busso},
  year = {2026},
  doi = {10.48550/ARXIV.2601.17085},
  url = {https://doi.org/10.48550/ARXIV.2601.17085},
  howpublished = {CoRR},
  annotation = {中文辅助译名：通过多层融合和副语言特征集成恢复离散标记的语音情感识别性能},
  abstract = {Discrete speech tokens offer significant advantages for storage and language model integration, but their application in speech emotion recognition (SER) is limited by paralinguistic information loss during quantization. This paper presents a comprehensive investigation of discrete tokens for SER. Using a fine-tuned WavLM-Large model, we systematically quantify performance degradation across different layer configurations and k-means quantization granularities. To recover the information loss, we propose two key strategies: (1) attention-based multi-layer fusion to recapture complementary information from different layers, and (2) integration of openSMILE features to explicitly reintroduce paralinguistic cues. We also compare mainstream neural codec tokenizers (SpeechTokenizer, DAC, EnCodec) and analyze their behaviors when fused with acoustic features. Our findings demonstrate that through multi-layer fusion and acoustic feature integration, discrete tokens can close the performance gap with continuous representations in SER tasks.},
}

