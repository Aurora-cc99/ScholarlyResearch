@misc{carlos_busso_6d08fbda7a17ea38,
  title = {Comparative Reasoning: Making an Audio Language Model Better at Comparing Emotions},
  author = {Abinay Reddy Naini and Jaeyeon Kim and Chao-Han Huck Yang and Shinji Watanabe and Carlos Busso},
  year = {2026},
  doi = {10.21437/INTERSPEECH.2026-2935},
  url = {https://doi.org/10.21437/INTERSPEECH.2026-2935},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：比较推理：使音频语言模型更好地比较情感},
  abstract = {Large audio-language models (LALMs) can reason about audio, yet it remains unclear whether they can perform comparative judgments between two speech signals along emotional, environmental, linguistic, prosodic, and interpersonal dimensions.We study this question in the context of speech emotion recognition (SER), where the model determines which utterance exhibits higher arousal, valence, or dominance.We introduce a reasoning-guided ordinal SER framework that conditions an LALM on paired speech inputs.The model is trained using reasoning traces generated from both semantic audio descriptions and acoustic evidence derived from GeMAPS features, enabling interpretable comparative decisions.Beyond direct supervision, we also employ direct preference optimization to encourage stronger separation for emotional differences.Experiments show that the proposed framework improves preference prediction while requiring only 5% of the training data used by conventional ordinal SER systems.},
}

@misc{carlos_busso_b1d560dbb5ef058e,
  title = {Reasoning beyond Majority Vote: An Explainable Speechlm Framework for Speech Emotion Recognition},
  author = {Bo-Hao Su and Hui-Ying Shih and Jinchuan Tian and Jiatong Shi and Chi-Chun Lee and Carlos Busso and Shinji Watanabe},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464563},
  url = {https://doi.org/10.1109/icassp55912.2026.11464563},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：超越多数投票的推理：语音情感识别的可解释语音框架},
  abstract = {Speech Emotion Recognition (SER) is typically trained and evaluated on majority-voted labels, which simplifies benchmarking but masks subjectivity and provides little transparency into why predictions are made. This neglects valid minority annotations and limits interpretability. We propose an explainable Speech Language Model (SpeechLM) framework that frames SER as a generative reasoning task. Given an utterance, the model first produces a transcript, then outputs both an emotion label and a concise natural-language rationale grounded in lexical and acoustic cues. Rationales are generated by a reasoning-capable teacher LLM and used as intermediate supervision, combined with majority labels during fine-tuning. Unlike prior work primarily focused on boosting classification accuracy, we aim to enhance explainability while preserving competitive performance. To this end, we complement majority-label metrics with annotator-aware scoring that credits matches with any annotator label. On MSP-Podcast v1.12, our model maintains improvements over zero-shot SpeechLM baselines, and produces rationales that human evaluators find plausible and well grounded. This demonstrates that incorporating rationale supervision offers a practical path toward interpretable SER without sacrificing predictive quality.},
}

@misc{carlos_busso_64ca518c1a10b065,
  title = {Improving the Dependency on Fine-Tuning Data in Transfer Learning for Speech Emotion Recognition},
  author = {Ricardo García and Rodrigo Mahú and Carlos Busso and Néstor Becerra Yoma},
  year = {2026},
  doi = {10.48550/arxiv.2610.38050},
  url = {https://arxiv.org/abs/2610.38050},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：改善语音情感识别迁移学习中对微调数据的依赖},
  abstract = {Compensating for train-test mismatches in acoustic environments is important for deployable speech solutions. This paper proposes to reduce the amount of fine-tuning data needed in transfer learning to mitigate the train-test mismatch by using a compensation mechanism based on the feature maximum likelihood linear regression (fMLLR) algorithm. Our scheme incorporates an autoencoder to reduce the number of trainable parameters. Operating on the encoder latent space, our compensation strategy employs an affine linear transform that accounts for rotations and shifts in the feature space. We evaluate the proposed solution in a speech emotion recognition (SER) task within a realistic human-robot interaction scenario. The results show that the proposed architecture outperforms the original scheme without the compensation strategy. We observe a performance gain in the mean concordance correlation coefficient (CCC) of 16.8% using 12.9% of the training set, and 14.4% using 50% of the training set.},
}

