@misc{panorama_haibin_yan_321515342ba982d0,
  title = {KINMIX: A Data Augmentation Approach for Kinship Verification},
  author = {Chaohui Song and Haibin Yan},
  year = {2020},
  doi = {10.1109/icme46284.2020.9102891},
  url = {https://doi.org/10.1109/icme46284.2020.9102891},
  howpublished = {IEEE International Conference on Multimedia and Expo (ICME)},
  annotation = {中文辅助译名：KINMIX：一种用于亲属关系验证的数据增强方法},
  abstract = {In this paper, we propose a KinMix method to generate positive samples in the feature space for facial kinship verification. Unlike most existing data augmentation methods, we generate samples at the feature level instead of the original image level for data augmentation. Specifically, we use a pair of features with a kin relationship to construct a feature space instead of a single image, which aims to maintain the clustering results of features. We assume that a pair of kinship features lie in the same feature space, so that the generated feature remains the same kin relationship if it is sampled from the feature space. We use a linear sampling method to generate positive samples with the kin relationship. We evaluate our method on two widely used kinship datasets: KinFaceW-I and KinFaceW-II, and our experimental results are presented to show the effectiveness of the proposed approach.},
}

