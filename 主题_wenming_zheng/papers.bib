@misc{wenming_zheng_8ed2983eef4d5467,
  title = {Double sparse learning model for speech emotion recognition},
  author = {Yuan Zong and Wenming Zheng and Zhen Cui and Qiang Li},
  year = {2016},
  doi = {10.1049/el.2016.1211},
  url = {https://doi.org/10.1049/el.2016.1211},
