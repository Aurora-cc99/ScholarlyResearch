@misc{wenming_zheng_89b9f23bd16412f7,
  title = {Facial Expression Recognition Based on Sparse Locality Preserving Projection},
  author = {Jingjie Yan and Wenming Zheng and Minghai Xin and Jingwei Yan},
  year = {2014},
  doi = {10.1587/TRANSFUN.E97.A.1650},
  url = {https://doi.org/10.1587/TRANSFUN.E97.A.1650},
  howpublished = {IEICE Trans. Fundam. Electron. Commun. Comput. Sci.},
  annotation = {中文辅助译名：基于稀疏局部保持投影的人脸表情识别},
  abstract = {In this letter, a new sparse locality preserving projection (SLPP) algorithm is developed and applied to facial expression recognition. In comparison with the original locality preserving projection (LPP) algorithm, the presented SLPP algorithm is able to simultaneously find the intrinsic manifold of facial feature vectors and deal with facial feature selection. This is realized by the use of l1-norm regularization in the LPP objective function, which is directly formulated as a least squares regression pattern. We use two real facial expression databases (JAFFE and Ekman's POFA) to testify the proposed SLPP method and certain experiments show that the proposed SLPP approach respectively gains 77.60% and 82.29% on JAFFE and POFA database.},
}

@misc{wenming_zheng_4cfa2c7d81a2,
  title = {Multi-view facial expression recognition based on group sparse reduced-rank regression,},
  author = {Wenming Zheng},
  year = {2014},
  doi = {10.1109/TAFFC.2014.2304712},
  url = {https://aip.seu.edu.cn/wmzheng/main.htm},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：基于组稀疏降序回归的多视图面部表情识别，},
  abstract = {In this paper, a novel multi-view facial expression recognition method is presented. Different from most of the facial expression methods that use one view of facial feature vectors in the expression recognition, we synthesize multi-view facial feature vectors and combine them to this goal. In the facial feature extraction, we use the grids with multi-scale sizes to partition each facial image into a set of sub regions and carry out the feature extraction in each sub region. To deal with the prediction of expressions, we propose a novel group sparse reduced-rank regression (GSRRR) model to describe the relationship between the multi-view facial feature vectors and the corresponding expression class label vectors. The group sparsity of GSRRR enables us to automatically select the optimal sub regions of a face that contribute most to the expression recognition. To solve the optimization problem of GSRRR, we propose an efficient algorithm using inexact augmented Lagrangian multiplier (ALM) approach. Finally, we conduct extensive experiments on both BU-3DFE and Multi-PIE facial expression databases to evaluate the recognition performance of the proposed method. The experimental results confirm better recognition performance of the proposed method compared with the state of the art methods.},
}

