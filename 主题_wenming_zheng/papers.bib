@misc{wenming_zheng_651fa1d3bfb0,
  title = {UGPT: Uncertain Graph Prompt Tuning for Micro-expression Recognition},
  author = {J S Liu and Hengcan Shi and Feng Chen and Min Liu and Yue Wang and Wenming Zheng},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3708854},
  url = {https://doi.org/10.1109/TAFFC.2026.3708854},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：UGPT：微表情识别的不确定图提示调整},
  abstract = {Recently, micro-expression recognition (MER) has become a hot research topic in affective computing because of its wide applications, such as physiological assessment and medical diagnosis. According to the facial action coding theory, modeling the intrinsic relations among facial action units (AUs) of microexpressions (MEs) using a graph neural network (GNN) has been proven to improve MER performance effectively. However, existing AU-GNN-based MER frameworks are usually faced with two problems and thus damage the key AU feature learning of MEs. On the one hand, most previous AU-GNNs rely on a mass of precise training data, while AU annotations are usually hard to capture and tend to be trapped in overfitting. On the other hand, subtle and irregular AU movements will bring ambiguity to the modeling of AU-GNNs and result in model and data uncertainties. To address these problems, this paper proposes a novel uncertain graph prompt tuning (UGPT) method. Generally, UGPT consists of a three-stage 'pretraining'-'prompt tuning'- 'inference' pipeline. Firstly, to solve the limited training data problem, a large AU-GNN is trained on numerous AU samples to provide rich AU information for MER. Secondly, an uncertain graph prompt tuning mechanism is designed to fine-tune the large pretrained AU-GNN to the data-limited MER domain, in which lightweight probabilistic AU node and edge prompts are added to the pretrained AU-GNN separately, to learn the subtle and irregular AU motions in MEs, },
}

