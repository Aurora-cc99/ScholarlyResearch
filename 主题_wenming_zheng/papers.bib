@misc{wenming_zheng_924769d27b88,
  title = {PersonalityLLM: Fine-tuning Large Language Models for Personality Assessment from Asynchronous Video Interviews},
  author = {Tianyi Zhang and Dongsheng Hu and Xiu-xiu Zhan and Shan Liang and Yuan Zong and Yong Li and Chuang Liu and Wenming Zheng},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3684073},
  url = {https://aip.seu.edu.cn/wmzheng/main.htm},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：PersonalityLLM：微调大型语言模型，用于异步视频访谈的人格评估},
  abstract = {Asynchronous Video Interviews (AVIs) have gained traction in personality assessment due to their structured format and scalability. In the context of AVI, candidates respond to questions designed by psychologists to elicit specific personality traits. While Large Language Models (LLMs) possess strong semantic capabilities, most existing approaches apply them in a zero-shot manner without adapting to the content and structure of AVI questions. This can result in misalignment between candidate responses of designed questions and the corresponding personality traits. Thus fine-tuning LLMs to improve trait-specific reasoning becomes essential. However, the gap between the lack of sufficient annotated AVI data and the billions of parameters of LLMs makes fine-tuning challenging for AVI-based personality assessment. To address these limitations, we proposePersonalityLLM, a two-stage framework for fine-grained personality assessment. The first stage classifies the AVI responses of interviewees into a personality trait category. After that, a continuous score is predicted in the second stage based on the identified personality category and its empirical range. This structure reduces the learning burden by narrowing the prediction space and allowing each stage to focus on a simpler task. It improves the learning efficiency by reusing trait-level information to guide score estimation. Both stages are fine-tuned using Low-Rank Adaptation (LoRA) to further lower the parameter requirement},
}

@misc{wenming_zheng_06f530e26495be90,
  title = {SF-STACK: Streamlining RDMA for Heterogeneous Telecom Storage},
  author = {Jian Tang and Wenming Zheng and Xiaoliang Wang and Xiaoping Fan and Fangfang Yan and Luren Liu and Yi Liao and Xingling Han and Anran Xu},
  year = {2026},
  doi = {10.1109/INFOCOM59046.2026.11571387},
  url = {https://doi.org/10.1109/INFOCOM59046.2026.11571387},
  howpublished = {INFOCOM},
  annotation = {中文辅助译名：SF-STACK：简化异构电信存储的 RDMA},
  abstract = {Remote Direct Memory Access (RDMA) significantly enhances performance in distributed storage systems. However, deploying RDMA in heterogeneous environments remains a major challenge. Existing solutions from hyperscalers rely on full control over network configurations to achieve uniform deployments—conditions rarely met in telecom settings. Without infrastructure modifications, real-world deployments suffer from excessive connection overhead on resource-constrained servers, inconsistent path selection due to varying Linux bonding implementations, and degraded performance caused by congestion control sensitivity to diverse switch configurations. We present SF-STACK, a portable RDMA framework designed for fragmented storage clusters characterized by het-erogeneity and limited administrative control. SF-STACK introduces: (1) a thread-shared eXtended Reliable Connection (XRC) Queue Pair (QP) mechanism to reduce memory consumption; (2) a dual-IP routing strategy to ensure path consistency; and (3) a lightweight RTT-based congestion control algorithm that operates independently at the end hosts. Deployed across over 20 production clusters with diverse network architectures at a major telecom provider, SF-STACK achieves 70% memory consumption reduction and 50% bandwidth utilization improvement, requiring no hardware or network modifications.},
}

@misc{wenming_zheng_080b0cde1e50,
  title = {STMH: Speech-Text Modality Harmonization for Controllable Emotional Speech Synthesis With Mel-Derivative Augmented Conditional Adversarial Training},
  author = {Jian Zhou and Lei Wang and Cunhang Fan and Wenming Zheng and Hon Keung Kwan},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3702009},
  url = {https://aip.seu.edu.cn/wmzheng/main.htm},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：STMH：通过 Mel 导数增强条件对抗训练实现可控情感语音合成的语音文本模态协调},
  abstract = {Recent advancements in text-to-speech (TTS) have significantly improved emotional speech synthesis. However, many existing approaches capture only averaged emotional representations, thereby failing to reflect the inherently dynamic nature of speech prosody. To address these issues, we propose STMH, a novel framework designed to enhance the expressiveness and controllability of emotional speech synthesis. STMH integrates an emotion condition module, which captures global emotion representations and allows simultaneous control over both emotion category and intensity, as well as an emotion harmonization module to harmonize the condition mismatch between the training and inference. In addition, a mel-derivative augmented conditional adversarial framework is used to enhance emotional consistency and improve synthesis quality. Experimental results demonstrate that our approach surpasses state-of-the-art methods in terms of emotional expressiveness and controllability. Audio samples can be found at our demo pagehttps://wownaoh9.github.io/STMH/.},
}

