@misc{wenming_zheng_33e87b5cfa2e00da,
  title = {A Novel Transferable Sparse Regression Method for Cross-Database Facial Expression Recognition},
  author = {Wenjing Zhang and Peng Song and Wenming Zheng},
  year = {2022},
  doi = {10.1587/TRANSINF.2021EDL8062},
  url = {https://doi.org/10.1587/TRANSINF.2021EDL8062},
  howpublished = {IEICE Trans. Inf. Syst.},
  annotation = {中文辅助译名：一种新颖的跨数据库面部表情识别可迁移稀疏回归方法},
  abstract = {In this letter, we propose a novel transferable sparse regression (TSR) method, for cross-database facial expression recognition (FER). In TSR, we firstly present a novel regression function to regress the data into a latent representation space instead of a strict binary label space. To further alleviate the influence of outliers and overfitting, we impose a row sparsity constraint on the regression term. And a pairwise relation term is introduced to guide the feature transfer learning. Secondly, we design a global graph to transfer knowledge, which can well preserve the cross-database manifold structure. Moreover, we introduce a low-rank constraint on the graph regularization term to uncover additional structural information. Finally, several experiments are conducted on three popular facial expression databases, and the results validate that the proposed TSR method is superior to other non-deep and deep transfer learning methods.},
}

@misc{wenming_zheng_096063b4aa8efdcb,
  title = {A novel Adaptive Weighted Transfer Subspace Learning Method for Cross-Database Speech Emotion Recognition},
  author = {Keke Zhao and Peng Song and Shaokai Li and Wenjing Zhang and Wenming Zheng},
  year = {2022},
  doi = {10.1587/TRANSINF.2022EDL8021},
  url = {https://doi.org/10.1587/TRANSINF.2022EDL8021},
  howpublished = {IEICE Trans. Inf. Syst.},
  annotation = {中文辅助译名：一种新颖的跨数据库语音情感识别的自适应加权传输子空间学习方法},
  abstract = {In this letter, we present an adaptive weighted transfer subspace learning (AWTSL) method for cross-database speech emotion recognition (SER), which can efficiently eliminate the discrepancy between source and target databases. Specifically, on one hand, a subspace projection matrix is first learned to project the cross-database features into a common subspace. At the same time, each target sample can be represented by the source samples by using a sparse reconstruction matrix. On the other hand, we design an adaptive weighted matrix learning strategy, which can improve the reconstruction contribution of important features and eliminate the negative influence of redundant features. Finally, we conduct extensive experiments on four benchmark databases, and the experimental results demonstrate the efficacy of the proposed method.},
}

