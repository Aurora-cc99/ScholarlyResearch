@misc{wenming_zheng_fc7371b4f69c,
  title = {ChameleonVoice: A Contextual Prosody Perception Network for Emotional Voice Conversion},
  author = {Tianhua Qi and Cheng Lu and Yuan Zong and Wenming Zheng and Björn Wolfgang Schuller},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3735290},
  url = {https://doi.org/10.1109/TAFFC.2026.3735290},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：ChameleonVoice：用于情感语音转换的语境韵律感知网络},
  abstract = {Emotional voice conversion (EVC) has progressed rapidly, yet generating speech with natural prosody remains a core unsolved problem. The primary reason is that existing approaches rely heavily on static emotion categories, pseudo-labeled prosodic attributes, or reference-driven transfer mechanisms, which fail to model emotional prosody in a contextually aligned manner. Consequently, current systems often exhibit over-templated rhythmic patterns, misplaced emphasis, and limited perceptual naturalness. To address these challenges, we propose ChameleonVoice, a contextual prosody perception network that models emotional prosody as a temporally evolving process jointly shaped by linguistic structure and continuous affective state. The framework incorporates a contextual prosody perception mechanism that learns how rhythm, stress, and intonation unfold across the utterance based on semantic cues, and integrates valence-arousal emotion descriptors to capture intra-category variability and support fine-grained prosody modulation without requiring additional attributes or reference utterances. This design enables ChameleonVoice to adaptively reshape prosodic contours while preserving intelligibility and speaker identity. Comprehensive experiments across multiple emotions, speakers, and languages demonstrate that ChameleonVoice substantially improves prosodic naturalness, emotional expressiveness, and contextual coherence over state-of-the-art EVC systems.},
}

@misc{wenming_zheng_4cc43ad6b3373c8b,
  title = {EMMR: Emotion-Mediated Multimodal Reasoning for Personality Assessment in Asynchronous Video Interviews},
  author = {Dongsheng Hu and Tianyi Zhang and Chuang Liu and Yuan Zong and Yong Li and Wenming Zheng and XiuXiu Zhan},
  year = {2026},
  doi = {10.48550/ARXIV.2608.07512},
  url = {https://doi.org/10.48550/ARXIV.2608.07512},
  howpublished = {CoRR},
  annotation = {中文辅助译名：EMMR：异步视频面试中用于人格评估的情绪介导多模态推理},
  abstract = {Asynchronous Video Interviews (AVIs) have become increasingly popular for personality assessment. Recent large language models (LLMs) have shown potential for personality assessment from transcribed interview responses. However, text-centered methods may overlook non-verbal behavioral cues conveyed through visual and audio modalities, even though such cues are highly relevant to personality assessment. In particular, emotion-related cues provide important social and affective evidence for understanding candidates' behavior related to personality traits. Thus, we propose EMMR (Emotion-Mediated Multimodal Reasoning), a two-stage framework for MLLMs-based personality assessment for AVIs. EMMR extracts emotion-related cues from multimodal interview data and incorporates them into personality assessment through structured reasoning as auxiliary social and behavioral evidence. Experiments on two AVIs datasets, OPVA and AVI-6, show that EMMR improves MAE, MSE, and PCC compared with baselines. Further analysis indicates that semantic descriptions of emotion cues enhance personality assessment, while their quality affects personality assessment reliability. These results suggest that integrating emotion-related cues into multimodal reasoning is a promising direction for more interpretable MLLMs-based personality assessment in AVIs.},
}

