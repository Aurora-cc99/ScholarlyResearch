@misc{wenming_zheng_3c46bf6ebcdc,
  title = {MIR-SER: Leveraging Multilayer Intermediate Representations From ASR for Speech Emotion Recognition},
  author = {Jun Cao and Peng Song and Siqi Fu and Yifan Wang and Wenming Zheng},
  year = {2026},
  doi = {10.1109/tcss.2026.3743115},
  url = {https://doi.org/10.1109/tcss.2026.3743115},
  howpublished = {IEEE Transactions on Computational Social Systems},
  annotation = {中文辅助译名：MIR-SER：利用 ASR 的多层中间表示进行语音情感识别},
  abstract = {Recent advances in automatic speech recognition (ASR) have significantly benefited speech emotion recognition (SER) by providing powerful speech representations. However, existing ASR-based SER methods typically exploit representations from only a single hidden layer of Transformer-based ASR models, overlooking the complementary hierarchical information encoded across different layers. To address this limitation, we propose MIR-SER, a novel framework that effectively leverages multilayer representations from the ASR model. Specifically, multilayer features are first extracted from a pretrained ASR model to capture diverse semantic and acoustic cues. A bidirectional Mamba based feature enhancement module is then introduced to model temporal dependencies and improve feature discriminability. Furthermore, a joint optimization objective is designed to combine the losses computed from individual layer features and their fused representation, encouraging the complementary learning across layers. Extensive experiments on the IEMOCAP and RAVDESS datasets demonstrate that MIR-SER achieves competitive performance compared with state-of-the-art SER approaches, validating the effectiveness of leveraging multilayer ASR representations for emotion recognition.},
}

