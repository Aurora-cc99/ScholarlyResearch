@misc{wenming_zheng_641ec0b3e861472e,
  title = {Capacitive floating level shifter: Modeling and design},
  author = {Wenming Zheng and Chi‐Seng Lam and Sai‐Weng Sin and Yan Lü and Man‐Chung Wong and U Seng‐Pan and Rui Paulo Martins},
  year = {2015},
  doi = {10.1109/tencon.2015.7373013},
  url = {https://doi.org/10.1109/tencon.2015.7373013},
  howpublished = {IEEE Region 10 Conference (TENCON)},
  annotation = {中文辅助译名：电容式浮动电平转换器：建模和设计},
  abstract = {This paper introduces the failure operation principle of the capacitive floating level shifter, as well as its simplified circuit model. Based on the model, the mathematical equations for analyzing the level shifter's characteristics and its respective performances are also derived. Design criteria for the capacitive floating level shifter are proposed derived from the model and corresponding MATLAB simulation results. Furthermore, transistor-level simulations using 65-nm CMOS technology verify the deduced simplified circuit model and the proposed design criteria, following which, overdesign can be avoided to guarantee the proper operation of the floating capacitive level shifter, thus saving chip area and reducing cost.},
}

@misc{wei_long_zheng_c3791dd3f37a,
  title = {Emotion Recognition from Non‐Frontal Facial Images},
  author = {Wenming Zheng and Hao Tang and Thomas S. Huang},
  year = {2015},
  doi = {10.1002/9781118910566.ch8},
  url = {https://doi.org/10.1002/9781118910566.ch8},
  howpublished = {Emotion Recognition},
  annotation = {中文辅助译名：非正面面部图像的情绪识别},
  abstract = {This chapter reviews the recent advances of the current non-frontal facial emotion recognition methods, including the three-dimensional (3D) facial expression recognition and multiview facial expression recognition. It first gives a brief introduction of the facial emotion recognition methods. The chapter then briefly reviews the facial expression databases that are commonly used for the non-frontal facial emotion recognition researches. The method of using of 3D face model for face recognition has been proven to achieve better recognition results than 2D facial images due to its robustness to the poses, scales, and lighting variations. To perform the emotion classification, one may choose a classifier, for example, the support vector machine or Adaboost, and then classify each 3D face model into one of the basic emotion categories based on the geometric features.},
}

@misc{wenming_zheng_0c6a455c305a493c,
  title = {Speech Emotion Recognition Based on Sparse Transfer Learning Method},
  author = {Peng Song and Wenming Zheng and Ruiyu Liang},
  year = {2015},
  doi = {10.1587/TRANSINF.2015EDL8028},
  url = {https://doi.org/10.1587/TRANSINF.2015EDL8028},
  howpublished = {IEICE Trans. Inf. Syst.},
  annotation = {中文辅助译名：基于稀疏迁移学习方法的语音情感识别},
  abstract = {In traditional speech emotion recognition systems, when the training and testing utterances are obtained from different corpora, the recognition rates will decrease dramatically. To tackle this problem, in this letter, inspired from the recent developments of sparse coding and transfer learning, a novel sparse transfer learning method is presented for speech emotion recognition. Firstly, a sparse coding algorithm is employed to learn a robust sparse representation of emotional features. Then, a novel sparse transfer learning approach is presented, where the distance between the feature distributions of source and target datasets is considered and used to regularize the objective function of sparse coding. The experimental results demonstrate that, compared with the automatic recognition approach, the proposed method achieves promising improvements on recognition rates and significantly outperforms the classic dimension reduction based transfer learning approach.},
}

