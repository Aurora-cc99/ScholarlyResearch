@misc{panorama_d9615a213a1b_fb893d4ea1d5c639,
  title = {Overexpression of a bifunctional enzyme, CrtS, enhances astaxanthin synthesis through two pathways in Phaffia rhodozyma},
  author = {Shuang Chi and Yanfeng He and Jie Ren and Qian Su and Xingchao Liu and Zhi Chen and Mingan Wang and Ying Li and Jilun Li},
