@misc{panorama_d9615a213a1b_f5f19396c22e5197,
  title = {Nickel-catalyzed divergent Mizoroki–Heck reaction of 1,3-dienes},
  author = {Wei‐Song Zhang and Ding‐Wei Ji and Ying Li and Xiang‐Xin Zhang and Yong‐Kang Mei and Bingzhi Chen and Qing‐An Chen},
  year = {2023},
  doi = {10.1038/s41467-023-36237-1},
  url = {https://doi.org/10.1038/s41467-023-36237-1},
  howpublished = {Nature Communications},
  annotation = {中文辅助译名：镍催化 1,3-二烯的发散 Mizoroki-Heck 反应},
  abstract = {Abstract Developing efficient strategies to realize divergent arylation of dienes has been a long-standing synthetic challenge. Herein, a nickel catalyzed divergent Mizoroki–Heck reaction of 1,3-dienes has been demonstrated through the regulation of ligands and additives. In the presence of Mn/NEt 3 , the Mizoroki–Heck reaction of dienes delivers linear products under Ni(dppe)Cl 2 catalysis in high regio- and stereoselectivities. With the help of catalytic amount of organoboron and NaF, the use of bulky ligand IPr diverts the selectivity from linear products to branched products. Highly aryl-substituted compounds can be transformed from dispersive Mizoroki–Heck products programmatically. Preliminary experimental studies are carried out to elucidate the role of additives.},
}

