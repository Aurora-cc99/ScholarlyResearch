  author = {Aumber Abbas and Qian Zhang and Jamal Kazmi and Ying Li and Wenbo Li and Waqas Ahmad and Chao Zou and Qijie Liang},
  year = {2025},
  doi = {10.1021/acs.nanolett.5c03047},
  url = {https://doi.org/10.1021/acs.nanolett.5c03047},
  howpublished = {Nano Letters},
  annotation = {中文辅助译名：使用手性二维超晶格进行无标记 SERS 指纹识别手性识别},
  abstract = {Chiral discrimination is crucial in chiral synthesis, pharmaceuticals, and biology. Although surface-enhanced Raman scattering (SERS) provides highly sensitive molecule-specific vibrational data, existing approaches depend on indirect detection involving supplementary selectors, impeding clear and versatile chiral discrimination. Here, we report the direct label-free SERS sensing of different biologically prominent enantiomers with a two-dimensional transition metal dichalcogenide, such as TaS 2, based chiral superlattice to produce enantiospecific molecular fingerprints. The clear enantiodiscrimination between a model chiral pair of l - and d -glucose is achieved with a detection limit of 8 × 10 –10 M. In addition, noninvasive identification of l - and d -glucose in actual saliva samples and multiplex quantification of enantiomeric ratios with superior predictive accuracy are accomplished.},
}

@misc{panorama_d9615a213a1b_16c05d7e4821e390,
