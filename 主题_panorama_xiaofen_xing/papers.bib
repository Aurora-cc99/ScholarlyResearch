@misc{panorama_xiaofen_xing_6d6e61344101e5a2,
  title = {LSSED: a large-scale dataset and benchmark for speech emotion recognition},
  author = {Weiquan Fan and Xiangmin Xu and Xiaofen Xing and Weidong Chen and Dongyan Huang},
  year = {2021},
  doi = {10.48550/ARXIV.2102.01754},
  url = {https://doi.org/10.48550/ARXIV.2102.01754},
  howpublished = {CoRR},
  annotation = {中文辅助译名：LSSED：语音情感识别的大规模数据集和基准},
  abstract = {Speech emotion recognition is a vital contributor to the next generation of human-computer interaction (HCI). However, current existing small-scale databases have limited the development of related research. In this paper, we present LSSED, a challenging large-scale english speech emotion dataset, which has data collected from 820 subjects to simulate real- world distribution. In addition, we release some pre-trained models based on LSSED, which can not only promote the development of speech emotion recognition, but can also be transferred to related downstream tasks such as mental health analysis where data is extremely difficult to collect. Finally, our experiments show the necessity of large-scale datasets and the effectiveness of pre-trained models. The dateset will be released on https://github.com/tobefans/LSSED.},
}

@misc{panorama_xiaofen_xing_aad21fcf05d85b47,
  title = {Learning Spatio-Temporal Convolutional Network for Real-Time Object Tracking},
  author = {Hanzao Chen and Xiaofen Xing and Xiangmin Xu},
  year = {2020},
  doi = {10.1109/ICASSP40776.2020.9054757},
  url = {https://doi.org/10.1109/ICASSP40776.2020.9054757},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：学习时空卷积网络进行实时目标跟踪},
  abstract = {Siamese series of tracking networks have shown great potentials in achieving balanced accuracy and beyond real-time speed. However, most of existing siamese trackers only consider appearance features of first frame, and hardly benefit from interframe information. The lack of latest temporal transformation degrades the tracking performance during challenges such as deformation and partial occlusion. In this paper we focus on making using of the rich information in latest consecutive frames to improve the feature representation of initial template frame. Specifically, the latest frames after 3d convolution are used to generate an attention map, which is then point-wise multiplied by the features of first frame to obtain the updated template. With the attention map, the template can adaptively cope with the deformation and occlusion of the target. Since the first frame is always used as the basis of the template, there is no cumulative error when using the latest frames for attention. Due to the shared 2d convolution of all frames, the feature map results can be reused so that the added module has almost no time-consuming effects. This module is easily embedded into different siamese trackers. Through verification, the module has significantly improved tracking performance in different backbone situations.},
}

@misc{panorama_xiaofen_xing_65c24ea09d9578ab,
  title = {Adaptive Domain-Aware Representation Learning for Speech Emotion Recognition},
