@misc{panorama_xiaofen_xing_ba7902892db3bd19,
  title = {Profile-aided distillation framework for personalized sleep analysis with compact models using LLM-guided synthetic data},
  author = {Huimin Zheng and Xingxing Ai and Xueyan Liu and Xiaofen Xing and Xiangmin Xu},
  year = {2026},
