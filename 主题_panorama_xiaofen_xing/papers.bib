@misc{panorama_xiaofen_xing_cbc023e55abbf0ba,
  title = {SAKI-RAG: Mitigating Context Fragmentation in Long-Document RAG via Sentence-level Attention Knowledge Integration},
  author = {Wenyu Tao and Xiaofen Xing and Zeliang Li and Xiangmin Xu},
  year = {2025},
  doi = {10.18653/V1/2025.EMNLP-MAIN.63},
  url = {https://doi.org/10.18653/V1/2025.EMNLP-MAIN.63},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：SAKI-RAG：通过句子级注意力知识集成减轻长文档 RAG 中的上下文碎片},
  abstract = {Traditional Retrieval-Augmented Generation (RAG) frameworks often segment documents into larger chunks to preserve contextual coherence, inadvertently introducing redundant noise.Recent advanced RAG frameworks have shifted toward finer-grained chunking to improve precision.However, in long-document scenarios, such chunking methods lead to fragmented contexts, isolated chunk semantics, and broken inter-chunk relationships, making cross-paragraph retrieval particularly challenging.To address this challenge, maintaining granular chunks while recovering their intrinsic semantic connections, we propose SAKI-RAG (Sentence-level Attention Knowledge Integration Retrieval-Augmented Generation).Our framework introduces two core components: (1) the SentenceAttnLinker, which constructs a semantically enriched knowledge repository by modeling inter-sentence attention relationships, and (2) the Dual-Axis Retriever, which is designed to expand and filter the candidate chunks from the dual dimensions of semantic similarity and contextual relevance.Experimental results across four datasets-Dragonball, SQUAD, NFCORPUS, and SCI-DOCS demonstrate that SAKI-RAG achieves better recall and precision compared to other RAG frameworks in long-document retrieval scenarios, while also exhibiting higher information efficiency.},
}

@misc{panorama_xiaofen_xing_1037700bbdc6c365,
  title = {SemGesture: Synthesizing Semantically Enhanced and Coherent Gestures},
  author = {Pengsheng Liu and Zhaojie Chu and Xiaofen Xing and Xiangmin Xu},
  year = {2025},
  doi = {10.1145/3746027.3755753},
  url = {https://doi.org/10.1145/3746027.3755753},
  howpublished = {ACM Multimedia},
  annotation = {中文辅助译名：SemGesture：合成语义增强且连贯的手势},
  abstract = {Co-speech gestures are generally categorized into rhythmic and semantic gestures: rhythmic gestures align with speech rhythm and intonation, while semantic gestures convey specific meanings or emotions, enriching verbal communication. Most previous studies have focused on synthesizing rhythmic gestures, while recent methods have explored integrating large language models (LLMs) to retrieve semantic gestures and merge them with rhythmic ones. However, existing approaches primarily rely on textual context for retrieval, which may not fully capture the emotional and tonal nuances of speech, sometimes leading to semantic gestures that do not align with the speaker's intended expression. Additionally, common gesture fusion techniques often merge rhythmic and semantic gestures directly, causing discontinuity due to differences in their movement styles. To address these challenges, we propose SemGesture, a system designed to generate smooth and semantically accurate gestures. Our approach incorporates Context-aware Retrieval powered by a Large Audio Language Model, enabling precise retrieval of gestures that align with both the semantic and emotional aspects of speech. Additionally, the Gesture Fusion Module dynamically adjusts semantic gestures to harmonize with rhythmic gestures, ensuring seamless and coherent motion transitions. Extensive experiments demonstrate that SemGesture significantly outperforms existing methods in generating contextually accurate and visually natural ges},
}

