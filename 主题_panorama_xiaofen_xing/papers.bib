@misc{panorama_xiaofen_xing_73fd91b1ebd29623,
  title = {Patch-as-Decodable-Token: Towards Unified Multi-Modal Vision Tasks in MLLMs},
  author = {Yongyi Su and Haojie Zhang and Shijie Li and Nanqing Liu and Jingyi Liao and Junyi Pan and Yuan Liu and Xiaofen Xing and Chong Sun and Chen Li and Nancy F. Chen and Shuicheng Yan and Xulei Yang and Xun Xu},
  year = {2026},
  doi = {10.48550/ARXIV.2510.01954},
  url = {https://proceedings.iclr.cc/paper_files/paper/2026/hash/ef3644ca8787131263600445b0461383-Abstract-Conference.html},
  howpublished = {ICLR},
  annotation = {中文辅助译名：补丁作为可解码令牌：迈向 MLLM 中的统一多模态视觉任务},
  abstract = {Multimodal large language models (MLLMs) have advanced rapidly in recent years. However, existing approaches for vision tasks often rely on indirect representations, such as generating coordinates as text for detection, which limits performance and prevents dense prediction tasks like segmentation. To overcome these challenges, we introduce Patch-as-Decodable Token (PaDT), a unified paradigm that enables MLLMs to directly generate both textual and diverse visual outputs. Central to PaDT are Visual Reference Tokens (VRTs), derived from visual patch embeddings of query images and interleaved seamlessly with LLM's output textual tokens. A lightweight decoder then transforms LLM's outputs into detection, segmentation, and grounding predictions. Unlike prior methods, PaDT processes VRTs independently at each forward pass and dynamically expands the embedding table, thus improving localization and differentiation among similar objects. We further tailor a training strategy for PaDT by randomly selecting VRTs for supervised fine-tuning and introducing a robust per-token cross-entropy loss. Our empirical studies across four visual perception and understanding tasks suggest PaDT consistently achieving state-of-the-art performance, even compared with significantly larger MLLM models. The code is available at https://github.com/Gorilla-Lab-SCUT/PaDT.},
}

@misc{panorama_xiaofen_xing_8530c3ddb45a12ef,
  title = {Can Large Language Models Extend Their Agentic Capabilities to Goal Pursuit in Open-Ended Multi-Turn Interaction?},
  author = {Mingyu Chen and Jingkai Lin and Xiaofen Xing and Liankai Huang and Ruiqi Xiong and Xiangmin Xu},
  year = {2026},
  doi = {10.48550/arxiv.2611.01552},
  url = {https://arxiv.org/abs/2611.01552},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：大型语言模型能否将其代理能力扩展到开放式多轮交互中的目标追求？},
  abstract = {Goal pursuit in open-ended dialogue requires agents to adapt their actions to interaction feedback across successive exchanges. We investigate whether agentic capabilities developed for multi-step tool use carry over to dialogue organized through the model's native tool interface, and how this changes interaction behavior. We define Tool-Mediated Interaction (TMI) as a training-free protocol that represents dialogue actions as tool calls and counterpart responses as tool results, maintaining a continuous reasoning-action-observation loop with retained reasoning and interaction history. We evaluate TMI across social interaction, emotional support, persuasion, and price negotiation using two models and 15,678 main-experiment episodes. Across both models, TMI improves social goal attainment, emotional-support preference, donation amounts, and buyer negotiation margins over conversational baselines with and without thinking. A Qwen ablation further shows that TMI outperforms ordinary conversation with retained reasoning on all four primary outcomes. Behavioral analyses associate the improvements with task-specific patterns in initial proposals and responses to interaction feedback. Alongside these gains, TMI reduces mean reasoning tokens per decision by 42.0-81.5% relative to the thinking baseline and lowers mean cross-turn phrase reuse across all eight model-environment pairs. These findings show that interaction organization shapes both goal attainment and reasoning across dial},
}

@misc{panorama_xiaofen_xing_2a4f93a5f1fbcf8d,
  title = {A Noncontact Capacitive ECG Smart Mattress System Using Sensor Arrays and Adaptive Switching Strategy for Unconstrained In-Bed Sleep},
  author = {Baoliang Feng and Lin Shu and Xiaofen Xing and Jun Guo and Kaikai Wang and Junjie Pan and Zeyu Yang and Haoqiang Hua and Pan Hui and Xiangmin Xu},
  year = {2026},
  doi = {10.1109/JIOT.2026.3721121},
  url = {https://doi.org/10.1109/JIOT.2026.3721121},
  howpublished = {IEEE Internet Things J.},
  annotation = {中文辅助译名：非接触式电容式心电图智能床垫系统，采用传感器阵列和自适应切换策略，实现不受约束的床上睡眠},
  abstract = {—Capacitive electrocardiogram (cECG) enables unobtrusive cardiac monitoring during sleep without direct skin contact, but reliable acquisition remains challenging because electrode–body coupling changes with posture. This article presents an Internet of Things (IoT)-enabled smart mattress system for posture-adaptive cECG monitoring during unconstrained sleep. The system integrates a mattress-embedded$3\times 4$integrated sensor electrode array (ISEA) with independent cECG and capacitive lying posture (cLP) subarrays, and an edge controller that executes an adaptive switching strategy (ASS) for real-time posture recognition and dynamic electrode pair reconfiguration. Using the inferred coupling distribution and standard-lead-inspired dorsal mapping, the system automatically selects effective electrode pairs for continuous in-bed monitoring. The system was evaluated through hardware benchmarking and two separate subject protocols: ASS functional testing and a 90-min siesta experiment, each involving ten healthy subjects, with polysomnography (PSG)-recorded electrocardiogram (ECG) used as the synchronized reference. The hardware achieved a passbandgain of 60 dB and a phase offset below 0.018 rad in the cECG-related frequency band. The ASS achieved posture recognition accuracies of 93.8%–98.8%, executed the lying posture recognition algorithm (LPRA) within 9 ms with microcontroller utilization below 5.2%, and selected target electrode pairs that produced stable cECG signals with },
}

