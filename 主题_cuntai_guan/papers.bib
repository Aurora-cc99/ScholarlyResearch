@misc{cuntai_guan_2c016cf8aa2d8533,
  title = {Design Considerations for Long Term Non-invasive Brain Computer Interface Training With Tetraplegic CYBATHLON Pilot},
  author = {Neethu Robinson and Tushar Singh Chouhan and Ernest Mihelj and Paulina Kratka and Frédéric Debraine and Nicole Wenderoth and Cuntai Guan and Rea Lehner},
  year = {2021},
  doi = {10.3389/fnhum.2021.648275},
  url = {https://doi.org/10.3389/fnhum.2021.648275},
