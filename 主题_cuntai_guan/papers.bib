@misc{panorama_02b2025de2e8_9048df12be4224e3,
  title = {Hierarchical Vision-Language Interaction for Facial Action Unit Detection},
  author = {Yong Li and Yi Ren and Yizhe Zhang and Wenhua Zhang and Tianyi Zhang and Muyun Jiang and Guo-Sen Xie and Cuntai Guan},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3665903},
