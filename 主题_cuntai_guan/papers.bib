  annotation = {中文辅助译名：噪声语音识别的多模型方法},
  abstract = {A multi-model approach for noisy speech recognition is proposed. This approach comprises an SVD-based preprocessing front-end, and a multi-model HMM recognition structure. It can provide a high recognition rate over a large range of SNRs for speech recognition in wide-band additive noise.},
}

