@misc{cuntai_guan_d2534c14cdaff761,
  title = {Multi-model approach for noisy speech recognition},
  author = {Cuntai Guan and S.H. Leung and Wing-Hong Lau},
  year = {1998},
  doi = {10.1049/el:19980042},
