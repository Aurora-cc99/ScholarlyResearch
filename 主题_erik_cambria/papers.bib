@misc{erik_cambria_64562c0f93f54f39,
  title = {TEMPO: Training-time Equilibration of Modalities for Per-sample Optimization in Multimodal Sentiment},
  author = {Yi Zhao and Erik Cambria and E Xiaosong and Xianxun Zhu},
  year = {2026},
  doi = {10.1109/taffc.2026.3657064},
  url = {https://doi.org/10.1109/taffc.2026.3657064},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：TEMPO：多模态情感中每样本优化模态的训练时间平衡},
  abstract = {Multimodal sentiment models often become over-reliant on the “easiest” modality (typically text), leading to three coupled sub-problems: (i)representation-level dominance, where weaker modalities contribute little to the fused representation; (ii)optimization-level dominance, where the strongest modality drives most gradient updates and suppresses learning in others; and (iii)robustness degradation, where audio or vision fail under noise or missing inputs at test time. We present TEMPO, a plug-and-play training framework that mitigates these issues by rebalancing learning pressure across modalities while leaving inference unchanged. For each mini-batch, TEMPO estimates relative modality strength and applies two synchronized, training-only controls: selective forward attenuation and backward gradient equilibration. On IEMOCAP and MELD, TEMPO improves accuracy and weighted F1 over strong multimodal baselines, increases the standalone usefulness of weaker modalities, and offers higher robustness under missing- or corrupted-modality stress. Across three benchmarks, TEMPO improves accuracy by 3.2–6.7% and reduces calibration error by 18–34%, demonstrating consistent gains in both performance and reliability with negligible computational overhead.},
}

@misc{erik_cambria_42ce305eea575b05,
  title = {TextNCA: Neural Cellular Automata for Language Modeling via Hierarchical Local Attention},
  author = {Zhengkui Wang and Rajiv Ratn Shah and Avinash Anand and Kritarth Prasad and Sushane Dulloo and Timothy Liu and Avni Mittal and Dikshant Kukreja and Ashutosh Kumar and Erik Cambria},
  year = {2026},
  doi = {10.48550/ARXIV.2608.02050},
  url = {https://doi.org/10.48550/ARXIV.2608.02050},
  howpublished = {CoRR},
  annotation = {中文辅助译名：TextNCA：通过分层局部注意力进行语言建模的神经细胞自动机},
  abstract = {Neural Cellular Automata (NCAs) generate complex spatial patterns in vision by repeatedly applying a shared local rule to persistent cell states, combining local perception, weightshared iteration, and gated in-place updates.We test this principle in language modelling with TEXTNCA, a 1D causal model in which token positions act as cells, windowed attention provides local perception, and a GRUstyle gate updates their states.Its hierarchical variant cascades increasingly wide attention windows w ∈ 8, 32, 128 and reuses each stage's parameters for T s iterations.We train roughly 30M-parameter models on SlimPajama for 60k steps and evaluate on WikiText-103.TextNCA trails a similarly sized Transformer-6L (60.3 versus 52.8 best-run PPL), so we study it as an analytical probe rather than a performance alternative.Reordering or flattening the windows raises PPL by 16.7-70.8,whereas a non-iterating sliding-window Transformer preserving the staged order performs comparably across three seeds.These results identify the narrow-to-wide schedule as the dominant factor and provide no reliable evidence that iterated weight sharing improves perplexity at this scale.Intermediate-state analyses support a preparethen-decode account in which early stages reorganise representations and the final wide stage performs most next-token loss reduction.},
}

@misc{erik_cambria_eae3455851d39f12,
  title = {VIAS: Value-Isolating Activation Steering for Multi-Value Alignment and Compliance for Organisations},
  author = {Avni Mittal and Avinash Anand and Dikshant Kukreja and Erik Cambria and Rajiv Ratn Shah and Sandipan Dandapat},
  year = {2026},
  doi = {10.48550/arxiv.2611.03518},
  url = {https://arxiv.org/abs/2611.03518},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：VIAS：价值隔离激活指导，实现组织的多价值调整和合规性},
  abstract = {Organisations increasingly deploy large language model agents that must follow organisational values. We check whether activation steering, which adds vectors to a model's internal activations during generation without changing its weights, can improve compliance beyond prompting alone. Since most scenarios involve several values at once, we focus on multi-value steering. A simple way to build these vectors is to contrast responses that follow all values relevant to a scenario with responses that violate them. However, this gives nearly identical vectors for different values: they capture a general compliance signal rather than individual values, which limits their use when combining several values. We propose Value-Isolating Activation Steering (VIAS), which contrasts responses to the same scenario under two prompts, one listing all relevant values and one omitting a single target value. We keep a pair only if the target value changes from compliant to non-compliant and both responses still meet a minimum compliance level on the other values. We evaluate VIAS on PROTECT, a workplace compliance dataset where each scenario is tagged with relevant values from a 21-value taxonomy. VIAS reduces overlap between value vectors, making them better suited for multi-value steering, although this alone does not lead to independent control over each value. Combined with prompting, VIAS complies with every tagged value on 69.6% of scenarios for Qwen2.5-7B, 75.2% for Mistral-7B, and 72.6% },
}

