  annotation = {中文辅助译名：简介},
  abstract = {This introductory chapter of Computational Paralinguistics: Emotion, Affect and Personality in Speech and Language Processing begins with a definition of ‘computational paralinguistics’, and sketches the history of the term and the subject area. In this book the authors adhere to a shallower definition of the terms ‘language’ and ‘speech’, based on their use in speech and language technology. The book focuses on analysis, basically excluding generation and synthesis. The title of the book mentions three exemplary phenomena such as personality, emotion, and affect. The chapter sketches all the aspects of ethical concern — generation, synthesis, multimodality, usability, applications, and ethical considerations. Finally it provides an overview of the contents discussed in other chapters of the book.},
}

@misc{erik_cambria_107dc643cf3095e5,
  title = {Weakly supervised semantic segmentation with superpixel embedding},
  author = {Frank Z. Xing and Yang Xu and Erik Cambria and Win-Bin Huang},
  year = {2016},
  doi = {10.1109/ICIP.2016.7532562},
  url = {https://doi.org/10.1109/ICIP.2016.7532562},
  howpublished = {ICIP},
  annotation = {中文辅助译名：具有超像素嵌入的弱监督语义分割},
  abstract = {In this paper, we propose to use contexts of superpixels as a prior to improve semantic segmentation by the CRF framework. A graphical model is constructed on over-segmented images. Our main contribution is to take the concept of “superpixel embedding” into consideration, which is formalized as a potential item for optimizing the energy of the whole graph. We also introduce two ways of calculating this embedding potential. Experiments on several popular datasets, e.g., MRSC-21 and PASCAL VOC, illustrate that our approach enhances the performance of a previously proposed segmentation model without embedding. The accuracy results are comparable to some fully supervised methods.},
}

