@misc{erik_cambria_a08f65498afd087e,
  title = {Code and trained models for an external validation of saliency maps as error flags for chest radiograph classifiers},
  author = {Aashish Chapagai and Angad Singh Gurtatta and Erik Cambria},
  year = {2026},
  doi = {10.5281/zenodo.23618484},
  url = {https://doi.org/10.5281/zenodo.23618484},
