@misc{erik_cambria_4e5902d7d6308aa8,
  title = {SEA-LION: Southeast Asian Languages in One Network},
  author = {Raymond Ng and Brandon Ong and Thanh Ngan Nguyen and Peerat Limkonchotiwat and Adithya Venkatadri Hulagadri and Esther Choa and Nicholas Cheng and Wei Qi Leong and Xianbin Yong and Wai Yi Leong and Yosephine Susanto and Leslie Teo and Kok Wai Teng and Yeo Yeow Tong and Sajeban Antonyrex and Choon Meng Tan and Jann Railey Montalan and Adwin Chan and Bing Jie Darius Liu and Bryan Siow and David Ong Tat-Wee and William-Chandra Tjhi and Ren Lee and Zhi Hao Ong and Hamsawardhini Rengarajan and Ngee Chia Tai and Wei Yi Teo and Yuli Huang and Jian Gang Ngui and Erik Cambria},
  year = {2025},
  doi = {10.18653/V1/2025.IJCNLP-LONG.30},
  url = {https://doi.org/10.18653/V1/2025.IJCNLP-LONG.30},
  howpublished = {IJCNLP-AACL (long papers)},
  annotation = {中文辅助译名：SEA-LION：东南亚语言同一个网络},
  abstract = {Recently, Large Language Models (LLMs) have dominated much of the artificial intelligence scene with their ability to process and generate natural languages. However, the majority of LLM research and development remains English-centric, leaving low-resource languages such as those in the Southeast Asian (SEA) region under-represented. To address this representation gap, we introduce Llama-SEA-LION-v3-8B-IT and Gemma-SEA-LION-v3-9B-IT, two cutting-edge multilingual LLMs designed for SEA languages. The SEA-LION family of LLMs supports 11 SEA languages, namely English, Chinese, Indonesian, Vietnamese, Malay, Thai, Burmese, Lao, Filipino, Tamil, and Khmer. Our work leverages large-scale multilingual continued pre-training with a comprehensive post-training regime involving multiple stages of instruction fine-tuning, alignment, and model merging. Evaluation results on multilingual benchmarks indicate that our models achieve state-of-the-art performance across LLMs supporting SEA languages. We open-source the models to benefit the wider SEA community.},
}

@misc{xu_ruifeng_15c9f80ad1965bc7,
  title = {SupportPlay: A Multi-Agent Role-Playing System for Personalized and Sustained Multimodal Emotional Support Conversation},
  author = {Geng Tu and Bingbing Wang and Erik Cambria and Wenjie Li and Ruifeng Xu},
  year = {2025},
  doi = {10.1145/3701716.3715200},
  url = {https://doi.org/10.1145/3701716.3715200},
  howpublished = {WWW (Companion Volume)},
  annotation = {中文辅助译名：SupportPlay：用于个性化和持续的多模式情感支持对话的多智能体角色扮演系统},
  abstract = {In this demo, we present SupportPlay, a multi-agent role-playing system for emotional support conversation (ESC) that addresses the limitations of existing methods in providing personalized, sustained, and multimodal support.SupportPlay generates potential seeker profiles from existing ESC datasets and employs GPT-powered agents to play various seeker roles, enabling the supporter to learn personalized memories for each seeker.Subsequently, the supporter can induce general memory from these memories for real user interactions while learning the user's personalized memory in a similar manner.Through continuous memory management-including retrieval, storage, reflection, and forgetting-SupportPlay delivers tailored emotional support across interactions.By integrating text, speech, and video, SupportPlay creates immersive emotional support experiences.},
}

@misc{erik_cambria_7f3df4f74dde1334,
  title = {Multi-Layered Prompting of Small Language Models for Twitter Sentiment Analysis},
  author = {Ranjan Satapathy and Kenneth Kwok and Sidney Suen and Erik Cambria},
  year = {2025},
  doi = {10.1109/ICDMW69685.2025.00255},
  url = {https://doi.org/10.1109/ICDMW69685.2025.00255},
  howpublished = {ICDM (Workshops)},
  annotation = {中文辅助译名：Twitter情感分析小语言模型的多层提示},
  abstract = {This study examines the capacity of Small Language Models (SLMs) for complex sentiment analysis tasks through a novel multi-layered prompting strategy. The approach guides model reasoning across four layers: lexical, contextual, pragmatic, and cultural. The SLMs are also prompted to generate structured rationales based on these layers. 6 SLMs from three model families (DeepSeek R1, LLaMA and Qwen) are evaluated on a curated dataset testing sentiment polarity, subjectivity, and irony detection. High-capacity LLM judges (Claude and GPT4o) evaluate the quality of the structured rationales generated by the baseline using a structured. Comparative analysis reveal mixed effectiveness of the multi-layered prompting approach: while certain models, such as the Qwen family, show improved performance and rank the highest in explanation quality, other SLM families demonstrate limited benefits or even degraded performance. Furthermore, while most Small Language Models (SLMs) underperform across sentiment tasks relative to traditional machine learning baselines, the Qwen family stands out, achieving comparable performance and notably higher irony detection rate (0.446 for Qwen 38 B compared to 0.277). These findings underscore the model-dependent nature of prompting strategies and highlight both the potential and current limitations of SLMs in interpreting culturally embedded sentiment.},
}

