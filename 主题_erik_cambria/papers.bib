@misc{erik_cambria_ddbe0ac52bdabdc2,
  title = {The data heat island effect: quantifying the impact of AI data centers in a warming world},
  author = {Weisi Lin and Yihao Zhu and Edoardo Ragusa and Benjamin P. Horton and Chi Yan Tso and Luca Dal Zilio and Andrea Marinoni and Erik Cambria and Mauro Dalla Mura and Jocelyn Chanussot},
  year = {2026},
  doi = {10.48550/ARXIV.2603.20897},
  url = {https://doi.org/10.48550/ARXIV.2603.20897},
  howpublished = {CoRR},
  annotation = {中文辅助译名：数据热岛效应：量化人工智能数据中心在变暖世界中的影响},
  abstract = {The strong and continuous increase of AI-based services leads to the steady proliferation of AI data centres worldwide with the unavoidable escalation of their power consumption. It is unknown how this energy demand for computational purposes will impact the surrounding environment. Here, we focus our attention on the heat dissipation of AI hyperscalers. Taking advantage of land surface temperature measurements acquired by remote sensing platforms over the last decades, we are able to obtain a robust assessment of the temperature increase recorded in the areas surrounding AI data centres globally. We estimate that the land surface temperature increases by 2°C on average after the start of operations of an AI data centre, inducing local microclimate zones, which we call the data heat island effect. We assess the impact on the communities, quantifying that more than 340 million people could be affected by this temperature increase. Our results show that the data heat island effect could have a remarkable influence on communities and regional welfare in the future, hence becoming part of the conversation around environmentally sustainable AI worldwide.},
}

@misc{erik_cambria_35098a6f82642b28,
  title = {Exploring the Commercial Trajectories of LLMs: Business Models and Advertising Perspectives},
  author = {Grzegorz Chodak and Wiktoria Mieleszczenko-Kowszewicz and Przemyslaw Kazienko and Erik Cambria},
  year = {2026},
  doi = {10.1109/MIS.2025.3636023},
  url = {https://doi.org/10.1109/MIS.2025.3636023},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：探索大语言模型的商业轨迹：商业模式和广告视角},
  abstract = {As large language models (LLMs) gain millions of individual and business users, their rapid adoption has raised critical questions about economic sustainability and commercialization strategies. This paper examines monetization strategies for LLMs, providing a structured overview of existing and emerging revenue models, including subscription and pay-per-use access plans. Particular emphasis is placed on the potential of advertising-based models that leverage the unique strengths of LLMs. The paper also presents eight potential scenarios for the commercial future of LLMs, ranging from advertising-based, hybrid, and public sector funding models to the dominance of open source solutions and blockchain-based microtransactions. Drawing parallels to the evolution of search engine monetization, the authors argue that hybrid approaches (e.g., combining advertising revenue with other sources) may represent the most viable future for funding LLMs. This work contributes to a deeper understanding of the commercial forces shaping the next phase of generative artificial intelligence deployment.},
}

@misc{panorama_xiaochu_zhang_18458bd7930ac9c0,
  title = {The Commit-Abstain Circuit: Why Language Models Hallucinate Instead of Abstaining},
  author = {Vy Nguyen and Ziqi Xu and Jeffrey Chan and Estrid He and Feng Xia and Renqiang Luo and Erik Cambria and Xiuzhen Jenny Zhang},
  year = {2026},
  doi = {10.48550/ARXIV.2609.32964},
  url = {https://doi.org/10.48550/ARXIV.2609.32964},
  howpublished = {CoRR},
  annotation = {中文辅助译名：提交-弃权循环：为什么语言模型会产生幻觉而不是弃权},
  abstract = {Language models (LMs) often hallucinate by committing to confident answers rather than abstaining, even when they do not have enough information to answer reliably. A large body of existing work mitigates hallucination through detection or abstention mechanisms, but leaves open how models internally arrive at the decision to commit or abstain in the first place. We study this decision through mechanistic analysis, framing hallucination as unsupported commitment: the model commits despite exhibiting signals of unanswerability. Using causal gating, we identify a Commit-Abstain Circuit (CAC), a sparse, causally localised subset of attention heads and MLP sublayers underlying this decision. Across ten LMs (3B-14B) from five families and three benchmarks, the CAC exhibits a recurring accumulate-yet-undercorrect pattern: commitment-promoting components build up commitment in earlier layers, while abstention-promoting components act later as corrective signals that are often insufficient to overturn the accumulated commitment. Building on this finding, a lightweight policy trained on CAC activations improves decision accuracy by 12.2 points over the model's intrinsic commit-abstain margin, reduces false abstentions by 2.5 times, transfers to unseen benchmarks, and extends to larger models (27B-35B). The CAC is both diagnostic, clarifying how models overcommit, and practical, enabling improved abstention decisions.},
}

@misc{xu_ruifeng_c5f0a96537e218e8,
  title = {Benchmarking Explainable Argumentation Dialogue via Freeman's Theory},
  author = {Yang Sun and Geng Tu and Wenpeng Lu and Min Yang and Erik Cambria and Ruifeng Xu},
  year = {2026},
  doi = {10.1109/MIS.2025.3649244},
  url = {https://doi.org/10.1109/MIS.2025.3649244},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：通过弗里曼理论对可解释的论证对话进行基准测试},
  abstract = {Argumentative dialogue involves structured exchanges of claims and supporting evidence, yet progress in building effective dialogue systems is limited by the scarcity of high-quality datasets. To address this, we introduce CMV-AD, a baseline dataset derived from the ChangeMyView corpus, designed for modeling structured argumentative interactions. We further propose FTCoT, a Freeman’s Theory-based Chain-of-Thought framework that enhances interpretability and reasoning in dialogue generation. FTCoT represents each dialogue turn with a structured quadruple: Dialogue Summary, User Argument, Assistant Argument, and Response Reasoning. We construct FTCoT using large language models (LLMs), leveraging their capabilities in reasoning and data annotation. Extensive automatic and human evaluations demonstrate the effectiveness of FTCoT in improving both the interpretability and quality of generated responses.},
}

@misc{erik_cambria_926dcc39a7509e7f,
  title = {Learning Structured Emotional Dynamics in Latent Space via Trajectory Modeling and Controlled Transitions},
  author = {Agampreet Saini and Bayan Abusalameh and Rahul Kumar Singh and Erik Cambria},
  year = {2026},
  doi = {10.18653/2026.findings-emnlp.1565},
  url = {https://doi.org/10.18653/2026.findings-emnlp.1565},
  howpublished = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  annotation = {中文辅助译名：通过轨迹建模和受控转换学习潜在空间中的结构化情绪动力学},
  abstract = {Emotion understanding from text has predominantly been approached through discrete classification.Yet perspectives in psychology and neuroscience suggest affective states may also be continuous, context-dependent, and temporally structured.Building on this, we investigate emotion representations as latent dynamical trajectories within transformer embedding spaces.Using GoEmotions and MELD across four transformer architectures, we analyze the geometric organization and temporal evolution of learned emotional states.We find that latent trajectories exhibit temporal persistence and structured transition dynamics, while prediction error increases during emotion shifts, signaling expectation violation.We additionally introduce trajectory-level latent interventions for controlled emotional transitions through directional operations in representation space.Finally, manifold capacity analysis reveals partially aligned and variably separable emotional manifolds, suggesting shared geometric organization across affective representations.},
}

