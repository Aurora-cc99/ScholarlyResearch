@misc{erik_cambria_3a7d0d52dbaa39b2,
  title = {Phonetic-Based Microtext Normalization for Twitter Sentiment Analysis},
  author = {Ranjan Satapathy and Claudia Guerreiro and Iti Chaturvedi and Erik Cambria},
  year = {2017},
  doi = {10.1109/ICDMW.2017.59},
  url = {https://doi.org/10.1109/ICDMW.2017.59},
  howpublished = {ICDM Workshops},
  annotation = {中文辅助译名：用于 Twitter 情感分析的基于语音的缩微文本规范化},
  abstract = {The proliferation of Web 2.0 technologies and the increasing use of computer-mediated communication resulted in a new form of written text, termed microtext. This poses new challenges to natural language processing tools which are usually designed for well-written text. This paper proposes a phonetic-based framework for normalizing microtext to plain English and, hence, improve the classification accuracy of sentiment analysis. Results demonstrated that there is a high (>0.8) similarity index between tweets normalized by our model and tweets normalized by human annotators in 85.31% of cases, and that there is an accuracy increase of >4% in terms of polarity detection after normalization.},
}

@misc{louis_philippe_morency_6848b5cd789bb487,
  title = {Tensor Fusion Network for Multimodal Sentiment Analysis},
  author = {Amir Zadeh and Soujanya Poria and Minghai Chen and Louis-Philippe Morency and Erik Cambria},
  year = {2017},
  doi = {10.18653/V1/D17-1115},
  url = {https://doi.org/10.18653/V1/D17-1115},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：用于多模态情感分析的张量融合网络},
  abstract = {Multimodal sentiment analysis is an increasingly popular research area, which extends the conventional language-based definition of sentiment analysis to a multimodal setup where other relevant modalities accompany language.In this paper, we pose the problem of multimodal sentiment analysis as modeling intra-modality and inter-modality dynamics.We introduce a novel model, termed Tensor Fusion Network, which learns both such dynamics end-to-end.The proposed approach is tailored for the volatile nature of spoken language in online videos as well as accompanying gestures and voice.In the experiments, our model outperforms state-ofthe-art approaches for both multimodal and unimodal sentiment analysis.},
}

@misc{erik_cambria_101b0de7267c9df4,
  title = {Adaptive two-stage feature selection for sentiment classification},
  author = {Puay Siew Tan and Chi Xu and Erik Cambria},
  year = {2017},
  doi = {10.1109/SMC.2017.8122782},
  url = {https://doi.org/10.1109/SMC.2017.8122782},
  howpublished = {SMC},
  annotation = {中文辅助译名：用于情感分类的自适应两阶段特征选择},
  abstract = {Sentiment analysis is able to automatically extract valuable customer information from large amount of unstructured text data to support decision making in manufacturing applications such as product design and demand planning. One of the key issues of sentiment analysis is the high dimensionality of data, which can be effectively solved by feature selection. Existing feature selection techniques compute feature scores solely based on training data statistics or by modifying a specific feature metric formula to include test data information which can not be generalized to other types of feature metrics. In this paper, we propose an adaptive two-stage feature selection approach, which generates base feature scores from a training dataset and then weights them based on individual test sample so that the feature importance evaluation is adapted to the characteristic of test data as well. The proposed method is applicable to arbitrary type of feature metrics and sentiment classifiers. The experiments show that our approach can consistently outperform other methods, especially for the setting of small number of selected features.},
}

@misc{louis_philippe_morency_4e8d1587a85bf3d0,
  title = {Multi-level Multiple Attentions for Contextual Multimodal Sentiment Analysis},
  author = {Devamanyu Hazarika and Soujanya Poria and Navonil Majumder and Amir Zadeh and Louis-Philippe Morency and Erik Cambria},
