@misc{bjorn_schuller_d0fe752f8180c487,
  title = {MuSe 2020 Challenge and Workshop: Multimodal Sentiment Analysis, Emotion-target Engagement and Trustworthiness Detection in Real-life Media: Emotional Car Reviews in-the-wild},
  author = {Panagiotis Tzirakis and Alice Baird and Georgios Rizos and Adria Mallol-Ragolta and Iulia Lefter and Lea Schumann and Felix Hafner and Lukas Stappen and Xinchen Du and Erik Cambria and Björn W. Schuller and Ioannis Kompatsiaris},
  year = {2020},
  doi = {10.1145/3423327.3423673},
  url = {https://doi.org/10.1145/3423327.3423673},
  howpublished = {MuSe @ ACM Multimedia},
  annotation = {中文辅助译名：MuSe 2020 挑战赛和研讨会：现实生活媒体中的多模态情感分析、情感目标参与度和可信度检测：野外情感汽车评论},
  abstract = {Multimodal Sentiment Analysis in Real-life Media (MuSe) 2020 is a Challenge-based Workshop focusing on the tasks of sentiment recognition, as well as emotion-target engagement and trustworthiness detection by means of more comprehensively integrating the audio-visual and language modalities. The purpose of MuSe 2020 is to bring together communities from different disciplines; mainly, the audio-visual emotion recognition community (signal-based), and the sentiment analysis community (symbol-based). We present three distinct sub-challenges: MuSe-Wild, which focuses on continuous emotion (arousal and valence) prediction; MuSe-Topic, in which participants recognise 10 domain-specific topics as the target of 3-class (low, medium, high) emotions; and MuSe-Trust, in which the novel aspect of trustworthiness is to be predicted. In this paper, we provide detailed information on MuSe-CAR, the first of its kind in-the-wild database, which is utilised for the challenge, as well as the state-of-the-art features and modelling approaches applied. For each sub-challenge, a competitive baseline for participants is set; namely, on test we report for MuSe-Wild a combined (valence and arousal) CCC of .2568, for MuSe-Topic a score (computed as 0.34 * UAR + 0.66 * F1) of 76.78 % on the 10-class topic and 40.64 % on the 3-class emotion prediction, and for MuSe-Trust a CCC of .4359.},
}

