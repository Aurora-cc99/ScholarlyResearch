  howpublished = {ICDM (Workshops)},
  annotation = {中文辅助译名：神经符号人工智能挖掘公众对生成式人工智能在企业效率中的作用的看法},
  abstract = {Generative Artificial Intelligence (GenAI) is rapidly transforming industries by enhancing operational efficiency, automating complex tasks, and enabling innovative business practices. While large multinational corporations have begun to integrate GenAI into areas such as marketing, customer service, and supply chain management, far less is known about how small and medium sized enterprises (SMEs) are adopting or planning to adopt these tools. SMEs face distinct challenges including resource constraints, skills gaps, and cybersecurity risks that may limit effective implementation. This study presents an exploratory investigation into GenAIadoption among firms, using data collected from news media and social platforms over a six month period. The research focuses on three objectives: (i) capturing current usage and perceptions of GenAI, (ii) identifying functional areas where GenAIcan deliver the most efficiency gains, and (iii) understanding the barriers hindering broader adoption. Findings from this analysis aim to inform the design of future large scale surveys, experiments, and interviews, providing both academic insights and practical guidance for firms seeking to leverage GenAIfor operational efficiency.},
}

@misc{erik_cambria_79a29709a548a6f7,
  title = {Neural Brain: A Neuroscience-inspired Framework for Embodied Agents},
  author = {Lin Wang and Tianxiang Zhang and Wei Sun and Jian Liu and Arshad Ali Khan and Haitian Zhang and Athanasios V. Vasilakos and Lihua Xie and Xiongtao Shi and Thai Duy Nguyen and Jae Won Cho and Giovanni Iacca and Erik Cambria and Arvind Kumar and Ajmal Mian and Yanjie Li},
  year = {2025},
  doi = {10.48550/ARXIV.2505.07634},
  url = {https://doi.org/10.48550/ARXIV.2505.07634},
  howpublished = {CoRR},
  annotation = {中文辅助译名：神经脑：受神经科学启发的实体代理框架},
  abstract = {The rapid evolution of artificial intelligence (AI) has shifted from static, data-driven models to dynamic systems capable of perceiving and interacting with real-world environments. Despite advancements in pattern recognition and symbolic reasoning, current AI systems, such as large language models, remain disembodied, unable to physically engage with the world. This limitation has driven the rise of embodied AI, where autonomous agents, such as humanoid robots, must navigate and manipulate unstructured environments with human-like adaptability. At the core of this challenge lies the concept of Neural Brain, a central intelligence system designed to drive embodied agents with human-like adaptability. A Neural Brain must seamlessly integrate multimodal sensing and perception with cognitive capabilities. Achieving this also requires an adaptive memory system and energy-efficient hardware-software co-design, enabling real-time action in dynamic environments. This paper introduces a unified framework for the Neural Brain of embodied agents, addressing two fundamental challenges: (1) defining the core components of Neural Brain and (2) bridging the gap between static AI models and the dynamic adaptability required for real-world deployment. To this end, we propose a biologically inspired architecture that integrates multimodal active sensing, perception-cognition-action function, neuroplasticity-based memory storage and updating, and neuromorphic hardware/software optimization. F},
}

