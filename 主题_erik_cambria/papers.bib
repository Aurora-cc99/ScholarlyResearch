@misc{erik_cambria_87a34f73f4935e9b,
  title = {Guest Editorial: Industrial Internet of Things: Where Are We and What Is Next?},
  author = {Francesco Piccialli and Erik Cambria and Nik Bessis},
  year = {2021},
  doi = {10.1109/TII.2021.3086771},
