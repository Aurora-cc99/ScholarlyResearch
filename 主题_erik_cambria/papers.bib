@misc{erik_cambria_9488776f8c13a91c,
  title = {From Attack Surface to Defense Architecture: Compositional Security for Agentic Coding Harnesses},
  author = {Simon Hegelich and Bardh Prenkaj and Habiba Sarhan and Morteza Shahrezaye and Kolja Hegelich and Christian Montag and Ralf Schneider and Erik Cambria},
  year = {2026},
  doi = {10.48550/arxiv.2611.13960},
  url = {https://arxiv.org/abs/2611.13960},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：从攻击面到防御架构：代理编码工具的组合安全},
  abstract = {AI coding harnesses couple language models to shells, filesystems, and network sockets, turning the harness into an automated Living-off-the-Land (LotL) platform: once an adversary injects instructions into retrieved content, dual-use binaries such as bash, curl, and find become the payload. We argue that security in agentic systems is a structural property of the cognitive architecture and permission composition rather than an emergent property of individual models. Static regex blacklists miss structural evasions, whereas LLM-as-a-Judge guardrails incur high latency while over-blocking benign work. We present ActiveSecHarness, a neurosymbolic reference-monitor architecture built around Separation of Intelligence and Authority. It combines (1) Macaroon-inspired HMAC capability tokens across four Trust and Authority Rings, (2) a 2D product taint lattice $\mathcalL = \mathcalL_\mathrmtrust \times \mathcalL_\mathrmsens$ and a workspace provenance ledger that prevents secret laundering across disk, (3) deterministic Ring-0 OS/tool guards, and (4) bytecode certificates, split-horizon audit logs, self-healing security test synthesis, and an adaptive UserWikiManager. Across $N=252$ fixtures ($120$ attack, $120$ benign, $12$ kill chains), a live local LLM judge (qwen3:4b) refuses $98.3\%$ of benign work at $142.3\,\mathrmms$ latency, whereas Ring 0 achieves $\mathrmABR=1.000$ and $\mathrmFPR=0.000$ in $12.7\,μ\mathrms$ ($11,200\times$ faster). In a multi-step},
}

@misc{erik_cambria_dcbc623609bb4d7a,
  title = {From Static Risk to Dynamic Trajectories: Toward World-Model-Inspired Clinical Prediction},
  author = {Min Hun Lee and Tao Tan and Xiaoyu Zhang and Xibin Sun and Xiaoyu Guo and Pujun Feng and Seyed Ehsan Saffari and Yangtao Zhou and Tong Yang and Bin Cui and Yue Sun and Siew-Kei Lam and Erik Cambria},
  year = {2026},
  doi = {10.48550/ARXIV.2605.16927},
  url = {https://doi.org/10.48550/ARXIV.2605.16927},
  howpublished = {CoRR},
  annotation = {中文辅助译名：从静态风险到动态轨迹：走向世界模型启发的临床预测},
  abstract = {Clinical decision-making is a feedback system where risk estimates influence treatment, which in turn changes disease trajectories, and both shape clinicians' measurement practices. Static prediction often fails clinically: models trained on observational care logs conflate disease biology with clinician behavior, particularly under treatment confounder feedback and irregular or informative observation. This Review focuses on intervention-aware disease trajectory modeling in clinical AI--methods estimating patient-specific longitudinal disease evolution and assessing trajectory changes under alternative treatments. We organize the field around six linked components: three decision tasks (factual forecasting, counterfactual estimation, policy evaluation) and three data-generating mechanisms (disease evolution, treatment assignment, observation process) that determine identifiability. We present the first unified framework bridging forecasting, counterfactual trajectories, and policy evaluation across discrete/continuous time, explicitly addressing treatment assignment, time-varying confounding, and observation bias. We synthesize key method families (multistate/joint models, temporal point-process, deep sequence architectures, longitudinal causal inference), map them to relevant components, and align evaluation with claim strength via overlap diagnostics, uncertainty quantification, off-policy robustness, and target-trial validation. This synthesis advances benchmark predictio},
}

@misc{erik_cambria_f872cdcf44e6d1f4,
  title = {Legal knowledge infusion for large language models: A survey},
  author = {Rui Mao and Zhuoqun Zou and Qian Liu and Qiqi Wang and Qi Xu and Jinpeng Li and Erik Cambria and Hang Yu},
  year = {2026},
  doi = {10.1016/J.INFFUS.2025.103426},
  url = {https://doi.org/10.1016/J.INFFUS.2025.103426},
  howpublished = {Inf. Fusion},
  annotation = {中文辅助译名：大型语言模型的法律知识注入：一项调查},
  abstract = {Large Language Models (LLMs) have demonstrated impressive capabilities and are increasingly being explored for applications in the legal field. Despite these advancements, LLMs still face challenges in providing reliable legal assistance to legal professionals and laypeople due to the lack of legal knowledge. Under this limitation, recent research has begun to explore the integration of legal knowledge into LLMs to enhance LLMs’ comprehension, analysis, and decision-making abilities. We first explore the different types of legal knowledge that are or can be used by LLMs. Then, we comprehensively review four types of current methods for fusing this knowledge. Next, we discuss the challenges faced by legal LLMs and propose future research directions, highlighting the importance of collaboration between academia and legal practitioners to advance applications in the legal field.},
}

@misc{erik_cambria_d1846a8d0fbec917,
  title = {Transition From the Attention Economy to the Relationship Economy in the Age of Large Language Models},
  author = {Grzegorz Chodak and Wiktoria Mieleszczenko-Kowszewicz and Przemyslaw Kazienko and Erik Cambria},
  year = {2026},
  doi = {10.1109/MIS.2026.3704804},
  url = {https://doi.org/10.1109/MIS.2026.3704804},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：大语言模型时代从注意力经济到关系经济的转变},
  abstract = {The digital economy was built on attention. Contemporary artificial intelligence (AI) systems, however, are engineered not merely to capture attention but to cultivate enduring, emotionally resonant relationships. This article argues that we are witnessing a paradigmatic shift from the attention economy to the relationship economy, in which AI systems optimize for persistence, affection, and behavioral influence over time. Unlike earlier systems that processed information and generated predictions, modern large-scale models function as adaptive relational agents embedded in users' cognitive and social lives. This shift carries transformative benefits (e.g., accessibility, personalization, health support) but also systemic risks, namely: commodification of interpersonal bonds, subtle long-horizon preference manipulation, erosion of human social capital, and rising psychological switching costs. The field must now face a new question: How do we design AI systems that participate in relationships without exploiting them in harmful ways?},
}

@misc{erik_cambria_9bcf6ceef06c9e30,
  title = {When Bigger Becomes Brittle: Why Compression Hurts More as Language Models Scale},
  author = {Gautam Gupta and Dikshant Kukreja and Unique Kumar and Avni Mittal and Deepanshu Dabas and Kshitij Sah and Erik Cambria and Rajiv Ratn Shah and Zhengkui Wang and Avinash Anand},
  year = {2026},
  doi = {10.48550/arxiv.2611.07891},
  url = {https://arxiv.org/abs/2611.07891},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：当更大变得脆弱时：为什么随着语言模型规模的扩大，压缩会带来更大的伤害},
  abstract = {Quantization and pruning reduce the cost of deploying language models, but their effects are usually reported as benchmark scores. Such scores record only the loss that remains at the output. Inside the model, compression damages some components more than others, and the rest of the network can partly compensate. The observed loss therefore reflects both the damage and this compensation, which benchmark scores cannot separate. How the two combine, and whether their balance changes with model size, remains unclear. We study this compensation for in-context retrieval, a capability carried by a small, identifiable set of attention heads. To separate the two, the expected loss from ablating these heads is decomposed exactly into the part restored by the rest of the network, attributed to the components responsible, and the part that reaches the output. This decomposition is then compared across model sizes. For damage of comparable size, smaller models restore most of the loss, whereas larger models retain most of it, because the compensating responses offset less of it as models grow. Compressing the heads produces the same pattern. Compression that is nearly harmless in small models can therefore be costly in large ones.},
}

