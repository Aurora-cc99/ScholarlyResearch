@misc{erik_cambria_9d7e109076931d09,
  title = {The Hourglass Model Revisited},
  author = {Ng Bee Chin and Andrew G. Livingstone and Yosephine Susanto and Erik Cambria},
  year = {2020},
  doi = {10.1109/MIS.2020.2992799},
  url = {https://doi.org/10.1109/MIS.2020.2992799},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：重新审视沙漏模型},
  abstract = {Recent developments in the field of AI have fostered multidisciplinary research in various disciplines, including computer science, linguistics, and psychology. Intelligence, in fact, is much more than just IQ: it comprises many other kinds of intelligence, including physical intelligence, cultural intelligence, linguistic intelligence, and emotional intelligence (EQ). While traditional classification tasks and standard phenomena in computer science are easy to define, however, emotions are still a rather mysterious subject of study. That is why so many different emotion classifications have been proposed in the literature and there is still no common agreement on a universal emotion categorization model. In this article, we revisit the Hourglass of Emotions, an emotion categorization model optimized for polarity detection, based on some recent empirical evidence in the context of sentiment analysis. This new model does not claim to offer the ultimate emotion categorization but it proves the most effective for the task of sentiment analysis.},
}

@misc{erik_cambria_851b082ec9270796,
  title = {Bottom-Up and Top-Down: Predicting Personality with Psycholinguistic and Language Model Features},
  author = {Clemens Stachl and Sauleh Eetemadi and Yash Mehta and Amirmohammad Kazameini and Samin Fatehi and Erik Cambria},
  year = {2020},
  doi = {10.1109/ICDM50108.2020.00146},
  url = {https://doi.org/10.1109/ICDM50108.2020.00146},
  howpublished = {ICDM},
  annotation = {中文辅助译名：自下而上和自上而下：利用心理语言学和语言模型特征预测人格},
  abstract = {State-of-the-art personality prediction with text data mostly relies on bottom up, automated feature generation as part of the deep learning process. More traditional models rely on hand-crafted, theory-based text-feature categories. We propose a novel deep learning-based model which integrates traditional psycholinguistic features with language model embeddings to predict personality from the Essays dataset for Big-Five and Kaggle dataset for MBTI. With this approach we achieve state-of-the-art model performance. Additionally, we use interpretable machine learning to visualize and quantify the impact of various language features in the respective personality prediction models. We conclude with a discussion on the potential this work has for computational modeling and psychological science alike.},
}

@misc{erik_cambria_79490e00dc0f154e,
  title = {COAL: Convolutional Online Adaptation Learning for Opinion Mining},
  author = {Edoardo Ragusa and Paolo Gastaldo and Iti Chaturvedi and Erik Cambria},
  year = {2020},
  doi = {10.1109/ICDMW51313.2020.00012},
  url = {https://doi.org/10.1109/ICDMW51313.2020.00012},
  howpublished = {ICDM (Workshops)},
  annotation = {中文辅助译名：COAL：用于意见挖掘的卷积在线适应学习},
  abstract = {Thanks to recent advances in machine learning, some say AI is the new engine and data is the new coal. Mining this ‘coal’ from the ever-growing Social Web, however, can be a formidable task. In this work, we address this problem in the context of sentiment analysis using convolutional online adaptation learning (COAL). In particular, we consider semi-supervised learning of convolutional features, which we use to train an online model. Such a model, which can be trained in one domain but also used to predict sentiment in other domains, outperforms the baseline in the range of 5-20%.},
}

@misc{erik_cambria_a1c59c881c763dc4,
