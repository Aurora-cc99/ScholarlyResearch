@misc{erik_cambria_fdee055ba6e34711,
  title = {Benchmarking Distributional Vector Similarity Measures: A Survey},
  author = {Navid Nobani and Filippo Pallucchini and Fabio Mercorio and Erik Cambria},
  year = {2026},
  doi = {10.1111/EXSY.70354},
  url = {https://doi.org/10.1111/EXSY.70354},
  howpublished = {Expert Syst. J. Knowl. Eng.},
  annotation = {中文辅助译名：分布式向量相似性度量的基准测试：一项调查},
  abstract = {Measuring semantic similarity between words or phrases is central to natural language processing, information retrieval and computational linguistics. Despite their importance, similarity and distance measures are typically chosen by default (e.g., cosine similarity) or in an ad hoc fashion, with little empirical justification. This lack of systematic evaluation creates two gaps: first, the absence of a comprehensive taxonomy of measures that spans set‐based, vector‐based and information‐theoretic approaches; second, the lack of task‐aware benchmarking that quantifies how these measures perform across different models and applications. In this paper, we address these gaps by comparing 15 similarity and distance measures on four NLP tasks (sentence similarity, kNN classification, correlation analysis and visualisation) using multiple benchmark datasets and embedding models. Our results reveal that the effectiveness of similarity measures varies substantially depending on the task and model, challenging the assumption that cosine similarity is universally optimal. These findings highlight the practical risk of relying on default measures and provide a principled basis for selecting similarity functions in NLP, information retrieval and related fields.},
}

@misc{erik_cambria_df2ab48288e662a3,
  title = {Personalized Diabetes Care: Discovering Diabetes Mindset Disparities From Metaphorical Cognition},
  author = {Wang Zhao and Rui Mao and Shuangyan Deng and Erik Cambria},
  year = {2026},
  doi = {10.1109/taffc.2026.3696507},
  url = {https://doi.org/10.1109/taffc.2026.3696507},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：个性化糖尿病护理：从隐喻认知中发现糖尿病心态差异},
  abstract = {Diabetes self-management is shaped not only by knowledge and resources but by implicit cognitive architectures that guide how patients interpret symptoms, data, and control. Existing questionnaire-based measures and surface-level NLP analyses capture explicit constructs and topics, yet they overlook how patients conceptually structure their illness experience. Grounded in Conceptual Metaphor Theory, we propose a scalable framework that reconstructs diabetes self-management cognition from naturalistic patient discourse via computational metaphor analysis. We extract concept mappings from diabetes posts on Reddit using MetaPro 2.0, and summarize them into an interpretable multi-layer taxonomy, spanning embodied grounding, clinical event reasoning, social negotiation, psychological sense-making, instrumental treatment, and long-horizon control. We quantify sociocognitive homophily by correlating demographic and cognitive distance matrices, and test subgroup disparities. Association-rule mining further identifies indicative metaphorical markers that tend to differentiate patient subgroups in this dataset. Beyond demographics, latent class analysis reveals adversarial, managerial, and transactional coping logics. Finally, we explain how key cognitive themes evolve with age and disease duration, highlighting shifts from metric shock to embodied burden and toward resource-based integration. Overall, the results inform the design of precision diabetes education and future cognitively},
}

@misc{erik_cambria_29ec953603a429ad,
  title = {Better and Worse with Scale: How Contextual Entrainment Diverges with Model Size},
  author = {Zhengkui Wang and Rajiv Ratn Shah and Dikshant Kukreja and Avinash Anand and Gautam Gupta and Kshitij Sah and Aik Beng Ng and Erik Cambria},
  year = {2026},
  doi = {10.18653/V1/2026.FINDINGS-ACL.1509},
  url = {https://doi.org/10.18653/V1/2026.FINDINGS-ACL.1509},
  howpublished = {ACL (Findings)},
  annotation = {中文辅助译名：规模的好坏：上下文夹带如何随模型大小而变化},
  abstract = {Larger language models become simultaneously better and worse at handling contextual information—better at ignoring false claims, worse at ignoring irrelevant tokens. We formalize this apparent paradox through the first scaling laws for contextual entrainment, the tendency of models to favor tokens that appeared in context regardless of relevance. Analyzing the Cerebras-GPT (111M–13B) and Pythia (14M–12B) model families, we find entrainment follows predictable power-law scaling, but with opposite trends depending on context type: semantic contexts show decreasing entrainment with scale, while non-semantic contexts show increasing entrainment. Concretely, the largest models are four times more resistant to counterfactual misinformation than the smallest, yet simultaneously twice as prone to copying arbitrary tokens. These diverging trends, which replicate across model families, suggest that semantic filtering and mechanical copying are functionally distinct behaviors that scale in opposition. These opposing trends suggest that scaling alone does not resolve context sensitivity—it reshapes it.},
}

@misc{erik_cambria_b1bd3bf5e23063ed,
  title = {A multimodal data-driven method for abnormal condition identification of energy storage batteries based on EAA-Informer},
  author = {Xianxun Zhu and Jun Xie and Zezhong Sun and Erik Cambria and Yan Li},
  year = {2026},
