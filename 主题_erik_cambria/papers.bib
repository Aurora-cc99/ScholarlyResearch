@misc{erik_cambria_46e4cfbc23dd855a,
  title = {Transfer Learning for Cross-Domain Sentiment Classification via Domain Adaptation},
  author = {Abhijit Kumar and Agampreet Saini and Rahul Kumar Singh and Erik Cambria},
  year = {2026},
  doi = {10.1109/TCSS.2025.3625989},
  url = {https://doi.org/10.1109/TCSS.2025.3625989},
  howpublished = {IEEE Trans. Comput. Soc. Syst.},
  annotation = {中文辅助译名：通过域适应进行跨域情感分类的迁移学习},
  abstract = {The exponential proliferation of user-generated content across online platforms has driven a substantial surge in domain-specific textual data. Consequently, sentiment analysis has emerged to facilitate context-aware, real-time decision making in dynamic, data-intensive domains. Nevertheless, obtaining large-scale annotated data for all domains remains impractical, therefore a necessity for robust cross-domain sentiment classification techniques is still necessary. This work proposes WBiGe a hybrid domain adaptation architecture that combines static and contextual embeddings with a hierarchical BiGRU encoder to exploit semantic structure globally and sentiment cues locally. A lightweight convolutional architecture is used to extract phrase level patterns that are usually ignored by sequential encoders to improve short range sentiment expressions detection. To focus sentiment informative pivots and nonpivots during domain drilldown, a class aware domain alignment mechanism based on weighted maximum mean discrepancy is utilized. Furthermore, an iterative pseudolabeling strategy and dual-level attention modules are incorporated into the architecture to continuously improve target domain prediction to increase the interpretability of the model. The proposed WBiGe framework was extensively assessed using the Amazon benchmark dataset, in which it significantly outperforms the existing models across a wide range of cross-domain classification tasks with a record peak accuracy of 92.},
}

@misc{erik_cambria_8aa5241b406f66ea,
  title = {Can saliency maps flag chest radiograph classifier errors at a new hospital? An external validation study},
  author = {Aashish Chapagai and Angad Singh Gurtatta and Erik Cambria},
  year = {2026},
  doi = {10.48550/arxiv.2611.05011},
  url = {https://arxiv.org/abs/2611.05011},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：显着图可以标记新医院的胸片分类器错误吗？外部验证研究},
  abstract = {Saliency maps are offered as a safeguard for medical image classifiers, but whether they reveal individual errors at a new hospital remains largely untested. We trained a convolutional network and a vision transformer on NIH ChestX-ray14 and evaluated 303,768 decisions per model at the training hospital and at two external sites, in the USA and Vietnam, with radiologist-consensus labels. We scored each explanation by its anatomical enrichment, the area-normalized concentration of attribution in a segmented thoracic region, and tested whether it detects errors beyond the model's confidence. Grad-CAM localized findings less often than radiologists (hit rate at most 0.575 versus 0.888). Adding enrichment to a confidence-based error detector calibrated at the training hospital never raised its area under the curve by more than 0.011, and for the convolutional network the relation between enrichment and correctness reversed between hospitals, degrading the transferred detector. Model confidence, not saliency, should anchor deployment monitoring.},
}

@misc{erik_cambria_9534e03fe6191e80,
  title = {Affective Language Processing for Mental Healthcare: A Survey of LLM-Based Approaches across the Care Continuum},
  author = {Jialun Wu and Kai He and Onno Pepijn Kampman and Gerard Chung and Wilson Wen Bin Goh and Qika Lin and Jiaxing Xu and Yanrui Du and Xuequn Shang and Erik Cambria and Mengling Feng},
  year = {2026},
  doi = {10.1109/taffc.2026.3726877},
  url = {https://doi.org/10.1109/taffc.2026.3726877},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：心理保健的情感语言处理：整个护理连续体中基于大语言模型的方法的调查},
  abstract = {Mental healthcare is fundamentally mediated by affective phenomena expressed through language, including emotional disclosure, shifting mood states, cognitive appraisals, and the relational dynamics of therapeutic alliance. Large language models (LLMs) offer new opportunities to model these signals across mental health workflows, but their clinical value depends on whether they can reliably recognize, track, and respond to affect in context. This survey reviews LLM-based approaches to mental healthcare through an affective computing lens, organizing the literature around emotional expression and affect recognition, empathy and therapeutic alliance, affective dialogue management, longitudinal user-state tracking, and affect-aware safety. We situate these capabilities along a language-mediated care continuum spanning screening and triage, assessment, diagnosis and risk reasoning, and intervention and decision support, linked by iterative follow-up and affective feedback over time. Covering studies published between 2019 and October 2025, we trace the shift from scripted and task-specific NLP systems to LLM-based approaches with stronger contextual understanding and more adaptive response generation, and introduce a three level taxonomy connecting methodological foundations, service level applications, and assurance requirements. Across six major research lines, we synthesize current evidence, identify persistent gaps in evaluation and deployment, and outline directions for clin},
}

@misc{erik_cambria_bd235b70a01c6b6f,
  title = {A survey of LLM reasoning in healthcare and medicine: Individual modeling and collaborative agents},
  author = {Qika Lin and Luwei Xiao and Bin Pu and Kaize Shi and Yanrui Du and Jiaxing Xu and Kai He and Shuai Zhao and Jian Zhang and Erik Cambria and Swapnil Mishra and Mengling Feng},
  year = {2026},
  doi = {10.1016/j.inffus.2026.104827},
  url = {https://doi.org/10.1016/j.inffus.2026.104827},
  howpublished = {Information Fusion},
  annotation = {中文辅助译名：医疗保健和医学领域的大语言模型推理调查：个体建模和协作智能体},
  abstract = {Large Language Models (LLMs) are rapidly transforming intelligent healthcare and medicine. However, their successful clinical deployment depends on reliable and explainable medical reasoning rather than surface-level text generation. This survey reviews LLM reasoning in medicine. It covers foundational datasets, training-time optimization, test-time reasoning, collaborative agents, and reasoning evaluation. We distinguish two complementary design axes. Individual-model optimization improves the reasoning behavior of a model or module through supervised fine-tuning, reinforcement-based fine-tuning, or test-time control. Collaborative-agent design specifies how one or more such modules exchange evidence, invoke tools, and aggregate decisions at the system level. Collaborative-agent design does not replace individual-model optimization. Contemporary agent systems commonly compose prompted or individually trained modules, including SFT- and GRPO-optimized planners, routers, and aggregators. This compositional view clarifies both the promise and the current limitations of agents. Structured collaboration can support transparency, error recovery, and heterogeneous evidence integration in workflow-oriented tasks. However, it does not provide an inherent advantage over a strong single LLM on narrowly scoped questions. Combining individual-model optimization with collaborative-agent design offers substantial potential for advancing future medical intelligence.},
}

