@misc{panorama_mi_li_58fd7de6a8c70606,
  title = {Benzothiadiazole-Based Linear and Star Molecules: Design, Synthesis, and Their Application in Bulk Heterojunction Organic Solar Cells},
  author = {Weiwei Li and Chun Du and Fenghong Li and Yi Zhou and Mats Fahlman and Zhishan Bo and Fengling Zhang},
  year = {2009},
  doi = {10.1021/cm902611b},
  url = {https://doi.org/10.1021/cm902611b},
  howpublished = {Chemistry of Materials},
  annotation = {中文辅助译名：基于苯并噻二唑的线性和星形分子：设计、合成及其在体异质结有机太阳能电池中的应用},
  abstract = {Star molecules have many advantages, such as monodispersity, excellent solubility, and vast structures with different functional groups. A set of four-arm star molecules with benzothiadiazole as the core, oligothiophene as the arm, and triphenylamine as the end group and their linear counterparts were designed and synthesized. Organic solar cells (OSCs) fabricated with these star molecules and [6,6]-phenyl C 71 butyric acid methyl ester (PC 71 BM) by spin-coating from solution demonstrate similar short circuit current density ( J sc ) and fill factor (FF) but larger open circuit voltage ( V oc ) in comparison with solar cells fabricated with corresponding linear molecules and PC 71 BM. A power conversion efficiency (PCE) of 1.8%, with J sc = 4.9 mA/cm 2, V oc = 0.92 V, and FF = 0.41 was achieved with one of these star molecules.},
}
