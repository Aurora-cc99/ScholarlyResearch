  year = {2015},
  doi = {10.1021/acs.accounts.5b00334},
  url = {https://doi.org/10.1021/acs.accounts.5b00334},
  howpublished = {Accounts of Chemical Research},
  annotation = {中文辅助译名：用于有机太阳能电池的二酮吡咯并吡咯聚合物},
  abstract = {Conjugated polymers have been extensively studied for application in organic solar cells. In designing new polymers, particular attention has been given to tuning the absorption spectrum, molecular energy levels, crystallinity, and charge carrier mobility to enhance performance. As a result, the power conversion efficiencies (PCEs) of solar cells based on conjugated polymers as electron donor and fullerene derivatives as electron acceptor have exceeded 10% in single-junction and 11% in multijunction devices. Despite these efforts, it is notoriously difficult to establish thorough structure-property relationships that will be required to further optimize existing high-performance polymers to their intrinsic limits. In this Account, we highlight progress on the development and our understanding of diketopyrrolopyrrole (DPP) based conjugated polymers for polymer solar cells. The DPP moiety is strongly electron withdrawing and its polar nature enhances the tendency of DPP-based polymers to crystallize. As a result, DPP-based conjugated polymers often exhibit an advantageously broad and tunable optical absorption, up to 1000 nm, and high mobilities for holes and electrons, which can result in high photocurrents and good fill factors in solar cells. Here we focus on the structural modifications applied to DPP polymers and rationalize and explain the relationships between chemical structure and organic photovoltaic performance. The DPP polymers can be tuned via their aromatic substi},
}

@misc{panorama_mi_li_64c525154cfe7f02,
  title = {Physicochemical origin of space charge dynamics for aged XLPE cable insulation},
  author = {Weiwei Li and Jianying Li and Xia Wang and Shengtao Li and George Y. Chen and Jiankang Zhao and Benhong Ouyang},
  year = {2014},
  doi = {10.1109/tdei.2013.004070},
  url = {https://doi.org/10.1109/tdei.2013.004070},
