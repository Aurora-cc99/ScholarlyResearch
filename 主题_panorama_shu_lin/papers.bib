  annotation = {中文辅助译名：通过高频电磁断层扫描监测多孔材料的孔隙率和盐水扩散},
  abstract = {Electromagnetic tomography (EMT) is an emerging imaging modality that presents electromagnetic property distributions. However, most existing EMT studies focus on highly-conductive metals using low-frequency fields, which are not suitable for monitoring non-conductive materials, in particular, for new emerging applications involving porous materials. To address this issue, a method is proposed by immersing porous materials in saline and then carrying out imaging using EMT. Traditional low-frequency EMTs are not suitable due to their insensitivity to low-conductivity and weakly magnetic materials. As such, this paper develops a high-frequency 8-channel EMT sensor that achieves an SNR of 76.74 dB with operating frequencies up to 5 MHz. The sensor features a circular imaging region with a 101.5 mm diameter. The system integrates 8 equal-spaced, capsule-shaped coils, each containing 3 turns with a self-inductance of 11 μ H. The system performance is validated through imaging bulk liquid samples, including salines from 0.25 % to 20 % and magnetite dispersions from 0.097 % to 1.54 %, with sample diameters between 22 mm and 100 mm. Additionally, a signal response model is derived for arbitrarily placed samples between a coil-coil model, which is validated through signal analyses with bulk liquid samples. The study then extends to monitoring porous media. Packed structures formed by 5 mm and 8 mm glass beads immersed in 4% saline are imaged. Additionally, dynamic diffusions of 4% sal},
}

@misc{panorama_shu_lin_e2017fe6469907eb,
  title = {Wearable fall risk assessment by discriminating recessive weak foot individual},
  author = {Zhen Guo Song and Jianlin Ou and Shibin Wu and Lin Shu and Qihan Fu and Xiangmin Xu},
  year = {2025},
  doi = {10.1186/s12984-025-01599-8},
  url = {https://doi.org/10.1186/s12984-025-01599-8},
  howpublished = {Journal of NeuroEngineering and Rehabilitation},
  annotation = {中文辅助译名：通过区分隐性弱足个体来评估可穿戴跌倒风险},
  abstract = {BACKGROUND: Sensor-based technologies have been widely used in fall risk assessment. To enhance the model's robustness and reliability, it is crucial to analyze and discuss the factors contributing to the misclassification of certain individuals, enabling purposeful and interpretable refinement. METHODS: This study identified an abnormal gait pattern termed "Recessive weak foot (RWF)," characterized by a discontinuous high-risk gait on the weak foot side, observed through weak foot feature space. This condition negatively affected the training and performance of fall risk assessment models. To address this, we proposed a trainable threshold method to discriminate individuals with this pattern, thereby enhancing the model's generalization performance. We conducted feasibility and ablation studies on two self-established datasets and tested the compatibility on two published gait-related Parkinson's disease (PD) datasets. RESULTS: Guided by a customized index and the optimized adaptive thresholds, our method effectively screened out the RWF individuals. Specifically, after fine adaptation, the individual-specific models could achieve accuracies of 87.5% and 73.6% on an enhanced dataset. Compared to the baseline, the proposed two-stage model demonstrated improved performance, with an accuracy of 85.4% and sensitivity of 87.5%. In PD dataset, our method mitigated potential overfitting from low feature dimensions, increasing accuracy by 4.7%. CONCLUSIONS: Our results indicate the },
}

@misc{panorama_shu_lin_8afb03001897fa15,
