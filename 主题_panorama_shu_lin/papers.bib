  author = {Tao Huang and Zikang Dong and Jialong Liu and Hongbo Yao and Fenghan Zhou and Haoqiang Hua and Xiangmin Xu and Lin Shu},
  year = {2025},
  doi = {10.1080/10447318.2025.2531277},
  url = {https://doi.org/10.1080/10447318.2025.2531277},
