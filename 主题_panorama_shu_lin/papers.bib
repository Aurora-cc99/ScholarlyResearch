@misc{panorama_shu_lin_d19df887e73e99cf,
  title = {Identifying changes in dynamic plantar pressure associated with radiological knee osteoarthritis based on machine learning and wearable devices},
  author = {Gege Li and Shilin Li and Junan Xie and Zhuodong Zhang and Jihua Zou and Chengduan Yang and Longlong He and Qing Zeng and Lin Shu and Guozhi Huang},
