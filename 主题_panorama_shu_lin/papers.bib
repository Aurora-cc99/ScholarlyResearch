  howpublished = {International Conference on Intelligent Computing (ICIC)},
  annotation = {中文辅助译名：电气柜检测中多目标OCR文本识别的分布式层次结构},
  abstract = {Electrical Cabinet Label Recognition is an important part of robotic intelligent inspection. Accurate label recognition is a prerequisite for effectively recording inspection anomalies. After the inspection robot takes pictures, OCR Optimal Character Recognition can detect the location of the electrical cabinet labels and recognize the content on the labels. Firstly, We use the oclip method to reduce the model training time and reduce the need for dataset size. Secondly, In the electrical cabinet label dataset, the text location detection accuracy based on the cutting-edge model DBNet__ reaches 96.74 , and the text content recognition accuracy based on ABINet reaches 89.33 . Through comparative experiments, we found that applying only the ABINet visual model can improve the text recognition accuracy to 90.58 , indicating that the language model in ABINet does not perform well for this task. The ABINet visual model is better at extracting local information from the image text, while the ABINet language model excels at recognizing semantic relationships across different parts of the text. Thirdly, Leveraging this characteristic, we designed a distributed hierarchical structure for the multi-objective OCR text recognition framework ABINet-TS. In the first layer, the visual model is used to recognize local information from the image, while in the second layer, the language model is applied to correlate and correct the predictions made by the visual model. This further improves th},
}

@misc{panorama_shu_lin_c1bc223f0b2afa23,
  title = {Multi-Channel Tactile-Force Rendering: A Microcurrent-Based Computational Framework for High-Resolution Haptic Feedback},
  author = {Qiwei Xiong and Junfeng Liao and Detian Liu and Jusheng Chen and Zichen Su and Haoqiang Hua and Lin Wang and Hongbo Yao and Zhiheng Zhou and Lin Shu},
  year = {2025},
  doi = {10.1145/3734921.3734938},
  url = {https://doi.org/10.1145/3734921.3734938},
  howpublished = {International Conference on Generative Artificial Intelligence and Digital Media},
  annotation = {中文辅助译名：多通道触觉力渲染：基于微电流的高分辨率触觉反馈计算框架},
  abstract = {With the rapid development of information technology (IT), the lifestyle of modern society has transformed to a faster pace and is more human-centered. The developments in haptic technology have significantly improved the human-computer interaction. Virtual reality (VR) technology and the metaverse, which highlight personalized experience, have become hotspots of the information application industry. In VR applications, adding haptic feedback to the human-computer interaction process can make the experience more immersive. In recent years, research on virtual haptics has focused on two areas: the use of microcurrents to stimulate mechanoreceptors and the use of virtual haptics to convey information. Multi-channel tactile-force rendering permits realistic touch sensations. This is achieved by utilizing force and tactile feedback methods. It is effective for the users to feel detailed and immersive interactions. This paper presents a detailed review on the developments in microcurrent-based computational frameworks for high-resolution haptic feedback. This work also investigates the modern techniques for high resolution haptic rendering, such as the role of multi-channel simulation and computational modeling techniques. Furthermore, the applications of this technology, challenges, and future directions were elaborated.},
}

@misc{panorama_shu_lin_cfcd50755652fc51,
