  howpublished = {IEEE Transactions on Networking},
  annotation = {中文辅助译名：利用商用 Wi-Fi 实现跨环境连续手势用户身份验证},
  abstract = {Behavior biometrics-based user authentication with Wi-Fi gains significant attention due to its ubiquitous and contact-free manners. An individual’s identity can be verified by analyzing activities induced signal variances, excellently balancing the security demands and user experience. However, the inherent complexity of Wi-Fi signals presents significant challenges for behavior biometrics-based user authentication. The susceptibility of Wi-Fi signals results in a poor cross-environment generalization capability, which is overlooked by the existing research. In addition, most existing works of behavior-based user authentication are based on one-off activity. This makes them vulnerable to zero-effort attacks and imitation attacks. To address these issues, we propose a cross-environment continuous gesture-based user authentication framework with Wi-Fi, dubbed Wi-CGAuth. Specifically, the cross-environment generalization capability is enhanced by the cross-layer joint optimization approach. At the lowest signal layer, the signals’ time, spatial, and frequency diversity are extended maximally, by a novel, subcarrier-level, cost-effective signal optimization strategy. At the middle layer, the multi-view fusion method, i.e., multi-transfer component analysis (TCA), is applied to refine the signals from transceiver pairs after signal preprocessing. The continuous gesture segmentation problem is modeled as the classification problem, which is solved by CNN. At the upper layer, a Con},
}

@misc{panorama_shu_lin_20c5a150010896f6,
  title = {QRS Complexes Detection Using UNet-BiLSTM Model Combined With Adaptive Post-Processing for Multilead Wearable ECG Smart T-Shirt System},
  author = {Kaikai Wang and Baoliang Feng and Fenghan Zhou and Changfu Zhong and Jingyuan Qiao and Junhong Luo and Huilin Yao and Jiyu Wang and Lin Shu},
  year = {2025},
  doi = {10.1109/jiot.2025.3574944},
  url = {https://doi.org/10.1109/jiot.2025.3574944},
  howpublished = {IEEE Internet of Things Journal},
  annotation = {中文辅助译名：使用 UNet-BiLSTM 模型结合自适应后处理进行 QRS 复合体检测，用于多导联可穿戴心电图智能 T 恤系统},
  abstract = {In recent years, the rapid development of wearable devices and Internet of Things (IoT) technology has made realtime, continuous dynamic electrocardiogram (ECG) monitoring possible. However, robust universal multi-lead QRS complex detection under noise and high heart rate (HR) conditions remains challenging. In this study, we propose a smart T-shirtbased multi-lead dynamic ECG monitoring system and a highaccuracy QRS complex detection algorithm to solve the above problems. First, we develop a six-lead smart T-shirt system with integrated flexible dry electrodes for real-time acquisition of the ECG under three conditions: standing, walking, and jogging. The electrode structure and hardware circuit are designed to resist noise, while electrodes are combined with medical-grade conductive gels to replace conventional Ag/AgCl wet electrodes, ultimately realizing high signal-to-noise ratio (SNR) signal acquisition under dynamic conditions. The T-shirt-based system design not only enhances user comfort but also facilitates use for non-medical users, making long-term ECG monitoring more feasible. Second, we propose a novel Pro-APP algorithm combining the UNet and bidirectional long short-term memory (UNet-BiLSTM) model with adaptive post-processing (APP), which is robust and outperforms three existing QRS complex detection algorithms. The UNet-BiLSTM model can effectively extract multi-scale features and capture the timing information in the ECG. The APP algorithm further optimizes t},
}

@misc{panorama_shu_lin_7017db50c6de1914,
