@misc{lu_baoliang_f56c766550e2,
  title = {Multi-View Self-Supervised Domain Adaptation for EEG-Based Emotion Recognition},
  author = {Lu Zhang and Hanwen Shi and Juan-Zi Li and Wei-Long Zheng and Bao-Liang Lu},
  year = {2025},
  doi = {10.1109/TAFFC.2025.3574868},
  url = {https://doi.org/10.1109/TAFFC.2025.3574868},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：基于脑电图的情绪识别的多视图自监督域适应。 IEEE 传输。影响。计算。 16（4）：3055-3066（2025）},
  abstract = {Research on emotion recognition based on EEG signals has made significant progress. Most of the existing studies have focused on supervised learning methods, but real-life data cannot meet the requirement of high quality with labels. In addition, EEG signals have individual variability and instability, which requires transfer learning to enhance the model generalization. In this paper, we propose a multi-view self-supervised domain adaptation model that combines self-supervised learning techniques with domain-adaptive transfer learning algorithms, which can solve the last two problems mentioned above. Specifically, we add a multi-class domain discriminator to construct the adversarial relationship between the sub-networks so that distribution discrepancy of different subjects can be reduced effectively. We conduct both subject-dependent and subject-independent experiments on the SEED and SEED-IV datasets to thoroughly evaluate the performance of our model. The results show that our model achieves outstanding emotion recognition performance even with limited labeled data. In the subject-dependent experiments on both datasets, our model achieves accuracy rates of 85.91% and 87.19% respectively, surpassing the original self-supervised masked autoencoder model by about 3%. In subject-independent experiments, our model demonstrates strong data distribution adaptation capabilities, achieving an accuracy of 69.72% and 62.87%, respectively on the SEED and SEED-IV datasets using only },
}

@misc{lu_baoliang_28a19f3683be,
  title = {Self-supervised EEG Representation Learning based on Temporal Prediction and Spatial Reconstruction for Emotion Recognition},
  author = {Cognitive Science Society 2025 and Ren-Jie Dai and Keya Hu and Bao‐Liang Lu and Haolong Yin and Wei‐Long Zheng},
  year = {2025},
  doi = {10.48448/cp45-k557},
  url = {https://escholarship.org/uc/item/93n3q505},
  howpublished = {CogSci},
  annotation = {中文辅助译名：基于情绪识别的时间预测和空间重建的自监督脑电图表示学习。},
  abstract = {Affective Brain-Computer Interfaces has achieved remarkable advancements, enabling researchers to interpret labeled EEG data accurately. However, the annotation of EEG data is time-consuming and requires substantial effort, which limits the application in practical scenarios. In this paper, we propose a self-supervised EEG representation learning framework based on temporal prediction and spatial reconstruction (EEG-TPSR) to learn EEG representations from a large amount of unlabeled data. Our model consists of two stages: 1) In the pre-training stage, we use contrastive temporal prediction and spatial reconstruction as proxy tasks, which utilize the spatio-temporal information to learn the generic representations from EEG data; 2) In the fine-tuning stage, few data is used to calibrate the pre-trained model. We conduct extensive experiments on three emotion EEG datasets. The results demonstrate that our proposed model achieves excellent performance, with over 20% relative accuracy improvement and more than 15% improvement using only 1% labeled data.},
}

@misc{lu_baoliang_4d47eca0698a,
  title = {Attention-Based Graph Net with Mixture of Experts for Emotion Recognition Under Sleep Deprivation},
  author = {Shi-Heng Tian and Yan-Kai Liu and Bao-Liang Lu and Wei-Long Zheng},
  year = {2025},
  doi = {10.1109/BIBM66473.2025.11357156},
  url = {https://doi.org/10.1109/BIBM66473.2025.11357156},
  howpublished = {BIBM},
  annotation = {中文辅助译名：基于注意力的图网络与专家混合，用于睡眠剥夺下的情绪识别。 BIBM 2025：4115-4120},
  abstract = {The impact of sleep deprivation on human emotional states has long been a central topic in psychology and neuroscience. However, the lack of high-quality, randomized stimuli materials for eliciting multimodal emotional responses has limited the development of robust datasets in this area. To address this gap, we collected a multimodal dataset comprising four emotional categories-happy, sad, fear, and neutral-from 20 subjects under three sleep conditions: sleep deprivation, sleep recovery, and normal sleep. Each emotional state was elicited using randomized video stimuli specifically designed to provoke the target emotions. Furthermore, we propose a novel emotion classification framework that integrates a Graph Neural Network (GNN) with a MoE (Mixture-of-Experts) architecture. Experimental results demonstrate that our method achieves SOTA performance. Moreover, in all models evaluated, the accuracy of emotional recognition was significantly lower under sleep deprivation compared to sleep recovery and baseline conditions, particularly for positive emotional states.},
}

@misc{wei_long_zheng_09cb478cd948ab4b,
  title = {Cross-Stimulus Transfer Learning: Enhancing Emotion Recognition from Visual-Auditory to Olfactory Perception},
  author = {Jiaqi Wang and Zheng-Ting Chen and Kenan Huang and Yifan Wu and Dian Zhang and Jizhou Guo and X. J. Liu and Dan Peng and Bao‐Liang Lu and Wei‐Long Zheng},
  year = {2025},
  doi = {10.1109/embc58623.2025.11253239},
  url = {https://doi.org/10.1109/embc58623.2025.11253239},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：交叉刺激迁移学习：增强从视觉听觉到嗅觉的情感识别},
  abstract = {Olfactory stimuli, due to their unique neural connections with the amygdala and hippocampus, demonstrate significant potential for emotion research. However, compared to visual-auditory stimuli, they remain relatively underexplored. To address this gap, we designed a cross-stimulus transfer learning task involving two datasets. One dataset contains emotion EEG data induced by olfactory stimuli, while the other, the SEED dataset, contains EEG signals recorded during video-induced emotional experiences. Both datasets focus on three emotional categories: positive, neutral, and negative. To minimize differences between stimulus types and handle individual variability, we employed domain adaptation (DA) and domain generalization (DG) techniques. A Transformer-based Domain-Adversarial Neural Network (DANN) achieved average accuracies of 50.7% and 44.0% in cross-subject and cross-stimulus emotion recognition, respectively, outperforming conventional methods. The study validated the feasibility of cross-stimulus transfer in emotion recognition and provided the experimental support for further exploration of stimulus-independent emotion patterns.},
}

@misc{wei_long_zheng_a4df6506265221d3,
  title = {Combining Induction and Transduction for Abstract Reasoning},
  author = {Wen-Ding Li and Keya Hu and Carter Larsen and Yuqing Wu and Simon Alford and Caleb Woo and Spencer M. Dunn and Hao Tang and Michelangelo Naim and Dat Nguyen and Wei-Long Zheng and Zenna Tavares and Yewen Pu and Kevin Ellis},
  year = {2025},
  doi = {10.48550/ARXIV.2411.02272},
  url = {https://openreview.net/forum?id=UmdotAAVDe},
  howpublished = {ICLR},
  annotation = {中文辅助译名：结合归纳和转导进行抽象推理},
  abstract = {When learning an input-output mapping from very few examples, is it better to first infer a latent function that explains the examples, or is it better to directly predict new test outputs, e.g. using a neural network? We study this question on ARC by training neural models for induction (inferring latent functions) and transduction (directly predicting the test output for a given test input). We train on synthetically generated variations of Python programs that solve ARC training tasks. We find inductive and transductive models solve different kinds of test problems, despite having the same training problems and sharing the same neural architecture: Inductive program synthesis excels at precise computations, and at composing multiple concepts, while transduction succeeds on fuzzier perceptual concepts. Ensembling them approaches human-level performance on ARC.},
}

@misc{wenming_zheng_30134a4413d1,
