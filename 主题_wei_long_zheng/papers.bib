@misc{lu_baoliang_70b0132ece29,
  title = {Multimodal Symptoms-Assisted Depression Detection Using EEG and Eye Movements},
  author = {Hao-Long Yin and Jian-Ming Zhan and Wei‐Long Zheng and Qinyu Lv and Zhenghui Yi and Bao‐Liang Lu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464822},
  url = {https://doi.org/10.1109/icassp55912.2026.11464822},
  howpublished = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  annotation = {中文辅助译名：使用脑电图和眼动进行多模态症状辅助抑郁症检测},
  abstract = {Depression, a widespread mental health disorder, is characterized by persistent sadness and diminished interest in daily activities. Early detection facilitates timely intervention, thereby reducing its negative impact. Electroencephalography (EEG) and eye movements, owing to their non-invasive and cost-effective nature, have gained recognition as reliable biomarkers for detecting depression. Depression symptoms, as prominent external manifestations of the disorder, play a crucial role in its diagnosis. However, limited research has focused on incorporating these symptoms into depression detection tasks. In this study, we collected EEG data and eye movement recordings from 100 participants. In addition to depression diagnoses, we compiled a list of depression-related symptoms, based on assessments made by experienced psychiatrist and responses to clinical scales. To fully explore the potential of symptoms-assisted detection of depression, we propose the Multimodal Symptoms-Assisted Depression Detection (MSADD) model. This model utilizes EEG and eye movements not only to identify symptoms but also to enhance the performance of depression detection through the integration of symptom information.},
}

@misc{lu_baoliang_07184d35cc82,
  title = {Cross-Cultural Differences and Similarities in EEG-Eye Emotion Recognition Across Four Groups},
  author = {Khin Pa Pa Aung and Wei‐Long Zheng and Bao‐Liang Lu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464152},
  url = {https://doi.org/10.1109/icassp55912.2026.11464152},
  howpublished = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  annotation = {中文辅助译名：四组脑电图-眼睛情绪识别的跨文化差异和相似之处},
  abstract = {Emotion recognition is shaped by cultural differences, as emotional expressions and physiological responses vary across populations. However, most affective computing studies focus on single-culture datasets and overlook cultural diversity. This limits cross-cultural generalization and underrepresents minority populations. In this work, we present a benchmark for multimodal emotion recognition using EEG and eye movement data across four culturally diverse groups: China, Myanmar, Germany, and French. To support this investigation, we incorporate our recently introduced SEED-MYA alongside SEED, SEED-GER, and SEED-FRA; further develop a Culture-Aware Multimodal Emotion Transformer (CAMET) with cultural embeddings and bidirectional cross-attention to enhance cross-cultural emotion recognition. We evaluate models under both intra-culture and cross-culture subject-independent settings. Our findings reveal both cultural differences and cross-cultural similarities in emotion recognition. EEG consistently captures core neural responses, while eye movements provide complementary behavioral cues, with notable performance gains through multimodal fusion, particularly with our proposed CAMET model. CHN remains the most predictable test culture, while GER presents the greatest challenge. An in-group advantage is observed, and positive emotions consistently elicit shared temporal lobe activation across cultures. These results establish a rigorous cross-cultural benchmark and underscore the },
}

@misc{wei_long_zheng_9efd403685b4e29d,
  title = {Self-Supervised EEG-Based Emotion Recognition in an Olfactory Stimulation Paradigm},
  author = {Jia-Qi Wang and Zheng-Ting Chen and Kenan Huang and Yifan Wu and Dian Zhang and Jizhou Guo and X. J. Liu and Dan Peng and Bao-Liang Lu and Wei‐Long Zheng},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11463129},
  url = {https://doi.org/10.1109/icassp55912.2026.11463129},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：嗅觉刺激范式中基于自我监督脑电图的情绪识别},
  abstract = {Olfactory stimulation is a promising alternative to conventional visual and auditory emotion induction methods. We propose a paradigm that elicits three emotional states—positive, neutral, and negative—using selected odors. In the Odor-Induced Emotion Filtering Experiment (OIEFE), 44 participants rated 10 odors for pleasantness, and five odors with high consensus were chosen. EEG data from 9 participants exposed to these odors were recorded for classification. In the subject-dependent setting, a Transformer model achieved 62.4% accuracy, while in the cross-subject setting, a Transformer-based Domain Adversarial Neural Network (DANN) reached 51.2%. We further explored cross-stimulus transfer from visual–auditory (SEED dataset) to olfactory EEG, where the proposed self-supervised MV-SSTMA model attained 59.2%, surpassing traditional domain adaptation approaches. These findings demonstrate the effectiveness of self-supervised learning for modality-invariant EEG representation and highlight the considerable potential of olfactory-based EEG emotion recognition in enabling scalable, multimodal affective computing systems.},
}

@misc{wenming_zheng_a7dd5f51b80d,
  title = {Dual-Branch Cross-Temporal Graph Neural Network for EEG-based Depression Detection},
  author = {Yiye Wang and Tao Zhao and Hao Yang and Xiaoyan Zhou and Wenming Zheng},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3691251},
  url = {https://aip.seu.edu.cn/wmzheng/main.htm},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：用于基于 EEG 的抑郁检测的双分支跨时图神经网络},
  abstract = {Recent studies have demonstrated the effectiveness of Graph Neural Networks (GNNs) in EEG-based depression detection. However, two critical challenges remain unresolved. These challenges limit the ability of GNN-based methods to fully exploit spatio-temporal (ST) features for EEG-based depression detection. Firstly, the depression-relevant cross-temporal interactions that represent the complex relationships between different electrodes across various time steps are not fully considered. Secondly, although depression is closely associated with multiple distributed brain regions and their interactions, the existing methods provide limited exploration of brain-region-level ST features, failing to fully exploit the depression-related neural patterns at the brain-region level. To tackle these limitations, in this paper we propose a Dual-branch Cross-Temporal Graph Neural Network (DCTGNN) to effectively capture cross-temporal (CT) interactions. Specifically, a CT graph structure is introduced to explicitly model relationships between electrodes (or regions) across different time steps. To extract region-level ST features, we design a dedicated region-level branch that integrates electrode features into brain regions. A region-level CT graph is then constructed to capture region-level ST interactions. Extensive experiments validate the effectiveness of DCTGNN, achieving consistent improvements across the three datasets. Furthermore, CT graph-based analysis reveals that the frontal a},
}

@misc{wei_long_zheng_4900c772314f8900,
  title = {Large-Scale EEG Models For Meditation State Recognition},
  author = {Yingjie Zhang and Mingyu Gou and Zuxin Song and Tianzhen Chen and Fei Cheng and Bao‐Liang Lu and Jiang Du and Wei‐Long Zheng},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11461706},
  url = {https://doi.org/10.1109/icassp55912.2026.11461706},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：用于冥想状态识别的大规模脑电图模型},
  abstract = {Meditation has received widespread attention for its positive effects on mental health. Electroencephalography (EEG) offers a promising objective approach for identifying meditation states; however, traditional EEG analysis models suffer from limited generalizability and dependence on task-specific data. Recently, large-scale EEG models (LEMs) based on self-supervised learning have opened new avenues for EEG analysis by using large-scale pretraining and cross-task transferability. This study provides the first systematic review of LEM architectures and empirically evaluates their effectiveness in the classification of meditation and resting states. Comparative experiments on five representative LEMs (EEGPT, BENDR, BIOT, LaBraM, and Gram) revealed that: (1) LEMs exhibit varying performance across different setups, highlighting the importance of model-task alignment; (2) continued pretraining on the SEED dataset may degrade performance due to negative transfer. In our evaluation, LaBraM-Large achieved the best cross-subject F1 score of 70.49%, while LaBraM-Base reached the highest subject-dependent F1 score of 67.33%, demonstrating the potential of LEMs for practical meditation monitoring, laying an important foundation for objective assessment and intervention technologies in future mental health applications.},
}

