  abstract = {Reconstructing video from brain signals is an important brain decoding task. Existing brain decoding frameworks are primarily built on a subject-dependent paradigm, which requires large amounts of brain data for each subject. However, the expensive cost of collecting brain-video data causes severe data scarcity. Although some cross-subject methods being introduced, they often overfocus with subject-invariant information while neglecting subject-specific information, resulting in slow fine-tune-based adaptation strategy. To achieve fast and data-efficient new subject adaptation, we propose MindCross, a novel cross-subject framework. MindCross's N specific encoders and one shared encoder are designed to extract subject-specific and subject-invariant information, respectively. Additionally, a Top-K collaboration module is adopted to enhance new subject decoding with the knowledge learned from previous subjects' encoders. Extensive experiments on fMRI/EEG-to-video benchmarks demonstrate MindCross's efficacy and efficiency of cross-subject decoding and new subject adaptation using only one model.},
}

@misc{wei_long_zheng_91345f9b2e62c964,
  title = {pMoE: A Prompt-Based Mixture of Expert Model for Unified and Incremental Emotion Recognition},
  author = {Hanwen Shi and Xinhe Gao and Bao‐Liang Lu and Wei‐Long Zheng},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464706},
  url = {https://doi.org/10.1109/icassp55912.2026.11464706},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：pMoE：用于统一和增量情绪识别的基于提示的专家模型混合},
  abstract = {Electroencephalogram (EEG) signals have been widely applied in emotion recognition due to their objectivity. However, both subject-dependent and subject-independent paradigms require building a separate model for each individual, which limits scalability and practical applications. To address this challenge, we propose a prompt-based Mixture-of-Experts (pMoE) model, where the gating mechanism is guided by both internal gating weights and external subject-specific prompts to select the most suitable expert modules. Experimental results demonstrate that our approach achieves superior performance on the SEED-IV, SEED-V, and SEED-VII datasets under a subject-unified setting, reaching accuracies of 78.79%, 76.16%, and 46.67%, respectively, outperforming existing methods. Moreover, pMoE framework exhibits strong incremental learning capabilities, enabling effective adaptation to new subjects without retraining from scratch. These findings highlight the potential of prompt-based expert selection for unified and incremental EEG-based emotion recognition.},
}

