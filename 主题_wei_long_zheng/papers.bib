@misc{wei_long_zheng_c3791dd3f37a,
  title = {Emotion Recognition from Non‐Frontal Facial Images},
  author = {Wenming Zheng and Hao Tang and Thomas S. Huang},
  year = {2015},
  doi = {10.1002/9781118910566.ch8},
  url = {https://doi.org/10.1002/9781118910566.ch8},
  howpublished = {Emotion Recognition},
  annotation = {中文辅助译名：非正面面部图像的情绪识别},
  abstract = {This chapter reviews the recent advances of the current non-frontal facial emotion recognition methods, including the three-dimensional (3D) facial expression recognition and multiview facial expression recognition. It first gives a brief introduction of the facial emotion recognition methods. The chapter then briefly reviews the facial expression databases that are commonly used for the non-frontal facial emotion recognition researches. The method of using of 3D face model for face recognition has been proven to achieve better recognition results than 2D facial images due to its robustness to the poses, scales, and lighting variations. To perform the emotion classification, one may choose a classifier, for example, the support vector machine or Adaboost, and then classify each 3D face model into one of the basic emotion categories based on the geometric features.},
}

