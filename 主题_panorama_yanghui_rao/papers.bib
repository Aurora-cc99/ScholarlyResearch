@misc{panorama_yanghui_rao_67c42f197a99b26e,
  title = {Adaptive Adversarial Training for Balancing Model Robustness and Standard Performance},
  author = {Bin Zhu and Siyu Liu and Yuyin Lu and Jielin Song and Yanghui Rao},
  year = {2026},
  doi = {10.3724/2096-7004.DI.2025.0182},
  url = {https://doi.org/10.3724/2096-7004.DI.2025.0182},
  howpublished = {Data Intell.},
  annotation = {中文辅助译名：用于平衡模型鲁棒性和标准性能的自适应对抗训练},
  abstract = {Adversarial training (AT) is widely used to boost model robustness against adversarial attacks, i.e., adding minor perturbations on the clean input to fool the target model. However, AT can also lead to degraded clean accuracy since it changes the distribution of the training set. Using the Taylor expansion, we find that commonly used adversarial loss functions inherently include clean loss, making it challenging for previous methods to effectively balance the standard performance and robustness. Based on this, we establish a flexible AT framework that can explicitly balance the model robustness and clean accuracy by assigning learnable weights to the clean and adversarial loss components. Comprehensive experimental results indicate that our method boosts model robustness while maintaining comparable standard performance.},
}

@misc{panorama_yanghui_rao_b3350e9ab7be,
  title = {Existentially Consistent Skolemized Reasoning for Complex Query Answering on Knowledge Graphs},
  author = {Yuyin Lu and Hegang Chen and Shanrui Xie and Yanghui Rao and Haoran Xie and Fu Lee Wang and Qing Li},
  year = {2026},
  doi = {10.1145/3799682.3840631},
  url = {https://doi.org/10.1145/3799682.3840631},
  howpublished = {ACM International Conference on Information and Knowledge Management (CIKM)},
  annotation = {中文辅助译名：知识图上复杂查询回答的存在一致 Skolem 化推理},
  abstract = {Complex Query Answering (CQA) over incomplete Knowledge Graphs (KGs) formalizes compositional reasoning as Existential First-Order logic with one free variable (EFO1), where existential variables link multiple atomic constraints within a query. Maintaining existential consistency helps prevent reasoning shortcuts that satisfy only part of these constraints. We identify a Grounding--Skolemization dichotomy in existing CQA approaches. Grounding-based methods preserve logical equivalence but incur combinatorial enumeration costs, whereas Skolemization-based methods enable efficient latent reasoning over KGs while risking reasoning shortcuts arising from existential inconsistency. To address this tradeoff, we propose existentially consistent Skolemized reasoning, instantiated by the Logic-constrained Vector Symbolic Architecture (LVSA). LVSA uses vector-symbolic operations to compose atomic constraints and differentiable Skolemization to construct and reuse a constraint-conditioned latent state for each existential variable. Logical negation is handled through a logic-regularized neural negator. Theoretically, LVSA is structurally expressive for EFO1 queries with acyclic query graphs and offers favorable complexity. Experiments show that LVSA outperforms prior Skolemization-based methods in reasoning performance and empirical existential consistency, while incurring substantially lower inference costs than Grounding-based approaches.},
}

@misc{panorama_yanghui_rao_d6bdd8982c607292,
  title = {Rethinking Reverse KL as Adaptive Entropy Distillation},
  author = {Shizhen Li and Zhiyu Shen and Yuyin Lu and Yunhe Pang and Jielin Song and Yanghui Rao and Fu Lee Wang},
  year = {2026},
  doi = {10.48550/ARXIV.2608.14685},
  url = {https://doi.org/10.48550/ARXIV.2608.14685},
  howpublished = {CoRR},
  annotation = {中文辅助译名：重新思考逆向 KL 作为自适应熵蒸馏},
  abstract = {Knowledge distillation (KD) is widely used to transfer the capabilities of large language models (LLMs) to smaller students, but existing objectives often struggle to balance faithful imitation and robust generation. In particular, existing methods mainly combine FKL and RKL, overlooking that RKL itself provides a mechanism for adjusting the student's imitation strength. Motivated by this, we revisit on-policy Reverse Kullback-Leibler (RKL) distillation and decompose its objective into a teacher-fitting term and a student-entropy term, without introducing an explicit FKL branch. We show theoretically that the token-level optimal student distribution corresponds to a tempered variant of the teacher distribution, where the adaptive weight controls the trade-off between mode-seeking and uncertainty preservation. Guided by this insight, we propose \textbfAdaptive Entropy Distillation (AED), which uses the teacher's entropy to dynamically calibrate token-level imitation strength. Experiments on instruction-following and mathematical reasoning benchmarks demonstrate that AED achieves superior overall performance and generally improves teacher--student distributional and entropy alignment.},
}

@misc{panorama_yanghui_rao_2532203c538ab950,
  title = {HopWeaver: Cross-Document Synthesis of High-Quality and Authentic Multi-Hop Questions},
  author = {Association for Computational Linguistics 2026 and Jiyuan Liu and Yunhe Pang and Yanghui Rao and Zhiyu Shen and Fu Lee Wang and Jie Yu},
  year = {2026},
  doi = {10.18653/V1/2026.ACL-LONG.1295},
  url = {https://doi.org/10.18653/V1/2026.ACL-LONG.1295},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：HopWeaver：高质量和真实的多跳问题的跨文档综合},
  abstract = {Multi-Hop Question Answering (MHQA) is crucial for evaluating the model's capability to integrate information from diverse sources. However, creating extensive and high-quality MHQA datasets is challenging: (i) manual annotation is expensive, and (ii) current synthesis methods often produce simplistic questions or require extensive manual guidance. This paper introduces HopWeaver, the first cross-document framework synthesizing authentic multi-hop questions without human intervention. HopWeaver synthesizes bridge and comparison questions through an innovative pipeline that identifies complementary documents and constructs authentic reasoning paths to ensure true multi-hop reasoning. We further present a comprehensive system for evaluating the synthesized multi-hop questions. Empirical evaluations demonstrate that the synthesized questions achieve comparable or superior quality to human-annotated datasets at a lower cost. Our framework provides a valuable tool for the research community: it can automatically generate challenging benchmarks from any raw corpus, which opens new avenues for both evaluation and targeted training to improve the reasoning capabilities of advanced question answering models, especially in domains with scarce resources.},
}

@misc{panorama_yanghui_rao_da59b94107cdc5d9,
  title = {MemBuilder: Reinforcing LLMs for Long-Term Memory Construction via Attributed Dense Rewards},
  author = {Association for Computational Linguistics 2026 and Fuming Lai and Shaobing Lian and Yanghui Rao and Zhiyu Shen and Ziming Wu},
  year = {2026},
  doi = {10.18653/V1/2026.ACL-LONG.1284},
  url = {https://doi.org/10.18653/V1/2026.ACL-LONG.1284},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：MemBuilder：通过归因密集奖励强化大语言模型的长期记忆构建},
  abstract = {Maintaining consistency in long-term dialogues remains a fundamental challenge for LLMs, as standard retrieval mechanisms often fail to capture the temporal evolution of historical states.While memory-augmented frameworks offer a structured alternative, current systems rely on static prompting of closed-source models or suffer from ineffective training paradigms with sparse rewards.We introduce MemBuilder, a reinforcement learning framework that trains models to orchestrate multi-dimensional memory construction with attributed dense rewards.MemBuilder addresses two key challenges: (1) Sparse Trajectory-Level Rewards: we employ synthetic session-level question generation to provide dense intermediate rewards across extended trajectories; and (2) Multi-Dimensional Memory Attribution: we introduce contribution-aware gradient weighting that scales policy updates based on each component's downstream impact.Experimental results show that MemBuilder enables a 4Bparameter model to outperform state-of-the-art closed-source baselines, exhibiting strong generalization across long-term dialogue benchmarks. 1},
}

@misc{panorama_yanghui_rao_41d4abc5aa167951,
  title = {ReDO: Online Data Selection via Joint Relevance and Diversity Optimization},
  author = {Siyu Liu and Jielin Song and Fu Lee Wang and Yanghui Rao},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464760},
  url = {https://doi.org/10.1109/icassp55912.2026.11464760},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：ReDO：通过联合相关性和多样性优化进行在线数据选择},
  abstract = {Selecting high-quality data is critical for improving the instruction-following capabilities of Large Language Models (LLMs). Existing approaches typically rely on offline, static data selection, which requires expensive pre-computation over the entire dataset and cannot adapt to the model’s evolving knowledge during training. To address this limitation, we propose ReDO, a principled and efficient online data selection framework that integrates coreset selection directly into the training loop. ReDO greedily selects samples using a utility function that balances task relevance and informational diversity. Task relevance prioritizes samples aligned with the gradient subspace of anchor data, while informational diversity reduces redundancy by favoring gradients orthogonal to previously selected samples. Extensive experiments across multiple benchmarks demonstrate that ReDO outperforms existing methods, improving average model performance while reducing inference and training time by at least 8× compared to offline baselines.},
}

