@misc{panorama_fei_su_dba19e9879c2d5b2,
  title = {OILSHALE RESOURCES AND PRIORITIZATION OF EXPLORATION TARGETS IN WESTERN CHINA TO QINGHAI-TIBET AREA},
  author = {Fei Su},
  year = {2009},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=ZIYU200906019},
  howpublished = {Resources and Industries},
  annotation = {中文辅助译名：中国西部青藏地区油页岩资源及优先勘探目标},
  abstract = {The western China to Qinghai-Tibet area covers Gansu,Qinghai,Xinjiang,Tibet and western Sichuan,where distributes lots of sedimentary basins hosting abundant oilshale resources.The oilshale resources reach to 195.263 billion tons in these areas,about 4.44% of the total in China,the oilshale potential is 193.039 billion tons,28.82 of the total in China,indicating a big potential in these areas.The genesis of oilshale can be classified as sapropel,humosapropelic and humic,formed in lakes,marshes and lagoons,where the oilshale is quality,most more than 10% in oil-bearing rate.The oilshales are distributed in the upper Paleozoic,Mesozoic and Cenozoic,becoming younger southwards in oilshale formation ages.This paper,based on a prioritization of exploration targets,selects 9 target areas as most favorable areas,7 as favorable areas,and 4 as sub-favorable areas.},
}

