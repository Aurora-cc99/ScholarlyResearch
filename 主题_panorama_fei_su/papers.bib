@misc{panorama_fei_su_105b7b8f14075d81,
  title = {Underground Economy in China: Size,Causes and Consequence},
  author = {Fei Su},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=JGGB201201010},
  howpublished = {The Journal of Guangxi Economic Management Cadre College},
  annotation = {中文辅助译名：中国地下经济：规模、原因和后果},
  abstract = {The Underground Economy(UE) has formed a considerable size in China,which has great influence on the operation of national economy.This paper investigates the logical status of UE in the whole economic system,gives the estimations of the size of UE in China since 1979 using currency demand method.At the same time,we examine the causes and consequences of UE and its policy implications in China.The empirical results shows: The size of UE accounts for 0.78%—23.28% during 1979—2009;Heavy tax burden and government regulation are the main reasons of UE;UE has positive effect on the official economy,and the growth of UE Granger causes income inequality.},
}

