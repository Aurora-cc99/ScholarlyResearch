  year = {2012},
  doi = {10.1109/ccdc.2012.6244667},
  url = {https://doi.org/10.1109/ccdc.2012.6244667},
  howpublished = {Chinese Control and Decision Conference (CCDC)},
  annotation = {中文辅助译名：高速公路实时质量评价指标设计与分析},
  abstract = {Expressways are the important component to the urban road network. The traffic operation quality evaluation report can provide the traffic managers and users decision supports to alleviate the traffic congestion. This paper designs a new traffic loading degree index and calculation method based on time occupancy to evaluate the real time traffic operation quality. Based on huge amounts of traffic data detected from Beijing Expressways, the reference thresholds of the new index are determined to represent different traffic statuses. The experiment analysis using the data from 2ndRing Road in Beijing illuminates the method of effectivity and practicability.},
}

@misc{panorama_fei_su_776b36d5f4e2b83a,
