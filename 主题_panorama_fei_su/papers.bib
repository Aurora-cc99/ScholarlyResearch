@misc{panorama_fei_su_54efbb867cd51458,
  title = {Machine learning classification of cellular states based on the impedance features derived from microfluidic single-cell impedance flow cytometry},
  author = {Jian Wei and Wenbing Gao and Xinlong Yang and Zhuotong Yu and Fei Su and Chengwu Han and Xiaoxing Xing},
  year = {2024},
  doi = {10.1063/5.0181287},
