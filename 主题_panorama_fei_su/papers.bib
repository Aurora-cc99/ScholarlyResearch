@misc{panorama_fei_su_eaf0ec2f5b4240a2,
  title = {Remote Sensing Recognition of Alkaline Basalt in the Taxkorgan Area in Xinjiang and its Geological Structure Implication in the Early Triassic},
  author = {Shichao Lu and Shizhong Chen and Hongfei Shen and ZhongFei PAN and Guoliang Yang and Fei Su},
  year = {2025},
  doi = {10.17491/jgsi/2025/174272},
  url = {https://doi.org/10.17491/jgsi/2025/174272},
  howpublished = {Journal of the Geological Society of India},
  annotation = {中文辅助译名：新疆塔什库尔干地区早三叠世碱性玄武岩遥感识别及其地质构造意义},
  abstract = {ABSTRACT The Taxkorgan area in Xinjiang is located in the northwestern part of the Tibetan Plateau and the eastern part of the Pamir Plateau. It is a tectonic suture zone where the Indian Plate collided with the Eurasian Plate, and the Palaeo-Tethys Ocean closed here. However, due to the harsh natural conditions of the area, the level of research is relatively low, resulting in an insufficient understanding of the tectonic evolution of the PalaeoTethys Ocean. Through the analysis of Worldview-2 remote sensing images, a set of basalts with a NW-SE linear distribution was discovered in the Taxkorgan area. Studies on the isotopic geochronology and geochemical characteristics of these basalts show that the Taxkorgan basalts have formation ages of 241±2.9 Ma and 251.9±2 Ma, dating back to the Early Triassic. They are alkaline basalts with Oceanic Island Basalt (OIB) characteristics. The magma underwent a certain degree of crustal contamination and originated from the partial melting of garnet-spinel lherzolite in the EII enriched mantle. This indicates that the Palaeo-Tethys Ocean had not yet closed during the Early Triassic, and oceanic crust construction still existed in this area, possibly representing a remnant of the Palaeo-Tethys Oceanic crust.},
}

