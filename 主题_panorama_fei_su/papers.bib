  abstract = {A fuzzy based algorithm for contrast enhancement of fingerprint ima ge and edge detection is presented. In this method a fuzzy edge detector is fir s t applied to make soft decision on degree of belonging to edge for each pixel. A ccording to these decisions and fingerprint orientation image, image contrast is enhanced without significant noise enhancement. Experimental results demons trat e that this method is effective in performing detail sharpening and removin g noi se without destroying the useful information contained in a fingerprint im age.},
}

@misc{panorama_fei_su_851e518e17de7696,
  title = {Quantitative investigation of chemical shrinkage stress in flip chip using a 3D moire interferometry system},
  author = {Fei Su and Lie Liu and Sung Yi and K. S. Chian},
  year = {2002},
  doi = {10.1117/12.473561},
  url = {https://doi.org/10.1117/12.473561},
  howpublished = {Proceedings of SPIE, the International Society for Optical Engineering/Proceedings of SPIE},
  annotation = {中文辅助译名：使用 3D 莫尔干涉测量系统定量研究倒装芯片中的化学收缩应力},
  abstract = {Thermo-mechanical reliability is a key issue of IC packaging. In this paper, the chemical shrinkage stress caused by the underfill curing is quantitatively investigated: DSC test result provides the basis for the determination of temperature profile for the curing of underfill. The 3D deformation of the flip chip during the underfill curing process is measured with 3D Moire interferometry system. Also a simple theoretical model is set up for this problem, DMA test provide the necessary parameters for this model. The experimental and theoretical results agree well with each other, both results show that the chemical shrinkage stress is fairly small when compared with the thermal residual stress, so this part of residual stress can be neglected in the commonly used finite element analysis (FEA) model.},
}

