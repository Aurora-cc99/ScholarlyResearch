@misc{sidney_dmello_5a8f87e3efc20df3,
  title = {A Responsible Human-Centered Design of Student Engagement Visualizations for Collective Reflection in Classrooms},
  author = {Sidney K. D'Mello and Thomas Breideband and Sandra Sawaya and Chelsea Brown and Ashieda McKoy},
  year = {2026},
  doi = {10.1109/ACIIW71585.2026.11712119},
  url = {https://doi.org/10.1109/ACIIW71585.2026.11712119},
  howpublished = {ACIIW},
  annotation = {中文辅助译名：负责任的以人为本的学生参与可视化设计，以促进课堂集体反思},
  abstract = {In this paper we present Talk Trees, a human-centered Artificial Intelligence (HCAI) tool designed to support shared classroom reflection on student discourse as an indicator of their level of engagement. Rather than treating students as passive sources of data or positioning educators as the sole recipients of feedback, the Talk Trees tool reframes feedback as a collective activity involving the entire classroom community in collective interpretation and goal-setting. We describe the principled sociotechnical process of designing Talk Trees across multiple layers of data collection, discourse model development, student discourse visualization, and classroom use. Our design process emphasizes how technical constraints and HCAI guiding principles shaped key design decisions. The design of the Talk Trees tool contributes a case study for responsible affective HCAI by showing how classroom AI tools can be designed to support privacy, interpretability, and student and educator agency.},
}

