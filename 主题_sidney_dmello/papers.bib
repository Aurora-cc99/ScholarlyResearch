@misc{sidney_dmello_3abf808b85596ac6,
  title = {Cortical cognitive processing during reading captured using functional-near infrared spectroscopy},
  author = {Marta Čeko and Leanne Hirshfield and Emily J. Doherty and Rosy V. Southwell and Sidney K. D’Mello},
  year = {2024},
  doi = {10.1038/s41598-024-69630-x},
  url = {https://doi.org/10.1038/s41598-024-69630-x},
  howpublished = {Scientific Reports},
  annotation = {中文辅助译名：使用功能近红外光谱捕获阅读期间的皮质认知处理},
  abstract = {Neuroimaging studies using functional magnetic resonance imaging (fMRI) have provided unparalleled insights into the fundamental neural mechanisms underlying human cognitive processing, such as high-level linguistic processes during reading. Here, we build upon this prior work to capture sentence reading comprehension outside the MRI scanner using functional near infra-red spectroscopy (fNIRS) in a large sample of participants (n = 82). We observed increased task-related hemodynamic responses in prefrontal and temporal cortical regions during sentence-level reading relative to the control condition (a list of non-words), replicating prior fMRI work on cortical recruitment associated with high-level linguistic processing during reading comprehension. These results lay the groundwork towards developing adaptive systems to support novice readers and language learners by targeting the underlying cognitive processes. This work also contributes to bridging the gap between laboratory findings and more real-world applications in the realm of cognitive neuroscience.},
}

@misc{sidney_dmello_d9d3cea1e4236021,
  title = {Characterizing Learners' Complex Attentional States During Online Multimedia Learning Using Eye-tracking, Egocentric Camera, Webcam, and Retrospective recalls},
  author = {Minh Hoai and Brian Howatt and Prasanth Chandran and Lindsey Wilson and Brayden Wallace and Jeremy Munsell and Lester C. Loschky and Sidney K. D'Mello and Yifeng Huang and N. Sanjay Rebello},
  year = {2024},
  doi = {10.1145/3649902.3653939},
  url = {https://doi.org/10.1145/3649902.3653939},
  howpublished = {ETRA},
  annotation = {中文辅助译名：使用眼动追踪、自我中心相机、网络摄像头和回顾性回忆来表征在线多媒体学习期间学习者的复杂注意力状态},
  abstract = {As online learning becomes increasingly ubiquitous, a key challenge is maintaining learners' sustained attention. Using eye-tracking, together with observing and interviewing learners, we can characterize both 1) whether they are looking at their learning materials, and 2) whether they are thinking about them. Critically, eye-tracking only speaks to the first distinction, not the second. To overcome this limitation, we supplemented eye-tracking with an egocentric camera, a webcam, a retrospective recall, and mind-wandering probes to capture a 2×2 matrix of attentional/cognitive states. We then categorized N=101 learners' attentional/cognitive states while they completed a multimedia physics module. This meets two goals: 1) allowing basic research to understand the relationship between attentional/cognitive states and behavioral outcomes; and 2) facilitating applied research by generating rich ground truth for future use in training machine learning to categorize this 2×2 set of attentional states, for which eye-tracking is necessary, but not sufficient.},
}

