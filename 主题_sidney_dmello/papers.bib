@misc{sidney_dmello_73edd71c752a07c3,
  title = {Emotional Learning Analytics},
  author = {Sidney K. D’Mello},
  year = {2017},
  doi = {10.18608/hla17.010},
  url = {https://doi.org/10.18608/hla17.010},
