@misc{sidney_dmello_3445ae4fd102e225,
  title = {Meta-Knowledge in Tutoring},
  author = {Arthur C. Graesser and Sidney K. D’Mello and Natalie K. Person},
  year = {2009},
  doi = {10.4324/9780203876428-28},
