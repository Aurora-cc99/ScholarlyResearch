@misc{sidney_dmello_edd89ce6742d97e7,
  title = {Why High School Grades Are Better Predictors of On-Time College Graduation Than Are Admissions Test Scores: The Roles of Self-Regulation and Cognitive Ability},
  author = {Brian M. Galla and Elizabeth P. Shulman and Benjamin D. Plummer and Margo Gardner and Stephen J. Hutt and J. Parker Goyer and Sidney K. D’Mello and Amy S. Finn and Angela Lee Duckworth},
  year = {2019},
  doi = {10.3102/0002831219843292},
  url = {https://doi.org/10.3102/0002831219843292},
  howpublished = {American Educational Research Journal},
  annotation = {中文辅助译名：为什么高中成绩比入学考试成绩更能预测大学按时毕业：自我调节和认知能力的作用},
  abstract = {Compared with admissions test scores, why are high school grades better at predicting college graduation? We argue that success in college requires not only cognitive ability but also self-regulatory competencies that are better indexed by high school grades. In a national sample of 47,303 students who applied to college for the 2009/2010 academic year, Study 1 affirmed that high school grades out-predicted test scores for 4-year college graduation. In a convenience sample of 1,622 high school seniors in the Class of 2013, Study 2 revealed that the incremental predictive validity of high school grades for college graduation was explained by composite measures of self-regulation, whereas the incremental predictive validity of test scores was explained by composite measures of cognitive ability.},
}

@misc{sidney_dmello_8bc04b823f4cb556,
  title = {I Say, You Say, We Say: Using Spoken Language to Model Socio-Cognitive Processes during Computer-Supported Collaborative Problem Solving},
  author = {Valerie J. Shute and Chen Sun and Angela Stewart and Jade Yonehiro and Cathlyn Stone and Sidney K. D'Mello and Nicholas D. Duran and Hana Vrzakova},
  year = {2019},
  doi = {10.1145/3359296},
  url = {https://doi.org/10.1145/3359296},
  howpublished = {Proc. ACM Hum. Comput. Interact.},
  annotation = {中文辅助译名：我说，你说，我们说：在计算机支持的协作问题解决过程中使用口语对社会认知过程进行建模},
  abstract = {Collaborative problem solving (CPS) is a crucial 21st century skill; however, current technologies fall short of effectively supporting CPS processes, especially for remote, computer-enabled interactions. In order to develop next-generation computer-supported collaborative systems that enhance CPS processes and outcomes by monitoring and responding to the unfolding collaboration, we investigate automated detection of three critical CPS process ? construction of shared knowledge, negotiation/coordination, and maintaining team function ? derived from a validated CPS framework. Our data consists of 32 triads who were tasked with collaboratively solving a challenging visual computer programming task for 20 minutes using commercial videoconferencing software. We used automatic speech recognition to generate transcripts of 11,163 utterances, which trained humans coded for evidence of the above three CPS processes using a set of behavioral indicators. We aimed to automate the trained human-raters' codes in a team-independent fashion (current study) in order to provide automatic real-time or offline feedback (future work). We used Random Forest classifiers trained on the words themselves (bag of n-grams) or with word categories (e.g., emotions, thinking styles, social constructs) from the Linguistic Inquiry Word Count (LIWC) tool. Despite imperfect automatic speech recognition, the n-gram models achieved AUROC (area under the receiver operating characteristic curve) scores of .85, .7},
}

@misc{sidney_dmello_6150165b8d50541e,
  title = {A Multisensor Person-Centered Approach to Understand the Role of Daily Activities in Job Performance with Organizational Personas},
  author = {Gonzalo J. Martínez and Kaifeng Jiang and Anind K. Dey and Pablo Robles-Granda and Gloria Mark and Koustuv Saha and Louis Tay and Subigya Nepal and Hemang Rajvanshy and Edward Moskal and Suwen Lin and Stephen M. Mattingly and Raghu Mulukutla and Shayan Mirjafari and Anusha Sirigiri and Manikanta D. Reddy and Vedant Das Swain and Julie M. Gregg and Aaron Striegel and Sidney K. D'Mello and Andrew T. Campbell and Munmun De Choudhury and Nitesh V. Chawla and Kari Nies and Qiang Liu and Gregory D. Abowd},
  year = {2019},
