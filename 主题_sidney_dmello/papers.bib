@misc{rosalind_picard_c4c7e8b15bef00c5,
  title = {Toward an Affect-Sensitive AutoTutor},
  author = {Arthur C. Graesser and Sidney K. D'Mello and Rosalind W. Picard},
  year = {2007},
  doi = {10.1109/MIS.2007.79},
  url = {https://doi.org/10.1109/MIS.2007.79},
  howpublished = {IEEE Intell. Syst.},
  annotation = {中文辅助译名：走向情感敏感的自动辅导员},
  abstract = {Here, we consider the possibility of enabling AutoTutor, an intelligent tutoring system, to process learners' affective and cognitive states. AutoTutor is a fully automated computer tutor that simulates human tutors and converses with students in natural language.},
}

@misc{sidney_dmello_171503b80491d470,
  title = {RFID Tag Characterization in a GHz Transverse Electromagnetic Cell},
  author = {Sidney K. D’Mello and Divya Choudhary and Srikant K. Chari and James Markham and Lee McCauley},
  year = {2007},
  doi = {10.1109/soli.2007.4383935},
  url = {https://doi.org/10.1109/soli.2007.4383935},
  howpublished = {IEEE International Conference on Service Operations and Logistics, and Informatics (SOLI)},
  annotation = {中文辅助译名：GHz 横向电磁单元中的 RFID 标签表征},
  abstract = {This paper presents results from a study that attempted to characterize the performance of RFID tags in a GHz Transverse Electromagnetic (GTEM) cell in which an approximately constant electro magnetic (EM) field potentially free of any extraneous interference was maintained. Performance of four commercially available RFID tags manufactured by different vendors was characterized on the basis of horizontal directivity, vertical directivity, sensitivity, and frequency characteristics.},
}

