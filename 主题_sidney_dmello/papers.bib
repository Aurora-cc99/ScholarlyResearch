@misc{sidney_dmello_7b8c2e5e088e80a8,
  title = {Frontiers of Affect-Aware Learning Technologies},
  author = {Sidney K. D'Mello and Rafael A. Calvo},
  year = {2012},
  doi = {10.1109/MIS.2012.110},
  url = {https://doi.org/10.1109/MIS.2012.110},
