@misc{sidney_dmello_7fad478fbac1fd8f,
  title = {Social Media as a Passive Sensor in Longitudinal Studies of Human Behavior and Wellbeing},
  author = {Ge Gao and Gonzalo J. Martínez and Anind K. Dey and Koustuv Saha and Gloria Mark and Krithika Jagannath and Edward Moskal and Julie M. Gregg and Sidney K. D'Mello and Anusha Sirigiri and Dong Whi Yoo and Stephen M. Mattingly and Nitesh V. Chawla and Munmun De Choudhury and Andrew T. Campbell and Aaron Striegel and A. Elvan Bayraktaroglu},
  year = {2019},
  doi = {10.1145/3290607.3299065},
  url = {https://doi.org/10.1145/3290607.3299065},
  howpublished = {CHI Extended Abstracts},
  annotation = {中文辅助译名：社交媒体作为人类行为和福祉纵向研究中的被动传感器},
  abstract = {Social media serves as a platform to share thoughts and connect with others. The ubiquitous use of social media also enables researchers to study human behavior as the data can be collected in an inexpensive and unobtrusive way. Not only does social media provide a passive means to collect historical data at scale, it also functions as a "verbal" sensor, providing rich signals about an individual's social ecological context. This case study introduces an infrastructural framework to illustrate the feasibility of passively collecting social media data at scale in the context of an ongoing multimodal sensing study of workplace performance (N=757). We study our dataset in its relationship with demographic, personality, and wellbeing attributes of individuals. Importantly, as a means to study selection bias, we examine what characterizes individuals who choose to consent to social media data sharing vs. those who do not. Our work provides practical experiences and implications for research in the HCI field who seek to conduct similar longitudinal studies that harness the potential of social media data.},
}

@misc{sidney_dmello_8d69bc0b3fcc4eea,
  title = {Dynamics of Visual Attention in Multiparty Collaborative Problem Solving using Multidimensional Recurrence Quantification Analysis},
  author = {Mary Jean Amon and Angela Stewart and Sidney K. D'Mello and Hana Vrzakova},
  year = {2019},
  doi = {10.1145/3290605.3300572},
  url = {https://doi.org/10.1145/3290605.3300572},
  howpublished = {CHI},
  annotation = {中文辅助译名：使用多维递归量化分析多方协作解决问题中的视觉注意动态},
  abstract = {Multiparty collaborative problem solving - an increasingly important context in the 21st century workforce - suffers from a degradation of social and behavioral signals when attempted remotely, resulting in suboptimal outcomes. We investigate teams' multidimensional patterns of visual attention during a collaborative problem-solving task with an eye for leveraging insights to improve collaborative interfaces. Fifty-seven novices (forming 19 triads) engaged in a challenging programming task (Minecraft Hour of Code) using videoconferencing software with screen sharing. To discover patterns of individual-level gaze-UI coupling(coordination of a teammate's attention with respect to changes in the user interface) and team-level gaze-UI regularity (dynamics of teams' collective attention in context with changes in the user interface), we applied cross- and multidimensional recurrence quantification analyses, respectively. Individuals' eye gaze was significantly coupled with the ongoing screen activity whereas teams displayed significant patterns of gaze regularity, suggesting repetitive patterns in teams' attention. These measures predicted expert-coded collaborative processes of constructing shared knowledge and negotiation and coordination (but not maintaining team function) and correlated with task score (r = .425). They also predicted individually assessed subjective perceptions of team performance and the collaboration process, but not individual's learning or team's task scor},
}

@misc{sidney_dmello_0e67adc500e24eec,
  title = {Differentiating Higher and Lower Job Performers in the Workplace Using Mobile Sensing},
  author = {Anind K. Dey and Pablo Robles-Granda and Kizito Masaba and Krithika Jagannath and Kaifeng Jiang and Ge Gao and Ted Grover and Gonzalo J. Martínez and Koustuv Saha and Gloria Mark and Vedant Das Swain and Anusha Sirigiri and Weichen Wang and Julie M. Gregg and Stephen M. Mattingly and Subigya Nepal and Raghu Mulukutla and Edward Moskal and Manikanta D. Reddy and Shayan Mirjafari and Suwen Lin and Nitesh V. Chawla and Qiang Liu and Munmun De Choudhury and Sidney K. D'Mello and Pino G. Audia and Kari Nies and Aaron Striegel and Andrew T. Campbell},
  year = {2019},
  doi = {10.1145/3328908},
  url = {https://doi.org/10.1145/3328908},
  howpublished = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
  annotation = {中文辅助译名：使用移动传感区分工作场所中工作表现较高和较低的人},
  abstract = {Assessing performance in the workplace typically relies on subjective evaluations, such as, peer ratings, supervisor ratings and self assessments, which are manual, burdensome and potentially biased. We use objective mobile sensing data from phones, wearables and beacons to study workplace performance and offer new insights into behavioral patterns that distinguish higher and lower performers when considering roles in companies (i.e., supervisors and non-supervisors) and different types of companies (i.e., high tech and consultancy). We present initial results from an ongoing year-long study of N=554 information workers collected over a period ranging from 2-8.5 months. We train a gradient boosting classifier that can classify workers as higher or lower performers with AUROC of 0.83. Our work opens the way to new forms of passive objective assessment and feedback to workers to potentially provide week by week or quarter by quarter guidance in the workplace.},
}

