@misc{fu_xiaolan_e93ae42fcea3ae13,
  title = {Are Nouns Learned Before Verbs? Infants Provide Insight Into a Long-Standing Debate},
  author = {Sandra R. Waxman and Xiaolan Fu and Sudha Arunachalam and Erin M. Leddon and Kathleen Geraghty and Hyun-Joo Song},
  year = {2013},
  doi = {10.1111/cdep.12032},
  url = {https://doi.org/10.1111/cdep.12032},
  howpublished = {Child Development Perspectives},
  annotation = {中文辅助译名：名词是先学还是动词？婴儿为长期争论提供了见解},
  abstract = {For decades, a spirited debate has existed over whether infants' remarkable capacity to learn words is shaped primarily by universal features of human language or by specific featuers of the particulare native language they are acquiring. A strong focus for this debate has been a well-documented difference in early word learning: Infants' success in learning verbs lags behind their success in learning nouns.. In this review, we articulate both sides of the debate and summarize new cross-linguistic evidence from infants that underscores the role of universal features and begins to clarify the impact of distinctly different languages on early language and conceptual development.},
}

