@misc{fu_xiaolan_9b3f5c46a6d91522,
  title = {The influence of expertise and of physical complexity on visual short-term memory consolidation},
  author = {Huiming Sun and Hubert D. Zimmer and Xiaolan Fu},
  year = {2010},
