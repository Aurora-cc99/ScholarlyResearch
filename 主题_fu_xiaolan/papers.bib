  author = {Alessandro Aiuti and Blanca Amador-Borrero and Juan-Manuel Amaya and Anderson, Mark S. and Dany Anglicheau and Juan-Manuel Anaya and Dany Anglicheau and Andrés Augusto Arias and Romain Arrestier and Hagit Baris Feldman and Lucila Akune Barreiros and Paul Bastard and Alexandre Bélot and Diederik van de Beek and Vivien Béziat and Catherine M. Biggs and Kaya Bilgüvar and Andrea Biondi and Lucy Bizien and Bertrand Boisson and Anastasiia Bondarenko and Paolo Bonfanti and Soraya Boucherit and Ahmed A. Bousfiha and Nollaig M. Bourke and Oksana Boyarchuk and James D. Brien and Charles Burdet and Sonia Burrel and Andrés Augusto Arias},
  year = {2025},
  doi = {10.1073/pnas},
  url = {https://doi.org/10.1073/pnas},
  howpublished = {Fu Xiaolan official SJTU publication list},
  annotation = {中文辅助译名：任务难度调节心智游移对相位动态的影响。 PNAS，122（22），e2416387122，doi：10.1073/pnas.2416387122},
  abstract = {La infección por SARS-CoV-2 ha causado más de 250 millones de casos y al menos 5 millones de muertes a nivel mundial. La variabilidad clínica es amplia, desde infecciones asintomáticas hasta síndrome de dificultad respiratoria aguda y muerte en aproximadamente el 1% de los casos. La edad y el sexo masculino son los principales predictores epidemiológicos de mortalidad. Estudios del COVID Human Genetic Effort han demostrado que la inmunidad mediada por interferón tipo I (IFN-I) es esencial para la protección frente al SARS-CoV-2. Se han identificado errores congénitos en la inmunidad dependiente de TLR3, así como deficiencias autosómicas recesivas en genes como IFNAR1 e IRF7, y deficiencia ligada al cromosoma X en TLR7, como causas de COVID-19 crítico en pacientes jóvenes. Estos hallazgos resaltan la importancia de la integridad de las vías de señalización de IFN-I en la defensa contra la enfermedad grave.},
}

