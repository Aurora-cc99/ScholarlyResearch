@misc{fu_xiaolan_9e3663664a0eed46,
  title = {”I can’t name it, but I can perceive it” Conceptual and Operational Design of ”Tactile Accuracy” Assisting Tactile Image Cognition},
  author = {Jiangtao Gong and Wenyuan Yu and Long Ni and Yang Jiao and Ye Liu and Xiaolan Fu and Yingqing Xu},
  year = {2020},
  doi = {10.1145/3373625.3417015},
