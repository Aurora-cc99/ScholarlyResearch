  year = {2023},
  doi = {10.1109/csis-iac60628.2023.10364071},
  url = {https://doi.org/10.1109/csis-iac60628.2023.10364071},
  howpublished = {International Annual Conference on Complex Systems and Intelligent Science (CSIS-IAC)},
  annotation = {中文辅助译名：基于卷积神经网络和数据增强的蒙面面部表情识别},
  abstract = {People sometimes intentionally change their facial expressions to mask their real emotions. Currently, there is relatively little research on the recognition of masked expressions. The effective identification of masked expressions helps to identify deception and lies and has important application value. Traditional machine learning methods require the manual design of feature extraction algorithms and have poor performance in facial expression recognition. This study performs masked expression recognition based on convolutional neural networks, including VGGNet, GoogLeNet, ResNet, and MobileNet. Data augmentation and regularization are used to improve the performance of the network. The recognition rate of masked expressions has been significantly improved. Using leave-one-subject-out cross-validation, the recognition accuracy is 63.62% for required expressions (6R), 39.97% for experienced emotions evoked by video clips (6E), and 22.11% for 36 mixed expressions (6Ex6R), which is improved by 33.19%, 48.99%, and 96.52% compared to traditional methods, respectively.},
}

@misc{fu_xiaolan_c98f432da914,
  title = {Recognition of Masked Facial Expressions Based on Transfer Learning and Data Augmentation},
  author = {Yonggang Liu and Ke Zhao and Xiaolan Fu},
  year = {2023},
  doi = {10.1109/csis-iac60628.2023.10364081},
  url = {https://doi.org/10.1109/csis-iac60628.2023.10364081},
  howpublished = {2023 International Annual Conference on Complex Systems and Intelligent Science (CSIS-IAC)},
  annotation = {中文辅助译名：基于迁移学习和数据增强的蒙面面部表情识别},
  abstract = {Facial expression recognition is currently one of the research hotspots in the field of artificial intelligence. In addition to normal natural expressions, people sometimes intentionally change their facial expressions to mask their real emotions. Masked expressions are more complex than ordinary expressions, and the number of masked expression datasets that can be used for model training is limited. The automatic recognition of masked expressions will be a new challenge. Traditional machine learning requires the manual design of feature extraction algorithms, resulting in low expression recognition rates. Deep learning requires a large amount of labeled data and has poor model performance on small sample datasets. This paper proposes a method based on transfer learning, which transfers the pre-trained weights to the model, reconstructs the classifier to complete new tasks, and combines data augmentation and regularization to improve the robustness and generalization ability of the model. It has achieved good results on the Masked Facial Expression Database (MFED). Using leave-one-subject-out cross-validation, the recognition accuracy is 64.78% for required expressions (6R), 42.16% for experienced emotions evoked by video clips (6E), and 21.21% for 36 mixed expressions (6Ex6R), which is improved by 35.61%, 57.14%, and 88.52% compared to traditional methods, respectively. The experiment deepens the research on the recognition of masked expressions, providing a possible method },
}

@misc{fu_xiaolan_c03ec0ba3c690fa3,
  title = {Acute psychosocial stress weakens the sense of agency in healthy adults},
  author = {Yayun Chu and Guan‐Hua Huang and Yunyun Li and Qin Chen and Jiajia Liu and Ke Zhao and Xiaolan Fu},
  year = {2023},
  doi = {10.1080/10253890.2023.2195511},
  url = {https://doi.org/10.1080/10253890.2023.2195511},
  howpublished = {Stress},
  annotation = {中文辅助译名：急性社会心理压力会削弱健康成年人的代理感},
  abstract = {The sense of agency (SoA) refers to the feeling of being in control of one's actions and the subsequent consequence of these actions. Emotional context seems to alter the strength of sense of agency. The present study explored the influence of acute psychosocial stress on the SoA by means of the Trier Social Stress Test (TSST). Self-assessment manikin (SAM) and objective physiological indicators (e.g. heart rate, electrodermal activity, and salivary cortisol levels) were utilized to evaluate the effect of the TSST. We also employed the temporal binding effect as an implicit assessment of the participant's SoA. The results indicated that the stress level of the experimental group after TSST was significantly higher than the control group, whilst the temporal binding scores of the experimental group decreased after TSST manipulation. In short, acute psychosocial stress with intense emotional arousal weakened the sense of agency.},
}

@misc{fu_xiaolan_d1bd40bbf930343b,
  title = {Decoding the temporal representation of facial expression in face-selective regions},
