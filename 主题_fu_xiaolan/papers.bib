@misc{fu_xiaolan_899f16bc5051ff80,
  title = {Word Familiarity Modulates the Interference Effects of Mind Wandering on Semantic and Reafferent Information Processing},
  author = {Zhengkun Long and Qiufang Fu and Xiaolan Fu},
