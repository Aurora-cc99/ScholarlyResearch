  author = {MENG Xianxin and YAN Chen and YU Delin and GAO Shuling and Xiaolan Fu},
  year = {2024},
  doi = {10.3724/sp.j.1042.2024.01087},
  url = {https://doi.org/10.3724/sp.j.1042.2024.01087},
