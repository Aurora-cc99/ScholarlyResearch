@misc{klaus_robert_muller_f1e92180f542a0b5,
  title = {In Search of Non-Gaussian Components of a High-Dimensional Distribution},
  author = {Masashi Sugiyama and Motoaki Kawanabe and Gilles Blanchard and Klaus-Robert Müller and Vladimir G. Spokoiny},
  year = {2006},
  doi = {10.18452/3970},
  url = {http://sfb649.wiwi.hu-berlin.de/papers/pdf/SFB649DP2006-040.pdf},
  howpublished = {J. Mach. Learn. Res.},
  annotation = {中文辅助译名：搜索高维分布的非高斯分量},
  abstract = {Finding non-Gaussian components of high-dimensional data is an important preprocessing step for effcient information processing. This article proposes a new linear method to identify the ``non-Gaussian subspace´´ within a very general semi-parametric framework. Our proposed method, called NGCA (Non-Gaussian Component Analysis), is essentially based on a linear operator which, to any arbitrary nonlinear (smooth) function, associates a vector which belongs to the low dimensional non-Gaussian target subspace up to an estimation error. By applying this operator to a family of different nonlinear functions, one obtains a family of different vectors lying in a vicinity of the target space. As a final step, the target space itself is estimated by applying PCA to this family of vectors. We show that this procedure is consistent in the sense that the estimaton error tends to zero at a parametric rate, uniformly over the family, Numerical examples demonstrate the usefulness of our method.},
}

@misc{klaus_robert_muller_ef49071917d5d66e,
  title = {Enhancing the signal-to-noise ratio of ICA-based extracted ERPs},
  author = {Yevhen Hlushchuk and Gabriel Curio and Steven Lemm and Klaus-Robert Müller},
  year = {2006},
  doi = {10.1109/TBME.2006.870258},
  url = {https://doi.org/10.1109/TBME.2006.870258},
  howpublished = {IEEE Trans. Biomed. Eng.},
  annotation = {中文辅助译名：提高基于 ICA 提取的 ERP 的信噪比},
  abstract = {When decomposing single trial electroencephalography it is a challenge to incorporate prior physiological knowledge. Here, we develop a method that uses prior information about the phase-locking property of event-related potentials in a regularization framework to bias a blind source separation algorithm toward an improved separation of single-trial phase-locked responses in terms of an increased signal-to-noise ratio. In particular, we suggest a transformation of the data, using weighted average of the single trial and trial-averaged response, that redirects the focus of source separation methods onto the subspace of event-related potentials. The practical benefit with respect to an improved separation of such components from ongoing background activity and extraneous noise is first illustrated on artificial data and finally verified in a real-world application of extracting single-trial somatosensory evoked potentials from multichannel EEG-recordings.},
}

@misc{klaus_robert_muller_d0e6d0618b40e8a7,
  title = {Obtaining the Best Linear Unbiased Estimator of Noisy Signals by Non-Gaussian Component Analysis},
  author = {Gilles Blanchard and Masashi Sugiyama and Motoaki Kawanabe and Vladimir G. Spokoiny and Klaus-Robert Müller},
  year = {2006},
  doi = {10.1109/ICASSP.2006.1660727},
  url = {https://doi.org/10.1109/ICASSP.2006.1660727},
  howpublished = {ICASSP (3)},
  annotation = {中文辅助译名：通过非高斯分量分析获得噪声信号的最佳线性无偏估计器},
  abstract = {Obtaining the best linear unbiased estimator (BLUE) of noisy signals is a traditional but powerful approach to noise reduction. Explicitly computing BLUE usually requires the prior knowledge of the subspace to which the true signal belongs and the noise covariance matrix. However, such prior knowledge is often unavailable in reality, which prevents us from applying BLUE to real-world problems. In this paper, we therefore give a method for obtaining BLUE without such prior knowledge. Our additional assumption is that the true signal follows a non-Gaussian distribution while the noise is Gaussian},
}

@misc{klaus_robert_muller_f94e4d2d08ad6ed9,
  title = {Brain state differences between calibration and application periods influence BCI classification accuracy},
  author = {Florian Losch and Benjamin Blankertz and Matthias Krauledat and K. Robert Müller and Gabriel Curio},
  year = {2006},
  doi = {10.1055/s-2006-953100},
  url = {https://doi.org/10.1055/s-2006-953100},
  howpublished = {Aktuelle Neurologie},
  annotation = {中文辅助译名：校准和应用周期之间的大脑状态差异会影响 BCI 分类准确性},
  abstract = {Introduction: Non-invasive Brain-Computer Interfaces (BCI) translate a user's intent into technical control signals without relying on peripheral nerves and muscles. The Berlin-BCI application uses a calibration period to train machine learning algorithms for the classification of single-trial brain signals indicating specific motor intentions. These signals are then used in diverse application scenarios where the classifier output is fed back to the user, e.g., by a cursor movement. Here, we analyse possible reasons why the BCI classification accuracy can differ between calibration and feedback trials. Methods: Nine healthy subjects imagined unilateral hand or foot movements following screen prompts (R: right hand; L: left hand; F: right foot). After fitting three pairwise classifiers (RL, RF, LF) to the 128-channel EEG calibration data (four runs of 10min each) the most accurate one was utilized in five feedback runs (10min each): the classifier output was translated into the horizontal position of a cursor which started in a central position and must be navigated by imagined movements into a highlighted target field situated either on the left or right screen edge, while the opposite edge holds a non-target field. The trial ended when the cursor touched one field which then was colored green (if target) or red (if non-target). To assess the stationarity of brain states between calibration and feedback periods we compared (a) global band power values, and (b) 2D-projections},
}

