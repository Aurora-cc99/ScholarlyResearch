@misc{klaus_robert_muller_033de0ca8f39e94b,
  title = {Predicting Error Bars for QSAR Models},
  author = {Timon Sebastian Schroeter and Anton Schwaighofer and Sebastian Mika and Antonius ter Laak and Detlev Suelzle and Ursula Ganzer and Nikolaus Heinrich and Klaus‐Robert Müller and Arno P. J. M. Siebes and Michael R. Berthold and Robert C. Glen and Ad Feelders},
  year = {2007},
