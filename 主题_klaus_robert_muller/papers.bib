@misc{klaus_robert_muller_aa336665c52b91ba,
  title = {Faculty Opinions recommendation of A Benchmark Dataset for SSVEP-Based Brain-Computer Interfaces},
  author = {Klaus‐Robert Müller},
  year = {2017},
