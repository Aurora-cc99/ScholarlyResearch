@misc{klaus_robert_muller_07d01942915480d4,
  title = {xCG: Explainable Cell Graphs for Survival Prediction in Non-Small Cell Lung Cancer},
  author = {Kai Standvoss and Maximilian Alber and Frederick Klauschen and Lukas Ruff and Simon Schallenberg and Gabriel Dernbach and Marvin Sextro and Klaus-Robert Müller},
  year = {2024},
  doi = {10.48550/ARXIV.2411.07643},
  url = {https://doi.org/10.48550/ARXIV.2411.07643},
  howpublished = {CoRR},
  annotation = {中文辅助译名：xCG：用于非小细胞肺癌生存预测的可解释细胞图},
  abstract = {Understanding how deep learning models predict oncology patient risk can provide critical insights into disease progression, support clinical decision-making, and pave the way for trustworthy and data-driven precision medicine. Building on recent advances in the spatial modeling of the tumor microenvironment using graph neural networks, we present an explainable cell graph (xCG) approach for survival prediction. We validate our model on a public cohort of imaging mass cytometry (IMC) data for 416 cases of lung adenocarcinoma. We explain survival predictions in terms of known phenotypes on the cell level by computing risk attributions over cell graphs, for which we propose an efficient grid-based layer-wise relevance propagation (LRP) method. Our ablation studies highlight the importance of incorporating the cancer stage and model ensembling to improve the quality of risk estimates. Our xCG method, together with the IMC data, is made publicly available to support further research.},
}

@misc{klaus_robert_muller_e379fb5c33d5dbd9,
  title = {xMIL: Insightful Explanations for Multiple Instance Learning in Histopathology},
  author = {Frederick Klauschen and Thomas Schnake and Mina Jamshidi Idaji and Jonas Dippel and Oliver Eberle and Andreas Mock and Laure Ciernik and Oliver Buchstab and Julius Hense and Klaus-Robert Müller},
  year = {2024},
  doi = {10.52202/079017-0266},
  url = {https://doi.org/10.52202/079017-0266},
  howpublished = {NeurIPS},
  annotation = {中文辅助译名：xMIL：组织病理学中多实例学习的深刻解释},
  abstract = {Multiple instance learning (MIL) is an effective and widely used approach for weakly supervised machine learning. In histopathology, MIL models have achieved remarkable success in tasks like tumor detection, biomarker prediction, and outcome prognostication. However, MIL explanation methods are still lagging behind, as they are limited to small bag sizes or disregard instance interactions. We revisit MIL through the lens of explainable AI (XAI) and introduce xMIL, a refined framework with more general assumptions. We demonstrate how to obtain improved MIL explanations using layer-wise relevance propagation (LRP) and conduct extensive evaluation experiments on three toy settings and four real-world histopathology datasets. Our approach consistently outperforms previous explanation attempts with particularly improved faithfulness scores on challenging biomarker prediction tasks. Finally, we showcase how xMIL explanations enable pathologists to extract insights from MIL models, representing a significant advance for knowledge discovery and model debugging in digital histopathology. Codes are available at: https://github.com/bifold-pathomics/xMIL.},
}

