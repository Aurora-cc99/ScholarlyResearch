  howpublished = {Helvetica Chimica Acta},
  annotation = {中文辅助译名：Langsame Inversion am Pyramidal gebundenen Stickstoff：异构体和差向非对映异构体 N-甲氧基-3,3-二甲氧基羰基-5-氰基-1, 2-恶唑烷。福尔劳菲格米特伊隆},
  abstract = {Two crystalline diastereomeric N‐methoxy‐3, 3‐di‐methoxycarbonyl‐5‐cyano‐1, 2‐oxazolidines (II and III) have been isolated. The pyramidal arrangement at the respective nitrogen atoms does not invert at room temperature. The ARRHENIUS activation energy for the epimerization of the thermodynamically less stable isomer to the more stable one in bromoform solution is 29,2 ± 0,5 kcal/Mol (log A = 14,2 ± 0,3).},
}

@misc{klaus_robert_muller_40a8087f10db9408,
  title = {Lösung der radialen Schrödingergleichung durch Variation in Teilbereichen. Mit 4 Abbildungen},
  author = {K. Robert Müller},
  doi = {10.1002/andp.19644680708},
  url = {https://doi.org/10.1002/andp.19644680708},
  howpublished = {Annalen der Physik},
  annotation = {中文辅助译名：Lösung der Radien Schrödingergleichung durch Variation in Teilbereichen。 Mit 4 解说},
  abstract = {Das Schrödingersche Variationsprinzip für die radiale Wellengleichung eines Einelektronenproblems läßt sich so abändern, daß die Integration im Variations‐Funktional nur über Teilbereiche erstreckt zu werden braucht. Dies gelingt durch Einführung zusätzlicher Randbedingungen an den Integrationsgrenzen, in denen die logarithmische Ableitung der Wellenfunktion auftritt. Das entsprechende Ritzsche Verfahren wird diskutiert und als Anwendung der Grundzustand eines Elektrons im Felde einer Kernladung berechnet, die durch eine kleine kugelförmige Oberflächenladung teilweise abgeschirmt ist.},
}

