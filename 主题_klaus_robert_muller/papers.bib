@misc{klaus_robert_muller_7aa429c289022074,
  title = {Optimizing for Measure of Performance in Max-Margin Parsing},
  author = {Alexander Bauer and Nico Görnitz and Shinichi Nakajima and Klaus-Robert Müller},
  year = {2020},
  doi = {10.1109/TNNLS.2019.2934225},
  url = {https://doi.org/10.1109/TNNLS.2019.2934225},
  howpublished = {IEEE Trans. Neural Networks Learn. Syst.},
  annotation = {中文辅助译名：优化最大边距解析中的性能度量},
  abstract = {Many learning tasks in the field of natural language processing including sequence tagging, sequence segmentation, and syntactic parsing have been successfully approached by means of structured prediction methods. An appealing property of the corresponding training algorithms is their ability to integrate the loss function of interest into the optimization process improving the final results according to the chosen measure of performance. Here, we focus on the task of constituency parsing and show how to optimize the model for the F1-score in the max-margin framework of a structural support vector machine (SVM). For reasons of computational efficiency, it is a common approach to binarize the corresponding grammar before training. Unfortunately, this introduces a bias during the training procedure as the corresponding loss function is evaluated on the binary representation, while the resulting performance is measured on the original unbinarized trees. Here, we address this problem by extending the inference procedure presented by Bauer et al. Specifically, we propose an algorithmic modification that allows evaluating the loss on the unbinarized trees. The new approach properly models the loss function of interest resulting in better prediction accuracy and still benefits from the computational efficiency due to binarized representation. The presented idea can be easily transferred to other structured loss functions.},
}

@misc{klaus_robert_muller_bc98e9999117ae9e,
  title = {Rethinking Assumptions in Deep Anomaly Detection},
  author = {Lukas Ruff and Billy Joe Franks and Robert A. Vandermeulen and Marius Kloft and Klaus-Robert Müller},
  year = {2020},
  doi = {10.48550/ARXIV.2006.00339},
  url = {https://doi.org/10.48550/ARXIV.2006.00339},
  howpublished = {CoRR},
  annotation = {中文辅助译名：重新思考深度异常检测中的假设},
  abstract = {Though anomaly detection (AD) can be viewed as a classification problem (nominal vs. anomalous) it is usually treated in an unsupervised manner since one typically does not have access to, or it is infeasible to utilize, a dataset that sufficiently characterizes what it means to be "anomalous." In this paper we present results demonstrating that this intuition surprisingly seems not to extend to deep AD on images. For a recent AD benchmark on ImageNet, classifiers trained to discern between normal samples and just a few (64) random natural images are able to outperform the current state of the art in deep AD. Experimentally we discover that the multiscale structure of image data makes example anomalies exceptionally informative.},
}

