@misc{klaus_robert_muller_bd837bb51cc08ad6,
  title = {AI-based discovery of functional boundaries in the human brain from intraoperative electrophysiology},
  author = {Simon Leszek and Matthew R. Baker and Bryan T. Klassen and Michael A. Jensen and Gaby Ojeda Valencia and Klaus‐Robert Müller and Kai Joshua Miller},
  year = {2026},
  doi = {10.64898/2026.05.02.26352297},
  url = {https://doi.org/10.64898/2026.05.02.26352297},
  howpublished = {medRxiv},
  annotation = {中文辅助译名：基于人工智能的术中电生理学发现人脑功能边界},
  abstract = {Neurosurgical and neuromodulation therapies such as deep brain stimulation (DBS) require millimeter-level accuracy to effectively target functional brain regions. Yet, many neuroanatomical boundaries remain invisible to current imaging and electrophysiology methods, limiting precision and contributing to suboptimal patient outcomes. Here, we introduce a self-supervised artificial intelligence (AI) framework that learns to delineate functional subregions directly from the spectral content of intraoperative local field potential (LFP) recordings, without the need for predefined biomarkers or anatomical labels. The framework identifies physiologic structure across the full spectrum of the signal and, through explainable AI (XAI), reveals the specific frequency components underlying these distinctions. Validated in the subthalamic nucleus (STN), the model aligned with clinically defined borders and rediscovered known beta oscillations. Applied to the motor thalamus in tremor patients, it consistently identified functional transitions corresponding to the ventral oralis posterior (Vop) and ventral intermediate (Vim) nuclei-regions where conventional methods fail to provide reliable boundaries. To assess clinical relevance, physiologically defined clusters were functionally evaluated using monopolar review data at their first DBS clinic postoperative visit, demonstrating distinct stimulation-response profiles across clusters and linking electrophysiologic segmentation to clinically},
}

@misc{klaus_robert_muller_790e35eda445a37a,
  title = {Disentangling total-variance and signal-to-noise-ratio improves diffusion models},
  author = {Khaled Kahouli and Winfried Ripken and Stefan Gugler and Oliver T. Unke and Klaus‐Robert Müller and Shinichi Nakajima},
  year = {2026},
  doi = {10.1088/2632-2153/aeb69d},
  url = {https://doi.org/10.1088/2632-2153/aeb69d},
  howpublished = {Machine Learning Science and Technology},
  annotation = {中文辅助译名：解开总方差和信噪比可改进扩散模型},
  abstract = {Diffusion models have been widely adopted as a powerful generative framework across numerous scientific domains, yet their inherently iterative sampling process remains a significant computational bottleneck. While this is typically mitigated by reducing the number of reverse diffusion steps, sample quality becomes highly sensitive to the chosen noise schedule, i.e. the manner in which noise is introduced and the signal is reduced at each step. Although prior work has improved on the original variance-preserving and variance-exploding schedules, these approaches passively adjust the total variance, without direct independent control over it. In this work, we propose a novel total-variance/signal-to-noise-ratio disentangled framework, where total variance (TV) and signal-to-noise-ratio (SNR) can be controlled independently. Our approach reveals that schedules with exponentially exploding TV can be consistently improved by adopting a constant TV schedule while preserving the underlying SNR schedule. Furthermore, we demonstrate that generalizing the SNR schedule of optimal transport flow matching significantly enhances generation efficiency. Crucially, these gains remain consistent across various reverse diffusion solvers and reduce the search space to two independent and interpretable parameters, enabling fast and robust sampling for complex scientific applications, such as molecular structure generation.},
}

