@misc{klaus_robert_muller_24d674887b09e926,
  title = {BCI Systems and Approaches},
  author = {Guido Dornhege and José del R. Millán and Thilo Hinterberger and Dennis J. McFarland and Klaus‐Robert Müller},
  year = {2007},
