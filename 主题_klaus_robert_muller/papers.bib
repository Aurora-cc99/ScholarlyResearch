@misc{klaus_robert_muller_97e5a9448ad76728,
  title = {Learning Feature Hierarchies with Centered Deep Boltzmann Machines},
  author = {Grégoire Montavon and Klaus-Robert Müller},
  year = {2012},
  doi = {10.48550/ARXIV.1203.3783},
  url = {https://doi.org/10.48550/ARXIV.1203.3783},
  howpublished = {CoRR},
  annotation = {中文辅助译名：使用中心深度玻尔兹曼机学习特征层次结构},
  abstract = {Deep Boltzmann machines are in principle powerful models for extracting the hierarchical structure of data. Unfortunately, attempts to train layers jointly (without greedy layer-wise pretraining) have been largely unsuccessful. We propose a modification of the learning algorithm that initially recenters the output of the activation functions to zero. This modification leads to a better conditioned Hessian and thus makes learning easier. We test the algorithm on real data and demonstrate that our suggestion, the centered deep Boltzmann machine, learns a hierarchy of increasingly abstract representations and a better generative model of data.},
}

@misc{klaus_robert_muller_485147bcd119a37e,
  title = {First study towards linear control of an upper-limb neuroprosthesis with an EEG-based Brain-Computer Interface},
  author = {Carmen Vidaurre and Javier Pascual and Francisco Velasco-Álvarez and Klaus-Robert Müller},
  year = {2012},
  doi = {10.1109/EMBC.2012.6346663},
  url = {https://doi.org/10.1109/EMBC.2012.6346663},
  howpublished = {EMBC},
  annotation = {中文辅助译名：首次研究利用基于脑电图的脑机接口对上肢神经假体进行线性控制},
  abstract = {In this study we show how healthy subjects are able to use a non-invasive Motor Imagery (MI)-based Brain Computer Interface (BCI) to achieve linear control of an upper-limb neuromuscular electrical stimulation (NMES) controlled neuroprosthesis in a simple binary target selection task. Linear BCI control can be achieved if two motor imagery classes can be discriminated with a reliability over 80% in single trial. The results presented in this work show that there was no significant loss of performance using the neuroprosthesis in comparison to MI where no stimulation was present. However, it is remarkable how different the experience of the users was in the same experiment. The stimulation either provoked a positive reinforcement feedback, or prevented the user from concentrating in the task.},
}

