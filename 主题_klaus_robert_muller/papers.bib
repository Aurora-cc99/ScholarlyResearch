  annotation = {中文辅助译名：优化时空滤波器以改善脑机接口},
  abstract = {Brain-Computer Interface (BCI) systems create a novel communication channel from the brain to an output device by bypassing conventional motor output pathways of nerves and muscles. Therefore they could provide a new communication and control option for paralyzed patients.},
}

@misc{klaus_robert_muller_22fd33de868ac237,
  title = {Automatie Identification of Faked and Fraudulent Interviews in the German SOEP},
  author = {Christin Schäfer and Jörg-Peter Schräpler and Klaus‐Robert Müller and Gert G. Wagner},
  year = {2005},
  doi = {10.3790/schm.125.1.183},
  url = {https://doi.org/10.3790/schm.125.1.183},
  howpublished = {Journal of Contextual Economics – Schmollers Jahrbuch},
  annotation = {中文辅助译名：自动识别德国 SOEP 中的虚假和欺诈性采访},
  abstract = {Based on data frorn the German Socio-Econornic Panel (SOEP), this paper presents two new tools for the identification of faked interviews in surveys. One rnethod is based on Benford's Law, and the other exploits the ernpirical observation that fakers most often produce answers with less variability than could be expected frorn the whole survey. We focus on fabricated data, which was taken out of the survey before the data was disserninated to extemal users. For two sarnples, the resulting rankings of the interviewers with respect to their cheating behavior are given. For both rnethods all of the evident fakers are identified.},
}

@misc{klaus_robert_muller_2f96984d13968d41,
  title = {Error Vector Magnitude (EVM) Measurements for GSM/EDGE Applications Revised under Production Conditions},
  author = {M. Helfenstein and E. Baykal and K. Robert Müller and A. Lampe},
  year = {2005},
  doi = {10.1109/iscas.2005.1465757},
  url = {https://doi.org/10.1109/iscas.2005.1465757},
  howpublished = {IEEE International Symposium on Circuits and Systems proceedings},
  annotation = {中文辅助译名：GSM/EDGE 应用的误差矢量幅度 (EVM) 测量在生产条件下进行了修订},
  abstract = {A main concern in the testing of systems fulfilling the enhanced general packet radio service (EGPRS) requirements is the proper measurement of the error vector magnitude (EVM) for the implemented 8PSK modulator. However, handsets supporting EGPRS also incorporate a GMSK modulator and hence, in order to reduce computing time on the production tester by more than an order of magnitude, this paper suggests obtaining part of the data needed for the 8PSK modulator's EVM calculations during the phase error measurements of the GMSK modulator. More fundamentally, this approach can be applied to any mixed-signal modulator embodying a phase-only modulator in parallel with a modulator employing a phase and amplitude modulation scheme.},
}

@misc{klaus_robert_muller_0a97b7ea55b1a6ed,
  title = {The BCI competition 2003: progress and perspectives in detection and discrimination of EEG single trials},
  author = {Alois Schlögl and Benjamin Blankertz and Gert Pfurtscheller and Gerwin Schalk and Gabriel Curio and Jonathan R. Wolpaw and Thilo Hinterberger and Niels Birbaumer and Theresa M. Vaughan and Christa Neuper and Michael Tangermann and Klaus-Robert Müller},
  year = {2004},
  doi = {10.1109/TBME.2004.826692},
  url = {https://doi.org/10.1109/TBME.2004.826692},
  howpublished = {IEEE Trans. Biomed. Eng.},
  annotation = {中文辅助译名：2003 年 BCI 竞赛：EEG 单项试验检测和区分的进展和前景},
  abstract = {Interest in developing a new method of man-to-machine communication--a brain-computer interface (BCI)--has grown steadily over the past few decades. BCIs create a new communication channel between the brain and an output device by bypassing conventional motor output pathways of nerves and muscles. These systems use signals recorded from the scalp, the surface of the cortex, or from inside the brain to enable users to control a variety of applications including simple word-processing software and orthotics. BCI technology could therefore provide a new communication and control option for individuals who cannot otherwise express their wishes to the outside world. Signal processing and classification methods are essential tools in the development of improved BCI technology. We organized the BCI Competition 2003 to evaluate the current state of the art of these tools. Four laboratories well versed in EEG-based BCI research provided six data sets in a documented format. We made these data sets (i.e., labeled training sets and unlabeled test sets) and their descriptions available on the Internet. The goal in the competition was to maximize the performance measure for the test labels. Researchers worldwide tested their algorithms and competed for the best classification results. This paper describes the six data sets and the results and function of the most successful algorithms.},
}

