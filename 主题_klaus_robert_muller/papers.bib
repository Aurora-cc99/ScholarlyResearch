@misc{klaus_robert_muller_ef86e027b413d574,
  title = {Langsame Inversion am pyramidal gebundenen Stickstoff: Isolierung und Epimerisierung diastereomerer N‐Methoxy‐3,3‐di‐methoxycarbonyl‐5‐cyan‐1, 2‐oxazolidine. Vorläufige Mitteilung},
