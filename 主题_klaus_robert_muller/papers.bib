@misc{klaus_robert_muller_2746486e59d0e4a2,
  title = {Data for "SO3LR Tauri: Generally Applicable Force Fields for Reactive (Bio)Molecular Simulations Covering the Periodic Table"},
  author = {Adil Kabylda and Florian N. Brünig and Miguel Gallegos and J. Thorben Frank and Evgeny Moerman and Oliver T. Unke and Stefan Chmiela and Klaus‐Robert Müller and Alexandre Tkatchenko},
  year = {2026},
  doi = {10.5281/zenodo.22920713},
  url = {https://doi.org/10.5281/zenodo.22920713},
  howpublished = {Zenodo (CERN European Organization for Nuclear Research)},
  annotation = {中文辅助译名：“SO3LR Tauri：覆盖周期表的反应（生物）分子模拟的普遍适用力场”的数据},
  abstract = {This repository contains the training data and test benchmarks of SO3LR Tauri, a family of machine-learned force fields described in the paper “SO3LR Tauri: Generally Applicable Force Fields for Reactive (Bio)Molecular Simulations Covering the Periodic Table”. The code and models are available at https://github.com/general-molecular-simulations/so3lr. Training data. The models were trained on 52 subsets with 148.9 million structures covering 85 elements. The subsets come from QCell, QCML, QM7-X, AQM, SPICE, GEMS, OMol25-0 and OPoly26. Twelve subsets (8.3 million structures) are included here in TensorFlow Datasets (TFDS) format, one archive per subset (so3lr_data_<subset>.tar.gz), with the train/validation/test splits used in training. The remaining 40 subsets (QCML, 38 OMol25-0 subsets and OPoly26) are publicly available from their original sources and can be rebuilt exactly with the provided scripts. Test benchmarks. so3lr_test_benchmarks.tar.gz contains the test sets of the paper: the held-out PBE0+MBD(-NL) test splits, the external benchmarks of Table II (SAPT10k, QUID, JSCH-2005, PLA15, TorsionNet500, GlcMal, QM7b, AlphaML) with a scoring script, metal–organic framework structures with PBE-D3 from Vandenhaute et al. and new PBE0+MBD-NL labels, transition-state geometries and reference calculations for the reaction studies, results of the pentapeptide pKa calculations, and the starting structures of all molecular dynamics simulations. Scripts. so3lr_scripts_and_manifests.},
}

