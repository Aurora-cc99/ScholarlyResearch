@misc{klaus_robert_muller_815a844eac149f55,
  title = {Hochpolymere Werkstoffe. Aufbau – Eigenschaftsbild – Anwendung},
  author = {K. Robert Müller},
  year = {1971},
  doi = {10.1002/mawe.19710020203},
  url = {https://doi.org/10.1002/mawe.19710020203},
  howpublished = {Materialwissenschaft und Werkstofftechnik},
  annotation = {中文辅助译名：Hochpolymere Werkstoffe. Aufbau – Eigenschaftsbild – Anwendung},
  abstract = {Es wurde gezeigt, wie durch die enge sachbezogene Bindung zwischen dêm Institut für Werkstoffkunde und der Staatlichen Materialprüfungsanstalt eine zwanglose und stete Wechselwirkung zwischen Werkstofforschung, Werkstoffprüfung und ‐lehre — hier speziell bezogen auf das Gebiet der Hochpolymeren — erreicht wurde. Aus den Forschungsschwerpunkten der letzten fünf Jahre wurden einige kennzeichnende Beispiele herausgegriffen und — pars pro toto — Themenentwicklung, Aufgabenstellung, Themenverflechtung und Ergebnisse skizziert. Hierbei handelt es sich vornehmlich um Untersuchungen der Zusammenhänge zwischen Aufbau und Eigenschaftsbild duroplastischer Mehrstoffsysteme, die Abhängigkeit der molekularen Orientierung und elektrostatischen Aufladung thermoplastischer Kunststoffe von den Verarbeitungsbedingungen sowie um Fragen des Verhaltens von Bauteilen aus Duro‐ und Thermoplasten. Begonnene und geplante Forschungsarbeiten konzentrieren sich wie bisher auf die anwendungsbezogene, ingenieurmäßige Bearbeitung des zwischen Rohstoff und Fertigerzeugnis liegenden Feldes. Es ist jedoch bereits erkennbar, daß die interdisziplinäre Zusammenarbeit bei diesen Aufgaben wesentlich intensiviert werden wird.},
}

