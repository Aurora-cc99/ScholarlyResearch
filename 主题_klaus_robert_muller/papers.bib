}

@misc{klaus_robert_muller_8003afda034be8d3,
  title = {Correction to “Concurrent Adaptation of Human and Machine Improves Simultaneous and Proportional Myoelectric Control” [Jul 15 618-627]},
  author = {Janne Mathias Hahne and Sven Dähne and Han‐Jeong Hwang and Klaus‐Robert Müller and Lucas C. Parra},
