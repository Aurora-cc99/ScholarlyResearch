  annotation = {中文辅助译名：大语言模型更信任人类，这是一个问题！揭示并减轻检索增强生成中的权威偏差},
  abstract = {Yuxuan Li, Xinwei Guo, Jiashi Gao, Guanhua Chen, Xiangyu Zhao, Jiaxin Zhang, Quanying Liu, Haiyan Wu, Xin Yao, Xuetao Wei. Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (Volume 1: Long Papers). 2025.},
}

@misc{quanying_liu_29e52a2af94f1088,
  title = {When LLM Agents Disagree, Do Humans Mirror? Behavioral Comparisons on Moral Dilemmas},
  author = {Haotian Deng and Sitian Wang and Ruxin Wang and Xuetao Wei and Chen Wei and Quanying Liu},
  year = {2025},
  doi = {10.1109/mind67540.2025.11351781},
  url = {https://doi.org/10.1109/mind67540.2025.11351781},
  howpublished = {International Conference on Machine Intelligence and Nature-Inspired Computing (MIND)},
  annotation = {中文辅助译名：当大语言模型智能体人意见不一致时，人类会镜像吗？道德困境的行为比较},
  abstract = {Moral dilemmas are widely used to study ethical decision-making in humans and artificial agents. While recent studies have shown large language models (LLMs) can produce consistent human-like moral judgments, their ability to capture human inter-individual variability-especially in highdisagreement scenarios-remains unexplored. To explore this, we propose a variability-based assessment framework that evaluates human-AI moral alignment through inter-individual disagreement. We curated a diverse set of$\mathbf6 0 0$moral dilemmas spanning domains such as harm, fairness, and loyalty. Using a unified experimental paradigm, we collected binary moral decisions and confidence ratings from over 100 LLM-based agents and 100 human participants. For each scenario, we quantified interagent disagreement (AI uncertainty) and inter-human response variability (Human uncertainty). Our results reveal a fundamental misalignment that AI uncertainty fails to predict human disagreement levels ($r=0.01, p=0.73$). Paradoxically, agents exhibiting greater moral consistency diverge further from human variability patterns. This suggests current alignment strategies overlook key dimensions of moral ambiguity, risking brittle ethical AI systems.},
}

