@misc{bin_hu_b5b73de463c925f3,
  title = {Neural Correlates of Drug-Related Attentional Bias in Heroin Dependence},
  author = {Qinglin Zhao and Hongqian Li and Bin Hu and Yonghui Li and Céline R. Gillebert and Dante Mantini and Quanying Liu},
  year = {2018},
  doi = {10.3389/fnhum.2017.00646},
