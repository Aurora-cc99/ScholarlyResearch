@misc{quanying_liu_72dd14a13526a272,
  title = {CoFlu-Brain: An fMRI Connectivity Foundation Model with Cofluctuation-Based Pretraining},
  author = {Wenhao Ye and Junfeng Xia and Quanying Liu and Ziteng Sui and Mo Wang},
  year = {2026},
  doi = {10.48550/ARXIV.2610.15450},
  url = {https://doi.org/10.48550/ARXIV.2610.15450},
  howpublished = {CoRR},
  annotation = {中文辅助译名：CoFlu-Brain：具有基于共波动的预训练的 fMRI 连接基础模型},
  abstract = {Functional magnetic resonance imaging (fMRI) commonly characterizes large-scale brain organization through functional connectivity (FC). However, an observed FC matrix is not a fixed brain graph but a statistical estimate determined by the finite BOLD frames used to compute it. Conventional FC-based approaches typically represent each scan with a single Pearson-correlation matrix, leaving frame-resolved variations in regional interactions unexploited. To address this limitation, we introduce CoFlu-Brain, which organizes framewise cofluctuation observations into multiple retained and dropped views, each summarized as an FC matrix. The model learns connectivity structure reproducible across retained views and predicts the representations of the corresponding dropped views, while adopting SIGReg from LeJEPA to prevent representation collapse. We pretrained CoFlu-Brain on 13,444 subjects from eight dataset groups and evaluated its representations via frozen-encoder linear probing on seven classification and two age-prediction tasks across seven datasets. CoFlu-Brain showed strong transfer across demographic, developmental, and clinical prediction tasks, outperforming the evaluated released models on most tasks. Random frame partitioning improved aggregate transfer, while the complete objective achieved the strongest overall performance. Code is available.},
}

@misc{quanying_liu_bd8c8914e50c4c13,
  title = {DCHO: A Decomposition-Composition Framework for Predicting Higher-Order Brain Connectivity to Enhance Diverse Downstream Applications},
  author = {Weibin Li and Quanying Liu and Wendu Li},
  year = {2026},
  doi = {10.1609/AAAI.V40I3.37171},
  url = {https://doi.org/10.1609/AAAI.V40I3.37171},
  howpublished = {AAAI},
  annotation = {中文辅助译名：DCHO：用于预测高阶大脑连接以增强多样化下游应用的分解组合框架},
  abstract = {Higher-order brain connectivity (HOBC), which captures interactions among three or more brain regions, provides richer organizational information than traditional pairwise functional connectivity (FC). Recent studies have begun to infer latent HOBC from noninvasive imaging data, but they mainly focus on static analyses, limiting their applicability in dynamic prediction tasks. To address this gap, we propose DCHO, a unified approach for modeling and forecasting the temporal evolution of HOBC based on a Decomposition-Composition framework, which is applicable to both non-predictive tasks (state classification) and predictive tasks (brain dynamics forecasting). DCHO adopts a decomposition-composition strategy that reformulates the prediction task into two manageable subproblems: HOBC inference and latent trajectory prediction. In the inference stage, we propose a dual-view encoder to extract multiscale topological features and a latent combinatorial learner to capture high-level HOBC information. In the forecasting stage, we introduce a latent-space prediction loss to enhance the modeling of temporal trajectories. Extensive experiments on multiple neuroimaging datasets demonstrate that DCHO achieves superior performance in both non-predictive tasks (state classification) and predictive tasks (brain dynamics forecasting), significantly outperforming existing methods.},
}

@misc{dan_zhang_thu_620df8f35eec4d3c,
  title = {EmoEEG-MC: A Multi-Context Emotional EEG Dataset for Cross-Context Emotion Decoding},
  author = {Xin XU and Xinke SHEN and Xuyang CHEN and Qingzhu ZHANG and Sitian WANG and Yihan LI and Zongsheng LI and Dan Zhang and Mingming ZHANG and Quanying Liu},
  year = {2026},
  doi = {10.82901/nemar.on005540},
  url = {https://doi.org/10.82901/nemar.on005540},
  howpublished = {UC San Diego},
  annotation = {中文辅助译名：EmoEEG-MC：用于跨上下文情感解码的多上下文情感脑电图数据集},
  abstract = {EmoEEG-MC is a multi-context emotional EEG dataset comprising 64-channel EEG and peripheral physiological recordings from 60 participants exposed to video-induced and imagery-induced emotional stimuli across seven emotion categories (joy, inspiration, tenderness, fear, disgust, sadness, and neutral). This dataset addresses the critical gap in cross-context emotion decoding by enabling investigation of how emotional neural responses generalize across different elicitation contexts, with demonstrated classification accuracies of 66.7% for binary emotion classification and 28.9% for seven-category emotion classification using machine learning approaches.},
}

@misc{quanying_liu_f0d280ac0212c107,
  title = {FlatClip: A Geometry-Aware Surface-Level Baseline for fMRI Representation Learning},
  author = {Wenhao Ye and Quanying Liu and Jiayu Zuo and Junfeng Xia and Hongkai Wen and Mo Wang and Zihan Ning},
  year = {2026},
  doi = {10.48550/ARXIV.2609.31204},
  url = {https://doi.org/10.48550/ARXIV.2609.31204},
  howpublished = {CoRR},
  annotation = {中文辅助译名：FlatClip：用于 fMRI 表示学习的几何感知表面水平基线},
  abstract = {Can the spatial organization of cortical activity help transfer frozen image representations to fMRI prediction? We introduce FlatClip, which renders cortical activity as anatomy-linked flatmaps and extracts features with a frozen SigLIP2 encoder. Only a lightweight downstream probe is trained, without fMRI-specific encoder pretraining or fine-tuning. Across four resting-state benchmarks, FlatClip outperforms the evaluated ROI-level baselines on HCP and ADNI, but is weaker on PPMI and below the strongest voxel-level models overall. On NSD visual-fMRI decoding, restricting inputs to visual or NSD-provided task-active cortex improves recognition over whole-cortex inputs. Spatial perturbations reduce performance with both retrained and fixed readouts, and anatomy-linked arrangements outperform cortical-pixel permutations across three colormaps. Together, these results demonstrate a practical route for reusing image-pretrained features in fMRI and highlight cortical arrangement and input-region selection as important design choices. Code is available at https://github.com/OneMore1/FlatClip.},
}

