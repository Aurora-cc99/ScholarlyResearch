@misc{xiangshui_miao_702a8e9939c688be,
  title = {Synergic Effect in a New Electrocatalyst Ni2SbTe2 for Oxygen Reduction Reaction},
  author = {Li-Heng Li and Jun‐Hui Yuan and Kan‐Hao Xue and Meng Kai Xu and Ming Xu and Jiafu Wang and Xiangshui Miao},
  year = {2020},
  doi = {10.1021/acs.jpcc.9b11004},
  url = {https://doi.org/10.1021/acs.jpcc.9b11004},
  howpublished = {The Journal of Physical Chemistry C},
  annotation = {中文辅助译名：新型电催化剂 Ni2SbTe2 对氧还原反应的协同效应},
  abstract = {Pt and Pt-based materials are still the most common catalysts for oxygen reduction reaction (ORR), but it is highly desirable to develop efficient ORR electrocatalysts based on inexpensive metals. This paper presents a novel two-dimensional transition-metal chalcogenide material Ni 2 SbTe 2 for ORR, which has a stable three-dimensional counterpart and can be obtained through exfoliation. First-principles calculations with solvation correction show that the edge sites of few-layer Ni 2 SbTe 2 possess better ORR performances than the basal plane. The (014) surface not only is energetically favorable but also demonstrates a high ORR onset potential of 0.52 V (the Pt(111) onset potential is 0.50 V). An interesting triple-element synergic effect has been revealed in the Ni–Sb–Te system, where Te helps to reduce the bonding strength between surface Ni and adsorbed O. Meanwhile, the capability of Sb to donate different numbers of electrons can improve O 2 adsorption and reduce Δ G *OH . A detailed comparative study of Ni 2 SbTe 2, NiSb, NiTe 2, NiSe 2, Co 2 SbTe, and Ni 2 SbSe 2 as ORR electrocatalysts is given.},
}

@misc{xiangshui_miao_5f16496a6e407e9b,
  title = {Suppressed resistance drift from short range order of amorphous GeTe ultrathin films},
  author = {Ping Ma and Hao Tong and Ming Xu and Xiaomin Cheng and Xiangshui Miao},
  year = {2020},
  doi = {10.1063/5.0009362},
  url = {https://doi.org/10.1063/5.0009362},
  howpublished = {Applied Physics Letters},
  annotation = {中文辅助译名：抑制非晶 GeTe 超薄膜短程有序的电阻漂移},
  abstract = {The nanosize confined effect is believed to contribute to improving the resistance drift in nanophase change devices. However, the smaller dimension of device designs is limited by plane lithography techniques. Phase change memory with a confined thickness of ultrathin GeTe layers is fabricated to overcome the limit of current plane lithography. Those memory cells composed of two-dimensional materials present a suppressed resistance drift in their amorphous phase. The drift exponent ν is reduced to 0.05 for 3 nm GeTe layers. Combined with Raman spectroscopy and ab initio molecular dynamics simulations, the structural relaxation process is described as the decay of tetrahedral-bonded sites. Tetrahedrons in ultrathin films are more stable than those in bulk materials. The local motifs of amorphous GeTe ultrathin films are covalently bonded and highly ordered in a short range. The majority of highly ordered tetrahedral clusters prevents spontaneous structural relaxation and leads to high stability in amorphous states, which helps to stop intrinsic fluctuations in physical properties of SET and RESET states, without an extra processing cost.},
}

