  annotation = {中文辅助译名：一种用于EOG驱动人机界面的新型眼动检测算法},
}

@misc{panorama_zhao_lv_5aaa8ab111fdc98b,
  title = {Implementation of the EOG-Based Human Computer Interface System},
  author = {Zhao Lv and Xiaopei Wu and Mi Li and Chao Zhang},
  year = {2008},
  doi = {10.1109/icbbe.2008.877},
  url = {https://doi.org/10.1109/icbbe.2008.877},
  howpublished = {International Conference on Bioinformatics and Biomedical Engineering},
  annotation = {中文辅助译名：基于EOG的人机界面系统的实现},
  abstract = {Bio-based human computer interface(HCI) has attracted more and more attention of researches all over the world in recent years. In this paper, an EOG-based HCI system is introduced. It is composed of three parts: EOG amplifying and acquisition, EOG pattern recognition and control command output. Three plane electrodes are employed to detects the EOG signals, which contains the information related to the eye blinking and vertical( or horizontal ) eye movements referred to pre-designed command table. An online signal processing algorithm is designated to get the command information contained in EOG signals, and these commands could be used to control the computer or other instruments. Based on this HCI system, the remote control experiments driven by EOG are realized.},
}

@misc{panorama_zhao_lv_5195347dff5f6ce3,
  title = {A permutation alignment algorithm based on multiple criterions in audio signal Frequency-Domain Blind deconvolution},
  author = {Chao Zhang and Xiaopei and Zhao Lv},
  year = {2008},
  doi = {10.1109/icosp.2008.4697427},
  url = {https://doi.org/10.1109/icosp.2008.4697427},
  howpublished = {International Conference on Signal Processing},
  annotation = {中文辅助译名：音频信号频域盲反卷积中基于多准则的排列对齐算法},
  abstract = {In audio signal frequency-domain blind deconvolution, the conversion of signals from time-domain convolutive mixture to several instantaneous mixtures in frequency-domain may cause indeterminacies in scaling and permutation. Based on traditional permutation alignment algorithms, this paper proposes a permutation alignment algorithm based on multiple criterions. A combination of several classical criterions will be used to make a more precise permutation judgment. Simulation results show that algorithm based on multiple criterions achieves a better accuracy in permutation alignment and the acoustic quality of separation is improved.},
}
