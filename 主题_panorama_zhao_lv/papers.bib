@misc{panorama_zhao_lv_93abe865d9837ff6,
  title = {HUNT: Detecting Hallucinations via Multi-Layer Discriminative Representations in Large Language Models},
  author = {Xue Zhang and Shuai Zhang and Wang Xiang and Heng Xie and Jianhua Tao and Zhengqi Wen and Zhao Lv and Cunhang Fan},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464490},
  url = {https://doi.org/10.1109/icassp55912.2026.11464490},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：HUNT：通过大型语言模型中的多层判别表示检测幻觉},
  abstract = {Large Language Models (LLMs) are prone to hallucinations due to the probability of their generation process, which means outputs are inconsistent with the fact label. The existing hallucination detection methods usually rely on the final layer representation, identifying hallucination by judging deviations between output and ground truth. These methods have made remarkable progress, but they still have certain limitations: hallucinations often do not occur at the last layer, but are gradually accumulated by semantic mutations in the middle layers and finally reflected in the output layer. If relying solely on the final layer, although inconsistencies at the label level can be detected, it is difficult to capture the formation and propagation of internal biases, thereby limiting the accuracy and robustness of detection. To address this issue, we propose a novel discriminative mechanism, the HallUciNation Tracking network (HUNT). We employ a gating mechanism to monitor multi-layer features, improving reliability. Within the expert network, subspace division enhances attention to critical information and restrains interference. Finally, a multi-layer fusion module integrates input, intermediate, and output layers, guiding attention with intermediate representations to merge semantic information. Experimental results on the True-False dataset show that our HUNT achieves state-of-the-art performance in hallucination detection.},
}

@misc{panorama_zhao_lv_976b9eef408a5427,
  title = {Hyper-GST: A Dyadic EEG Based Graph-Swin Transformer Model for AIGC Deepfake Video Detection},
  author = {Shiang Hu and Zhiwen Zha and Yi Fang and Dongdong Jia and Zhao Lv},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11461831},
  url = {https://doi.org/10.1109/icassp55912.2026.11461831},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：Hyper-GST：用于 AIGC Deepfake 视频检测的基于二元脑电图的 Graph-Swin Transformer 模型},
  abstract = {Generative AI is evolving rapidly. The spread of realistic and diverse deepfakes in the real world poses serious challenges to deepfake detection. Traditional computer vision detectors only focus on face-swapping, relying on transient digital artifacts, and often lack interpretability and robustness. To address this dilemma, we propose a neuro-cognitive approach using Dyadic EEG to decode human perception of authenticity. We employed Hyperscanning to synchronously record EEG from 15 participant pairs viewing authentic and deepfake videos. We extracted inter-subject neural synchrony metrics, including Inter-Subject Correlation, Phase-Locking Value, and Coherence, as robust neuro-biomarkers for video authenticity. To decode these patterns, we propose Hyper-GST, a dual-branch model fusing a Swin Transformer and GNN. Experimental results show that our model achieves high accuracy (90.47%) in deepfake video detection. Furthermore, our analysis reveals that deepfake videos induce distinct and interpretable synchrony patterns across participants. This work highlights the potential of inter-subject synchrony for detecting novel deepfakes.},
}

