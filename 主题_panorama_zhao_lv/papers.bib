@misc{panorama_zhao_lv_d6201f792bf41180,
  title = {Ancient Chinese Character Image Restoration: Present Investigations and Future Perspective},
  author = {Zhao Lv and Wentao Ruan and Xinhui Li},
  year = {2026},
  doi = {10.34133/icomputing.1195},
  url = {https://doi.org/10.34133/icomputing.1195},
  howpublished = {Intelligent Computing},
  annotation = {中文辅助译名：古汉字图像修复：现状研究与未来展望},
  abstract = {Ancient Chinese character images, including oracle bone inscriptions, bamboo slips, and stele rubbings, are vital carriers of Chinese civilization but are often severely degraded because of aging, resulting in noise, stroke loss, and stylistic distortion. While recent restoration techniques have advanced from traditional pixel-level methods such as skeleton-extraction-based generative adversarial networks to more sophisticated deep generative models such as diffusion models, current approaches remain heavily technology driven. This paper argues that the future of ancient character restoration must evolve beyond purely technical solutions, shifting toward a “human–technology synergy” paradigm that integrates both computational precision and historical authenticity. Embedding historical evolution rules into restoration models, constructing multimodal and cross-era datasets with rich semantic annotations, and fostering interdisciplinary collaboration between computer vision, paleography, and digital humanities are crucial steps toward achieving this goal. By grounding restoration efforts in both technical innovation and humanistic understanding, this paper offers a forward-looking vision for the field, advocating for solutions that are not only accurate in terms of pixel fidelity but also aligned with the historical and cultural context of ancient Chinese characters.},
}

@misc{panorama_zhao_lv_d005fe0cefa6,
  title = {Emotion Recognition Based on EEG Neuroscience Features: Microstate and Source Microstate Analysis},
  author = {Shiang Hu and Lusheng Ding and Guo Hu and Weijie Yao and Yuhan Lin and Zhao Lv},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11462531},
  url = {https://doi.org/10.1109/icassp55912.2026.11462531},
  howpublished = {ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)},
  annotation = {中文辅助译名：基于脑电图神经科学特征的情绪识别：微状态和源微状态分析},
  abstract = {Electroencephalogram (EEG) is widely used for emotion recognition due to its direct reflection of emotional states, yet emotion-related neuroscience features are often overlooked. This study investigated two emotion recognition paradigms: one paradigm involves deep models combined with traditional features, while the other involves lightweight models combined with neuroscience-related features: microstate and source microstate features. For within-subject recognition using an i7 CPU, the multi-frequency microstate method achieved 92.14±1.55% accuracy on SEED and 82.36±6.31% (valence)/83.85±5.62% (arousal) on DEAP in 10 minutes, while the source microstate method reached 95.23±1.25% on SEED in 25 minutes. For cross-subject recognition, the microstate method achieved accuracies of 89.73±1.38% (SEED), 86.64±2.38% (valence)/83.47±1.85% (arousal) on DEAP. These results highlight the potential of neuroscientific features in emotion classification. Future research should focus on extracting effective EEG features.},
}

@misc{panorama_zhao_lv_bd3cfbdb60040a61,
  title = {EEG Auditory Attention Decoding 2026 : Challenge Overview},
  author = {Cunhang Fan and Xiaoke Yang and Zhao Lv and Xingguang Dong and Mengyuan Gao and Hailong Zhang and Yu Luo and Jian Zhou and Siqi Cai and Yuanming Zhang and Yayun Liang and Jing Lu and Jingdong Chen},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11463546},
  url = {https://doi.org/10.1109/icassp55912.2026.11463546},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：脑电图听觉注意力解码 2026：挑战概述},
  abstract = {EEG-based auditory attention decoding (AAD) challenge aims to identify the direction of the attended speaker in multi-speaker environments from EEG signals. Despite significant progress, a key limitation of current AAD studies is their poor generalization to unseen subjects and sessions. To address these issues and promote robust AAD research, the EEG-AAD challenge focuses on two primary tracks: cross-subject and cross-session, with the aim of promoting the generalizability of methods and their applications in the real world. The challenge provides participants with 4,400 minutes of EEG data collected from 40 subjects across two experimental sessions under both audiovisual and audio-only scenes. The dataset is available at: https://iiphci.ahu.edu.cn/toEEGAADEnglish.},
}

@misc{panorama_zhao_lv_c54416c82929fa80,
  title = {EEG Auditory Attention Decoding 2026: Challenges and Insights},
  author = {Yongguan Ai and Xiaoke Yang and Zhao Lv and Xingguang Dong and Mengyuan Gao and Hongyu Zhang and Yu Luo and Jin Zhou and Siqi Cai and Yuanming Zhang and Yayun Liang and Jing Zhou Lu and Jingdong Chen and Cunhang Fan},
  year = {2026},
  doi = {10.1109/ojsp.2026.3753620},
  url = {https://doi.org/10.1109/ojsp.2026.3753620},
  howpublished = {IEEE Open Journal of Signal Processing},
  annotation = {中文辅助译名：脑电图听觉注意力解码 2026：挑战与见解},
  abstract = {EEG-based auditory attention decoding (AAD) aims to identify a listener's attended speaker in multi-talker environments, offering a key technology for neuro-inspired hearing devices. A major bottleneck is poor model generalization to unseen subjects and scenarios due to large inter-subject variability, low signal-to-noise ratio, and session non-stationarity. To address this, the ICASSP 2026 EEG-AAD Challenge focuses on cross-subject and cross-session attention tracking across diverse acoustic scenes. The challenge provides a multi-modal EEG dataset collected from 40 subjects under audio-visual and audio-only conditions, with a total duration of 73.3 hours. Two tracks are defined: Track 1 evaluates cross-subject decoding on unseen individuals; Track 2 evaluates cross-session transfer from audio-only training to audio-visual testing for the same subject. A total of 156 teams worldwide participated, with 67 submitting valid results. Overall, robust cross-subject and cross-session spatial AAD remains highly challenging, with most systems failing to reach statistical significance above chance under strict independent subject-level evaluation. This challenge focuses exclusively on the EEG-only spatial AAD paradigm, without providing auditory stimuli, thereby excluding stimulus-reconstruction approaches. Nevertheless, it establishes a rigorous benchmark and highlights key limitations of current methods.},
}

