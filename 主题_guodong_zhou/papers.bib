@misc{guodong_zhou_e0e360749e3f6aee,
  title = {Stance Detection with Hierarchical Attention Network},
  author = {Qiaoming Zhu and Zhongqing Wang and Guodong Zhou and Qingying Sun},
  year = {2018},
  url = {https://www.aclweb.org/anthology/C18-1203.pdf},
  howpublished = {COLING},
  annotation = {中文辅助译名：使用分层注意力网络进行姿态检测},
  abstract = {Stance detection aims to assign a stance label (for or against) to a post toward a specific target. Recently, there is a growing interest in using neural models to detect stance of documents. Most of these works model the sequence of words to learn document representation. However, much linguistic information, such as polarity and arguments of the document, is correlated with the stance of the document, and can inspire us to explore the stance. Hence, we present a neural model to fully employ various linguistic information to construct the document representation. In addition, since the influences of different linguistic information are different, we propose a hierarchical attention network to weigh the importance of various linguistic information, and learn the mutual attention between the document and the linguistic information. The experimental results on two datasets demonstrate the effectiveness of the proposed hierarchical attention neural model.},
}

@misc{guodong_zhou_7efc1a1aa132aab9,
  title = {Review Rating with Both Positive and Negative Sentiment Intensity Measurements},
  author = {Yijie Zhang and Guodong Zhou and Shoushan Li and Lu Zhang},
  year = {2018},
  doi = {10.1109/IALP.2018.8629146},
  url = {https://doi.org/10.1109/IALP.2018.8629146},
  howpublished = {IALP},
  annotation = {中文辅助译名：使用积极和消极情绪强度测量进行评论评级},
  abstract = {As a fundamental task in sentiment analysis, review rating has normally been modeled as a multi-class classification problem or a real-valued regression problem. In this study, we focus on regression modeling for review rating. Compared with all existing studies which perform regression learning with the intensity scores towards only the positive sentiment (abbreviated as positive scores). We introduce the concept of negative scores to leverage both positive and negative sentiment intensity measurements to improve the regression performance. To achieve this, we propose a joint learning framework to integrate the two regression tasks, i.e., the sentiment regression tasks with either positive or negative scores. Empirical studies demonstrate the effectiveness of the proposed joint learning framework to review rating.},
}

