@misc{guodong_zhou_69a5fd1954f25bf9,
  title = {EBAMQ: Exposure Bias Alleviation via Moment Matching for Question Generation},
  author = {Jianmin Yao and Chuyao Ding and Guodong Zhou and Dong Liu and Yu Hong},
  year = {2023},
  doi = {10.1109/IJCNN54540.2023.10191278},
  url = {https://doi.org/10.1109/IJCNN54540.2023.10191278},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：EBAMQ：通过问题生成的矩匹配减轻曝光偏差},
  abstract = {Question Generation (QG) aims to automatically raise questions given contexts. Due to the discrepancy between the training (supervised learning) and inference (autoregressive) modes, the current QG task suffers from exposure bias, i.e., the phenomenon of error propagation induced by mistakenly-generated tokens in the preceding subsequence. To address this issue, we propose to utilize moment matching to progressively alleviate exposure biases, which is referred to EBAMQ for short in this paper. EBAMQ enhances QG by imposing positive mitigation effects on the distributed representation. This is implemented by two components, including (1) adaptive moment matching and (2) assistant-cooperating data augmentation. Within the two components, adaptive moment matching plays the dominant role. It enables the sharing of feature space among different samples that derive from binary channels (i.e., training and inference). More importantly, it provides more similar representations for synonymous or homologous tokens. In addition, we introduce the pseudo-masked technique to generate additional reference questions. It contributes to the reduction of inevitable constraints of ground-truth instances, and therefore, it helps to improve the robustness. Extensive experiments are conducted on the benchmark dataset SQuAD. Experimental results show that EBAMD produces substantial improvements for all the metrics (BLEU-4, ROUGE-L and METEOR) compared to the UniLM-based baseline, and it outperforms },
}

