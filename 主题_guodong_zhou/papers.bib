@misc{guodong_zhou_2421ee42924808c3,
  title = {TREC 2005 Genomics Track at I2R},
  author = {Nie Yu and Xiaofeng Yang and Juan Xiao and Soon-Heng Tan and Guodong Zhou and Lingpeng Yang and Jie Zhang and Donghong Ji and Jian Su},
