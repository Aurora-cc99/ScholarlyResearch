@misc{guodong_zhou_a8a571b4276ddbd9,
  title = {Interactively-Propagative Attention Learning for Implicit Discourse Relation Recognition},
  author = {Huibin Ruan and Zhen Huang and Guodong Zhou and Yang Xu and Min Zhang and Yu Hong},
  year = {2020},
  doi = {10.18653/V1/2020.COLING-MAIN.282},
  url = {https://doi.org/10.18653/V1/2020.COLING-MAIN.282},
  howpublished = {COLING},
  annotation = {中文辅助译名：用于内隐话语关系识别的交互式传播注意学习},
  abstract = {We tackle implicit discourse relation recognition.Both self-attention and interactive-attention mechanisms have been applied for attention-aware representation learning, which improves the current discourse analysis models.To take advantages of the two attention mechanisms simultaneously, we develop a propagative attention learning model using a cross-coupled two-channel network.We experiment on Penn Discourse Treebank.The test results demonstrate that our model yields substantial improvements over the baselines (BiLSTM and BERT).},
}

@misc{guodong_zhou_9a38fa3173bddc26,
  title = {Multimodal Topic-Enriched Auxiliary Learning for Depression Detection},
  author = {Minghui An and Guodong Zhou and Jingjing Wang and Shoushan Li},
  year = {2020},
  doi = {10.18653/V1/2020.COLING-MAIN.94},
  url = {https://doi.org/10.18653/V1/2020.COLING-MAIN.94},
  howpublished = {COLING},
  annotation = {中文辅助译名：用于抑郁症检测的多模态主题丰富辅助学习},
  abstract = {From the perspective of health psychology, human beings with long-term and sustained negativity are highly probable to be diagnosed with depression.Inspired by this, we argue that the global topic information derived from user-generated contents (e.g., texts and images) is crucial to boost the performance of the depression detection task, though this information has been neglected by almost all previous studies on depression detection.To this end, we propose a new Multimodal Topic-enriched Auxiliary Learning (MTAL) approach, aiming at capturing the topic information inside different modalities (i.e., texts and images) for depression detection.Especially, in our approach, a modality-agnostic topic model is proposed to be capable of mining the topical clues from either the discrete textual signals or the continuous visual signals.On this basis, the topic modeling w.r.t. the two modalities are cast as two auxiliary tasks for improving the performance of the primary task (i.e., depression detection).Finally, the detailed evaluation demonstrates the great advantage of our MTAL approach to depression detection over the state-of-the-art baselines.This justifies the importance of the multimodal topic information to depression detection and the effectiveness of our approach in capturing such information.},
}

