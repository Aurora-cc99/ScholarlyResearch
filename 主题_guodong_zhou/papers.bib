@misc{guodong_zhou_03234f2a416753d5,
  title = {Exploring Knowledge Filtering for Retrieval-Augmented Question Answering},
  author = {Minjie Qiang and Zhongqing Wang and Shoushan Li and Guodong Zhou},
  year = {2026},
  doi = {10.1109/taslpro.2026.3658957},
  url = {https://doi.org/10.1109/taslpro.2026.3658957},
  howpublished = {IEEE Transactions on Audio Speech and Language Processing},
  annotation = {中文辅助译名：探索检索增强问答的知识过滤},
  abstract = {Retrieval-Augmented Generation significantly enhances the performance of Large Language Models on knowledge-intensive tasks by incorporating external knowledge. However, retrieval is not always beneficial, as the presence of harmful knowledge in retrieved documents can degrade generation quality. While existing methods attempt to mitigate this by either assessing the necessity of retrieval or by compressing retrieved documents, they struggle to reject entirely harmful documents selectively. To address this, we propose a novel two-stage framework. First, we establish an annotation strategy to label the harmfulness of a document based on its impact on downstream task performance. Subsequently, our Knowledge Filtering module utilizes this annotated data to learn to identify and eliminate harmful knowledge. For this module, we develop and evaluate four distinct strategies, ranging from methods that leverage LLM self-evaluation and lightweight proxy models to those based on preference alignment. Experiments conducted on three diverse question answering datasets demonstrate that our approach effectively purges harmful knowledge, leading to more reliable and accurate responses.},
}

