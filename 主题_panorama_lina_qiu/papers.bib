@misc{panorama_jiahui_pan_a79db7ce886d,
  title = {A Multi-Scale Attention-Based Reconstruction Fusion Network for Motor Imagery Classification},
  author = {Lina Qiu and You Hu and Minjin Wu and Baiqiang Long and Tianjian Chen and Jiahui Pan},
  year = {2026},
  doi = {10.1109/jbhi.2026.3668760},
  url = {https://doi.org/10.1109/jbhi.2026.3668760},
  howpublished = {IEEE J. Biomed. Health Informatics},
  annotation = {中文辅助译名：用于运动意象分类的多尺度基于注意力的重建融合网络.. IEEE J Biomed Health Inform},
  abstract = {Motor imagery (MI) is a widely used cognitive paradigm in brain-computer interface (BCI) systems, where accurate and efficient MI decoding is essential for real-time human-machine interaction. However, the non-stationary nature and pronounced inter-subject variability of electroencephalography (EEG) signals pose significant challenges to reliable decoding. To address these issues, we propose a multi-scale attention-based reconstruction fusion network (MSARFNet) for MI-EEG decoding. The proposed framework employs parallel multi-scale convolutional branches to extract discriminative spatio-temporal features at different temporal resolutions. An attention-based reconstruction fusion module is then introduced to selectively diminish non-dominant information while promoting effective interaction among multi-scale features. Furthermore, local-global temporal encoding strategy is designed to enhance transient MI-related responses through local temporal context aggregation and subsequently capture long-range temporal dependencies via global temporal modeling. Subject-dependent experiments conducted on the BCI Competition IV 2a and 2b datasets demonstrate that MSARFNet achieves average classification accuracies of 84.64% and 87.96%, respectively, outperforming several state-of-the-art methods. These results indicate that MSARFNet provides an effective and robust solution for EEG-based MI decoding.},
}

@misc{panorama_lina_qiu_e50d4c501c6d9039,
  title = {Attention-Based Explicit Reconstruction Fusion Network for Motor Imagery Decoding},
  author = {You Hu and Minjin Wu and Baiqiang Long and Tianjian Chen and Lina Qiu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11462558},
  url = {https://doi.org/10.1109/icassp55912.2026.11462558},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：用于运动意象解码的基于注意力的显式重建融合网络},
  abstract = {Motor imagery (MI) electroencephalography (EEG) signals are highly non-stationary and exhibit substantial inter-subject variability, posing challenges for single-scale feature extraction. Moreover, existing multi-scale fusion methods often rely on simple fusion or attention mechanisms, which limits their ability to effectively emphasize informative features. To address these limitations, this paper proposes an attention-based explicit reconstruction fusion network (AERNet) for MI-EEG decoding. AERNet employs multiple convolutional branches to extract complementary spatio-temporal features at different scales, followed by an attention-based explicit reconstruction fusion module that reorganizes and integrates multi-scale representations. Experiments on two public MI-EEG datasets demonstrate the effectiveness of the proposed method.},
}

@misc{panorama_lina_qiu_7f9246675d136587,
  title = {GT-ARN: A Graph-Tokenized Adaptive Retentive Network for EEG Decoding},
  author = {Baiqiang Long and Tianjian Chen and You Hu and Minjin Wu and Quanlin Chen and Lina Qiu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11464507},
  url = {https://doi.org/10.1109/icassp55912.2026.11464507},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：GT-ARN：用于脑电图解码的图标记化自适应记忆网络},
  abstract = {Transformer-based models have shown strong potential for capturing long-range temporal dependencies in EEG signals, but they often neglect intrinsic signal characteristics. Conventional approaches rely solely on self-attention without domain priors or noise suppression, and construct tokens by convolution based on Euclidean proximity, which does not necessarily reflect true inter-channel dependencies. To address these limitations, we propose the Graph-Tokenized Adaptive Retentive Network (GT-ARN), a framework tailored for EEG decoding. GT-ARN introduces a Graph-based Token Extractor (GTE) that captures short-term temporal patterns via one-dimensional convolution and models inter-channel dependencies using dynamic graph convolution. The extracted tokens are processed by an Adaptive Retention Module, which employs a learnable decay factor to flexibly adjust temporal dependency ranges and a gating mechanism to suppress redundant or noise-related tokens. This design yields more informative representations of EEG dynamics. Extensive experiments on two public EEG datasets demonstrate that GT-ARN achieves state-of-the-art decoding performance, validating its effectiveness. The source code of GT-ARN is publicly available at: https://github.com/VerdantE1/GT_ARN},
}

@misc{panorama_lina_qiu_1696a326cafb301b,
  title = {LF-MHANet: A Driving-Fatigue Detection Network Integrating Learnable Feature Fusion with Multi-Head Attention},
  author = {Tianjian Chen and Baiqiang Long and Junyu Wang and You Hu and Minjin Wu and Lina Qiu},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11463238},
  url = {https://doi.org/10.1109/icassp55912.2026.11463238},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：LF-MHANet：将可学习特征融合与多头注意力相结合的驾驶疲劳检测网络},
  abstract = {Driving safety is heavily dependent on the driver’s level of vigilance. Electroencephalogram (EEG), a reliable indicator of brain activity with high temporal resolution, holds great promise for fatigue monitoring. This paper proposes a novel end-to-end deep-learning model, the learnable feature fusion and multi-head attention network (LF-MHANet), for driving-fatigue recognition. The model first employs depthwise separable convolutions to extract deep features from EEG signals, then innovatively applies the Hilbert transform to obtain the feature envelope and fuses it with the original high-frequency details via a learnable adaptive feature fusion module. Subsequently, a multi-head channel-attention module is introduced to adjust feature weights in groups and thereby enhance critical information. Experiments on two public driving datasets demonstrate that LF-MHANet outperforms state-of-the-art models, confirming its effectiveness. Further ablation studies verify the contributions of both the learnable feature fusion and the multi-head attention modules.},
}

@misc{panorama_jiahui_pan_24ce95e78f97e378,
  title = {PA-MEANet: A Pointer-Attention and Manifold-to-Entropy Adaptation Network for Cross-Subject EEG-fNIRS Decoding},
  author = {Lina Qiu and Zixiang Zhou and Jiahui Pan},
  year = {2026},
  doi = {10.1109/jiot.2026.3754495},
  url = {https://doi.org/10.1109/jiot.2026.3754495},
  howpublished = {IEEE Internet of Things Journal},
  annotation = {中文辅助译名：PA-MEANet：用于跨主题 EEG-fNIRS 解码的指针注意和流形熵适应网络},
  abstract = {Hybrid EEG-fNIRS brain-computer interfaces (BCIs) fuse neural electrical activity and hemodynamic metabolic information, offering substantial potential for robust brain-state decoding. However, the practical deployment of such systems is hindered by two critical issues: the inherent physiological asymmetry between electrophysiological and hemodynamic signals, and severe performance degradation under cross-subject settings due to inter-individual distribution shifts. To address these challenges, this paper proposes PA-MEANet, a lightweight multimodal fusion network for cross-subject EEG-fNIRS classification. The framework first employs modality-specific encoders tailored to the distinct temporal-spatial characteristics of EEG and fNIRS. An electrophysiological pointer-attention module (EPAM) is then introduced to exploit the asymmetric cross-modal relationship by using EEG representations as pointers to retrieve task-relevant fNIRS contextual information. A dual-modal gated integrator (DMGI) dynamically regulates the contribution of the retrieved fNIRS context through an EEG residual pathway, thereby enabling task-dependent integration of complementary electrophysiological and hemodynamic information. Furthermore, a two-stage progressive unsupervised domain adaptation strategy—combining Euclidean alignment (EA) at the input level and entropy-minimization-based test-time adaptation (TTA) at the model level—is adopted to mitigate the impact of cross-subject distribution shifts. },
}

