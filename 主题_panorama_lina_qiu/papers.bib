@misc{panorama_lina_qiu_acc671a1be8e1bcd,
  title = {Knowledge-Enhanced Contrastive Learning for Gait Emotion Recognition},
  author = {Xiaotong Fan and Lina Qiu and Mengxin Xu and Yan Liang and Chengju Zhou},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11460443},
  url = {https://doi.org/10.1109/icassp55912.2026.11460443},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：用于步态情感识别的知识增强对比学习},
  abstract = {With its non-contact nature and universality across diverse scenarios, gait is gradually emerging as a promising technology for emotion recognition. Recently, self-supervised learning has been applied to gait emotion recognition; however, existing methods fail to make full use of gait’s affective information. To address this issue, the present paper innovatively proposes a contrastive learning framework to mine gait-based emotional features related to emotion recognition. Specifically, we introduce a Spatial Extent Difference Learning(SEDL), which measures the differences in spatial extent between augmented samples to help effectively capture spatially-related emotional features. In addition, we design a Multi-speed Prediction Module(MPM) that predicts various speeds, enabling the emotion representation in temporal dimension. We conducted experiments on the Emotion-Gait dataset, achieving significant improvements across various evaluation protocols and outperforming state-of-the-art approaches, thereby validating the effectiveness and superiority of our proposed framework.},
}

