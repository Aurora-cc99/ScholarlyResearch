@misc{panorama_lina_qiu_4230cfbfefa6f8b0,
  title = {Multi-Source Domain Generalized Person Re-Identification with Dualstyle Augmentation and Dynamic Memory Classifier},
  author = {Lewei He and Kaiyong Zhang and Biranchi Panda and Lina Qiu and Quanyu Dai and Jiahui Pan},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11461549},
  url = {https://doi.org/10.1109/icassp55912.2026.11461549},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：使用双重增强和动态记忆分类器的多源域广义行人重识别},
  abstract = {Person re-identification (ReID) is a critical task in computer vision, aiming at identifying the same individuals across various, non-overlapping camera views. Traditional ReID approaches, predominantly based on supervised methods, face significant performance decreases when applied across different domains due to different camera views. To address this challenge, we propose DualStyle, a novel approach that integrates two style enhancement techniques to preserve the integrity of images while boosting the model’s generalization capabilities. Furthermore, we propose a dynamic memory classifier, which combines a temporal-adaptive memory update (TAMU) module and a class-specific loss, to refine the non-parametric classifier with better adaptation to inter-domain variations. Extensive experiments validate that our method significantly elevates the model’s ability to generalize across unseen domains, achieving state-of-the-art performance on several major ReID datasets with the mAP increased by 0.9% to 4.3% and the Rank-1 increased by 1.0% to 7.8%.},
}

