@misc{alexandre_gramfort_fc7a5b14c0b50666,
  title = {Automated rejection and repair of bad trials in MEG/EEG},
  author = {Yousra Bekhti and Denis A. Engemann and Mainak Jas and Federico Raimondo and Alexandre Gramfort},
  year = {2016},
  doi = {10.1109/PRNI.2016.7552336},
  url = {https://doi.org/10.1109/PRNI.2016.7552336},
  howpublished = {PRNI},
  annotation = {中文辅助译名：自动拒绝和修复 MEG/EEG 中的不良试验},
  abstract = {We present an automated solution for detecting bad trials in magneto-/electroencephalography (M/EEG). Bad trials are commonly identified using peak-to-peak rejection thresholds that are set manually. This work proposes a solution to determine them automatically using cross-validation. We show that automatically selected rejection thresholds perform at par with manual thresholds, which can save hours of visual data inspection. We then use this automated approach to learn a sensor-specific rejection threshold. Finally, we use this approach to remove trials with finer precision and/or partially repair them using interpolation.We illustrate the performance on three public datasets. The method clearly performs better than a competitive benchmark on a 19-subject Faces dataset.},
}

@misc{alexandre_gramfort_e888fa3944fafa02,
  title = {Nipype: a flexible, lightweight and extensible neuroimaging data processing framework in Python. 0.12.0-rc1},
  author = {William Triplett and Blake Dewey and Ariel Rokem and Julia M. Huntenburg and Daniel Geisler and L. Nathan Perkins and Michael L. Waskom and Daniel S. Margulies and Sami Andberg and Michael Dayan and Xiang-Zhen Kong and Anisha Keshavan and Dmytro Bielievtsov and Erik Ziegler and Alexandre Gramfort and Janosch Linkersdörfer and B. Nolan Nichols and Paul Sharp and Michael Hanke and Stephan Gerhard and Oscar Esteban and Arman Eshaghi and Christopher John Steele and Dav Clark and David Gage Ellis and Leonie Lampe and Franziskus Liem and Joshua D. Warner and Lijie Huang and Carlo Hämäläinen and John Pellman and Krzysztof J. Gorgolewski and Daniel Clark and R. Cameron Craddock and Benjamin T. Acland and Christopher Burns and Jessica Forbes and René Küttner and Martin Perez-Guevara and Gaël Varoquaux and Andrew Floren and Basile Pinsard and Shariq N. Iqbal and Erik K. Kastman and Demian Wassermann and Alexandre Manhães-Savio and Michael Philipp Notter and Satrajit S. Ghosh and Daniel C. McNamee and Gavin Cooper and Hans J. Johnson and Jörg Stadler and David Welch and Sharad Sikka and Christopher J. Markiewicz and Iván González and William Broderick and Dimitri Papadopoulos Orfanos and Jens Kleesiek and Siqi Liu and Tristan Glatard and Yaroslav O. Halchenko and Alexander Schäfer and Cindee M. Madison},
