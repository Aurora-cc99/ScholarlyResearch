@misc{alexandre_gramfort_49f2ff982a4cf721,
  title = {Dexamethasone use and mortality in hospitalized patients with coronavirus disease 2019: A multicentre retrospective observational study},
  author = {Nicolas Hoertel and Marina Sánchez Rico and Raphaël Vernet and Nathanaël Beeker and Antoine Neuraz and Jesús María Alvarado and Christel Daniel and Nicolás Paris and Alexandre Gramfort and Guillaume Lemaître and Elisa Salamanca and Mélodie Bernaux and Ali Bellamine and Anita Burgun and Frédéric Limosin},
  year = {2021},
  doi = {10.1111/bcp.14784},
  url = {https://doi.org/10.1111/bcp.14784},
  howpublished = {British Journal of Clinical Pharmacology},
  annotation = {中文辅助译名：2019 年冠状病毒病住院患者地塞米松的使用和死亡率：一项多中心回顾性观察研究},
  abstract = {Aims To examine the association between dexamethasone use and mortality among patients hospitalized for COVID‐19. Methods We examined the association between dexamethasone use and mortality at AP‐HP Greater Paris University hospitals. Study baseline was defined as the date of hospital admission. The primary endpoint was time to death. We compared this endpoint between patients who received dexamethasone and those who did not in time‐to‐event analyses adjusted for patient characteristics (such as age, sex and comorbidity) and clinical and biological markers of clinical severity of COVID‐19, and stratified by the need for respiratory support, i.e. mechanical ventilation or oxygen. The primary analysis was a multivariable Cox regression model. Results Of 12 217 adult patients hospitalized with a positive COVID‐19 reverse transcriptase–polymerase chain reaction test, 171 (1.4%) received dexamethasone orally or by intravenous perfusion during the visit. Among patients who required respiratory support, the end‐point occurred in 10/63 (15.9%) patients who received dexamethasone and 298/1129 (26.4%) patients who did not. In this group, there was a significant association between dexamethasone use and reduced mortality in the primary analysis (hazard ratio, 0.46; 95% confidence interval 0.22–0.96, P = .039). Among patients who did not require respiratory support, there was no significant association between dexamethasone use and the endpoint. Conclusions In this multicentre observatio},
}

@misc{alexandre_gramfort_53120e6a0b26d702,
  title = {Long-range and hierarchical language predictions in brains and algorithms},
  author = {Jean-Rémi King and Alexandre Gramfort and Charlotte Caucheteux},
  year = {2021},
  doi = {10.48550/ARXIV.2111.14232},
  url = {https://doi.org/10.48550/ARXIV.2111.14232},
  howpublished = {CoRR},
  annotation = {中文辅助译名：大脑和算法中的远程和分层语言预测},
  abstract = {Deep learning has recently made remarkable progress in natural language processing. Yet, the resulting algorithms remain far from competing with the language abilities of the human brain. Predictive coding theory offers a potential explanation to this discrepancy: while deep language algorithms are optimized to predict adjacent words, the human brain would be tuned to make long-range and hierarchical predictions. To test this hypothesis, we analyze the fMRI brain signals of 304 subjects each listening to 70min of short stories. After confirming that the activations of deep language algorithms linearly map onto those of the brain, we show that enhancing these models with long-range forecast representations improves their brain-mapping. The results further reveal a hierarchy of predictions in the brain, whereby the fronto-parietal cortices forecast more abstract and more distant representations than the temporal cortices. Overall, this study strengthens predictive coding theory and suggests a critical role of long-range and hierarchical predictions in natural language processing.},
}

@misc{alexandre_gramfort_bcf20668e734cdfa,
  title = {International Analysis of Electronic Health Records of Children and Youth Hospitalized With COVID-19 Infection in 6 Countries},
  author = {Florence T. Bourgeois and Alba Gutiérrez‐Sacristán and Mark S. Keller and Molei Liu and Chuan Hong and Clara-Lea Bonzel and Amelia L.M. Tan and Bruce J. Aronow and Martin Boeker and John Booth and Jaime Cruz Rojo and Batsal Devkota and Noelia García Barrio and Nils Gehlenborg and Alon Geva and David A. Hanauer and Meghan R. Hutch and Richard W. Issitt and Jeffrey Gordon Klann and Yuan Luo and Kenneth D. Mandl and Chengsheng Mao and Bertrand Moal and Karyn L. Moshal and Shawn N. Murphy and Antoine Neuraz and Kee Yuan Ngiam and Gilbert S. Omenn and Lav P. Patel and Miguel Pedrera‐Jiménez and Neil James Sebire and Pablo Serrano Balazote and Arnaud Serret-Larmande and Andrew Michael South and Anastassia Spiridou and Deanne Taylor and Patric Tippmann and Shyam Visweswaran and Griffin M. Weber and Isaac S. Kohane and Tianxi Cai and Paul Avillach and James R. Aaron and Giuseppe Agapito and Adem Albayrak and MARIO ALESSIANI and Danilo F. Amendola and François Angoulvant and Li L.L.J. Anthony and Andrew M. Atz and James Balshi and Brett K. Beaulieu‐Jones and Douglas S. Bell and Antonio Bellasi and Riccardo Bellazzi and Vincent Benoît and Michele Beraghi and José Luis Bernal Sobrino and Mélodie Bernaux and Romain Bey and Alvar Blanco Martínez and Silvano Bòsari and Robert L. Bradford and Gabriel A. Brat and Stéphane Breant and Nicholas W. Brown and William A Bryant and Mauro Bucalo and Anita Burgun and Mario Cannataro and Aldo Carmona and Charlotte Caucheteux and Julien Champ and Krista Chen and Jin Chen and Luca Chiovato and Lorenzo Chiudinelli and James J. Cimino and Tiago K. Colicchio and Sylvie Cormont and Sébastien Cossin and Jean B. Craig and Juan Luis Cruz-Bermúdez and Arianna Dagliati and Mohamad Daniar and Christel Daniel and Anahita Davoudi and Julien Dubiel and Scott L. DuVall and Loïc Estève and Shirley Fan and Robert W Follett and Paula Schmidt Azevedo Gaiolla and Thomas Ganslandt and Lana Xia Garmire and Tobias Gradinger and Alexandre Gramfort and Romain Griffier and Nicolas Griffon and Olivier Grisel},
