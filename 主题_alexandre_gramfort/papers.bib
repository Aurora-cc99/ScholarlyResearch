  author = {Nicolas Hoertel and Marina Sánchez Rico and Raphaël Vernet and Anne‐Sophie Jannot and Antoine Neuraz and Carlos Blanco and Cédric Lemogne and Guillaume Airagnes and Nicolás Paris and Christel Daniel and Alexandre Gramfort and Guillaume Lemaître and Mélodie Bernaux and Ali Bellamine and Nathanaël Beeker and Frédéric Limosin},
