@misc{alexandre_gramfort_35a297c54181e269,
  title = {Multi-subject MEG/EEG source imaging with sparse multi-task regression},
  author = {Alexandre Gramfort and Hicham Janati and Thomas Bazeille and Bertrand Thirion and Marco Cuturi},
  year = {2020},
  doi = {10.1016/J.NEUROIMAGE.2020.116847},
  url = {https://doi.org/10.1016/J.NEUROIMAGE.2020.116847},
  howpublished = {NeuroImage},
  annotation = {中文辅助译名：具有稀疏多任务回归的多主体 MEG/EEG 源成像},
  abstract = {Magnetoencephalography and electroencephalography (M/EEG) are non-invasive modalities that measure the weak electromagnetic fields generated by neural activity. Estimating the location and magnitude of the current sources that generated these electromagnetic fields is an inverse problem. Although it can be cast as a linear regression, this problem is severely ill-posed as the number of observations, which equals the number of sensors, is small. When considering a group study, a common approach consists in carrying out the regression tasks independently for each subject using techniques such as MNE or sLORETA. An alternative is to jointly localize sources for all subjects taken together, while enforcing some similarity between them. By pooling S subjects in a single joint regression, the number of observations is S times larger, potentially making the problem better posed and offering the ability to identify more sources with greater precision. Here we show how the coupling of the different regression problems can be done through a multi-task regularization that promotes focal source estimates. To take into account intersubject variabilities, we propose the Minimum Wasserstein Estimates (MWE). Thanks to a new joint regression method based on optimal transport (OT) metrics, MWE does not enforce perfect overlap of activation foci for all subjects but rather promotes spatial proximity on the cortical mantle. Besides, by estimating the noise level of each subject, MWE copes with t},
}

@misc{alexandre_gramfort_4c59197bb2ba5c93,
  title = {Model identification and local linear convergence of coordinate descent},
  author = {Quentin Bertrand and Alexandre Gramfort and Quentin Klopfenstein and Samuel Vaiter and Joseph Salmon},
  year = {2020},
  doi = {10.48550/ARXIV.2010.11825},
  url = {https://doi.org/10.48550/ARXIV.2010.11825},
  howpublished = {CoRR},
  annotation = {中文辅助译名：模型辨识与坐标下降的局部线性收敛},
  abstract = {For composite nonsmooth optimization problems, Forward-Backward algorithm achieves model identification (e.g. support identification for the Lasso) after a finite number of iterations, provided the objective function is regular enough. Results concerning coordinate descent are scarcer and model identification has only been shown for specific estimators, the support-vector machine for instance. In this work, we show that cyclic coordinate descent achieves model identification in finite time for a wide class of functions. In addition, we prove explicit local linear convergence rates for coordinate descent. Extensive experiments on various estimators and on real datasets demonstrate that these rates match well empirical results.},
}

@misc{alexandre_gramfort_63fd0c5294581470,
  title = {Combining magnetoencephalography with magnetic resonance imaging enhances learning of surrogate-biomarkers},
  author = {Denis Alexander Engemann and Oleh Kozynets and David Sabbagh and Guillaume Lemaître and Gael P. Varoquaux and Franziskus Liem and Alexandre Gramfort},
  year = {2020},
  doi = {10.7554/elife.54055},
  url = {https://doi.org/10.7554/elife.54055},
  howpublished = {eLife},
  annotation = {中文辅助译名：脑磁图与磁共振成像相结合可增强替代生物标志物的学习},
  abstract = {Electrophysiological methods, that is M/EEG, provide unique views into brain health. Yet, when building predictive models from brain data, it is often unclear how electrophysiology should be combined with other neuroimaging methods. Information can be redundant, useful common representations of multimodal data may not be obvious and multimodal data collection can be medically contraindicated, which reduces applicability. Here, we propose a multimodal model to robustly combine MEG, MRI and fMRI for prediction. We focus on age prediction as a surrogate biomarker in 674 subjects from the Cam-CAN dataset. Strikingly, MEG, fMRI and MRI showed additive effects supporting distinct brain-behavior associations. Moreover, the contribution of MEG was best explained by cortical power spectra between 8 and 30 Hz. Finally, we demonstrate that the model preserves benefits of stacking when some data is missing. The proposed framework, hence, enables multimodal learning for a wide range of biomarkers from diverse types of brain signals.},
}

