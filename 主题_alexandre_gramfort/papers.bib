@misc{alexandre_gramfort_68efc7534f91fec4,
  title = {Imaging Neuroscience opening editorial},
  author = {Stephen M. Smith and Til Ole Bergmann and Birte U. Forstmann and Alain Dagher and Shella Dawn Keilholz and Kristen M. Kennedy and Sonja A. Kotz and Cindy Lustig and G. Bruce Pike and Marc Tittgemeyer and Mark W. Woolrich and B.T. Thomas Yeo and Andrew L. Alexander and Janine Diane Bijsterbosch and Tjeerd W. Boonstra and M. Mallar Chakravarty and Chris Chambers and Catie Chang and Bradley T. Christian and Sarang S. Dalal and Nai Ding and Audrey Duarte and Audrey Peiwen Fan and Alexandre Gramfort and Gesa Hartwigsen and Mbemba Jabbi and Peter Kochunov and Ulrike M. Krämer and Martin A. Lindquist and Jean‐François Mangin and Kevin Murphy and Jon̈athan R. Polimeni and Emma C. Robinson and Monica D. Rosenberg and Sepideh Sadaghiani and Mohamed Lamine Seghier and Yen‐Yu Ian Shih and Axel Thielscher and Lucina Q. Uddin and Dimitri Van De Ville and Wim Vanduffel and Chao‐Gan Yan and Anastasia Yendiki},
  year = {2023},
  doi = {10.1162/imag_e_00007},
  url = {https://doi.org/10.1162/imag_e_00007},
  howpublished = {Imaging Neuroscience},
  annotation = {中文辅助译名：影像神经科学开幕社论},
  abstract = {In this editorial we introduce a new non-profit open access journal, Imaging Neuroscience. In April 2023, editors of the journals NeuroImage and NeuroImage:Reports resigned, and a month later launched Imaging Neuroscience. NeuroImage had long been the leading journal in the field of neuroimaging. While the move to fully open access in 2020 represented a positive step toward modern academic practices, the publication fee was set to a level that the editors found unethical and unsustainable. The publisher of NeuroImage, Elsevier, was unwilling to reduce the fee after much discussion. This led us to launch Imaging Neuroscience with MIT Press, intended to replace NeuroImage as our field’s leading journal, but with greater control by the neuroimaging academic community over publication fees and adoption of modern and ethical publishing practices.},
}

@misc{alexandre_gramfort_92886981650e65e5,
  title = {Convolutional Monge Mapping Normalization for learning on biosignals},
  author = {Alexandre Gramfort and Rémi Flamary and Théo Gnassounou},
  year = {2023},
  doi = {10.48550/ARXIV.2305.18831},
  url = {https://doi.org/10.48550/ARXIV.2305.18831},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于生物信号学习的卷积蒙日映射归一化},
  abstract = {In many machine learning applications on signals and biomedical data, especially electroencephalogram (EEG), one major challenge is the variability of the data across subjects, sessions, and hardware devices. In this work, we propose a new method called Convolutional Monge Mapping Normalization (CMMN), which consists in filtering the signals in order to adapt their power spectrum density (PSD) to a Wasserstein barycenter estimated on training data. CMMN relies on novel closed-form solutions for optimal transport mappings and barycenters and provides individual test time adaptation to new data without needing to retrain a prediction model. Numerical experiments on sleep EEG data show that CMMN leads to significant and consistent performance gains independent from the neural network architecture when adapting between subjects, sessions, and even datasets collected with different hardware. Notably our performance gain is on par with much more numerically intensive Domain Adaptation (DA) methods and can be used in conjunction with those for even better performances.},
}

