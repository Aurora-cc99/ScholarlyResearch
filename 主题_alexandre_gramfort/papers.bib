  title = {A unified view on beamformers for M/EEG source reconstruction},
  author = {Alexandre Gramfort and Robert Oostenveld and John C. Mosher and Jan-Mathijs Schoffelen and Sarang S. Dalal and Britta U. Westner and Vladimir Litvak},
