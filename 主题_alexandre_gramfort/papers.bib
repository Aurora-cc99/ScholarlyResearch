@misc{alexandre_gramfort_5a7d5d1806cb3a12,
  title = {Retour d’expérience sur Covidom : une solution de télésurveillance pour les patients porteurs ou suspectés Covid-19},
  author = {Youri Yordanov and Agnès Dechartres and François‐Xavier Lescure and Caroline Apra and Pascaline Villie and Jerôme Marchand-Arvier and Aurélien Dinh and Patrick Jourdain and Erwan Debuc and Charlotte Caucheteux and Alexandre Gramfort and Luc Jaulmes and Jenny Mansour and Arthur Mensch and Amélie Aïm-Eusébi and Alexandre Bleibtreu and Laurène Deconinck and Christine Katlama and Josselin Le Bel and J Y Artigou and Amélie Banzet and Elodie Boucheron and Christiane Boudier and Edouard Buzenac and Marie-Claire Chapron and Dalhia Chekaoui and Laurent Bastard and Alexandre Grenier and Pierre-Étienne Haas and Julien Hody and Michèle Jarraya and Louis Lacaille and Aurélie Le Guern and Jeremy Leclert and Fanny Male and Emmanuel Martin-Blondet and Apolinne Nassour and Oussama Ourahou and Thomas Penn and Ribardiere, Ambre and Nicolas Robin and Camille Rouge and Nicolas Schmidt and Sofia Zemouri},
  year = {2020},
  doi = {10.3166/afmu-2020-0267},
  url = {https://doi.org/10.3166/afmu-2020-0267},
  howpublished = {Annales françaises de médecine d’urgence},
  annotation = {中文辅助译名：Covid-19 患者或嫌疑人的远程监控解决方案},
  abstract = {Covidom est une plateforme de télésurveillance destinée aux patients suspects ou atteints de Covid-19, ne nécessitant pas une hospitalisation au décours de leur prise en charge initiale. Cet outil a été coconstruit avec tous les acteurs du soin (ville, hôpital, institutions). Il se compose d’une application Web et d’un centre de télésurveillance permettant de surveiller à distance les patients atteints de Covid-19. Cette surveillance est faite à l’aide de brefs questionnaires quotidiens, autoadministrés et standardisés. Actuellement, plus de 60 000 patients ont achevé leur suivi dans Covidom. Covidom est une solution innovante permettant la surveillance à domicile des patients atteints d’une forme légère de Covid-19.},
}

@misc{alexandre_gramfort_c6ca4fa822f62e09,
  title = {Comparison of beamformer implementations for MEG source localization},
  author = {Robert Oostenveld and Alexandre Gramfort and John C. Mosher and Jan-Mathijs Schoffelen and Sarang S. Dalal and Britta U. Westner and Amit Jaiswal and Vladimir Litvak and Caroline Witton and Matti Stenroos and Jukka Nenonen and Lauri Parkkonen},
  year = {2020},
  doi = {10.1016/J.NEUROIMAGE.2020.116797},
  url = {https://doi.org/10.1016/J.NEUROIMAGE.2020.116797},
  howpublished = {NeuroImage},
  annotation = {中文辅助译名：MEG 源定位的波束形成器实现比较},
  abstract = {Beamformers are applied for estimating spatiotemporal characteristics of neuronal sources underlying measured MEG/EEG signals. Several MEG analysis toolboxes include an implementation of a linearly constrained minimum-variance (LCMV) beamformer. However, differences in implementations and in their results complicate the selection and application of beamformers and may hinder their wider adoption in research and clinical use. Additionally, combinations of different MEG sensor types (such as magnetometers and planar gradiometers) and application of preprocessing methods for interference suppression, such as signal space separation (SSS), can affect the results in different ways for different implementations. So far, a systematic evaluation of the different implementations has not been performed. Here, we compared the localization performance of the LCMV beamformer pipelines in four widely used open-source toolboxes (MNE-Python, FieldTrip, DAiSS (SPM12), and Brainstorm) using datasets both with and without SSS interference suppression. We analyzed MEG data that were i) simulated, ii) recorded from a static and moving phantom, and iii) recorded from a healthy volunteer receiving auditory, visual, and somatosensory stimulation. We also investigated the effects of SSS and the combination of the magnetometer and gradiometer signals. We quantified how localization error and point-spread volume vary with the signal-to-noise ratio (SNR) in all four toolboxes. When applied carefully to },
}

