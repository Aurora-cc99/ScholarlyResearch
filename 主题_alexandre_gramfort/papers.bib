@misc{alexandre_gramfort_0794b8660e31fcfc,
  title = {Multinational characterization of neurological phenotypes in patients hospitalized with COVID-19},
  author = {Trang T. Le and Alba Gutiérrez‐Sacristán and Jiyeon Son and Chuan Hong and Andrew Michael South and Brett K. Beaulieu‐Jones and Ne Hooi Will Loh and Yuan Luo and Michele M. Morris and Kee Yuan Ngiam and Lav P. Patel and Malarkodi Jebathilagam Samayamuthu and Emily Schriver and Amelia L.M. Tan and Jason H. Moore and Tianxi Cai and Gilbert S. Omenn and Paul Avillach and Isaac S. Kohane and James R. Aaron and Giuseppe Agapito and Adem Albayrak and MARIO ALESSIANI and Danilo F. Amendola and François Angoulvant and Li L.L.J. Anthony and Bruce J. Aronow and Andrew M. Atz and James Balshi and Douglas S. Bell and Antonio Bellasi and Riccardo Bellazzi and Vincent Benoît and Michele Beraghi and José Luis Bernal Sobrino and Mélodie Bernaux and Romain Bey and Alvar Blanco Martínez and Martin Boeker and Clara-Lea Bonzel and John Booth and Silvano Bosari and Florence T. Bourgeois and Robert L. Bradford and Gabriel A. Brat and Stéphane Breant and Nicholas W. Brown and William A Bryant and Mauro Bucalo and Anita Burgun and Mario Cannataro and Aldo Carmona and Charlotte Caucheteux and Julien Champ and Krista Chen and Jin Chen and Luca Chiovato and Lorenzo Chiudinelli and James J. Cimino and Tiago K. Colicchio and Sylvie Cormont and Sébastien Cossin and Jean B. Craig and Juan Luis Cruz-Bermúdez and Jaime Cruz Rojo and Arianna Dagliati and Mohamad Daniar and Christel Daniel and Anahita Davoudi and Batsal Devkota and Julien Dubiel and Loïc Estève and Shirley Fan and Robert W Follett and Paula S. A. Gaiolla and Thomas Ganslandt and Noelia García Barrio and Lana X. Garmire and Nils Gehlenborg and Alon Geva and Tobias Gradinger and Alexandre Gramfort and Romain Griffier and Nicolas Griffon and Olivier Grisel and David A. Hanauer and Christian Haverkamp and Bing He and Darren W. Henderson and Martin Hilka and John H. Holmes and Petar Horki and Kenneth M. Huling and Meghan R. Hutch and Richard W. Issitt and Anne‐Sophie Jannot and Vianney Jouhet and Ramakanth Kavuluru and Mark S. Keller and Katie Kirchoff},
  year = {2021},
  doi = {10.1038/s41598-021-99481-9},
  url = {https://doi.org/10.1038/s41598-021-99481-9},
  howpublished = {Scientific Reports},
  annotation = {中文辅助译名：COVID-19 住院患者神经表型的跨国特征},
  abstract = {Neurological complications worsen outcomes in COVID-19. To define the prevalence of neurological conditions among hospitalized patients with a positive SARS-CoV-2 reverse transcription polymerase chain reaction test in geographically diverse multinational populations during early pandemic, we used electronic health records (EHR) from 338 participating hospitals across 6 countries and 3 continents (January–September 2020) for a cross-sectional analysis. We assessed the frequency of International Classification of Disease code of neurological conditions by countries, healthcare systems, time before and after admission for COVID-19 and COVID-19 severity. Among 35,177 hospitalized patients with SARS-CoV-2 infection, there was an increase in the proportion with disorders of consciousness (5.8%, 95% confidence interval [CI] 3.7–7.8%, pFDR < 0.001) and unspecified disorders of the brain (8.1%, 5.7–10.5%, pFDR < 0.001) when compared to the pre-admission proportion. During hospitalization, the relative risk of disorders of consciousness (22%, 19–25%), cerebrovascular diseases (24%, 13–35%), nontraumatic intracranial hemorrhage (34%, 20–50%), encephalitis and/or myelitis (37%, 17–60%) and myopathy (72%, 67–77%) were higher for patients with severe COVID-19 when compared to those who never experienced severe COVID-19. Leveraging a multinational network to capture standardized EHR data, we highlighted the increased prevalence of central and peripheral neurological phenotypes in patients },
}

@misc{alexandre_gramfort_c87696ac5e5cbf17,
  title = {HNPE: Leveraging Global Parameters for Neural Posterior Estimation},
  author = {Thomas Moreau and Gilles Louppe and Alexandre Gramfort and Pedro Rodrigues},
  year = {2021},
  url = {https://hal.archives-ouvertes.fr/hal-03139916},
  howpublished = {NeurIPS},
  annotation = {中文辅助译名：HNPE：利用全局参数进行神经后验估计},
  abstract = {Inferring the parameters of a stochastic model based on experimental observations is central to the scientific method. A particularly challenging setting is when the model is strongly indeterminate, i.e. when distinct sets of parameters yield identical observations. This arises in many practical situations, such as when inferring the distance and power of a radio source (is the source close and weak or far and strong?) or when estimating the amplifier gain and underlying brain activity of an electrophysiological experiment. In this work, we present hierarchical neural posterior estimation (HNPE), a novel method for cracking such indeterminacy by exploiting additional information conveyed by an auxiliary set of observations sharing global parameters. Our method extends recent developments in simulation-based inference (SBI) based on normalizing flows to Bayesian hierarchical models. We validate quantitatively our proposal on a motivating example amenable to analytical solutions and then apply it to invert a well known non-linear model from computational neuroscience.},
}

@misc{alexandre_gramfort_1cd730c609cdd94a,
  title = {mvlearn: Multiview Machine Learning in Python},
  author = {Richard Guo and Alexandre Gramfort and Joshua T. Vogelstein and Pierre Ablin and Iain Carmichael and Ronan Perry and Cameron Franz and Gavin Mischler and Hugo Richard and Alexander Chang and Theo Lee and Arman Koul},
  year = {2021},
  doi = {10.48550/arxiv.2005.11890},
  url = {http://arxiv.org/abs/2005.11890},
  howpublished = {J. Mach. Learn. Res.},
  annotation = {中文辅助译名：mvlearn：Python 中的多视图机器学习},
  abstract = {As data are generated more and more from multiple disparate sources, multiview data sets, where each sample has features in distinct views, have ballooned in recent years. However, no comprehensive package exists that enables non-specialists to use these methods easily. mvlearn is a Python library which implements the leading multiview machine learning methods. Its simple API closely follows that of scikit-learn for increased ease-of-use. The package can be installed from Python Package Index (PyPI) and the conda package manager and is released under the MIT open-source license. The documentation, detailed examples, and all releases are available at https://mvlearn.github.io/.},
}

@misc{alexandre_gramfort_32508b45e1f9ebfa,
  title = {POT: Python Optimal Transport},
  author = {Romain Tavenard and Nathalie T. H. Gayraud and Mokhtar Z. Alaya and Vivien Seguy and Rémi Flamary and Alexander Tong and Ievgen Redko and Aurelie Boisbunon and Antoine Rolet and Stanislas Chambon and Alexandre Gramfort and Hicham Janati and Laetitia Chapel and Adrien Corenflos and Kilian Fatras and Nemo Fournier and Léo Gautheron and Titouan Vayer and Alain Rakotomamonjy and Danica J. Sutherland and Nicolas Courty and Antony Schutz},
  year = {2021},
  doi = {10.5281/zenodo.17161062},
  url = {https://hal.science/hal-03264013v1/document},
  howpublished = {J. Mach. Learn. Res.},
  annotation = {中文辅助译名：POT：Python 最优传输},
  abstract = {This new release contains several new features and bug fixes. Among the new features we have a new submodule ot.batch that contains batch parallel solvers for several OT problems including Sinkhorn, Gromov-Wasserstein and Fused Gromov-Wasserstein. This new submodule can be used to solve many independent OT problems in parallel on CPU or GPU with shared source and target support sizes. We also implemented a new Nystrom kernel approximation for the Sinkhorn solver that can be used to speed up the computation of the Sinkhorn divergence on large datasets. We also added new 1D solvers for Linear circular OT and new solvers for free support OT barycenters with generic cost functions and for barycenters between Gaussian Mixture Models (GMMs). We also implemented two solvers for partial Fused Gromov-Wasserstein problems based on conditional gradient and projected gradient descents. Finally we have updated the documentation to reflect the new generic API and reorganized the examples gallery. New features Implement CG solvers for partial FGW (PR #687) Added feature grad=last_step for ot.solvers.solve (PR #693) Automatic PR labeling and release file update check (PR #704) Reorganize sub-module ot/lp/__init__.py into separate files (PR #714) Implement fixed-point solver for OT barycenters with generic cost functions (generalizes ot.lp.free_support_barycenter), with example. (PR #715) Implement fixed-point solver for barycenters between GMMs (PR #715), with example. Fix warning raise when},
}

@misc{alexandre_gramfort_e5bc7df100b5ec04,
  title = {Predictive usefulness of RT-PCR testing in different patterns of Covid-19 symptomatology: analysis of a French cohort of 12,810 outpatients},
  author = {Caroline Apra and Charlotte Caucheteux and Arthur Mensch and Jenny Mansour and Mélodie Bernaux and Agnès Dechartres and Erwan Debuc and Xavier Lescure and Aurélien Dinh and Youri Yordanov and Patrick Jourdain M and Arthur Mensch and Charlotte Caucheteux and Caroline Apra and Jenny Mansour and Nicolás Paris and Alexandre Gramfort and Amélie Aïm-Eusébi and Caroline Apra and Alexandre Bleibtreu and Erwan Debuc and Agnès Dechartres and Laurène Deconinck and Aurélien Dinh and Patrick Jourdain M and Christine Katlama and Josselin Le Bel and François-Xavier Lescure and Youri Yordanov and J Y Artigou and Amélie Banzet and Elodie Boucheron and Christiane Boudier and Edouard Buzenac and Marie-Claire Chapron and Dalhia Chekaoui and Laurent Bastard and Erwan Debuc and Aurélien Dinh and Alexandre Grenier and Pierre-Etienne Haas and Julien Hody and Michèle Jarraya and Patrick Jourdain M and Louis Lacaille and Aurélie Le Guern and Jeremy Leclert and Fanny Male and Jerôme Marchand-Arvier and Emmanuel Martin-Blondet and Apolinne Nassour and Oussama Ourahou and Thomas E. Penn and Ambre Ribardiere and Nicolas Robin and Camille Rouge and Nicolas Schmidt and Pascaline Villie},
  year = {2021},
  doi = {10.1038/s41598-021-99991-6},
  url = {https://doi.org/10.1038/s41598-021-99991-6},
  howpublished = {Scientific Reports},
  annotation = {中文辅助译名：RT-PCR 检测对不同 Covid-19 症状模式的预测有用性：对法国 12,810 名门诊患者队列的分析},
  abstract = {Reverse transcriptase polymerase chain reaction (RT-PCR) is a key tool to diagnose Covid-19. Yet it may not be the most efficient test in all patients. In this paper, we develop a clinical strategy for prescribing RT-PCR to patients based on data from COVIDOM, a French cohort of 54,000 patients with clinically suspected Covid-19, including 12,810 patients tested by RT-PCR. We use a machine-learning algorithm (decision tree) in order to predict RT-PCR results based on the clinical presentation. We show that symptoms alone are sufficient to predict RT-PCR outcome with a mean average precision of 86%. We identify combinations of symptoms that are predictive of RT-PCR positivity (90% for anosmia/ageusia) or negativity (only 30% of RT-PCR+ for a subgroup with cardiopulmonary symptoms): in both cases, RT-PCR provides little added diagnostic value. We propose a prescribing strategy based on clinical presentation that can improve the global efficiency of RT-PCR testing.},
}

@misc{alexandre_gramfort_e0b5a5efa39ecaa4,
  title = {International electronic health record-derived COVID-19 clinical course profiles: the 4CE consortium},
  author = {James J. Cimino and Nathan P. Palmer and Nils Gehlenborg and Alexandre Gramfort and Nina Orlova and John J. Holmes and Alberto Zambelli and Robert W. Follett and Sehi L'Yi and Jill-Jênn Vie and Vincent Benoit and Alba Gutiérrez-Sacristán and Danielle L. Mowery and Piotr Sliz and Jason H. Moore and Vianney Jouhet and Thomas Moreau and Ian D. Krantz and Luca Chiovato and Thomas Ganslandt and Anita Burgun-Parenthoine and Jean B. Craig and Sylvie Cormont and Brett K. Beaulieu-Jones and Kee Yuan Ngiam and Detlef Kraska and Mauro Bucalo and Jihad S. Obeid and Arthur Mensch and Sébastien Cossin and Robert L. Bradford and Bertrand Moal and Demian Wassermann and Andrew M. South and Katie G. Kirchoff and Alberto Malovini and Gabriel A. Brat and Gilbert S. Omenn and Lav P. Patel and Charlotte Caucheteux and Silvano Bosari and Judith Leblanc and Arnaud Serret-Larmande and Mohamad Daniar and Patricia Martel and Elisa Salamanca and Mélodie Bernaux and Emily Schriver and Griffin M. Weber and Martin Hilka and Julien Dubiel and Gaël Varoquaux and Luigia Scudeller and Julien Champ and Mark S. Keller and Paul Avillach and Arnaud Sandrin and Douglas A. Murad and Romain Bey and Romain Griffier and Patricia Serre and Antonio Bellasi and Stéphane Bréant and Christian Haverkamp and Tobias Gradinger and Amelia L. M. Tan and Riccardo Bellazzi and Nicolas Griffon and Christel Daniel-Le Bozec and Hans-Ulrich Prokosch and Batsal Devkota and Guillaume Lemaitre and Tianxi Cai and Olivier Grisel and Loic Estève and David A. Hanauer and Kenneth D. Mandl and Shawn N. Murphy and Martin Boeker and Anne-Sophie Jannot and Jeffrey G. Klann and Valentina Tibollo and Douglas S. Bell and Lemuel R. Waitman and Damien Leprovost and Nicolas Paris and Isaac S. Kohane},
  year = {2020},
  doi = {10.1038/S41746-020-00308-0},
  url = {https://doi.org/10.1038/S41746-020-00308-0},
  howpublished = {npj Digit. Medicine},
  annotation = {中文辅助译名：国际电子健康记录衍生的 COVID-19 临床病程概况：4CE 联盟},
  abstract = {We leveraged the largely untapped resource of electronic health record data to address critical clinical and epidemiological questions about Coronavirus Disease 2019 (COVID-19). To do this, we formed an international consortium (4CE) of 96 hospitals across five countries (www.covidclinical.net). Contributors utilized the Informatics for Integrating Biology and the Bedside (i2b2) or Observational Medical Outcomes Partnership (OMOP) platforms to map to a common data model. The group focused on temporal changes in key laboratory test values. Harmonized data were analyzed locally and converted to a shared aggregate form for rapid analysis and visualization of regional differences and global commonalities. Data covered 27,584 COVID-19 cases with 187,802 laboratory tests. Case counts and laboratory trajectories were concordant with existing literature. Laboratory tests at the time of diagnosis showed hospital-level differences equivalent to country-level variation across the consortium partners. Despite the limitations of decentralized data generation, we established a framework to capture the trajectory of COVID-19 disease in patients and their response to interventions.},
}

