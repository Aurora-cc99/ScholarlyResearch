  author = {Zitong Xu and Huiyu Duan and Yifei Nie and Mingda Du and Sijing Wu and Xiongkuo Min and Tianyi Zheng and Jian Zhang and Shusong Xu and Jinwei Chen and Bo Li and Guangtao Zhai},
  year = {2026},
