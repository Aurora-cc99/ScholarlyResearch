@misc{panorama_59d1207a515b_ff21d61c6c40fa68,
  title = {A Cascaded Syntactic and Semantic Dependency Parsing System},
  author = {Wanxiang Che and Zhenghua Li and Yuxuan Hu and Yongqiang Li and Bing Qin and Ting Liu and Sheng Li},
  year = {2008},
  doi = {10.3115/1596324.1596367},
  url = {https://aclanthology.org/W08-2134/},
  howpublished = {CoNLL},
  annotation = {中文辅助译名：级联句法和语义依存分析系统},
  abstract = {We describe our CoNLL 2008 Shared Task system in this paper. The system includes two cascaded components: a syntactic and a semantic dependency parsers. A first-order projective MSTParser is used as our syntactic dependency parser. In order to overcome the shortcoming of the MSTParser, that it cannot model more global information, we add a relabeling stage after the parsing to distinguish some confusable labels, such as ADV, TMP, and LOC. Besides adding a predicate identification and a classification stages, our semantic dependency parsing simplifies the traditional four stages semantic role labeling into two: a maximum entropy based argument classification and an ILP-based post inference. Finally, we gain the overall labeled macro F1 = 82.66, which ranked the second position in the closed challenge.},
}

@misc{panorama_59d1207a515b_f313ed4f3894d0a7,
  title = {Recommended or Not? Give Advice on Online Products},
  author = {Bing Qin and Yanyan Zhao and Leilei Gao and Ting Liu},
  year = {2008},
  doi = {10.1109/FSKD.2008.441},
  url = {https://doi.org/10.1109/FSKD.2008.441},
  howpublished = {FSKD (4)},
  annotation = {中文辅助译名：推荐还是不推荐？提供有关在线产品的建议},
  abstract = {This paper introduces an opinion judgment system that automatically gives advice on whether to recommend this product and furthermore provides corresponding reasons.The core task of the system can be considered as a binary sentence sentiment classification problem. A novel "polarityword-target" related feature extraction method is proposed. An opinion judgment system is then built based on the sentiment of each sentence predicted by a maximum entropy (ME) classifier with the novel features. The experimental results on two domains show that the special feature extraction methods are promising; the opinion judgment system with 91.5% average accuracy is highly effective.},
}

