@misc{panorama_qingliang_chen_18af4ec2be852d43,
  title = {Cytotoxicity and hemolysis tests on modification materials of ventricular assisted devices},
  author = {Qingliang Chen},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=MTYX201004006},
  howpublished = {Journal of Hebei United University},
  annotation = {中文辅助译名：心室辅助装置修饰材料的细胞毒性和溶血试验},
  abstract = {Objective To select the biocompatible requirements materials of the ventricular assisted device by cytotoxicity test and hemolysis test.Methods Five kinds of materials of polyurethane(APCU,PCU,PU,SPCU and HPCU)were divided into 3 parts(60cm2),sodium chloride injection was added in each of materials(60cm2).Sodium chloride injection was and added in three test-tubes as negative control and distilled water was added in three test-tubes as positive control.All of the test-tubes were placed in constant temperature water,dilution of rabbit blood was added to each test-tube and heated continuously,then the clear liquid was taken out after centrifugation and examined the optical density.The extraction of the materials after the sterilization was prepared.The sterile filter paper of the material extraction was laid on the agar surface including L-929 cells,incubated in incubator and dyed,then observed by inverted phase contrast microscope.Results The hemolytic rates of APCU,PCU,PU,SPCU and HPCU were 0.3%,1.4%,0%,23.6% and 12.1%,while the toxicity grades of APCU,PCU,SPCU,HPU and PU were 0.6,0.2,1.5,1.5 and 1.2 respectively.Conclusion APCU,PCU and PU accorded with the requirements of medical materials by hemolysis test,APCU and PCU accorded with the requirements of medical materials by cytotoxicity test.},
}

@misc{panorama_qingliang_chen_4e3e8d95d0d851cb,
  title = {Automatic Verification of Web Service Protocols for Epistemic Specifications under Dolev-Yao Model},
  author = {Qingliang Chen and Kaile Su and Chanjuan Liu and Yinyin Xiao},
  year = {2010},
  doi = {10.1109/icss.2010.33},
  url = {https://doi.org/10.1109/icss.2010.33},
  howpublished = {International Conference on Service Sciences},
  annotation = {中文辅助译名：Dolev-Yao模型下认知规范Web服务协议的自动验证},
  abstract = {Web service protocols are designed in XML formats so the message structures within are quite different from the conventional protocols. Therefore, the traditional formal verification techniques which have gain substantial achievements in practice, cannot be applied directly to them because their underlying models are written in Alice\Bob-style descriptions using high-level message formats instead of XML tags. In this paper, we propose a justification-oriented and automatic formal approach to verify, in the standard Dolev-Yao model, security properties expressed as epistemic notions for a Web service protocol, based on a fault-preserving mapping tool called SuD (SOAP under Dolev-Yao). Our approach can shed more light on Web service protocols in another perspective because the concerned properties to be verified are some inherent features of protocols.},
}

@misc{panorama_qingliang_chen_5660d417d2c1fdbf,
  title = {EWLS: A New Local Search for Minimum Vertex Cover},
  author = {Shaowei Cai and Kaile Su and Qingliang Chen},
  year = {2010},
  doi = {10.1609/aaai.v24i1.7539},
  url = {https://doi.org/10.1609/aaai.v24i1.7539},
  howpublished = {Proceedings of the AAAI Conference on Artificial Intelligence},
  annotation = {中文辅助译名：EWLS：最小顶点覆盖的新局部搜索},
  abstract = {A number of algorithms have been proposed for the Minimum Vertex Cover problem. However, they are far from satisfactory, especially on hard instances. In this paper, we introduce Edge Weighting Local Search (EWLS), a new local search algorithm for the Minimum Vertex Cover problem. EWLS is based on the idea of extending a partial vertex cover into a vertex cover. A key point of EWLS is to find a vertex set that provides a tight upper bound on the size of the minimum vertex cover. To this purpose, EWLS employs an iterated local search procedure, using an edge weighting scheme which updates edge weights when stuck in local optima. Moreover, some sophisticated search strategies have been taken to improve the quality of local optima. Experimental results on the broadly used DIMACS benchmark show that EWLS is competitive with the current best heuristic algorithms, and outperforms them on hard instances. Furthermore, on a suite of difficult benchmarks, EWLS delivers the best results and sets a new record on the largest instance.},
}

@misc{panorama_qingliang_chen_03ae3bc653e702fd,
  title = {Knowledge-theoretic approach to formal verification of Web services protocols},
  author = {Guoxiang Yao and Qingliang Chen and Chanjuan Liu and Zhuolin Yang},
  year = {2010},
  doi = {10.1109/icsess.2010.5552425},
  url = {https://doi.org/10.1109/icsess.2010.5552425},
  howpublished = {IEEE International Conference on Software Engineering and Service Science (ICSESS)},
  annotation = {中文辅助译名：Web 服务协议形式化验证的知识理论方法},
  abstract = {Traditional formal methods for analyzing security protocols have gained great success to find attacks or prove their absence in the standard Dolev-Yao model. However, they cannot be applied directly to verify Web services protocols because of their inherent different message syntax. In this paper, we apply our justification-oriented and automatic formal approach again to verify directly security properties for a more complex Web services protocol, based on a fault-preserving mapping tool called SuD (SOAP under Dolev-Yao) and the well developed epistemic logic (logic of knowledge) as the underlying specification language. The effectiveness of the approach can be further confirmed by the experimental results.},
}

