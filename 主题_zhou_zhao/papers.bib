@misc{zhou_zhao_972c9d4667731244,
  title = {DiTReducio: A Training-Free Acceleration for DiT-Based TTS via Progressive Calibration},
  author = {Qingyang Hong and Ziyue Jiang and Yanru Huo and Zuoli Tang and Zhou Zhao},
  year = {2026},
  doi = {10.18653/V1/2026.FINDINGS-ACL.1157},
  url = {https://doi.org/10.18653/V1/2026.FINDINGS-ACL.1157},
  howpublished = {ACL (Findings)},
  annotation = {中文辅助译名：DiTReducio：通过渐进式校准实现基于 DiT 的 TTS 免培训加速},
  abstract = {While Diffusion Transformers (DiT) have advanced non-autoregressive (NAR) speech synthesis, their high computational demands remain a limitation.Existing DiT-based text-tospeech (TTS) model acceleration approaches mainly focus on reducing sampling steps through distillation techniques, yet they remain constrained by training costs.We introduce DiTReducio, a training-free acceleration framework that compresses computations in DiT-based TTS models via progressive calibration.We propose two compression methods, Temporal Skipping and Branch Skipping, to eliminate redundant computations during inference.Moreover, based on two characteristic attention patterns identified within DiT layers, we devise a pattern-guided strategy to selectively apply the compression methods.Our method allows flexible modulation between generation quality and computational efficiency through adjustable compression thresholds.Experimental evaluations conducted on F5-TTS and MegaTTS 3 demonstrate that DiTReducio achieves a 75.4% reduction in FLOPs and improves the Real-Time Factor (RTF) by 37.1%, while preserving generation quality.The code is available at https://github.com/ iHateTheWorld555/DiTReducio.},
}

