@misc{zhou_zhao_8dd7c999224152d0,
  title = {GTSinger: A Global Multi-Technique Singing Corpus with Realistic Music Scores for All Singing Tasks},
  author = {Xinyu Cheng and Zhiyuan Zhu and Yuxin Chen and Jingyu Lu and Ruiqi Li and Lichao Zhang and Zhiqing Hong and Chen Yang and Yu Zhang and Ziyue Jiang and Wenxiang Guo and Jiecheng Zhou and Changhao Pan and Jinzheng He and Jialei Wang and Chuxin Wang and Wenhao Xu and Zhou Zhao},
  year = {2024},
