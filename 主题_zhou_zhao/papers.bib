@misc{zhou_zhao_d0205fb37898fe72,
  title = {HERO: HiErarchical spatio-tempoRal reasOning with Contrastive Action Correspondence for End-to-End Video Object Grounding},
  author = {Haoyu Zhang and Shiliang Pu and Mengze Li and Shengyu Zhang and Jiaxu Miao and Wenqiao Zhang and Zhou Zhao and Tianbao Wang and Fei Wu},
  year = {2022},
  doi = {10.1145/3503161.3548333},
  url = {https://doi.org/10.1145/3503161.3548333},
  howpublished = {ACM Multimedia},
  annotation = {中文辅助译名：HERO：分层时空推理与端到端视频对象接地的对比动作对应},
  abstract = {Video Object Grounding (VOG) is the problem of associating spatial object regions in the video to a descriptive natural language query. This is a challenging vision-language task that necessitates constructing the correct cross-modal correspondence and modeling the appropriate spatio-temporal context of the query video and caption, thereby localizing the specific objects accurately. In this paper, we tackle this task by a novel framework called HiErarchical spatio-tempoRal reasOning (HERO) with contrastive action correspondence. We study the VOG task at two aspects that prior works overlooked: (1) Contrastive Action Correspondence-aware Retrieval. Notice that the fine-grained video semantics (e.g., multiple actions) is not totally aligned with the annotated language query (e.g., single action), we first introduce the weakly-supervised contrastive learning that classifies the video as action-consistent and action-independent frames relying on the video-caption action semantic correspondence. Such a design can build the fine-grained cross-modal correspondence for more accurate subsequent VOG. (2) Hierarchical Spatio-temporal Modeling Improvement. While transformer-based VOG models present their potential in sequential modality (i.e., video and caption) modeling, existing evidence also indicates that the transformer suffers from the issue of the insensitive spatio-temporal locality. Motivated by that, we carefully design the hierarchical reasoning layers to decouple fully connec},
}

@misc{zhou_zhao_f5ee9e7e28c0bfa0,
  title = {HiFiDenoise: High-Fidelity Denoising Text to Speech with Adversarial Networks},
  author = {Lichao Zhang and Liqun Deng and Yi Ren and Zhou Zhao},
  year = {2022},
  doi = {10.1109/ICASSP43922.2022.9747155},
  url = {https://doi.org/10.1109/ICASSP43922.2022.9747155},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：HiFiDenoise：使用对抗网络进行高保真去噪文本转语音},
  abstract = {Building a high-fidelity speech synthesis system with noisy speech data is a challenging but valuable task, which could significantly reduce the cost of data collection. Existing methods usually train speech synthesis systems based on the speech denoised with an enhancement model or feed noise information as a condition into the system. These methods certainly have some effect on inhibiting noise, but the quality and the prosody of their synthesized speech are still far away from natural speech. In this paper, we propose HiFiDenoise, a speech synthesis system with adversarial networks that can synthesize high-fidelity speech with low-quality and noisy speech data. Specifically, 1) to tackle the difficulty of noise modeling, we introduce multi-length adversarial training in the noise condition module. 2) To handle the problem of inaccurate pitch extraction caused by noise, we remove the pitch predictor in the acoustic model and also add discriminators on the mel-spectrogram generator. 3) In addition, we also apply HiFiDenoise to singing voice synthesis with a noisy singing dataset. Experiments show that our model outperforms the baseline by 0.36 and 0.44 in terms of MOS on speech and singing respectively.},
}

