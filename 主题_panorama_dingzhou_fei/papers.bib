@misc{panorama_dingzhou_fei_4b224652f564,
  title = {The Paradox of Uncertainty: How Tolerance for Uncertainty Modulates Approach Motivation - Evidence from ERPs Experiments},
  author = {Dingzhou Fei and Yinrui Liu and Wenqing Zhang},
  year = {2025},
  doi = {10.21203/rs.3.rs-4229168/v1},
  url = {https://doi.org/10.21203/rs.3.rs-4229168/v1},
  howpublished = {Communications in Computer and Information Science},
  annotation = {中文辅助译名：不确定性的悖论：对不确定性的容忍度如何调节接近动机 - 来自 ERP 实验的证据},
  abstract = {Abstract Background Certainty has an important meaning for an individual, as it gives a sense of security and fulfillment. However, uncertainty occurs every day in real life, causing anxiety and aversion. Therefore, individuals take measures to cope with uncertain feelings. Previous studies have hinted at the important role of approach motivation in alleviating uncertainty and the possibility that loss of a sense of control may induce approach motivations and behaviors, but there is no clear empirical research demonstrating this mechanism. We explored the role of uncertainty in the induction of approach motivation and the moderating role of uncertainty tolerance. Method In the present study, we measured subjects' uncertainty tolerance trait, in addition to the classical forced-choice gambling task, and measured 20 subjects' brainwave changes in uncertain situations, using the lateralization of approach-motivated brain activity to test the above hypotheses using the FRN and the P300 as the response indexes. Result Subjects who received the feedback "+/-/?" in the gambling task were followed by the production of FRN in the right brain and then P300 in the left brain, and the peaks of the P300 wave in the "+" and "-" feedback cases were significantly lower than those of "?". In addition, the peak difference between the left and right brain P300 waves was significantly higher in individuals with low uncertainty tolerance than in those with low uncertainty tolerance. Conclusion We},
}

@misc{panorama_dingzhou_fei_3daf32e0b195e778,
  title = {Computational thinking in complex problem solving based on data analysis: exploring the role of problem representation using the Tower of Hanoi},
  author = {Jinlong Fei and Shuyuan Dong and Dingzhou Fei},
  year = {2025},
  doi = {10.1186/s13662-025-03866-3},
  url = {https://doi.org/10.1186/s13662-025-03866-3},
  howpublished = {Advances in Continuous and Discrete Models},
  annotation = {中文辅助译名：基于数据分析的复杂问题解决中的计算思维：利用河内塔探索问题表示的作用},
  abstract = {This article investigates the role of problem representation in complex problem-solving based on quasi-experimental data analysis, specifically within the context of computational thinking. Using the Tower of Hanoi task, researchers compared the performance of computer science students (with algorithmic background) and non-computer science students (novices). The data research results revealed that participants with stronger problem representation skills, i.e., computer science students, demonstrated superior problem-solving abilities, particularly as task difficulty increased. Additionally, practice was found to significantly improve problem-solving efficiency for novices, suggesting that enhancing problem representation skills through experience can effectively boost complex problem-solving abilities. The data research highlights the critical role of problem representation in computational thinking and provides valuable insights for programming practices, emphasizing the importance of developing problem representation skills to foster effective problem-solving in complex scenarios.},
}

