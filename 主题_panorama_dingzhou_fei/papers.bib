@misc{panorama_dingzhou_fei_ddf18e4f55db,
  title = {Improve the interpretability by decision tree regression: exampled by an insurance dataset},
  author = {Shuyuan Dong and Dingzhou Fei},
  year = {2021},
  doi = {10.1109/icceai52939.2021.00065},
  url = {https://doi.org/10.1109/icceai52939.2021.00065},
  howpublished = {2021 International Conference on Computer Engineering and Artificial Intelligence (ICCEAI)},
  annotation = {中文辅助译名：通过决策树回归提高可解释性：以保险数据集为例},
  abstract = {Rapidly rising national health care expenditure is a problem for both developed and developing countries. Based on the data of medical insurance of insurance companies, this study explores the influencing factors of medical insurance cost. Furthermore, the influencing factors are used as characteristic variables to establish decision tree regression model and linear regression model, and predict the medical insurance cost. The main conclusions are as follows: (1) The characteristics of “region” and “sex” do not affect the insurance cost.(2) Smoking has the greatest influence on insurance cost. Smoking is a characteristic of body mass index (BMI) and has a driving effect on insurance cost. (3) The regression correlation coefficient of decision tree is about 81%, and the linear regression correlation coefficient is 65%, that is, the prediction result of decision tree is more accurate.},
}

