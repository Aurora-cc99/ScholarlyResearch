@misc{panorama_weihong_deng_9d48050a5efa41b9,
  title = {Improving Retrieval Performance by Global Analysis},
  author = {Jiani Hu and Weihong Deng and Jun Hai Guo},
  year = {2006},
  doi = {10.1109/icpr.2006.703},
  url = {https://doi.org/10.1109/icpr.2006.703},
  howpublished = {Proceedings - International Conference on Pattern Recognition/Proceedings/International Conference on Pattern Recognition},
  annotation = {中文辅助译名：通过全局分析提高检索性能},
  abstract = {In this paper, we propose a global analysis approach for query expansion in information retrieval. This approach, which concentrates on extracting associated expansion terms for a given query so as to improve the retrieval performance, can be divided into three stages. The first stage, called association calculation, is to measure associations between term-term pairs. The second stage focuses on how to select suitable terms for expansion. In the last stage, a reweighting scheme is introduced in order to clarify the impact of each expansion term. Experimental results on the TREC collection demonstrate the effectiveness of our approach.},
}

