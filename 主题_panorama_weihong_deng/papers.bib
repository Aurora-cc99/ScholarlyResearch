  annotation = {中文辅助译名：用于无约束人脸识别的光照恢复姿势标准化},
}

@misc{panorama_weihong_deng_da4e40dfa1d59796,
  title = {Lighting-aware face frontalization for unconstrained face recognition},
  author = {Weihong Deng and Jiani Hu and Zhongjun Wu and Jun Hai Guo},
  year = {2017},
  doi = {10.1016/j.patcog.2017.03.024},
