}

@misc{panorama_weihong_deng_8fb1c5ea1776f447,
  title = {Semi-supervised Learning Based on Label Propagation through Submanifold},
  author = {Jiani Hu and Weihong Deng and Jun Hai Guo},
  year = {2009},
  doi = {10.1007/978-3-642-01507-6_70},
