@misc{dan_zhang_thu_12912b8254018983,
  title = {Civil Society under the Ken of Economics and Organization Theory},
  author = {Dan Zhang},
  year = {2004},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=HBSG200401012},
  howpublished = {Journal of Hubei University of Economics},
  annotation = {中文辅助译名：经济学与组织理论下的公民社会},
  abstract = {This paper focuses on civil society as a new organizational form and economic phenomenon, examines its micro and macro cause through ken of economics and organization theory. In conclusion, as the third hand after government faialure and market faialure, civil society, in which NPO is a core factor, not only cuts down productive and transaction costs, but also realizes excellent location of sources which plays an important role in third field. Studying civil society through ken of economics and organization theory supplies us with a new perspective and important practical refrerence.},
}
