@misc{dan_zhang_thu_ec36347f3e6fcbd2,
  title = {Aligning Gaze, Space, and Cognition: A Multimodal Triangulation Framework for Visitor Interactions in Cultural Heritage (An Expert vs. Non-Expert Comparative Study)},
  author = {Zihe Wei and Yufei Liu and Dan Zhang and Xin Zhang and Miao Sun},
  year = {2026},
  doi = {10.1145/3776591.3832501},
  url = {https://doi.org/10.1145/3776591.3832501},
  howpublished = {Companion Publication of the International Conference on Multimodal Interaction (ICMI Companion)},
  annotation = {中文辅助译名：协调目光、空间和认知：文化遗产中游客互动的多模态三角测量框架（专家与非专家比较研究）},
  abstract = {Cultural heritage, as a combination of physical space and cultural significance, relies heavily on a deep understanding of visitor interaction patterns for its active conservation and public education. However, existing research is largely confined to laboratory or virtual environments, failing to capture the embodied interactions of visitors during real-world exploration. Furthermore, there is a methodological gap in multimodal spatio-temporal alignment and cross-modal synthesis across diverse knowledge backgrounds, limiting a holistic understanding of visitor experience. To address these challenges, the main novelty of the study is presenting a multimodal spatio-temporal alignment framework for analyzing how knowledge backgrounds influence human-environment interaction patterns. First-time visitors (N = 30; 12 visitors with an architectural background, hereafter “experts”, and 18 visitors without a formal architectural background, hereafter “non-experts”) were recruited for a real-world experiment in the Qianlong Garden. We integrated and associated four data modalities: GPS, on-site photography, eye tracking, and interview transcripts. Spatio-temporal patterns of visitor interactions were identified using cluster analysis; interaction scene selections were quantified through key event identification and semantic segmentation modeling; and information processing strategies were examined using LDA topic modeling. Results indicate both consistencies and significant difference},
}

