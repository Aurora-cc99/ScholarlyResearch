  author = {Yukie Nagai and Dan Zhang and Ming Li and Jiarui Li},
  year = {2023},
  doi = {10.1109/ICDL55364.2023.10364533},
  url = {https://doi.org/10.1109/ICDL55364.2023.10364533},
  howpublished = {ICDL},
  annotation = {中文辅助译名：婴儿与护理人员互动中基于韵律的声音情感协调},
  abstract = {Infants actively interact with caregivers to develop social competence by aligning behaviors and mental states. Previous research has demonstrated the early ability to align core affect through distinct naïve nonverbal behaviors. However, the extent to which infants align vocal emotions with caregivers more finely has remained largely unexplored. This study investigated the nuances of vocal emotions during 60 minutes of natural conversations between caregivers and their 9-month-old infants from 25 families. To this end, a pre-trained deep neural network (DNN) based on contrastive learning was applied to extract emotion representations using the prosodic features of infants' and caregivers' vocalizations. The results revealed that infants and caregivers align their vocal emotions in natural interactions. While infants showed less variability in vocal emotions than their caregivers, the variabilities of both parties were positively correlated at the family level, indicating the role of parental vocal emotions in facilitating infant vocal emotions. These findings provide insight into the early interactions of vocal emotions in family conversations and highlight the significance of the quality of caregivers' vocal expressions, i.e., the displayed emotional variability.},
}

@misc{dan_zhang_thu_e268ce5ce136d7c9,
