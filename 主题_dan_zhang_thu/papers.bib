  howpublished = {Frontiers in Neurology},
  annotation = {中文辅助译名：基于 fNIRS 的围产期抑郁症评估的自由联想语义任务},
  abstract = {Perinatal depression (PD) is a highly prevalent psychological disorder that has a detrimental effect on infant and maternal physical and mental health, but effective and objective assessment of PD is still insufficient. In recent years, the functional near-infrared spectroscopy (fNIRS) has been acknowledged as an effective non-invasive tool for clinical assessment of depression. This study proposed a free association semantic task (FAST) paradigm for fNIRS-based assessment of PD. To better address the emotion characteristics of PD, the participants are required to generate a dynamic concept chain based on positive, negative or neutral seed words, while 48-channel fNIRS recordings over frontal and bilateral temporal regions. Results from twenty-two late-pregnant women revealed that, the oxyhemoglobin (oxy-Hb) changes during the FAST with the positive and negative seed words over the frontal region were correlated with PD severity, which was different from the correlation patterns in the FAST with neutral seed word and the classical verbal fluency test (VFT). Furthermore, distinct correlation patterns were also observed in the FAST with the positive and negative seed words, manifested in fNIRS channels corresponding to the right dorsolateral prefrontal cortex (DLPFC) and right inferior frontal gyrus (IFG), respectively. Moreover, regression analyses showed that the FAST with positive and negative seed words can well explain the severity of PD. Our findings suggest the proposed },
}

@misc{xinke_shen_18584d2d2e58,
  title = {Dynamic-Attention-Based EEG State Transition Modeling for Emotion Recognition},
  author = {Xinke Shen and Runmin Gan and Kaixuan Wang and Shuyi Yang and Qingzhu Zhang and Quanying Liu and Dan Zhang and Sen Song},
  year = {2025},
  doi = {10.1109/taffc.2025.3593630},
  url = {https://doi.org/10.1109/taffc.2025.3593630},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：基于动态注意用于情绪识别的脑电图状态转换建模},
  abstract = {Electroencephalogram (EEG)-based emotion decoding can objectively quantify people's emotional state and has broad application prospects in human-computer interaction and early detection of emotional disorders. Recently emerging deep learning architectures have significantly improved the performance of EEG emotion decoding. However, existing methods still fall short of fully capturing the complex spatiotemporal dynamics of neural signals, which are crucial for representing emotion processing. This study proposes a Dynamic-Attention-based EEG State Transition (DAEST) modeling method to characterize EEG spatiotemporal dynamics. The model extracts spatiotemporal components of EEG that represent multiple parallel neural processes and estimates dynamic attention weights on these components to capture transitions in brain states. The model is optimized within a contrastive learning framework for cross-subject emotion recognition. The proposed method achieved state-of-the-art performance on three publicly available datasets: FACED, SEED, and SEED-V. It achieved$81.7\pm 4.3\%$accuracy in the binary classification of positive and negative emotions and$67.9\pm 7.3\%$in nine-class discrete emotion classification on the FACED dataset,$88.1\pm 3.6\%$in the three-class classification of positive, negative, and neutral emotions on the SEED dataset, and$73.6\pm 12.7\%$in five-class discrete emotion classification on the SEED-V dataset. The learned EEG spatiotemporal patterns and dynamic trans},
}

@misc{dan_zhang_thu_37344235df028a4f,
  title = {A Fast System Modeling Method for a Highperformance Self-Collimating SPECT System Combining Deep Learning and Sparse Point-Source Calibration},
  author = {Qing Ye and Dan Zhang and Tianyu Ma},
  year = {2025},
  doi = {10.1109/nss/mic/rtsd57106.2025.11286385},
  url = {https://doi.org/10.1109/nss/mic/rtsd57106.2025.11286385},
  howpublished = {IEEE Nuclear Science Symposium and Medical Imaging Conference (NSS/MIC)},
  annotation = {中文辅助译名：结合深度学习和稀疏点源校准的高性能自准直 SPECT 系统快速系统建模方法},
  abstract = {We have recently developed a self-collimating SPECT (SC-SPECT) system, where multiple sparsescintillator detector layers are used to replace part of the mechanical collimator for photon collimation, enabling simultaneous high-resolution, high-sensitivity SPECT imaging. A critical component for acquiring high-quality image is the generation of an accurate system matrix. However, due to the complex geometry of SC-SPECT, conventional system modeling methods are not directly appliable. In this work, we propose a deep learning framework-DMR2.5D-GAN-to estimate the full system matrix from sparse point-source calibration data (10k positions). The network incorporates dual inputs-sparse projection probability density functions (PPDFs) and Halton-sequence positional encoding-along with multi-scale convolutions and ROI-weighted discrimination. The network is trained and evaluated using datasets generated with Monte Carlo simulations. Results show high structural similarity between the predicted and ground-truth matrices. Moreover, MLEM reconstructions using the generated matrix achieve comparable normalized mean square error (NMSE) to those using the ground-truth matrix. This method demonstrates significantly reduced system calibration time ($>90 \%$) while preserving reconstruction accuracy.},
}

