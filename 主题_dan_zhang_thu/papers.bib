  url = {https://doi.org/10.1109/nssmicrtsd49126.2023.10337852},
  howpublished = {IEEE Nuclear Science Symposium and Medical Imaging Conference (NSS/MIC)},
  annotation = {中文辅助译名：自准直 SPECT 成像的精确衰减校正},
  abstract = {Recently, our group proposed a self-collimating SPECT system with multi-layer interspaced mosaic detectors to achieve high resolution and sensitivity simultaneously. In this study, we investigated the effect of attenuation on image quality and applied an accurate attenuation correction during reconstruction for self-collimating SPECT based on a half-ring and a full-ring system, respectively. The attenuation factor was calculated using a fast ray-tracing algorithm. The attenuation correction was performed during OSEM reconstruction by multiplying the attenuation factor by the system matrix. Noise-free and noisy analytical simulations were performed using an XCAT phantom with 1 slice. GATE simulations were performed using an XCAT phantom with 20 slices. The reconstructed image quality was evaluated quantitatively using the absolute relative bias between the reconstructed images and the phantom image. The simulation results showed that attenuation correction greatly improved the image quality qualitatively and quantitatively. The results also showed that the full-ring system was preferable than the half-ring system to avoid attenuation-caused artifact when statistical noise was introduced. The GATE simulation results of the full-ring system showed that the absolute quantification biases were reduced after attenuation correction from 82.0% to 4.2%, from 87.7% to 7.7%, from 24.4% to 2.2%, from 95.0% to 9.5% for 4 ROIs, respectively. In conclusion, attenuation correction is crucial},
}

@misc{sun_xiao_058736b01177,
  title = {CPED: A Chinese Positive Emotion Database for Emotion Elicitation and Analysis},
  author = {Xiao Sun},
  year = {2023},
  doi = {10.1109/TAFFC.2021.3088523},
  url = {https://doi.org/10.1109/TAFFC.2021.3088523},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：CPED：用于情绪诱导和分析的中国积极情绪数据库},
  abstract = {Positive emotions are of great significance to people's daily life, such as human-computer/robot interaction. However, the structure of extensive positive emotions is not clear yet and effective standardized inducing materials containing as many positive emotional categories as possible are lacking. Thus, this article aims to establish a Chinese positive emotion database (CPED) to (1) effectively elicit positive emotion categories as many as possible, (2) provide both the subjective feelings of different positive emotions and a corresponding peripheral physiological database, and (3) explore the structure and framework of positive emotion categories. 42 video clips of 16 positive emotion categories were screened from 1000+ online clips. Then a total of 312 participants watched and rated these video clips during which GSR and PPG signals were recorded. 34 video clips that met hit rate and intensity standards were systemically clustered into four emotion categories (empathy, fun, creativity and esteem). Eventually, 22 film clips of these four major categories formed the CPED database. A total of 84 features from GSR and PPG signals were extracted and entered into RF, SVM, DBN and LSTM classifiers that serves as baseline classification methods. A classification accuracy of 44.66 percent for four major categories of positive emotions was achieved.},
}

