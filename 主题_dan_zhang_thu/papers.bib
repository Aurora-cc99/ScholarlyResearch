  author = {Joseph C. C. Chen and Gabriella Mace and Avery E. Ostrand and Christian Valtierra and Sydney Griffith and Richard Campusano and Andrew I. Li and Erin Vinson and Jonas TT Schlomberg and Maya Nicole Eshel and John Matthew Suntay and Syed Rahim and Roger Anguera‐Singla and Bijurika Nandi and Isabella Hartley and Daniel A. Brown and Nicole C. Swann and Luca Mazzucato and Xin Hu and Dan Zhang and Christopher Timmermann and Maryam Bijanzadeh and Reza Abbasi-Asl and Robin Lester Carhart-Harris and Theodore P. Zanto and David A. Ziegler and Adam H. Gazzaley and Lorenzo Pasquini},
  year = {2025},
  doi = {10.1101/2025.11.20.689403},
