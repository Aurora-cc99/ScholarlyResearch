  author = {Qian Ru Lin and Horng-Shuh Hao and Deqing Qin and Dan Zhang},
  year = {2022},
  doi = {10.1093/intqhc/mzac035},
  url = {https://doi.org/10.1093/intqhc/mzac035},
  howpublished = {International Journal for Quality in Health Care},
