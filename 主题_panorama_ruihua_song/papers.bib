  abstract = {In this paper, we provide an overview of the NTCIR IMine task, which is a core task of NTCIR-11 and also a succeeding work of},
}

@misc{panorama_ruihua_song_b030bcf1e74cacbb,
  title = {Mining subtopics from text fragments for a web query},
  author = {Qinglei Wang and Yanan Qian and Ruihua Song and Zhicheng Dou and Zhang Fan and Tetsuya Sakai and Qinghua Zheng},
