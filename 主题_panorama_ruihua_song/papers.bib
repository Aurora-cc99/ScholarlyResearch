@misc{panorama_ruihua_song_d69a417772c5a5af,
  title = {DF or IDF? On the Use of HTML Primary Feature Fields for Web IR},
  author = {Min Zhang and Ruihua Song and Shaoping Ma},
  year = {2003},
  url = {https://dblp.uni-trier.de/db/conf/www/www2003p.html#ZhangSM03},
  howpublished = {WWW (Posters)},
  annotation = {中文辅助译名：国防军还是以色列国防军？关于 Web IR 的 HTML 主要特征字段的使用},
  abstract = {This paper describes a new document-frequency-related query term weighting schema in Web information retrieval using HTML structure information. Firstly, the concept of the Primary Feature Space has been proposed, which is composed of the more informative field in HTML documents, such as emphasized bold words. Secondly, a new PF query term weighting schema has been proposed which takes logarithm of DF into accounts instead of general IDF factor. Finally, a combination strategy of term weighting on both Primary Feature Field and general body text is given. The consistent great improvement of performance verifies the reliability and effectiveness of the PF term weighting schema.},
}

@misc{panorama_ruihua_song_98bbcfea6d1d0dbf,
  title = {THU TREC 2002: Novelty Track Experiments},
  author = {Min Zhang and Ruihua Song and Chuan Lin and Shaoping Ma and Zhe Jiang and Yijiang Jin and Yiqun Liu and Le Zhao},
  year = {2002},
  url = {https://trec.nist.gov/pubs/trec11/papers/tsinghuau.novelty2.pdf},
  howpublished = {Text REtrieval Conference},
  annotation = {中文辅助译名：THU TREC 2002：新颖的赛道实验},
  abstract = {This is the first time that Tsinghua University took part in TREC. In this year’s novelty track, our basic idea is to find the key factor that help people find relevant and new information on a set of documents with noise. We paid attention to three points: 1. how to get full information from a short sentence; 2. how to complement hidden well-known knowledge to the sentences; 3. how to make the determination of duplication.},
}

@misc{panorama_ruihua_song_59f0d790a361c6f9,
  title = {THU TREC2002 Web Track Experiments},
  author = {Min Zhang and Ruihua Song and Chuan Lin and Shaoping Ma and Zhe Jiang and Yijiang Jin and Yiqun Liu and Le Zhao},
  year = {2002},
  url = {https://trec.nist.gov/pubs/trec11/papers/tsinghuau.web2.pdf},
