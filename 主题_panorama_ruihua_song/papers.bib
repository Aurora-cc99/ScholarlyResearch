@misc{panorama_ruihua_song_2a5a6191849374ea,
  title = {Immersion in the GitHub Universe: Scaling Coding Agents to Mastery},
  author = {Jiale Zhao and Guoxin Chen and Fanzhe Meng and Minghao Li and Jie Chen and Hui Xu and Yongshuai Sun and Xin Zhao and Ruihua Song and Yuan Zhang and Peng Wang and Cheng Chen and Jirong Wen and Kai Jia},
  year = {2026},
  doi = {10.18653/2026.findings-emnlp.1695},
  url = {https://doi.org/10.18653/2026.findings-emnlp.1695},
  howpublished = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  annotation = {中文辅助译名：沉浸在 GitHub 世界中：将编码代理扩展到精通},
  abstract = {Achieving mastery in real-world software engineering tasks is fundamentally bottlenecked by the scarcity of large-scale, high-quality training data.Scaling such data has been limited by the complexity of environment setup, unittest generation, and problem statement curation.In this paper, we propose Scale-SWE, an automated, sandboxed multi-agent workflow designed to construct high-quality SWE data at scale.The system coordinates three specialized agents-for environment setup, test creation, and problem description synthesis-to process 6 million pull requests across 5.2k repositories, producing Scale-SWE-Data: 100k verified SWE instances, the largest such dataset to date.It substantially surpasses existing real-world datasets in repository diversity and reflects realistic task complexity.We further demonstrate the dataset's utility for training by distilling 71,498 high-quality trajectories and fine-tuning Qwen-30B-A3B-Instruct to produce Scale-SWE-Agent.Our agent achieves a 64% resolve rate on SWE-Bench-Verified-a nearly three-fold improvement over the base model.Scale-SWE provides a scalable, reproducible approach for data construction to advance LLM-based software engineering.},
}

@misc{panorama_ruihua_song_23fed3b1a8683ce4,
  title = {Unified Synthesis of Compositional Speech and Sound from Free-Form Text Prompts},
  author = {Yuyue Wang and Xihua Wang and Xin Cheng and Yijing Chen and Ruihua Song},
  year = {2026},
  doi = {10.48550/arxiv.2605.28063},
  url = {https://arxiv.org/abs/2605.28063},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：根据自由格式文本提示统一合成组合语音和声音},
  abstract = {Generating unified audio that naturally integrates speech and sounds from free-form text prompts remains challenging. For example, the prompt ``A fast drum roll ends with a cymbal crash, after which a man shouts: `Come on!'.'' describes several events that should appear in order and form a coherent recording rather than independent tracks that lack coherent temporal and semantic interactions. Current methods broadly follow two paradigms: pipeline methods couple separate text-to-sound and text-to-speech models, while unified models rely on a single generator that still requires structured, multi-field prompt inputs. Both paradigms require upstream prompt decomposition or rewriting, limiting free-form flexibility and risking cascading errors. To enable direct generation from free-form prompts within a single model, we introduce PlanAudio, an end-to-end framework that maps unconstrained free-form text to unified audio without intermediate prompt preprocessing. To address the challenges of direct free-form generation, PlanAudio integrates latent planning into a single autoregressive framework, predicting continuous audio layout before acoustic token synthesis. We construct a large-scale training corpus and introduce Free-Form Unified Audio Generation Benchmark (FUAG) for evaluation, both spanning speech, sound, and joint speech-and-sound generation. Experiments show that a single PlanAudio outperforms existing pipeline and unified baselines on speech-and-sound generation, while r},
}

