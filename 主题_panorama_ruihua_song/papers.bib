  annotation = {中文辅助译名：THU TREC2002 Web Track 实验},
  abstract = {Anchor text has been proofed efficient in former TREC experiments on homepage finding task [1] and somewhat useful to ad hoc retrieval by result combination [2]. In this year, our conclusion was consistent with formers. Besides, the use of the URL and links inside the webpage were also observed. Again, results on training set are encouraging.},
