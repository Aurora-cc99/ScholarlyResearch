  author = {Yanhe Deng and Zhuhong Shao and Shihao Li and Xiaohui Tan and Rongyin Qin and Tie Liu and Xiaobai Li and Yinan Jiang and Peipeng Liang and Yongzhen Huang},
  year = {2026},
  doi = {10.1109/TAFFC.2025.3611238},
