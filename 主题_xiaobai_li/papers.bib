@misc{xiaobai_li_9114c063b00076b7,
  title = {Editorial: Towards Emotion AI to next generation healthcare and education},
  author = {Yang Merik Liu and Janne Kauttonen and Bowen Zhao and Xiaobai Li and Wei Peng},
