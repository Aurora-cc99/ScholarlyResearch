@misc{panorama_173db248ed1f_a1364de58b24f5ad,
  title = {Weighted Macro-Expression Guided Transitional Cross-Domain Learning for Micro-Expression Recognition},
  author = {Jie Zhu and Yan Zhao and Dong Wei},
  year = {2026},
  doi = {10.1109/LSP.2026.3681205},
  url = {https://doi.org/10.1109/LSP.2026.3681205},
  howpublished = {IEEE Signal Process. Lett.},
  annotation = {中文辅助译名：用于微表情识别的加权宏表达引导过渡跨域学习},
  abstract = {Despite progress in micro-expression recognition (MER), the low intensity of micro-expressions remains a key challenge, hindering effective learning of discriminative features. Given that macro-expressions share emotional components with micro-expressions and offer stronger discriminative cues, we propose a method that leverages macro-expression knowledge to enhance MER. A generative model is designed to synthesize transitional-expression features based on weighted representations, enabling one-to-many guidance from macro-expressions to micro-expressions. To align these transitional features with micro-expression semantics, we apply consistency regularization using micro-expression labels. Finally, feature alignment is conducted to increase inter-class separability and reduce intra-class variation. Experiments demonstrate that our method significantly improves MER performance.},
}

@misc{wenming_zheng_156eac025cea,
  title = {Generalizable Dynamic Domain Adaptation for Speaker-Independent Speech Emotion Recognition},
