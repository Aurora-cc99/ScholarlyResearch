  howpublished = {ACII},
  annotation = {中文辅助译名：基于二类分类器重构的语音情感识别},
  abstract = {A method of using two-class classifiers in emotion recognition was discussed. Emotion classes were divided into pairs for improved feature selection and optimization. Each pair of emotions was classified by a two-class classifier and the final recognition result was reached by a correlation decoder. Compared with n-class classifier, using two-class classifiers for each pair of emotions is more suitable for multiple emotions classification.},
}

@misc{panorama_173db248ed1f_455a6b24f54c77bf,
  title = {Modified quadratic discrimination function for non-normal distribution and its application in speech emotion recognition},
  author = {Yan Zhao and Li Zhao and Cairong Zou and Yinhua Yu and Chengwei Huang and Qingyun Wang},
  year = {2008},
  doi = {10.1109/APCCAS.2008.4745998},
  url = {https://doi.org/10.1109/APCCAS.2008.4745998},
  howpublished = {APCCAS},
  annotation = {中文辅助译名：非正态分布的修正二次判别函数及其在语音情感识别中的应用},
  abstract = {The quadratic discrimination function (QDF) is a common method widely used in pattern recognition. It is optimal when the sampled features are normal with known means and covariance matrices. In this paper, a new transform is proposed and a method named modified QDF (MQDF) is deduced aim to improve the non-normality of the features during the speech emotion recognition, both prosodic and voice quality features are considered in the experiment. The results show that our method is effective and robust.},
}

@misc{panorama_173db248ed1f_43a7075a128fa7fe,
  title = {A local time Fukunage-Koontz transformation for speech emotional recognition},
  author = {Yan Zhao and Haixian Wang and Li Zhao},
  year = {2008},
  doi = {10.1145/1509315.1509431},
  url = {https://doi.org/10.1145/1509315.1509431},
  howpublished = {ICAIT},
  annotation = {中文辅助译名：用于语音情感识别的当地时间 Fukunage-Koontz 变换},
  abstract = {Dimension reduction is widely used in the domains of speech emotional recognition. Considering the underlying time structure of speech signals, we propose a local time Fukunage-koontz transformation (LTFKT) to contain more discriminative information during emotional recognition. The goal of LTFKT is to maximize/ minimize the eigenvalues of covariance in different classes simultaneously. It can be seen that FKT is a special case of LTFKT from analysis. The results show that the method in this paper can improve recognition rate effectively.},
}

@misc{panorama_173db248ed1f_7cc7219b714afc99,
  title = {Nonlinear blind source separation based on radial basis function},
  author = {Ding Liu and Yan Daniel Zhao},
  year = {2004},
  doi = {10.1109/wcica.2004.1341932},
  url = {https://doi.org/10.1109/wcica.2004.1341932},
  howpublished = {World Congress on Intelligent Control and Automation},
  annotation = {中文辅助译名：基于径向基函数的非线性盲源分离},
  abstract = {Radial basis function (RBF) neural network is used as a de-mixing system for nonlinear blind source separation (BSS). The nonlinear mixing mapping is assumed to exist and able to be approximated using RBF network. The object criterion is based on the maximum entropy (ME) approach. To ensure the entropy of the outputs has upper bounded, a special sigmoid function is introduced to the output of the network. The cost function, which maximizes the output entropy of the sigmoid function, is defined to separate the nonlinear mixture. The natural gradient descent method is applied in maximizing entropy. Simulation results are presented to demonstrate the feasibility, robustness and computability of the proposed method.},
}

@misc{panorama_173db248ed1f_ee708671e9f90f36,
  title = {Visualization of Communication Patterns in Collaborative Innovation Networks - Analysis of Some W3C Working Groups},
  author = {Peter A. Gloor and Robert Laubacher and Scott Dynes and Yan Daniel Zhao},
  year = {2003},
  doi = {10.1145/956873.956875},
  url = {https://doi.org/10.1145/956873.956875},
  howpublished = {ACM International Conference on Information and Knowledge Management (CIKM)},
  annotation = {中文辅助译名：协同创新网络中通信模式的可视化——W3C部分工作组分析},
  abstract = {Collaborative Innovation Networks (COINs) are groups of self-motivated individuals from various parts of an organization or from multiple organizations, empowered by the Internet, who work together on a new idea, driven by a common vision. In this paper we report first results of a project that examines innovation networks by analyzing the e-mail archives of some W3C (WWW consortium) working groups. These groups exhibit ideal characteristics for our purpose, as they form truly global networks working together over the Internet to develop next generation technologies. We first describe the software tools we developed to visualize the temporal communication flow, which represent communication patterns as directed acyclic graphs, We then show initial results, which revealed significant variations between the communication patterns and network structures of the different groups., We were also able to identify distinctive communication patterns among group leaders, both those who were officially appointed and other who were assuming unofficial coordinating roles.},
}

