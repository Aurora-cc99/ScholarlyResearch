  abstract = {Speaker attributes (e. g., age, accent, and expression habits) are typically confused with emotional cues in the speech feature space, which can impair the emotional discriminability of speech features that are robust to speakers, thereby degrading the generalization of speech emotion recognition (SER). To overcome this issue, we propose a Generalizable Dynamic Domain Adaptation (GDDA) framework for learning speaker-invariant speech emotion representations. GDDA transforms the speaker-independent SER task into an extension of domain adaptation from a single-source domain to multi-source domains to address the impact of multiple speakers on speech emotion representations. For this purpose, we first construct a GDDA under theSingleSource domain adaptation (i. e., GDDA-SS), which consists of two parts: a joint distribution adaptation (JDA) measuring the speech emotion feature distributions caused by speakers between the training and testing domains, and a dynamic balance factor (DBF) that enables the recognition model to adaptively handle unseen speaker data distributions. Specifically, JDA combines global marginal distribution adaptation (MDA) with local class-aware conditional distribution adaptation (CDA), and DBF uses$\mathcal A$-divergence to automatically quantify the contributions of MDA and CDA in JDA. In DJDA-SS, the training and testing data are considered as a source domain and a target domain, respectively, from a coarse-grained perspective. Considering the multi-d},
}

@misc{panorama_6ea6272c5bf0_a1fd7be56cfd5981,
  title = {An Interpretable Collaborative Acoustic Parameter Modeling Network for Speech Emotion Recognition},
  author = {Hailun Lian and Cheng Lu and H S Yang and Yan Daniel Zhao and Sunan Li and Yuan Zong},
  year = {2026},
  doi = {10.1109/tcss.2026.3692891},
  url = {https://doi.org/10.1109/tcss.2026.3692891},
  howpublished = {IEEE Transactions on Computational Social Systems},
  annotation = {中文辅助译名：用于语音情感识别的可解释的协作声学参数建模网络},
  abstract = {Acoustic parameters can collaboratively represent speech emotions. However, existing speech emotion recognition (SER) methods neglect explicit collaborative modeling among acoustic parameters during representation learning. This not only limits their ability to extract the information contained in acoustic parameters that collaboratively represent emotions, but also makes it difficult to trace back which acoustic parameters are closely associated with emotional states (i.e., lack of interpretability). To address these challenges, we propose the interpretable collaborative acoustic parameter modeling network (ICAPM-Net), which innovatively introduces Graph Convolutional Networks (GCN) to model the relationships among acoustic parameters. Specifically, ICAPM-Net represents different acoustic parameters as nodes, with edges characterizing their collaborative relationships. The GCN utilizes edges to explicitly model the collaborative dependencies between acoustic parameters. Importantly, visualizing the edges in the graph (i.e., adjacency matrix) can trace which acoustic parameters (or their combinations) play dominant roles in emotional expression. The overall architecture of ICAPM-Net consists of three modules: 1) an encoding module, which is used to unify feature dimensions of acoustic parameters; 2) a graph-based collaborative modeling module (GBCM), which is responsible for modeling the collaborative relationships among acoustic parameters; and 3) an emotion adjacency matrix},
}

