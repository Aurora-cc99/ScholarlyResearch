@misc{panorama_173db248ed1f_a0730c834c0ec3dc,
  title = {An Improved Time-domain Decomposition Approach for Chance-Constrained Fast Production Cost Minimization Simulation},
  author = {Zishan Guo and Qinran Hu and Tao Qian and Yongxu Zhu and Yan Daniel Zhao and Yifei Wang},
  year = {2024},
  doi = {10.1109/pree63126.2024.10955844},
  url = {https://doi.org/10.1109/pree63126.2024.10955844},
  howpublished = {International Conference on Power and Renewable Energy Engineering (PREE)},
  annotation = {中文辅助译名：机会约束快速生产成本最小化仿真的改进时域分解方法},
  abstract = {Chance-constrained production cost minimization (PCM) simulation has been employed for long-term power system simulations and assessments considering uncertainties. However, solving such a problem is time-consuming for its numerous binary variables. Traditional time-domain decomposition (TDD) is widely used for acceleration, but plenty of temporal constraint violations make the resulting solution significantly less accurate. To address this drawback, this paper proposes an improved TDD approach based on optimal initial decomposition segment (IDS) to generate sub-problems, thus reducing the temporal constraint violations across sub-problems. Simulation results show that the proposed approach provides the near-optimal solution with less than one violation in 100,000 constraints, and improves the computational efficiency by 3 orders of magnitude.},
}

@misc{panorama_173db248ed1f_618e750bf426abea,
  title = {Dynamic Light and Shadow Rendering Algorithm of VR Scene Based on Global Illumination and Deep Learning},
  author = {Yan Daniel Zhao},
  year = {2024},
  doi = {10.1109/edpee61724.2024.00178},
  url = {http://dx.doi.org/10.1109/edpee61724.2024.00178},
  howpublished = {International Conference on Electrical Drives, Power Electronics & Engineering (EDPEE)},
  annotation = {中文辅助译名：基于全局光照和深度学习的VR场景动态光影渲染算法},
  abstract = {This paper aims to study the dynamic light and shadow rendering technology in VR (Virtual Reality) scene, and proposes an efficient rendering algorithm to improve the user experience and enhance the immersion of VR technology. Specifically, this paper proposes a new dynamic light and shadow rendering algorithm combining global illumination and DL (Deep Learning), which can improve the real-time performance while ensuring the authenticity of rendering. By optimizing the neural network model and designing efficient training strategies, the rendering performance of the algorithm is further improved. At the same time, the effectiveness and superiority of the algorithm are verified by simulation experiments, which provides a new solution for the light and shadow rendering of VR scenes. Experimental results show that, compared with traditional rendering algorithms, the algorithm proposed in this paper significantly improves the rendering speed and frame rate while maintaining high-quality lighting effects. And the users' scores basically reached more than 9 points, and the user feedback further confirmed the effectiveness of the algorithm in improving immersion and user experience. This research not only promotes the development of VR technology, but also provides strong support for realizing high-quality real-time rendering in more complex scenes in the future.},
}

@misc{panorama_173db248ed1f_30b607d1974e3ebe,
  title = {Fixed-Time Stabilizing Control for Nonlinear Systems With Uncontrollable Linearization and Unmodeled Dynamics},
  author = {Xinyu Wang and Jiangbo Yu and Yan Daniel Zhao},
  year = {2024},
  doi = {10.1109/cac63892.2024.10864734},
  url = {https://doi.org/10.1109/cac63892.2024.10864734},
  howpublished = {China Automation Congress (CAC)},
  annotation = {中文辅助译名：具有不可控线性化和未建模动态的非线性系统的固定时间稳定控制},
  abstract = {This paper addresses the problem of fixed-time stabilization for a class of nonlinear systems.Unlike existing results in the literature, the studied system accounts for uncontrollable unstable linearization and unmodeled dynamics, which may represent a broader class of nonlinear systems. Thanks to the changing supply rates for fixed-time input-to-state stability (FxT-ISS) system and the adding-one-power-integrator (AOPI) techniques, we propose a partial-state feedback control scheme that ensures system states converge to zero in fixed time. The settling time under this fixed-time control scheme depends solely on the control design parameters, independent of the initial conditions. Finally, numerical simulations validate the effectiveness of the proposed method.},
}

