@misc{panorama_173db248ed1f_f5224e3a6e092235,
  title = {Speech emotion recognition based on re-composition of two-class classifiers},
  author = {Chengwei Huang and Yun Jin and Yan Zhao and Yinhua Yu and Li Zhao},
  year = {2009},
  doi = {10.1109/ACII.2009.5349420},
