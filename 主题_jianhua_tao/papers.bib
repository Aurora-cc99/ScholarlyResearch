@misc{jianhua_tao_b9070ba7e846,
  title = {Tucker decomposition-based temporal knowledge graph completion},
  author = {Pengpeng Shao and Dawei Zhang and Guohua Yang and Jianhua Tao and Feihu Che and Tong Liu},
  year = {2021},
  doi = {10.1016/j.knosys.2021.107841},
  url = {https://doi.org/10.1016/j.knosys.2021.107841},
  howpublished = {Knowledge-Based Systems},
  annotation = {中文辅助译名：基于塔克分解的时间知识图完成},
  abstract = {Knowledge graphs have been demonstrated to be an effective tool for numerous intelligent applications. However, a large amount of valuable knowledge still exists implicitly in the knowledge graphs. To enrich the existing knowledge graphs, recent years witness that many algorithms for link prediction and knowledge graphs embedding have been designed to infer new facts. But most of these studies focus on the static knowledge graphs and ignore the temporal information that reflects the validity of knowledge. Developing the model for temporal knowledge graphs completion is an increasingly important task. In this paper, we build a new tensor decomposition model for temporal knowledge graphs completion inspired by the Tucker decomposition of order 4 tensor. We demonstrate that the proposed model is fully expressive and report state-of-the-art results for several public benchmarks. Additionally, we present several regularization schemes to improve the strategy and study their impact on the proposed model. Experimental studies on three temporal datasets (i.e. ICEWS2014, ICEWS2005-15, GDELT) justify our design and demonstrate that our model outperforms baselines with an explicit margin on link prediction task.},
}

@misc{licai_sun_898980608308,
  title = {Multimodal Sentiment Analysis based on Recurrent Neural Network and Multimodal Attention},
  author = {Cong Cai and Yu Lin He and Licai Sun and Zheng Lian and Bin Liu and Jianhua Tao and Mingyu Xu and Kexin Wang},
  year = {2021},
  doi = {10.1145/3475957.3484454},
  url = {https://doi.org/10.1145/3475957.3484454},
  howpublished = {MuSe @ ACM Multimedia},
  annotation = {中文辅助译名：基于循环神经网络和多模态注意的多模态情感分析},
  abstract = {Automatic estimation of emotional state has a wide application in human-computer interaction. In this paper, we present our solutions for the MuSe-Stress and MuSe-Physio sub-challenge of Multimodal Sentiment Analysis (MuSe 2021). The goal of these two sub-challenges is to perform continuous emotion predictions from people in stressed dispositions. To this end, we first extract both handcrafted features and deep representations from multiple modalities. Then, we explore the Long Short-Term Memory network and Transformer Encoder with Multimodal Multi-head Attention to model the complex temporal dependencies in the sequence. Finally, we adopt the early fusion, late fusion and model fusion to boost the model's performance by exploiting complementary information from different modalities. Our method achieves CCC of 0.6648, 0.3054 and 0.5781 for valence, arousal and arousal plus EDA (anno12_EDA). The results of valence and anno12_EDA outperform the baseline system with corresponding CCC of 0.5614 and 0.4908, and both rank Top3 in these challenges.},
}

