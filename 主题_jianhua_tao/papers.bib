@misc{jianhua_tao_3fb27e0844aefc09,
  title = {Categorizing terms' subjectivity and polarity manually for opinion mining in Chinese},
  author = {Xiaoying Xu and Aijun Li and Liping Hu and Jianhua Tao},
  year = {2009},
  doi = {10.1109/ACII.2009.5349566},
  url = {https://doi.org/10.1109/ACII.2009.5349566},
  howpublished = {ACII},
  annotation = {中文辅助译名：手动分类术语的主观性和极性以进行中文意见挖掘},
  abstract = {The paper proposes three principles and a clear guideline to create a large-scale Chinese sentiment lexicon for opinion mining systems. The comparative analysis between the criterions used in ready-made resource and the subjectivity and polarity in opinion mining system is also discussed in the paper. With the analysis results, we manually categorize 116533 entries of Hownet terms for the lexicon according to the guideline. Two experiments are conducted to investigate the reliability of manual subjectivity labeling of the terms. The result of the first experiment shows significant high agreement between different annotators, while the second experiment demonstrates the effectiveness of our lexicon in judging the polarity of subjective sentence considering the simple recognition method and verifying our approach's high reliability.},
}

@misc{jianhua_tao_394c47fb4784,
  title = {Advances in Chinese Natural Language Processing and Language resources},
  author = {Jianhua Tao and Fang Zheng and Aijun Li and Ya Li},
  year = {2009},
  doi = {10.1109/icsda.2009.5278384},
  url = {https://doi.org/10.1109/icsda.2009.5278384},
  howpublished = {International Conference on Speech Database and Assessments},
  annotation = {中文辅助译名：中国自然语言处理和语言资源的进展},
  abstract = {In the past few years, there have been a significant number of activities in the area of Chinese natural language processing (CNLP) including the language resource construction and assessment. This paper summarized the major tasks and key technologies in natural language processing (NLP), which encompasses both text processing and speech processing by extension. The Chinese language resources, including linguistic data, speech data, evaluation data and language toolkits which are elaborately constructed for CNLP related fields and some language resource consortiums are also introduced in this paper. Aimed to promote the development of corpus-based technologies, many resource consortiums commit themselves to collect, create and distribute many kinds of resources. The goal of these organizations is to set up a universal and well accepted Chinese resources database so that to push forward the CNLP.},
}

@misc{jianhua_tao_cc26dc61298a29a9,
  title = {The WISTON Text to Speech System for Blizzard 2008},
  author = {Jianhua Tao and Jian Yu and Lixing Huang and Fangzhou Liu and Huibin Jia and Meng Zhang},
  year = {2008},
  doi = {10.21437/BLIZZARD.2008-12},
  url = {https://doi.org/10.21437/BLIZZARD.2008-12},
  howpublished = {Blizzard Challenge},
  annotation = {中文辅助译名：暴雪 2008 的 WISTON 文本转语音系统},
  abstract = {The WISTON system is a large corpus based TTS system with the unit selection method. The text analysis part of this system contains text pre-processing, word segmentation, POS tagging, phonetic transcription and prosody structure prediction. The prosody information (duration, F0, energy) is predicted by the CART model with the input context information. In the unit selection model, we use the mutual prosody constraint as the part of concatenation costs for the path searching while the predicted F0s, durations and energies are used to get the target costs. The spectrum smoothing method is also used for the speech generation. The final system was used to attend Blizzard evaluation for both English test and Mandarin test. Good scores were got based on this system.},
}

@misc{jianhua_tao_ba3b87997d0e4930,
  title = {Prosody Modification on Mixed-Language Speech Synthesis},
  author = {Yi Zhang and Jianhua Tao},
  year = {2008},
  doi = {10.1109/CHINSL.2008.ECP.75},
  url = {https://doi.org/10.1109/CHINSL.2008.ECP.75},
  howpublished = {ISCSLP},
  annotation = {中文辅助译名：混合语言语音合成的韵律修改},
  abstract = {This paper proposes a method to generate natural prosody parameters in Chinese and English mixed-language speech synthesis system which is based on separate Chinese, English, and a small bilingual corpus. Prosodic assimilation of English words to Chinese contexts can be found by observing the bilingual corpus. The most obvious assimilation characteristics are the wider pitch range and the longer duration. A prosody modification model based on this observation is proposed to modify mono-lingual prosody parameters to adapt for mixed-lingual environment. Experiments have proved that more natural mixed-lingual prosody can be generated with our model.},
}

@misc{jianhua_tao_fe5abc8e7b38,
  title = {Text-independent voice conversion based on state mapped codebook},
  author = {Meng Zhang and Jianhua Tao and Jilei Tian and Xia Wang},
  year = {2008},
  doi = {10.1109/icassp.2008.4518682},
  url = {https://doi.org/10.1109/icassp.2008.4518682},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：基于状态映射码本的文本独立语音转换},
  abstract = {Voice conversion has become more and more important in speech technology, but most of current works have to use parallel utterances of both source and target speaker as the training corpus, which limits the application of the technology. In the paper, we propose a new method of text- independent voice conversion which uses non-parallel corpus for the training. The hidden Markov model (HMM) is used to represent the phonetic structure of training speech and to generate the training pairs of source and target speakers by mapping the HMM states between source and target speeches. Then, HMM state mapped codebooks are generated to create the mapping function for the text- independent voice conversion. The subjective experiments based on ABX tests and MOS tests show that the method proposed in the paper gets the similar conversion performance and better speech quality compared to the conventional voice conversion systems.},
}

