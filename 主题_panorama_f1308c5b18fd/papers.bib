@misc{panorama_f1308c5b18fd_bff6bba9615f667e,
  title = {Working memory test battery for young adults: Computerized working memory assessment},
  author = {Liang Ma and Lei Chang and Xiaoying Chen and Renlai Zhou},
  year = {2017},
  doi = {10.1371/journal.pone.0175047},
  url = {https://doi.org/10.1371/journal.pone.0175047},
  howpublished = {PLoS ONE},
  annotation = {中文辅助译名：年轻人工作记忆测试电池：计算机化工作记忆评估},
  abstract = {This study developed a battery of computerized working memory (WM) tests and a scoring system suitable for young adult users. The tests comprised five classic tasks derived from Baddeley's model of WM, reflecting each of the five WM functions. We recruited 115 undergraduate and graduate students from various academic fields and constructed a preliminary WM scoring norm for young adults. The scoring norm was used as a basis for developing a computerized assessment system. The results of correlation analysis show that the fluid intelligence of young adults is related to the memory function of WM, but not to the central executive system. The proposed working memory test battery for young adults comprehensively reflects the WM capacity of adults.},
}

@misc{panorama_f1308c5b18fd_e5d61f0393cd9aec,
  title = {The Role of Cognitive Control in Older Adult Cognitive Reappraisal: Detached and Positive Reappraisal},
  author = {Ying Liang and Meng L Huo and Robert F. Kennison and Renlai Zhou},
  year = {2017},
  doi = {10.3389/fnbeh.2017.00027},
  url = {https://doi.org/10.3389/fnbeh.2017.00027},
  howpublished = {Frontiers in Behavioral Neuroscience},
  annotation = {中文辅助译名：认知控制在老年人认知重评价中的作用：超然和积极的重评价},
  abstract = {Older adults are more likely to regulate their emotions by engaging in cognitive reappraisal. However, depending on the type of cognitive reappraisal used, efforts to regulate emotions are sometimes met with success and other times with failure. It has been suggested the well-known age-related decline in cognitive control might be the culprit behind the poor use of detached reappraisal by older adults. However, this possibility has not been thoroughly investigated. In addition, studies have not examined what aspects of cognitive control- shifting, updating or inhibition-might be relevant to cognitive reappraisal. In the present study, 41 older participants were tested on cognitive control and abilities to use detached and positive reappraisal. Results showed detached reappraisal compared to positive relied more heavily on cognitive control, specifically mental set shifting. Results of this study have important implications for development of cognitive training interventions for older adults.},
}

