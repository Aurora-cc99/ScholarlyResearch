  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=ZLCY201004004},
  howpublished = {Zhongguo linchuang xinlixue zazhi},
  annotation = {中文辅助译名：嚼口香糖对情绪和认知任务的影响},
  abstract = {Objective:This research tested the hypothesis that chewing gum may relieve stress and enhance working efficiency at different difficulty levels.Methods:48 undergraduates were recruited in a randomized crossover design.Participants were instructed to perform on the multi-tasking framework at low and moderate intensities(on separate days) both while chewing and not chewing,with saliva samples collected meanwhile.Results:In baseline condition,performing the platform resulted in significantly self-reported increased stress and state anxiety.In addition in low level of stress the cortisol levels were significantly lower in chewing condition.Conclusion:DISS task is effective in eliciting anxiety states.Chewing gum can significantly decrease the salivary cortisol during the task process.Chinese people show the same performance observed in western researches only in the lower stress condition.},
}

