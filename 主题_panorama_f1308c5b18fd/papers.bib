@misc{panorama_f1308c5b18fd_711be94a26b75fa0,
  title = {A New Standardized Emotional Film Database for Asian Culture},
  author = {Yaling Deng and Meng Yang and Renlai Zhou},
  year = {2017},
  doi = {10.3389/fpsyg.2017.01941},
  url = {https://doi.org/10.3389/fpsyg.2017.01941},
  howpublished = {Frontiers in Psychology},
  annotation = {中文辅助译名：亚洲文化新标准化情感电影数据库},
  abstract = {Researchers interested in emotions have endeavored to elicit emotional responses in the laboratory and have determined that films were one of the most effective ways to elicit emotions. The present study presented the development of a new standardized emotional film database for Asian culture. There were eight kinds of emotion: fear, disgust, anger, sadness, neutrality, surprise, amusement, and pleasure. Each kind included eight film clips, and a total of 64 emotional films were viewed by 110 participants. We analyzed both the subjective experience (valence, arousal, motivation, and dominance) and physiological response (heart rate and respiration rate) to the presentation of each film. The results of the subjective ratings indicated that our set of 64 films successfully elicited the target emotions. Heart rate declined while watching high-arousal films compared to neutral ones. Films that expressed amusement elicited the lowest respiration rate, whereas fear elicited the highest. The amount and category of emotional films in this database were considerable. This database may help researchers choose applicable emotional films for study according to their own purposes and help in studies of cultural differences in emotion.},
}

@misc{panorama_f1308c5b18fd_554e92cfa32e4fc9,
