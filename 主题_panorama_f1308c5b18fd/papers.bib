@misc{panorama_f1308c5b18fd_83aae6adcd87843e,
  title = {Eye Movements from Those with Test Anxiety During Multiple-Choice Tests},
  author = {Renlai Zhou},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=ZDTJ201210016},
  howpublished = {Zhongguo teshu jiaoyu},
  annotation = {中文辅助译名：多项选择测试期间考试焦虑者的眼球运动},
  abstract = {The present study aims at exploring the effect of test anxiety on eye movements during a test,by using the Test Anxiety Scale(TAS) to survey 29 undergraduates from Beijing Normal University and the Beijing University of Posts and Telecommunications,who were categorized into a high test anxiety group(HTAG) and a low test anxiety group(LTAG).The Beck Depression Inventory(BDI) and Raven's Standard Progressive Matrices(RSPM) were employed respectively to acquire their level of depression and intelligence before the start of the formal experiment,during which parameters such as Fixation Durations(FD) and Fixation Counts(FC) of the participants were collected by the eye tracker.The results showed the following:(1) the HTAG displayed significantly longer average fixation duration(AFD) and total fixation duration(TFD) of the titles and alternatives than the LTAG,while the blank parts demonstrated no difference;(2) the HTAG showed significantly longer TFD of the chosen alternatives and the proportion of it to the TFD of all the alternatives than the LTAG,but the HTAG showed a lower proportion of the TFD of the blank parts to the TFD of the other two parts than the LTAG;(3) the two groups showed a significant difference in the FC of the titles,but no significant difference in the FC of the blank parts or the alternatives.},
}

@misc{panorama_f1308c5b18fd_b436a7c4112259da,
  title = {The Working Memory Updating of High and Low Test-Anxious Students:the Effect of the Task Load and Stimuli},
  author = {Renlai Zhou},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=ZDTJ201207014},
  howpublished = {Zhongguo teshu jiaoyu},
  annotation = {中文辅助译名：高、低考试焦虑学生的工作记忆更新:任务负荷和刺激的影响},
  abstract = {The present study,by using test-related and neutral pictures as stimuli in the n-back paradigm,aims to explore the working memory updating of high and low test-anxious students under high and low task loads.The results show the following:(1) in the high-and low-load task,the high test-anxious students' time of reaction to test-related pictures is significantly longer than the low test-anxious students';(2) in the high-load task,the high test-anxious students show a significantly lower rate of correct reaction to test-related pictures than the low test-anxious students,but they show no difference in the low-load task;the two groups show no difference in the time of reaction to neutral pictures and the rate of correct reaction.The authors believe that under the high-load task,the high test-anxious students,compared with the low test-anxious students,show significant defects in the working memory updating of test-related pictures.},
}

@misc{panorama_f1308c5b18fd_6026fef6684b416f,
  title = {A META-ANALYSIS OF BIOFEEDBACK THERAPY FOR DEPRESSION},
  author = {Renlai Zhou},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=BSDZ201201020},
  howpublished = {Journal of Beijing Normal University},
  annotation = {中文辅助译名：抑郁症生物反馈疗法的荟萃分析},
  abstract = {Meta-analysis method was adopted to analyze biofeedback depression therapy reported in 11 recently published papers,to further investigate biofeedback effect on the recovery of depression.Data indicated that the effect ranged from 0.18 to 11.09,the overall effect was 1.28,95% confidence interval ranged from 1.44 to 0.15.Biofeedback therapy was found to play an important role in treating depression,which was the effective therapy for recovery from depression.},
}

