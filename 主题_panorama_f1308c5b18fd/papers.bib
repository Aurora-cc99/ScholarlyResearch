@misc{panorama_f1308c5b18fd_0ab4e8b0916b2c88,
  title = {焦虑个体抑制控制缺陷的研究现状和争议：基于注意控制理论视角},
  author = {Hua Wei and Renlai Zhou},
  year = {2019},
  doi = {10.3724/sp.j.1042.2019.01853},
