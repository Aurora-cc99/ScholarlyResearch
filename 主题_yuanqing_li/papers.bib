@misc{yuanqing_li_c4148e6abbdc,
  title = {Reproducibility and discriminability of brain patterns of semantic categories enhanced by congruent audiovisual stimuli},
  author = {Yuanqing Li and Guangyi Wang and Jinyi Long and Zhuliang Yu and Biao Huang and Xiaojian Li and Tianyou Yu and Changhong Liang and Zheng Li and Pei Sun},
  year = {2011},
  doi = {10.1371/journal.pone.0020801},
