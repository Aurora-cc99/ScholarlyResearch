@misc{yuanqing_li_e3c8d495ce7a1e6b,
  title = {A brain-computer interface controlled mail client},
  author = {Tianyou Yu and Yuanqing Li and Jinyi Long and Cong Wang},
  year = {2013},
  doi = {10.1109/EMBC.2013.6609963},
