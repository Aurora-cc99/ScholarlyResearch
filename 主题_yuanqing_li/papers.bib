@misc{yuanqing_li_5f23d99c254b1a9e,
  title = {Enhanced Transformer-Based UAV-to-UAV Tracking Using Distractor Elimination and Trajectory Prediction},
  author = {Wuwei Wang and Ruiye Gao and Chi Du and Yuanqing Li},
  year = {2024},
  doi = {10.1109/icsp62129.2024.10846255},
  url = {https://doi.org/10.1109/icsp62129.2024.10846255},
  howpublished = {International Conference on Signal Processing},
  annotation = {中文辅助译名：使用干扰消除和轨迹预测增强基于Transformer的无人机到无人机跟踪},
  abstract = {With the advancement of UAV technology, utilizing UAVs for surveillance, capture, or destruction of other UAVs has become a significant focus in the counter-UAV domain. A core challenge within this domain is the visual target tracking of a UAV by the other UAV. However, due to the highly dynamic relative motion between the source UAV and the target UAV, along with the small scale of the UAV in images and background distractors, existing tracking algorithms, including the most popular Transformer-based trackers, often struggle to continuously and robustly track the target. To address these issues, this paper proposes an enhanced Transformer-based UAV-to-UAV tracking method using distractor elimination and trajectory prediction. Specifically, a target-surrounding matching mechanism is introduced to help the tracker eliminate distractors. Additionally, to tackle the high dynamic tracking problem of the camera and target, a Transformer-based trajectory prediction module is proposed to accurately predict the target’s location even when the tracker loses the target. Experimental results demonstrate that the proposed method achieves superior performance in UAVto-UAV target tracking scenarios compared to state-of-the-art algorithms},
}

@misc{yuanqing_li_4a08d986fd4c82dd,
  title = {Assessing breast disease with deep learning model using bimodal bi-view ultrasound images and clinical information},
  author = {Fengping Liang and Yihua Song and Xiaoping Huang and Tong Ren and Qiao Ji and Yanan Guo and Xiang Li and Yajuan Sui and Xiaohui Xie and Lanqing Han and Yuanqing Li and Yong Ren and Zuofeng Xu},
  year = {2024},
  doi = {10.1016/j.isci.2024.110279},
  url = {https://doi.org/10.1016/j.isci.2024.110279},
  howpublished = {iScience},
  annotation = {中文辅助译名：使用双模双向超声图像和临床信息通过深度学习模型评估乳腺疾病},
  abstract = {Breast cancer is the second leading cause of carcinoma-linked death in women. We developed a multi-modal deep-learning model (BreNet) to differentiate breast cancer from benign lesions. BreNet was constructed and trained on 10,108 images from one center and tested on 3,762 images from two centers in three steps. The diagnostic ability of BreNet was first compared with that of six radiologists; a BreNet-aided scheme was constructed to improve the diagnostic ability of the radiologists; and the diagnosis of real-world radiologists' scheme was then compared with the BreNet-aided scheme. The diagnostic performance of BreNet was superior to that of the radiologists (area under the curve [AUC]: 0.996 vs. 0.841). BreNet-aided scheme increased the pooled AUC of the radiologists from 0.841 to 0.934 for reviewing images, and from 0.892 to 0.934 in the real-world test. The use of BreNet significantly enhances the diagnostic ability of radiologists in the detection of breast cancer.},
}

