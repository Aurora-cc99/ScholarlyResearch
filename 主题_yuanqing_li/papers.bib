  howpublished = {ICACI},
  annotation = {中文辅助译名：基于正念脑机接口的晕动病缓解},
  abstract = {Motion sickness is a common affliction that affects nearly half of the global population and poses challenges to comfortable travel experiences, necessitating diverse intervention strategies. Pharmacological interventions have shown promise but present limitations due to side effects. To date, there is no non- pharmacological alleviation method for motion sickness that has been proven effective in a large population. In this study, we developed a novel mindfulness brain-computer interface (mindfulness BCI) for alleviation of motion sickness. Thirty-one subjects who were susceptible to motion sickness participated in our experiments in a real-world car motion environment. The experimental results demonstrated that the proposed mindfulness BCI can effectively alleviate motion sickness symptoms, where more than 90% of subjects reported the effectiveness of the mindfulness BCI system and a significant reduction of Motion Sickness Susceptibility Questionnaire (MISC) scores was obtained when comparing the BCI-based meditation state with the resting state for the subjects (t30=4.968, P<0.001). To the best of our knowledge, our mindfulness BCI is the first effective non- pharmacological alleviation method for motion sickness as demonstrated by a strict test.},
}

@misc{yuanqing_li_91b03afe2bb31346,
  title = {Stress Concentration Zone Detection of Aircraft Structures Based on LW-YOLOv8},
  author = {Wang Yezi and Lyu Shuaishuai and Yang Yu and Jiaxin Li and Wuwei Wang and Yuanqing Li},
  year = {2024},
  doi = {10.1109/icmee63700.2024.11025279},
  url = {https://doi.org/10.1109/icmee63700.2024.11025279},
  howpublished = {International Conference on Mechanical and Electronics Engineering},
  annotation = {中文辅助译名：基于LW-YOLOv8的飞机结构应力集中区检测},
  abstract = {Accurately pinpointing stress concentration zones during aircraft structure fatigue tests contributes significantly to enhancing the efficiency of fatigue crack detection, which represents a pivotal step towards realizing automated vision-based damage monitoring. To achieve high-precision detection of stress concentration zones in aircraft structures on resource-constrained embedded devices, a stress concentration zone detection method based on LW-YOLOv8 is proposed. Firstly, the feature fusion stage of YOLOv8 is optimized based on the C2f_RepViTBlocks, aiming to enhance the detection precision of stress concentration zones while reducing the model parameters and computational complexity. Secondly, EIoU loss is adopted to replace the original loss function, further improving the localization accuracy for stress concentration zones. Ablation studies demonstrate that the proposed model, under the combined effect of two modules, achieves a 1.9% improvement in $\mathrmmAP_0.5: 0.95$ compared to the baseline, while reducing the parameters and Giga Floating-Point Operations Per Second(GFLOPs) by 1,195,712 and 2.2 respectively. Experimental results illustrate that the presented LW-YOLOv8 possesses robust stress concentration zone detection capabilities under conditions of blurred imaging and complex background interference. Furthermore, its lightweight structural design facilitates easier deployment on embedded devices in subsequent stages.},
}

