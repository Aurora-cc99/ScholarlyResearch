@misc{guoxing_wang_212bedd506e6ab46,
  title = {A Fully Integrated High-Sensitivity Wide Dynamic Range PPG Sensor With an Integrated Photodiode and an Automatic Dimming Control LED Driver},
  author = {Mohamed Atef and Min Wang and Guoxing Wang},
  year = {2017},
  doi = {10.1109/jsen.2017.2777740},
  url = {https://doi.org/10.1109/jsen.2017.2777740},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：具有集成光电二极管和自动调光控制 LED 驱动器的全集成高灵敏度宽动态范围 PPG 传感器},
  abstract = {This paper presents the design and implementation for a photoplethysmographic (PPG) sensor with an integrated photodiode and an automatic dimming control LED driver. The PPG front end is designed with a programmable low-pass cutoff frequency from 5 Hz up to 35 Hz, a high-pass cutoff frequency of 0.1 Hz, a total input referred noise current of 79 pA, and a maximum transimpedance gain of 144 dBQ. The sensor fabricated in 0.35-μm CMOS technology and consumes 1.4 mA from 2.7 V-4 V single power supply. The integrated LED driver uses a duty cycle control at a pulse repetition frequency of 200 Hz and 1% duty cycle. The LED driver can supply four LEDs each with 10 mA. An automatic dimming control is implemented to reduce the LEDs current at strong PPG signal strength, to reduce the LEDs power consumption.},
}

@misc{guoxing_wang_b85795c0d5dd6783,
  title = {Live demonstration: A ring-type blood pressure monitoring system based on photoplesthygraphy},
  author = {Min Wang and Mohamed Atef and Qingsong Xie and Yong Lian and Guoxing Wang},
  year = {2017},
  doi = {10.1109/biocas.2017.8325091},
  url = {https://doi.org/10.1109/biocas.2017.8325091},
  howpublished = {IEEE Biomedical Circuits and Systems Conference (BioCAS)},
  annotation = {中文辅助译名：现场演示：基于光电体积描记法的环式血压监测系统},
  abstract = {A ring-type blood pressure (BP) monitoring system based on photoplethysmograph (PPG) will be presented. In the system, the PPG signal on the finger is acquired in real time through a highly sensitive low-power readout module and transmitted to smartphone via Bluetooth Low Energy (BLE) module. An app on the smart phone will process the signal and predict the blood pressure value. The morphological method and adaptive filter is implemented in the app to improve the signal quality. By using the extracted features from PPG signal, the BP can be predicted based on the sparse Least Square Support Vector Machine (LSSVM) model. The users can observe the real-time BP and HR on the mobile phone. The measured mean absolute error (MAE) from an experiment involving 20 subjects is 7.1 mmHg for systolic blood pressure (SBP) and 6.5 mmHg for diastolic blood pressure (DBP).},
}

@misc{guoxing_wang_c3f1adbf22196ec4,
  title = {A low-power high-sensitivity analog front-end for PPG sensor},
  author = {Guoxing Wang and Binghui Lin and Mohamed Atef},
  year = {2017},
  doi = {10.1109/EMBC.2017.8036960},
  url = {https://doi.org/10.1109/EMBC.2017.8036960},
  howpublished = {EMBC},
  annotation = {中文辅助译名：用于 PPG 传感器的低功耗高灵敏度模拟前端},
  abstract = {This paper presents a low-power analog front-end (AFE) photoplethysmography (PPG) sensor fabricated in 0.35 μm CMOS process. The AFE amplifies the weak photocurrent from the photodiode (PD) and converts it to a strong voltage at the output. In order to decrease the power consumption, the circuits are designed in subthreshold region; so the total biasing current of the AFE is 10 μ A. Since the large input DC photocurrent is a big issue for the PPG sensing circuit, we apply a DC photocurrent rejection technique by adding a DC current-cancellation loop to reject the large DC photocurrent up to 10 μA. In addition, a pseudo resistor is used to reduce the high-pass corner frequency below 0.5 Hz and Gm-C filter is adapted to reject the out-of-band noise higher than 16 Hz. For the whole sensor, the amplifier chain can achieve a total gain of 140 dBμ and an input integrated noise current of 68.87 pArmsup to 16 Hz.},
}

@misc{guoxing_wang_c7fccefc7f21a02c,
  title = {Ultrathin flexible coils for wireless power and data link in biomedical sensors},
  author = {Yong Lian and Guoxing Wang and Wei Xu and Tianyuan Cheng and Zeyu Yang and Chundong Wu and Nanshu Lu},
  year = {2017},
  doi = {10.1109/ASICON.2017.8252548},
  url = {https://doi.org/10.1109/ASICON.2017.8252548},
  howpublished = {ASICON},
  annotation = {中文辅助译名：用于生物医学传感器中无线电源和数据链路的超薄柔性线圈},
  abstract = {This paper presents a study on thin flexible coils for wireless power and data link in biomedical sensors. The coils used in this study are built with 9-μm-thick aluminum (Al) and 12-μm-thick blue-colored polythylene terephthalate (PET), which is called Al-on-PET bilayer flexible coils. A wireless power system is designed to test the coils under different operation conditions, in which the coils are attached to different parts of human body. The measurement results show that the coils maintain a relative good quality factor in a frequency range from 5.62 MHz to 6.5 MHz. The open-loop transmit efficiency of the wireless power system attains 80.63% when the ultrathin coil is attached to arm.},
}

@misc{guoxing_wang_ace0a0d2f8dc0cb9,
  title = {A fully differential high efficient ASK demodulator for biomedical implantable application},
  author = {Guoxing Wang and Jie Zhou and Tianzhun Wu and Xi Chen},
  year = {2017},
  doi = {10.1109/ASICON.2017.8252524},
  url = {https://doi.org/10.1109/ASICON.2017.8252524},
  howpublished = {ASICON},
  annotation = {中文辅助译名：用于生物医学植入应用的全差分高效 ASK 解调器},
  abstract = {This paper proposed a ASK demodulator with fully differential transconductance input stage and full-wave active rectifier for data rate improvement. Implemented in X-FAB 0.35 μm CMOS process, this design achieved demodulation performance of 4Mbps data rate with 13.56MHz carrier frequency and minimum input amplitude of 50mV. It can demodulate an input signal with 4% modulation index. Finally, 18pJ/bit energy efficiency has been achieved.},
}

