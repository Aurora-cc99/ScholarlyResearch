@misc{guoxing_wang_8f2fd9b0c74e4b05,
  title = {Towards a Continuous Non-Invasive Cuffless Blood Pressure Monitoring System Using PPG: Systems and Circuits Review},
  author = {Guoxing Wang and Mohamed Atef and Yong Lian},
  year = {2018},
  doi = {10.1109/mcas.2018.2849261},
  url = {https://doi.org/10.1109/mcas.2018.2849261},
  howpublished = {IEEE Circuits and Systems Magazine},
  annotation = {中文辅助译名：使用 PPG 实现连续无创无套血压监测系统：系统和电路回顾},
  abstract = {This paper presents an overview of the cuffless, continuous time, non-invasive blood pressure measuring devices (cNIBP) based on photoplethysmography (PPG). The cNIBP fundamental challenges, such as motion artifacts (MAs), noise, low PPG signal amplitude with large DC components, and possible solutions are discussed. Techniques and circuits for MAs reduction, DC photocurrent cancellation, and sensitivity improvements are presented. To enhance the BP system performance, both the optimization of the integrated PPG receiver design and the reduction of the LED driver power consumption are introduced. Useful design considerations are proposed for designers to improve the PPG-based BP system accuracy.},
}

@misc{guoxing_wang_0cb07f097f4d62cd,
  title = {Optimization of a Dual-Band Wireless Power and Data Telemetry System Using Genetic Algorithm},
  author = {Xiyan Li and Guoxing Wang and Wei Xu and Miaorong Wang and Hang Yuan},
  year = {2018},
  doi = {10.1109/MDAT.2016.2582828},
  url = {https://doi.org/10.1109/MDAT.2016.2582828},
  howpublished = {IEEE Des. Test},
  annotation = {中文辅助译名：使用遗传算法优化双频段无线电力和数据遥测系统},
  abstract = {Inductively coupled coils are commonly used in implanted biomedical electronic devices for wireless power and data transmission. The design challenges include high power transmission efficiency, high data rate, and overall low power operation. This article uses genetic algorithm for the optimization which has the advantages of global optimization, capability of handling multiple targets, and providing multiple solutions.},
}

@misc{guoxing_wang_eeece9f3b037c8b3,
  title = {A 1-to-1-kHz, 4.2-to-544-nW, Multi-Level Comparator Based Level-Crossing ADC for IoT Applications},
  author = {Yuting Hou and Guoxing Wang and Mohamed Atef and Yong Lian and Khalil Yousef},
  year = {2018},
  doi = {10.1109/TCSII.2018.2854862},
  url = {https://doi.org/10.1109/TCSII.2018.2854862},
  howpublished = {IEEE Trans. Circuits Syst. II Express Briefs},
  annotation = {中文辅助译名：适用于物联网应用的基于 1 至 1kHz、4.2 至 544nW、多电平比较器的电平交叉 ADC},
  abstract = {This brief presents the design of an ultra-low power level-crossing analog-to-digital converter (LC-ADC) for IoT and biomedical applications. The proposed LC-ADC utilizes only one multi-level comparator instead of multiple comparators as in conventional LC-ADC, leading to simplified implementation and significant reduction in power. Implemented in 0.18- $\mu\textm$ CMOS process, the LC-ADC achieves 7.9 equivalent number of bits with a 49 dB signal-to-noise and distortion ratio at the input frequency up to 1 kHz. The measured minimum power is only 4.2 nW at the supply voltage of 0.55 V.},
}

@misc{guoxing_wang_82a0711d23d7898e,
  title = {A High Accuracy and High Sensitivity System Architecture for Electrical Impedance Tomography System},
  author = {Hui Li and Boxiao Liu and Yongfu Li and Guoxing Wang and Yong Lian},
  year = {2018},
  doi = {10.1109/apccas.2018.8605564},
  url = {https://doi.org/10.1109/apccas.2018.8605564},
  howpublished = {IEEE Asia Pacific Conference on Circuits and Systems (APCCAS)},
  annotation = {中文辅助译名：一种高精度、高灵敏度电阻抗断层扫描系统架构},
  abstract = {A high accuracy and high sensitivity system architecture is proposed for the read-out circuit of electrical impedance tomography system-on-chip. The switched ratio-metric technique is applied in the proposed architecture. The proposed system architecture minimizes the device noise by processing signals from both read-out electrodes and the stimulus. The quantized signals are post-processed in the digital processing unit for proper signal demodulation and impedance ratio calculation. Our proposed architecture improves the sensitivity of the read-out circuit, cancels out the gain fluctuations in the system, and overcomes the effects of motion artifacts on measurements.},
}

@misc{guoxing_wang_feff72264dfc6892,
  title = {A 100μW AC-DC Boost Converter for Electromagnetic Energy Harvesting With 0.2 VPeak Self-starting Voltage and 85% Efficiency},
  author = {Kangqi Liu and Mingyi Chen and Yiyu Gong and Songhai Fan and Guoxing Wang},
  year = {2018},
  doi = {10.1109/apccas.2018.8605576},
  url = {https://doi.org/10.1109/apccas.2018.8605576},
  howpublished = {IEEE Asia Pacific Conference on Circuits and Systems (APCCAS)},
  annotation = {中文辅助译名：用于电磁能量收集的 100μW AC-DC 升压转换器，具有 0.2 VPeak 自启动电压和 85% 效率},
  abstract = {This work presents an AC-DC boost converter for electromagnetic (EM) energy harvesting consisting of a self-start-up rectifier and a hysteretic DC-DC boost converter. Active diodes controlled by two novel unbalance-sized comparators are adopted, thus improving the power conversion efficiency (PCE) of the rectifier. To further improve the efficiency and lower the start-up voltage, a clock-less asynchronized hysteretic DC-DC boost converter has been used, thus avoiding the power losses related to the driving clock as well as eliminating the requirements of high driving voltage. Simulation based on 0.18-μm CMOS process shows that with a 0.37 Vpeakinput voltage, the converter is capable of harvesting > 100μW power with more than 1 V output voltage and over 85% efficiency.},
}

@misc{guoxing_wang_6b50c64a85dc6391,
  title = {A Self-Powered 3.26-µW 70-m Wireless Temperature Sensor Node for Power Grid Monitoring},
  author = {Guanghui He and Guoxing Wang and Hengwei Yu and Mingyi Chen and Min Wang and Yongxin Zhu and Yadong Liu},
  year = {2018},
  doi = {10.1109/TIE.2018.2811360},
  url = {https://doi.org/10.1109/TIE.2018.2811360},
  howpublished = {IEEE Trans. Ind. Electron.},
  annotation = {中文辅助译名：用于电网监控的自供电 3.26μW 70-m 无线温度传感器节点},
  abstract = {This paper presents a self-powered wireless temperature sensor node for power grid monitoring. With an electromagnetic energy harvester, the node can operate without a battery. In order to reduce the power consumption, several techniques, including deep duty-cycle operation, simple chip architecture with only transmitter, and careful control of sleeping power, are adopted, reducing the average power consumption to only 3.26 μW. The measurement results show that the temperature range is from 0 to 80 °C with a resolution of 0.8 °C. With 2-FSK modulation on the carrier frequency of 433 MHz, the maximum output power is 14.5 dBm, which enables the transmission distance of 70 m, with a bit error rate and packet loss rate of 0.037% and 0.89%, respectively. Similar system architectures and ultralow power (ULP) strategies can be applied to other wireless sensor networks.},
}

@misc{guoxing_wang_f51b669870bba7f1,
  title = {On-chip Data Compression Scheme for Lung EIT Signal Acquisition and Recovery},
  author = {Boxiao Liu and Chun-Huat Heng and Guoxing Wang and Yong Lian},
  year = {2018},
  doi = {10.1109/icdsp.2018.8631589},
  url = {https://doi.org/10.1109/icdsp.2018.8631589},
  howpublished = {IEEE International Conference on Digital Signal Processing (DSP)},
  annotation = {中文辅助译名：用于肺 EIT 信号采集和恢复的片上数据压缩方案},
  abstract = {An on-chip data compression scheme, suitable for electrical impedance tomography signal acquisition and recovery is proposed. For typical 16 electrode lung electrical impedance tomography system, 13 channel high frequency signals are acquired and I/Q demodulated to different frequencies. Frequency division signals are summed up and sampled by only two delta sigma modulators with high resolution. Thus 84.6% reduction of ADC usage is achieved, and the output data is repacked with compression ratio of 9.75. After decimation, each I/Q signal is recovered with 10-bit resolution by applying Blackman window corrected fast Fourier transformation algorithm.},
}

@misc{guoxing_wang_cf8e647c74e95de1,
  title = {A Batteryless and Single-Inductor DC-DC Boost Converter for Thermoelectric Energy Harvesting Application with 190mV Cold-Start Voltage},
  author = {Hengwei Yu and Mingyi Chen and Chundong Wu and Kea‐Tiong Tang and Guoxing Wang},
  year = {2018},
  doi = {10.1109/iscas.2018.8351428},
  url = {https://doi.org/10.1109/iscas.2018.8351428},
  howpublished = {IEEE International Symposium on Circuits and Systems proceedings},
  annotation = {中文辅助译名：用于热电能量收集应用的无电池单电感 DC-DC 升压转换器，冷启动电压为 190mV},
  abstract = {This paper presents a batteryless DC-DC boost converter for thermoelectric energy harvesting application. With a stepping-up architecture and by inductor sharing, only one off-chip inductor is employed. Fabricated in 0.18μm CMOS process, the chip can be cold-started at 190mV and sustain operation with a minimum input voltage of 50mV. Zero-current switching (ZCS) and maximum power point tracking (MPPT) techniques are utilized to enhance the measured peak efficiency to 60%. And the output voltage can be regulated from 1V to 1.6V.},
}

@misc{guoxing_wang_6fa4d002ee55a8b1,
  title = {A CMOS Temperature Sensor With Single-Point Calibration for Retinal Prosthesis},
  author = {Guoxing Wang and Jie Zhou and Mingyi Chen and Zhiheng Zheng},
  year = {2018},
  doi = {10.1109/APCCAS.2018.8605719},
  url = {https://doi.org/10.1109/APCCAS.2018.8605719},
  howpublished = {APCCAS},
  annotation = {中文辅助译名：用于视网膜假体的单点校准 CMOS 温度传感器},
  abstract = {A CMOS temperature sensor for retinal prosthesis has been realized using X-FAB 0.35-μm CMOS technology. Isolated vertical bipolar NPN transistors are used to sense the temperature. Conversion of temperature to digital output is achieved by a SAR ADC. The temperature sensor operates in a short time and then enters the standby mode to save power. It can realize a high resolution of 0.125°C in the temperature range from 20°C to 50°C. After single-point calibration, the inaccuracy of the sensor is -0.5/+0.25°C.},
}

@misc{guoxing_wang_c6d110ec2d9edb16,
  title = {Low-noise high input impedance 8-channels chopper-stabilized EEG acquisition system},
  author = {Guoxing Wang and Yong Lian and Zhengnan Yan and Mohamed Atef},
  year = {2017},
  doi = {10.1109/SOCC.2017.8226005},
  url = {https://doi.org/10.1109/SOCC.2017.8226005},
  howpublished = {SoCC},
  annotation = {中文辅助译名：低噪声高输入阻抗8通道斩波稳定脑电采集系统},
  abstract = {This paper presents the design and implementation of an 8-channel low-noise chopper-stabilized analog front-end (AFE) for electroencephalogram (EEG) acquisition system. Each channel of the AFE is composed of an AC-coupled chopper instrumentation amplifier (ACCIA), a programmable gain amplifier (PGA), and a buffer. A positive feedback loop is adopted to boost its input impedance while the low-pass property suppresses the chopping ripple. The proposed AFE is implemented in 0.35 gm CMOS technology with the ADC, MUX, digital part and other control blocks. Post-layout simulation results show that the AFE achieves 46/52/58/64 dB programmable gain, 108 dB CMRR, and 0.32 μVrmsinput-referred noise for a bandwidth of 0.5-150 Hz. Each channel consumes 7.5 μA from a 3 V supply.},
}

@misc{guoxing_wang_0e2cd4f805fabbe8,
  title = {Emotion recognition based on low-cost in-ear EEG},
  author = {Guoxing Wang and Zhe Zhang and Gang Li},
  year = {2017},
  doi = {10.1109/BIOCAS.2017.8325198},
  url = {https://doi.org/10.1109/BIOCAS.2017.8325198},
  howpublished = {BioCAS},
  annotation = {中文辅助译名：基于低成本入耳式脑电图的情绪识别},
  abstract = {In this paper, we propose a low-cost in-ear EEG device which is implemented by refitting a commercial scalp EEG device, in order to recognize emotion in a manner that is simple, inexpensive, and popular in style. EEG signals of twelve subjects were recorded under three emotion conditions that were induced by music and video materials. By using wavelet packet transformation (WPT), two frequency features and a nonlinear feature are extracted to create a three-dimensional feature vector for each labeled EEG segment. These feature vectors are input into a support vector machine (SVM) classifier for automatic emotion recognition. The SVM classifier achieved a best 94.1% cross-validation accuracy for positive (high valence, HV) and negative (low valence, LV) two-class emotion recognition. However, the accuracy for excited (high valence and high arousal, HVHA), relaxed (high valence and low arousal, HVLA) and negative (LV) multi-class emotion classification was 58.8%. The experimental results show that the proposed low-cost in-ear EEG has outstanding accuracy for valence recognition, but poor accuracy for arousal recognition.},
}

