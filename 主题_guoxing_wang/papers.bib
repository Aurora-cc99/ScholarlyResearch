@misc{guoxing_wang_b792cc7373400734,
  title = {10 Gb/s 1.95 mW active cascode transimpedance amplifier for high speed optical receivers},
  author = {Guoxing Wang and Mohamed Atef and Diaa Abdelrahman},
  year = {2016},
  doi = {10.1109/MWSCAS.2016.7870132},
  url = {https://doi.org/10.1109/MWSCAS.2016.7870132},
  howpublished = {MWSCAS},
  annotation = {中文辅助译名：适用于高速光接收器的 10 Gb/s 1.95 mW 有源共源共栅跨阻放大器},
  abstract = {This paper presents the design and performance of a transimpedance amplifier (TIA) for optical receivers integrated in a 130nm CMOS technology. The proposed TIA is based on common source (CS) voltage amplifier with a shunt-shunt feedback resistor using active cascode technique (CSAC-TIA). The CSAC technique succeeds to extend the bandwidth without scarifying the gain and power consumption. The presented CSAC-TIA shows a post layout simulated transimpedance gain of 56.65 dBΩ with bandwidth 7 GHz for 0.2 pF photodiode capacitance and optical sensitivity of -20.5 dBm at a BER= 10-12. The presented CSAC-TIA consumes 1.95 mW from single voltage supply of 1.5 V.},
}

