@misc{guoxing_wang_8fcbae6ec540a5ed,
  title = {An Asynchronous AC-DC Boost Converter With Event-Driven Voltage Regulator and 94% Efficiency for Low-Frequency Electromagnetic Energy Harvesting},
  author = {Zhuo Gao and Mingyi Chen and Kangqi Liu and Jian ping Zhao and Yongfu Li and Guoxing Wang},
  year = {2021},
