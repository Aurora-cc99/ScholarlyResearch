@misc{guoxing_wang_c0e090d96a292730,
  title = {A low power level-crossing ADC for wearable wireless ECG sensors},
  author = {Zhenzhen Tian and Rendong Ying and Yong Lian and Guoxing Wang and Peilin Liu},
  year = {2016},
  doi = {10.1109/EMBC.2016.7591493},
  url = {https://doi.org/10.1109/EMBC.2016.7591493},
  howpublished = {EMBC},
  annotation = {中文辅助译名：用于可穿戴无线 ECG 传感器的低功耗跨电平 ADC},
  abstract = {Ultra-low power consumption is desired in most wearable biomedical devices. The event-driven based Analog-to-Digital converter (ADC) could be an excellent candidate for low power system because of the reduction in sampling points for biosignals. In the existing event-driven based ADC architectures, two or more high precision comparators are utilized to sample the input signal. In this paper, we propose a new scheme utilizing only one high precision comparator to genertate samples with the assistance of a low precision one. From the Matlab simulations on real ECG signal, it is shown that around 25% reduction on the number of samples can be be achieved compared with the Nyquist sampling scheme.},
}

@misc{guoxing_wang_1406a62c066df7b6,
  title = {A high-voltage stimulation chip for wearable stroke rehabilitation systems},
  author = {Guoxing Wang and Lei Zeng and Mohamad Sawan and Guoyong Shi and Xin Yi},
  year = {2016},
  doi = {10.1002/CTA.2181},
  url = {https://doi.org/10.1002/CTA.2181},
  howpublished = {Int. J. Circuit Theory Appl.},
  annotation = {中文辅助译名：用于可穿戴中风康复系统的高压刺激芯片},
  abstract = {In this work, an 8‐channel high‐voltage (HV) stimulation chip for the rehabilitation of stroke patients through surface stimulation is presented. The chip receives control data through its serial peripheral interface and can be controlled by an external microcontroller. It can accordingly generate biphasic stimulation currents with different amplitudes, duration time, frequencies, and polarities for each channel independently. The chip was designed and fabricated using X‐FAB 0.35 µm HV mixed‐signal process. Circuits were carefully designed to ensure their operations under HVs. Our measurement results showed that a supply voltage of as high as 75 V can be achieved, and the current driver can generate biphasic stimuli with current amplitudes up to 4 mA. Copyright © 2015 John Wiley & Sons, Ltd.},
}

