@misc{guoxing_wang_051db2994860a5f8,
  title = {A 2.4-GS/s 7.5-MHz-BW 95.4-dB-DR CT 4× Time-Interleaved Second-Order DSM Achieving 0-dBFS-MSA With High Tolerance to ELD},
  author = {Yuekai Liu and Ziqiang Cai and Jingying Zhang and Yichen Jin and Zhenzhen Tian and Guoxing Wang and Liang Qi},
  year = {2026},
  doi = {10.1109/jssc.2026.3740491},
  url = {https://doi.org/10.1109/jssc.2026.3740491},
  howpublished = {IEEE Journal of Solid-State Circuits},
  annotation = {中文辅助译名：2.4GS/s 7.5MHz-BW 95.4dB-DR CT 4× 时间交错二阶 DSM 可实现具有高 ELD 容差的 0dBFS-MSA},
  abstract = {This article presents a continuous-time (CT), four-channel ($4\times)$time-interleaved (TI) delta–sigma modulator (DSM). Based on a CT 2nd-order feedforward loop filter (LF), an equivalent$4\times $TI CT DSM has been constructed by using digital extrapolation. Thereby, it merely requires two active integrators and three quantizers (QTZs) for the overall$4\times $TI DSM system. Note that the$4\times $TI implementation allows a lower sampling rate for the DSM analog loop. Furthermore, leveraging digital extrapolation, the analog loop is designed to operate solely as a 1st-order system, whereas the complete 2nd-order noise transfer function (NTF) is synthesized in the digital backend. Notably, the 1st-order analog loop exhibits strong robustness to excess loop delay (ELD)—an inherent issue in CT implementations. Consequently, the$4\times $TI CT DSM maintains high immunity to ELD without requiring any compensation, thereby greatly simplifying the overall$4\times $TI system. Fabricated in a 65-nm CMOS process and clocked at 600 MHz, the prototype yields an equivalent sampling rate of 2.4 GS/s. With the on-chip DAC calibration enabled, it achieves a dynamic range (DR) of 95.4dB and a signal-to-noise and distortion ratio (SNDR) of 87.5 dB over a 7.5-MHz bandwidth (BW) with a full-scale, 2.2-MHz input signal. Consuming 21.92 mW of power at 1.2/1.8-V supplies, it leads to a state-of-the-art FoM$_\mathrm S\vert DR$of 180.7 dB.},
}

@misc{guoxing_wang_e8d6da7fa6ffa684,
  title = {Photoacoustic Noninvasive Blood Glucose Monitoring: A Review of Systems and Strategies for Robust Glucose Concentration Estimation, with Perspectives on Miniaturization and Wearability},
  author = {Jianyu Zhang and Zhizhang Li and Min Wang and Lu Lin and Guoxing Wang and Cheng Chen},
  year = {2026},
  doi = {10.3390/s26061942},
  url = {https://doi.org/10.3390/s26061942},
  howpublished = {Sensors},
  annotation = {中文辅助译名：光声无创血糖监测：从小型化和可穿戴性的角度回顾稳健葡萄糖浓度估计的系统和策略},
  abstract = {Noninvasive blood glucose monitoring has long been a critical research focus in diabetes management. Among emerging technologies, photoacoustic sensing, combining the molecular specificity with deep penetration, has garnered significant attention. It offers rapid response and pain-free operation, making it a strong candidate for next-generation portable blood glucose monitoring devices. This review systematically traces the development and current state of photoacoustic glucose sensing, with a particular focus on the selection and optimization of core system components. It also summarizes common interference in glucose detection and outlines strategies for their mitigation, along with signal processing and signal-to-noise ratio enhancement techniques suitable for real-world applications. Addressing the growing demand for wearable continuous glucose monitors, this work analyzes the key challenges in system integration and outlines recent advances in enabling technologies. It proposes multi-technology integration approaches to bridge the gap between photoacoustic sensing and microsystem design, offering theoretical foundations and practical guidance for future research on wearable photoacoustic systems.},
}

@misc{guoxing_wang_72f6b35759a6691e,
  title = {A Digitally Enhanced Capacitively Coupled VCO-Based CTDSM Featuring Mostly Digital Configurable RRL and PLL-Based Impedance Boosting for Biopotential Recording},
  author = {Yang Lin and Pujia Xing and Huaiyu Liu and Guoxing Wang and Yan Liu},
  year = {2026},
  doi = {10.1109/tcsi.2026.3705231},
  url = {https://doi.org/10.1109/tcsi.2026.3705231},
  howpublished = {IEEE Transactions on Circuits and Systems I Regular Papers},
  annotation = {中文辅助译名：基于 VCO 的数字增强型电容耦合 CTDSM，主要具有用于生物电记录的数字可配置 RRL 和基于 PLL 的阻抗提升},
  abstract = {The capacitively coupled (CC) voltage-controlled oscillator (VCO)-based continuous-time$\rm \Delta \Sigma $modulator (CTDSM) combines a wide common-mode input range and high linearity with inherent noise-shaping and direct digital output, making it attractive for biopotential recording. While chopping is essential to suppress flicker noise and improve the common-mode rejection ratio (CMRR), it severely degrades input impedance, attenuating weak biosignals. Applying positive feedback or lowering chopping frequency can alleviate this degradation, however, the former suffers from limited compensation precision and the latter introduces in-band ripple and other nonidealities due to the input-referred offset voltage$V_os,in$. To overcome these issues, this paper presents a digitally-enhanced CC VCO-based CTDSM: first, a current-injection phase-locked loop (PLL)-based pulse-width-modulation (PWM) generator for precise positive feedback capacitance tuning to boost input impedance; second, a mostly digital ripple reduction loop (RRL) that suppresses$V_os,in$via a configurable digital integrator and a current-steering digital-to analog converter (IDAC). Fabricated in 180-nm CMOS, the prototype achieves an input impedance of 12.97 G$\Omega $at 2 Hz with a 10 kHz chopping frequency, while simultaneously achieving an input-referred noise (IRN) of$2.75~\mu V_rms$, a peak signal-to-noise and distortion ratio (SNDR) of 82.9 dB over a 1 kHz bandwidth, and a 160 mVpp input range that ac},
}

@misc{guoxing_wang_27dd7135ec8847f6,
  title = {A 3.64 μ J/Frame Visual-Aided Speech Enhancement Processor for −10 dB Noise Tolerance},
  author = {Nan Wu and Siqi Wang and Huizheng Wang and Peng Wang and Xiao Liu and Zhihua Wang and Yang Hu and Guoxing Wang and Yanshu Guo and Hanjun Jiang},
  year = {2026},
  doi = {10.1109/jssc.2026.3746040},
  url = {https://doi.org/10.1109/jssc.2026.3746040},
  howpublished = {IEEE Journal of Solid-State Circuits},
  annotation = {中文辅助译名：具有 −10 dB 噪声容限的 3.64 μ J/帧视觉辅助语音增强处理器},
  abstract = {Visual-aided speech enhancement (VASE) exhibits robust performance over the audio-only models in extremely noisy environments. However, the distinct computational properties of multimodal fusion introduce significant hardware inefficiencies. In this article, we present an energy-efficient VASE processor tailored for intelligent hearing aids to achieve high-noise tolerance. To address the specific challenges of multimodal processing with a limited power budget, three key software–hardware co-optimization techniques are proposed. First, a redundancy speculation dynamic computing (RSDC) architecture is proposed. Using transfer learning, it derives a dynamic-level signal from high-level speech features. Based on this level, RSDC dynamically adjusts the computation flow to bypass unnecessary visual extraction and modality fusion, eliminating 36.9% of overall computations. Second, a multi-domain coding processing element (MCPE) employs three heterogeneous coding domains to adaptively match varying weight distributions, offering up to a$2.14\times $efficiency gain in multiplications. Third, a bipolar computing engine (BCE) is proposed to minimize dynamic power of accumulation. By predicting the accumulation sign using the sign bits of weights and activations, it enables a sign-aware scheduling of the accumulation order and improves processing efficiency by$2.51\times $. Fabricated in a 22 nm CMOS process, the processor consumes only$228~\mu $W of power at 0.65 V. The proposed design},
}

@misc{guoxing_wang_e214813d78f44696,
  title = {A Low-phase-error FD-fNIRS Readout Circuit with Sub-1V Transimpedance Amplifier and LC-ADC-based Amplitude Control Loop},
  author = {Cheng Chen and Zheng Ding and Guoxing Wang and Kang-Kang Xu and Mohamad Sawan and Nan Zeng and Shuo Zhang and Jian Zhao},
  year = {2026},
  doi = {10.1109/ISCAS66217.2026.11562872},
  url = {https://doi.org/10.1109/ISCAS66217.2026.11562872},
  howpublished = {ISCAS},
  annotation = {中文辅助译名：具有低于 1V 跨阻放大器和基于 LC-ADC 的幅度控制环路的低相位误差 FD-fNIRS 读出电路},
  abstract = {Frequency-domain functional near-infrared spectroscopy (FD-fNIRS) ultilizes the propagation time and amplitude attenuation of light in tissue to quantify blood oxygen concentration. This enables more detailed monitoring of human brain activity, providing a potential solution for non-invasive and wearable brain-computer interface (BCI) devices. However, the amplitude-phase coupling effect of the comparator in the phase detector introduces phase errors, which in turn leads to inaccuracies in the measurement of light propagation time. To suppress amplitude-phase coupling effect, an amplitude control loop based on the level-crossing analog-to-digital converter (LC ADC) is employed. The utilization of the LC ADC eliminates the need for a high-speed envelope detector, thereby reducing circuit complexity and power consumption. In addition, a sub-1V transimpedance amplifier (TIA) is employed to improve energy efficiency. The proposed structure achieves a phase error of 0.11° and 12 mW power consumption.},
}

@misc{guoxing_wang_b7f6fe1a280aaff6,
  title = {A 64-Channel Thin-Film Transistor-Based Multimodal Active Pixel Sensor Array for Lab-on-Chip Applications},
  author = {Songyu Han and Ziqi Ma and Hangzheng Lu and Jian ping Zhao and Yongfu Li and Wei Tang and Xiaojun Guo and Guoxing Wang and Yan Liu},
  year = {2026},
  doi = {10.1109/jsen.2026.3739985},
  url = {https://doi.org/10.1109/jsen.2026.3739985},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：适用于片上实验室应用的 64 通道基于薄膜晶体管的多模式有源像素传感器阵列},
  abstract = {This article demonstrates a 64-channel multimodal active pixel sensor (APS) array in thin-film transistor (TFT) technology for lab-on-chip (LOC) applications. The prototype, implemented in a 3-μm low-temperature polysilicon (LTPS) technology, integrates four modalities, including electrical recording, chemical recording, optical recording, and electrical stimulation, enabling simultaneous multimodal signal recording and conditioning on a single glass substrate. The APS architecture scheme is designed to address the challenges of scalability and signal integrity in low-cost, large-area electronic platforms. Each unit pixel occupies an area of 1130 μm × 1130 μm, and includes one electrical recording site, one chemical recording site, one optical recording site, and one electrical stimulation site. The recording electrodes and the chemical sensing membrane are directly formed through a standard LTPS process. The in-pixel amplifier directly pre-amplifies the readout signal, while the ion-sensitive thin-film transistor (ISTFT) and N-type photo TFT are employed for chemical and optical sensing, respectively. Measurement results in saline solution demonstrate that the array can stably record signals from all modalities. The on-chip electrical recording achieves an amplification gain of 45.28 dB, the chemical recording achieves a sensitivity of 23.4 mV/pH, and the optical recording achieves a responsivity of 0.6 nA/W at 685 nm when biased in the subthreshold region. This work demonst},
}

@misc{guoxing_wang_c3ae2f75e46f3c68,
  title = {Automated Pediatric Delirium Recognition via Deep Learning-Powered Video Analysis},
  author = {Cheng Chen and Xiaoyu Lin and Lixiang Gu and Yali Huang and Guoxing Wang and Wenyi Luo and Jiarong Chen and Liebin Zhao and Wenqi Shi and Yemin Gong and Haibao Chen and Suqin Xia},
  year = {2026},
  doi = {10.1109/JBHI.2025.3604448},
  url = {https://doi.org/10.1109/JBHI.2025.3604448},
  howpublished = {IEEE J. Biomed. Health Informatics},
  annotation = {中文辅助译名：通过深度学习驱动的视频分析自动识别儿科谵妄},
  abstract = {Delirium is an acute, fluctuating state of consciousness disturbance characterized by cognitive alterations and perceptual disturbances. Pediatric delirium has a notably higher incidence rate than adult delirium, and it is time-consuming and labor-intensive for clinicians to analyze, requiring effective recognition approaches. Deep learning has shown potential for the extraction of robust representations and improvement of patient outcomes. In this study, 129 video samples labeled by professional clinicians were collected from multiple hospitals, including 74 non-delirium and 55 delirium labeled samples. An 18-layer deep spatiotemporal convolutional neural network is employed, in which two-dimensional and one-dimensional convolutional filters are applied to individual video frames to extract frame-level and inter-frame-level features, respectively. The entire architecture is pretrained on a large-scale video analysis dataset, and a three-layer fully connected classification head is integrated for the delirium recognition task. The proposed model was fine-tuned with a training dataset and evaluated on a testing dataset, exploring various models and strategies. The proposed algorithm demonstrated robust classification performance, achieving an accuracy of 0.8718, precision of 0.8711, recall of 0.8730, and F1-score of 0.8715, with approximately 31.54 million model parameters. These metric results validate the clinical applicability and technical reliability of the model under va},
}

@misc{guoxing_wang_ba8a5338475d772c,
  title = {Live Demonstration: A Dual-modal Neural Sensing Array System with Back-end Neural Signal Processing},
  author = {Guoxing Wang and Songyu Han and Zepu Li and Yan Liu},
  year = {2026},
  doi = {10.1109/ISCAS66217.2026.11562213},
  url = {https://doi.org/10.1109/ISCAS66217.2026.11562213},
  howpublished = {ISCAS},
  annotation = {中文辅助译名：现场演示：具有后端神经信号处理的双模态神经传感阵列系统},
  abstract = {This live demonstration shows a dual-modal neural sensing array system with back-end neural signal processing. The implemented system includes a front-end 32×32 pixels LabOn-Chip array and a back-end python-based data sorting and processing engine to examine. Within the array, a dual mode recordings pixels is capable to capture both electrical recording channel and three chemical recording channels, with integrated sensors/electrodes, amplifiers and digitization circuits. The spacing between active pixels is only 100μm. The 1024 electrical recording channels and 3072 chemical recording channels can simultaneously collect electrical and chemical signals for in-vitro brain slice at the sampling rates of 10kHz and 3.3kHz. The back-end data processing engine collect the data, analysis the correlation between recording sites.},
}

