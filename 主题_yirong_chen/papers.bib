  author = {Yirong Chen and Xiaofen Xing and Jingkai Lin and Huimin Zheng and Zhenyu Wang and Qi Liu and Xiangmin Xu},
  year = {2023},
  doi = {10.48550/ARXIV.2311.00273},
  url = {https://doi.org/10.48550/ARXIV.2311.00273},
