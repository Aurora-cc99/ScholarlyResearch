@misc{yirong_chen_c1bd63922f975b51,
  title = {Directional Three-Dimensional Macroporous Carbon Foams Decorated with WC1−x Nanoparticles Derived from Salting-Out Protein Assemblies for Highly Effective Electromagnetic Absorption},
  author = {Yongzheng Chen and Lixue Gai and Bo Hu and Yan Wang and Yanyi Chen and Xijiang Han and Ping Xu and Yunchen Du},
  year = {2025},
  doi = {10.1007/s40820-025-01920-z},
  url = {https://doi.org/10.1007/s40820-025-01920-z},
  howpublished = {Nano-Micro Letters},
  annotation = {中文辅助译名：定向三维大孔碳泡沫装饰有来自盐析蛋白组件的 WC1−x 纳米颗粒，可实现高效电磁吸收},
  abstract = {Directional three-dimensional carbon-based foams are emerging as highly attractive candidates for promising electromagnetic wave absorbing materials (EWAMs) thanks to their unique architecture, but their construction usually involves complex procedures and extremely depends on unidirectional freezing technique. Herein, we propose a groundbreaking approach that leverages the assemblies of salting-out protein induced by ammonium metatungstate (AM) as the precursor, and then acquire directional three-dimensional carbon-based foams through simple pyrolysis. The electrostatic interaction between AM and protein ensures well dispersion of WC 1−x nanoparticles on carbon frameworks. The content of WC 1−x nanoparticles can be rationally regulated by AM dosage, and it also affects the electromagnetic (EM) properties of final carbon-based foams. The optimized foam exhibits exceptional EM absorption performance, achieving a remarkable minimum reflection loss of − 72.0 dB and an effective absorption bandwidth of 6.3 GHz when EM wave propagates parallel to the directional pores. Such performance benefits from the synergistic effects of macroporous architecture and compositional design. Although there is a directional dependence of EM absorption, radar stealth simulation demonstrates that these foams can still promise considerable reduction in radar cross section with the change of incident angle. Moreover, COMSOL simulation further identifies their good performance in preventing EM interfer},
}

@misc{yirong_chen_7590ae4bef046d21,
  title = {Research on the variation of time-frequency domain signals during transmission in high voltage cables as affected by wave speed and attenuation},
  author = {Jiaming Huang and Yadi Wang and Yanyi Chen and Yunying Mai and Danbing Liu and Yuting Ye and Hang Dou and Xinxin Hu and Wuzhou Zhu and Gang Liu},
  year = {2025},
  doi = {10.1088/1742-6596/2963/1/012017},
  url = {https://doi.org/10.1088/1742-6596/2963/1/012017},
  howpublished = {Journal of Physics Conference Series},
  annotation = {中文辅助译名：高压电缆传输时频域信号受波速和衰减影响的变化研究},
  abstract = {High-voltage cables play a vital role in urban power transmission. However, cables can become defective during operation due to corrosion, aging, etc., which can lead to power outages, fires, and other accidents. The time-frequency domain reflection method is a cable detection method, but it uses a detection signal that is difficult to calculate the wave speed due to the continuously changing frequency characteristics, which can lead to errors due to wave speed determination. In this paper, a signal transmission model considering the effects of wave speed and attenuation will be established to simulate the process of signal change. The simulations concluded that in 110 kV high voltage cable which has a 150 m fault point, the signal would generate a positioning offset of 1.1758 m due to the wave speed.},
}

@misc{yirong_chen_4ae2bb61b6cbf9f7,
  title = {Research on the characteristic impedance model and breakage detection method of high-voltage cable outer sheath},
  author = {Yadi Wang and Jiaming Hang and Yanyi Chen and Liang Tang and Xinxin Hu and Hang Dou and Danbing Liu and Yuting Ye and Wuzhou Zhu and Gang Liu},
  year = {2025},
  doi = {10.1088/1742-6596/2963/1/012015},
  url = {https://doi.org/10.1088/1742-6596/2963/1/012015},
  howpublished = {Journal of Physics Conference Series},
  annotation = {中文辅助译名：高压电缆外护层特性阻抗模型及断线检测方法研究},
  abstract = {The outer sheath of high voltage cables is the “first line of defence”, preventing the internal structure of the cable from being damaged in the first place. However, during cable operation, the outer sheath can break due to termite erosion, external stress, and other factors. In order to detect the broken state of the outer sheath of high-voltage cables and to improve the stability and reliability of the power grid operation, this paper proposes the detection method for the identification and localization of the fault point of cables. First, it establishes a model of the characteristic impedance of high-voltage cables’ outer sheath and the distribution parameters calculation method. Then, it builds the experimental platform consisting of two parallel-laid 110kV single-core XLPE cables as the experimental object to carry out the experimental verification of single-side breakage and bilateral breakage. Finally, it uses the time-frequency domain reflection (TFDR) method to detect and localize the two cables’ fault points with localization relative errors of 0.39% and 1.09%. The model’s accuracy as a high-voltage cable detection model is verified.},
}

