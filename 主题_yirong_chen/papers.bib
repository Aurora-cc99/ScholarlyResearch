@misc{yirong_chen_cd0829db72f21e9c,
  title = {An Interpretable Model Using Evidence Information for Multi-Hop Question Answering Over Long Texts},
  author = {Yanyi Chen and Ruifang Liu and Xiyan Liu and Yidong Shi and Ge Bai},
  year = {2023},
  doi = {10.1109/icassp49357.2023.10095602},
  url = {https://doi.org/10.1109/icassp49357.2023.10095602},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：使用证据信息进行长文本多跳问答的可解释模型},
  abstract = {Machine Reading Comprehension (MRC) is a challenging task in natural language understanding, especially multi-hop question answering (QA) in long texts. One of the challenges in multi-hop QA requires models to produce interpretable answers based on evidence that is selected from a given long text. Based on the Retriever-Reader architecture, existing work tackles this problem by using different methods to exploit various evidence information. To better use evidence information, we propose a loss function considering answer groups, which improves the reasoning ability of the reader in the Retriever-Reader architecture. Besides, we introduce the relevance constraint factor containing evidence information to improve the reader’s ability of locating key sentences. Evaluated on the HotpotQA dataset, the proposed methods achieve improvement, demonstrating the effectiveness of our methods and the importance of evidence information.},
}

@misc{yirong_chen_1bc65fbb7dbc7487,
  title = {Narrow Down Before Selection: A Dynamic Exclusion Model for Multiple-Choice QA},
  author = {Xiyan Liu and Yidong Shi and Ruifang Liu and Ge Bai and Yanyi Chen},
  year = {2023},
  doi = {10.1109/icassp49357.2023.10096136},
  url = {https://doi.org/10.1109/icassp49357.2023.10096136},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：选择前缩小范围：用于多项选择 QA 的动态排除模型},
  abstract = {Multiple-choice question answering (MCQA) is a challenging task that requires selecting the correct answer from a set of options based on a given question. There is a trend to use pre-trained encoder-decoder models to solve MCQA. Previous works concentrate on the decoder and adopt the generated text to enhance model performance. However, few studies have optimized the use of encoders for the characteristics of MCQA. In this work, we propose a dynamic exclusion model for MCQA named ExcMC, which mimics human thinking in selection. It dynamically eliminates several incorrect options to optimize the encoder usage. ExcMC outperforms existing comparable works on two widely-used MCQA datasets, demonstrating the effectiveness of our model.},
}

@misc{yirong_chen_4998c5c3120b6002,
  title = {A cooperative positioning algorithm based on adaptive selection and factor graph},
  author = {Qinghua Luo and Qicheng Guo and Jiaqi Lin and Yanyi Chen},
  year = {2023},
  doi = {10.1109/oncon60463.2023.10431055},
  url = {http://dx.doi.org/10.1109/oncon60463.2023.10431055},
  howpublished = {IEEE Industrial Electronics Society Annual On-Line Conference (ONCON)},
  annotation = {中文辅助译名：一种基于自适应选择和因子图的协作定位算法},
  abstract = {The cooperative positioning technology based on Autonomous Underwater Vehicles (AUVs) is one of the most rapidly developing underwater positioning technologies in recent years, it can complete complex underwater tasks that are difficult for a single AUV to complete, and has broad development prospects. Due to the complex underwater environment, fuzzy time-varying noise may be generated, which may also lead to changes in the system structure, the number of leader AUVs is numerous and the quality is complex. These factors can lead to a decrease in the accuracy and efficiency of traditional algorithms. To address these issues, we propose a cooperative positioning algorithm based on dynamic structure-based adaptive selection and Factor Graph (DS-AOSFG). Systems with dynamic topology can effectively cope with structural changes. In response to fuzzy time-varying noise, we introduce an adaptive filter module. In response to the problem of many leader AUVs and mixed quality, we introduce a node optimization selection module and improve the traditional algorithm through the factor graph algorithm. The final evaluation indicates that our DS-AOSFG method outperforms other algorithms in terms of positioning accuracy and speed.},
}

