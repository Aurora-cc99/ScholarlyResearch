  abstract = {In this study, utility theory is introduced into stakeholder analysis, stakeholders in waterway engineering projects (WEPs) are defined, the influencing factors of stakeholder utility in WEPs are analysed and a decision making index system for investment in WEPs is constructed. In view of the multi-attribute group decision making characteristics of investment decisions in WEPs and the fuzziness of the attribute values of programmes, combined with multi-attribute group decision making and intuitionistic fuzzy set theory, an intuitionistic fuzzy multi-attribute decision making method based on S-type utility function is proposed and the utility function of stakeholders in WEPs is established. The proposed method was applied to analyse investment decisions in WEPs and a sensitivity analysis of the parameters ϕ, η and γ in the S-type utility function on the optimal programme was carried out to study the influence of the decision makers’ risk attitude on the results. The method can be used to conduct a preliminary and intuitive quantitative evaluation of the effectiveness of waterway project construction, provide a basis for decision making on WEPs and help to maximise the benefits of waterway construction.},
}

@misc{yirong_chen_7af550a44dc6f9f9,
  title = {Efficiency Evaluation of multi-modal Transport Considering Undesirable Outputs Based on the SBM Model},
  author = {Ye Li and Jiaqi Yang and Yanyi Chen and Jiarun Peng},
  year = {2025},
  doi = {10.1109/ictis68762.2025.11214918},
  url = {https://doi.org/10.1109/ictis68762.2025.11214918},
  howpublished = {International Conference on Transportation Information and Safety},
  annotation = {中文辅助译名：基于SBM模型的考虑不良输出的多式联运效率评估},
  abstract = {This study focuses on evaluating the efficiency of multi-modal transport systems while incorporating the consideration of undesirable outputs, using the super-efficiency SBM model as a theoretical basis. Compared to single-modal transport systems, multi-modal transport demonstrates significantly greater advantages by efficiently integrating various transportation modes, thereby reducing intermediate transfers, shortening transit times, and lowering energy consumption and emissions. By selecting input-output indicators across multiple cities, the research provides a detailed analysis of multi-modal transport efficiency, with an emphasis on the role of undesirable outputs. Unlike traditional DEA models, the SBM model combines non-radial and non-angular efficiency assessments, enabling the simultaneous evaluation of multidimensional changes in inputs, desirable outputs, and undesirable outputs. Moreover, the model incorporates slack variables for both inputs and outputs, offering a more thorough understanding of resource utilization and environmental sustainability. To further investigate the factors influencing the efficiency of multi-modal transport, the study employs the Tobit model. Based on the analysis, targeted strategies and actionable recommendations are proposed to enhance the efficiency and sustainability of multi-modal transport systems, contributing to a more effective integration of resources and improved environmental outcomes.},
}

