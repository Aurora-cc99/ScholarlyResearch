  title = {A Butterfly Algorithm That Combines Chaos Mapping and Fused Particle Swarm Optimization for UAV Path Planning},
  author = {Linlin Wang and Xin Zhang and Huilong Zheng and Chuanyun Wang and Qian Gao and Tong Zhang and Zhongyi Li and Jing Shao},
  year = {2024},
