@misc{tong_zhang_19f87adcf470fb77,
  title = {Research on Speed Guidance Srategy of Traffic Platoon Based on “Time Block”},
  author = {Zhang Zeying and Tong Zhang and Wang Jiangfeng and Liu Song and Rong Wang},
  year = {2019},
  doi = {10.3233/978-1-61499-939-3-287},
  url = {https://doi.org/10.3233/978-1-61499-939-3-287},
  howpublished = {Frontiers in artificial intelligence and applications},
  annotation = {中文辅助译名：基于“时间块”的交通队列速度引导策略研究},
  abstract = {Many researchers come up with speed guidance models applied to intersection in order to improve the traffic efficiency at intersection and reduce the vehicle emission. However, most of the speed guidance models are single car models with complex parameters and low compute efficiency. This paper presents a traffic platoon speed guidance strategy based on “Time Block”. It can realize the Inter-Vehicle Communication as well as providing a proper speed to the vehicle driver according to the signal lamp and vehicle's real-time position information. The simulation results show that this model can be applied to different saturation sections and it can efficiently reduce average traffic delay by around 35.0%, reduce hydrocarbon emissions by 52.7%, and reduce the CO emissions by 29.1%. What's more, it also can cause 23.4% reduction of accident rate.},
}

@misc{tong_zhang_be82898320f638ee,
  title = {Multi-Kernel Broad Learning systems Based on Random Features: A Novel Expansion for Nonlinear Feature Nodes},
  author = {Zhulin Liu and C. L. Philip Chen and Tong Zhang and Jin Zhou},
  year = {2019},
  doi = {10.1109/SMC.2019.8914328},
  url = {https://doi.org/10.1109/SMC.2019.8914328},
  howpublished = {SMC},
  annotation = {中文辅助译名：基于随机特征的多核广泛学习系统：非线性特征节点的新颖扩展},
  abstract = {The Broad Learning System has been proved to be effective and efficient. However, the associated feature nodes in the system are mainly based on linear mappings. Although such kind of features has been successful in various datasets and applications, more general features (especially for the nonlinear features) are necessary for specific applications. Motivated by the powerful capability of the kernel methods, a novel expansion of broad learning system based on multiple kernels is proposed in this paper. Firstly, the nonlinear feature mappings in the form of multiple kernels are merged into the feature nodes of broad learning system. After that, the resulted features are further enhanced through nonlinear activation functions. The experimental results on UCI datasets indicate that the proposed method outperforms the other methods.},
}

