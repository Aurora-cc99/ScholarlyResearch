@misc{tong_zhang_2b5a8b83c01e,
  title = {EEG Sequence Dependencies Learning With Fine-grained Sleep Transition Graph for Sleep Stage Classification, 2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM), Lisbon, Portugal, 2024, pp. 3485-3490, doi: 10.1109/BIBM62325.2024.10822164.(*Corresponding Author, EI)},
  author = {Jingxin Liang and C.L. Philip and Yuebin Xu and Tong Zhang},
  year = {2024},
  doi = {10.1109/BIBM62325.2024.10822164},
  url = {https://doi.org/10.1109/BIBM62325.2024.10822164},
  howpublished = {IEEE International Conference on Bioinformatics and Biomedicine (BIBM)},
  annotation = {中文辅助译名：用于睡眠阶段分类的细粒度睡眠转换图的脑电图序列依赖性学习，2024 年 IEEE 国际生物信息学会议生物医学 (BIBM)，里斯本，葡萄牙，2024 年，第 3485-3490 页，doi: 10.1109/BIBM62325.2024.10822164.(*通讯作者，EI)},
  abstract = {Sleep stage classification assists in evaluating sleep quality and diagnosing sleep disorders. Existing methods based on spatial-temporal graph convolutional networks (STGCNs) have shown excellent performance in recognizing sleep stages. However, current works learn transition dependencies in sleep sequence in a coarse manner and restrict the modeling of brain activity to a significantly brief period. To address the above issues, we propose a fine-grained sleep transition graph (FSTG) method to learn EEG sequence dependencies for sleep stage classification in this paper. Specifically, the novel sleep transition graph (STG) constructor (STG-C) is proposed to model sleep sequence transition dependencies in a more fine-grained manner, extracting effective auxiliary information from sleep contextual sequences for sleep staging. In the STG-C, we initially explore brain connectivity over extended sleep temporal scales, utilizing the graph fusion mechanism (GFM) to learn the multiple temporal correlations of brain channels. Furthermore, to better capture dependencies of sleep sequence, a skip-gated STGCN (SG-STGCN) is designed as the strong STG sequence learner. The proposed FSTG model achieves state-of-the-art performance in public sleep staging datasets, ISRUC-S3 and ISRUC-S1. Additionally, visualization experiments demonstrate the effectiveness and interpretability of FSTG in sleep staging classification.},
}

@misc{tong_zhang_af68872f65cbfcb8,
  title = {Multi-Granularity Temporal-Spectral Representation Learning for Speech Emotion Recognition},
  author = {Zhichen Yuan and C. L. Philip Chen and Shuzhen Li and Tong Zhang},
  year = {2024},
  doi = {10.1109/SMC54092.2024.10831974},
  url = {https://doi.org/10.1109/SMC54092.2024.10831974},
  howpublished = {SMC},
  annotation = {中文辅助译名：用于语音情感识别的多粒度时谱表示学习},
  abstract = {Speech emotion recognition (SER) captures emotional information from speech signals to recognize users' emotional states, which plays a crucial role in conversational human-computer interaction. Most SER researches focus on ex-ploiting emotional information from global temporal or spectral features, but it may neglect detailed emotion-related information such as phonemes and syllables. To address this problem, this paper proposes a multi-granularity temporal-spectral representation learning (MG-TSRL) network for speech emotion recognition tasks. Specifically, MG-TSRL extracts different temporal features in phonetic, syllabic, and sentential granular-ity from spectrograms to retain more detailed emotional-related information. It then designs multilayer emotion-aware units to capture emotion-related frequency patterns and obtain deep spectrum features at each temporal granularity feature. MG-TSRL further introduces a fast broad learning system and feeds deep temporal-spectral features to it to obtain more accurate emotions. MG-TSRL gradually achieves effective temporal-spectral representation learning through multi-granularity temporal features and multilayer frequency pattern learning. The state-of-the-art results on the CASIA, RAVDESS, and SAVEE datasets are respectively 95.17%, 92.78%, and 87.50% in unweighted accuracy, demonstrating the effectiveness of MG-TSRL in speech emotion recognition.},
}

