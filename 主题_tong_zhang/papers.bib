  author = {Bin Wang and Zheng Lv and Jinwei Zhao and Xiaofan Wang and Tong Zhang},
  year = {2016},
  doi = {10.1109/cis.2016.0041},
  url = {https://doi.org/10.1109/cis.2016.0041},
  howpublished = {International Conference on Computational Intelligence and Security (CIS)},
  annotation = {中文辅助译名：基于MapReduce模型的自适应分散质心K-Means算法},
  abstract = {K-means is a clustering algorithm which is used widely. Its clustering results heavily depend on the initial centroids. An adaptive method for disperse centroids is proposed to improve the stability and accuracy of the clustering result. The Adaptively Disperse Centroids K-means Algorithm (ADC-K-means) is implemented using MapReduce model on hadoop platform, and it is compared with the k-means of Mahout which is a sub-project of hadoop. The experimental result shows that proposed algorithm is effective.},
}

@misc{tong_zhang_9086fd3d1ff1014b,
  title = {Balanced COD-CLARANS: A Constrained Clustering Algorithm to Optimize Logistics Distribution Network},
  author = {Tong Zhang and Dong Wang and Haonan Chen},
  year = {2016},
  doi = {10.2991/aiie-16.2016.33},
  url = {https://doi.org/10.2991/aiie-16.2016.33},
  howpublished = {International Conference on Artificial Intelligence and Industrial Engineering (AIIE)},
  annotation = {中文辅助译名：平衡COD-CLARANS：优化物流配送网络的约束聚类算法},
  abstract = {In this paper, we focus on the problem of the siting of distribution stations, which is of key importance during designing a logistics distribution network.This problem includes dealing with physical obstacles in real world, making the orders as close as possible to their respective stations and making the workload of each station as balanced as possible.To solve this problem, we use a dataset of the geographical coordinates of all orders of a certain express company per day in Shanghai, and propose an algorithm called Balanced COD-CLARANS, which is a constrained clustering algorithm capable of handling physical obstacles and balance factor and outputting a set of clusters for decision-making.Besides, we design the experiment to prove that Balanced COD-CLARANS works well.},
}

