@misc{tong_zhang_cd1e0e2e37ae094b,
  title = {Five-Minute Rule 40 Years Later: A First-Principles Revisit for Modern Memory Hierarchy},
  author = {Tong Zhang and Vikram Sharma Mailthody and Fei Sun and Linsen Ma and Chris J. Newburn and Teresa Zhang and Yang Liu and Jiangpeng Li and Hao Zhong and Wen‐mei Hwu},
  year = {2026},
  doi = {10.1109/isca66397.2026.00031},
  url = {https://doi.org/10.1109/isca66397.2026.00031},
  howpublished = {Proceedings - International Symposium on Computer Architecture/Proceedings},
  annotation = {中文辅助译名：40 年后的五分钟规则：现代内存层次结构第一原理重温},
  abstract = {In 1987, Jim Gray and Gianfranco Putzolu introduced the five-minute rule, a simple, storage-memory-economics-based heuristic for deciding when data should live in DRAM rather than on storage. Subsequent revisits to the rule largely retained that economics-only view, leaving host costs, feasibility limits, and workload behavior out of scope. This paper revisits the rule from first principles, integrating host costs, DRAM bandwidth/capacity, and physics-grounded models of SSD performance and cost, and then embedding these elements in a constraint- and workload-aware framework that yields actionable provisioning guidance. We show that, for modern AI platforms, especially GPU-centric hosts paired with ultra-high-IOPS SSDs engineered for fine-grained random access, the DRAM$\leftrightarrow$flash caching threshold collapses from minutes to a few seconds. This shift reframes NAND flash memory as an \emphactive data tier and exposes a broad research space across the hardware-software stack. We further introduce MQSim-Next, a calibrated SSD simulator that supports validation and sensitivity analysis and facilitates future architectural and system research. Finally, we present two concrete case studies that showcase the software system design space opened by such memory hierarchy paradigm shift. Overall, we turn a classical heuristic into an actionable, feasibility-aware analysis and provisioning framework and set the stage for further research on AI-era memory hierarchy.},
}

@misc{tong_zhang_7c71ba2932c7,
  title = {Deep Reinforcement Learning With Trajectory-Guided Masked Diffusion Policy for Active Suspension Control},
  author = {Keyao Chang and Shiyuan Han and Xiaofang Zhong and Jin Zhou and Tong Zhang and C. L. Philip Chen},
  year = {2026},
  doi = {10.1109/tii.2026.3730227},
  url = {https://doi.org/10.1109/tii.2026.3730227},
  howpublished = {IEEE Transactions on Industrial Informatics},
  annotation = {中文辅助译名：采用轨迹引导屏蔽扩散策略的深度强化学习，用于主动悬架控制},
  abstract = {Deep reinforcement learning (DRL) is driving a significant transition in active suspension control from model-driven to data-driven approaches by virtue of its strong environmental adaptability and online learning capabilities. Concurrently, rapid advancements in onboard sensing and electronic chassis technologies have enabled the integration of road preview information as a critical input for state-of-the-art suspension control strategies. However, conventional DRL policies face challenges in effectively capturing the complex action distributions that arise from the combined influence of suspension states and road elevation profiles, thereby constraining further enhancements in control performance. To address this challenge, this article proposes an online DRL framework with trajectory-guided masked diffusion policy, which designs a diffusion model as the policy representation to harness its superior capability in modeling intricate probability distributions. Specifically, a mask reconstruction mechanism is embedded within the decision-making process to enable the learned policy to obtain more effective joint representations of suspension dynamics and road elevation profiles. Moreover, a diffusion trajectory guidance strategy is developed that tightly couples diffusion sampling trajectories with action-value estimation, thereby enhancing the exploration efficiency during online reinforcement learning while simultaneously ensuring the generation of high-quality control action},
}

