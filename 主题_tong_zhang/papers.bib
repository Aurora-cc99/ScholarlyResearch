@misc{tong_zhang_c6d031d1d01cca21,
  title = {Facial Expression Recognition via Broad Learning System},
  author = {Tong Zhang and Zhulin Liu and Xuehan Wang and Xiao-Fen Xing and C. L. Philip Chen and Enhong Chen},
  year = {2018},
  doi = {10.1109/SMC.2018.00328},
  url = {https://doi.org/10.1109/SMC.2018.00328},
  howpublished = {SMC},
  annotation = {中文辅助译名：通过广泛的学习系统进行面部表情识别},
  abstract = {In recent years, research on facial expression recognition (FER) has become an increasingly active research topic. Deep learning is a new area, which gives a new way to classify images of human faces into emotion categories. However, it faces many difficulties caused by poor robustness and real-time performance. This paper designs a new architecture network based on Broad Learning System (BLS) for facial expressions recognition. It is established as a flat network. The original inputs are transferred and placed as mapped features in feature nodes, while the structure is expanded in wide sense in the enhancement nodes. To evaluate our architecture we tested the proposed method with the Extended Cohn-Kanade Dataset (CK+). The experimental results show that the BLS approach is very effective in facial expression recognition to compare with convolutional neural networks.},
}

@misc{tong_zhang_51756c101d10cf04,
  title = {A method of educational news classification based on emotional dictionary},
  author = {Bin Wang and Lmli Gao and Tao An and Mei Meng and Tong Zhang},
  year = {2018},
  doi = {10.1109/ccdc.2018.8407737},
  url = {https://doi.org/10.1109/ccdc.2018.8407737},
  howpublished = {Chinese Control and Decision Conference (CCDC)},
  annotation = {中文辅助译名：一种基于情感词典的教育新闻分类方法},
  abstract = {Aiming at the problem of educational news classification, this paper proposes a method of educational news classification based on emotional dictionary. This paper takes educational news as the application background. First, this paper summarizes the common sentiment dictionary and the education-related sentiment words of manually arranged. Then, this paper uses the Laplace smoothing SO-PMI algorithm to expand the emotional dictionary of educational news. Finally, the whole news is divided into several clauses, from which emotional key words in education news is required by combining emotional dictionary, and calculate the weights of each clause according to corresponding rules and get the weights sum of each clause, and we get the emotional tendencies of the whole education news in order to identify the positive and negative classification of educational news. Experimental results show that the method of educational news classification based on emotional news has higher precision and recall rate.},
}

