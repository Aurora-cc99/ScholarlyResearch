@misc{tong_zhang_7b4bf46e1c1b,
  title = {An Efficient Inspection System Based on Broad Learning: Nondestructively Estimating Cement Compressive Strength With Internal Factors},
  author = {Jifeng Guo and Zhulin Liu and C. L. Philip Chen and Tong Zhang and Lin Wang and Kaipeng Fan},
  year = {2022},
  doi = {10.1109/tii.2021.3110517},
  url = {https://doi.org/10.1109/tii.2021.3110517},
