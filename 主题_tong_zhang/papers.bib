  author = {Haoqi Yuan and Zhixuan Liang and Anzhe Chen and Ye Wang and Haoyang Li and Pei Lin and Yiyang Huang and Zixing Lei and Tong Zhang and Jiazhao Zhang and Jie Zhang and Jingyang Fan and Gengze Zhou and Qihang Peng and Chenxu Lv and Xiaoyue Chen and An Yang and Fei Huang and Junyang Lin and Dayiheng Liu and Jingren Zhou and Chenfei Wu and Xiong-Hui Chen},
  year = {2026},
