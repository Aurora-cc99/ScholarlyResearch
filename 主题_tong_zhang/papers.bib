@misc{tong_zhang_8d8f42ab5f0ad013,
  title = {Research on Turnout Fault Diagnosis Model Based on GADF-CNN-MAML},
  author = {Lang Du and Sheng Liu and Ting Cao and Tong Zhang},
  year = {2024},
  doi = {10.1109/icaice63571.2024.10863959},
  url = {https://doi.org/10.1109/icaice63571.2024.10863959},
  howpublished = {International Conference on Artificial Intelligence and Computer Engineering (ICAICE)},
  annotation = {中文辅助译名：基于GADF-CNN-MAML的道岔故障诊断模型研究},
  abstract = {As a crucial component in the railway transportation system, the implementation of regular maintenance and fault detection on turnout equipment not only prevents potential operational risks but also ensures the smooth operation of the railway network. Currently, intelligent fault diagnosis for turnouts is mostly based on deep learning models, which possess strong capabilities for fault signal feature extraction and accurate identification. However, under conditions of scarcity in fault data, the performance of these models declines, resulting in low diagnostic accuracy. To address the shortcomings of these models, this paper leverages the advantages of meta-learning algorithms in addressing small-sample issues and focuses on the power curve of the ZD7 turnout switch machine. It applies the Model-Agnostic Meta-Learning (MAML) algorithm to Convolutional Neural Networks (CNN) and employs Gramian Angular Difference Field (GADF) encoding to convert the one-dimensional time-series power curve of the turnout switch machine into two-dimensional feature maps. A turnout fault diagnosis model based on GADF-CNN-MAML is proposed, and experiments have verified that this model effectively improves the accuracy of fault diagnosis.},
}

@misc{tong_zhang_be03075c59dad63b,
  title = {A Cascade Active Disturbance Rejection Control Method Based on SPSA Online Optimization for SCR Denitration System},
  author = {Wei Ai and Yang Wang and Tong Zhang and Xiangyang Li},
  year = {2024},
  doi = {10.1109/ddcls61622.2024.10606679},
  url = {https://doi.org/10.1109/ddcls61622.2024.10606679},
  howpublished = {IEEE Data Driven Control and Learning Systems Conference (DDCLS)},
  annotation = {中文辅助译名：基于SPSA在线优化的SCR脱硝系统级联自抗扰控制方法},
  abstract = {Due to the characteristics of large inertia, significant lag, and model uncertainty in the Selective Catalytic Reduction (SCR) denitrification system, traditional control schemes encounter challenges in achieving precise control. To tackle this issue, this paper proposes an IMC cascade self-adaptive disturbance rejection controller based on SPSA online parameter optimization and applies it to the SCR denitrification control system. This approach effectively addresses the challenges of precise setpoint tracking, disturbance suppression due to model variations, and difficulties in controlling significant lag. The introduction of the SPSA algorithm allows the controller to update optimal parameters in real-time as the operating conditions change over time. Experimental results from setpoint tracking and disturbance rejection demonstrate that the proposed approach outperforms traditional PID control and linear self-adaptive disturbance rejection control.},
}

