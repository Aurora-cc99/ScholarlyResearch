@misc{panorama_tianjiang_wang_fef277f3d873,
  title = {A Hybrid EEG-EMG System for Brain-Computer Interface-Based Unmanned Aerial Vehicle Control},
  author = {Ting Wang and Lei Cao and Yan Huang and Yilin Dong},
  year = {2026},
  doi = {10.1109/icaace69793.2026.11509238},
  url = {https://doi.org/10.1109/icaace69793.2026.11509238},
  howpublished = {2026 9th International Conference on Advanced Algorithms and Control Engineering (ICAACE)},
  annotation = {中文辅助译名：基于脑机接口的无人机控制的脑电-肌电混合系统},
  abstract = {Reliable and intuitive control of unmanned aerial vehicles (UAVs) remains a major challenge for brain-computer interface (BCI) systems, particularly in dynamic real-world environments. Steady-state visually evoked potential (SSVEP) based BCI has high precision, however, it may cause visual tiredness; while Electromyography (EMG) provides additional information of motor related signals which can improve the adaptability of the performance for BCI especially on the dynamic tasks. Therefore, this hybrid BCI protocol provides a reliable framework for UAV control by integrating the two physiological Electroencephalography (EEG) and EMG signals. The evaluation experiment indicated that hybrid EEG-EMG control obtained higher accuracy than unimodal methods, and the errors caused by the incorrect perception can be decreased.},
}

@misc{panorama_tianjiang_wang_ed23460b061ad005,
  title = {Backing Design for Coil-only EMAT using Nickel-powder Epoxy Composite},
  author = {Yini Song and Kai WANG and Yiru Xiao and Jun Tu and Bo Feng and Yihua Kang},
  year = {2026},
  doi = {10.58286/32917},
  url = {https://doi.org/10.58286/32917},
  howpublished = {e-Journal of Nondestructive Testing},
  annotation = {中文辅助译名：使用镍粉环氧复合材料的纯线圈 EMAT 背衬设计},
  abstract = {Coil-only magnetostrictive Lamb-wave detection employs a nickel sheet both as the waveguide and as an integral part of the ultrasonic excitation structure, but this configuration often produces multiple echo pulses that obscure interpretation. To mitigate unwanted reflections, we coated the nickel substrate with 5 mm-wide strips of nickelpowder epoxy composite at the excitation edge. For direct comparison, we applied pure epoxy strips of identical width at the same locations. Following band-pass filtering and baseline correction, we computed the RMS energy within the reflection window. Energy absorption ratios relative to an uncoated control show that the nickel-powder composite attenuates Lamb-wave energy two to three times more effectively than pure epoxy. Viscoelastic damping in the epoxy resin combined with scattering at metal–polymer interfaces drives this enhanced dissipation. These results clarify the key absorption mechanisms and inform the design of high-efficiency backing materials for Lamb-wave transduction in thin plates.},
}

