@misc{panorama_ef5ed70a98c0_7cbf760468f4714f,
  title = {Compact Video Code and Its Application to Robust Face Retrieval in TV-Series},
  author = {Yan Li and Ruiping Wang and Zhen Cui and Shiguang Shan and Xilin Chen},
