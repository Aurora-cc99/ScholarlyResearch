@misc{gao_xiaorong_2982a57ccbf0e07b,
  title = {A BCI-based environmental controller for the motion-disabled},
  author = {Xiaorong Gao and Dingfeng Xu and Ming Jen Cheng and Shangkai Gao},
  year = {2003},
  doi = {10.1109/tnsre.2003.814449},
  url = {https://doi.org/10.1109/tnsre.2003.814449},
  howpublished = {IEEE Transactions on Neural Systems and Rehabilitation Engineering},
  annotation = {中文辅助译名：针对运动障碍人士的基于 BCI 的环境控制器},
  abstract = {With the development of brain-computer interface (BCI) technology, researchers are now attempting to put current BCI techniques into practical application. This paper presents an environmental controller using a BCI technique based on steady-state visual evoked potential. The system is composed of a stimulator, a digital signal processor, and a trainable infrared remote-controller. The attractive features of this system include noninvasive signal recording, little training requirement, and a high information transfer rate. Our test results have shown that this system can distinguish at least 48 targets and provide a transfer rate up to 68 b/min. The system has been applied to the control of an electric apparatus successfully.},
}

@misc{gao_xiaorong_6e4eeb5d36678577,
  title = {A new calibration method in 3D ultrasonic imaging system},
  author = {Jie Liu and Xiaorong Gao and Zhiguang Zhang and Shangkai Gao and Jinghao Zhou},
  year = {2002},
  doi = {10.1109/iembs.1998.745567},
  url = {https://doi.org/10.1109/iembs.1998.745567},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：3D超声成像系统中的一种新标定方法},
  abstract = {The authors' three-dimensional (3D) ultrasonic imaging system is constructed from a B-Mode ultrasound scanner, a magnetometer-based position and orientation measurement system (Flock of Birds), and a personal computer. To accurately determine the relationship between the magnetic receiver and the image plane, the authors propose a new calibration method which determines the system calibration parameters by measuring a triangular pyramid phantom. The new method not only reduces the effect of the thickness and divergence of the ultrasound beam, but also improves the efficiency of the algorithm.},
}

