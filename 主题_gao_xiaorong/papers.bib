@misc{gao_xiaorong_bb6548d57aed,
  title = {A similarity calculation model of road network and its application in map generalization quality evaluation},
  author = {Tianshu Chu and Haowen Yan and Pengbo Li and Xiaomin Lu and Xiaorong Gao},
  year = {2024},
  doi = {10.1080/13875868.2023.2234074},
  url = {https://doi.org/10.1080/13875868.2023.2234074},
  howpublished = {Spatial Cognition and Computation},
  annotation = {中文辅助译名：路网相似度计算模型及其在地图综合质量评价中的应用},
  abstract = {As an important part of maps, road networks have always been the focus of research in map generalization. However, the fully automated quality evaluation of road network generalization has not been implemented. This paper proposes a framework of Sample-Map database to evaluate road network generalization quality using spatial similarity measures. The similarity calculation model considers spatial distribution, topological relations, and distance relations of road networks. A Sample-Maps database is created as an evaluation set for different road network types. The method is tested on multi-scale maps from Shenzhen, China, and validated by psychological cognition experiments and professional cartographers’ judgment.},
}

@misc{gao_xiaorong_672b95b449a41191,
  title = {Time-varying EEG networks of major depressive disorder during facial emotion tasks},
