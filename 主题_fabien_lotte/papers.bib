@misc{fabien_lotte_c826e287a74dd456,
  title = {Impact of background sound and visual cost on active brain computer interface performance and user experience},
  author = {Pauline Dreyer and Nawfel Belcaid and Raphaëlle N. Roy and Fabien Lotte},
  year = {2026},
  url = {https://hal.science/hal-05771439v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：背景声音和视觉成本对主动脑机接口性能和用户体验的影响},
  abstract = {Active brain computer interfaces (aBCIs) are increasingly investigated for ecological applications such as gaming, rehabilitation, and telepresence, where users may be exposed to continuous environmental sounds. However, whether such background sound affects BCI control itself, or only the subjective experience of using it, remains unclear. This study investigated the effect of continuous background sound on online BCI performance and user experience while accounting for individual susceptibility to auditory distraction. Thirteen participants completed one session that involved three mental tasks (kinesthetic motor imagery, mental arithmetic, and word association) under two experimental conditions, with and without background sound. Online classification performance, sleepiness, visual fatigue, workload, and engagement were assessed over four online runs. Mixed-effects models showed no significant effect of background sound, susceptibility to auditory distraction, their interaction, or hearing sensitivity on online BCI performance. However, sleepiness increased and engagement decreased over successive runs, and, more importantly, reported engagement was significantly lower in the background sound condition. Condition by auditory distraction susceptibility interactions were observed for workload and engagement, although these interactions were sensitive to participant exclusion. Overall these findings indicate that a moderate continuous background sound may alter users' subjec},
}

@misc{fabien_lotte_14c5796699779018,
  title = {Dreyer et al. 2023 — A large EEG database with users' profile information for motor imagery brain-computer interface research},
  author = {Pauline Dreyer and Aline Roc and Léa Pillette and Sébastien Rimbert and Fabien Lotte},
  year = {2026},
  doi = {10.82901/nemar.nm000250},
  url = {https://doi.org/10.82901/nemar.nm000250},
  howpublished = {UC San Diego},
  annotation = {中文辅助译名：德雷尔等人。 2023 年——一个包含用户个人资料信息的大型脑电图数据库，用于运动想象脑机接口研究},
  abstract = {A comprehensive EEG database containing electroencephalographic signals from 87 healthy participants performing motor imagery brain-computer interface tasks. The dataset comprises over 20,800 trials (~70 hours of recording) organized into three datasets (A, B, C) using a standardized Graz protocol for right and left hand motor imagery. In addition to raw EEG signals, the database includes detailed participant demographics, personality profiles, cognitive traits, and BCI performance metrics, enabling research on user-performance relationships, cross-user machine learning algorithms, and profile-informed signal classification.},
}

@misc{fabien_lotte_09c96cb1fb82cd85,
  title = {Toward a systematic review of collaborative tasks in EEG hyperscanning studies},
  author = {Juliette Meunier and Sébastien Rimbert and Arnaud Prouzeau and Fabien Lotte},
  year = {2026},
  url = {https://hal.science/hal-05634609v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：对脑电图超扫描研究中的协作任务进行系统回顾},
  abstract = {Hyperscanning allows recording multiple brains simultaneously and is increasingly used to study the neural mechanisms involved in collaboration, notably through measures of inter-brain synchrony (IBS). However, collaborative work can take different forms depending on the task being performed, making it difficult to compare results across studies. McGrath (1984) proposed a taxonomy of collaborative tasks to characterize different forms of group work; however, this framework is rarely considered in electroencephalography (EEG) hyperscanning studies. Therefore, we aim to review EEG hyperscanning studies on collaborative tasks and to propose their classification within McGrath’s taxonomy. We conducted a systematic review following PRISMA methodology, with 126 articles selected after screening. We aim to correlate the IBS with task types, as well as link it to behavioral data corresponding to collaboration information. We will also address the challenge of running multi-subject experiments.},
}

@misc{fabien_lotte_a34196868e36ed05,
  title = {One-Class Riemannian Wrapped Gaussian classifier for EEG-based BCI: application to anesthetic state detection},
  author = {Valérie Marissens Cueva and Thibault de Surrel and Laurent Bougrain and Seyed Javad Bidgoli and Guy Chéron and Ana Maria Cebolla Alvarez and Claude Meistelman and Fabien Lotte and Florian Yger and Sébastien Rimbert},
  year = {2026},
  url = {https://hal.science/hal-05634437v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：基于脑电图 BCI 的一类黎曼包裹高斯分类器：在麻醉状态检测中的应用},
  abstract = {Brain-computer interfaces (BCIs) based on ElectroEncephaloGraphy (EEG) often represent brain signalsas covariance matrices and leverage Riemannian geometry for mental states classification. However, currentapproaches require multiple classes for training. In many applications, such as intraoperative monitoring ofconsciousness during anesthesia, only data from one class, like the awake state, may be available, requiringone-class classificationmethods [1]. In this context, the idea is to differentiate EEG responses recorded in awakepatients from those observed under altered brain dynamics induced by general anesthesia. Ultimately, thisparticular framework aims to contribute to the detection of intraoperative awareness by identifying potentialmotor activity from the anesthetized patient. This setting naturally defines a one-class problem, as only thereference condition can be collected preoperatively for patient-specific calibration.},
}

@misc{fabien_lotte_a4fe6227de4e1864,
  title = {Tools, Challenges and Opportunities to Address Intra-and Inter-User Variability in EEG-based BCIs},
  author = {Fabien Lotte and Simon Kojima and Niklas Kueper and Pauline Dreyer and Rafael Math and Mansi Sharma and Raphaëlle N. Roy and Sébastien Rimbert and Marc Tabie and Maurice Rekrut},
  year = {2026},
  url = {https://hal.science/hal-05668969v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：解决基于脑电图的 BCI 中用户内和用户间差异的工具、挑战和机遇},
  abstract = {Brain-Computer Interfaces (BCI), which translate brain signals (typically electroencephalography -EEG) into control commands for computers, are promising for many applications, e.g., neurorehabilitation or assistive technologies. However, they suffer from strong variabilities of performance, both interusers and intra-users (e.g., across sessions or days), which limit their applicability in practice. To contribute to better research and methods to address these variabilities, this paper proposes an overview of current knowledge about these variabilities and about machine learning & signal processing (ML/SP) tools to tackle them. We notably review the factors explaining these variabilities (e.g., users' cognitive skills or mental states), the metrics to quantify them, and various ML/SP tools to tackle them, including adaptive classifiers or emerging foundation models. This paper then identifies a number of promising directions to better understand and tackle BCI variabilities, including the need to better understand their causes and neurophysiological effects and the need for dedicated databases to be able to do so.},
}

@misc{fabien_lotte_6227537faa10ea0b,
  title = {Quantifying Event-Related (De)Synchronization Variability for Brain-Computer Interface: A Unified and Interpretable Framework},
  author = {Simon Kojima and Fabien Lotte},
  year = {2026},
  doi = {10.48550/arxiv.2607.21119},
  url = {https://arxiv.org/abs/2607.21119},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：量化脑机接口的事件相关（去）同步变异性：一个统一且可解释的框架},
  abstract = {Objective: Brain-Computer Interfaces (BCIs) enable the control of external devices by decoding user intentions from electroencephalography (EEG). However, substantial EEG variability within and between users remains a major challenge. To better understand this variability, we propose interpretable metrics that independently quantify temporal, spatial, and frequency variability in BCI related brain activity within and between users. Methods: We propose a framework to quantify variability by extracting EEG features and defining variability as their dispersion around their centroid using appropriate distance functions. Using two motor imagery BCI datasets (N = 133 users), we investigated the relationship between BCI performance and the variability metrics through within-user and cross-user classification experiments. Results: Negative correlations of -0.2 to -0.4 were observed across most conditions, suggesting that lower variability is associated with higher BCI performance. Moreover, the metrics revealed differences in robustness to variability between the deep learning and Riemannian-based classifiers, with the former showing weaker correlations. Conclusion: The results demonstrate the effectiveness of the proposed variability metrics and suggest that reducing variability may improve BCI performance while revealing differences in the sensitivity of classification models to different types of variability. Significance: The framework quantifies temporal, spatial, and frequency },
}

