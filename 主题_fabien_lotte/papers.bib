@misc{fabien_lotte_11af50561219c4bf,
  title = {Classifying EEG for brain computer interfaces using Gaussian processes},
  author = {Fabien Lotte and Mingjun Zhong and Anatole Lécuyer and Mark A. Girolami},
  year = {2008},
  doi = {10.1016/J.PATREC.2007.10.009},
  url = {https://doi.org/10.1016/J.PATREC.2007.10.009},
  howpublished = {Pattern Recognit. Lett.},
