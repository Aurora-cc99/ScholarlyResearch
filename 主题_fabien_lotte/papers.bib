@misc{fabien_lotte_7eb817b383227e4b,
  title = {Generative Augmentation for EEG Motor Imagery Classification: A Class-Conditional VAE with Cycle-Consistent Decoder Refinement},
  author = {Florian Yger and Matei Moldoveanu and Claire Ben Ali and Alain Sirois and Fabien Lotte},
  year = {2026},
  doi = {10.48550/ARXIV.2607.22733},
  url = {https://doi.org/10.48550/ARXIV.2607.22733},
  howpublished = {CoRR},
  annotation = {中文辅助译名：EEG 运动意象分类的生成增强：具有周期一致解码器细化的类条件 VAE},
  abstract = {We investigate whether a generative model can supply useful synthetic motor-imagery (MI) electroencephalography (EEG) trials that improve the accuracy of independent downstream classifiers. We train a class-conditional variational autoencoder (CVAE) with an integrated latent classifier on the Zhou motor-imagery dataset, using the learned per-class prior as a generator: sampling the prior for a given label and decoding it into a synthetic, label-consistent signal. A constraint on the covariance matrix of the generated data encourages preservation of covariance structure, and the model is trained with a schedule that alternates ordinary VAE training with a decoder-focused phase that sharpens the generative pathway used for augmentation. We measure the effect of adding synthetic trials to the training set under two evaluation protocols -- within-user (pooled 60/20/20 split across subjects) and cross-user (leave-one-subject-out, LOSO) -- across four representative EEG classification pipelines: Common Spatial Patterns with Linear Discriminant Analysis (CSP+LDA), tangent-space features with a Support Vector Machine (TGSP+SVM), Minimum Distance to Riemannian Mean (MDM), and a neural network based on EEGNetv4 (henceforth EEGNet). Results are aggregated across independent augmentation draws, random seeds (within-user), or leave-one-subject-out folds (cross-user), with uncertainty reported as 95\% confidence intervals (Student's $t$-distribution) computed over per-seed/per-fold average},
}

@misc{fabien_lotte_48c208a3e76d7ba1,
  title = {Visual cues in MI-BCI induce biases in EEG classification models with deep learning but not with standard machine learning},
  author = {David Trocellier and Simon Kojima and Bernard N’Kaoua and Fabien Lotte},
  year = {2026},
  doi = {10.3389/fnrgo.2026.1804143},
  url = {https://doi.org/10.3389/fnrgo.2026.1804143},
  howpublished = {Frontiers in Neuroergonomics},
  annotation = {中文辅助译名：MI-BCI 中的视觉线索会导致深度学习脑电图分类模型产生偏差，但标准机器学习不会产生偏差},
  abstract = {Objective: Deep learning classification methods are increasingly popular in the brain-computer interface (BCI) field due to their ability to learn complex, non-linear representations from EEG data. Unlike traditional machine learning approaches, which typically rely on hand-crafted features, deep learning models autonomously extract spatio-temporal features directly from the raw or minimally preprocessed signal. However, this flexibility may come at the cost of reduced interpretability and increased susceptibility to confounding factors. This study aims to investigate whether the inclusion of task-related visual cues in the input EEG window biases deep learning models by leading them to exploit irrelevant features, thereby compromising their neurophysiological validity. Approach: This study investigates how including EEG signals measured during visual cue presentation on classification accuracy and feature extraction in motor imagery (MI)-based BCIs. Three classification pipelines were evaluated: CSP+LDA, a traditional machine learning approach; DeepConvNet, a convolutional neural network for EEG classification; and REVE, a Transformer-based EEG foundation model. All methods are trained and tested on two large scale open-access EEG datasets using two epoching strategies, with or without including the visual cue onset, to assess their impact on model performance and neurophysiological relevance. Attribution maps (e.g., Saliency maps) and CSP patterns are used to interpret the },
}

