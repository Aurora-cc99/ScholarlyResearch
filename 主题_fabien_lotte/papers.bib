@misc{fabien_lotte_bc0f591026452348,
  title = {Tracking anesthetic depth with Median Nerve Stimulation-evoked Riemannian EEG features in a clinical setting},
  author = {Valérie Marissens Cueva and Wael El Hage Sleiman and Laurent Bougrain and Fabien Lotte and Guy Chéron and Ana Maria Cebolla Alvarez and Claude Meistelman and Sébastien Rimbert and Seyed Javad Bidgoli},
  year = {2026},
  url = {https://hal.science/hal-05677420v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：在临床环境中利用正中神经刺激诱发的黎曼脑电图特征追踪麻醉深度},
  abstract = {Accidental awareness during general anesthesia (AAGA) is defined as an unexpected return of consciousness during surgery. Despite advances in monitoring, its incidence remains stable, underscoring the need for improved techniques. The Patient State Index (PSI), derived from frontal electroencephalography (EEG), is a common clinical measure of anesthesia depth but is sensitive to electromyographic (EMG) artifacts. In paralyzed patients receiving neuromuscular blocking agents, motor signs of awareness are suppressed, making EEG-based brain-computer interfaces (BCIs) a promising approach to detect motor intentions independently of peripheral output. We propose a novel BCI based on median nerve stimulation (MNS) to detect potential movement attempts. MNS-evokedEEG responses recorded in the awake state define a subject-specific reference. During surgery, ongoing EEG responses to MNS are continuously compared with this awake reference using Riemannian distances computed on EEG covariance matrices. Deviations from the awake pattern are investigated as markers of anesthetic depth, possibly reflecting propofol-related cortico-subcortical decoupling.},
}

@misc{fabien_lotte_5f3f64d6c46c1c08,
  title = {Influence of Median Nerve Stimulation Intensity on ERD/ERS, BCI Performance and User Experience},
  author = {Loïc Bechon and Fabien Lotte and Stéphanie Fleck and Sébastien Rimbert},
  year = {2026},
  doi = {10.3217/978-3-99161-093-9-077},
  url = {https://hal.science/hal-05769138v1},
  howpublished = {HAL},
  annotation = {中文辅助译名：正中神经刺激强度对 ERD/ERS、BCI 性能和用户体验的影响},
  abstract = {Median Nerve Stimulation (MNS) has recently emerged as a promising approach to enhance Motor Imagery (MI)based Brain-Computer Interfaces (BCIs) by providing additional somatosensory input that modulates sensorimotor rhythms. While previous studies have shown that MNS interacts with MI-related activity and can improve BCI performance, the influence of stimulation intensity on the resulting cortical patterns remains largely unexplored. In this study, we investigate how different MNS intensities affect ERD/ERS patterns, offline classification performance, and user experience (UX) with these stimulations. Thirteen participants performed right-hand motor imagery while receiving three stimulation levels relative to their motor threshold: low (below threshold), medium (twitch-inducing), and high (above threshold). Results show similar ERD/ERS patterns across stimulation intensities and no significant differences in classification accuracy. Participants reported very low levels of discomfort associated with the MNS. These findings suggest that relatively low-intensity MNS is sufficient to elicit detectable sensorimotor responses while improving user comfort, supporting the design of more usable MNS-based BCI systems. This opens the possibility of using MNS at the lowest effective level, which is particularly beneficial from a user experience perspective for prolonged BCI interaction.},
}

