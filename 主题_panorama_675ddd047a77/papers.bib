@misc{panorama_675ddd047a77_2fc23c6ebf215875,
  title = {Differential Evolution with Cloud Model Based Self-adaptive Crossover Strategy},
  author = {Xiaojun Bi and Liu Guo-an and Jing Xiao},
  year = {2012},
  doi = {10.1109/icetce.2012.230},
  url = {http://dl.acm.org/citation.cfm?id=2373875},
  howpublished = {International Conference on Electric Technology and Civil Engineering},
  annotation = {中文辅助译名：基于云模型的差分进化自适应交叉策略},
  abstract = {Efficiency of the evolutionary algorithms (EAs) is strongly dependent on the parameter setting. Differential evolution (DE) is well known as a simple and efficient evolutionary algorithm over continuous spaces. Of the three main parameters which control DE's behavior-population size NP, scaling factor F and crossover rate CR-CR is the most important. Despite the important role CR plays in effecting the performance of DE there are few studies that have examined the adaptive or self-adaptive strategies of CR. This paper is aim to investigate the influence of CR on the behavior of DE both from a theoretical and numerical point of view. In addition, a novel self-adaptive scheme for the evolution of CR based on a cloud model is proposed to enhance the convergence performance of DE. Experimental results confirm the superiority of the new scheme over several state-of-the-art self-adaptive DE versions.},
}

@misc{panorama_675ddd047a77_d8bfe65e29581def,
  title = {On Chaos Character of Dynamic Fuzzy Neural Network},
  author = {Mo Tang and Kejun Wang and Xiaojun Bi},
  year = {2011},
  doi = {10.1109/cso.2011.183},
  url = {https://doi.org/10.1109/cso.2011.183},
  howpublished = {International Joint Conference on Computational Sciences and Optimization (CSO)},
  annotation = {中文辅助译名：动态模糊神经网络的混沌特性研究},
  abstract = {The chaos character of dynamic fuzzy neural network is further explored and analyzed in this paper applying the traditional Lyapunov exponent method. Firstly, the working principle of dynamic fuzzy neural network is introduced, and then the discretization network model is given by Euler method. The dissipation and chaos traits of single dynamic fuzzy neuron and dynamic fuzzy neural networks are proved separately. According to Lyapunov exponent discriminance criterion, four conditions are deduced, which the parameters should satisfy to prove the existence of chaos in single dynamic neuron and dynamic fuzzy neural network.},
}

