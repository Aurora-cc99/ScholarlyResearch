@misc{panorama_675ddd047a77_1fea18c9837525fb,
  title = {HRPFormer: High-Resolution Pyramid Transformer for Crowd Pose Estimation},
  author = {Xue-lian Zou and Xiaojun Bi},
  year = {2026},
  doi = {10.1109/lsp.2026.3742746},
  url = {https://doi.org/10.1109/lsp.2026.3742746},
  howpublished = {IEEE Signal Processing Letters},
  annotation = {中文辅助译名：HRPFormer：用于人群姿势估计的高分辨率金字塔Transformer},
  abstract = {Occlusion in crowded scenes is a challenging problem for human pose estimation. To address this problem, we design an effective HRPFormer model. Specifically, HRPFormer consists of three parts: Feature Fusion attention module (FFA), Dual-source feature fusion (DFF) and Waterful module. FFA is used to effectively extract shallow features. DFF enhances the fusion of shallow features we extract with features from different stages and improves the feature representation ability. Unlike the local information extracted by CNN, the Waterful module improves the information exchange between local information and global information. In addition, the Waterful module contains multiple Multi-scale Pyramid Pooling Transformer Modules (MPPTM) to capture global dependencies. Extensive experimental results show that our HRPFormer significantly outperforms the state-of-the-art backbone network HRNeXt on the challenging crowded scene Crowdpose dataset. Our model has only 0.39 times and 0.53 times of the parameters and complexity of HRNeXt, respectively. It achieves 70.7AP and is 0.3AP higher than HRNeXt.},
}

@misc{panorama_675ddd047a77_d4cbe3d0f1072b3e,
  title = {REARL: A Closed-loop Autonomous Driving Simulation Enhancement Framework with Real Traffic Data and Large Language Models},
  author = {Xiaojun Bi and Jun Jiang and Yiwen Sun and Quanyi Ou and Yizhi Ma and Ke Cheng and Yexin Li and Yexin Li and Bowen Du},
  year = {2026},
  doi = {10.48550/arxiv.2609.19903},
  url = {https://arxiv.org/abs/2609.19903},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：REARL：基于真实交通数据和大型语言模型的闭环自动驾驶仿真增强框架},
  abstract = {Accurate simulation is crucial for autonomous driving development, yet capturing real-world traffic complexity remains challenging. Existing simulators that rely on predefined rules or static data playback struggle with dynamic traffic. CRITICAL uses real traffic data and a large language model (LLM) to adjust the initial simulation configuration, but the simulated distribution still diverges from real traffic as the rollout evolves. We propose REARL, a closed-loop simulation enhancement framework that integrates real traffic data with LLMs. Real traffic data are clustered, and each cluster center is used as a representative scenario that provides typical real-world traffic patterns for the LLM. A timed sliding-window detector then monitors discrepancies in vehicle speed distribution and mean spacing between pairs of vehicles. If a metric exceeds a threshold, the LLM adjusts vehicle decision-making; otherwise the existing controller is kept. The LLM also selects a matching real vehicle from a traffic snapshot and modulates the simulated vehicle with reference to that real action. In a controlled HighD highway setting, compared with the CRITICAL baseline and a PPO-based learning baseline, REARL reduces the Hellinger distance for speed distributions to 0.3067 and the MAPE for mean spacing to 0.8371, while achieving a time headway (THW) of 22.8575 and a lane change rate of 0.0708.},
}

