@misc{panorama_675ddd047a77_8fbca21d1bb9459a,
  title = {Multi-Scale Attention Generative Adversarial Networks for Video Frame Interpolation},
  author = {Jian Xiao and Xiaojun Bi},
  year = {2020},
  doi = {10.1109/ACCESS.2020.2995705},
  url = {https://doi.org/10.1109/ACCESS.2020.2995705},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：用于视频帧插值的多尺度注意力生成对抗网络},
  abstract = {Video frame interpolation is a fundamental task in computer vision. Recent methods usually apply convolutional neural networks to generate intermediate frame with two consecutive frames as inputs. But sometimes existing methods fail to handle with complex motion and long-range dependencies. In this paper, a multi-scale dense attention generative adversarial network is proposed. First, a multi-scale generative adversarial framework is established for video frame interpolation. Generators from coarse to fine can better combine global and local information. Second, an attention module introduced to generator makes network accurately focus on moving objects. Third, a sequence discriminator is designed to improve the ability of capturing spatial and temporal consistency in frame sequence. Experimental results of ablation study prove the effectiveness of our three contributions. And results on several datasets demonstrate that our approach attains higher performance and produce more photo-realistic in-between frame comparing with previous works.},
}

@misc{panorama_675ddd047a77_da4f3cf367549429,
  title = {A Modification of UCT Algorithm for WTN-EinStein würfelt nicht! Game},
  author = {Xiali Li and Yingying Cai and Luyao Yu and Licheng Wu and Xiaojun Bi and Yue Zhao and Bo Liu},
  year = {2020},
  doi = {10.1109/ICCC49849.2020.9238833},
  url = {https://doi.org/10.1109/ICCC49849.2020.9238833},
  howpublished = {ICCC},
  annotation = {中文辅助译名：WTN-EinStein UCT 算法的修改版 würfelt nicht!游戏},
  abstract = {WTN-EinStein würfelt nicht! (abbreviated as EWN) chess game has been attracting much attention owing to its characteristics of randomness and incompleteness. In this study, a modified upper confidence bounds applied to trees (UCT) algorithm is proposed by optimizing selection strategy, simulation of tree nodes and establishing the game tree based on probabilistic rules and natural characteristics of the chess game. Experimental results verify that the program applying the modified UCT algorithm can greatly improve winning rate compared with others with plain UCT or Monte Carlo algorithms. The program won the first prize in 2019 Chinese University Student Computer Games Competition and 13th National Computer Games Tournament.},
}

