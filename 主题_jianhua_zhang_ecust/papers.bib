@misc{jianhua_zhang_ecust_4220c06764276ab1,
  title = {Support vector machine approaches to classifying operator functional state in human-machine system},
  author = {Zhong Yin and Jianhua Zhang},
  year = {2011},
  url = {https://ieeexplore.ieee.org/document/6000428/},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：支持向量机方法对人机系统中操作员功能状态进行分类},
  abstract = {The safety of a sophisticated human-machine system is closely related to the operator functional states (OFS) and the OFS is also associated with the physiological and mental state. The precise evaluation of OFS can realize an adaptive auxiliary system to assist operator decrease the accident risk. This paper has assessed and classified OFS based on a series of operator performance data, subjective evaluation data and electrophysiological signals. The classification model of OFS is based on the support vector machine (SVM). Analysis demonstrated that SVM can classify the OFS into three levels and the suitable feature selection contributes to increasing correct classification rate.},
}

@misc{jing_jin_ecust_1884785e9f2555e9,
  title = {P300 Chinese input system based on Bayesian LDA},
  author = {Jing Jin and Brendan Z. Allison and Clemens Brunner and Bei Wang and Xingyu Wang and Jianhua Zhang and Christa Neuper and Gert Pfurtscheller},
  year = {2010},
  doi = {10.1515/bmt.2010.003},
  url = {https://doi.org/10.1515/bmt.2010.003},
  howpublished = {Biomedizinische Technik/Biomedical Engineering},
  annotation = {中文辅助译名：基于贝叶斯LDA的P300中文输入系统},
  abstract = {A brain-computer interface (BCI) is a new communication channel between humans and computers that translates brain activity into recognizable command and control signals. Attended events can evoke P300 potentials in the electroencephalogram. Hence, the P300 has been used in BCI systems to spell, control cursors or robotic devices, and other tasks. This paper introduces a novel P300 BCI to communicate Chinese characters. To improve classification accuracy, an optimization algorithm (particle swarm optimization, PSO) is used for channel selection (i.e., identifying the best electrode configuration). The effects of different electrode configurations on classification accuracy were tested by Bayesian linear discriminant analysis offline. The offline results from 11 subjects show that this new P300 BCI can effectively communicate Chinese characters and that the features extracted from the electrodes obtained by PSO yield good performance.},
}

@misc{jianhua_zhang_ecust_b85747e82b302955,
  title = {Fuzzy clustering of operator functional states in human-machine systems},
  author = {Hua Liu and Jianhua Zhang and Raofen Wang and Xingyu Wang},
  year = {2010},
  url = {http://yadda.icm.edu.pl/yadda/element/bwmeta1.element.ieee-000005572493},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：人机系统中操作员功能状态的模糊聚类},
  abstract = {The primary objective of this paper is to classify the operator functional states (OFS) in the control of human-machine system. In a lab environment, 11 subjects were employed to simulate a set of process control tasks in an automated cabin air management system (aCAMS), recording psychophysiological signal and performance appearance. The fuzzy C means classification algorithm is used to classify operator functional state, which is divided into three categories, corresponding to the status of “good”, “Medium” and “bad”, and finally gives the exact classification of results, and given their respective categories the degree of membership. By selecting the appropriate input, fuzzy C means classification accuracy can be achieved within an acceptable scope. The final classification based on the results is used to adjust control strategies, achieving intelligent human-machine interaction.},
}

@misc{jing_jin_ecust_9a40f0cfef39a4a1,
  title = {Classification of the Direction Perceived EEG Based on ICA-F-Score Approach},
  author = {Jing Jin and Xingyu Wang and Jianhua Zhang},
  year = {2008},
  doi = {10.1109/icbbe.2008.800},
  url = {https://doi.org/10.1109/icbbe.2008.800},
  howpublished = {International Conference on Bioinformatics and Biomedical Engineering},
  annotation = {中文辅助译名：基于ICA-F-Score方法的方向感知脑电分类},
  abstract = {An experiment was designed to record the electroencephalography, when people caught the vision of different directional moving. Independent components analysis was used to analyze the EEG signal. The selection of independent component has received a great deal of attention in the field of signal processing and image processing. Here, F-score of multisets was used to select the valuable independent components. The analysis result showed that separable features could be obtained when people had different directional perception.},
}

@misc{jianhua_zhang_ecust_6947388b985b9492,
  title = {Use of Heart Rate Variability Analysis for Quantitatively Assessing Operator's Mental Workload},
  author = {Jianhua Zhang and Xingyu Wang and Mahdi Mahfouf and D.A. Linkens},
  year = {2008},
  doi = {10.1109/bmei.2008.180},
  url = {https://doi.org/10.1109/bmei.2008.180},
  howpublished = {International Conference on Biomedical Engineering and Informatics (BMEI)},
  annotation = {中文辅助译名：利用心率变异性分析定量评估操作者的脑力负荷},
  abstract = {In this paper, the autoregressive modeling based spectral analysis method is described and its application to spectral analysis of heart rate variability (HRV) signal is evaluated. The assessment of heart rate (HR) spectra aimed at providing meaningful measure of mental workload is also discussed. This work may provide insight into the effect of mental workload on the HRV spectral characteristics.},
}

@misc{jianhua_zhang_ecust_eb475d198037aae0,
  title = {Fuzzy Logic based Identification of Operator Functional States Using Multiple Physiological and Performance Measures},
  author = {Jianhua Zhang and Xingyu Wang and Mahdi Mahfouf and D.A. Linkens},
  year = {2008},
  doi = {10.1109/bmei.2008.181},
  url = {https://doi.org/10.1109/bmei.2008.181},
  howpublished = {International Conference on Biomedical Engineering and Informatics (BMEI)},
  annotation = {中文辅助译名：使用多种生理和性能测量的基于模糊逻辑的操作员功能状态识别},
  abstract = {This paper assesses the operator functional state (OFS) based on a collection of psychophysiological and performance measures. Two types of adaptive fuzzy models, namely ANFIS (adaptive-network-based fuzzy inference system) and GA (genetic algorithm) based Mamdani fuzzy model, are employed to estimate the OFSs under a set of simulated process control tasks involved in an automation-enhanced cabin air management system (aCAMS). The adaptive fuzzy modelling procedures are described and then validated using real-life data measured from such a simulated human-machine process control system.},
}
