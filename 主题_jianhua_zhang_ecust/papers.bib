@misc{jianhua_zhang_ecust_c5a754298c3e5760,
  title = {SCVCNet: Sliding Cross-Vector Convolution Network for Task-Independent Cognitive Workload Recognition With EEG Measurement},
  author = {Zhiyuan Zhan and Zhong Yin and Li Chen and Qi Wang and Jianhua Zhang},
  year = {2025},
  doi = {10.1109/TIM.2025.3550250},
  url = {https://doi.org/10.1109/TIM.2025.3550250},
  howpublished = {IEEE Trans. Instrum. Meas.},
  annotation = {中文辅助译名：SCVCNet：滑动交叉向量卷积网络，用于通过脑电图测量进行任务无关的认知工作负载识别},
  abstract = {This article presents a generic approach for measuring cognitive workload by exploiting common electroencephalogram (EEG) patterns. We propose a neural network called SCVCNet, which eliminates task- and individual-set-related interferences in the EEG by analyzing its detailed spatial-frequency structures. The SCVCNet utilizes a sliding cross-vector convolution (SCVC). It adopts two input layers representing theta and alpha power at fine-grained frequency points, with each node corresponding to an EEG electrode. For each frequency point, the inputs from the two bands are arranged in a cross shape. A kernel matrix is then applied to the power values at the intersection of the electrode locations, focusing on both the central and neighboring electrodes. Next, we introduce an interfrequency-point feature integration (IFPFI) module to fuse the SCVC feature maps. We validate its performance using three databases, each consisting of distinct tasks performed by independent participant groups. The average accuracy (ACC) (68.1% and 62.3%) and F1 score (67.4% and 60.8%) achieved in two different validation paradigms show partially higher performance than the previous works. All features and proposed algorithms are publicly available.},
}

@misc{jianhua_zhang_ecust_760f29f660b55a1c,
  title = {Predictive Modeling of Stock Prices Using Transformer Model},
  author = {Leila Mozaffari and Jianhua Zhang},
  year = {2024},
  doi = {10.1145/3674029.3674037},
  url = {https://doi.org/10.1145/3674029.3674037},
  howpublished = {ICMLT},
  annotation = {中文辅助译名：使用 Transformer 模型对股票价格进行预测建模},
  abstract = {Financial market prediction utilizing deep learning has attracted the attention of both investors and researchers. Deep learning methods, such as convolutional neural networks and recurrent neural networks work well at predicting stock indices based on the non-linear characteristics of stock markets. The goal of this work is to predict the stock index using the latest deep learning framework, Transformer. This paper presents a comprehensive analysis of stock closing price prediction using three distinct machine learning models: Long Short-Term Memory (LSTM), Prophet, and Transformer. Using the encoder-decoder architecture and the multi-head attention mechanism, Transformer is able to better characterize stock market dynamics. The present study uses data from Yahoo Finance. The Transformer model demonstrated superior performance in comparison with LSTM and Prophet. In this work, we handle the complexities of market dynamics to improve stock price predictions.},
}

@misc{jianhua_zhang_ecust_8de76ecdaac7f21a,
  title = {Generic Mental Workload Measurement Using a Shared Spatial Map Network With Different EEG Channel Layouts},
  author = {Jing Zhang and Jiehao Tang and Jianhua Zhang and Zhong Yin and Yagang Wang and Zhe Wang and Bingxue Zhang},
  year = {2024},
  doi = {10.1109/TIM.2024.3373070},
  url = {https://doi.org/10.1109/TIM.2024.3373070},
  howpublished = {IEEE Trans. Instrum. Meas.},
  annotation = {中文辅助译名：使用具有不同 EEG 通道布局的共享空间地图网络进行通用心理工作量测量},
  abstract = {Passive brain-computer interfaces with electroencephalographs (EEGs) could measure human mental workload levels. However, the use of EEG headsets with varying electrode configurations presents challenges in creating an interpretable mental workload recognizer that can be applied across different individuals and databases. To address this issue, we propose a novel shared spatial map network (SSMN), which abstracts EEG data representations from different individuals and electrode layouts. The SSMN utilizes a shared map encoder to generate EEG feature maps with consistent spatial locations on the scalp. Then, an instance augmentation encoder is employed to increase the sample size and filter out individual-specific components. Finally, a workload recognition committee is established by combining shallow and deep architectures of convolutional neural networks, allowing for adaptation to different mental workload measurement scenarios. We evaluate SSMN’s performance by combining two feature types and four validation approaches on three databases. The classification accuracy of the mental workload level measured by the EEG samples is comparable with the state-of-the-art models. The shared feature maps also clearly interpret the contribution of the cortical regions to the mental workload variations.},
}

