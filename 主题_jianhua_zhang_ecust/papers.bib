@misc{jianhua_zhang_ecust_db351045010933a9,
  title = {Brainprint Measurement Under Complex Cognitive Load Scenarios With a Spatially Aware Polyspectral Retention Network},
  author = {Xin Xie and Xiaolong Zhong and Jianhua Zhang and Hengqian Zhang and Yinuo Shi and Zhong Yin},
  year = {2025},
  doi = {10.1109/TIM.2025.3600822},
  url = {https://doi.org/10.1109/TIM.2025.3600822},
  howpublished = {IEEE Trans. Instrum. Meas.},
  annotation = {中文辅助译名：使用空间感知多谱保留网络在复杂认知负荷场景下进行脑纹测量},
  abstract = {The brainprint, based on electroencephalography (EEG), offers unique identification through dynamic physiological patterns. However, EEGs may concurrently capture cognitive load as a potential interference to brainprint. On the contrary, traditional EEG-based deep models, designed for diagnostic purposes, often treat brainprint variations as noise. To address this mismatch, we introduce the Brainprint database under cOmplex cOgnitive Load Scenarios (BOOLS) and a novel Spatially Aware Poly-Spectral Retention Network (SAPR-Net). The BOOLS database records EEG signals under four different cognitive load levels from 30 participants, which is made publicly available. The SAPR-Net amplifies individual-specific EEG features by improving the connectivity within and between cortical regions, utilizing a new electrode-position encoding method. The peak performance of the SAPR-Net on the BOOLS database was achieved at 94.70%. Through analysis of channel selection strategies and window size choices, we demonstrate that the brainprint can be consistently preserved despite cognitive load fluctuations by leveraging interpretable EEG connectivity.},
}

