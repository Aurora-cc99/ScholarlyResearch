@misc{panorama_ting_jin_e0acc506744d4b18,
  title = {Survey on Dim Small Target Detection in Clutter Background: Wavelet, Inter-Frame and Filter Based Algorithms},
  author = {Xiangzhi Bai and Shan Zhang and Binbin Du and Zhaoying Liu and Ting Jin and Bindang Xue and Fugen Zhou},
  year = {2011},
  doi = {10.1016/j.proeng.2011.08.091},
  url = {https://doi.org/10.1016/j.proeng.2011.08.091},
  howpublished = {Procedia Engineering},
  annotation = {中文辅助译名：杂波背景下弱小目标检测研究综述：基于小波、帧间和滤波器的算法},
  abstract = {Dim small target is an active and important research area in image processing and pattern recognition. Various algorithms have been proposed to detect and track dim small target. This paper reviews some algorithms for dim small target detection, including the wavelet based algorithms, inter-frame difference based algorithms and filter based algorithms. Also, the further development of the technologies has been briefly analyzed.},
}

