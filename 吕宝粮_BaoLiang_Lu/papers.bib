@misc{lu_baoliang_898e3ba2961f,
  title = {Multimodal Emotion Recognition Using a Modified Dense Co-Attention Symmetric Network, 2021 10th International IEEE/EMBS Conference on Neural Engineering (NER), Online conference, 2021-5-4 to 2021-5-6},
