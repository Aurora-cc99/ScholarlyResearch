@misc{lu_baoliang_63005ac76880,
  title = {Vigilance Estimation Using a Wearable EOG Device in Real Driving Environment},
  author = {Wei-Long Zheng and Kunpeng Gao and Gang Li and Wei Liu and Chao Liu and Jing-Quan Liu and Guoxing Wang and Bao-Liang Lu},
