@misc{lu_baoliang_0cb5f8a06090,
  title = {A roadmap to navigate the future of neural engineering},
  author = {Warren M Grill and Cynthia Chestek and Yiwen Wang and Aman S Aberra and Alain Destexhe and Rosa H M Chan and Bao-Liang Lu and Yael Hanein and Jacob T Robinson and Clarissa Whitmire and Allen Song and Dario Farina and Daniel P Ferris and Rylie A Green and Josef Goding and Maria Asplund},
  year = {2026},
  doi = {10.1088/1741-2552/ae78c2},
  url = {https://doi.org/10.1088/1741-2552/ae78c2},
  howpublished = {Journal of neural engineering},
  annotation = {中文辅助译名：导航神经工程未来的路线图。},
  abstract = {A group of leaders in neural engineering collaborated to develop a roadmap to navigate the future of neural engineering. We covered a range of themes, including brain machine interfaces, neural modeling, artificial intelligence and machine learning, neural interfaces, neural imaging, augmented rehabilitation, and neuromaterials. For each topic we reviewed the current status, identified current and future challenges, and speculated on the emerging and necessary advances in science and technology to meet these challenges. Neural engineering will continue to yield the approaches and insights that advance the diagnosis and treatment of nervous system disorders, as well as provide new understanding of neural function.},
}

@misc{lu_baoliang_8fd0685e01a1,
  title = {LaBraM at Scale: Scaling Data and Models for EEG Pretraining},
  author = {Jun-Yu Pan and Ruicheng Yin and Bao-Liang Lu and Dongsheng Li and Wei-Long Zheng and Yansen Wang},
  year = {2026},
  url = {https://arxiv.org/abs/2611.03165},
  howpublished = {arXiv 2611.03165},
  annotation = {中文辅助译名：规模化LaBraM：扩展脑电预训练的数据与模型规模},
  abstract = {LaBraM, an early EEG foundation model, demonstrated that large-scale EEG pretraining can yield strong representations for diverse downstream tasks. Building on this foundation, we expand pretraining data and model capacity while retaining its core encoder and objective. We train ten encoders with 5.8 million to 1.97 billion parameters on three EEG collections spanning 25,067 to 79,910 hours, adapting signal preparation and training to heterogeneous recordings. Across 23 tasks, Atom-L* reaches 59.05% mean balanced accuracy at its best evaluated full fine-tuning (Full-FT) checkpoint, 3.61 percentage points above the strongest baseline EEG foundation model. Quark-G leads linear probing (LP) at 54.33%, a 1.24-point margin. Both also lead average task rank. At the last evaluated checkpoints, larger encoders improve Full-FT more consistently than LP, and stronger LP does not guarantee stronger Full-FT. Preserving patch structure improves LP over average pooling. Data-fraction experiments suggest capacity-dependent saturation, while checkpoint trajectories show that downstream performance can decline as pretraining loss falls. Joint classification with a shared Qwen3 readout reaches 50.50% with Molecule-H and Qwen3-8B; increasing language-model size provides no consistent gain. These results demonstrate the value of scaling LaBraM and the importance of matching pretraining scale to downstream adaptation.},
}

@misc{lu_baoliang_6c2635bac3c0,
  title = {Visualizing the Invisible: Generative Visual Grounding Empowers Universal EEG Understanding in MLLMs},
  author = {Jun-Yu Pan and Yansen Wang and Enze Zhang and Bao-Liang Lu and Wei-Long Zheng and Dongsheng Li},
  year = {2026},
  doi = {10.48550/ARXIV.2605.18172},
  url = {https://arxiv.org/abs/2605.18172},
  howpublished = {CoRR},
  annotation = {中文辅助译名：可视化不可见：生成视觉基础增强 MLLM 中的通用脑电图理解。 CoRR abs/2605.18172 (2026) [arXiv]},
  abstract = {Leveraging the universal representations of pre-trained LLMs and MLLMs offers a promising path toward brain foundation models. However, visually-evoked EEG datasets remain scarce, leading existing methods to align neural signals mainly with abstract text, a lossy translation that may discard fine-grained perceptual information encoded in brain activity. We propose Generative Visual Grounding (GVG), a framework that visualizes the invisible by using an EEG-to-image generative model as a visual translator. Instead of forcing EEG into text alone, GVG hallucinates instance-specific proxy images for non-visual EEG, providing structured visual contexts that allow MLLMs to exploit their visual priors for clinical-state interpretation. We validate this idea on two MLLM backbones, GVG-X-Omni and GVG-Janus. Image-only alignment is already competitive: the lightweight GVG-X-Omni matches 1.7B-parameter text-aligned baselines while tuning only 170M parameters on a frozen 7B backbone. We further extend GVG-Janus with trimodal Image+Text alignment, where text supplies categorical semantic anchors and visual proxies enrich neural representations with perceptual details. Experiments show consistent gains in EEG understanding and visual generation, suggesting visual proxy grounding as an effective complement to textual alignment.},
}

