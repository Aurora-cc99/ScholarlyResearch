@misc{panorama_946642b6ca0e_a0a7a140e265,
  title = {A Lightweight Passive Depression Detection System Based on Interpretable Facial Feature Analysis},
  author = {Liang Zhang and Peng Zhang and Tianhuan Huang and Jian Zhao and Wei Xiang and Xianye Ben},
  year = {2026},
  doi = {10.1109/jiot.2026.3667276},
  url = {https://doi.org/10.1109/jiot.2026.3667276},
  howpublished = {IEEE Internet of Things Journal},
  annotation = {中文辅助译名：基于可解释的面部特征分析的轻量级被动抑郁症检测系统。 IEEE 物联网期刊},
  abstract = {Automatic depression detection from facial videos is promising for IoT deployment but has long suffered from the black-box nature of deep models, which overlook how depression manifests on the face. This lack of interpretability leads to redundant feature learning, overly complex architectures, and consequently a trade-off between accuracy and deployability. We introduce a lightweight, interpretable system that explicitly models static–dynamic facial patterns, color channels, and regional textures. At its core is a Hybrid Static–Dynamic Model (HSDM) with detachable modules and identity decoupling, supported by two task-driven preprocessing steps (blue-channel suppression and 90° Gabor filtering). On AVEC2013/2014, our approach reduces mean absolute error by 10.1% on AVEC2014 while maintaining competitive results on AVEC2013. From a systems perspective, it achieves real-time inference on Jetson Nano (0.071M parameters, 0.21 GFLOPs, 17.69 ms latency, 56.54 samples/s throughput), outperforming larger SOTA models under identical conditions. The design facilitates on-device deployment and offers transparent decision paths through interpretable static–dynamic fusion, color synergy, and region-level analysis.},
}

@misc{xianye_ben_5e82670ee5620472,
  title = {Cross-Domain Knowledge Transfer Learning With Macro-Expression Priors for Micro-Expression Recognition},
  author = {Yingying Guo and Xianye Ben and Peng Zhang and Chen Gong and Wei Xiang and Xiaolin Wu},
  year = {2026},
  doi = {10.1109/taffc.2026.3710255},
  url = {https://doi.org/10.1109/taffc.2026.3710255},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：利用宏表达先验进行微表情识别的跨领域知识迁移学习},
  abstract = {Micro-expression recognition (MER) aims to objectively decode genuine human emotions with applications in psychology and other fields of social science. Although having made good progress, existing MER methods remain challenged by the scarcity of annotated samples. Recent studies have explored leveraging macro-expression knowledge as an auxiliary source to enhance micro-expression learning. But they often fail to achieve complete domain consistency, due to their inadequacy to align macro and micro domains. Motivated by these observations, this paper proposes a Cross-domain Knowledge Transfer Learning (CKTL) framework that formulates MER as a structure-consistent cross-domain problem, facilitating both semantic alignment and intra-domain relational enhancement through dual-level propagation mechanisms. Specifically, a Cross-domain Structure Propagation (CDSP) module constructs a transfer matrix to propagate category-level dependencies from macro to micro domains, while an Intra-domain Structure Enhancement (IDSE) module reinforces latent relational patterns within each domain to mitigate feature collapse under limited samples. This dual mechanism not only aligns distributions but also explicitly preserves cross-domain relational topology and intra-class geometry, bridging the semantic-structural gaps that previous approaches overlook. Extensive experiments on four public benchmarks demonstrate that CKTL achieves indispensable and consistent improvements over state-of-the-art m},
}

