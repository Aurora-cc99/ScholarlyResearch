@misc{bo_hong_thu_518c223774755293,
  title = {Mirrored high gamma cortical activity during finger tap imitation},
  author = {Tianyi Qian and Bo Hong and Wenjing Zhou and Shangkai Gao},
  year = {2010},
  doi = {10.1109/iembs.2010.5627355},
  url = {https://doi.org/10.1109/iembs.2010.5627355},
  howpublished = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)},
  annotation = {中文辅助译名：在手指敲击模仿过程中镜像高伽玛皮层活动},
  abstract = {The discovery of mirror neuron system in the macaque study in the 1990s explored a new way to investigate motor imitation. By using the electrocorticographic (ECoG) with high resolution in both spatial and temporal domains, this paper studies brain function during both observation and execution of a simple finger tapping task. Four epilepsy patients were asked to watch simple finger tapping video clips and then imitate the same action themselves. A significant mirrored power increase in the high gamma (HG) band (> 60Hz) have been observed over the superior parietal cortex in the right hemisphere. Furthermore, the power changes in the frequency range 75-95Hz were phase locked to the finger tapping trajectory. The temporal patterns of ECoG power varied during observation and execution, and were similar with the neuronal firing histogram recorded in the macaque imitation study.},
}

