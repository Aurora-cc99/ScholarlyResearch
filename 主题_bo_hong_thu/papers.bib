@misc{bo_hong_thu_0068dd3f8547e0a6,
  title = {Surgical outcomes in patients with epilepsy after viral encephalitis: contribution of SEEG study},
  author = {Liu Yi-ou and Wenjing Zhou and Bo Hong and Tong Zhao and Yuefeng Wang},
