  author = {Dingkun Liu and Yongzhi Shan and Liang Chen and Wenzheng Li and Xintong Yao and Ruwei Yao and Junze Zheng and Fangshuo Liang and Wen Zhu and Honglai Xu and Tao Liu and Yujing Wang and Penghu Wei and Ying Qing Mao and Guoguang Zhao and Bo Hong},
  year = {2024},
  doi = {10.1101/2024.09.05.24313041},
  url = {https://doi.org/10.1101/2024.09.05.24313041},
  howpublished = {medRxiv},
  annotation = {中文辅助译名：通过硬膜外脑机接口恢复慢性脊髓损伤的手部功能},
  abstract = {Loss of hand function after cervical spinal cord injury limits independence in daily life. Implanted brain–computer interfaces (BCIs) can assist movement, but their role in sustained hand rehabilitation at home remains unclear 1,2 . Here we show that a wireless epidural BCI provides long-term hand assistance at home, accompanied by gains in unassisted hand function in two people with chronic cervical spinal cord injury. The system decoded grasp intention from electrodes placed above the dura to control a pneumatic glove, coupling motor intention to hand movement and sensory feedback. The system supported home use for 24 and 12 months, with 98% success in object-transfer testing and assistance during eating and drinking. Both participants regained the ability to grasp and hold objects without BCI assistance. Functional gains were observed in both hands despite unilateral training and were accompanied by increased somatosensory evoked responses. These findings suggest that sustained BCI-assisted hand use at home can support recovery of voluntary control after chronic spinal cord injury.},
}

