@misc{bo_hong_thu_168f9b3ac4c222e8,
  title = {Cooperative cortical network for categorical processing of Chinese lexical tone},
  author = {Xiaopeng Si and Wenjing Zhou and Bo Hong},
  year = {2017},
  doi = {10.1073/pnas.1710752114},
  url = {https://doi.org/10.1073/pnas.1710752114},
  howpublished = {Proceedings of the National Academy of Sciences},
  annotation = {中文辅助译名：用于汉语词汇声调分类处理的协作皮层网络},
  abstract = {This dataset contains the ECoG, CT and MRI data for the six subjects associated with the manuscript, "Cooperative cortical network for categorical processing of Chinese lexical tone", as well as stimulus sound files used in the study. data_MRI.rar - MRI scan before the ECoG electrode implantation data_CT.rar - CT images with ECoG electrode implanted data_ECoG.rar - ECoG recording of six patients reported in the manuscript stimuli_BehaviorContinumm.rar - Chinese tone continuum stimuli (Token 1-13 as in Fig 1 of the manuscript) stimuli_ECoG_MMN.rar - Chinese tone stimuli used for oddball paradigm in ECoG experiment (Token 2, 5 and 8, see Fig 1 of the manuscript) Upon email request (hongbo@tsinghua.edu.cn), the authors may provide analysis code. Original manuscript: Si, Zhou and Hong. PNAS, 2017 Cooperative cortical network for categorical processing of Chinese lexical tone Abstract: In tonal languages such as Chinese, lexical tone with varying pitch contours serves as a key feature to provide contrast in word meaning. Similar to phoneme processing, behavioral studies have suggested that Chinese tone is categorically perceived. However, its underlying neural mechanism remains poorly understood. By conducting cortical surface recordings in surgical patients, we revealed a cooperative cortical network along with its dynamics responsible for this categorical perception. Based on an oddball paradigm, we found amplified neural dissimilarity between cross-category tone pairs, rather t},
}

@misc{bo_hong_thu_ef982834e402e6f2,
  title = {Minimally invasive brain computer interface for fast typing},
  author = {Hao Han and Xin Xu and Zhipei Ling and Dongyang Li and Bo Hong},
  year = {2017},
  doi = {10.1109/NER.2017.8008393},
  url = {https://doi.org/10.1109/NER.2017.8008393},
  howpublished = {NER},
  annotation = {中文辅助译名：用于快速打字的微创脑机接口},
  abstract = {For a practical intracranial brain computer interface (BCI), minimizing the invasiveness of the electrode implantation is crucial. In this study, we used only one intracranial electrode to implement an online BCI for fast typing. When the subject attended the virtual button containing visual motion stimuli, prominent responses were elicited at the stereo-EEG (SEEG) electrodes within the fMRI defined middle temporal (MT) region, which were composed of motion-onset visual evoked potential (mVEP) around 200 ms post-stimulus and a power increase at the high gamma (70-100 Hz) frequency range. In the online BCI experiment with surgical epilepsy patients, by combining both mVEP and high gamma features and using smart stopping strategy, single SEEG electrode supported a speed of BCI typing up to 14 characters per minute. Our findings demonstrate the feasibility of implementing a minimally invasive intracranial BCI with only one electrode for fast typing.},
}

