@misc{dan_zhang_thu_242b0347f3fe20c9,
  title = {Leading and following: Noise differently affects semantic and acoustic processing during naturalistic speech comprehension},
  author = {Xin Ma and Zhuoran Li and Bo Hong and Tongxiang Diao and Dan Zhang and Jiawei Li and Guido Nolte and Xinmiao Zhang and Andreas K. Engel},
  year = {2023},
  doi = {10.1016/J.NEUROIMAGE.2023.120404},
