  annotation = {中文辅助译名：计算机科学与技术专业特色建设的研究与实践},
  abstract = {To reform the traditional and enclosed teaching model which centers on preparing for examinations and imparting old knowledge to students, we made serials of innovations in the areas of course constructing, teacher construction and talents training. Aiming to train personnel competent both for middle schools, Enterprises and government institutions, countryside and community, we have constructed a computer and science and technology major with distinctively characteristics, that is, learning under the tutorial system with two tutors, practicing as a substitute of a worker in an enterprise or a middle school, training by classifying students to different groups. The graduates were qualified not only to teach information technology courses but also to work as IT engineers. They are also component for information instructors in countryside and community of city.},
}

@misc{panorama_dfb4cba79996_c18de0518c5d95aa,
  title = {Combining Interest Point and Invariant Moment for Geometrically Robust Image Watermarking},
  author = {Leida Li and Baolong Guo and Lei Guo},
  year = {2009},
  url = {https://dblp.uni-trier.de/db/journals/jise/jise25.html#LiGG09},
  howpublished = {Journal of information science and engineering},
  annotation = {中文辅助译名：结合兴趣点和不变矩实现几何鲁棒图像水印},
  abstract = {This paper presents a new robust image watermarking scheme for resisting both traditional and geometric attacks. A watermark synchronization scheme is first presented using image features. Harris interest points are first extracted from the scale normalized image and the locally most stable points are employed to generate some non-overlapped circular regions. Watermark synchronization is achieved using these local circular regions. Thereafter, the rotation invariant pseudo-Zernike moments (PZMs) are computed over each circular region and the watermark signal is composed of the PZM vectors extracted from all the local regions. Then the PZM vectors are modified and reconstructed, producing some error images. The watermark is embedded by adding the error images into the corresponding local circular regions in spatial domain directly. During watermark detection, local circular regions are first extracted from the distorted image and PZMs are computed over each local region. A minimum distance decoder is proposed to detect the watermark blindly. Simulation results on Stirmark 4.0 show that the watermark is robust against traditional signal processing attacks, rotation, scaling, flipping, Stirmark random bending as well as combined attacks.},
}

@misc{panorama_dfb4cba79996_81b1fd2786746c30,
  title = {The Innovation and Practice of Training Talents Model of the Computer Science in Normal Schools},
  author = {Aimin Wang and Xia Zheng and Qingsheng Li and Chuangming Shi and Lei Guo and Yahong Han},
  year = {2009},
  doi = {10.1109/etcs.2009.244},
  url = {https://doi.org/10.1109/etcs.2009.244},
  howpublished = {International Workshop on Education Technology and Computer Science},
  annotation = {中文辅助译名：师范院校计算机科学人才培养模式的创新与实践},
  abstract = {Exploring the effective model which can train the innovative professional computer teachers in the foundational education career; giving prominence to the normal character, strengthening the basic, improving the comprehensive applied ability, laying stress on innovation and developing in all round ways. Reforming the conventional and closed test-oriented teaching model; and carrying through the innovation in the education concept, training target, estimating system, teaching manner, compulsory course arrangement and managing system. And then practicing the model of teaching students in different levels and sorts; the "double tutorial system" and "experimental teaching innovation" are also practiced and researched.},
}

@misc{panorama_dfb4cba79996_7e6141095d6ccdf1,
  title = {A Rough Set-Based SVM Classifier for ATR on the Basis of Invariant Moment},
  author = {Lei Huang and Ying-jun Ma and Lei Guo},
  year = {2009},
  doi = {10.1109/cmc.2009.219},
  url = {https://doi.org/10.1109/cmc.2009.219},
  howpublished = {来源待核},
  annotation = {中文辅助译名：一种基于不变矩的粗糙集SVM ATR分类器},
  abstract = {Automatic target recognition (ATR) is an important task in image application. A classifier for the airplane recognition based on the merits of rough set theory (RST)and directed acyclic graph support vector machines (DAGSVM) is proposed in this paper. RST can mine useful information from a large number of data and generate decision rules without prior knowledge. DAGSVM have better classification performances than other SVMs methods and good capabilities of fault-tolerance and generalization. RST is used as preprocessing step to improve the performances of DAGSVM. Coupled together with RST and DAGSVM techniques they enable the ATR system to identify airplane type on the basis of certain shape feature sets in the images. The methods proposed are compared with general SVMs approach and are shown to perform somewhat better on the remote sensing images.},
}

@misc{panorama_dfb4cba79996_32e3ec62ecc8cfbd,
  title = {Conceptual Design Knowledge Management Based on Rule and User's Feedback},
  author = {Zhenqiang Bao and Lei Guo and Hui Zhong and Rong Luo},
  year = {2008},
  doi = {10.1109/wgec.2008.113},
  url = {https://doi.org/10.1109/wgec.2008.113},
  howpublished = {International Conference on Genetic and Evolutionary Computing},
  annotation = {中文辅助译名：基于规则和用户反馈的概念设计知识管理},
  abstract = {The paper concentrates on the issue how to get the answer to provide knowledge support with available knowledge of concept design for the problem cases. First, a method based on the rules and feedbacks from users is offered for concept-designing. User's feedback is integrated with case-based reasoning (CBR). This method can improve effect and precision of knowledge support for problem cases. Function unit and restriction matrix are used in the process of integration. Then, information of user's feedback is analyzed for improving the product quality. At last, this paper presents a system framework and analyzes the practical flow of the module. And the framework is verified by an example.},
}

@misc{panorama_dfb4cba79996_9a66f1a1c505c88b,
