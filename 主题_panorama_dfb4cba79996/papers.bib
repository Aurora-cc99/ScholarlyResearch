}

@misc{panorama_dfb4cba79996_5627ef79eb537fc9,
  title = {3-D Reconstruction of Encephalic Tissue in MR Images Using Immune Sphere-Shaped SVMs},
  author = {Lei Guo and Ying Li and Dongbo Miao and Lei Zhao and Weili Yan and Xueqin Shen},
  year = {2010},
  doi = {10.1109/tmag.2010.2072776},
  url = {https://doi.org/10.1109/tmag.2010.2072776},
  howpublished = {IEEE Transactions on Magnetics},
  annotation = {中文辅助译名：使用免疫球状 SVM 重建 MR 图像中的脑组织},
  abstract = {In the brain MR images, the boundary of each encephalic tissue is highly irregular. Traditional 3-D reconstruction algorithms are challenged. Owing to its powerful capacity in solving nonlinearity problems, the sphere-shaped support vector machines (SSSVMs) is applied in the 3-D reconstruction. Selecting parameters for SSSVM and the kernel function, however, is a complicated issue. Appropriate parameters can make the model more flexible and help to obtain more accurate data description. In this study, immune algorithm (IA) is used in searching for the optimal parameters. Immune SSSVM (ISSSVM) is proposed to reconstruct the 3-D encephalic tissues in MR images. As shown by the experiment of this study, each encephalic tissue can be reconstructed efficiently, and satisfied accuracy and visual effect can be obtained.},
}

@misc{panorama_dfb4cba79996_0caaf06333c4a7fc,
  title = {Classification of Mental Task From EEG Signals Using Immune Feature Weighted Support Vector Machines},
  author = {Lei Guo and Youxi Wu and Lei Zhao and Ting Cao and Weili Yan and Xueqin Shen},
  year = {2010},
  doi = {10.1109/tmag.2010.2072775},
  url = {https://doi.org/10.1109/tmag.2010.2072775},
  howpublished = {IEEE Transactions on Magnetics},
  annotation = {中文辅助译名：使用免疫特征加权支持向量机对脑电图信号中的心理任务进行分类},
  abstract = {The classification of mental tasks is one of key issues of EEG-based brain computer interface (BCI). Differentiating classes of mental tasks from EEG signals is challenging because EEG signals are nonstationary and nonlinear. Owing to its powerful capacity in solving nonlinearity problems, support vector machine (SVM) method has been widely used as a classification tool. Traditional SVMs, however, assume that each feature of a sample contributes equally to classification accuracy, which is not necessarily true in real applications. In addition, the parameters of SVM and the kernel function also affect classification accuracy. In this study, immune feature weighted SVM (IFWSVM) method was proposed. Immune algorithm (IA) was then introduced in searching for the optimal feature weights and the parameters simultaneously. IFWSVM was used to multiclassify five different mental tasks. Theoretical analysis and experimental results showed that IFWSVM has better performance than traditional SVM.},
}

@misc{panorama_dfb4cba79996_738c95ec085bfa0d,
  title = {Classification of mental task from EEG signals using Immune Feature Weighted Support Vector Machine},
  author = {Lei Guo and Youxi Wu and Ting Cao and Weili Yan and Xueqin Shen},
  year = {2010},
  doi = {10.1109/cefc.2010.5481822},
  url = {https://doi.org/10.1109/cefc.2010.5481822},
  howpublished = {Digest of the Fifth Biennial IEEE Conference on Electromagnetic Field Computation},
  annotation = {中文辅助译名：使用免疫特征加权支持向量机对脑电图信号中的心理任务进行分类},
  abstract = {The classification of mental tasks is one of the key issues of Brain Computer Interface (BCI). Owing to its powerful capacity in solving non-linearity problems, Support Vector Machine (SVM) has been widely used in classification. Traditional SVM, however, assumes that each feature of a sample contributes equally to classification accuracy, which is not necessarily true in real world applications. In addition, the parameters of SVM and kernel function also affect classification accuracy. In this paper, Immune Algorithm (IA) is introduced in searching for the optimal feature weights and parameters simultaneously. So Immune Feature Weighted SVM (IFWSVM) is used to multi-classify 5 kinds of mental tasks. Theoretical analysis and experimental results show that IFWSVM has better performance than Immune SVM (ISVM) without feature weight.},
}

@misc{panorama_dfb4cba79996_c91ff81eb52c498d,
  title = {A novel hybrid filter for edge preserving restoration of image},
  author = {Xiaoliang Qian and Lei Guo and Bo Yu and Tianyun Zhao},
  year = {2010},
  doi = {10.1109/icacte.2010.5579690},
  url = {https://doi.org/10.1109/icacte.2010.5579690},
  howpublished = {International Conference on Advanced Computer Theory and Engineering},
  annotation = {中文辅助译名：一种用于图像边缘保留恢复的新型混合滤波器},
  abstract = {In order to realize the edge preserving restoration of image, a novel hybrid filter which is a combination of Tukey anisotropic diffusion and an adaptive median filter based on object scale is proposed in this paper. The Tukey anisotropic diffusion can suppress the most of noises while preserving the edges, however, the impulse noise points which usually have large gradient will be regarded as edges by Tukey anisotropic diffusion and also be preserved. Our proposed adaptive median filter identify the impulse noise point adaptively according to the object scale of pixel, thus, it can not only remove the impulse noise clearly but also avoid the filtering of the most of pixels. The simulation which add the Gaussian noises and pepper-and-salt noises to Lena indicate that the ability of our method in preserving the fine details is superior than several traditional image filter.},
}

@misc{panorama_dfb4cba79996_7c92483da5f81317,
  title = {Coil optimization design of permanent magnet vibration-to-electrical power generator},
  author = {Wang Zhihua and Bowen Wang and Wang Li and Jia Yao Deng and Weili Yan and Lei Guo},
  year = {2010},
  doi = {10.1109/cefc.2010.5481663},
  url = {https://doi.org/10.1109/cefc.2010.5481663},
  howpublished = {Digest of the Fifth Biennial IEEE Conference on Electromagnetic Field Computation},
  annotation = {中文辅助译名：永磁振动发电线圈优化设计},
  abstract = {Induction coil is one of the key components of permanent magnet vibration-to-electrical power generator (VEPG). Here, the equivalent turn number of coil (ETNC) is introduced to build the relationship between the induction coil's structure and magnetic field. And the dynamic magnetic flux density is calculated by finite element method (FEM). The optimized induction coil is fabricated according to the calculating result. The peak-to-peak voltage and effective value voltage of the optimized coil increase up to 52.59% and 48.76%, respectively, compared with the uniform coil.},
}

@misc{panorama_dfb4cba79996_845efff08f246f01,
  title = {Human-centered attention models for video summarization},
  author = {Kaiming Li and Lei Guo and Carlos Faraco and Dajiang Zhu and Fan Deng and Tuo Zhang and Xi Jiang and Degang Zhang and Hanbo Chen and Xintao Hu and Stephen Miller and Tianming Liu},
  year = {2010},
  doi = {10.1145/1891903.1891938},
  url = {https://doi.org/10.1145/1891903.1891938},
  howpublished = {INTERNATIONAL CONFERENCE ON MULTIMODAL INTERACTION},
  annotation = {中文辅助译名：用于视频摘要的以人为中心的注意力模型},
  abstract = {A variety of user attention models for video/audio streams have been developed for video summarization and abstraction, in order to facilitate efficient video browsing and indexing. Essentially, human brain is the end user and evaluator of multimedia content and representation, and its responses can provide meaningful guidelines for multimedia stream summarization. For example, video/audio segments that significantly activate the visual, auditory, language and working memory systems of the human brain should be considered more important than others. It should be noted that user experience studies could be useful for such evaluations, but are suboptimal in terms of their capability of accurately capturing the full-length dynamics and interactions of the brain's response. This paper presents our preliminary efforts in applying the brain imaging technique of functional magnetic resonance imaging (fMRI) to quantify and model the dynamics and interactions between multimedia streams and brain response, when the human subjects are presented with the multimedia clips, in order to develop human-centered attention models that can be used to guide and facilitate more effective and efficient multimedia summarization. Our initial results are encouraging.},
}

