@misc{panorama_dfb4cba79996_4723d3dcde7bcfb1,
  title = {The Study and Practice of Specialty Characteristics Construction of Computer Science and Technology},
  author = {Aimin Wang and Yuxing Yang and Lei Guo},
  year = {2009},
  doi = {10.1109/etcs.2009.243},
