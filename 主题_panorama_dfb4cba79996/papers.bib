  annotation = {中文辅助译名：个性化图像语义模型相关性反馈中的贝叶斯网络方法},
}

@misc{panorama_dfb4cba79996_98edf2e948f20183,
  title = {GA-SVM based feature selection and parameters optimization for BCI research},
  author = {Lei Wang and Guizhi Xu and Jiang Wang and Shuo Yang and Lei Guo and Weili Yan},
  year = {2011},
  doi = {10.1109/ICNC.2011.6022083},
  url = {https://doi.org/10.1109/ICNC.2011.6022083},
  howpublished = {ICNC},
  annotation = {中文辅助译名：基于 GA-SVM 的 BCI 研究特征选择和参数优化},
  abstract = {Brain Computer Interface (BCI) can translate the mind of the patients who suffered from locked- in syndrome into control commands or meaning symbols. Using this technology, the patients can communicate with the world. The core parts of a typical BCI system is feature extraction and pattern recognition. Too many irrelevant and redundant features will increase the time of classification and decrease the prediction accuracy. The kernel parameters setting for support vector machine (SVM) also impact on the classification accuracy. In this paper, after the features extracted though the algorithm called Sample Entropy, GA-SVM hybrid algorithm was used with two purposes: Selecting of the optimal feature subset and deciding the parameters for SVM classifier. Compared with GA-based feature selection and GA-based parameters optimization for SVM, the GA-SVM hybrid algorithm has fewer input features and gain much higher classification accuracy.},
}

@misc{panorama_dfb4cba79996_d553cb506240521a,
  title = {Hybrid image filter based on decimal object scale},
  author = {Xiaoliang Qian and Lei Guo and Bo Yu},
  year = {2011},
  doi = {10.3724/sp.j.1087.2011.00745},
  url = {https://doi.org/10.3724/sp.j.1087.2011.00745},
  howpublished = {Journal of Computer Applications},
  annotation = {中文辅助译名：基于十进制对象尺度的混合图像滤波器},
  abstract = {摘要： 为了在有效去除可见光图像噪声的同时最大限度地保持图像的边缘、纹理等细节，将已有的目标尺度改进为小数目标尺度以便更精确地反映局部目标结构的大小，提出了基于小数目标尺度的自适应高斯滤波和基于小数目标尺度的自适应中值滤波的混合滤波算法。前者通过小数目标尺度来自适应地控制高斯核的尺度和滤波的模板大小，后者利用小数目标尺度自适应地筛选出脉冲噪声点并进行中值滤波，并弥补前者在抑制脉冲噪声方面的不足。理论分析和仿真实验结果均表明，所提出的算法不仅可以去除各种类型的点状噪声，而且在图像细节的保护和信噪比方面优于其他几类传统算法。},
}

@misc{panorama_dfb4cba79996_cf3a3f81ba4077df,
  title = {Color Image ROI Coding Based on Visual Saliency},
  author = {Lei Guo},
  year = {2011},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=JSJC2011S1079},
  howpublished = {Jisuanji gongcheng},
  annotation = {中文辅助译名：基于视觉显着性的彩色图像ROI编码},
  abstract = {At present,the Region of Interest(ROI) coding is mainly directed against the gray image,so the color image can not use directly.This paper presents a method of ROI coding color image based on visual saliency.It segments ROI from visual saliency map,makes wavelet transform to the whole image,moves the bit plane of ROI’s wavelet coefficients,and codes with improved SPIHT.Experimental results show that by using this method,the PSNR of the whole image and ROI of the proposed method recovered rises respectively by 1.559 7 dB and 1.845 0 dB on average compared with SPIHT method.},
}

@misc{panorama_dfb4cba79996_3d6a7e5db4d982c1,
