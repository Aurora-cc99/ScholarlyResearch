@misc{xiaoli_li_5b0f0583cc92,
  title = {DeepSeek or ChatGPT: Can brain‐computer interfaces/brain‐inspired computing achieve leapfrog development with large AI models?},
  author = {Long Bai and Shugeng Chen and Peng Wang and He Chen and Jiaqing Yan and Xiaojian Zhu and Enming Song and Bobo Tian and Jiacan Su and Xiaoli Li},
  year = {2025},
