  abstract = {The accelerated growth of the global aging population mandates robust ’Aging-in-Place’ solutions, particularly for the highly vulnerable demographic of elderly individuals living alone (solo-aging). For these solo-living seniors, proactive home health monitoring remains impeded by the maintenance complexities of distributed IoT infrastructures. Conventional battery-powered sensor arrays encounter a pragmatic ’Deployment Wall’ where maintenance scales linearly with node density. Conversely, device-free Radio Frequency (RF) sensing suffers from a fundamental ’Dimensionality Deficit,’ struggling to disentangle high-dimensional cross-scale semantics—from transient macro-activities to continuous micro-physiological rhythms—within a narrow-band channel. To transcend these limitations, we propose the Centralized-Perception Virtualized-Representation (CP-VR) architecture, establishing a Software-Defined Sensing (SDS) paradigm via a single passive fiber-optic continuum. Physically, an optimized Pound-Drever-Hall (PDH) locking technique generates a high-dynamic-range sensing channel. Logically, an edge-native InceptionTime deep network is designed and benchmarked as a virtualization engine, deploying multi-scale convolutional kernels to dynamically decouple superimposed cross-scale signals. Preliminary edge benchmarking demonstrates the computational feasibility of local inference on a Raspberry Pi 4B. Proof-of-concept offline evaluations involving five participants yielded an accuracy},
}

@misc{xiaoli_li_deb7871e168a,
  title = {Development of Portable TMS-MEP Device for Emergency Medicine},
  author = {Zhaohuan Ding and Jinbei Tang and Tao Liu and Heng Gu and Gaoxiang Ouyang and He Chen and Xiaoli Li},
  year = {2026},
  doi = {10.1109/jsen.2025.3647765},
  url = {https://doi.org/10.1109/jsen.2025.3647765},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：开发用于急诊医学的便携式 TMS-MEP 设备},
  abstract = {This study presents the development of a portable Transcranial Magnetic Stimulation-Motor Evoked Potential (TMS-MEP) system for emergency medicine, addressing the bulkiness and mains power dependency of conventional devices. The system integrates a battery-powered TMS module with a wearable MEP detector, with a total weight of <3.5 kg. The TMS module utilizes a push-pull converter topology to generate a 720 V DC source from a 12 V lithium battery, coupled with a resonant circuit that produces transient currents exceeding 2000 A in a figure-8 coil. The MEP module employs a 361.7 Hz low-pass filter and a 24-bit analog front-end to suppress electromagnetic artifacts and maintains a resolution of 0.08 μV/bit. Experimental results demonstrated a linear magnetic field output (0.38-0.77 T) at ≥ 50% intensity with <1% residual error. MEP recordings from the first dorsal interosseous muscle in five healthy subjects showed amplitudes surpassing the 50 μV threshold (range: 75.2-283.3 μV). While the system's magnetic field intensity limits high-intensity paradigms, its portability enables deployment in emergency settings. Future integration of high-energy-density capacitors may reduce the performance gap with conventional systems.},
}

