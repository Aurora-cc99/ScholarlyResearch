@misc{xiaoli_li_ae49af4956dc90c1,
  title = {The neurovascular couplings between electrophysiological and hemodynamic activities in anticipatory selective attention},
  author = {Chenguang Zhao and Dongwei Li and Jialiang Guo and Bingkun Li and Yuanjun Kong and Yiqing Hu and Boqi Du and Yulong Ding and Xiaoli Li and Hanli Liu and Yan Song},
  year = {2021},
  doi = {10.1093/cercor/bhab525},
  url = {https://doi.org/10.1093/cercor/bhab525},
  howpublished = {Cerebral Cortex},
  annotation = {中文辅助译名：预期选择性注意中电生理和血流动力学活动之间的神经血管耦合},
  abstract = {Selective attention is thought to involve target enhancement and distractor inhibition processes. Here, we recorded simultaneous electroencephalographic (EEG) and functional near-infrared spectroscopy (fNIRS) data from human adults when they were pre-cued by the visual field of coming target, distractor, or both of them. From the EEG data, we found alpha power relatively decreased contralaterally to the to-be-attended target, as reflected by the positive-going alpha modulation index. Late alpha power relatively increased contralaterally to the to-be-suppressed distractor, as reflected by the negative-going alpha modulation index. From the fNIRS data, we found enhancements of hemodynamic activity over the contralateral hemisphere in response to both the target and the distractor anticipation but within nonoverlapping posterior brain regions. More importantly, we described the specific neurovascular modulation between alpha power and oxygenated hemoglobin signal, which showed a positive coupling effect during target anticipation and a negative coupling effect during distractor anticipation. Such flexible neurovascular couplings between EEG oscillation and hemodynamic activity seem to play an essential role in the final behavioral outcomes. These results provide unique neurovascular evidence for the dissociation of the mechanisms of target enhancement and distractor inhibition. Individual behavioral differences can be related to individual differences in neurovascular coupling.},
}

