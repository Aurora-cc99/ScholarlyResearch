  year = {2026},
  doi = {10.1109/cme70365.2026.11723791},
  url = {https://doi.org/10.1109/cme70365.2026.11723791},
  howpublished = {2026 20th International Conference on Complex Medical Engineering (CME)},
  annotation = {中文辅助译名：一种用于试验级脑电图情绪识别的轻量级分层时间注意力方法},
  abstract = {Trial-level electroencephalography (EEG) emotion recognition must model temporally distributed affective responses without the cost of deep sequence models. We propose differential-entropy multilayer perceptron with hierarchical attention (DMHA), a lightweight framework that extracts five-band differential entropy (DE) features from non-overlapping 3-s windows, encodes each window with a compact two-layer multilayer perceptron (MLP), and applies two-stage hierarchical temporal attention. Window-to-segment attention summarizes local responses, whereas segment-to-trial attention forms the trial representation. Under subject-dependent five-fold cross-validation with trial-level splitting on DEAP, DMHA achieved accuracies of 96.25% for Arousal2, 97.58% for Valence2, and 90.87% for VA4. The binary configuration uses approximately 37.6K trainable parameters and 0.68M multiply-accumulate operations (MACs) per trial. These results support low-complexity affective brain-computer interfaces and resource-constrained biomedical engineering systems that require trial-level EEG emotion decoding.},
}

@misc{xiaoli_li_e3d23e0fb439,
