@misc{xiaoli_li_76a52f08c131,
  title = {Classification of Energy Consumption in Buildings With Outlier Detection},
  author = {Xiaoli Li and Chris P. Bowers and Thorsten Schnier},
  year = {2010},
  doi = {10.1109/TIE.2009.2027926},
