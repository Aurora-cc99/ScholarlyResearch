@misc{haixian_wang_32665698f98b147d,
  title = {L21-Norm-Based Common Spatial Pattern with Regularized Filters},
  author = {Jingyu Gu and Qian Cai and Weiqiang Gong and Haixian Wang},
  year = {2021},
  doi = {10.1109/imcec51613.2021.9482128},
  url = {https://doi.org/10.1109/imcec51613.2021.9482128},
  howpublished = {IEEE Advanced Information Management, Communicates, Electronic and Automation Control Conference (IMCEC)},
  annotation = {中文辅助译名：具有正则化滤波器的基于 L21 范数的通用空间模式},
  abstract = {Common spatial pattern (CSP) is one of the most popular feature extraction techniques that performs well in the field of brain-computer interface (BCI). However, the classical CSP based on the squared Frobenious norm is known to be sensitive to noise and prone to overfitting. In recent years, efforts have been made to solve the problem of robust and sparse modeling. Therefore, we describe the formulation of a CSP criterion by using the L21-norm and add the L21-norm regularization term. The regularized version of the L21-norm-based common spatial pattern is termed RCSP-L21 in this paper. An iterative algorithm is designed to obtain the spatial filters of the regularized objective function. Experimental results on EEG dataset IIa of BCI Competition IV verify the effectiveness of our new method.},
}

