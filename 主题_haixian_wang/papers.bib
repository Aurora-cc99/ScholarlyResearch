@misc{haixian_wang_d12e24af5a17f628,
  title = {Evaluation of satellite-based and reanalysis soil moisture products using ground-observations in the Qilian Mountains},
  author = {Yongyong Zhang and Shumin Wang and Shue Wei and Wenrong Kang and Haixian Wang},
  year = {2026},
  doi = {10.1080/10095020.2025.2536758},
  url = {https://doi.org/10.1080/10095020.2025.2536758},
  howpublished = {Geo spatial Inf. Sci.},
  annotation = {中文辅助译名：祁连山土壤水分卫星地面观测产品评价与再分析},
  abstract = {Critical to the reliable application of gridded soil moisture (SM) products is a thorough assessment of their quality, particularly in water conservation and supply areas such as Qilian Mountains (QLM). The study systematically evaluated the accuracy of surface soil moisture (SSM) and root-zone soil moisture (RZSM) using 14 ground-based sites in the QLM from 2019 to 2021. The study evaluated seven SSM products, comprising four satellite-based datasets (AMSR2-LPRM, SMOS-IC, SMAP-L3, and ESA CCI) and three reanalysis datasets (SMAP-L4, GLDAS-Noah, and ERA5-Land). Furthermore, the performance of three RZSM products derived from these reanalysis datasets was also examined. For SSM products, reanalysis products generally exhibit higher R (0.56) and lower ubRMSE (0.04 m3/m3) compared to satellite-based products (0.44, 0.05 m3/m3). The SMAP-L3 showed the best performance (R = 0.71), followed by the ERA5-Land and SMAP-L4. For RZSM products, compared to GLDAS and ERA5-Land, SMAP-L4 demonstrated better performance (R = 0.59) and shown greater potential for application in QLM. The average R (0.65) of SSM was highest for grassland sites, attributed to fewer land cover heterogeneity. For forest sites, the SSM performance was generally lowest (average R = −0.11). In Arou site, the superior spatial representativeness of Cosmic ray neutron sensor (CRNS) measurements enhanced the evaluation performance (higher R, lower ubRMSE) of nearly all products. Notably, the comparative evaluation with i},
}

@misc{haixian_wang_9523c3d2410d4c7a,
  title = {Subtype-Specific Causal Brain Network Mechanisms in ADHD Using Directed Visibility Graphs},
  author = {Haixian Wang and Ruina Sun},
  year = {2026},
  doi = {10.1145/3809986.3810109},
  url = {https://doi.org/10.1145/3809986.3810109},
  howpublished = {BIC},
  annotation = {中文辅助译名：使用定向可见性图研究 ADHD 中特定亚型的因果脑网络机制},
  abstract = {To identify subtype-specific brain dynamics of ADHD, we propose a directed EEG network framework that integrates Transfer Entropy (TE) with Natural Visibility Graphs (NVG). Causal connectivity networks were constructed from resting-state EEG data of children with ADHD-I, ADHD-C, and typically developing (TD) controls. This framework enables the estimation of directed information flow between brain regions and captures nonlinear temporal characteristics of neural signals. Compared with traditional functional connectivity approaches, the proposed integrated method can provide more robust and discriminative network properties for ADHD subtypes classification. Specifically, ADHD-I exhibited increased compensatory information flow originating from parietal regions, whereas ADHD-C showed enhanced bottom-up processing dominated by occipital regions. Classification performance was significantly improved using features derived from directed causal graphs, supporting their potential as objective neurophysiological biomarkers for ADHD subtype identification.},
}

@misc{haixian_wang_b455c3b626a33e8f,
  title = {Dynamic Reconfiguration of Resting-State Functional Brain Networks in ADHD: A Markov Chain Analysis of Source-Space Synchronization States},
  author = {Liangyu Gao and Haixian Wang},
  year = {2026},
  doi = {10.1145/3822183.3822247},
  url = {https://doi.org/10.1145/3822183.3822247},
  howpublished = {International Conference on Biomedicine and Bioinformatics Engineering (ICBBE)},
  annotation = {中文辅助译名：ADHD 静息态功能脑网络的动态重构：源空间同步状态的马尔可夫链分析},
  abstract = {Attention deficit hyperactivity disorder (ADHD) is associated with disruptions in large-scale functional brain networks. In this study, we combined static and dynamic approaches to investigate topological abnormalities and temporal fluctuations of functional connectivity networks (FCNs) in ADHD. Resting-state electroencephalography (EEG) was collected from 98 individuals with ADHD and 19 typically developing controls. Source localization was applied to derive 151 regions of interest (ROIs). Using these ROIs as nodes and applying K-means clustering to topological features (node centrality) of the functional brain networks, we identified five representative functional connectivity patterns that captured all synchronization states across participants and trials. Statistical modeling and temporal feature extraction based on a Markov chain of synchronization state sequences revealed that the default mode network, central executive network, salience network, visual network, and sensorimotor network re-emerge aperiodically during the resting state. In the ADHD resting state, significant group differences were observed in temporal metrics (fractional occupancy, mean duration, and transition probabilities) of these typical states within the Markov chain. Our findings provide temporal characteristics of ADHD subnetworks from the perspective of functional network transition dynamics, which may help distinguish brain responses under different task conditions or cognitive events. Most met},
}

@misc{haixian_wang_bb511b5f5029b54e,
  title = {Cogformer: A Unified Multi-Scale Brain Representation for Visual Decoding and Reconstruction From fMRI},
  author = {John Q. Gan and Xu Yin and Haixian Wang},
  year = {2026},
  doi = {10.1109/TMI.2026.3667706},
  url = {https://doi.org/10.1109/TMI.2026.3667706},
  howpublished = {IEEE Trans. Medical Imaging},
  annotation = {中文辅助译名：Cogformer：用于 fMRI 视觉解码和重建的统一多尺度大脑表示},
  abstract = {With the rapid development of deep generative models (DGMs), the performance of decoding language and reconstructing images from Functional Magnetic Resonance Imaging (fMRI) has been improved. Nevertheless, the accurate representation of brain activity remains highly challenging, primarily due to the limited paired samples and the low signal-to-noise ratios of fMRI. To tackle these challenges, we introduce Cogformer, a unified multi-scale brain representation method. It is the first to learn brain representation from multi-scale fMRI activities via self-attention, and integrate a synchronized decoding and dynamic decoupling strategy for structural and semantic features through cross-attention. We conduct a systematic evaluation of Cogformer on the large-scale Natural Scenes Dataset (NSD) across a broad range of visual decoding tasks, including category classification, multi-label classification, image retrieval, image captioning, and image reconstruction. To the best of our knowledge, this represents the most extensive task coverage reported in related research. Cogformer achieves superior performance compared to a range of transformer-based baselines in category classification, multi-label classification, and image retrieval tasks. Moreover, in the more challenging tasks of image captioning and image reconstruction, Cogformer leverages a prior diffusion module to enhance the alignment with image semantics. This further improves the semantic consistency for caption generation},
}

@misc{haixian_wang_057ab8484b59a8de,
  title = {DeID-Aligner: fine-grained brain-vision semantic alignment for cross-subject visual decoding from limited fMRI data},
  author = {Ming Yang and Zhiping Wang and Haixian Wang and Xu Yin and John Q. Gan},
  year = {2026},
  doi = {10.1016/J.NEUROIMAGE.2026.122268},
  url = {https://doi.org/10.1016/J.NEUROIMAGE.2026.122268},
  howpublished = {NeuroImage},
  annotation = {中文辅助译名：DeID-Aligner：细粒度的大脑视觉语义对齐，用于根据有限的功能磁共振成像数据进行跨主题视觉解码},
  abstract = {Recent advances in fMRI-based semantic decoding and visual reconstruction have achieved remarkable progress. However, severe inter-subject variability and the scarcity of paired fMRI-image data remain major obstacles to cross-subject generalization. To overcome these challenges, we propose DeID-Aligner, a brain functional alignment framework that enables multi-task visual decoding across subjects under limited fMRI data. The method first constructs a region-of-interest (ROI)-wise fMRI encoder that captures regional functional representations. A dynamic Patch-to-ROI fusion mechanism with Progressive Modal Attention Transition (PMAT) explicitly associates image patches with cortical regions, enabling fine-grained cross-modal semantic alignment while gradually shifting from cross-modal to fMRI-only for robust inference. To remove subject-specific information, we introduce a de-identification task implemented with a graph attention network (DIT-GAT), which models inter-ROI interaction patterns to reduce subject-specific information and suppress identity cues. Extensive experiments on the Natural Scenes Dataset (NSD) demonstrate that DeID-Aligner significantly outperforms state-of-the-art methods in cross-subject category classification, multi-label classification, image captioning, and image reconstruction. Voxel-wise unique variance analysis further reveals that the Patch-to-ROI fusion mechanism substantially enhances semantic representations in high-level visual areas while mai},
}

@misc{haixian_wang_e64fcf6dcfd7e8bb,
  title = {SMIR: An SEEG-Based Multisource Reconstruction Framework Revealing the Roles of Observation-Space Energy and Spatial Separability},
  author = {Shuyao Sun and Zhengping Wu and Haixian Wang and 刘焕光},
  year = {2026},
  doi = {10.1109/jsen.2026.3734286},
  url = {https://doi.org/10.1109/jsen.2026.3734286},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：SMIR：基于 SEEG 的多源重建框架揭示观测空间能量和空间可分离性的作用},
  abstract = {Stereo-electroencephalography (SEEG) offers high spatiotemporal resolution and direct access to deep brain activity, making it valuable for epilepsy evaluation, cognitive neuroscience, and brain–computer interfaces. However, each electrode records a mixture of multiple neural sources, making accurate multi-source reconstruction challenging. To address this, we propose the SEEG-based Multi-source Independent Reconstruction (SMIR) framework, which integrates hierarchical density-based clustering, stabilized independent component analysis, distributed source imaging, and Source Aggregation modules to separate and reconstruct the spatial configurations and time courses of multiple brain sources. We evaluated SMIR on 25 subjects funder simulated and clinical conditions. Under white noise at low signal-to-noise ratios, SMIR achieved stable single-source reconstruction, with the correlation being greater than 0.89 and the localization error less than 11 mm . For multiple equal-energy sources, average localization error was approximately 11.68 mm per source. When the source energy proportion in the observation space exceeded 0.1, performance of SMIR rapidly converged to stable and superior levels. In epileptogenic zone localization, SMIR predicted centroids within 10.61 ± 7.88 mm of resected contacts, significantly outperforming existing source imaging methods. Mechanistically, our results suggest that multi-source reconstruction is governed by competition for explanatory power over },
}

@misc{haixian_wang_0633fa8da776c9c3,
  title = {Alterations in Phase Synchronization During Epileptic Seizures: A Frequency-Based Multilayer EEG Network Analysis},
  author = {Dian Zhang and Jiuchuan Jiang and Yupeng Wang and John Q. Gan and Haixian Wang},
  year = {2025},
  doi = {10.1109/jsen.2025.3557802},
  url = {https://doi.org/10.1109/jsen.2025.3557802},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：癫痫发作期间相位同步的变化：基于频率的多层脑电图网络分析},
  abstract = {Epilepsy is a common neurological disorder, and electroencephalogram (EEG) is widely used for its detection and analysis. EEG-based functional brain networks play a key role in revealing epileptic seizure patterns. Multilayer networks, which can capture multiple types of interactions, have shown great potential in this domain. However, previous analysis frameworks often simplified multilayer networks into single-layer subnetworks, ignoring the multilayer structure, or adopted a multiplex analysis framework, ignoring the importance of inter-layer connections. In this study, we proposed a multi-level analysis framework for frequency-based multilayer networks, ranging from supra-adjacency matrix, subnetwork, node, layer, and global levels. We applied this framework to the TUH EEG Seizure Corpus (TUSZ) to investigate the phase synchronization changes between the interictal (between seizures) and ictal (during seizures) phases of epileptic seizures. Compared to the interictal phase, the ictal phase showed increased local connectivity, decreased overall network connectivity, and a shift from random to regular network organization. Meanwhile, cross-frequency coupling (CFC) analysis suggested that δ-γ (frontal and parietal-occipital regions) and θ-α (frontal and right frontal-temporal regions) bands are potentially associated with seizure propagation or termination. These findings provide insights for future analysis of CFC in seizures and intervention strategies by interpreting seiz},
}

@misc{haixian_wang_0952912454d9b921,
  title = {Seizure Detection Based on Multilayer Brain Network Features},
  author = {Dian Zhang and Haixian Wang},
  year = {2025},
  doi = {10.1109/icaace65325.2025.11019636},
  url = {https://doi.org/10.1109/icaace65325.2025.11019636},
  howpublished = {International Conference on Advanced Algorithms and Control Engineering (ICAACE)},
  annotation = {中文辅助译名：基于多层脑网络特征的癫痫发作检测},
  abstract = {Automated seizure detection can reduce the cost of long-term electroencephalography (EEG) monitoring and assist in the diagnosis of epilepsy. However, existing feature extraction methods primarily focus on the excessive discharge of brain neurons during seizures and fail to capture the altered synchronization in multichannel EEG signals. A frequency-based multilayer brain network was developed to model the complex interactions between different oscillation frequencies and brain regions. Topological features were extracted from each scale of the multilayer network, in combination with single-channel features, to enable patient-independent seizure detection. This approach achieved a sensitivity of 0.7301, a specificity of 0.9392, and an AVC of 0.9337 on the TUSZ dataset. The multilayer network-based method for capturing inter-channel synchronization variations from a phase perspective improves the sensitivity of short-duration seizure detection.},
}

@misc{haixian_wang_ea4ec3961163e288,
  title = {EEG Emotion Recognition Method Based on a Hybrid Perception Training Strategy},
  author = {Yuxuan Zhang and Haixian Wang},
  year = {2025},
  doi = {10.1145/3745034.3745044},
  url = {https://doi.org/10.1145/3745034.3745044},
  howpublished = {International Conference on Biomedical and Intelligent Systems (IC-BIS)},
  annotation = {中文辅助译名：基于混合感知训练策略的脑电情绪识别方法},
  abstract = {Emotion recognition technology based on electroencephalogram (EEG) has attracted much attention in brain activity analysis due to its millisecond-level temporal resolution. However, bottleneck problems such as significant differences in neural responses between individuals and complex spatiotemporal coupling characteristics of signals restrict the effectiveness of practical applications. This study innovatively proposed a hybrid perception-driven auxiliary enhanced spatiotemporal network (AETSN), whose core architecture adopts a dual-path collaborative mechanism: on the one hand, the electrode topological relationship is modeled through a graph convolutional network (GCN) to analyze the functional connection characteristics of brain regions, and on the other hand, the self-attention Transformer module is introduced to deeply mine the temporal dynamic patterns related to emotions. In order to further improve the generalization ability across subjects, a multimodal auxiliary training strategy is designed - the potential emotion representation of peripheral physiological signals (ECG/EDA) is extracted through pre-training auxiliary networks, and the feature alignment loss function is used to realize the knowledge transfer of the main and auxiliary networks. Experiments based on the DEAP benchmark dataset show that the model achieved an accuracy of 62.58% and 59.01% in the arousal and valence binary classification tasks, respectively, which is an average improvement of 2.3%-4.5% },
}

@misc{haixian_wang_8cd5e7a0f583fe4c,
  title = {Cross-Frequency Graph Neural Networks for EEG Based Motor Imagery},
  author = {Tingrui Wei and Haixian Wang},
  year = {2025},
  doi = {10.1109/icaace65325.2025.11018926},
  url = {https://doi.org/10.1109/icaace65325.2025.11018926},
  howpublished = {International Conference on Advanced Algorithms and Control Engineering (ICAACE)},
  annotation = {中文辅助译名：基于脑电图运动想象的跨频图神经网络},
  abstract = {Nowadays, the application of deep learning has significantly advanced motor imagery research, which is one of the major topic of brain-computer interfaces (BCIs). Traditional approaches primarily focus on extracting temporal features or leveraging spatial topological information from multi-channel EEG signals. However, these methods often overlook cross-frequency spatial interactions, which are crucial for capturing comprehensive neural dynamics. To address the issues mentions above, we propose a new model, Cross-Frequency Graph Neural Network (CF-GNN), which constructs graphs across different frequency bands to model both spatial and frequency-domain relationships. By applying a sliding window mechanism along the frequency dimension, our method adaptively captures cross-frequency spatial dependencies. Experimental results demonstrate that CF-GNN achieves classification accuracies of 80.24% on a four-class motor imagery dataset, gaining competitive results comparing to the baseline methods. The experiment results show the effectiveness of graph learning in capturing cross-frequency spatial interactions, offering a promising direction for enhancing the motor imagery classification accuracy.},
}

