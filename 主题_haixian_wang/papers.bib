@misc{haixian_wang_f05ee21c7dccf43d,
  title = {Regularized common spatial patterns with subject-to-subject transfer of EEG signals},
  author = {Minmin Cheng and Zuhong Lu and Haixian Wang},
  year = {2016},
  doi = {10.1007/s11571-016-9417-x},
  url = {https://doi.org/10.1007/s11571-016-9417-x},
  howpublished = {Cognitive Neurodynamics},
  annotation = {中文辅助译名：通过脑电图信号的主体间传输来规范化常见空间模式},
  abstract = {In the context of brain-computer interface (BCI) system, the common spatial patterns (CSP) method has been used to extract discriminative spatial filters for the classification of electroencephalogram (EEG) signals. However, the classification performance of CSP typically deteriorates when a few training samples are collected from a new BCI user. In this paper, we propose an approach that maintains or improves the recognition accuracy of the system with only a small size of training data set. The proposed approach is formulated by regularizing the classical CSP technique with the strategy of transfer learning. Specifically, we incorporate into the CSP analysis inter-subject information involving the same task, by minimizing the difference between the inter-subject features. Experimental results on two data sets from BCI competitions show that the proposed approach greatly improves the classification performance over that of the conventional CSP method; the transformed variant proved to be successful in almost every case, based on a small number of available training samples.},
}

@misc{haixian_wang_2d274fb47cbfa505,
  title = {Fnirs-Assisting bimodal EEG based SSVEP},
  author = {Zhaoxuan Li and Xinyu Huang and Gaopeng Sun and Yanhua Shi and Yue Leng and Yuankui Yang and Haixian Wang and Sheng Ge},
  year = {2016},
  doi = {10.1109/iccwamtip.2016.8079874},
  url = {https://doi.org/10.1109/iccwamtip.2016.8079874},
  howpublished = {International Computer Conference on Wavelet Active Media Technology and Information Processing (ICCWAMTIP)},
  annotation = {中文辅助译名：Fnirs-基于 SSVEP 的辅助双模态脑电图},
  abstract = {Traditional electroencephalographic (EEG)-based steady-state visual evoked potentials (SSVEPs) have been studied for decades. However, classification accuracy is still limited. One reason for this is the existence of false positives when subjects are not focusing on a stimulus or target. In this study, we used fNIRS signals to identify the time at which subject really focusing on the stimulus and shift the start of an epoch which will be sent for an EEG classifier. An offline SSVEP experiment results demonstrated that this method is feasible.},
}

