@misc{badong_chen_e02fe377c88609da,
  title = {Correntropy induced metric based common spatial patterns},
  author = {Nanning Zheng and Jiyao Dong and Na Lu and Haixian Wang and Badong Chen},
  year = {2017},
  doi = {10.1109/MLSP.2017.8168132},
  url = {https://doi.org/10.1109/MLSP.2017.8168132},
  howpublished = {MLSP},
  annotation = {中文辅助译名：基于熵诱导度量的常见空间模式},
  abstract = {Common spatial patterns (CSP) is a widely used method in the field of electroencephalogram (EEG) signal processing. The goal of CSP is to find spatial filters that maximize the ratio between the variances of two classes. The conventional CSP is however sensitive to outliers because it is based on the L2-norm. Inspired by the correntropy induced metric (CIM), we propose in this work a new algorithm, called CIM based CSP (CSP-CIM), to improve the robustness of CSP with respect to outliers. The CSP-CIM searches the optimal solution by a simple gradient based iterative algorithm. A toy example and a real EEG dataset are used to demonstrate the desirable performance of the new method.},
}

@misc{panorama_yang_yang_cee791fed9bf,
  title = {A Brain-Computer Interface Based on a Few-Channel EEG-fNIRS Bimodal System},
  author = {Yang Yang},
  year = {2017},
  doi = {10.1109/ACCESS.2016.2637409},
  url = {https://doi.org/10.1109/ACCESS.2016.2637409},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：基于少通道EEG-fNIRS双模系统的脑机接口},
  abstract = {With the development of the wearable brain-computer interface (BCI), a few-channel BCI system is necessary for its application to daily life. In this paper, we proposed a bimodal BCI system that uses only a few channels of electroencephalograph (EEG) and functional near-infrared spectroscopy (fNIRS) signals to obtain relatively high accuracy. We developed new approaches for signal acquisition and signal processing to improve the performance of this few-channel BCI system. At the signal acquisition stage, source analysis was applied for both EEG and fNIRS signals to select the optimal channels for bimodal signal collection. At the feature extraction stage, phase-space reconstruction was applied to the selected three-channel EEG signals to expand them into multichannel signals, thus allowing the use of the traditional effective common spatial pattern to extract EEG features. For the fNIRS signal, the Hurst exponents for the selected ten channels were calculated and composed of the fNIRS data feature. At the classification stage, EEG and fNIRS features were joined and classified with the support vector machine. The averaged classification accuracy of 12 participants was 81.2% for the bimodal EEG-fNIRS signals, which was significantly higher than that for either single modality.},
}

@misc{haixian_wang_438608600bf95c51,
  title = {The Distribution of Classification Accuracy Over the Whole Head for a Steady State Visual Evoked Potential Based Brain-computer Interface},
  author = {Gaopeng Sun and Yuankui Yang and Yue Leng and Haixian Wang and Sheng Ge},
  year = {2017},
  doi = {10.1016/j.procs.2017.03.123},
  url = {https://doi.org/10.1016/j.procs.2017.03.123},
  howpublished = {Procedia Computer Science},
  annotation = {中文辅助译名：基于稳态视觉诱发电位的脑机接口全头部分类精度分布},
  abstract = {Brain–computer interfaces (BCIs) system designed using the steady-state visual evoked potential (SSVEP) signal have been widely studied because of their high accuracy of classification and high rates of the information transfer. However, the SSVEP is typically measured over the occipital scalp region (channels O1, O2, and Oz), which makes this type of BCI unsuitable for some patients. We investigated the classification accuracy of SSVEP over the whole scalp, to evaluate the feasibility of building SSVEP-based BCIs that use additional channels. The classification accuracy distribution of the whole scalp increased with the electrode positions closer to the occipital region, and the classification accuracy increased with an increasing number of electroencephalogram data channels.},
}

@misc{haixian_wang_87e8be233ebdc913,
  title = {Action understanding based on a combination of one-versus-rest and one-versus-one multi-classification methods},
  author = {Yuankui Yang and Haixian Wang and Junfeng Gao and Keiji Iramina and Sheng Ge and Yue Leng and Gao-Peng Sun and Wengming Zheng and Yanhua Shi and Ruimin Wang and Hui Liu and Pan Lin},
  year = {2017},
  doi = {10.1109/CISP-BMEI.2017.8302159},
  url = {https://doi.org/10.1109/CISP-BMEI.2017.8302159},
  howpublished = {CISP-BMEI},
  annotation = {中文辅助译名：基于一对一和一对一多分类方法相结合的动作理解},
  abstract = {When people observe the actions of others, they naturally try to understand the underlying intentions. This behavior is called action understanding, and it has an important influence on mental development, language comprehension, and socialization. In this study, we used functional near-infrared spectroscopy (fNIRS) to obtain brain signals related to action understanding and then classified different intentions. Aiming to overcome the drawbacks of traditional multiclass classification methods of one-versus-rest (OVR) and one-versus-one (OVO), in this paper, we propose a new effective method to solve multiclass classification that is a combination of OVR and OVO. Compared with OVO, this new method effectively improved the accuracy of four-class classification from 25% to 48%.},
}

@misc{haixian_wang_d7e8fadadc3d5562,
  title = {One class support vector machine based filter for improving the classification accuracy of SSVEP BCI},
  author = {Sheng Ge and Hui Liu and Ruimin Wang and Yanhua Shi and Gao-Peng Sun and Keiji Iramina and Yue Leng and Yuankui Yang and Junfeng Gao and Pan Lin and Haixian Wang},
  year = {2017},
  doi = {10.1109/CISP-BMEI.2017.8302171},
  url = {https://doi.org/10.1109/CISP-BMEI.2017.8302171},
  howpublished = {CISP-BMEI},
  annotation = {中文辅助译名：基于一类支持向量机的滤波器，用于提高 SSVEP BCI 的分类精度},
  abstract = {Canonical correlation analysis (CCA) has been proved to be effective in the detection of steady state visual evoked potential (SSVEP) signals. However, the CCA method only chooses the frequency in the reference mode that corresponds to the maximum correlation value as the target. This may make the CCA output less robust. In this study, we propose a one-class support vector machine based filter to filter the sequences of correlation values in the process of the detection of SSVEP signals. The results demonstrate that the classification accuracy improved over different time windows for all subjects and the improvement achieved approximately 10% for some subjects. Moreover, the ratio of instructions that were filtered incorrectly was relative low (less than 5%) if the SSVEP signals were generated effectively.},
}

