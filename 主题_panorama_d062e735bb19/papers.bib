@misc{panorama_d062e735bb19_9665bf97e51ff741,
  title = {Real poems bear no poetic forms —New comments on the lyric of пушкин},
  author = {Zhang Wei},
  year = {1999},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=FSKS199904009},
  howpublished = {Journal of Foshan University},
  annotation = {中文辅助译名：真正的诗没有诗意的形式——对пушкин抒情诗的新评},
  abstract = {The lyric of лушкин bear the quality of being real, pure and simple. The clear and real passion makes his lyric simple in forms and the simple style suitably presents his real passion. In many of лушкин lyric, readers cannot make out that they are poems, nor realize the poet's thought, artistic method and figures of speech. Everything in his poems is natural and simple, but its artistic charm is obvious and perpetual.},
