  annotation = {中文辅助译名：托马斯·沃尔夫小说的翻译及其在中国的接受度},
  abstract = {As one of the most representative writers of Literature of the American South,Thomas Wolfe has enjoyed a wide readership in China since 1980s when his works began to be translated into Chinese.The translations offer many Chinese an access to the invaluable literary world of the Initiation Story and the Lost Generation.This paper,based on an overview of the transition studies of Wolfe and analysis,attempts to advance the following suggestions:1)Wolfe's fictional works contain insightful thoughts and much aesthetic value;2)several retranslated versions of Wolfe's works,though worthy,have not received adequate attention;3)Compared to the fruitful findings in Wolfe studies in fiction,the situation of fictional translation studies calls for more critical attention.Further research in the field,remaining unexplored,deserves to be conducted in depth.},
}

@misc{panorama_d062e735bb19_dd7a713f3432d926,
  title = {Toward allotetraploid cotton genome assembly: integration of a high-density molecular genetic linkage map with DNA sequence information},
  author = {Liang Zhao and Lv Yuanda and Cai Caiping and Tong Xiangchao and Chen Xiangdong and Zhang Wei and Du Hao and Guo Xiuhua and Guo Wangzhen},
  year = {2012},
  doi = {10.1186/1471-2164-13-539},
  url = {https://doi.org/10.1186/1471-2164-13-539},
  howpublished = {BMC genomics},
  annotation = {中文辅助译名：异源四倍体棉花基因组组装：高密度分子遗传连锁图与 DNA 序列信息的整合},
  abstract = {BACKGROUND: Cotton is the world's most important natural textile fiber and a significant oilseed crop. Decoding cotton genomes will provide the ultimate reference and resource for research and utilization of the species. Integration of high-density genetic maps with genomic sequence information will largely accelerate the process of whole-genome assembly in cotton. RESULTS: In this paper, we update a high-density interspecific genetic linkage map of allotetraploid cultivated cotton. An additional 1,167 marker loci have been added to our previously published map of 2,247 loci. Three new marker types, InDel (insertion-deletion) and SNP (single nucleotide polymorphism) developed from gene information, and REMAP (retrotransposon-microsatellite amplified polymorphism), were used to increase map density. The updated map consists of 3,414 loci in 26 linkage groups covering 3,667.62 cM with an average inter-locus distance of 1.08 cM. Furthermore, genome-wide sequence analysis was finished using 3,324 informative sequence-based markers and publicly-available Gossypium DNA sequence information. A total of 413,113 EST and 195 BAC sequences were physically anchored and clustered by 3,324 sequence-based markers. Of these, 14,243 ESTs and 188 BACs from different species of Gossypium were clustered and specifically anchored to the high-density genetic map. A total of 2,748 candidate unigenes from 2,111 ESTs clusters and 63 BACs were mined for functional annotation and classification. The 33},
}

