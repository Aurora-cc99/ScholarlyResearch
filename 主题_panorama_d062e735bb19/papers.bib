@misc{panorama_d062e735bb19_2fa6ba43d71c666f,
  title = {Exploring the mediating role of curiosity and confidence between digital interaction and math achievement},
  author = {Millicent Aziku and Dahman Tahri and Denis Djekourmane and Zhang Wei},
  year = {2026},
  doi = {10.1016/j.chbr.2026.101156},
  url = {https://doi.org/10.1016/j.chbr.2026.101156},
  howpublished = {Computers in Human Behavior Reports},
  annotation = {中文辅助译名：探索好奇心和信心在数字交互和数学成绩之间的中介作用},
  abstract = {The association between digital interaction and math achievement has been expansively investigated. However, the role of mechanisms such as curiosity and math confidence in this relationship is not well established. Guided by the self-determination theory, the current study explored the mediating role of curiosity and math confidence in the relationship between digital interaction and math achievement among 15-year-olds (N = 613,744) who participated in the Programme for International Student Assessment (PISA) 2022. Using a partial least-squares structural equation modeling (PLS-SEM) approach, the results revealed a significant negative association between digital interaction and math achievement. The findings also show that increased curiosity and math confidence enhanced math achievement. Finally, curiosity and math confidence positively and significantly mediated the relationship between digital interaction and math achievement. By integrating curiosity and math confidence as self-determination theory aligned motivational mechanisms within a large-scale PLS-SEM framework, this study extends the theory to explain how digital interaction influences achievement through internal psychological pathways.},
}

@misc{panorama_d062e735bb19_55c772b0aed1c26d,
  title = {Fan dance, masked dance, and the divine in East Asia/China},
  author = {Zhang Wei},
  year = {2024},
  doi = {10.4324/9781003455073-3},
  url = {http://dx.doi.org/10.4324/9781003455073-3},
  howpublished = {Routledge eBooks},
  annotation = {中文辅助译名：东亚/中国的扇子舞、假面舞和神},
  abstract = {This chapter focuses on the traditional performance of Japan and Korea: the differences of the use of Japanese fans in noh , kyogen , and kabuki ; the dynamic interconnections between Japanese noh (能剧), Chinese nuoxi (傩戏，including nuowu 傩舞), and Korean talchum (mask dance drama 假面戏/舞), all imbued with a palpable sense of worship, the divine, and Shamanism. More particularly, this chapter discusses the distinctive characteristics of the Chinese Nanfeng nuowu and Korean Bongsan talchum as the typical examples of Chinese nuoxi (傩戏) and Korean talchum (mask dance drama) through analysis of the ritual procedure, props, movements, masks, and other characteristics of these performances.},
}

@misc{panorama_d062e735bb19_37dd0c206aceb01d,
  title = {Golden-winged bird, flying apsaras, Thousand-Hand Avalokitesvara, and Indian Buddhism influence on performance arts in China},
  author = {Zhang Wei},
  year = {2024},
  doi = {10.4324/9781003455073-4},
  url = {http://dx.doi.org/10.4324/9781003455073-4},
  howpublished = {Routledge eBooks},
  annotation = {中文辅助译名：金翅鸟、飞天、千手观音以及印度佛教对中国表演艺术的影响},
  abstract = {This chapter first traces the Indian Buddhism influence on the western regions of historical China, including the image of the golden-winged bird in Qiuci murals and the performance genre such as lion dance. It then goes into a comparative analysis of the hand gestures of Indian Natyasastra, Bharatanatyam, and Kathakali, and the style of hand gesture featured on the Qiuci mural, Dunhuang mural, especially the representation of the Buddhism figure of “flying apsaras” and “Thousand-Hand Avalokitesvara” from the grottoes’ images, which is used in modern times both in training and in professional productions in China. This chapter concludes with a brief discussion of the use of flying apsara dance in China and apsara dance in Cambodia, both showing the indelible influence of Indian culture.},
}

@misc{panorama_d062e735bb19_490179acd0460cc9,
  title = {On the Semantic Types and Formation Causes of「V+zai+NPL」Structure in Modern Chinese Language},
  author = {Zhang Wei},
  year = {2023},
  doi = {10.58664/mustjournal.2023.06.008},
  url = {http://dx.doi.org/10.58664/mustjournal.2023.06.008},
  howpublished = {Journal of Macau University of Science and Technology},
  annotation = {中文辅助译名：论现代汉语“V+在+NPL”结构的语义类型及成因},
  abstract = {Based on the “zai + NPL” indicating “real space location”, this paper takes further study on the semantic relationship between V which indicates action and “zai + NPL” which indicates location after their combination in Chinese. First, upon a deep observation of the example sentences from CCL corpus, this paper shows that the semantic types of “V + zai + NPL” structure can be divided into three categories at the synchronic level: action result, dynamic progress and static-existence. Secondly, compared with the semantic type of structure “zai + NPL + V”, it has been found that the action V of admitting the structure has formed a continuum in semantic features. Combined diachronic corpus and previous researches, this paper proved that the three semantic types of “V +zai+ NPL” are actually a diachronic continuum from weak to strong. Finally, this paper explored the causes of word order of the combination of “zai+NPL” and V, finding that the formation of structure “V+zai+NPL” is driven by both Abstract Principle and Iconic Principle, while the structure “zai+NPL+ V” is driven only by the Iconic Principle.},
}

