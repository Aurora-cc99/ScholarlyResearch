@misc{panorama_d062e735bb19_1ab45c085e94ec0d,
  title = {The Way out for Literary Publication in Time of Digital Reading——A Co-discussion on the Innovation in the Publication Mode of Digital Literature in Terms of Study of Reading Ecology},
  author = {Zhang Wei},
  year = {2013},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=SXSS201304013},
  howpublished = {Journal of Shaanxi Normal University},
  annotation = {中文辅助译名：数字阅读时代文学出版的出路——从阅读生态研究谈数字文学出版模式创新},
  abstract = {The renewal of perception and innovation of mode of the world of publication is the key step and prerequisite of transformation of literary publication industry in the current digital reading times.Literary reading is essentially an organic interaction between author and reader through literary text.The publishing media's participation in digital literary reading creates a vigorous ecological system for reading,in which the author,literary editor and reader together take part in a never-ending process of cultural creation.Although losing his monopoly in text duplication in the digital reading times,the literary publisher can program and design a publishing mode of digital literature in terms of literary reading activity by transferring literary publication from simple literary text duplication to offer service and guide in literary reading so as to bring literary publication to another brilliant summit in the digital reading times.},
}

@misc{panorama_d062e735bb19_a3ba645f2bee76be,
  title = {Latching/Rush-Through as a Turn-Holding Device and Its Functions in Retrospectively Oriented Pre-Emptive Turn Continuation: Findings from Mandarin Conversation},
  author = {Zhang Wei},
  year = {2012},
  doi = {10.1080/0163853x.2012.658501},
  url = {https://doi.org/10.1080/0163853x.2012.658501},
  howpublished = {Discourse Processes},
  annotation = {中文辅助译名：闭锁/冲通作为转弯保持装置及其在回顾性先发制人转弯延续中的功能：普通话对话的发现},
  abstract = {This article offers an interactional account of turn continuations in Chinese conversation, which are characterized as (a) being effected by latching/rush-through, (b) being clauses with predicates, either main or adverbial, and (c) taking a retrospective orientation in the kind of interactional work they do. Close examination reveals that while, in general, these continuations provide explanation, specification, or elaboration, they serve to address aspects of immediate prior talk as deemed inadequate in given interactional/sequential contexts. Findings show that a turn's possible completion point is an organizationally consequential place around which one can indicate turn continuation, should the need come up later in the turn. A prime way to bid for turn continuation at this place is the use of prosody.},
}

@misc{panorama_d062e735bb19_b23610004bbbc0a6,
  title = {An Analysis of Translator's Subjectivity from Comparative Research of Chinese Versions of Shakespearean Sonnets},
  author = {Zhang Wei},
