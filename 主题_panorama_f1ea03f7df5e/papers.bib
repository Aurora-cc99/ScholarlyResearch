  author = {L Zhang and Xueqin Cheng and Chunli Wang and Zhou Wei and Bixia Zheng and Aihua Zhang},
  year = {2024},
  doi = {10.1093/ckj/sfae124},
  url = {https://doi.org/10.1093/ckj/sfae124},
  howpublished = {Clinical Kidney Journal},
  annotation = {中文辅助译名：患有婴儿期蛋白尿和运动障碍的儿童中 ANKFY1 的复合杂合变异体},
  abstract = {ABSTRACT The ANKFY1 gene encodes a protein that belongs to double zinc finger proteins involved in endocytosis. Only one family with steroid-resistant nephrotic syndrome has been reported carrying a homozygous variant in ANKFY1 so far. Here we describe the second case where a 13-year-old boy presented with infantile-onset proteinuria and movement disorder. Whole-exome sequencing showed compound heterozygous variants (NM_001330063.2: c.2753C>G; p.Ser918Ter, and c.3287–11_3287–10del) in ANKFY1. In vitro functional study revealed the two variants led to reduced protein expression level of ANKFY1. This is the first case of co-existence of renal and nervous system phenotypes in a child with variants in ANKFY1, suggesting that bi-allelic variants in ANKFY1 might be associated with a new neuro-renal syndrome.},
}

