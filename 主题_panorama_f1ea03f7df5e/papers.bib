@misc{panorama_f1ea03f7df5e_02ece449f742dafd,
  title = {A viral effector blocks the turnover of a plant NLR receptor to trigger a robust immune response},
  author = {Chunli Wang and Min Zhu and Hao Hong and Jia Li and Chongkun Zuo and Yu Zhang and Yajie Shi and Suyu Liu and Haohua Yu and Yuling Yan and Jing Chen and Lingna Shangguan and Aiping Zhi and Rongzhen Chen and Karen Thulasi Devendrakumar and Xiaorong Tao},
  year = {2024},
  doi = {10.1038/s44318-024-00174-6},
  url = {https://doi.org/10.1038/s44318-024-00174-6},
  howpublished = {The EMBO Journal},
  annotation = {中文辅助译名：病毒效应子阻断植物 NLR 受体的更新，从而触发强大的免疫反应},
  abstract = {Plant intracellular nucleotide-binding and leucine-rich repeat immune receptors (NLRs) play a key role in activating a strong pathogen defense response. Plant NLR proteins are tightly regulated and accumulate at very low levels in the absence of pathogen effectors. However, little is known about how this low level of NLR proteins is able to induce robust immune responses upon recognition of pathogen effectors. Here, we report that, in the absence of effector, the inactive form of the tomato NLR Sw-5b is targeted for ubiquitination by the E3 ligase SBP1. Interaction of SBP1 with Sw-5b via only its N-terminal domain leads to slow turnover. In contrast, in its auto-active state, Sw-5b is rapidly turned over as SBP1 is upregulated and interacts with both its N-terminal and NB-LRR domains. During infection with the tomato spotted wilt virus, the viral effector NSm interacts with Sw-5b and disrupts the interaction of Sw-5b with SBP1, thereby stabilizing the active Sw-5b and allowing it to induce a robust immune response.},
}

@misc{panorama_f1ea03f7df5e_c8656b971f955bb2,
  title = {Serum vitamin C levels and their correlation with chronic kidney disease in adults: a nationwide study},
  author = {Chunli Wang and Jili Zhao and Qiaoqiao Zhou and Jing Li},
  year = {2024},
  doi = {10.1080/0886022x.2023.2298079},
