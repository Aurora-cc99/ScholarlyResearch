  year = {2023},
  doi = {10.1109/ic2ecs60824.2023.10493368},
  url = {http://dx.doi.org/10.1109/ic2ecs60824.2023.10493368},
  howpublished = {International Conference on Electrical Engineering and Control Science (IC2ECS)},
  annotation = {中文辅助译名：基于PSO的光伏电站储能容量优化分配方法},
  abstract = {Based on the analysis of the load curve of a substation with photovoltaic system in a region, the minimum initial investment cost of substation energy storage is taken as the objective function, and the N-1 guideline for the main transformer, the energy conservation in the charge and discharge cycle, the energy storage power and the state of charge (SOC) are taken as the constraints. With these constraints, the optimal model of energy storage access to substation is established. In this paper, due to the nonlinear programming problem with constraints, the particle swarm optimization (PSO) algorithm is proposed to solve the model. A typical 110 kV substation is selected, combined with its load curve, the optimal configuration capacity of energy storage and the charging and discharging law of energy storage are obtained by optimization analysis. The results show that it is reasonable to configure the substation energy storage power at 8 % and 2 h of electricity, which verifies the effectiveness and practicability of the proposed method.},
}

