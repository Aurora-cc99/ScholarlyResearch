@misc{shiguang_shan_764304b51111c160,
  title = {V-Attack: Targeting Disentangled Value Features for Controllable Adversarial Attacks on LVLMs},
  author = {Jie Zhang and Sen Nie and Xilin Chen and Jianxin Yan and Shiguang Shan},
  year = {2026},
