@misc{shiguang_shan_00be4da29e773a17,
  title = {MDS: a multimodal-based dialog system},
  author = {Jiyong Ma and Wen Gao and Xilin Chen and Shiguang Shan and Wei Zeng and Jie Yan and Hongming Zhang and Jiang Wu and Feng Wu and Chunli Wang},
  year = {2000},
  doi = {10.1145/354384.378974},
  url = {https://doi.org/10.1145/354384.378974},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：MDS：基于多模态的对话系统},
  abstract = {This paper describes MDS: a Multimodal-based Dialog System that supports communication between the hearing impaired and hearing-abled. The system converts sign language to speech, and combines speech with gesture and lip motion using a human face. The features of the human face are derived by doing a 3D feature extraction of the speaker's face, so that the “virtual face” similar to the actual speaker. The main technologies associated with the system include sign language recognition, sign language synthesis and the synchrony of the lip movement and speech. Integration of the sign language recognition, sign language synthesis, speech recognition, speech synthesis and 3D virtual human technologies provides a new way to interact with computers for the hearing impaired.},
}
