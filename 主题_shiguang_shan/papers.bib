@misc{shiguang_shan_1cd7a25541fa8aa8,
  title = {Leveraging Eye Movement for Instructing Robust Video-Based Facial Expression Recognition},
  author = {Zhe Chen and Zijing Chen and Chang Tang and Yuanyuan Liu and Lin Wei and Kejun Liu and Jingying Chen and Shiguang Shan},
  year = {2025},
