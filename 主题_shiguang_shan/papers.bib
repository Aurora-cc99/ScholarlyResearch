@misc{shiguang_shan_b5140582b7063a53,
  title = {EgoMotion: Hierarchical Vision-Language Learning and Diffusion for Egocentric Motion Generation},
  author = {Ruibing Hou and Mingyue Zhou and Yuwei Gui and Mingshuang Luo and Bingpeng Ma and Hong Chang and Shiguang Shan and Xilin Chen},
  year = {2026},
