@misc{shiguang_shan_a832f3a8a3a7b10b,
  title = {DeepBias: Adaptive In-depth Probing of Social Biases in LVLMs},
  author = {Songkai Xue and Zhongqi Wang and Jie Zhang and Jiahao Wang and Anqi Li and Xilin Chen and Shiguang Shan},
