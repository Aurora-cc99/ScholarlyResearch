  annotation = {中文辅助译名：学习用于个性化图像检索的多功能二进制代码},
}

@misc{shiguang_shan_70cdf659c4b6f84e,
  title = {Facial Expression Recognition for In-the-wild Videos},
  author = {Jiabei Zeng and Hanyu Liu and Shiguang Shan},
  year = {2020},
  doi = {10.1109/FG47880.2020.00102},
  url = {https://doi.org/10.1109/FG47880.2020.00102},
  howpublished = {FG},
  annotation = {中文辅助译名：野外视频的面部表情识别},
  abstract = {In this paper, we propose a method for facial expression recognition for in-the-wild videos. Our method combines Deep Residual Network (ResNet) and Bidirectional Recurrent Neutral Network with Long-Short-Term Memory Unit (BLSTM). This method won the 2ndplace in the seven basic expression classification track of Affective Behavior Analysis in-the-wild Competition held in conjunction with the IEEE International Conference on Automatic Face and Gesture Recognition (FG) 2020, achieving 66.9% accuracy and 40.8% final metric on the test set. We also visualize the learned attention maps and analyze the importance of different regions in facial expression recognition.},
}

@misc{shiguang_shan_3671154134c8ebf7,
  title = {Emotion Recognition for In-the-wild Videos},
  author = {Jiabei Zeng and Hanyu Liu and Xilin Chen and Shiguang Shan},
