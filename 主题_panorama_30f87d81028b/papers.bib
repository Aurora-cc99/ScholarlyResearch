  howpublished = {World Conference on Computing and Communication Technologies (WCCCT)},
  annotation = {中文辅助译名：用于弹道目标识别的快照集成一维卷积神经网络},
  abstract = {Aiming at improving the performance of ballistic target HRRP recognition, a ballistic target HRRP recognition method based on snapshot ensemble one-dimensional convolutional neural network (SSE-1DCNN) is proposed. The snapshot ensemble model is constructed by integrating a single 1DCNN estimator with a cosine annealing scheduler. The snapshot ensemble integrates 1DCNN estimators at different loss function minima in the same training process, which ensures the diversity of training estimators and avoids the increase in training cost for estimator ensemble. In addition, the AdamW algorithm is introduced to improve the convergence speed and degree of the ensemble training. The experimental results show that the use of snapshot ensemble can effectively improve the recognition of ballistic target HRRP by the 1DCNN, and the introduction of AdamW effectively improves the convergence effect. Compared with a single 1DCNN estimator, the optimal average recognition accuracy of SSE-1DCNN is improved by 0.31% withinside the hyperparameter experimental setting ranges.},
}

@misc{panorama_30f87d81028b_4569537d4dae0f96,
  title = {A High-Order Tracking Differentiator for Improved Filtering and Derivative Estimation},
  author = {Shanhai Jin and Xinyue Tian and Dejin Zhao and Xiaodan Wang and Changfu Jin},
  year = {2023},
  doi = {10.1109/icar58858.2023.10406727},
  url = {https://doi.org/10.1109/icar58858.2023.10406727},
  howpublished = {International Conference on Advanced Robotics (ICAR)},
  annotation = {中文辅助译名：用于改进滤波和导数估计的高阶跟踪微分器},
  abstract = {The task of filtering and estimating derivatives from noisy signals is crucial in feedback control systems. While linear filtering methods are widely used due to their simplicity, they can introduce significant phase lag and amplify noise, negatively impacting system performance. To address these limitations, researchers have investigated tracking differentiators (TD) based on sliding mode techniques. However, existing TD methods are restricted to estimating first-order or arbitrary order derivatives with significant overshoot during the process. To overcome these challenges, this paper proposes a novel high-order sliding mode tracking differentiator (TD-N) with gains adjusted using a nested signum function to provide reliable high-order derivative estimation without excessive overshoot. The simulation results confirm the effectiveness and advantages of the proposed TD-N.},
}

