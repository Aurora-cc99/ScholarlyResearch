@misc{panorama_30f87d81028b_12f3a7e2756b240a,
  title = {Research on shared bike supply-demand forecasting and regional dispatching strategy based on improved long short-term memory network},
  author = {Xiaodan Wang and Jiahong Zhu},
  year = {2026},
  doi = {10.1117/12.3118778},
  url = {https://doi.org/10.1117/12.3118778},
  howpublished = {International Conference on Intelligent Transportation and Smart Cities (ICITSC)},
  annotation = {中文辅助译名：基于改进长短期记忆网络的共享单车供需预测及区域调度策略研究},
  abstract = {Bike Sharing Systems (BSS) face key challenges of supply-demand imbalance and low regional dispatching efficiency. These challenges stem from limitations in existing studies—most rely on static statistical models or shallow learning methods, which fail to capture the spatio-temporal correlation of users’ travel behavior and the randomness of demand fluctuations. To address this issue, this paper proposes a demand forecasting model combining Markov Chain (MC) and Long Short-Term Memory (LSTM) network. The Markov Chain is used to model the transition probability of users’ travel states between different regions, while the LSTM learns long-term temporal dependencies. This paper also designs a two-stage regional dispatching strategy, which uses the output of the proposed model to optimize initial bike allocation and conduct real-time rebalancing. Experimental results show that compared with traditional LSTM and ARIMA models, the proposed model reduces prediction errors by 12.3% to 18.7%; the dispatching strategy shortens users’ waiting time by 21.5% and increases bike utilization rate by 15.8%. This study provides a practical solution for improving the operational efficiency of Bike Sharing Systems.},
}

