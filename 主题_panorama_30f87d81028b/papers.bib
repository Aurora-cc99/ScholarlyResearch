  annotation = {中文辅助译名：固体火箭发动机容器可靠性分析},
  abstract = {A simulating test of solid rocket engine under the hydrostatic was made.The finite element model of solid rocket engine shell was established and the maximum stress area was found by using the ANSYS software.Then the reliability was calculated by using stochastic finite element analysis.Load of the shell was increased and the reliability was calculated again by the basis of upper result.Analysis showed that the original design load is conservative and larger load can be exerted.The sensitivity analysis of structure parameters provided theory basis for the optimization design of the structure.},
}

@misc{panorama_30f87d81028b_6b43ea86804bbbdb,
