  author = {Jiaxing He and Xiaodan Wang and Yafei Song},
  year = {2024},
  doi = {10.1145/3718491.3718626},
  url = {https://doi.org/10.1145/3718491.3718626},
  howpublished = {Asia-Pacific Artificial Intelligence and Big Data Forum (AIBDF)},
  annotation = {中文辅助译名：一种基于CNN和Transformer的多尺度网络入侵检测方法},
  abstract = {Addressing the challenges in feature extraction for network intrusion detection due to vast high-dimensional traffic data, a novel approach integrating the Variational Gaussian Model (VGM) with a Convolutional Neural Network-Transformer (referred to as CNN-Transformer, or CTA-IDS) has been introduced, termed CTA-IDS. This system leverages VGM and OneHot encoding to preprocess the initial dataset, simplifying intricate features into more manageable components. Subsequently, a Convolutional Neural Network-Transformer fusion network designed for multi-scale feature selection, known as CTA-Net, is deployed to streamline network complexity. The efficacy of this approach is substantiated through experimental validation. The findings from these experiments indicate: 1) VGM-processed data significantly boosts detection precision; 2) When juxtaposed with three alternative convolutional neural networks, CTA-IDS markedly improves detection accuracy.},
}

@misc{panorama_30f87d81028b_5b75b34c31ffda8f,
  title = {Class-Agnostic Dual-Branch Network for Few-Shot SAR Target Recognition},
  author = {Songhao Shi and Xiaodan Wang and Yafei Song and Pengfei Guo},
  year = {2024},
  doi = {10.1109/cac63892.2024.10865568},
  url = {https://doi.org/10.1109/cac63892.2024.10865568},
  howpublished = {China Automation Congress (CAC)},
  annotation = {中文辅助译名：用于少镜头 SAR 目标识别的类无关双分支网络},
  abstract = {To address potential bottlenecks in cross-domain transfer for few-shot SAR target recognition, we overcome the limitations of source domain category attributes and propose a model named Class-Agnostic Dual-branch ProtoNet (CADP-Net). In this network, the global and local branches are designed to extract global and local features of the image, respectively, which are then mapped to a more discriminative space through a multi-layer perceptron. The dual-branch network is trained using moving exponential averaging under the consistency constraint of classification prediction. This approach can generalize a universal recognition strategy regardless of the target's category attributes, reduce intra-class distances, and increase inter-class distances. As a result, it enhances the ability to learn transferable representations in cross-domain few-shot tasks for SAR images. Experiments on the MSTAR dataset effectively validate our method.},
}

@misc{panorama_30f87d81028b_8e227451e5f88324,
  title = {AutoLDT: a lightweight spatio-temporal decoupling transformer framework with AutoML method for time series classification},
  author = {Peng Wang and Ke Wang and Yafei Song and Xiaodan Wang},
  year = {2024},
  doi = {10.1038/s41598-024-81000-1},
  url = {https://doi.org/10.1038/s41598-024-81000-1},
  howpublished = {Scientific Reports},
  annotation = {中文辅助译名：AutoLDT：一种轻量级时空解耦Transformer框架，采用 AutoML 方法进行时间序列分类},
  abstract = {Time series classification finds widespread applications in civil, industrial, and military fields, while the classification performance of time series models has been improving with the recent development of deep learning. However, the issues of feature extraction effectiveness, model complexity, and model design uncertainty constrain the further development of time series classification. To address the above issues, we propose a Lightweight Spatio-Temporal Decoupling Transformer framework based on Automated Machine Learning technique (AutoLDT). The framework proposes a novel lightweight Transformer with fuzzy position encoding, TS-separable linear self-attention mechanism, and convolutional feedforward network, which mine the temporal and spatial features, as well as the local and global relationship of time series. Fuzzy positional encoding integrates fuzzy ideas to enhance the generalization performance of model information mining. TS-separable linear self-attention mechanism and convolutional feedforward network achieve feature extraction in a lightweight way by decoupling temporal and spatial features of time series. Notably, we adopt the Covariance Matrix Adaptation Evolution Strategy and global adaptive pruning technique to realize automated network structure design, which further improves the model training efficiency and automation, and avoids the uncertainty problem of network design. Finally, we validate the effectiveness of the proposed framework on publicly avai},
}

