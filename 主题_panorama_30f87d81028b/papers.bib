@misc{panorama_30f87d81028b_bbcad3a31b7a72f9,
  title = {Emotion-Conditioned MusicLM: Enhancing Emotional Resonance in Music Generation},
  author = {Yuelang Sun and Matthew M. Y. Kuo and Xiaodan Wang and Weihua Li and Quan Bai},
  year = {2024},
  doi = {10.1109/cec60901.2024.10612075},
  url = {https://doi.org/10.1109/cec60901.2024.10612075},
  howpublished = {IEEE Congress on Evolutionary Computation (CEC)},
  annotation = {中文辅助译名：情感调节的音乐LM：增强音乐生成中的情感共鸣},
  abstract = {Nowadays, most music generation models are limited to accepting conditions from a single modality, whether text-based or neural signal-based. For most users, text represents the most accessible and intuitive input modality. However, this often dilutes the text's emotional characteristics, misaligning the emotional depth in the final music output. This article presents comprehensive research and improvement in the text-conditioned music generation model, named Emotion-Conditioned MusicLM. Building upon the existing text-conditioned music generation model, MusicLM, ECMusicLM is designed to generate music with a deeper emotional resonance while maintaining the high quality of musical output. Our research shows that combining text and emotional elements in music generation leads to the creation of emotionally resonant music. Through the experiments, ECMusicLM showed a notable capability in capturing implicit Valence-Arousal features from text prompts, significantly enhancing the emotional depth of the generated music. This study not only pushes the boundaries of AI in artistic creation but also opens avenues for future research in multi-modal emotional synthesis.},
}

@misc{panorama_30f87d81028b_a6ac4944f2992549,
  title = {Transfer Learning in Few Shot SAR Target Recognition: Contrastive Learning Matters},
  author = {Songhao Shi and Xiaodan Wang},
  year = {2024},
  doi = {10.1109/cvidl62147.2024.10604039},
  url = {http://dx.doi.org/10.1109/cvidl62147.2024.10604039},
  howpublished = {International Conference on Computer Vision, Image and Deep Learning (CVIDL)},
  annotation = {中文辅助译名：少镜头 SAR 目标识别中的迁移学习：对比学习很重要},
  abstract = {Considering the constraints inherent in transfer learning for few-shot Synthetic Aperture Radar (SAR) target recognition, we have investigated the possibilities presented by contrastive learning during the pre-training phase. This approach promises to enhance the model’s ability to capture more generalized and transferable features. To this end, we have devised a customized global-spatial pre-training contrastive loss, specifically tailored for few-shot SAR target recognition. This unique loss function directs the model’s attention to discriminatory semantic details, allowing for the extraction of supplementary features from optical images that can seamlessly translate to SAR images. After rigorous testing, our method has proven to provide excellent classification accuracy within the SAR imagery domain, especially under scenarios with limited samples. This underscores the significance of acquiring transferable features for few-shot learning in the context of SAR images.},
}

@misc{panorama_30f87d81028b_a588710f821522ad,
