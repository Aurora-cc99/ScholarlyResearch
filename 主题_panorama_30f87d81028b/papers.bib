@misc{panorama_30f87d81028b_b942998bbbc72432,
  title = {KMP Image Fast Matching Algorithms Based on Subtracting Matrix},
  author = {Xiaodan Wang},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=WJSJ201002081},
  howpublished = {Microcomputer Information},
  annotation = {中文辅助译名：基于减法矩阵的KMP图像快速匹配算法},
  abstract = {Because algorithms based on KMP applying to image matching has low efficiency and low success rate while pictures have noise or grays of template are different from grays of corresponding child picture, algorithm based on two-value subtracting matrix are used to improved it. In this algorithm, numbers in picture matrixes are subtracted using a model matrix firstly, search every row and find the probable matching locations in KMP method with two-value matrix, compare all of these locations and select the most suited location on the whole. At the same time, marking the preliminary number’s location in the process of matching can reduce searching room and improve matching efficiency. Experiment shows that matching velocity is increased without the loss of matching accuracy evidently using this algorithm.},
}

@misc{panorama_30f87d81028b_b48eb8bb499f8ab4,
  title = {A Dynamic Data Middleware Cache for Rapidly-growing Scientific Repositories},
  author = {Tanu Malik and Xiaodan Wang and Philip Little and Amitabh Chaudhary and Ani Thakar},
  year = {2010},
  doi = {10.48550/arxiv.1009.3665},
  url = {http://arxiv.org/abs/1009.3665},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：适用于快速增长的科学存储库的动态数据中间件缓存},
  abstract = {Modern scientific repositories are growing rapidly in size. Scientists are increasingly interested in viewing the latest data as part of query results. Current scientific middleware cache systems, however, assume repositories are static. Thus, they cannot answer scientific queries with the latest data. The queries, instead, are routed to the repository until data at the cache is refreshed. In data-intensive scientific disciplines, such as astronomy, indiscriminate query routing or data refreshing often results in runaway network costs. This severely affects the performance and scalability of the repositories and makes poor use of the cache system. We present Delta, a dynamic data middleware cache system for rapidly-growing scientific repositories. Delta's key component is a decision framework that adaptively decouples data objects---choosing to keep some data object at the cache, when they are heavily queried, and keeping some data objects at the repository, when they are heavily updated. Our algorithm profiles incoming workload to search for optimal data decoupling that reduces network costs. It leverages formal concepts from the network flow problem, and is robust to evolving scientific workloads. We evaluate the efficacy of Delta, through a prototype implementation, by running query traces collected from a real astronomy survey.},
}

@misc{panorama_30f87d81028b_df3b8edb7fc135ba,
  title = {Research on the characteristic of the probabilistic outputs via random ECOC},
  author = {Xiaodan Wang and Jindeng Zhou},
  year = {2010},
  doi = {10.1109/pic.2010.5687435},
  url = {https://doi.org/10.1109/pic.2010.5687435},
  howpublished = {IEEE International Conference on Progress in Informatics and Computing},
  annotation = {中文辅助译名：随机ECOC概率输出特性研究},
  abstract = {Error-correcting output codes (ECOC) is an efficient method to solve the problem of multi-class classification, and how to get the accurate probability estimation via ECOC is also attractive for many applications. The characteristic of the probabilistic outputs via random ECOC is analyzed in this paper, and the proof is given for that the probability output based on random ECOC is the unbiased estimation. Experimental results validate the correctness of our conclusion.},
}

@misc{panorama_30f87d81028b_89e619034b4044a1,
  title = {JAWS: Job-Aware Workload Scheduling for the Exploration of Turbulence Simulations},
  author = {Xiaodan Wang and Eric Perlman and Randal C. Burns and Tanu Malik and Tamás Budavári and Charles Meneveau and Alexander S. Szalay},
  year = {2010},
  doi = {10.1109/sc.2010.31},
  url = {https://doi.org/10.1109/sc.2010.31},
  howpublished = {International Conference for High Performance Computing, Networking, Storage and Analysis (SC)},
  annotation = {中文辅助译名：JAWS：用于探索湍流模拟的作业感知工作负载调度},
  abstract = {We present JAWS, a job-aware, data-driven batch scheduler that improves query throughput for data-intensive scientific database clusters. As datasets reach petabyte-scale, workloads that scan through vast amounts of data to extract features are gaining importance in the sciences. However, acute performance bottlenecks result when multiple queries execute simultaneously and compete for I/O resources. Our solution, JAWS, divides queries into I/O-friendly sub-queries for scheduling. It then identifies overlapping data requirements within the workload and executes sub-queries in batches to maximize data sharing and reduce redundant I/O. JAWS extends our previous work by supporting workflows in which queries exhibit data dependencies, exploiting workload knowledge to coordinate caching decisions, and combating starvation through adaptive and incremental trade-offs between query throughput and response time. Instrumenting JAWS in the Turbulence Database Cluster yields nearly three-fold improvement in query throughput when contention in the workload is high.},
}

@misc{panorama_30f87d81028b_7c4fde0510dedeb7,
  title = {New feature selection approach by PCA and ReliefF},
  author = {Jiang Yu-jiao and Xiaodan Wang and Wenjun Wang and Kai Bi},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=JSGG201026055},
  howpublished = {Computer Engineering and Applications Journal},
  annotation = {中文辅助译名：PCA 和 ReliefF 的新特征选择方法},
  abstract = {How to decrease the time of training and testing the samples,and improve the classification accuracy are important aspects of the feature selection research.A new feature selection approach by PCA and ReliefF is presented in this paper.The algorithm can take out the most representative features which constitute the effective feature sets from the original features,thus the dimensions of the features are decreased.Moreover the algorithm is proven to be more advantageous than the approach of PCA-GA in its simplicity and speed.Experiments on a UCI dataset show that the method in this paper provides a new research approach for information feature compression in pattern recognition.},
}

@misc{panorama_30f87d81028b_b95532a27c23435f,
