@misc{panorama_30f87d81028b_2e35c3167556d385,
  title = {Research on Colorectal Cancer Segmentation Algorithm Based on Deep Learning},
  author = {Jing Zhao and Xiaodan Wang and Chenxi He},
  year = {2025},
