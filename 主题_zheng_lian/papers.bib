  year = {2025},
  doi = {10.1109/icassp49660.2025.10890470},
  url = {https://doi.org/10.1109/icassp49660.2025.10890470},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：部分 Deepfake 音频定位的对抗训练和梯度优化},
  abstract = {Partially deepfake audio localization is important in audio forensics. However, existing localization models for partially deepfake audio face two major challenges: distribution shifts between training and testing data as well as insufficient utilization of information from both manipulated regions and boundaries. To address these challenges, we propose to use Adversarial training and Gradient Optimization (AGO) to improve partially fake audio localization. Specifically, we apply a gradient reversal layer to reduce the dependence on domain-specific features, enhancing the model’s generalization ability. Additionally, we introduce an alternating update strategy to learn information from both manipulated regions and boundaries, while orthogonal gradient updates minimize conflicts between the two tasks. We evaluated AGO on both the ADD2023 track 2 and PartialSpoof datasets. We achieved a 22.82% relative improvement over the first-ranked method of the ADD2023 track 2. We also achieved state-of-the-art results on the PartialSpoof dataset. Our code is available at https://github.com/Little-dingding/ATGO.},
}

@misc{zheng_lian_40934e81a0670654,
  title = {Are MLMs Trapped in the Visual Room?},
  author = {Yazhou Zhang and Chunwang Zou and Qimeng Liu and Lu Rong and Ben Yao and Zheng Lian and Qiuchi Li and Peng Zhang and Jing Qin},
  year = {2025},
  doi = {10.48550/ARXIV.2505.23272},
  url = {https://doi.org/10.48550/ARXIV.2505.23272},
  howpublished = {CoRR},
  annotation = {中文辅助译名：传销是否被困在可视室中？},
  abstract = {Can multi-modal large models (MLMs) that can ``see'' an image be said to ``understand'' it? Drawing inspiration from Searle's Chinese Room, we propose the \textbfVisual Room argument: a system may process and describe every detail of visual inputs by following algorithmic rules, without genuinely comprehending the underlying intention. This dilemma challenges the prevailing assumption that perceptual mastery implies genuine understanding. In implementation, we introduce a two-tier evaluation framework spanning perception and cognition. The perception component evaluates whether MLMs can accurately capture the surface-level details of visual contents, where the cognitive component examines their ability to infer sarcasm polarity. To support this framework, We further introduce a high-quality multi-modal sarcasm dataset comprising both 924 static images and 100 dynamic videos. All sarcasm labels are annotated by the original authors and verified by independent reviewers to ensure clarity and consistency. We evaluate eight state-of-the-art (SoTA) MLMs. Our results highlight three key findings: (1) MLMs demonstrate high accuracy in visual perception; (2) even with correct perception, MLMs exhibit an average error rate of ~17.1\% in sarcasm understanding, revealing a significant gap between seeing and understanding; (3) this gap stems from weaknesses in context integration, emotional reasoning, and pragmatic inference. This work provides empirical grounding for the proposed Visu},
}

@misc{zheng_lian_74f934529847,
  title = {Learning Transferable Facial Emotion Representations from Large-Scale Semantically Rich Captions},
  author = {Licai Sun and Xingxun Jiang and Haoyu Chen and Yante Li and Zheng Lian and Biu Liu and Yuan Zong and Wenming Zheng and Jukka M. Leppänen and Guoying Zhao},
  year = {2025},
  doi = {10.48550/ARXIV.2507.21015},
  url = {https://doi.org/10.48550/ARXIV.2507.21015},
  howpublished = {arXiv preprint},
  annotation = {中文辅助译名：从大规模语义丰富的字幕中学习可转移的面部情感表示},
  abstract = {Current facial emotion recognition systems are predominately trained to predict a fixed set of predefined categories or abstract dimensional values. This constrained form of supervision hinders generalization and applicability, as it reduces the rich and nuanced spectrum of emotions into oversimplified labels or scales. In contrast, natural language provides a more flexible, expressive, and interpretable way to represent emotions, offering a much broader source of supervision. Yet, leveraging semantically rich natural language captions as supervisory signals for facial emotion representation learning remains relatively underexplored, primarily due to two key challenges: 1) the lack of large-scale caption datasets with rich emotional semantics, and 2) the absence of effective frameworks tailored to harness such rich supervision. To this end, we introduce EmoCap100K, a large-scale facial emotion caption dataset comprising over 100,000 samples, featuring rich and structured semantic descriptions that capture both global affective states and fine-grained local facial behaviors. Building upon this dataset, we further propose EmoCapCLIP, which incorporates a joint global-local contrastive learning framework enhanced by a cross-modal guided positive mining module. This design facilitates the comprehensive exploitation of multi-level caption information while accommodating semantic similarities between closely related expressions. Extensive evaluations on over 20 benchmarks covering },
}

@misc{zheng_lian_165864e8b5b305a9,
  title = {LLM-Driven Multimodal Fusion: Enhancing Depression Detection through Textual Feature Augmentation},
  author = {Siyuan Zhang and Shun Chen and Zhuofan Wen and Hailiang Yao and Zheng Lian and Bin Liu and Zhengqi Wen and Jianhua Tao},
  year = {2025},
  doi = {10.1109/ACII67994.2025.11771888},
  url = {https://doi.org/10.1109/ACII67994.2025.11771888},
  howpublished = {ACII},
  annotation = {中文辅助译名：大语言模型驱动的多模态融合：通过文本特征增强增强抑郁症检测},
  abstract = {Current research on automatic Non-contact depression detection predominantly focuses on vocal and visual modalities. Traditional methods have made certain achievements in the field of multimodal automatic depression detection. At the same time, LLM has also shown greater potential through its powerful reasoning ability. Prevailing depression detection approaches exhibit two critical limitations: first, the cognitive reasoning advantages of LLM remain underutilized in mainstream methodologies; second, the textual modality is frequently neglected in commonly used datasets despite its ability to provide unique semantic complementarity. We developed a hierarchical feature extraction pipeline that employs multiple pretrained models across three modalities to optimize the exploitation efficiency of heterogeneous multimedia information, and we propose a cross-modal semantic enhancement method that employs LLM to perform psycholinguistically driven reconstruction on initial text, generating enhanced textual representations enriched with depression-related semantic markers. Experimental results on AVEC2013 and AVEC2014 datasets demonstrate the superior performance of our approach compared to existing baseline models.},
}

@misc{zheng_lian_bb255a4b1270,
