  abstract = {Data augmentation (DA) has demonstrated significant potential in enhancing the accuracy of electroencephalogram (EEG)-based depression detection. However, existing augmentation methods rely solely on simple linear transformations of the original signals and cannot effectively explore the underlying feature space. To this end, we propose a novel diffusion-based DA method called EEG-STDM. EEG-STDM is capable of comprehensively modeling spatial-temporal patterns in EEG signals and producing diverse synthetic samples to improve depression detection. The framework involves two main stages: a training process and a sampling process. In the training process, structured noise is progressively added to the input EEG signals, preserving the spatial-temporal characteristics while transforming the data into noise- like representations. During the sampling process, the model gradually removes noise from the corrupted inputs using the learned representations, resulting in high-quality synthetic samples. The random nature of the noise input and accurate modeling of spatial-temporal dependencies ensure that the generated data are both diverse and consistent with the feature space. Additionally, we design a Mamba-based spatial-temporal (ST-CAM) classifier aligned with the structure of the diffusion model to extract discriminative features from the generated samples effectively. With the contribution of EEG-STDM, the proposed framework gains state-of-the-art performance, reaching an accuracy o},
}

@misc{zheng_lian_5f38dad908da,
