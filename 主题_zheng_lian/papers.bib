  annotation = {中文辅助译名：多模态情感识别的认知启发自适应推理},
  abstract = {Recent advances in multimodal emotion recognition (MER) have shifted the focus from classification to explainable reasoning. However, reasoning complexity varies across cases and is often overlooked. Existing adaptive reasoning methods fail to explicitly model such cognitive difficulty, resulting in a "see-saw" trade-off between performance and efficiency. Therefore, we propose a Cognitively-Inspired Adaptive Reasoning framework (CIAR), which operates in three stages: (1) Cold-start fine-tuning to establish stable representations for adaptive reasoning; (2) Adaptive cognitive difficulty modeling captures two complementary aspects: modality conflict, inspired by cognitive load theory, quantifies the extra effort required under conflicting emotional cues across modalities; and modality reliance, inspired by cognitive bias theory, reflects difficulty induced by biased reasoning when removing a modality unexpectedly increases confidence. Unlike prior discrete difficulty measures, CIAR models difficulty as a continuous signal; and (3) Difficulty-aware reinforcement learning with verifiable rewards to iteratively optimize the reasoning policy. Extensive experiments across multiple MER benchmarks in both open- and closed-vocabulary settings demonstrate that CIAR achieves a superior balance of performance and efficiency. Furthermore, the framework yields reasoning processes that closely align with human cognitive mechanisms, while exhibiting robust out-of-domain generalization and ex},
}

@misc{zheng_lian_01faf85763cd,
  title = {Can You Predict the Next Mind? Toward Multi-Turn Multi-Party Mental World Modeling},
  author = {Jiahao Huang and Zheng Lian},
  year = {2026},
  doi = {10.48550/arxiv.2611.02988},
  url = {https://arxiv.org/abs/2611.02988},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：你能预测下一个思维吗？迈向多轮多方心理世界建模},
  abstract = {While multimodal foundation models have achieved remarkable progress in physical world modeling, generation, and embodied reasoning, their capacity for dynamic mental world modeling remains underexplored. Existing benchmarks predominantly focus on static mental state perception or short-horizon decision-making, overlooking the dynamic mental trajectories inherent in multi-party, multi-turn interactions. To bridge this gap, we introduce M$^3$WME-Bench, a benchmark designed to evaluate mental world modeling conditioned on the evolving actions of interactants. Specifically, models are tasked with forecasting a target subject's future mental states and behaviors over extended social interactions. In addition to the benchmark suite, we construct M$^3$WME-23K, a dedicated training dataset, and establish a competitive baseline named MindNext-7B. Extensive evaluations across four representative paradigms (general MLLMs, emotion-specialized MLLMs, agentic frameworks, and World Foundation Models) reveal that current systems consistently struggle to anticipate forward-looking mental states. Mechanistic analyses further reveal that existing architectures fundamentally lack forward mental state transition dynamics. Our findings highlight a pivotal challenge in advancing agents from physical to mental world modeling, charting new directions for socially adaptive AI.},
}

@misc{zheng_lian_7a7dbffb041e,
