  annotation = {中文辅助译名：基于无迹卡尔曼滤波器的Boost阶段轨迹跟踪},
  abstract = {This paper introduces Unscented Kalman Filtering(UKF) into trajectory tracking in boost phase.UKF is approximate to the state vector's probability density function(PDF) by making the distribution and the power of sampling point approaching transformed parameters' moment,and it is a nonlinear filter framed by the standard Kalman filter.In practice,UKF has great convenience in calculating,because it does not have to get the complicated Jacobian matrix which cannot be avoided in the ordinary Extended Kalman Filtering(EKF),and it does good performance at the trajectory tracking.},
}

@misc{panorama_65cdc0b75cb1_f99e7d17762561ca,
