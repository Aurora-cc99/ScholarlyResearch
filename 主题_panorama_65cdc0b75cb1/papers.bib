}

@misc{panorama_65cdc0b75cb1_97fe44a149af4822,
  title = {Research on reconfigurable nonlinear Boolean functions hardware structure targeted at stream cipher},
  author = {Xueying Zhang and Zibin Dai and Wei Li and Longmei Nan},
  year = {2009},
  doi = {10.1109/peits.2009.5406741},
  url = {https://doi.org/10.1109/peits.2009.5406741},
  howpublished = {International Conference on Power Electronics and Intelligent Transportation System},
  annotation = {中文辅助译名：针对流密码的可重构非线性布尔函数硬件结构研究},
  abstract = {Based on the characteristics of the nonlinear Boolean functions operated in stream ciphers, a reconfigurable hardware architecture for these nonlinear Boolean functions is presented, which could be reconfigured many different structures to match for the functions, such as the nonlinear Feedback functions of shift registers and the nonlinear filtering functions. The architecture in this design has been realized using Altera's FPGA. Synthesis, placement and routing of reconfigurable design have accomplished on 0.18 ¿m COMS process. The result proves that the design is propitious to carry out the most nonlinear Boolean functions in stream ciphers which have been published. A nonlinear function of 128 variables, the propagation time is 2.84 ns, compared with other designs, the structure can achieve relatively high flexibility, and it has an obvious advantage in the area of circuit and the aspect of speed.},
}

@misc{panorama_65cdc0b75cb1_3817a8896121b9f5,
