@misc{panorama_65cdc0b75cb1_e18bdd4d552d7469,
  title = {Utilizing network pharmacology and other tools to examine active components and mechanism of action of Magnolia officinalis rheum rhabarbarum decoction in treating Streptococcus pyogenes skin infections},
  author = {Yuanhao Wang and Xinrui Wang and Xueying Zhang and Mengyi Pan and Mingyang Sun and Zhiguo chen and Yingli Song},
  year = {2025},
  doi = {10.1186/s40643-025-00933-1},
  url = {https://doi.org/10.1186/s40643-025-00933-1},
  howpublished = {Bioresources and Bioprocessing},
  annotation = {中文辅助译名：利用网络药理学等工具探讨厚朴大黄汤治疗化脓性链球菌皮肤感染的活性成分及作用机制},
  abstract = {Infections caused by Streptococcus pyogenes and the growing threat of antibiotic resistance pose significant global health challenges. This study investigates the antibacterial properties of Magnolia officinalis Rheum rhabarbarum Decoction against Streptococcus pyogenes skin infections. By combining UHPLC-MS/MS, network pharmacology, and molecular docking techniques, we identified eight bioactive compounds in the formulation and explored their potential interactions with Streptococcus pyogenes-related targets. Our analysis revealed that compounds such as Sinensetin, Nobiletin, and (+)-Magnoflorine regulate immune pathways (IL-17, TNF), inhibit the production of inflammatory factors, and disrupt bacterial membranes and metabolic processes, achieving dual antibacterial and anti-inflammatory effects. In vitro experiments showed that the decoction exhibited a minimum inhibitory concentration (MIC) of 20 mg/mL against Streptococcus pyogenes, significantly reducing the secretion of pro-inflammatory factors such as IL-1α, IL-6, IL-36, and TNF-α. These results suggest that Magnolia officinalis Rheum rhabarbarum Decoction offers a promising multi-target strategy for treating drug-resistant Streptococcus pyogenes infections and may serve as a potential alternative to traditional antibiotics.},
}

@misc{panorama_65cdc0b75cb1_bb56c37631232924,
  title = {Agile-blended learning for metropolitan learners: insights and trends},
  author = {William Ko-Wai Tang and Venus W. M. Chan and Xueying Zhang},
  year = {2025},
  doi = {10.1108/aaouj-03-2025-0035},
  url = {https://doi.org/10.1108/aaouj-03-2025-0035},
  howpublished = {AAOU Journal/AAOU journal},
  annotation = {中文辅助译名：面向都市学习者的敏捷混合学习：见解和趋势},
  abstract = {Purpose The recently emerging agile-blended learning (AB learning) is novel to researchers and practitioners alike, and previous research has not examined the characteristics that the AB learning approach has presented in metropolitan learners. The significance of the AB learning approach has been neglected. Design/methodology/approach This systematic review aims to explore the AB learning strategies for metropolitan learners by examining recent literature from 2020 to 2024 using the PRISMA searching process, coding and analysis. The review included 68 studies after screening articles obtained from the Web of Science and Scopus databases. Findings The results present the current focus of AB learning in literature as flexibility, learner autonomy, technology mediation and collaboration of the AB learning approach for metropolitan learners. The review also provides implications for the future directions of AB learning research. Originality/value This paper presents an evaluation of the AB learning approach, specifically designed for metropolitan learners and highlights its distinctive characteristics inherent to AB learning.},
}

@misc{panorama_65cdc0b75cb1_0d5312df48e0,
  title = {Multi-dimensional feature extraction of EEG signal and its application in stroke classification},
  author = {Teng Wang and Wenhui Jia and Fenglian Li and Xirui Liu and Xueying Zhang and Fengyun Hu},
