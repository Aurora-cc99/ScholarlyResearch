  annotation = {中文辅助译名：基于Bark小波前端处理的语音识别},
}

@misc{panorama_65cdc0b75cb1_a32fcdf426d517f4,
  title = {A non-linear prediction speech coding system based on ANN},
  author = {Anhong Wang and Zhiyi Sun and Xueying Zhang},
  year = {2003},
  doi = {10.1109/wcica.2002.1022183},
  url = {https://doi.org/10.1109/wcica.2002.1022183},
  howpublished = {World Congress on Intelligent Control and Automation},
  annotation = {中文辅助译名：基于ANN的非线性预测语音编码系统},
  abstract = {A non-linear prediction speech coding system based on an ANN is introduced. In this coding system, the bit rate is not increased by the backward predictor. The pure backpropagation (BP) algorithm is replaced by the improved difference BP algorithm. The experimental results have indicated: the predictor based on an ANN has high prediction gain and the speech dependencies can been extracted by it though the embedding dimension is low. The speed quality of the new system is better than that of the speech coding standard G.721 system.},
}

@misc{panorama_65cdc0b75cb1_1a03a6deca5eb951,
  title = {A nonlinear prediction speech coding ADPCM algorithm based on RNN},
  author = {Anhong Wang and Xueying Zhang and Zhiyi Sun and Bing-Zhi Ma},
  year = {2003},
  doi = {10.1109/icmlc.2002.1167426},
  url = {https://doi.org/10.1109/icmlc.2002.1167426},
  howpublished = {International Conference on Machine Learning and Cybernetics},
  annotation = {中文辅助译名：基于RNN的非线性预测语音编码ADPCM算法},
  abstract = {In this paper, the nonlinear prediction speech coding ADPCM algorithm based on the recurrent neural network (RNN) is introduced. In this coding system, the bit rate is not increased by the backward predictor and the long-term correlation is extracted because of the inner memory of the RNN. The experiment results show that the speech coding system based on RNN has a lower dimension and less hidden layers than that of BP network but without a decrease in the quality of speech. Besides, the speech quality of the new system is better than that of the standard G.721 speech coding system.},
}

@misc{panorama_65cdc0b75cb1_ba5b8fc3ffb1393c,
  title = {Speech signal digital processing algorithm development environment},
  author = {Zhang Gang and Qiao Yanxi and Xueying Zhang},
  year = {2002},
  doi = {10.1109/icosp.1998.770939},
  url = {https://doi.org/10.1109/icosp.1998.770939},
  howpublished = {International Conference on Signal Processing},
  annotation = {中文辅助译名：语音信号数字处理算法开发环境},
  abstract = {Two TMS320C31 chips and two A/D, D/A channels combined with the powerful graphic and interactive ability of the personal computer makes a convenient and efficient integrated development environment for designing and debugging DSP algorithms. The powerful functions of the system are described by the example of the real-time implementation of ITU-T G.728, which offers a solution to the custom-made full-duplex G.728 chip by using a single TMS320C31.},
}

@misc{panorama_65cdc0b75cb1_a384952b79d7ef3b,
  title = {The application of BP type neural network in speech coding},
  author = {Xueying Zhang},
  year = {2002},
  doi = {10.1109/wcica.2000.862486},
  url = {https://doi.org/10.1109/wcica.2000.862486},
  howpublished = {World Congress on Intelligent Control and Automation},
  annotation = {中文辅助译名：BP型神经网络在语音编码中的应用},
  abstract = {The paper discusses the method that uses the BP algorithm of neural networks to code the speech signal by means of nonlinear prediction aiming at the non-stationary and nonlinear features of speech signals. Taking the G.721 ADPCM speech coding algorithm as an example, the method of nonlinear prediction replacing linear prediction is presented. The results indicate that the coding quality using neural network nonlinear prediction is better than that of using linear prediction.},
}
