  annotation = {中文辅助译名：基于nRF24L01的车载GPS数据传输系统},
  abstract = {A wireless GPS data transmission system implemented with a ATmega16L MCU and nRF24L01 is designed.The communication of transmitter side use standard RS-232 serial communication interface to communicate and which is consist of GPS satellite data receiver and MCU.The MCU controls nRF24L01 so as to fulfills the wireless communication.On the receiving end,the MCU commands the wireless module to get the signal and transports it to the computer so as to display the data.The system hardware and software designs are discussed in detail including control module,wireless module,GPS decoding.The design results show that the system has stable performance,high transmission speed,low power consumption,can achieve a reliable transmission of the GPS data.},
}

@misc{panorama_65cdc0b75cb1_3711aee2e648a249,
  title = {SVM-based speaker emotional cross-correlation algorithm in continuous Chinese mandarin},
  author = {Yuqiang Qin and Xueying Zhang},
