  url = {https://doi.org/10.1007/978-3-642-05173-9_10},
  howpublished = {Lecture notes in electrical engineering},
  annotation = {中文辅助译名：一种可重构并行低功耗E0算法的研究与实现},
}

@misc{panorama_65cdc0b75cb1_1e1932abefb24d07,
  title = {Warped Filter Banks Used in Noisy Speech Recognition},
  author = {Xueying Zhang and Lixia Huang and Gianpaolo Evangelista},
  year = {2009},
  doi = {10.1109/icicic.2009.382},
  url = {https://doi.org/10.1109/icicic.2009.382},
  howpublished = {International Conference on Innovative Computing, Information and Control},
  annotation = {中文辅助译名：用于噪声语音识别的扭曲滤波器组},
  abstract = {The filter bank in the front-end of a speech recognition system mimics the function of the basilar membrane. It is believed that the closer the band subdivision is to human perception, the better the recognition results. This paper proposes the use of warped filter banks (WFBs) to replace traditional FIR filter banks and validates its use for the recognition of noisy speech. The WFBs bandwidths can be warped by using a first-order allpass transformation replacing the unit delay. Different warped factors in the allpass function can make the different scaled filter banks. Experiments carried on isolated words for speaker independent speech recognition show that the recognition rate with our proposed WFBs has been effectively increased.},
}

@misc{panorama_65cdc0b75cb1_f2b103b9393298c8,
  title = {A PLP Speech Feature Extraction Method in Noisy Environment},
  author = {Xueying Zhang},
  year = {2009},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=TYGY200903006},
  howpublished = {Journal of Taiyuan University of Technology},
  annotation = {中文辅助译名：噪声环境下PLP语音特征提取方法},
  abstract = {A feature extraction method is studied in this paper.PLP parameter is extracted using feature compensation method and three concepts of auditory psychology including critical-band spectral resolution,equal-loudness preemphasis and intensity-loudness power law of hearing.Then,on this basis the parameter is improved by using RASTA technique and Half Raised-sine Function Cepstral Exaltation,good performance for speech feature extraction under high noise is obtained.},
}

