@misc{panorama_haiyun_huang_83b6ef2253061066,
  title = {Electrical Tuning of Optical Stark Effect in Monolayer WS 2},
  author = {Xiu Zhang and Ting‐Xiao Qin and Junzhi Zhu and Haiyun Huang and Mengdi Zhang and Baixu Xiang and Yubin Wang and Qihua Xiong and Haiyun Liu},
  year = {2025},
  doi = {10.1021/acs.nanolett.5c04755},
  url = {https://doi.org/10.1021/acs.nanolett.5c04755},
  howpublished = {Nano Letters},
  annotation = {中文辅助译名：单层 WS 2 中光学斯塔克效应的电调谐},
  abstract = {Upon excitation by a strong coherent light field, photon-dressed states form and hybridize with equilibrium states, leading to transient band renormalization, a phenomenon known as the optical Stark effect (OSE). Extensive research has been conducted on the optical control of the OSE by modulating the optical pump fluence, detuning energy, and polarization. Herein, we present the electrical tuning of valley-selective OSE in a back-gated monolayer WS 2 device using helicity-resolved transient absorption spectroscopy (TAS). The mechanism involves an enhanced transition dipole moment and exciton oscillator strength under electrical control. The OSE blue shift deviates from the exciton intensity trend at high negative voltages, arguing against a simple interpretation from the steady-state exciton density of states and suggesting a more complex underlying origin. Our study demonstrates electrical tuning as an additional degree of freedom for Floquet engineering, offering profound insights into coherent light–matter interaction in 2D materials.},
}

@misc{panorama_haiyun_huang_746fd59e53e61385,
  title = {Mechanisms by Which Low‐Temperature Plasma Exerts Bone Homeostasis},
  author = {Yao Lü and Mengyun Zhang and Xin Chen and Ziyao Wang and Chuyun Huang and Yuxuan He and Haiyun Huang and Qi Han and Hanjiu Yang},
  year = {2025},
  doi = {10.1002/ppap.70098},
  url = {https://doi.org/10.1002/ppap.70098},
  howpublished = {Plasma Processes and Polymers},
  annotation = {中文辅助译名：低温等离子体发挥骨稳态的机制},
  abstract = {ABSTRACT Bone homeostasis is maintained by the balance between bone resorption and bone formation. Disruption of bone homeostasis is closely linked to various bone‐related diseases, such as rheumatoid arthritis (RA), osteoporosis, peri‐implantitis (PI), and periodontal disease (PD). The quest to reduce the incidence of complications and alleviate the side effects of current therapeutic strategies remain an ongoing challenge. Owing to its minimal side effects, good controllability, and high selectivity, low‐temperature plasma (LTP) has found a wide range of medical applications, such as promoting wound healing, killing tumor cells, and functioning as an antimicrobial agent. In recent years, LTP has also been increasingly utilized in orthopedics and dentistry, owing to its potential to promote osseointegration, facilitate the repair of bone defects, and exhibit anti‐inflammatory properties. In this paper, this paper discusses the biological effects and mechanisms of LTP on osteoblasts, osteoclasts, and macrophages, as well as explore the potential differential impacts of various LTP sources and parameters. Additionally, this paper discusses the clinical applications of LTP in orthopedics and dentistry.},
}

@misc{panorama_haiyun_huang_d0255019b6c5b95d,
  title = {Low-frequency interlayer phonon dynamics and photoinduced terahertz absorption in black phosphorus},
  author = {Haiyun Huang and Cheng Chen and Yuxin Zhai and Xiu Zhang and Junzhi Zhu and Junyong Wang and Kai Zhang and Qihua Xiong and Haiyun Liu},
  year = {2025},
  doi = {10.1364/oe.574206},
  url = {https://doi.org/10.1364/oe.574206},
  howpublished = {Optics Express},
  annotation = {中文辅助译名：黑磷中的低频层间声子动力学和光致太赫兹吸收},
  abstract = {The strong interlayer coupling in black phosphorus (BP), arising from wavefunction overlap between layers, is critical for understanding its electronic and optical properties. Here, we utilize terahertz (THz) spectroscopy to study phonon dynamics in BP. We identify two peaks at 6 and 8.5 meV in steady-state THz spectra, which are attributed to low-frequency interlayer phonon modes. Both modes exhibit anharmonic phonon coupling behavior below 150 K, manifesting as temperature-dependent red shifts. Using time-resolved THz spectroscopy, we observe significantly increased THz absorption under photoexcitation, arising from the transient enhancements of the extended Drude component and the oscillator strengths of interlayer phonons in non-equilibrium. These findings highlight the critical role of interlayer phonon dynamics in understanding many-body physics in BP.},
}

@misc{panorama_haiyun_huang_6f4307efe2bd,
  title = {Combining Spectral Activation with Brain Network Interactions for EEG-based Attention Recognition},
  author = {Haiyun Huang and Jie Chen and Zhiqiang Chen and Aojun Wen and Fei Wang},
  year = {2025},
  doi = {10.1145/3724979.3724985},
  url = {https://doi.org/10.1145/3724979.3724985},
  howpublished = {International Conference on Bioinformatics and Intelligent Computing (BIC)},
  annotation = {中文辅助译名：将光谱激活与大脑网络交互相结合，实现基于脑电图的注意力识别},
  abstract = {Attention is a higher cognitive function of the human brain and is crucial in daily life. Recently, attention-based Brain-Computer Interface (BCI) has become a new hotspot in the field of BCI. However, current studies often employ single-task experimental paradigms that fail to capture the dynamic transitions between cognitive states, limiting their ability to effectively engage participants' attention. Moreover, most studies rely on both frequency-domain and time-domain methods for analyzing EEG signals. Frequency-domain approaches overlook the temporal dynamics of signals, while time-domain methods lack spectral resolution. Such one-dimensional analyses are insufficient to reveal the time-frequency interactions of EEG signals. In this study, we designed an alternating attention and relaxation experimental paradigm and proposed a method that combines spectral activation with brain network interactions for attention recognition. The experiment involved 69 participants, achieving the highest accuracy of 91.22%. Furthermore, we found significant differences between attention and relaxation states across frequency bands. In the attention state, the prefrontal and parietal regions showed enhanced connectivity. This study provides a new paradigm and theoretical support for understanding attention regulation mechanisms and advancing brain-computer interface applications.},
}

