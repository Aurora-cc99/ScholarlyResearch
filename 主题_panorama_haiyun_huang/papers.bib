  annotation = {中文辅助译名：基于格架理论的Y型桥结构分析},
  abstract = {In this paper simplification of structure calculation of Y-shape Bridge in the project of viaduct bridge or overhead crossing is carried out,and at the same time the simulation analysis of grillage mode is also carried out based on procedure software of finite element.It is a kind of effective way for asking and solving the complicated internal force of Y-shape bridge.By means of practice calculation,and at the same time,comparing with shell mode,the result of analysis indicates that they are of better value in the practice engineering application.In addition,while the grillage theory is carried out for structure analysis,some problems of worth notice are put forward about how to deal with the grillage divide and sectional characteristic parameter,then some existent problems and content of structure analysis are studied.},
}

@misc{panorama_haiyun_huang_62167ca3fb5b7cba,
