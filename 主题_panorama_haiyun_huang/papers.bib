@misc{panorama_haiyun_huang_dc1f5d09446894fb,
  title = {Coherent Dynamics of Neutral and Charged Biexcitons in Monolayer WSe2},
  author = {Xiu Zhang and Haiyun Huang and Ting‐Xiao Qin and Junzhi Zhu and Mengdi Zhang and Qihua Xiong and Haiyun Liu},
  year = {2026},
  doi = {10.1021/acs.nanolett.6c02450},
  url = {https://doi.org/10.1021/acs.nanolett.6c02450},
  howpublished = {Nano Letters},
  annotation = {中文辅助译名：单层 WSe2 中中性和带电双激子的相干动力学},
  abstract = {Monolayer transition-metal dichalcogenides provide an ideal platform for investigating many-body excitonic complexes due to their strong Coulomb interactions and unique valley-contrasting optical selection rules. Here, we employ helicity-resolved transient absorption spectroscopy in an opposite-circular-polarization configuration to systematically study the coherent dynamics of both neutral and charged intervalley biexcitons in monolayer WSe2. Our measurements reveal a linear dependence of the biexciton signal strength on the pump fluence, indicative of an intrinsic coherent process. In contrast to the exciton, the biexciton resonances display steeper red shifts as the temperature increases, leading to increased binding energies correspondingly. This behavior is attributed to the extended wave function and heavier effective mass of biexcitons, which enhance sensitivity to both thermal lattice vibration and low-energy phonon scattering. Our work advances the fundamental understanding of coherent biexciton dynamics and many-body physics in 2D semiconductors, paving the way for future quantum optoelectronic devices.},
}

@misc{panorama_haiyun_huang_ab0b9c9bc12c4590,
  title = {Exciton band renormalization induced by optical Stark effect and exciton–exciton interaction in monolayer WSe 2},
  author = {Xiu Zhang and Haiyun Huang and Lili Hu and Junzhi Zhu and Mengdi Zhang and Baixu Xiang and Kenji Watanabe and Takashi Taniguchi and Qihua Xiong and Haiyun Liu},
  year = {2026},
  doi = {10.1088/2516-1083/ae669d},
  url = {https://doi.org/10.1088/2516-1083/ae669d},
  howpublished = {Progress in Energy},
  annotation = {中文辅助译名：单层WSe 2 中光学斯塔克效应和激子-激子相互作用引起的激子带重整化},
  abstract = {Abstract Excitons are the primary quantum quasiparticles that dictate the performance of optoelectronic and photonic devices by mediating the photon-to-carrier conversion processes. Consequently, understanding ultrafast exciton dynamics is crucial for unraveling the microscopic origins of strong light-matter coupling and many-body correlations in monolayer transition metal dichalcogenides (ML-TMDs), paving the way for advanced device engineering. Herein, we employ helicity-resolved transient absorption spectroscopy to investigate the ultrafast coherent and incoherent exciton dynamics in ML-WSe ₂ across a range of pump-exciton detuning energies under near- and on-resonance conditions. Immediately upon photoexcitation, we observe optical Stark effect (OSE)-induced energy shifts, exhibiting the characteristic evolution from a blue shift (below-resonance), through a splitting (on-resonance), to a red shift (above-resonance), all can be well described by the dressed-atom model. Notably, after the pump pulse, the coherent OSE gives way to incoherent exciton–exciton interaction, characterized by a universal blue shift across all detuning energies. By dissecting the interplay between the detuning-dependent OSE and many-body excitonic correlations, we elucidate the temporal evolution and distinct roles of these effects in exciton band renormalization. This work provides fundamental insights into strong light-matter interaction in ML-TMDs and offers valuable design principles for devel},
}

@misc{panorama_jiahui_pan_9f2551e7e702,
