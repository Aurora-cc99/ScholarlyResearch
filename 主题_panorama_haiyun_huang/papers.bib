@misc{panorama_haiyun_huang_cb8a519dd2bd0a7a,
  title = {Theoretical analysis of Y-shape bridge and application},
  author = {Pengzhen Lu and Junping Zhang and Renda Zhao and Haiyun Huang},
  year = {2009},
  doi = {10.12989/sem.2009.31.2.137},
  url = {https://doi.org/10.12989/sem.2009.31.2.137},
  howpublished = {STRUCTURAL ENGINEERING AND MECHANICS},
  annotation = {中文辅助译名：Y型桥理论分析及应用},
  abstract = {Mechanic behavior of Y-shape thin-walled box girder bridge structure is complex, so one can not exactly hold the mechanical behavior of the Y-shape thin-walled box girder bridge structure through general calculation theory and analytical method. To hold the mechanical behavior better, based on elementary beam theory, by increasing the degree of freedom analytical method, taking account of restrained torsiondistortion angledistortion warp and shearing lag effect at the same time, authors obtain a thin-walled box beam analytical element of 10 degrees of freedom of every node, derive stiffness matrix of the element, and code a finite element procedure. In addition, authors combine the obtained procedure with spatial grillage analytical method, meanwhile, they build a new analytical method that is the spatial thin-walled box girder element grillage analysis method. In order to validate the precision of the obtained analysis method, authors analyze a type Y-shape thin-walled box girder bridge structure according to the elementary beam theory analytical method, the shell theory analytical method and the spatial thin-walled box girder element grillage analysis method respectively. At last, authors test a type Y-shape thin-walled box girder bridge structure. Comparisons of the results of theory analysis with the experimental text show that the spatial thin-walled box girder element grillage analysis method is simple and exact. The research results are helpful for the knowledge of the},
}

@misc{panorama_haiyun_huang_b67f63536a4cf722,
  title = {Application of a Thin-walled Box Girder Element and Grillage Method in the Special-shaped Bridge},
  author = {Pengzhen Lu and Junping Zhang and Zhao Renda and Haiyun Huang},
  year = {2008},
  url = {http://xuebao.sysu.edu.cn/Jweb_yxb/EN/abstract/abstract13757.shtml},
  howpublished = {Acta Scientiarum Naturalium Universitatis Sunyatseni},
  annotation = {中文辅助译名：薄壁箱梁单元及格板法在异形桥中的应用},
  abstract = {Mechanic behavior of Y-shape thin-walled box girder Bridge structure is complex and can not exactly described with general calculation theory and analytical method.Based on elementary beam theory,a thin-walled box beam analytical element of 10 degrees of freedom of every node was obtained,and stiffness matrix of the element was derived.In addition,a new spatial thin-walled box girder element grillage analysis method was built.A type of Y-shape thin-walled box Girder Bridge structure was analyzed with the elementary beam theory,shell theory and the new method.Comparison of results of theory analysis with experimental data,it is shown that the spatial thin-walled box girder element grillage analysis method is simple and exact.},
}

@misc{panorama_haiyun_huang_35b6645d21335006,
  title = {A mobile beacon based method for wireless sensor networks localization},
  author = {Weiwei Hu and Huibin Qin and Haiyun Huang},
  year = {2008},
  doi = {10.1109/icct.2008.4716153},
  url = {https://doi.org/10.1109/icct.2008.4716153},
  howpublished = {IEEE International Conference on Communication Technology (ICCT)},
  annotation = {中文辅助译名：一种基于移动信标的无线传感器网络定位方法},
  abstract = {The node localization technology is a foundation technology to wireless sensor networks, and a mobile beacon node based two-step localization algorithm is proposed in the paper. The main idea of the proposed algorithm is to use the mobile beacon node to traverse the entire network and to broadcast periodically the packet containing its current location information. Then the unknown sensor node can calculate its location as long as it has received enough location information packets. The method is divided into two steps: firstly, three noncollinear location information of beacon are selected to calculate the nodepsilas coarse location using the trilateration method, secondly, this coarse location serves as the initial state of the unscented Kalman filter (UKF) based localization algorithm, to get higher precise position. Simulation compared the localization error of the two-step localization algorithm among that of UKF based algorithm and trilateration algorithm, when the beacon mobile along multiple different trajectories. The results showed that the two-step localization method has not special restrict and obtains ideal localization accuracy.},
}

@misc{panorama_haiyun_huang_166d03e740b91fe3,
  title = {Stiffness Method Study of Structural Analysis of Typical Inverted Y-Shape Bridge},
  author = {Haiyun Huang},
  year = {2007},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=QLJS200701007},
  howpublished = {Qiaoliang jianshe},
  annotation = {中文辅助译名：典型倒Y形桥结构分析刚度法研究},
  abstract = {The finite element with 10 degrees of freedom each node for analysis of thin-wall box girder is proposed according to the analysis method of increasing degrees of freedom on the basis of the general elementary beam theory.By taking a typical inverted Y-shape thin-wall box girder bridge as the research object,the general spatial beam grillage model,spatial plate and shell finite element analysis model and organic glass test model are respectively set up,and various analysis and measurements of the models are compared according to the different theories.The results of study verify that the theoretic analysis method proposed in the paper is correct and simple.},
}

@misc{panorama_haiyun_huang_a04e7f60e344faa2,
  title = {Structure analysis for Y-shape Bridge based on grillage theory},
  author = {Haiyun Huang},
  year = {2006},
