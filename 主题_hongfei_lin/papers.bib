@misc{hongfei_lin_69359f45e2011b9a,
  title = {Complex Extraction from the Weighted Network Based on Topological and Biological Characteristics},
  author = {Hongfei Lin},
  year = {2013},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=CAPE201303012},
  howpublished = {Journal of Jiangxi Normal University},
  annotation = {中文辅助译名：基于拓扑和生物特征的加权网络的复杂提取},
  abstract = {The weight setting of protein interaction network has a great effect on protein complex identification.A better strategy which considers both topological characteristics and biological characteristics of protein interaction network has been provided.Furthermore,some credible interactions have been added into the original network.Then,the updated protein interaction network has been used for complex identification based on a supervised method.F-score reached 0.570 5 in the DIP dataset.},
}

@misc{hongfei_lin_b3ec9956e09e27cd,
  title = {The Construction of Affective Schemata and Its Application in Text Affective Computing},
  author = {Hongfei Lin},
  year = {2013},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=CAPE201302004},
  howpublished = {Journal of Jiangxi Normal University},
  annotation = {中文辅助译名：情感图式的构建及其在文本情感计算中的应用},
  abstract = {Stimulus situation has been mapped to multi-level concept space on the basis of cognitive evaluation theory.With HowNet and synonyms dictionary,the method of hyponymy acquisition based on patterns to construct four kinds of affective schemata has been used.Combined with the cognitive context and pragmatic inference,these affective schemata have been used in sentence level text affective computing.The experiments show that schema can effectively assist the recognition of text affection and improved its precision.},
}

@misc{hongfei_lin_33f475b8bacde626,
  title = {Question Similarity Calculation Based on Feature Fusion in Community Question Answering},
  author = {Hongfei Lin},
