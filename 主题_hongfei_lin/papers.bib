  abstract = {The cluster-based language model for resource selection in distributed information retrieval firstly uses the relevance model to get the probabilities of relevance between documents in the collection and a given query,and then the whole collection is clustered into several clusters,each of which is used to construct precisely language model.Finally,databases are selected by the similarity to the query according to the estimated language model.The experimental result shows that our approach consistently improves retrieval performance over CORI,CRCS and traditional language model.},
}

