@misc{hongfei_lin_5e509b55edf698cb,
  title = {TableMind: Redefining Table Reasoning With Semantics and Flexibility},
  author = {Zhehuan Zhao and Ludan Zhang and Bo Xu and Yuran Zhang and Zichuan Xu and Yu Liu and Shimin Shan and Hongfei Lin},
  year = {2026},
  doi = {10.1109/tkde.2026.3717667},
  url = {https://doi.org/10.1109/tkde.2026.3717667},
  howpublished = {IEEE Transactions on Knowledge and Data Engineering},
  annotation = {中文辅助译名：TableMind：通过语义和灵活性重新定义表格推理},
  abstract = {Recent advances in large language models (LLMs) have significantly improved table-based reasoning, yet challenges remain in effectively leveraging question semantics, adapting prompting strategies across diverse query types, and constructing efficient table contexts. In this paper, we propose TableMind, a semantics-aware extension of Chain-of-Table for flexible and efficient table reasoning. TableMind enhances the operation-chain paradigm through four complementary designs: (1) semantic parsing for guiding operation planning, (2) confidence-aware demonstration routing for adaptive prompting, (3) top-bottom context compression for reducing redundancy while preserving structural cues, and (4) an extended operation space with condition-aware filtering and grouped aggregation. Experiments on WikiTQ and TabFact demonstrate that TableMind consistently outperforms strong baselines, achieving accuracy improvements of 5.1% and 1.7%, respectively, while also reducing token consumption and inference cost, resulting in a better balance between reasoning accuracy and efficiency.},
}

