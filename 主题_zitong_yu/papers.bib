  year = {2026},
  doi = {10.1109/tifs.2026.3734785},
  url = {https://doi.org/10.1109/tifs.2026.3734785},
  howpublished = {IEEE Transactions on Information Forensics and Security},
  annotation = {中文辅助译名：用于广义多模态人脸反欺骗的模态和域感知自适应},
  abstract = {The increasing diversity of presentation attacks and the availability of multimodal sensors have motivated the use of multimodal face anti-spoofing (FAS) to improve domain generalization (DG). However, existing multimodal FAS methods are hindered by modality-specific domain shifts caused by fixed feature extraction, and limited dynamic adaptation to target–source domain relations, leading to asynchronous modality-domain coupling and suboptimal cross-domain generalization. To address these challenges, we propose MDAA, a modality- and domain-aware adaptive framework for multimodal DG FAS. For modality adaptivity, we introduce a Dynamic Difference Convolution module (DDC), which dynamically adjusts convolutional receptive fields according to modality characteristics, enabling adaptive feature extraction against modality-specific domain shifts. For domain adaptivity, we propose a Domain-Relation Weighted Multi-Head Fusion module (DReaM), which learns target-source domain relations and adaptively aggregates domain-specific predictions to facilitate robust knowledge transfer to unseen domains. Furthermore, we extend the vision–language model to a unified RGB–Infrared–Depth–Text setting, enabling joint alignment between language priors and heterogeneous visual modalities. Extensive experiments on four benchmark datasets demonstrate that MDAA consistently outperforms existing methods under cross-domain evaluation, modality-missing conditions, and limited source-domain settings, valid},
}

