  annotation = {中文辅助译名：用于外泌体纳米孔的高通量纳米流体装置，用于开发货物运输工具（小 35/2021）},
  abstract = {Nanofluidics In article number 2102150, Hui Yang and co-workers report a high-throughput nanofluidic device for loading of various cargos into exosomes. The exosomes treated by the device can deliver their drug cargos to cancer cells and induce cell death, indicating the potential opportunities of the device for developing new exosome-based delivery vehicles for further biomedical applications.},
}

@misc{zitong_yu_b97fc357c1824953,
  title = {A High-Throughput Nanofluidic Device for Small Extracellular Vesicle Nanoporation},
  author = {Rui Hao and Zitong Yu and Jing Du and Hang Guo and Yi Zhang and Hui Yang},
  year = {2021},
  doi = {10.1109/mems51782.2021.9375443},
  url = {https://doi.org/10.1109/mems51782.2021.9375443},
  howpublished = {IEEE International Conference on Micro Electro Mechanical Systems (MEMS)},
  annotation = {中文辅助译名：用于小细胞外囊泡纳米孔化的高通量纳米流体装置},
  abstract = {We propose a nanofluidic device named "small extracellular vesicle nanoporator (sEVN)" for high-throughput nanoporation of small extracellular vesicles (sEVs). By transporting sEVs through constriction nanochannel with height comparable to their dimension, transient nanopores are introduced on the sEVs membrane by mechanical membrane disruption, while maintaining sEV integrity. The sEVN consisting of 30,000 nanochannels demonstrates a high sample throughput and absence on clogging issues, and the working mechanism of the device is elucidated through experimental and numerical study. This platform provides a way for high-throughput sEV nanoporation and offers promises for engineering sEVs as universal drug delivery vehicles for biomedical applications.},
}

@misc{guoying_zhao_f623e9cc6c2db07d,
  title = {The 1st Challenge on Remote Physiological Signal Sensing (RePSS)},
  author = {Xiaobai Li and Hu Han and Hao Lü and Xuesong Niu and Zitong Yu and Antitza Dantcheva and Guoying Zhao and Shiguang Shan},
  year = {2020},
  doi = {10.1109/cvprw50498.2020.00165},
  url = {https://doi.org/10.1109/cvprw50498.2020.00165},
  howpublished = {IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)},
  annotation = {中文辅助译名：第一届远程生理信号传感（RePSS）挑战赛},
  abstract = {Remote measurement of physiological signals from videos is an emerging topic. The topic draws great interests, but the lack of publicly available benchmark databases and a fair validation platform are hindering its further development. For this concern, we organize the first challenge on Remote Physiological Signal Sensing (RePSS), in which two databases of VIPL and OBF are provided as the benchmark for kin researchers to evaluate their approaches. The 1st challenge of RePSS focuses on measuring the average heart rate from facial videos, which is the basic problem of remote physiological measurement. This paper presents an overview of the challenge, including data, protocol, analysis of results and discussion. The top ranked solutions are highlighted to provide insights for researchers, and future directions are outlined for this topic and this challenge.},
}

