@misc{chin_teng_lin_2da78d10da8bdd48,
  title = {MGRW-Transformer: Multigranularity Random Walk Transformer Model for Interpretable Learning},
  author = {Haipeng Wang and Jiashuang Huang and Hengrong Ju and Weiping Ding and Yu Geng and Chin-Teng Lin},
  year = {2025},
