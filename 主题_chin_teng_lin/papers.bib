@misc{chin_teng_lin_47e24117eee7ee65,
  title = {iFuzzyTL: Interpretable Fuzzy Transfer Learning for Steady-State Visual Evoked Potentials Brain-Computer Interfaces System},
  author = {Yu-Cheng Chang and Xiaowei Jiang and Chin-Teng Lin and Beining Cao and Thomas Do and Liang Ou},
