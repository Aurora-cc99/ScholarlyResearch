  abstract = {In this paper, we propose the adaptive least trimmed squares fuzzy neural network (ALTS-FNN), which applies the scale estimate to the least trimmed squares fuzzy neural network (LTS-FNN). The emphasis of this paper is particular on the robustness against the outliers and the choice of the trimming constant can be determined adaptively. Some numerical examples will be provided to compare the robustness against outliers for usual FNN and the ALTS-FNN. Simulation results show that the ALTS-FNN in the paper have good performance for outlier detection.},
}

@misc{chin_teng_lin_7c84223dab692b28,
  title = {An immune symbiotic evolution learning for compensatory neural fuzzy networks and its applications},
  author = {Chin-Teng Lin and Cheng-Jian Lin and Cheng-Hung Chen},
  year = {2011},
  doi = {10.1109/FUZZY.2011.6007323},
