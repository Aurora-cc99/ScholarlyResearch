@misc{chin_teng_lin_6dec18fd6ee9d30d,
  title = {Takagi-Sugeno-Kang type collaborative fuzzy rule based system},
  author = {Sudhanshu Joshi and Kuang-Pen Chou and Mukesh Prasad and Chin-Teng Lin and Yang-Yin Lin and Jyh-Yeong Chang},
