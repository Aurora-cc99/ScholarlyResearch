@misc{chin_teng_lin_f11754e43884a4f8,
  title = {Brain Dynamics of Spatial Reference Frame Proclivity in Active Navigation},
  author = {Che-Sheng Yang and Jia Liu and Avinash Kumar Singh and Kuan‐Chih Huang and Chin‐Teng Lin},
  year = {2021},
  doi = {10.1109/tnsre.2021.3106174},
