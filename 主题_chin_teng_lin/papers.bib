  author = {Miin-Tsair Su and Chin‐Teng Lin and Sheng-Chih Hsu and Dong Lin Li and Lin Cheng and Cheng-Hung Chen},
  year = {2012},
  doi = {10.30000/ijfs.201203.0010},
