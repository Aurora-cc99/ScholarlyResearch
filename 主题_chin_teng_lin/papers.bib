  author = {Arun Kumar Sangaiah and Deepak Puthal and Chia-Hsin Chung and Jagendra Singh and Mukesh Prasad and Sharmi Sankar and Chin-Teng Lin and Yu-Kai Wang and Hesham El-Sayed},
