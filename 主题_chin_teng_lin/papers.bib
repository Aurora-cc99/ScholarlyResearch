@misc{chin_teng_lin_a00afd33c2db75a7,
  title = {Kannon: Ubiquitous Sensor/Actuator Technologies for Elderly Living and Care: A Multidisciplinary Effort in National Chiao Tung University, Taiwan},
  author = {John Kar-Kin Zao and Zee-Yih Kuo and Ming-Chuen Chuang and Yu-Chee Tseng and Chin-Teng Lin and Jwu-Sheng Hu and Shu-Chen Li and Shang Hwa Hsu and Jin-Chern Chiou and Yu-Lun Huang and Jane W.-S. Liu},
  year = {2006},
