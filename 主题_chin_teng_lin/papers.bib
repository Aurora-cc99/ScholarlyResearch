  annotation = {中文辅助译名：用于实时 SSVEP 解码的嵌入式脑电图仪器平台的设计和定量评估},
  abstract = {This article presents an embedded EEG instrumentation platform for real-time steady state visually evoked potential (SSVEP) decoding based on an ESP32-S3 microcontroller and an ADS1299 analog front end. The system performs eight-channel EEG acquisition, zero-phase bandpass filtering, and canonical correlation analysis (CCA) entirely on-device, while supporting the wireless communication and closed-loop operation without external computation. A central contribution is the quantitative characterization of the platform as an integrated EEG measurement and processing instrument. Reported results demonstrate a stable shorted-input noise floor ($\approx 0.08~\mu \text V_\text rms$), tightly bounded sampling jitter (0.56-$\mu \text s$standard deviation), and negligible long-term drift ($100\,\%$decision agreement between the mixed-precision embedded pipeline and a 64-bit double-precision reference. Effective common-mode attenuation ranged from 106.2 to 115.4 dB under balanced conditions, with a localized 26.9-dB degradation observed under source-impedance mismatch. Closed-loop validation achieved$99.17\,\%$online accuracy and an information transfer rate of$27.66~\text bits/min$. These results position the proposed system as a quantitatively characterized embedded EEG measurement and processing platform for real-time SSVEP decoding.},
}

@misc{chin_teng_lin_0994a2d3dba1c460,
