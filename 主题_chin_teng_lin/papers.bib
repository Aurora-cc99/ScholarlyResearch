  author = {Chun-Hsiang Chuang and Shuu-Jiun Wang and Yu-Ting Liu and Jung-Tai King and Chih-Sheng Hung and Mauro Nascimben and Zehong Cao and Chin-Teng Lin and Yi-Hsin Yu and Tung-Ping Su and Avinash Kumar Singh},
  year = {2017},
  doi = {10.1109/ACCESS.2017.2675884},
  url = {https://doi.org/10.1109/ACCESS.2017.2675884},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：额头脑电图支持未来可行的个人医疗保健解决方案：睡眠管理、头痛预防和抑郁症治疗},
  abstract = {There are current limitations in the recording technologies for measuring EEG activity in clinical and experimental applications. Acquisition systems involving wet electrodes are time-consuming and uncomfortable for the user. Furthermore, dehydration of the gel affects the quality of the acquired data and reliability of long-term monitoring. As a result, dry electrodes may be used to facilitate the transition from neuroscience research or clinical practice to real-life applications. EEG signals can be easily obtained using dry electrodes on the forehead, which provides extensive information concerning various cognitive dysfunctions and disorders. This paper presents the usefulness of the forehead EEG with advanced sensing technology and signal processing algorithms to support people with healthcare needs, such as monitoring sleep, predicting headaches, and treating depression. The proposed system for evaluating sleep quality is capable of identifying five sleep stages to track nightly sleep patterns. Additionally, people with episodic migraines can be notified of an imminent migraine headache hours in advance through monitoring forehead EEG dynamics. The depression treatment screening system can predict the efficacy of rapid antidepressant agents. It is evident that frontal EEG activity is critically involved in sleep management, headache prevention, and depression treatment. The use of dry electrodes on the forehead allows for easy and rapid monitoring on an everyday basis. },
}

