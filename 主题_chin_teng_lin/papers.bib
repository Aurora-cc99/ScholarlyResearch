  author = {Hsin‐Yi Lai and Lun‐De Liao and Chin‐Teng Lin and Jui-Hsiang Hsu and Xin He and You‐Yin Chen and Jyh-Yeong Chang and Hui-Fen Chen and Siny Tsang and Yen‐Yu Ian Shih},
