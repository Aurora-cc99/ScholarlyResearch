@misc{chin_teng_lin_6addfae8ba426117,
  title = {A CDGFN-Based Quantum Multisource Information Fusion With Its Application in Time Series Classification},
  author = {Zehong Cao and Chin-Teng Lin and Junhao Yu and Fuyuan Xiao and Yi Zhang},
  year = {2026},
  doi = {10.1109/TKDE.2026.3652983},
  url = {https://doi.org/10.1109/TKDE.2026.3652983},
  howpublished = {IEEE Trans. Knowl. Data Eng.},
  annotation = {中文辅助译名：基于CDGFN的量子多源信息融合及其在时间序列分类中的应用},
  abstract = {Time series classification (TSC) is a critical area with broad applications. In the field of evidence theory, quantum evidence theory (QET) offers a promising framework for onedimensional TSC tasks, leveraging the capabilities of quantum basic probability amplitude (QBPA) to capture two-dimensional uncertainty. However, as the first step for the application of QET to TSC, how to construct QBPA still remains an open issue. In this paper, a novel approach to generate QBPA is devised. Specifically, we first apply the discrete Fourier transform (DFT) to the original data, extracting two-dimensional features embedded in the magnitude and phase from the frequency domain based on the front-few multi-frequency components, achieved by setting a threshold frequency index (TFI) to limit the frequencies considered. Next, we introduce the complex dual gaussian fuzzy number (CDGFN) as a carrier for QBPA, effectively representing two-dimensional uncertainty in the data. A CDGFN-based multisource information fusion (CDGFN-MSIF) algorithm for decision-making is proposed to combine information from different frequency components. Finally, the decisionmaking algorithm is validated on multiple time series datasets. Experimental results highlight the superior performance of the proposed approach over other state-of-the-art models, demonstrating its effectiveness and enhanced classification accuracy.},
}

@misc{chin_teng_lin_778ab777e668b79f,
  title = {Consensus-Guided Multi-Match Adaptation With Uncertainty-Calibrated Thresholding for Test-Time Cross-Modal Retrieval},
  author = {Yuanpeng He and Chung-Ju Huang and Lijian Li and Shizhuo Zhang and Wenpin Jiao and Chi‐Man Pun and Chin‐Teng Lin and Zhi Jin and Witold Pedrycz C and Haibin Ling and Philip S. Yu},
  year = {2026},
  doi = {10.1109/tkde.2026.3731404},
  url = {https://doi.org/10.1109/tkde.2026.3731404},
  howpublished = {IEEE Transactions on Knowledge and Data Engineering},
  annotation = {中文辅助译名：具有不确定性校准阈值的共识引导多重匹配适应，用于测试时跨模态检索},
  abstract = {This study enhances the robustness of pre-trained image–text retrieval models at test time, recovering the pre-trained similarity geometry under distribution shifts and modality degradations while preserving fine-grained cross-modal alignment. Existing Test-Time Adaptation methods, though effective for classification, are ill-suited to retrieval, where decisions require nuanced, bidirectional correspondences rather than single-label predictions. We address this gap with a framework that integratesConsensus-Guided Multi-Match Adaptation (CGMA)andUncertainty-Calibrated Matchwise Thresholding (UCMT)underBias-Only Fine-tuning. CGMA replaces single-candidate supervision with a consensus-guided strategy: it forms a temperature-scaled similarity distribution, selects Top-$k$matches as pseudo-labels, filters queries by average confidence via percentile ranking, and aggregates the retained candidates into a consensus target, against which a bidirectional cross-entropy/Kullback–Leibler objective is optimized to mitigate modality corruption and local semantic interference. UCMT complements CGMA by treating similarity scores as evidential signals to derive a bounded, sample-specific uncertainty that sets a per-sample threshold for a matchwise penalty: predictions above it are promoted and those below suppressed, with the threshold rising for uncertain samples and falling for confident ones, thereby slowing gradients and preventing over-optimization. The two modules are jointly optimized },
}

@misc{chin_teng_lin_57550c11e39d6b09,
