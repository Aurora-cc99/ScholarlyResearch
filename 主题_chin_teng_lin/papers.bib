  author = {Li-Wei Ko and Chih-Sheng Huang and Chun-Hsiang Chuang and Chin-Teng Lin},
  year = {2015},
  doi = {10.1016/J.KNOSYS.2015.01.007},
  url = {https://doi.org/10.1016/J.KNOSYS.2015.01.007},
