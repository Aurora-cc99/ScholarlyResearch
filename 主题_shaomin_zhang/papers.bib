@misc{shaomin_zhang_1eda57bc50b26c35,
  title = {Effects of cerebellar transcranial direct current stimulation on cognitive and motor impairments in patients with stroke a randomized clinical trial},
  author = {Qiuwen Gong and Dongyun Zhang and Zhou Feng and Yi Zhou and Rubing Yan and Xiaoyu Wu and Minmin Wang and Shaomin Zhang and Han Chen and Jingming Hou},
