@misc{shaomin_zhang_4558e7c60cdc73a2,
  title = {Monolithic multimodal neural probes for sustained stimulation and long-term neural recording},
  author = {Luxi Zhang and Shengming Wang and Jie Xia and Boyu Li and Shaomin Zhang and Jikui Luo and Fan Zhang and Tianyu Zheng and Gang Pan and Tawfique Hasan and Yanlan Yu and Guoqing Ding and Hao Jin and Zongyin Yang and Shurong Dong},
  year = {2025},
  doi = {10.1126/sciadv.adu1753},
  url = {https://doi.org/10.1126/sciadv.adu1753},
  howpublished = {Science Advances},
  annotation = {中文辅助译名：用于持续刺激和长期神经记录的整体多模式神经探针},
  abstract = {Long-term implantable neural probes with dual-mode optical stimulation and simultaneous electrical recording are crucial for modulating neural loop activity in vivo. Traditional probes using "add-on" strategies often suffer from mechanical rigidity, compromised electrical performance, and insufficient biocompatibility, limiting their clinical applicability. In this study, we present a method for the direct laser writing of electrode arrays onto the curved surface of optical fibers, integrating them within a biocompatible polymer coating to create monolithic neural probes. The monolithic probes demonstrate high mechanical bending endurance, stable impedance, and improved biocompatibility, resulting in a lower inflammatory response compared to conventional systems. Furthermore, our method facilitates the multilayer integration of multilayer electrodes onto optical fibers, enabling high-density electrical readout channels. This advancement represents substantial progress in neuroengineering, with promising implications for future neural monitoring and modulation applications.},
}

@misc{shaomin_zhang_7f9252fd55ced40c,
  title = {Transcranial Electrical Stimulation in Remote Rehabilitation:},
  author = {Minmin Wang and Huilin Mou and Xu Xie and Yuchen Xu and Yu‐Feng Zang and Xiangming Ye and Shaomin Zhang},
  year = {2025},
  doi = {10.1201/9781003419235-9},
  url = {https://doi.org/10.1201/9781003419235-9},
  howpublished = {CRC Press eBooks},
  annotation = {中文辅助译名：远程康复中的经颅电刺激：},
  abstract = {Transcranial electrical stimulation (TES) is a noninvasive neuromodulation technique that has shown potential in remote rehabilitation for various neurological conditions, including stroke, brain injury, Parkinson’s disease, and multiple sclerosis. This chapter explores the clinical applications of remote TES, assessing its efficacy and safety in remote rehabilitation. The key challenges include ensuring precise stimulation delivery, personalizing treatment protocols, and developing reliable monitoring systems. Ethical considerations, such as patient autonomy and equitable access, are also highlighted. Emerging technologies like artificial intelligence (AI)-driven personalized protocols, closed-loop systems, and integration with telemedicine platforms offer promising solutions for overcoming these challenges. Future advancements in these areas could further enhance the effectiveness and accessibility of TES in remote rehabilitation, providing more tailored treatment options for patients.},
}

