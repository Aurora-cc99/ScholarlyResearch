@misc{shaomin_zhang_34d766b2d31bda76,
  title = {Design of Dynamic Access Control Model for Power Market Operating System},
  author = {Baoyi Wang and Yuanhui Liu and Shaomin Zhang},
  year = {2008},
  doi = {10.1109/iita.2008.448},
  url = {https://doi.org/10.1109/iita.2008.448},
  howpublished = {Intelligent Information Technology Application},
  annotation = {中文辅助译名：电力市场操作系统动态访问控制模型设计},
  abstract = {Power market operating system is the technical supporting system of power market, and the security control of information access is the key factor for its normal running. So the information secrecy of power market, diversity of the user role and polytropy of access authority require strict and flexible access control mechanism must be possessed in power market operating system. In order to guarantee the userpsilas sensitive information more secure when the user is suspicious, the rolepsilas authority is divided into different grades in this paper, the userpsilas credibility is calculated according to the hidden information when he logs in, and then his authority is changed on the basis of his credibility. Based on this, a role-and-credibility based dynamic access control model is designed in this paper. After theory and application case analyses, in this model, illegal user canpsilat obtain the legal userpsilas all authority if he succeeds login, so he might find this ID isnpsilat the one that he wants and he doesnpsilat try to login again, so this model can protect the userpsilas sensitive information more security when he is suspicious.},
}

