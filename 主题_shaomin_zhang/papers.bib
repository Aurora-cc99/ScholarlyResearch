@misc{shaomin_zhang_e19ac7df2bc5bf97,
  title = {Soft Electronics for Neural Engineering},
  author = {Fan Zhang and Shurong Dong and Shaomin Zhang},
  year = {2024},
  doi = {10.1201/9781003493631-5},
  url = {https://doi.org/10.1201/9781003493631-5},
  howpublished = {CRC Press eBooks},
  annotation = {中文辅助译名：神经工程软电子学},
  abstract = {Soft neural electronics constitute a revolutionary domain in neural engineering that transforms the interaction between external devices and brain networks. Traditional neural interfaces face several limitations that impede long-term neural recording and stimulation, including low spatial resolution, tissue damage, device degradation, and a confined lifespan. The advent of soft neural electronics introduces a solution with flexible, biocompatible devices that seamlessly integrate with the brain. This chapter reviews the breakthroughs and applications in implanted soft neural interfaces, concentrating on neural recording, electrical neuromodulation, mechanical properties, and multimodal neural interfaces. Diverse conductive materials are explored, emphasizing their contributions to enhancing neural recording and electrical neuromodulation. Additionally, the pivotal role of mechanical properties is discussed, specifically flexible substrate materials that mitigate inflammation and improve neural interface lifespan. The chapter highlights the significance of soft electronics in multimodal neural interfaces, compatible with simultaneous electrical and optical observation or modulation and magnetic resonance imaging. Finally, recent advances in soft electronics, such as high-resolution neural electrode arrays and transient electronics, exhibit potential in advancing spatial coverage, resolution, integration, and overall safety within neural interfaces, thereby driving progress in },
}

