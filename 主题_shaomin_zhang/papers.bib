@misc{shaomin_zhang_ca3f6a717c3f8c14,
  title = {Dorsal Premotor Cortex Involved in Hand Gesture Preparation in Macaques},
  author = {Guanghao Sun and Shaomin Zhang and Ruixue Wang and Yaoyao Hao and Weidong Chen and Xiaoxiang Zheng},
  year = {2019},
  doi = {10.1101/869354},
  url = {https://doi.org/10.1101/869354},
  howpublished = {bioRxiv (Cold Spring Harbor Laboratory)},
  annotation = {中文辅助译名：背侧前运动皮层参与猕猴手势准备},
  abstract = {Reaching to grasp movement is thought to rely upon two independent brain pathways. The dorsomedial one is involved in reaching while the dorsolateral one is dealing with grasping. However, some recent evidences suggested that the dorsomedial pathway might participate in grasp movement. Therefore, it is important to investigate whether PMd is involved in grasp planning, and if participating, what kind of role PMd played in grasp planning. In this study, two macaques monkeys were trained to grasp same object by instructing or freely choosing one of two grips, power grip or hook grip. A 96-channel microelectrode array was implanted to collect the population activity of PMd in each subject. Both single unit activity and population activity were analyzed. We found that nearly 21.0% and 26.8% units in PMd of two monkeys displayed grip selectivity during gesture planning in both instructing or freely choosing conditions. These units exhibit selectivity for different gestures when facing the identical visual stimuli (freely choosing condition). At the same time, similar activity patterns are displayed for the same gesture when faced with different selection strategies (freely choosing condition vs. instructing condition). These results show that some neurons of PMd are mainly involved in the hand shape preparation and have no obvious relationship with external visual stimuli and selection strategies.},
}

@misc{nenggan_zheng_7218a96bdd67b296,
