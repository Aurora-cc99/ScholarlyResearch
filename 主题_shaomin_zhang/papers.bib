@misc{shaomin_zhang_eecc672e28bf43d3,
  title = {Development and Preliminary Validation of a Wearable Tumor Treating Fields Device for Breast Cancer Therapy},
  author = {Yue Lan and Yanyu Zheng and Ying Zhu and Xu Xie and Huilin Mou and Weiqiong Jin and Yunfeng Pan and Weidong Chen and Shaomin Zhang and Guangdi Chen and Minmin Wang},
