@misc{shaomin_zhang_2a4bb99d3049c2bd,
  title = {An ultrasensitive multimodal intracranial pressure biotelemetric system enabled by exceptional point and iontronics},
  author = {Jie Li and Fan Zhang and Xiaobin Xia and Kaihang Zhang and Jianhui Wu and Yulu Liu and Chi Zhang and Xinyu Cai and Jiaqi Lu and Liangquan Xu and Rui Wan and Dinku Hazarika and Weipeng Xuan and Jinkai Chen and Zhen Cao and Yubo Li and Hao Jin and Shurong Dong and Shaomin Zhang and Zhilu Ye and Minye Yang and Pai‐Yen Chen and Jikui Luo},
  year = {2024},
  doi = {10.1038/s41467-024-53836-8},
  url = {https://doi.org/10.1038/s41467-024-53836-8},
  howpublished = {Nature Communications},
  annotation = {中文辅助译名：由特殊点和离子电子技术实现的超灵敏多模式颅内压生物遥测系统},
  abstract = {The accurate monitoring of vital physiological parameters, exemplified by heart rate, respiratory rate, and intracranial pressure (ICP), is of paramount importance, particularly for managing severe cranial injuries. Despite the rapid development of implantable ICP sensing systems over the past decades, they still suffer from, for example, wire connection, low sensitivity, poor resolution, and the inability to monitor multiple variables simultaneously. Here, we propose an ultrasensitive multimodal biotelemetric system that amalgamates an iontronic pressure transducer with exceptional point (EP) operation for the monitoring of ICP signals. The proposed system can exhibit extraordinary performance regarding the detection of minuscule ICP fluctuation, demonstrated by the sensitivity of 115.95 kHz/mmHg and the sensing resolution down to 0.003 mmHg. Our system excels not only in the accurate quantification of ICP levels but also in distinguishing respiration and cardiac activities from ICP signals, thereby achieving the multimodal monitoring of ICP, respiratory, and heart rates within a single system. Our work may provide a pragmatic avenue for the real-time wireless monitoring of ICP and thus hold great potential to be extended to the monitoring of other vital physiological indicators.},
}

@misc{shaomin_zhang_151b47b26e610877,
  title = {Brain organoids in motor cortex involved in motor output},
  author = {Xiaoman Fan and Yuchen Xu and Shibo Xu and Yuqi Yang and Lufeng Shi and Yan Liu and Shaomin Zhang},
  year = {2024},
  doi = {10.1145/3691521.3691532},
  url = {https://doi.org/10.1145/3691521.3691532},
  howpublished = {International Conference on Biomedical Signal and Image Processing (ICBIP)},
  annotation = {中文辅助译名：运动皮层中参与运动输出的脑类器官},
  abstract = {Motor function is essential in daily life while brain damage in motor system such as stroke would lead to long term motor function deficits. Brain organoids, a novel in vitro stem cell culture technology, offer a new idea for motor function recovery. In this study, we pumped out the motor cortex of forelimbs to mimic brain injury in mice and implanted human brain organoids into the cavity combined with microwire electrodes to simultaneously record neural signals from both the organoids and the host animals. Our findings indicate that the brain organoids can be involved in motor output and the involvement can be improved through behavioral training.},
}

@misc{shaomin_zhang_46c1f13340d77bb8,
  title = {Dynamic lateralization in contralateral-projecting corticospinal neurons during motor learning},
  author = {Jiawei Han and Ruixue Wang and Minmin Wang and Zhihua Yu and Liang Jun Zhu and Jianmin Zhang and Junming Zhu and Shaomin Zhang and Xi Wang and Hemmings Wu},
  year = {2024},
  doi = {10.1016/j.isci.2024.111078},
  url = {https://doi.org/10.1016/j.isci.2024.111078},
  howpublished = {iScience},
  annotation = {中文辅助译名：运动学习过程中对侧投射皮质脊髓神经元的动态偏侧化},
  abstract = {Understanding the adaptability of the motor cortex in response to bilateral motor tasks is crucial for advancing our knowledge of neural plasticity and motor learning. Here we aim to investigate the dynamic lateralization of contralateral-projecting corticospinal neurons (cpCSNs) during such tasks. Utilizing in vivo two-photon calcium imaging, we observe cpCSNs in mice performing a "left-right" lever-press task. Our findings reveal heterogeneous populational dynamics in cpCSNs: a marked decrease in activity during ipsilateral motor learning, in contrast to maintained activity during contralateral motor learning. Notably, individual cpCSNs show dynamic shifts in engagement with ipsilateral and contralateral movements, displaying an evolving pattern of activation over successive days. It suggests that cpCSNs exhibit adaptive changes in activation patterns in response to ipsilateral and contralateral movements, highlighting a flexible reorganization during motor learning This reconfiguration underscores the dynamic nature of cortical lateralization in motor learning and offers insights for neuromotor rehabilitation.},
}

@misc{shaomin_zhang_49604ed800295b6a,
  title = {Tumor Treating Fields induced Electric Field Distribution for Breast Cancer Treatment A Computational Study},
  author = {Yuru Tian and Xu Xie and Yan Lan and Yun Pan and Dan Wu and Shaomin Zhang and Minmin Wang},
  year = {2024},
  doi = {10.1145/3691521.3691525},
  url = {https://doi.org/10.1145/3691521.3691525},
  howpublished = {International Conference on Biomedical Signal and Image Processing (ICBIP)},
  annotation = {中文辅助译名：肿瘤治疗场诱导电场分布用于乳腺癌治疗的计算研究},
  abstract = {Breast cancer stands as one of the most prevalent and challenging malignancies, necessitating innovative therapeutic approaches. Tumor Treating Fields (TTFields) have emerged as a promising non-invasive avenue in breast cancer therapy. The effectiveness of TTFields largely hinges on the electric field distribution within tumor tissues, which is influenced by various tumor characteristics including location, size, and morphology. However, a significant research gap exists in the TTFields-induced electric field distribution for breast cancer therapy. This study introduces an accessible TTFields transducer placement method tailored for breast cancer treatment, employing finite element analysis to investigate the impact of different tumor attributes on the induced field distribution. Our findings indicate significant effects of tumor characteristics on the induced electric field distribution, highlighting the critical need for personalized transducer placement optimization. This research offers valuable insights and broadens the application prospects of TTFields in breast cancer treatment.},
}

@misc{shaomin_zhang_eb253999e89ebd0f,
  title = {AutoSimTTF: A Fully Automatic Pipeline for Electric Field Simulation and Treatment Planning of Tumor Treating Fields},
  author = {Minmin Wang and Xie, Xu and Zhengbo Fan and Yan Lan and Yun Pan and Guangdi Chen and Shaomin Zhang and Yuxing Wang},
  year = {2024},
  doi = {10.48550/arxiv.2410.12196},
  url = {https://arxiv.org/abs/2410.12196},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：AutoSimTTF：用于肿瘤治疗场电场模拟和治疗规划的全自动流程},
  abstract = {Objective: Tumor Treating Fields (TTFields) is an emerging approach for cancer therapy that inhibits tumor cell proliferation by applying alternating electric fields (EF) of intermediate frequency and low intensity. The TTFields-induced electric field intensity at the tumor site is closely related to the therapeutic efficacy. Therefore, the EF simulation based on realistic head models have been utilized for the dosage analysis and treatment optimization of TTFields. However, current modeling methods require manual segmentation of tumors and rely on commercial software, which is time-consuming and labor-intensive. Approach: We introduce AutoSimTTF, a fully automatic pipeline for simulating and optimizing the EF distribution for TTFields. The main steps of AutoSimTTF utilize open-source toolkits, enabling fully automated processing of individual MRI data for TTFields. Additionally, AutoSimTTF allows for parameter optimization based on individual anatomical information, thereby achieving a more focused and higher EF distribution at the tumor site. Main results: Compared to conventional EF calculation processes, deviations in AutoSimTTF are below 20%. The optimal treatment parameters generated by AutoSimTTF produces a higher EF intensity at the tumor site (111.9%) and better focality (19.4%) compared to traditional TTFields settings. Significance: AutoSimTTF provides significant reference value and guidance for the clinical application and treatment planning of TTFields.},
}

@misc{shaomin_zhang_a08502960e6f5ad8,
  title = {Clinical Comparison between HD-tDCS and tDCS for Improving Upper Limb Motor Function: A Randomized, Double-Blinded, Sham-Controlled Trial},
  author = {Yaqin Zeng and Ruidong Cheng and Li Zhang and Shan Fang and Shaomin Zhang and Minmin Wang and Qian Lv and Yunlan Dai and X GONG and Feng Liang},
  year = {2024},
  doi = {10.1155/2024/2512796},
  url = {https://doi.org/10.1155/2024/2512796},
  howpublished = {Neural Plasticity},
  annotation = {中文辅助译名：HD-tDCS 和 tDCS 改善上肢运动功能的临床比较：随机、双盲、假对照试验},
  abstract = {Background: Stroke is a common and frequently occurring disease among middle-aged and elderly people, with approximately 55%-75% of patients remaining with upper limb dysfunction. How to promote the recovery of motor function at an early stage is crucial to the life of the patient. Objectives: This study aimed to investigate whether high-definition transcranial direct current stimulation (HD-tDCS) of the primary motor cortex (M1) functional area in poststroke patients in the subacute phase is more effective in improving upper limb function than conventional tDCS. Methods: This randomized, sham-controlled clinical trial included 69 patients with subcortical stroke. They were randomly divided into the HD-tDCS, anodal tDCS (a-tDCS), and sham groups. Each group received 20 sessions of stimulation. The patients were assessed using the Action Research Arm Test, Fugl-Meyer score for upper extremities, Motor Function Assessment Scale, and modified Barthel index (MBI) pretreatment and posttreatment. Results: The intragroup comparison scores improved after 4 weeks of treatment. The HD-tDCS group showed a slightly greater, but nonsignificant improvement as compared to a-tDCS group in terms of mean change observed in function of trained items. The MBI score of the HD-tDCS group was maintained up to 8 weeks of follow-up and was higher than that in the a-tDCS group. Conclusion: Both HD-tDCS and a-tDCS can improve upper limb motor function and daily activities of poststroke patients in the },
}

@misc{shaomin_zhang_8ed1866486b3f84a,
  title = {MTL-DEUnet: meta-transfer learning enhanced dual encoder U-Net for accurate cell nucleus segmentation},
  author = {Daifu Chao and Lijia Zhi and Shaomin Zhang and Siqing Zhang and Chonghua Yu},
  year = {2024},
  doi = {10.1117/12.3048538},
  url = {http://dx.doi.org/10.1117/12.3048538},
  howpublished = {International Conference on Optics, Electronics, and Communication Engineering (OECE)},
  annotation = {中文辅助译名：MTL-DEEUnet：元迁移学习增强型双编码器 U-Net，用于精确的细胞核分割},
  abstract = {Cells are capable of conveying rich information about their microenvironment. Automated cell nucleus segmentation technology not only alleviates the workload of pathologists but also provides accurate microenvironment data applied to biological and clinical research. Existing deep learning models show excellent performance given a large volume of labeled data, they still usually require some manual labeling for domain-specific training when faced with data from unknown fields. Unfortunately, obtaining precise annotations of histopathological images is an extremely challenging task that is not only highly dependent on expert knowledge but also takes a significant amount of time. In this study, we aim to develop a general cell nucleus model for segmentation that requires a smaller amount of data and has broader applicability. To this end, we designed a Dual Encoder U-net model based on Meta Transfer Learning (MTL), which can learn effectively with fewer training samples. Our network employs a Meta Transfer Learning optimization algorithm and introduces a feature fusion module to integrate deep and shallow feature information. Experimental results show that our proposed MTLDEUnet model not only enhances the generalization ability of the model but also achieves performance comparable to the current highly advanced models trained with a limited sample set.},
}

@misc{shaomin_zhang_d432074241b63bfb,
  title = {7T Magnetic Compatible Multimodality Electrophysiological Signal Recording System},
  author = {Jiadong Pan and Jie Xia and Fan Zhang and Luxi Zhang and Shaomin Zhang and Gang Pan and Shurong Dong},
  year = {2023},
  doi = {10.3390/electronics12173648},
  url = {https://doi.org/10.3390/electronics12173648},
  howpublished = {Electronics},
  annotation = {中文辅助译名：7T 磁兼容多模态电生理信号记录系统},
  abstract = {This paper developed a comprehensive magnetic resonance imaging (MRI)-compatible electrophysiological (EP) acquisition system, which can acquire various physiological electrical signals, including electrocardiography (ECG), electromyography (EMG), electroencephalography (EEG) and electrocorticogram (ECoG), and EP recording combined with multimodal stimulation. The system is designed to be compatible with the 7-Tesla (7T) ultra-high field MRI environment, providing convenience for neuroscience and physiological research. To achieve MRI compatibility, the device uses magnetically compatible materials and shielding measures on the hardware and algorithm processing on the software side. Different filtering algorithms are adopted for different signals to suppress all kinds of interference in the MRI environment. The system can allow input signals up to ±0.225 V and channels up to 256. The equipment has been tested and proven to be able to collect a variety of physiological electrical signals effectively. When scanned under the condition of a 7T high-intensity magnetic field, the system does not generate obvious heating and can meet the safety requirements of MRI and EEG acquisition requirements. Moreover, an algorithm is designed and improved to efficiently and automatically remove the gradient artifact (GA) noise generated by MRI, which is a thousand-fold gradient artifact. Overall, this work proposes a complete, portable, MRI-compatible system that can collect a variety of physi},
}

@misc{shaomin_zhang_836fd3042c7d6e32,
  title = {Multifunctional Evaluation Technology for Diagnosing Malfunctions of Regional Pelvic Floor Muscles Based on Stretchable Electrode Array Probe},
  author = {Shengming Wang and Luoqi Yang and Haofei Jiang and Jie Xia and Wenjuan Li and Zujuan Zhang and Shaomin Zhang and Hao Jin and Jikui Luo and Shurong Dong and Yanlan Yu and Zhenwei Xie},
  year = {2023},
  doi = {10.3390/diagnostics13061158},
  url = {https://doi.org/10.3390/diagnostics13061158},
  howpublished = {Diagnostics},
  annotation = {中文辅助译名：基于可拉伸电极阵列探头的盆底区域肌肉功能障碍诊断多功能评估技术},
  abstract = {The pelvic floor dysfunction (PFD) has become a serious public health problem. Accurate diagnosis of regional pelvic floor muscle (PFM) malfunctions is vitally important for the prevention and treatment of PFD. However, there is a lack of reliable diagnostic devices to evaluate and diagnose regional PFM abnormality. In this work, we developed a multifunctional evaluation technology (MET) based on a novel airbag-type stretchable electrode array probe (ASEA) for the diagnosis of malfunctions of regional PFM. The inflatable ASEA has specifically distributed 32 electrodes along the muscles, and is able to adapt to different human bodies for tight contact with the muscles. These allow synchronous collection of high-quality multi-channel surface electromyography (MC-sEMG) signals, and then are used to diagnose regional PFM malfunctions and evaluate inter-regional correlation. Clinical trial was conducted on 15 postpartum stress urinary incontinence (PSUI) patients and 15 matched asymptomatic women. Results showed that SUI patients responded slowly to the command and have symptoms of muscle strength degeneration. The results were consistent with the relevant clinical manifestations, and proved the reliability of MET for multifunctional PFM evaluation. Furthermore, the MET can diagnose malfunctions of regional PFM, which is inaccessible with existing technology. The results also showed that the dysfunction of PSUI patients is mainly located in iliococcygeus, pubococcygeus, and urethr},
}

