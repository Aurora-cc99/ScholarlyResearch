  title = {Corrigendum: Long-term decoding stability of local field potentials from silicon arrays in primate motor cortex during a 2D center out task (2014 J. Neural Eng. 11 036009)},
  author = {Dong Wang and Qiaosheng Zhang and Yue Li and Yiwen Wang and Junming Zhu and Shaomin Zhang and Xiaoxiang Zheng},
