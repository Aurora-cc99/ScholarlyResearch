  annotation = {中文辅助译名：微透析技术在中医药中的应用},
  abstract = {The concentration of extracellular neurotransmitters can be dynamically measured by in vivo microdialysis. This technique can apply to quantitatively evaluating the beneficial effects of Traditional Chinese Medicine (TCM). In the present study, the protective effects of Puerarin (Pur) on cerebral injuries evoked by ischemia/reperfusion was supported by a decrease of extracellular amino acids, especially glutamate (Glu), which were monitored by microdialysis combined with HPLC throughout the experiments. It suggested that, in addition to being a versatile and practical method in neuroscience, the microdialysis technique would play an important role in assessing and screening the effects of TCM.},
}

