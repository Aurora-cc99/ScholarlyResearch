@misc{nenggan_zheng_722cf87833fbab86,
  title = {Data from: Real-time, cross-modal genotype mapping of free-moving Drosophila larvae via simultaneous mechano-electrophysiological recording},
  author = {Kairu Dong and Hao Song and Qianhui Zhao and Zhiying Song and Fu Lv and Siouwen Wan and Tianyu Zheng and Yunlong Fan and Wenzhe Liu and Shaomin Zhang and Yong Jun Wu and Yu Huang and Jizhou Song and Zhefeng Gong and Nenggan Zheng and Kewang Nan},
  year = {2026},
  doi = {10.5061/dryad.s1rn8pkpr},
  url = {https://doi.org/10.5061/dryad.s1rn8pkpr},
  howpublished = {DRYAD},
  annotation = {中文辅助译名：数据来自：通过同步机械电生理记录对自由移动的果蝇幼虫进行实时、跨模式基因型图谱},
  abstract = {Drosophila larvae provide a powerful model for interrogating genes associated with human muscle and neurological disorders; however, existing genotyping and phenotyping approaches remain low-throughput and often rely on destructive, invasive, or toxic procedures. Here, we present a scalable bioelectronic platform that enables real-time, simultaneous mechano-electrophysiological recording from freely moving Drosophila larvae in an open three-dimensional (3D) space, allowing high-throughput cross-modal genotype mapping (CMGM). The system integrates conductive and piezoelectric microneedle electrodes into a flexible sensory array that achieves stable, long-term signal acquisition during unrestricted and complex 3D locomotion. By coupling dual-modal signal acquisition with machine-learning-assisted classification, we directly identify muscle defects in unlabeled RNAi-knockdown larvae within 30 minutes, without invasive manipulation or time-consuming sample preparation. Incorporation of both electrophysiological and mechanical waveform features improves overall classification accuracy to 96%, outperforming single-modality approaches. This non-destructive, high-throughput CMGM strategy establishes a generalizable framework for bridging genotype and phenotype in intact, freely behaving organisms, with broad implications for functional genetics and disease modeling.},
}

