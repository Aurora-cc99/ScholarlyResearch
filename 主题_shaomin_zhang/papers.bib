@misc{shaomin_zhang_bfb0cbebe8c633dd,
  title = {RETRACTED ARTICLE: Implantable neural probes with monolithically integrated CNTFET arrays for multimodal monitoring},
  author = {Jie Xia and Luxi Zhang and Shengming Wang and Yanlan Yu and Li Ding and Fan Zhang and Shaomin Zhang and Jikui Luo and Yan Yan Shery Huang and Luigi G. Occhipinti and Gang Pan and Zhen Cao and Guoqing Ding and Shurong Dong},
  year = {2025},
  doi = {10.1038/s41467-025-67535-5},
