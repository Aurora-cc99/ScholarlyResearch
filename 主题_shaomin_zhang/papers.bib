  annotation = {中文辅助译名：控制猕猴伸手和抓握运动的神经协同作用},
}

@misc{shaomin_zhang_7b6e0fbe6b531cc9,
  title = {Dorsal premotor area of the macaque monkey participates the preparation of grasp movements},
  author = {Guanghao Sun and Yiyi Yang and Junming Zhu and Xiaoxiang Zheng and Kedi Xu and Qiaosheng Zhang and Shaomin Zhang},
  year = {2017},
  doi = {10.1109/NER.2017.8008357},
  url = {https://doi.org/10.1109/NER.2017.8008357},
  howpublished = {NER},
  annotation = {中文辅助译名：猕猴的背侧前运动区参与抓握动作的准备},
  abstract = {Brain control of prehension is thought to rely on two specific brain circuits. The dorsomedial pathway is involved in the reach movements meanwhile the dorsolateral one is dealing with grasping components. However, recent studies have demonstrated that the dorsomedial pathway also takes part in grasp movement. Raos et al. found that some neurons in dorsal premotor (PMd) show high selectivity for specific gestures during movement planning period. But it is still unclear whether the distinct discharging of these neurons during movement plans is related to external visual stimuli induced by the shape and size of the object or internal movement selection for preshaping hand. In this study, we aimed to directly compare neuronal activity of PMd during the planning of internally and externally driven grasp movements. We trained a monkey to grasp the same object by freely choosing one of two gesture type (Power and Hook). Neural activities from its PMd were collected through a microelectrode array when the monkey was performing the task. With single neural activity (SUA) analysis, we found that 18% of neurons in PMd showed significant selectivity for hand shapes during planning period. Meanwhile, the gesture classification based on neuronal population activity showed that the decoding performance of the neurons with achieved 93.5% in planning period. Our results confirmed that PMd neurons participate the preparation of grasp movements.},
}

@misc{shaomin_zhang_7a5d6505cee1bfa7,
  title = {Prior Knowledge of Target Direction and Intended Movement Selection Improves Indirect Reaching Movement Decoding},
  author = {Hongbao Li and Yaoyao Hao and Shaomin Zhang and Yiwen Wang and Weidong Chen and Xiaoxiang Zheng},
  year = {2017},
  doi = {10.1155/2017/2182843},
  url = {https://doi.org/10.1155/2017/2182843},
  howpublished = {Behavioural Neurology},
  annotation = {中文辅助译名：目标方向和预期运动选择的先验知识可改善间接到达运动解码},
  abstract = {Objective.Previous studies have demonstrated that target direction information presented by the dorsal premotor cortex (PMd) during movement planning could be incorporated into neural decoder for achieving better decoding performance. It is still unknown whether the neural decoder combined with only target direction could work in more complex tasks where obstacles impeded direct reaching paths.Methods.In this study, spike activities were collected from the PMd of two monkeys when performing a delayed obstacle-avoidance task. We examined how target direction and intended movement selection were encoded in neuron population activities of the PMd during movement planning. The decoding performances of movement trajectory were compared for three neural decoders with no prior knowledge, or only target direction, or both target direction and intended movement selection integrated into a mixture of trajectory model (MTM).Results.We found that not only target direction but also intended movement selection was presented in neural activities of the PMd during movement planning. It was further confirmed by quantitative analysis. Combined with prior knowledge, the trajectory decoder achieved the best performance among three decoders.Conclusion.Recruiting prior knowledge about target direction and intended movement selection extracted from the PMd could enhance the decoding performance of hand trajectory in indirect reaching movement.},
}

