  author = {Liping Qin and Xu Xie and Minmin Wang and Mingwei Ma and Yun Pan and Guangdi Chen and Shaomin Zhang},
  year = {2024},
  doi = {10.7507/1001-5515.202306074},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/11058494},
