@misc{shaomin_zhang_ef4b4842670db10c,
  title = {A Vision Transformer Architecture For Overt Speech Decoding From ECoG Data},
  author = {Shaomin Zhang and Guillaume Charvet and Blaise Yvert and Xingchen Ran and Philippe Kahane and Stéphan Chabardès and Florent Bocquelet and Mohamed Baha Ben Ticha and Lucas Struber and Marc Aubert and Philémon Roussel and Thomas Costecalde and Gaël Le Godais},
  year = {2024},
  doi = {10.1109/EMBC53108.2024.10781877},
  url = {https://doi.org/10.1109/EMBC53108.2024.10781877},
  howpublished = {EMBC},
  annotation = {中文辅助译名：用于从 ECoG 数据进行公开语音解码的视觉转换器架构},
  abstract = {Speech Brain-Computer Interfaces rely on decoding algorithms that transform neural activity into speech. A current challenge is to achieve intelligible speech synthesis in real time from continuous ongoing brain activity, ideally without the need of language models that prevent free-speech production. As a first step toward this goal, we introduce here an encoder-decoder architecture, in which neural data is first encoded into a latent space using a multi-layer vision transformer (ViT), and then these latent variables are converted into acoustic coefficients using a bidirectional LSTM recurrent network. This network is compared to a more conventional architecture where the encoding is performed using a convolutional neural network. Moreover, we introduce a new data-driven data augmentation strategy based on Dynamic Time Warping (DTW) to increase a training dataset based on the intrinsic variability of its input neural features. On two ECoG datasets obtained in participants performing an overt speech task, we found that ViT-encoding outperforms CNN-encoding to predict produced speech offline and that DTW-based data augmentation also improves decoding performance.},
}

@misc{shaomin_zhang_0756ab5864298a21,
  title = {Transparent electrode for neural electrical stimulation and synchronized optical imaging},
  author = {Fan Zhang and Tao Feng and Ruixue Wang and Jiawei Han and Minmin Wang and Xi Wang and Shaomin Zhang},
  year = {2024},
  doi = {10.1145/3691521.3691531},
  url = {https://doi.org/10.1145/3691521.3691531},
  howpublished = {International Conference on Biomedical Signal and Image Processing (ICBIP)},
  annotation = {中文辅助译名：用于神经电刺激和同步光学成像的透明电极},
  abstract = {Transcranial electrical stimulation (TES) is widely used in treating brain disorders and enhancing cognitive functions. However, its effects and underlying neural mechanisms remain unclear, hindering further clinical development. This study introduces a novel transparent neural electrical stimulation (NES) electrode, paired with simultaneous in-situ two-photon calcium imaging, to investigate the effects and mechanisms of transcranial direct current stimulation. We developed an NES electrode with over 80% light transmittance in the visible spectrum and high electrical conductivity, utilizing micro-nano manufacturing technology and indium tin oxide, a transparent conductive material. This design ensures unobstructed optical interrogation and effective electrical stimulation. The electrode conforms snugly to the mouse cortex, efficiently delivering electric charges without degradation under varied polarization conditions (anodal and cathodal stimulations at 1.59 mA/cm² for 30 seconds across three trials), thereby maintaining consistent electrical and optical performance. Through this transparent electrode, we directly observed the effects of both anodal and cathodal direct current stimulation on neuronal activity in the cortex of an awake mouse. Due to the excellent transparency and electrical conductivity, the NES electrode can be combined with multiple optical brain imaging techniques to provide insights into the neural mechanisms and optimization strategies for treating brain},
}

