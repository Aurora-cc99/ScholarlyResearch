  title = {A Novel Attribute Reduction Algorithm Based on Rough Set and Information Entropy Theory},
  author = {Baoyi Wang and Shaomin Zhang},
  year = {2007},
  doi = {10.1109/cisw.2007.4425451},
  url = {https://doi.org/10.1109/cisw.2007.4425451},
