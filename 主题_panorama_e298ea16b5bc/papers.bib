@misc{panorama_e298ea16b5bc_fa9ca0f59d521f16,
  title = {MSANet: Congestion Prediction for Chip Routing Based on Multi-Scale Attention Network},
  author = {Rui Liu and Guorui Liu and Xuemei Lei},
  year = {2024},
  doi = {10.1109/isset62871.2024.10779655},
  url = {https://doi.org/10.1109/isset62871.2024.10779655},
  howpublished = {International Symposium on Semiconductor and Electronic Technology (ISSET)},
  annotation = {中文辅助译名：MSANet：基于多尺度注意力网络的芯片路由拥塞预测},
  abstract = {Placement and routing are the most time-consuming parts of the chip design process. Reducing routing congestion is crucial for optimizing placement and improving routability. However, existing congestion prediction models cannot fully utilize the feature information of the chip placement during the prediction process, leading to low prediction accuracy. Therefore, this paper proposes a new multi-scale perception convolutional neural network, called MSAN et, to extract and fully utilize the rich multi-scale feature information from chip placement diagrams, thereby improving the accuracy of predicting routing congestion hotspots. To sufficiently demonstrate the prediction ability of the proposed MSAN et, we conduct extensive experimental validation on two publicly classical datasets. The experimental results show that MSAN et achieves a 46.5% improvement over the existing state-of-the-art methods on the ISPD2015 benchmark dataset, which demonstrates the strong effectiveness of the proposed multi-scale attention mechanisms and shortcut operations of the MSAN et. Moreover, on the large-scale CircuitN et dataset, our MSAN et achieve a 7.1 % improvement compared to the original model, demonstrated the superiority of our approach.},
}

@misc{panorama_e298ea16b5bc_b259c534904ee9b9,
  title = {OB-YOLO: A UAV Image Detection Model for Reducing Computational Resource Consumption},
  author = {Rui Liu and Yuan Zhu and Yanqiang Wang and Zhecong Xing},
  year = {2024},
  doi = {10.1109/IJCNN60899.2024.10649954},
  url = {https://doi.org/10.1109/IJCNN60899.2024.10649954},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：OB-YOLO：一种减少计算资源消耗的无人机图像检测模型},
  abstract = {In contemporary society, the pervasive integration of Unmanned Aerial Vehicles (UAVs) in everyday activities is notable. Object detection emerges as a pivotal task within the UAV operational context. However, challenges such as the presence of expansive backgrounds in UAV images, insufficient target pixel resolution, and the prevalence of image interferences contribute to the diminished accuracy observed in existing object detection models tailored for UAV aerial imagery. Conventional strategies employed to enhance accuracy often incur exorbitant computational costs, failing to strike a harmonious balance between precision improvement and computational resource utilization. To address these challenges, this paper introduces an optimized variant of YOLOv8, denoted as OB-YOLO, specifically tailored for UAV aerial photography scenarios. The proposed model exhibits enhanced accuracy while concurrently mitigating parameter and floating-point operation costs. Particularly, the BiFPN concept is incorporated to fortify the feature fusion process, enabling comprehensive consideration and reuse of multi-scale feature fusion within the model. Additionally, the study integrates the full-dimensional dynamic convolution (ODConv) structure to replace the ordinary convolution within residual networks in the C2f module of the backbone network. This augmentation not only enhances the model’s feature extraction capabilities but also significantly reduces both the number of model parameters and },
}

@misc{licai_sun_bb800715a844,
  title = {OV-MER: Towards Open-Vocabulary Multimodal Emotion Recognition},
  author = {Zheng Lian and Haiyang Sun and Licai Sun and Lan Chen and Haoyu Chen and Hao Gu and Zhuofan Wen and Shun Chen and Siyuan Zhang and Hailiang Yao and Mingyu Xu and Kang Chen and Bin Liu and Rui Liu and Shan Liang and Ya Li and Jiangyan Yi and Jianhua Tao},
  year = {2024},
  doi = {10.48550/arxiv.2410.01495},
  url = {http://arxiv.org/abs/2410.01495},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：OV-MER：迈向开放词汇多模态情感识别},
  abstract = {Multimodal Emotion Recognition (MER) is a critical research area that seeks to decode human emotions from diverse data modalities. However, existing machine learning methods predominantly rely on predefined emotion taxonomies, which fail to capture the inherent complexity, subtlety, and multi-appraisal nature of human emotional experiences, as demonstrated by studies in psychology and cognitive science. To overcome this limitation, we advocate for introducing the concept of open vocabulary into MER. This paradigm shift aims to enable models to predict emotions beyond a fixed label space, accommodating a flexible set of categories to better reflect the nuanced spectrum of human emotions. To achieve this, we propose a novel paradigm: Open-Vocabulary MER (OV-MER), which enables emotion prediction without being confined to predefined spaces. However, constructing a dataset that encompasses the full range of emotions for OV-MER is practically infeasible; hence, we present a comprehensive solution including a newly curated database, novel evaluation metrics, and a preliminary benchmark. By advancing MER from basic emotions to more nuanced and diverse emotional states, we hope this work can inspire the next generation of MER, enhancing its generalizability and applicability in real-world scenarios. Code and dataset are available at: https://github.com/zeroQiaoba/AffectGPT.},
}

