@misc{panorama_e298ea16b5bc_79698e6f10daafb8,
  title = {Unraveling the mechanisms behind the enhanced efficacy of β-lactam-based sideromycins},
  author = {Evelyne Lacasse and Renaud Binette and Héloïse Guibout and Rui Liu and Yun‐Ming Lin and Manuka Ghosh and Pierre‐Luc Boudreault and Marvin J. Miller and François Malouin},
  year = {2025},
  doi = {10.1038/s42003-025-08898-9},
  url = {https://doi.org/10.1038/s42003-025-08898-9},
  howpublished = {Communications Biology},
  annotation = {中文辅助译名：揭示基于 β-内酰胺的铁霉素增强功效背后的机制},
  abstract = {Previous studies have explored combining β-lactams with siderophores to create Trojan horse molecules that can penetrate the outer membrane of Gram-negative bacteria via TonB-dependent transporter (TBDT). While the main advantage explaining their enhanced antibiotic activity is believed to be improved membrane permeability, other factors remain underexplored. This study evaluates three siderophore-β-lactam compounds: a bis-catechol siderophore linked to ampicillin or loracarbef, and a mixed bis-catechol-mono-hydroxamate siderophore linked to cefaclor. Minimal inhibitory concentrations showed that siderophore conjugation could enhance β-lactam efficacy by over 8000-fold. Comparison with unconjugated β-lactams revealed a complex interplay between β-lactamase susceptibility, competition with endogenous siderophore, membrane uptake, and binding to penicillin-binding proteins (PBPs). Enhanced PBP binding, particularly in Escherichia coli, emerged as a key factor contributing to improved bacterial inhibition by siderophore-β-lactam conjugates. Overall, the study provides insights into how siderophore conjugation enhances β-lactam activity and the therapeutic potential of the conjugates as narrow or broad-spectrum antibiotics.},
}

@misc{panorama_e298ea16b5bc_33fe3973431b288a,
