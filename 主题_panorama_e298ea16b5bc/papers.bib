@misc{panorama_e298ea16b5bc_92413264378aad3d,
  title = {Carrying Traditional Folk Culture Forward,Promoting the Development of Rural Cultural Industry},
  author = {Rui Liu},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=SXND201001013},
  howpublished = {Shanxi nongye daxue xuebao. Ziran kexue ban},
  annotation = {中文辅助译名：弘扬传统民俗文化促进乡村文化产业发展},
  abstract = {The rural area riches in traditional folk culture in our country.Carrying traditional folk culture forward and developing the folk cultural industry not only transfers the extra labour force in rural areas and lightens the government pressure on raising fund to development cultural industry,but also increases the economic benefit from rural cultural industry.There is certain development of the rural cultural industry in our country,but it is not good enough,and there are some problems: blind development regardless of the reality,small in and lack of competitivity,low economic benefit and lack of famous or good brand,Lack of human resources and corresponding market facilities and regulations.So we must take measures: developing the rural cultural industry according to the reality,managing in scale,trying to publicize famous brand,cultivating talents developing market and strengthening management.},
}

@misc{panorama_e298ea16b5bc_9e918031ee75b24f,
  title = {Hierarchical Fuzzy C-means Clustering Image Segmentation based on Neighborhood},
  author = {Rui Liu},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=WJSJ201002076},
  howpublished = {Microcomputer Information},
  annotation = {中文辅助译名：基于邻域的层次模糊C均值聚类图像分割},
  abstract = {Fuzzy C-Means (FCM) clustering is an unsupervised clustering technology and widely used in image segmentation. It has the heavy computing burden, and use pixel information only during the clustering process, the space relationship between neighborhood pixels is not used. In this paper, a method of hierarchical FCM based on neighborhood is proposed for image segmentation, it gained the multi-scale image framework through the image wavelet decomposition. In the framework, the neighborhood pixels of each pixel in the top -level low resolution image determines the clusters of each pixel through guides the clustering process, then adjust the details of the segmentation result via the image framework layers one by one. Segmentation experiments show that this method has better noise immunity and more evenly divided by contrast with the standard FCM.},
}

@misc{panorama_e298ea16b5bc_fc1d4b6cd373c10b,
  title = {Exploration on the reprieve prosecution system in wartime},
  author = {Rui Liu},
  year = {2010},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=OHJG201003012},
  howpublished = {Journal of Naval University of Engineering},
  annotation = {中文辅助译名：战时缓刑起诉制度探讨},
  abstract = {The reprieve prosecution system has been occasionally applied in judicial practice in China for nearly ten years,which proves its advantages overweight its disadvantages greatly,although it has not been received the formal recognition in Chinese legislation.Thus,to introduce this system into the field of military law will make a big breakthrough for military justice in wartime:On one hand,judicial cost will be saved;on the other hand,it carries a huge military value,which lays a new foundation for the administration of justice so as to give full spectrum dominance in the battle space.The primary issue of introducing the system of reprieve prosecution is to define it clearly.To provide beneficial reference for wartime military legislation,this paper elaborates on the concept,the value and the construction of reprieve prosecution in wartime.},
}

