@misc{panorama_e298ea16b5bc_032d23ed85918dc0,
  title = {MnTTS2: An Open-Source Multi-Speaker Mongolian Text-to-Speech Synthesis Dataset},
  author = {Kailin Liang and Bin Liu and Yifan Hu and Rui Liu and Feilong Bao and Guanglai Gao},
  year = {2023},
  doi = {10.48550/ARXIV.2301.00657},
  url = {https://doi.org/10.48550/ARXIV.2301.00657},
  howpublished = {CoRR},
  annotation = {中文辅助译名：MnTTS2：开源多说话人蒙古文文本转语音合成数据集},
  abstract = {Text-to-Speech (TTS) synthesis for low-resource languages is an attractive research issue in academia and industry nowadays. Mongolian is the official language of the Inner Mongolia Autonomous Region and a representative low-resource language spoken by over 10 million people worldwide. However, there is a relative lack of open-source datasets for Mongolian TTS. Therefore, we make public an open-source multi-speaker Mongolian TTS dataset, named MnTTS2, for the benefit of related researchers. In this work, we prepare the transcription from various topics and invite three professional Mongolian announcers to form a three-speaker TTS dataset, in which each announcer records 10 hours of speeches in Mongolian, resulting 30 hours in total. Furthermore, we build the baseline system based on the state-of-the-art FastSpeech2 model and HiFi-GAN vocoder. The experimental results suggest that the constructed MnTTS2 dataset is sufficient to build robust multi-speaker TTS models for real-world applications. The MnTTS2 dataset, training recipe, and pretrained models are released at: \urlhttps://github.com/ssmlkl/MnTTS2},
}

