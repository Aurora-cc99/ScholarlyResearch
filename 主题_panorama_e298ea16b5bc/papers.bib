  abstract = {With advances in deep-space exploration, hyperspectral imaging of the Martian surface has become feasible, making surface material classification a key tool for Mars observation. However, unlike terrestrial scenes, Martian mineral classes exhibit subtle spectral differences and highly similar spatial structures, resulting in strong spectral–spatial similarity among different materials and significantly limiting the effectiveness of existing methods. To address these issues, we propose a hybrid multihop differential Transformer with a pyramid gating (HMDTPG) mechanism for Mars hyperspectral image classification. The key novelty lies in the multihop differential Transformer, which explicitly models spectral differences via a multihop differential attention mechanism, enhancing sensitivity to subtle mineral variations while preserving global spectral dependencies. In parallel, a spatial pyramid gated enhancement module is designed to capture discriminative features across multiple scales, suppress redundant information, and retain fine-grained discriminative spatial features through gating. Furthermore, a spectral–spatial adaptive fusion module is designed to enable deep interaction between spectral and spatial features and perform adaptive fusion. Experimental results show that hybridmultihop differential Transformer and pyramid gate mechanism outperforms other state-of-the-art methods on three public Mars hyperspectral imagery (MHSI) datasets, achieving overall accuracies of 9},
}

@misc{jianhua_tao_014c0124ad2d,
  title = {AffectGPT-RL: Revealing Roles of Reinforcement Learning in Open-Vocabulary Emotion Recognition},
  author = {Zheng Lian and Fan Zhang and Lan Chen and Yazhou Zhang and Rui Liu and Jinyang Wu and Haoyu Chen and Xiaobai Li and Xiaojiang Peng and Bin He and Jianhua Tao},
  year = {2026},
  doi = {10.48550/ARXIV.2605.06126},
  url = {https://arxiv.org/abs/2605.06126v2},
  howpublished = {arXiv preprint},
  annotation = {中文辅助译名：AffectGPT-RL：揭示强化学习在开放词汇情绪识别中的作用},
  abstract = {Open-Vocabulary Multimodal Emotion Recognition (OV-MER) aims to predict emotions without being constrained by predefined label spaces, thereby enabling fine-grained emotion understanding. Unlike traditional discriminative methods, OV-MER leverages generative models to capture the full spectrum of emotions and employs emotion wheels (EWs) for metric calculation. Previous approaches primarily rely on token-level loss during training. However, this objective is misaligned with the metrics used in OV-MER, and these metrics cannot be directly optimized via gradient backpropagation. To address this limitation, we turn our attention to reinforcement learning, as this strategy can optimize non-differentiable objectives. We term this framework AffectGPT-RL. Furthermore, we conduct extensive experiments to elucidate the role of reinforcement learning in this task, revealing the necessity of the reasoning process, the impact of different rewards, and the generalizability to other emotion tasks such as sentiment analysis and basic emotion recognition. Experimental results demonstrate that AffectGPT-RL yields significant performance improvements on OV-MER. Beyond this task, we also achieve remarkable performance gains on basic emotion recognition, attaining state-of-the-art results on MER-UniBench. To the best of our knowledge, this is the pioneering work exploring the role of reinforcement learning in OV-MER, providing valuable guidance for subsequent researchers. Our code is provided at},
}

@misc{panorama_e298ea16b5bc_45bf0eadf46dc0a6,
