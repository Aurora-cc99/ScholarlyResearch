  abstract = {Hydrological monitoring is a fundamental pillar of environmental governance; however, accurate surface water extraction from satellite imagery remains challenging due to cloud interference, shadow-induced spectral confusion, and background complexity. To address these challenges, this study constructs a manually annotated multi-source Sentinel-1/2 water body dataset for a cloud-prone region in the upper Yangtze River basin and proposes the Reliability-aware Cross-modal Fusion Network (RCFNet). Specifically, RCFNet introduces a Cross-Modal Reliability Gate (CMRG) to estimate the relative reliability of optical and SAR information by jointly considering modalityspecific features, cross-modal context, and feature discrepancies. This allows the network to adaptively adjust the contribution of the two modalities before deeper feature extraction. A hybrid CNN-Swin Transformer encoder is then used to preserve local boundary details while capturing broader spatial context, followed by Efficient Multi-Scale Attention (EMA) for multiscale spatial refinement and a Squeeze-and-Excitation Block (SEBlock) for channel recalibration. These components operate at different stages of the network and together form a coordinated multimodal processing framework. Controlled pseudocloud experiments further show that SAR provides increasingly important complementary information as optical observations deteriorate, while the SAR-induced gain exhibits different stages of change. Similar transition patt},
}

@misc{panorama_e298ea16b5bc_990171d91aaf8a72,
  title = {Multi-modal and Multi-scale Spatial Environment Understanding for Immersive Visual Text-to-Speech},
  author = {Rui Liu and Shuwei He and Yifan Hu and Haizhou Li},
  year = {2025},
  doi = {10.1609/AAAI.V39I23.34643},
  url = {https://doi.org/10.1609/AAAI.V39I23.34643},
  howpublished = {AAAI},
  annotation = {中文辅助译名：沉浸式视觉文本转语音的多模态和多尺度空间环境理解},
  abstract = {Visual Text-to-Speech (VTTS) aims to take the environmental image as the prompt to synthesize the reverberant speech for the spoken content. The challenge of this task lies in understanding the spatial environment from the image. Many attempts have been made to extract global spatial visual information from the RGB space of an spatial image. However, local and depth image information are crucial for understanding the spatial environment, which previous works have ignored. To address the issues, we propose a novel multi-modal and multi-scale spatial environment understanding scheme to achieve immersive VTTS, termed M2SE-VTTS. The multi-modal aims to take both the RGB and Depth spaces of the spatial image to learn more comprehensive spatial information, and the multi-scale seeks to model the local and global spatial knowledge simultaneously. Specifically, we first split the RGB and Depth images into patches and adopt the Gemini-generated environment captions to guide the local spatial understanding. After that, the multi-modal and multi-scale features are integrated by the local-aware global spatial understanding. In this way, M2SE-VTTS effectively models the interactions between local and global spatial contexts in the multi-modal spatial environment. Objective and subjective evaluations suggest that our model outperforms the advanced baselines in environmental speech generation.},
}

@misc{panorama_e298ea16b5bc_981bc2e6af7b0e43,
  title = {Multi-Source Spatial Knowledge Understanding for Immersive Visual Text-to-Speech},
  author = {Shuwei He and Rui Liu and Haizhou Li},
  year = {2025},
  doi = {10.1109/ICASSP49660.2025.10888876},
  url = {https://doi.org/10.1109/ICASSP49660.2025.10888876},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：沉浸式视觉文本转语音的多源空间知识理解},
  abstract = {Visual Text-to-Speech (VTTS) aims to take the environmental image as the prompt to synthesize reverberant speech for the spoken content. Previous works focus on the RGB modality for global environmental modeling, overlooking the potential of multi-source spatial knowledge like depth, speaker position, and environmental semantics. To address these issues, we propose a novel multi-source spatial knowledge understanding scheme for immersive VTTS, termed MS2KU-VTTS. Specifically, we first prioritize RGB image as the dominant source and consider depth image, speaker position knowledge from object detection, and Gemini-generated semantic captions as supplementary sources. Afterwards, we propose a serial interaction mechanism to effectively integrate both dominant and supplementary sources. The resulting multi-source knowledge is dynamically integrated based on the respective contributions of each source. This enriched interaction and integration of multi-source spatial knowledge guides the speech generation model, enhancing the immersive speech experience. Experimental results demonstrate that the MS2KU-VTTS surpasses existing baselines in generating immersive speech. Demos and code are available at: https://github.com/AI-S2-Lab/MS2KU-VTTS.},
}

