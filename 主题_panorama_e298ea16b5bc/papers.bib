@misc{panorama_e298ea16b5bc_efa23511fcc21fe8,
  title = {Study on the Chemical Composition And Antitumor Activity of Neutral Glycoprotein From the Muscle of Hemifusus tuba (Gmelin)},
  author = {Rui Liu},
  year = {2002},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=HYYW200206005},
  howpublished = {Zhongguo haiyang yaowu},
  annotation = {中文辅助译名：管半毛肌（Gmelin）肌肉中性糖蛋白的化学成分及抗肿瘤活性研究},
  abstract = {Aim To study the chemical composition and antitumor activity of glycoprotein from marine mollusk Hemifusus tuba (Gmelin). Methods The muscle of H. tuba was extracted by boiling salt solution. The aqueous extract was chromatographed on DEAE-cellu-lose and Sephadex G-100 columns, eluting with water and sodium chloride solution to yield neutral glycoprotein(NGH) and three acidic glycoproteins( AGH), respectively. The purity and Mw of NGH were determined by HPLC,the contents of sugar and protein were measured by improved phenol-sulfuric acid and folin-phenol methods. Sugar component was analysed by GC,IR and NMR were used to determine the configuration of glycosidic bond of NGH. Results NGH was homogeneous and Mw was 7. 66×105. Its sugar chain was consisted of galactose with a little of mannose and glucose. Sugar content was 89. 6% and protein was 7.2%. The monosaccharide configuration was orpyranoside. NGH showed tumor-inhibition activity in vivo on S180- bearing mice.},
}

