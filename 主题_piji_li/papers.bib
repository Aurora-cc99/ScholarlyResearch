@misc{piji_li_c06fe7f54b450756,
  title = {When Response Variation Does Not Indicate Uncertainty: Hallucination Detection for Multi-Answer Queries},
  author = {Hongliang Dai and Qiuyuan Li and Piji Li},
  year = {2026},
  doi = {10.18653/2026.emnlp-main.864},
  url = {https://doi.org/10.18653/2026.emnlp-main.864},
  howpublished = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  annotation = {中文辅助译名：当响应变化并不表示不确定性时：多答案查询的幻觉检测},
  abstract = {Hallucination detection in LLMs often relies on output consistency or model-internal signals.While output-based methods have the advantage of applicability to closed-source models, existing studies often overlook a key limitation: they struggle on tasks that admit multiple valid answers, where variation across generations may reflect legitimate alternative responses rather than hallucinations.In this paper, we propose a question-type-aware hallucination detection framework that distinguishes singleanswer and multi-answer regimes.Given a predicted question-type signal, we derive typeconditioned diagnostic features from low-and high-temperature generations, and build two alternative hallucination detectors based on these features: a calibrated type-aware uncertainty estimator and a feature-verbalized few-shot LLM judge.Experiments on NQ-Open, WebQA, and AmbigQA across both open-source and closedsource LLMs demonstrate that our method consistently outperforms conventional semantic clustering approaches and representative baselines in hallucination detection.},
}

