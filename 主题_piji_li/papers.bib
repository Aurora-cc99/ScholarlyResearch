@misc{piji_li_65a732128af36471,
  title = {Concise and Sufficient Sub-Sentence Citations for Retrieval-Augmented Generation},
  author = {Guo Chen and Hongliang Dai and Qiuxian Li and Qiuyuan Li and Piji Li and Xiang Chen},
  year = {2025},
  doi = {10.48550/ARXIV.2509.20859},
  url = {https://doi.org/10.48550/ARXIV.2509.20859},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于检索增强生成的简洁且充分的子句引用},
  abstract = {In retrieval-augmented generation (RAG) question answering systems, generating citations for large language model (LLM) outputs enhances verifiability and helps users identify potential hallucinations.Existing citation generation methods for retrieval-augmented generation usually provide evidence at the paragraph or sentence level.Although such citations improve verifiability, they may still impose unnecessary reading burden on users: a cited sentence may include information irrelevant to the answer while lacking sufficient context, such as a clear referent for the subject.In this paper, we study concise and sufficient sub-sentence citation generation, aiming to identify minimal yet self-contained evidence spans for answer verification.To this end, we first develop annotation guidelines for such citations and construct a corresponding dataset.To reduce annotation cost, we propose a data augmentation framework that generates synthetic citation annotations and filters low-quality instances using an evaluator model.Our experiments on the constructed dataset demonstrate that the proposed approach can generate high-quality and more readable citations.},
}

