@misc{piji_li_fea494eec1758f63,
  title = {See Beyond Words: Joint Visual–Language Representations Improve Brain Encoding of Language-Only Stimuli},
  author = {Yongpeng Zhang and Congchi Yin and Runze Xia and Xuyun Wen and Piji Li},
  year = {2026},
  doi = {10.18653/2026.emnlp-main.935},
  url = {https://doi.org/10.18653/2026.emnlp-main.935},
  howpublished = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  annotation = {中文辅助译名：超越语言：联合视觉-语言表征改善仅语言刺激的大脑编码},
  abstract = {Human language processing in the brain involves the coordinated engagement of multiple perceptual pathways.In parallel, recent multimodal large language models (MLLMs) integrate visual and linguistic information into language generation.However, it remains unclear whether and how the injection of visual information alters language representations, and how such changes in turn affect neural predictions during language processing.To address this question, we analyze joint vision-language representations extracted from MLLMs using brain encoding models.We visually augment textual stimuli via image generation and use the resulting representations to predict fMRI responses recorded while participants process language-only stimuli.We find that joint vision-language representations substantially improve neural prediction performance, with pronounced gains in higher-level visual regions.Further analyses indicate that these improvements reflect both the engagement of visual pathways and the enrichment of linguistic representations through visually grounded information.Together, our results provide evidence for multimodal pathway involvement in human language processing and offer insights into the interpretability of multimodal models.},
}

@misc{piji_li_e89bf0795360d5c9,
  title = {From Reasoning LLMs to BERT: A Two-Stage Distillation Framework for Search Relevance},
  author = {Yupeng Ji and Yuxi Zhou and Haodong Liu and Teng Zhang and Runze Xia and Piji Li},
  year = {2026},
  doi = {10.1145/3774904.3792801},
  url = {https://doi.org/10.1145/3774904.3792801},
  howpublished = {WWW},
  annotation = {中文辅助译名：从推理大语言模型到 BERT：搜索相关性的两阶段蒸馏框架},
  abstract = {Query-service relevance prediction in e-commerce search systems faces strict latency requirements that prevent the direct application of Large Language Models (LLMs). To bridge this gap, we propose a two-stage reasoning distillation framework to transfer reasoning capabilities from a powerful teacher LLM to a lightweight, deployment-friendly student model. In the first stage, we address the limitations of general-purpose LLMs by constructing a domain-adapted teacher model. This is achieved through a three-step process: domain-adaptive pre-training to inject platform knowledge, supervised fine-tuning to elicit reasoning skills, and preference optimization with a multi-dimensional reward model to ensure the generation of reliable and preference-aligned reasoning paths. This teacher can then automatically annotate massive query-service pairs from search logs with both relevance labels and reasoning chains. In the second stage, to address the challenges of architectural heterogeneity in standard distillation, we introduce Contrastive Reasoning Self-Distillation (CRSD). By modeling the behavior of the same student model under ``standard'' and ``reasoning-augmented'' inputs as a teacher-student relationship, CRSD enables the lightweight model to internalize the teacher's complex decision-making mechanisms without needing the explicit reasoning path at inference. Offline evaluations and online A/B testing in the Meituan search advertising system demonstrate that our framework achiev},
}

