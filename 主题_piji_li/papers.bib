@misc{piji_li_8d687aa3986886e2,
  title = {Language Reconstruction with Brain Predictive Coding from fMRI Data},
  author = {Ziyi Ye and Congchi Yin and Piji Li},
  year = {2026},
  doi = {10.18653/V1/2026.ACL-LONG.949},
  url = {https://doi.org/10.18653/V1/2026.ACL-LONG.949},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：利用功能磁共振成像数据的大脑预测编码进行语言重建},
  abstract = {Many recent studies have shown that the perception of speech can be decoded from brain signals and subsequently reconstructed as continuous language.However, there is a lack of neurological basis for how the semantic information embedded within brain signals can be used more effectively to guide language reconstruction.Predictive coding theory suggests the human brain naturally engages in continuously predicting future words that span multiple timescales.This implies that the decoding of brain signals could potentially be associated with a predictable future.To explore the predictive coding theory within the context of language reconstruction, this paper proposes PREDFT (FMRI-to-Text decoding with Predictive coding).PREDFT consists of a main network and a side network.The side network obtains brain predictive representation from related regions of interest (ROIs) with a self-attention module.The representation is then fused into the main network for continuous language decoding.Experiments on two naturalistic language comprehension fMRI datasets show that PREDFT outperforms current decoding models on several evaluation metrics.},
}

@misc{piji_li_ede0936177e640de,
  title = {Entity Blackboard: Structured Agent Memory for Long Document Summarization},
  author = {Ruyi Liu and Guanyun Zou and Hongliang Dai and Piji Li},
  year = {2026},
  doi = {10.18653/2026.findings-emnlp.384},
  url = {https://doi.org/10.18653/2026.findings-emnlp.384},
  howpublished = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  annotation = {中文辅助译名：实体黑板：用于长文档摘要的结构化代理内存},
  abstract = {Hierarchical merging is commonly used to summarize long documents by splitting the input into chunks, summarizing each chunk independently, and merging the results into a final summary.However, because each chunk is processed independently, entity state changes across chunks are not tracked, leading to coherence and consistency issues in the final summary.We propose ENTITYBB (ENTITY BLACKBOARD), an agent memory framework that equips chunk-based LLM summarizers with structured entity memory.During sequential chunk processing, the model records and updates entity states through tool calls, while automatic safeguards and modeldriven rejection limit noisy writes.Experiments on three long document summarization benchmarks show that ENTITYBB consistently improves over a controlled hierarchical merging baseline across ROUGE and BERTScore, while NarrativeFactScore indicates improved source-grounded factuality.Targeted human and LLM-as-a-Judge evaluations further indicate fewer entity-level issues and higher judged summary quality.Code: github.com/heimaliu/EntityBB.},
}

