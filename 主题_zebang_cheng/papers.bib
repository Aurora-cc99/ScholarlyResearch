  author = {Minghui Li and Hongbo Xu and Hanling Wang and Yihua Shao and Nicu Sebe and Qi Tian and Dong Wang and Zhou Liu and Yuqing Gao and Zebang Cheng and Long Ma and Fei Ma and Yuyong Tan and Laizhong Cui},
