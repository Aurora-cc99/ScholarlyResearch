@misc{zebang_cheng_f6ea1890689d8bd7,
  title = {CARES: A Clinically Anchored Residual Evidence System for Multimodal Depression Assessment in Older Adults},
  author = {Yunfei Luo and Zebang Cheng and Fei Ma and Yaru Cao and Laizhong Cui and Qi Chuan Tian and Jianwu Dang},
  year = {2026},
  doi = {10.1145/3767308.3836619},
  url = {https://doi.org/10.1145/3767308.3836619},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：CARES：用于老年人多模式抑郁评估的临床锚定残留证据系统},
  abstract = {Automating depression screening and severity assessment in older adults is difficult because behavioral cues overlap with aging, chronic illness, medication effects, and motor decline. Although speech, facial expression, personality, and gait provide useful evidence, they are less clinically specific than interview semantics and should refine rather than determine decisions. We formulate this asymmetry as decision authority : primary evidence establishes severity, whereas auxiliary evidence only revises it. We propose CARES, a Clinically Anchored Residual Evidence System for older-adult multimodal depression assessment. CARES builds an anchor from structured interview transcripts and symptom abstractions; audio, visual, personality, and gait signals can adjust it only through uncertainty-gated, globally scaled corrections. A monotonic ternary checkpoint jointly predicts class labels and PHQ score, with binary decisions obtained by collapsing non-zero severity classes. On the MPDD-Elderly A-V+P and A-V-G+P sub-tracks, CARES achieves mean composite Scores of 82.00\pm4.67 and 82.04\pm4.64 over three random seeds, outperforming the official baseline and adapted multimodal fusion models. Reliable multimodal assessment therefore requires controlling the authority of behaviorally confounded auxiliary evidence.},
}

@misc{zheng_lian_6028e208c2ac,
