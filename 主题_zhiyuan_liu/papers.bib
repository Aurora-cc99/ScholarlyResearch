@misc{zhiyuan_liu_503d62ed973e0ecd,
  title = {Removal of dissolved inorganic carbon in the Yellow River Estuary},
  author = {Zhiyuan Liu and Longjun Zhang and Wei‐Jun Cai and Liang Wang and Ming Xue and Zhang Xiangshang},
  year = {2014},
  doi = {10.4319/lo.2014.59.2.0413},
  url = {https://doi.org/10.4319/lo.2014.59.2.0413},
  howpublished = {Limnology and Oceanography},
  annotation = {中文辅助译名：黄河口溶解性无机碳的去除},
  abstract = {The Yellow River of China runs mainly through an arid and semiarid midlatitude region that has experienced substantial anthropogenic and climatic change. This area includes the carbonate‐rich Loess Plateau and carries water of exceptionally high carbonate content. To investigate the processes by which dissolved inorganic carbon (DIC) is biogeochemically modified as the river approaches the sea, a multipronged field investigation was conducted in the Yellow River estuary, 2005–2009. The project included four research cruises (spring and fall), a year of monthly sampling at a lower‐river hydrological station (Lijin), and in situ bottle incubations. Our study revealed that 4–11% of the Yellow River DIC was removed from the water column in the estuarine mixing zone and thus was not transported to the sea. DIC removal was greater in the spring and occurred at a higher salinity range than in the fall. As a unique feature of the Yellow River estuary, calcium carbonate (CaCO3) precipitation was nearly as important as net biological production in the DIC removal. Longer freshwater—seawater mixing distances (and times) and higher DIC concentrations in the freshwater end member also promoted net biological production and CaCO3 precipitation, thus encouraging DIC removal.},
}

@misc{zhiyuan_liu_721eae3a1a09aed1,
  title = {Linking GloVe with word2vec},
  author = {Tianze Shi and Zhiyuan Liu},
  year = {2014},
  doi = {10.48550/ARXIV.1411.5595},
  url = {https://doi.org/10.48550/ARXIV.1411.5595},
  howpublished = {CoRR},
  annotation = {中文辅助译名：将 GloVe 与 word2vec 链接},
  abstract = {The Global Vectors for word representation (GloVe), introduced by Jeffrey Pennington et al. is reported to be an efficient and effective method for learning vector representations of words. State-of-the-art performance is also provided by skip-gram with negative-sampling (SGNS) implemented in the word2vec tool. In this note, we explain the similarities between the training objectives of the two models, and show that the objective of SGNS is similar to the objective of a specialized form of GloVe, though their cost functions are defined differently.},
}

@misc{zhiyuan_liu_cef5772bc08014cc,
  title = {Distant Supervision for Relation Extraction with Matrix Completion},
  author = {Miao Fan and Qiang Zhou and Edward Y. Chang and Deli Zhao and Zhiyuan Liu and Thomas Fang Zheng},
  year = {2014},
  doi = {10.3115/V1/P14-1079},
  url = {https://doi.org/10.3115/V1/P14-1079},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：矩阵补全关系抽取的远程监督},
  abstract = {The essence of distantly supervised relation extraction is that it is an incomplete multi-label classification problem with sparse and noisy features.To tackle the sparsity and noise challenges, we propose solving the classification problem using matrix completion on factorized matrix of minimized rank.We formulate relation classification as completing the unknown labels of testing items (entity pairs) in a sparse matrix that concatenates training and testing textual features with training labels.Our algorithmic framework is based on the assumption that the rank of item-byfeature and item-by-label joint matrix is low.We apply two optimization models to recover the underlying low-rank matrix leveraging the sparsity of feature-label matrix.The matrix completion problem is then solved by the fixed point continuation (FPC) algorithm, which can find the global optimum.Experiments on two widely used datasets with different dimensions of textual features demonstrate that our low-rank matrix completion approach significantly outperforms the baseline and the state-of-the-art methods.},
}

@misc{zhiyuan_liu_b74b896cfe5948a9,
  title = {Errata: Distant Supervision for Relation Extraction with Matrix Completion},
  author = {Miao Fan and Qiang Zhou and Deli Zhao and Edward Y. Chang and Zhiyuan Liu and Thomas Fang Zheng},
  year = {2014},
  doi = {10.48550/ARXIV.1411.4455},
  url = {https://doi.org/10.48550/ARXIV.1411.4455},
  howpublished = {CoRR},
  annotation = {中文辅助译名：勘误表：通过矩阵补全进行关系提取的远程监督},
  abstract = {The essence of distantly supervised relation extraction is that it is an incomplete multi-label classification problem with sparse and noisy features. To tackle the sparsity and noise challenges, we propose solving the classification problem using matrix completion on factorized matrix of minimized rank. We formulate relation classification as completing the unknown labels of testing items (entity pairs) in a sparse matrix that concatenates training and testing textual features with training labels. Our algorithmic framework is based on the assumption that the rank of item-by-feature and item-by-label joint matrix is low. We apply two optimization models to recover the underlying low-rank matrix leveraging the sparsity of feature-label matrix. The matrix completion problem is then solved by the fixed point continuation (FPC) algorithm, which can find the global optimum. Experiments on two widely used datasets with different dimensions of textual features demonstrate that our low-rank matrix completion approach significantly outperforms the baseline and the state-of-the-art methods.},
}

@misc{zhiyuan_liu_14663d43f56bfbd2,
  title = {Quantifying Chinese Happiness via Large-Scale Microblogging Data},
  author = {Chong Kuang and Feng Yu and Maosong Sun and Pengfei Ma and Zhiyuan Liu},
  year = {2014},
  doi = {10.1109/WISA.2014.48},
  url = {https://doi.org/10.1109/WISA.2014.48},
  howpublished = {IEEE WISA},
  annotation = {中文辅助译名：通过大规模微博数据量化中国人的幸福感},
  abstract = {Happiness is an important indicator to measure our life satisfaction. Microblogging data can reflect users' living standards and psychological state. We build a large lexicon based on the PERMA lexicon and large-scale microblogging data on Sina Weibo by combining the PMI and distrabutional similarty method. Using this lexicon, we propose a method to calculate the happiness quantitatively based on PERMA theory. Experiments shows that our method achieve significant improvement compared with the baseline in terms of AP and Bpref respectively. After the verification of our method on manual annotation dataset, we perform an in-depth analysis on large-scale microblogging data using our method.},
}

@misc{zhiyuan_liu_bcce6f2d432ddd6a,
  title = {Discriminating gender on Chinese microblog: A study of online behaviour, writing style and preferred vocabulary},
  author = {Zhiyuan Liu and Li Li and Maosong Sun},
  year = {2014},
  doi = {10.1109/ICNC.2014.6975942},
  url = {https://doi.org/10.1109/ICNC.2014.6975942},
  howpublished = {ICNC},
  annotation = {中文辅助译名：中国微博上的性别歧视：网络行为、写作风格和偏好词汇的研究},
  abstract = {As user attributes are useful for applications such as personalized recommendation, adverting and so on, user attribute predication on Twitter has attracted intensive attentions in recent years. Although Chinese micro-blogging services are different from Twitter on various aspects such as language, user behaviours and so on, few efforts have been made on Chinese micro-blogging services. In this paper, we propose a gender prediction model for Chinese microblog which exploits features including online behaviour, writing style, and preferred vocabulary. Experimental results on Sina Weibo, which is one of the most popular micro-blogging services in China, show that our model achieves the state-of-the-art accuracy 94.3%. We also find significant distinctions between male and female microblog users on online behaviour, writing style and preferred vocabulary, which would be helpful for improving personalized applications.},
}

