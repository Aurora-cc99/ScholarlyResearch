@misc{zhiyuan_liu_a18b7e16a5ab20fa,
  title = {Relation-aware deep neural network enables more efficient biomedical knowledge acquisition from massive literature},
  author = {Chenyang Song and Suncong Zheng and Changyao Tian and Zheni Zeng and Kuai Li and Yuan Yao and Zhiyuan Liu and Maosong Sun},
  year = {2024},
  doi = {10.1016/J.AIOPEN.2024.08.002},
  url = {https://doi.org/10.1016/J.AIOPEN.2024.08.002},
  howpublished = {AI Open},
  annotation = {中文辅助译名：关系感知深度神经网络能够更有效地从海量文献中获取生物医学知识},
  abstract = {Biomedical knowledge is typically organized in a relational scheme, such as chemical-disease relation, gene-disease relation, and gene-pathway relation. Biomedical scientists heavily rely on search engines to acquire up-to-date relational knowledge from massive biomedical articles. The navigation efficiency of the retrieval process , however, is significantly restricted by keyword matching techniques unaware of the biomedical relations of these keywords in articles. To bridge the gap between existing retrieval techniques and practical access demands for relational knowledge, we present a novel framework, Bio medical R elation- A ware D ocument R anking (BioRADR), capable of retrieving articles expressing specific relations with respect to the queried entity pair. Based on a deep neural network , BioRADR can be trained from large-scale data automatically annotated via distant supervision, and empirical evaluation reveals that it outperforms the strongest baseline by over 8 points in NDCG@1. We implement an online system ( http://bioradr.ai.thunlp.org/ ) based on BioRADR, enabling more efficient relation-oriented retrieval of biomedical articles.},
}

@misc{zhiyuan_liu_f17fa753d2f13962,
  title = {Cognitive and neural mechanisms of voluntary versus forced language switching in Chinese–English bilinguals: an fMRI study},
  author = {Libo Geng and Xinyu Zhao and Qihui Xu and Haiyan Wu and Xueping Hu and Zhiyuan Liu and Lili Ming and Zixuan Xue and Chenyi Yue and Yiming Yang},
  year = {2024},
  doi = {10.1093/cercor/bhae042},
  url = {https://doi.org/10.1093/cercor/bhae042},
  howpublished = {Cerebral Cortex},
  annotation = {中文辅助译名：汉英双语者自愿与强迫语言转换的认知和神经机制：功能磁共振成像研究},
  abstract = {The ecological validity of bilingual code-switching has garnered increasing attention in recent years. Contrary to traditional studies that have focused on forced language switching, emerging theories posit that voluntary switching may not incur such a cost. To test these claims and understand differences between forced and voluntary switching, the present study conducted a systematic comparison through both behavioral and neural perspectives. Utilizing fMRI alongside picture-naming tasks, our findings diverge from prior work. Voluntary language switching not only demonstrated switching costs at the behavioral level but also significantly activated brain regions associated with inhibitory control. Direct comparisons of voluntary and forced language switching revealed no significant behavioral differences in switching costs, and both shared several common brain regions that were activated. On the other hand, a nuanced difference between the two types of language switching was revealed by whole-brain analysis: voluntary switching engaged fewer language control regions than forced switching. These findings offer a comprehensive view of the neural and behavioral dynamics involved in bilingual language switching, challenging prior claims that voluntary switching imposes no behavioral or neural costs, and thus providing behavioral and neuroimaging evidence for the involvement of inhibitory control in voluntary language switching.},
}

@misc{zhiyuan_liu_a53d7594d2065285,
  title = {Large Language Model-based Human-Agent Collaboration for Complex Task Solving},
  author = {Zhiyuan Chen and Yujia Qin and Yankai Lin and Xueyang Feng and Xu Chen and Zhiyuan Liu and Ji-Rong Wen},
  year = {2024},
  doi = {10.18653/V1/2024.FINDINGS-EMNLP.72},
  url = {https://doi.org/10.18653/V1/2024.FINDINGS-EMNLP.72},
  howpublished = {EMNLP (Findings)},
  annotation = {中文辅助译名：基于大型语言模型的人机协作解决复杂任务},
  abstract = {In recent developments within the research community, the integration of Large Language Models (LLMs) in creating fully autonomous agents has garnered significant interest.Despite this, LLM-based agents frequently demonstrate notable shortcomings in adjusting to dynamic environments and fully grasping human needs.In this work, we introduce the problem of LLM-based human-agent collaboration for complex task-solving, exploring their synergistic potential.To tackle the problem, we propose a Reinforcement Learning-based Human-Agent Collaboration method, ReHAC, which trains a policy model designed to determine the most opportune stages for human intervention within the task-solving process.We conduct experiments under real and simulated human-agent collaboration scenarios.Experimental results demonstrate that the synergistic efforts of humans and LLM-based agents significantly improve performance in complex tasks, primarily through well-planned, limited human intervention.Datasets and code are available at: https://github.com/ XueyangFeng/ReHAC/.},
}

