@misc{zhiyuan_liu_3ef9c68e8aaac1fa,
  title = {Multimodal Language Modeling for High-Accuracy Single Cell Transcriptomics Analysis and Generation},
  author = {Sihang Li and Jiaqi Yang and Yang Zhang and Yaorui Shi and Junfeng Fang and Cheng-Xiang Wang and Zhiyuan Liu},
  year = {2025},
  doi = {10.48550/ARXIV.2503.09427},
  url = {https://doi.org/10.48550/ARXIV.2503.09427},
  howpublished = {CoRR},
  annotation = {中文辅助译名：用于高精度单细胞转录组分析和生成的多模态语言建模},
  abstract = {Single-cell RNA sequencing (scRNA-seq) offers detailed insights into cellular heterogeneity. Recent advancements leverage single-cell large language models (scLLMs) for effective representation learning. These models focus exclusively on transcriptomic data, neglecting complementary biological knowledge from textual descriptions. To overcome this limitation, we propose scMMGPT, a novel multimodal framework designed for language-enhanced representation learning in single-cell transcriptomics. Unlike existing methods, scMMGPT employs robust cell representation extraction, preserving quantitative gene expression data, and introduces an innovative two-stage pre-training strategy combining discriminative precision with generative flexibility. Extensive experiments demonstrate that scMMGPT significantly outperforms unimodal and multimodal baselines across key downstream tasks, including cell annotation and clustering, and exhibits superior generalization in out-of-distribution scenarios.},
}

@misc{zhiyuan_liu_2438b8980dbcfe02,
  title = {Automated device for small-tissue extraction and primary organoid modeling},
  author = {Wanlong Wang and Yongde Cai and Davit Khutsishvili and Xiaoyong Dai and Yifu Wei and Zhiyuan Liu and Yu Zhu and Zitian Wang and Shaohua Ma},
  year = {2025},
  doi = {10.1631/bdm.2500186},
  url = {https://doi.org/10.1631/bdm.2500186},
  howpublished = {Bio-Design and Manufacturing},
  annotation = {中文辅助译名：用于小组织提取和初级类器官建模的自动化设备},
  abstract = {从原代样本中提取的细胞对于构建患者同源类器官模型至关重要。然而, 目前的自动化细胞提取设备存在诸多不足: 一方面, 它们主要用于处理手术切除的组织; 另一方面, 它们操作流程繁琐耗时, 单次处理需要约半小时, 极大地限制了从少量活检样本中提取细胞的效率。为了解决这些问题, 我们开发了一种小型组织细胞提取装置(small-tissue extraction device, sTED), 该装置采用研磨方式提取细胞。其核心部件为微型三棱锥和三棱柱形成的一套微型刀片阵列, 它可以在提取细胞的同时保障细胞完整性; 在运行 1 分钟的时间内, 其内部刀片阵列可完成 150 万次微剪切操作。此外, 我们设计了研磨消化一体的研磨室, 使其能够高效地处理多种尺寸的组织样本(从小型穿刺活检样本到大型手术切除样本)。在小鼠肝脏和肺组织细胞提取的实验中, sTED 提取的细胞活率均超过了 90%。sTED 是首批能在不降低细胞得率和活率的前提下, 可靠地处理超小组织样本的设备之一, 其效果超过了熟练的人工操作。这一创新成果解决了穿刺取样细胞量不足与自动化设备高细胞需求量之间的矛盾, 为类器官技术的临床转化提供支持。},
}

@misc{zhiyuan_liu_fcb4244432df7822,
  title = {Efficient GPT-4V level multimodal large language model for deployment on edge devices},
  author = {Yuan Yao and Tianyu Yu and Ao Zhang and Chongyi Wang and Junbo Cui and Hongji Zhu and Tianchi Cai and Chi Chen and Haoyu Li and Weilin Zhao and Zhihui He and Qianyu Chen and Ronghua Zhou and Zhensheng Zou and Haoye Zhang and Shengding Hu and Zhi Zheng and Jie Zhou and Jie Cai and Han Xu and Guoyang Zeng and Dahai Li and Zhiyuan Liu and Maosong Sun},
  year = {2025},
  doi = {10.1038/s41467-025-61040-5},
  url = {https://doi.org/10.1038/s41467-025-61040-5},
  howpublished = {Nature Communications},
  annotation = {中文辅助译名：用于在边缘设备上部署的高效 GPT-4V 级多模态大语言模型},
  abstract = {Multimodal large language models have revolutionized AI research and industry, paving the way toward the next milestone. However, their large sizes and high computational costs restrict deployment to cloud servers, limiting use in mobile, offline, energy-sensitive, or privacy-critical scenarios. We present MiniCPM-V, efficient models for edge devices that integrate advancements in architecture, training, and data. The 8B model outperforms GPT-4V, Gemini Pro, and Claude 3 across 11 public benchmarks, processes high-resolution images at any aspect ratio, achieves robust optical character recognition, exhibits low hallucination rates, and supports over 30 languages while running efficiently on mobile phones. This progress reflects a broader trend: The sizes for high-performing models are rapidly decreasing alongside growing edge computation capacity, enabling advanced multimodal models to operate locally on consumer hardware. Such developments unlock applications across diverse real-world scenarios, from enhanced mobile AI to privacy-preserving solutions, marking a critical step toward democratizing powerful multimodal intelligence.},
}

