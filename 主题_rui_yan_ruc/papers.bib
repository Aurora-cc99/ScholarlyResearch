@misc{rui_yan_ruc_bab07e3f67f14bc0,
  title = {"Chitty-Chitty-Chat Bot": Deep Learning for Conversational AI},
  author = {Rui Yan},
  year = {2018},
  doi = {10.24963/ijcai.2018/778},
  url = {https://doi.org/10.24963/ijcai.2018/778},
  howpublished = {International Joint Conference on Artificial Intelligence},
  annotation = {中文辅助译名：“Chitty-Chitty-Chat Bot”：对话式人工智能的深度学习},
  abstract = {Conversational AI is of growing importance since it enables easy interaction interface between humans and computers. Due to its promising potential and alluring commercial values to serve as virtual assistants and/or social chatbots, major AI, NLP, and Search & Mining conferences are explicitly calling-out for contributions from conversational studies. It is an active research area and of considerable interest. To build a conversational system with moderate intelligence is challenging, and requires abundant dialogue data and interdisciplinary techniques. Along with the Web 2.0, the massive data available greatly facilitate data-driven methods such as deep learning for human-computer conversations. In general, conversational systems can be categorized into 1) task-oriented systems which aim to help users accomplish goals in vertical domains, and 2) social chat bots which can converse seamlessly and appropriately with humans, playing the role of a chat companion. In this paper, we focus on the survey of non-task-oriented chit-chat bots.},
}

@misc{rui_yan_ruc_e989ca9bbbd0db57,
  title = {When Less Is More: Using Less Context Information to Generate Better Utterances in Group Conversations},
  author = {Yan Song and Rui Yan and Haisong Zhang and Zhangming Chan and Dongyan Zhao},
  year = {2018},
  doi = {10.1007/978-3-319-99495-6_7},
