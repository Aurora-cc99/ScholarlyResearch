  title = {MultiFinBen: Benchmarking Large Language Models for Multilingual and Multimodal Financial Application},
  author = {Arman Cohan and Jimin Huang and Xiao-Yang Liu and Xi Chen and Kaleb E. Smith and Nuo Chen and Yijia Zhao and Mingquan Lin and Lingfei Qian and Efstathia Soufleri and Guojun Xiong and Yupeng Cao and Heming Fu and Qianqian Xie and Shanshan Yang and Jerry Huang and Triantafillos Papadopoulos and Xueqing Peng and Suyuchen Wang and Haohang Li and Penglei Gao and Zhiyang Deng and Vincent Jim Zhang and Sophia Ananiadou and Yi Han and Yilun Zhao and Alejandro Lopez-Lira and Jeff Zhao and Polydoros Giannouris and Yueru He and Yuechen Jiang and Ruoyu Xiang and Shengyuan Lin and Huan He and Yuqing Guo and Keyi Wang and Jun'ichi Tsujii and Jian-Yun Nie and Meikang Qiu and Zhiwei Liu and Yan Wang and Yang Ren and Xiaoyu Wang and Yun Feng and Peng Lu and Yangyang Yu and Mingyang Jiang},
  year = {2026},
