  url = {https://doi.org/10.1109/estc.2012.6485815},
  howpublished = {Electronic System-Integration Technology Conference (ESTC)},
  annotation = {中文辅助译名：一种环境自适应标签推荐模型},
}

@misc{panorama_pengzhou_zhang_7be4e1170498b0c2,
  title = {A Solution to Manage Copyright Information of TV Program Based on Three-Dimensional Model},
  author = {Haoran Yu and Chi Zhang and Pengzhou Zhang},
  year = {2011},
