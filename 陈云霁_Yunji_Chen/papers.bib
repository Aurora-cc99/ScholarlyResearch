  title = {BenchIP: Benchmarking Intelligence Processors},
  author = {Jinhua Tao and Zidong Du and Qi Guo and Huiying Lan and Lei Zhang and Shengyuan Zhou and Lingjie Xu and Cong Liu and Hai-Feng Liu and Shan Tang and Allen Rush and Willian Chen and Shaoli Liu and Yunji Chen and Tianshi Chen},
