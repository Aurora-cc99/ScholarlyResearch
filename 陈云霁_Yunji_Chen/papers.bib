@misc{chen_yunji_131f9e20087c,
  title = {Godson-3B: A 1GHz 40W 8-core 128GFLOPS processor in 65nm CMOS},
  author = {Weiwu Hu and Ru Wang and Yunji Chen and Bao-Xia Fan and Shi-Qiang Zhong and Xiang Gao and Zichu Qi and Xu Yang},
  year = {2011},
