@misc{dongrui_wu_e957b96f243c5433,
  title = {Aggregation Using the Linguistic Weighted Average and Interval Type-2 Fuzzy Sets},
  author = {Dongrui Wu and Jerry M. Mendel},
  year = {2007},
  doi = {10.1109/TFUZZ.2007.896325},
  url = {https://doi.org/10.1109/TFUZZ.2007.896325},
  howpublished = {IEEE Trans. Fuzzy Syst.},
  annotation = {中文辅助译名：使用语言加权平均和区间类型 2 模糊集的聚合},
  abstract = {The focus of this paper is the linguistic weighted average (LWA), where the weights are always words modeled as interval type-2 fuzzy sets (IT2 FSs), and the attributes may also (but do not have to) be words modeled as IT2 FSs; consequently, the output of the LWA is an IT2 FS. The LWA can be viewed as a generalization of the fuzzy weighted average (FWA) where the type-1 fuzzy inputs are replaced by IT2 FSs. This paper presents the theory, algorithms, and an application of the LWA. It is shown that finding the LWA can be decomposed into finding two FWAs. Since the LWA can model more uncertainties, it should have wide applications in distributed and hierarchical decision-making.},
}

