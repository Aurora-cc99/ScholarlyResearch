  author = {Mortimer Gierthmuehlen and Xi Wang and Celina Kuehn and C. Alexis Gkogkidis and Christian Henle and Markus Raab and Joerg Fischer and Fabian Kohler and Joerg Haberstroh and Thomas Stieglitz and Martin Schüettler and Joern Rickert and Tonio Ball and Thomas M. Freiman},
