@misc{tonio_ball_2ace971a49fbeff1,
  title = {Classicatio no fElectro-encephalographic Spatia lPatterns},
  author = {Thomas Müller and Tonio Ball and Rumyana Kristeva-Feige and Jens Timmer},
  year = {2000},
  url = {https://link.springer.com/content/pdf/10.1007/3-540-39949-6_9.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：脑电图空间模式分类},
  abstract = {The aim of this study is to describe a general approach to determine important electrode positions in the case when the measured EEG-signal is used for classication. To classify planning of movement of right and left index nger, three dierent approaches were compared: classication using a physiologically motivated set of four electrodes, a set determined by principal component analysis and electrodes deter- mined by spatial pattern analysis. Spatial pattern analysis enhanced the classication rate signicantly from 61:3 1:8% (with four electrodes) to 71:8 1:4% whereas the classication rate using the principal component analysis is signicantly lower (65:2 1:4%). Most of the 61 electrodes used had no influence on the classication rate so that in future experi- ments the setup can be simplied drastically to 6 to 8 electrodes without loss of information.},
}

