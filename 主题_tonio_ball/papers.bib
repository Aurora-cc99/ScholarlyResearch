@misc{tonio_ball_a06d793781b98844,
  title = {Traveling waves and trial averaging: The nature of single-trial and averaged brain responses in large-scale cortical signals},
  author = {Chris Trengove and Mikhail Zvyagintsev and Cees van Leeuwen and Johanna Ruescher and Andreas Schulze-Bonhage and David M. Alexander and Andrey R. Nikolaev and Sergei Gepshtein and Peter Jurica and Tonio Ball and Klaus Mathiak},
