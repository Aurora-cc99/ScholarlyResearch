@misc{guoying_zhao_f3e7f4d0359b,
  title = {MAC 2024: Micro-Action Analysis Grand Challenge},
  author = {Dan Guo and Xiaobai Li and Kun Li and Haoyu Chen and Jingjing Hu and Guoying Zhao and Yi Yang and Meng Wang},
  year = {2024},
