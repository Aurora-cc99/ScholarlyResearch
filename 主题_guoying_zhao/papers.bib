@misc{guoying_zhao_f42c6cd775a8b5c3,
  title = {Minutes-long soft X-ray prompt emission from a compact object merger},
  author = {An Y. Li and Chen-Wei Wang and Niccolò Passaleva and Jie An and Bin-Bin Zhang and Eleonora Troja and Yi-Han Iris Yin and Yuan Liu and S. L. Xiong and Li-Ping Xin and Yi-Xuan Shao and Jun Yang and Hui Sun and Dong Xu and Yu-Han Yang and Roberto Ricci and He Gao and S. Antier and R. L. Becerra and Jia-Xin Cao and Alberto Javier Castro-Tirado and Xin-Lei Chen and Ye-Hao Cheng and Yong Chen and Hua-Qing Cheng and Valerio D'Elia and M. de Pasquale and Yong-Wei Dong and E. G. Elhosseiny and Rob A. J. Eyles-Ferris and Maria I. Gritsevich and Xu-Hui Han and Dieter H. Hartmann and Y. D. Hu and Jing-Wei Hu and Shu-Mei Jia and Nino Kochiashvili and Wei‐Hua Lei and A. J. Levan and Cheng-Kui Li and Dongyue Li and Hua-Li Li and Xiaobo Li and Zhi-Xing Ling and He-Yang Liu and Houjun Lv and Daniele Bjørn Malesani and Brendan O’Connor and Haiwu Pan and Shashi Bhushan Pandey and Ignacio Pérez-García and D. L. A. Pieterse and Marion Pillas and Yu-Lei Qiu and A. Saccardi and Rubén Sánchez-Ramírez and Wen-Jun Tan and Manasanun Tanasan and Nial R. Tanvir and Susanna Diana Vergani and Jing Wang and Xiao-Feng Wang and Qin-Yu Wu and Shu-Xu Yi and Yusufjon A. Tillayev and Chen Zhang and Wen-Da Zhang and Yi-Jia Zhang and Guoying Zhao and Chao Zheng and Shi-Jie Zheng and Chang Zhou and Ping Zhou and B. Cordier and Jian-Yan Wei and Wei Yuan and Shuang-Nan Zhang and Bing Zhang},
  year = {2026},
  doi = {10.1016/j.scib.2026.08.021},
  url = {https://doi.org/10.1016/j.scib.2026.08.021},
  howpublished = {中国科学通报：英文版},
  annotation = {中文辅助译名：紧凑物体合并产生几分钟长的软 X 射线瞬发发射},
  abstract = {Compact object mergers are multi-messenger sources and known progenitors of some gamma-ray bursts, bright flashes of high-energy radiation powered by a central engine, either an accreting black hole or a neutron star. Our understanding of these events has so far been shaped primarily by observations in the gamma-ray band, leaving their prompt phase poorly constrained at lower energies. A long-lasting ($\approx$100 s) engine-driven X-ray emission was discussed to explain rapidly fading X-ray afterglows following several ($\approx$30%) bursts of short ($\lesssim$2 s) duration. However, this prompt X-ray component was not directly observed and past candidates were not confirmed. Here we report the discovery of EP250704a containing a minutes-long ($\sim$560 s) flash of soft (0.5--4 keV) X-rays immediately following the short ($\sim$0.4 s) GRB 250704B. The variability and spectral shape of this emission are inconsistent with the canonical picture of a hard, accretion-powered spike followed by a standard external-shock afterglow. Instead, the long-soft bump points to a distinct phase of prompt emission in X-rays, which would not have been detected without the soft X-ray coverage of Einstein Probe. The detection of a prompt soft X-ray counterpart in an otherwise ordinary short GRB shows that long-lasting X-ray emission is likely a common feature of merger-driven bursts and a promising electromagnetic counterpart to gravitational wave sources.},
}

