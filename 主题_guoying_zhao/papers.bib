  abstract = {MRAC 2026 marks the fourth edition of this workshop. The official website is available at: https://react-ws.github.io/2026_mrac/. Centered on affective computing, the workshop emphasizes multimodal, generative, and responsible AI technologies. This year, we received 40 submissions, a new milestone that underscores the growing interest in our workshop within the research community. The workshop has two tracks: Track 1 hosts the MER 2026 Challenge, comprising four tracks: MER-Cross focuses on emotion recognition in dyadic interactions; MER-FG targets fine-grained emotion recognition; MER-Prefer centers on human emotion preferences; and MER-PS integrates physiological signals for emotion recognition. MER 2026 has attracted approximately 300 registered teams, with 108 participating in MER-Cross, 64 in MER-FG, 82 in MER-Prefer, and 111 in MER-PS. We also invite participants to submit their challenge solutions to our workshop. Track 2 mainly focuses on the multimodal, generative, and responsible Affective Computing area. The creation, evaluation, and deployment of emotion-AI models require large amounts of multimodal data spanning RGB images, video, audio, text, and physiological signals. In principle, the development of any AI system must be guided by a concern for its impact on humans. The aim should be to augment and enhance human capabilities, not replace them, while drawing inspiration from human intelligence and prioritizing safety. MRAC 2026 aims to bring together affective },
}

@misc{guoying_zhao_5934560051ef,
  title = {ResoPhys: Unsupervised Plug-and-Play Remote Physiological Measurement via Facial Videos of Arbitrary Resolution},
  author = {Zhongtian He and Shuyang Chu and Xuqi Li and Zhengdong Jiang and Jian Xu and Guoying Zhao and Jingang Shi},
  year = {2026},
  doi = {10.1109/jbhi.2026.3658945},
  url = {https://doi.org/10.1109/jbhi.2026.3658945},
  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：ResoPhys：通过任意分辨率的面部视频进行无监督即插即用远程生理测量},
  abstract = {Remote photoplethysmography (rPPG) is a non-contact method that detects blood volume changes in facial tissues from video. The non-invasiveness of rPPG makes it promising for applications in remote health monitoring and telemedicine. However, its real-world application is hindered by a fundamental challenge. Existing models are typically designed for high-resolution, fixed-size inputs, making them ill-suited for the arbitrary-resolution videos commonly encountered in practical scenarios due to dynamic camera-to-subject distances. To address this challenge, we propose ResoPhys, an unsupervised plug-and-play rPPG measurement method designed for facial videos of arbitrary resolution. This method first generates video pairs via random scaling and then employs specialized modules for arbitrary-resolution feature extraction and upsampling to analyze the resulting multi-scale features. The framework is optimized via an unsupervised contrastive learning approach using our proposed multi-resolution contrastive loss. To validate its performance across a spectrum of resolutions, we evaluated ResoPhys on several public datasets. The results demonstrate the superiority of our method over previous unsupervised approaches, exhibiting particular strength in challenging low-resolution scenarios, which underscores its robustness to resolution changes. Crucially, ResoPhys acts as a universal front-end that decouples resolution handling from signal extraction, empowering existing rPPG networks f},
}

