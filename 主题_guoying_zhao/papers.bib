@misc{guoying_zhao_f6e4ebd870ad,
  title = {Surveillance Face Anti-Spoofing},
  author = {Hao Fang and Ajian Liu and Jun Wan and Sergio Escalera and Chenxu Zhao and Xu Zhang and Stan Z. Li and Zhen Lei},
  year = {2024},
