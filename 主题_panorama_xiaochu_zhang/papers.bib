@misc{panorama_xiaochu_zhang_1640516437c0,
  title = {Spatiotemporal Alignment for EEG-FNIRS Emotion Recognition},
  author = {Haifeng Li and Xueying Zhang and Guijun Chen and Yaru Zhou and Zelin Wu and Lixia Huang and Ying Sun},
  year = {2026},
