  abstract = {Digital technology, particularly smartphones, has become an integral part of modern life, raising concerns about its impact on mental health, especially among young people. Previous studies have yielded inconsistent results, possibly due to an overemphasis on the connection between smartphone use and mental health while neglecting confounding variables such as face-to-face communication time as well as a lack of differentiation between different types of digital use. The time displacement hypothesis suggests that digital media time may reduce time for beneficial activities like face-to-face interactions, highlighting the interplay between digital and non-digital elements. However, the validity of this hypothesis has not been confirmed with adequate precision of measuring both offline and online time and appropriate analysis methods to assess the dynamic interactions of the digital and in person communications. In this pre-registered study, we employed the experience sampling method (ESM) to track both the offline and online daily activities of 418 individuals in Japan over 21 days and analyzed the data using multilevel models and psychometric network models. Our study also examined the effects of different communication targets (private one-to-one vs. public one-to-many) and communication modes (online vs. offline). The findings revealed that digital use has only a small direct effect on well-being, with promoting loneliness of one-to-many online communication (e.g., viewing },
}

@misc{panorama_xiaochu_zhang_3bfacd5d49fbb4e2,
  title = {Explainable History Distillation by Marked Temporal Point Process},
  author = {Sishun Liu and Ke Deng and Yan Wang and Xiuzhen Zhang},
  year = {2023},
  doi = {10.48550/ARXIV.2311.07797},
  url = {https://doi.org/10.48550/ARXIV.2311.07797},
  howpublished = {CoRR},
  annotation = {中文辅助译名：通过标记时间点过程进行可解释的历史蒸馏},
  abstract = {Explainability of machine learning models is mandatory when researchers introduce these commonly believed black boxes to real-world tasks, especially high-stakes ones. In this paper, we build a machine learning system to automatically generate explanations of happened events from history by \glsca based on the \acrfulltpp. Specifically, we propose a new task called \acrfullehd. This task requires a model to distill as few events as possible from observed history. The target is that the event distribution conditioned on left events predicts the observed future noticeably worse. We then regard distilled events as the explanation for the future. To efficiently solve \acrshortehd, we rewrite the task into a \gls01ip and directly estimate the solution to the program by a model called \acrfullmodel. This work fills the gap between our task and existing works, which only spot the difference between factual and counterfactual worlds after applying a predefined modification to the environment. Experiment results on Retweet and StackOverflow datasets prove that \acrshortmodel significantly outperforms other \acrshortehd baselines and can reveal the rationale underpinning real-world processes.},
}

