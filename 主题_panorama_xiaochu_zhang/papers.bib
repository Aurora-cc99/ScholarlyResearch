@misc{panorama_xiaochu_zhang_0cd0c764142010c3,
  title = {A Low-cost 32-channel EEG Signal Acquisition System for Wearable Applications},
  author = {Minglei Du and Huixing Gou and Mingxiao Yuan and Pei Jung Wu and Yijun Chen and Chuangchuang Chang and Ginger Qinghong Zeng and Xiaochu Zhang},
  year = {2024},
  doi = {10.1109/icftic64248.2024.10913298},
  url = {https://doi.org/10.1109/icftic64248.2024.10913298},
  howpublished = {IEEE International Conference on Frontiers Technology of Information and Computer (ICFTIC)},
  annotation = {中文辅助译名：适用于可穿戴应用的低成本 32 通道 EEG 信号采集系统},
  abstract = {Electroencephalography (EEG) is a valuable non-invasive brain-computer interface technology. However, traditional EEG systems are often prohibitively expensive and bulky. In this paper, we present a novel, low-cost and portable EEG system with 32-channel EEG acquisition for wearable applications. The proposed system consists of signal acquisition, signal processing, WiFi transmission, and computer data analysis. It can acquire 32 channels of EEG data at a high sampling rate of up to 2 kHz and transmits data via WiFi. To evaluate our system, we utilize common-mode rejection ratio (CMRR) test, noise analysis, and functional assessments including alpha wave detection and steady-state visually evoked potential (SSVEP) experiments. Experimental results demonstrate that our system has superior performance (more channels and higher sampling frequency) with lower cost compared with existing EEG acquisition systems, providing a feasible solution for most EEG acquisition and analysis applications.},
}

