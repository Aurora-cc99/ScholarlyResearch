@misc{panorama_xiaochu_zhang_fe36865dde9b35ab,
  title = {LMOD\(\boldsymbol+\): A Comprehensive Multimodal Dataset and Benchmark for Developing and Evaluating Multimodal Large Language Models in Ophthalmology},
