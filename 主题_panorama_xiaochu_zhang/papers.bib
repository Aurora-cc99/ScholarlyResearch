  year = {2016},
  doi = {10.1109/ISIE.2016.7744980},
  url = {https://doi.org/10.1109/ISIE.2016.7744980},
  howpublished = {ISIE},
  annotation = {中文辅助译名：使用智能电表数据进行用电峰值检测以进行负载分析},
  abstract = {Emerging smart meter technologies allow energy retailers to monitor individual's consumption in real time. Efforts have been made in mining, modelling and manipulating those time series data for large number of applications, such as demand forecasting, user profiling or household appliance identification. This paper, however, focuses on modelling spikes in power usage for load profiling. This is a critical characteristic in smart meter load profiles. This paper presents a fast and accurate method to automate the detection of power usage spikes for further smart meter applications.},
}

