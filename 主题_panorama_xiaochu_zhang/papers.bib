@misc{panorama_xiaochu_zhang_65f0ff9fd16b0366,
  title = {Functional Polymorphism of the Mu-Opioid Receptor Gene (OPRM1) Influences Reinforcement Learning in Humans},
  author = {Mary R. Lee and Courtney L. Gallen and Xiaochu Zhang and Colin A. Hodgkinson and David A Goldman and Elliot A. Stein and Christina S. Barr},
  year = {2011},
  doi = {10.1371/journal.pone.0024203},
  url = {https://doi.org/10.1371/journal.pone.0024203},
  howpublished = {PLoS ONE},
  annotation = {中文辅助译名：Mu-阿片受体基因 (OPRM1) 的功能多态性影响人类强化学习},
  abstract = {Previous reports on the functional effects (i.e., gain or loss of function), and phenotypic outcomes (e.g., changes in addiction vulnerability and stress response) of a commonly occurring functional single nucleotide polymorphism (SNP) of the mu-opioid receptor (OPRM1 A118G) have been inconsistent. Here we examine the effect of this polymorphism on implicit reward learning. We used a probabilistic signal detection task to determine whether this polymorphism impacts response bias to monetary reward in 63 healthy adult subjects: 51 AA homozygotes and 12 G allele carriers. OPRM1 AA homozygotes exhibited typical responding to the rewarded response--that is, their bias to the rewarded stimulus increased over time. However, OPRM1 G allele carriers exhibited a decline in response to the rewarded stimulus compared to the AA homozygotes. These results extend previous reports on the heritability of performance on this task by implicating a specific polymorphism. Through comparison with other studies using this task, we suggest a possible mechanism by which the OPRM1 polymorphism may confer reduced response to natural reward through a dopamine-mediated decrease during positive reinforcement learning.},
}

@misc{panorama_xiaochu_zhang_1ddeb422cbdb6425,
  title = {A semantic aware image retargeting scheme combining seam carving and non-homogeneous warping},
  author = {Yu Gong and Lifang Wu and Xiuzhen Zhang},
  year = {2010},
  doi = {10.1145/1937728.1937741},
  url = {https://doi.org/10.1145/1937728.1937741},
  howpublished = {ICIMCS},
  annotation = {中文辅助译名：结合接缝雕刻和非均匀扭曲的语义感知图像重定向方案},
  abstract = {In this paper we propose a novel approach to semantic aware image retargeting combining seam carving and non-homogeneous warping. We extract the playing ground of basketball matches as the semantically important region and compute the Semantic Weight Function (SWF). We improve seam carving and warping using SWF. Furthermore, we combine seam carving and warping coherently. Our scheme starts from the seam carving operation on the original image. After a seam is removed, we compute Deformation of Semantic Edges (DSE). Seam carving is continued until DSE is larger than the assigned threshold. If the size of a current image is not the target size, it is further adapted to the target size using non-homogeneous warping. We compare our approach with scaling, seam carving and semantic aware seam carving. Experimental results show that our approach preserves more semantically important regions with less deformation.},
}

