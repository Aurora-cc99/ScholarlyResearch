  annotation = {中文辅助译名：$\bm\xi$-$\bm\pi$：神经功率谱分解的非参数模型},
  abstract = {The power spectra estimated from the brain recordings are the mixed representation of aperiodic transient activity and periodic oscillations, i.e., aperiodic component (AC) and periodic component (PC). Quantitative neurophysiology requires precise decomposition preceding parameterizing each component. However, the shape, statistical distribution, scale, and mixing mechanism of AC and PCs are unclear, challenging the effectiveness of current popular parametric models such as FOOOF, IRASA, BOSC, etc. Here, ξ- π was proposed to decompose the neural spectra by embedding the nonparametric spectra estimation with penalized Whittle likelihood and the shape language modeling into the expectation maximization framework. ξ- π was validated on the synthesized spectra with loss statistics and on the sleep EEG and the large sample iEEG with evaluation metrics and neurophysiological evidence. Compared to FOOOF, both the simulation presenting shape irregularities and the batch simulation with multiple isolated peaks indicated that ξ- π improved the fit of AC and PCs with less loss and higher F1-score in recognizing the centering frequencies and the number of peaks; the sleep EEG revealed that ξ- π produced more distinguishable AC exponents and improved the sleep state classification accuracy; the iEEG showed that ξ- π approached the clinical findings in peak discovery. Overall, ξ- π offered good performance in the spectra decomposition, which allows flexible parameterization using descripti},
}

@misc{panorama_xiaochu_zhang_09261d41f60eebe5,
  title = {Parameter Space and Potential for Biomarker Development in 25 Years of fMRI Drug Cue Reactivity: A Systematic Review},
  author = {Addiction Cue-Reactivity Initiative (ACRI) Network and Arshiya Sangchooli and Mehran Zare-Bidoky and Ali Fathi Jouzdani and Joseph P. Schacht and James Matthew Bjork and Eric Daniel Claus and James J. Prisciandaro and Stephen Jeffrey Wilson and Torsten Wüstenberg and Stéphane Potvin and Pooria Ahmadi and Patrick Bach and Alex Baldacchino and Anne Beck and Kathleen T. Brady and Judson A. Brewer and Anna Rose Childress and Kelly Elizabeth Courtney and Mohsen Ebrahimi and Francesca Mapua Filbey and Hugh Garavan and Dara G. Ghahremani and Rita Z. Goldstein and Anna E. Goudriaan and Erica N. Grodin and Colleen A. Hanlon and Amelie Haugg and Markus A Heilig and Andreas Heinz and Adrienn Holczer and Ruth Janke van Holst and Jane E. Joseph and Anthony Juliano and Marc J. Kaufman and Falk Kiefer and Arash Khojasteh Zonoozi and Rayus Kuplicki and Marco Leyton and Edythe D. London and Scott Mackey and Francis Joseph McClernon and William H. Mellick and Kirsten C. Morley and Hamid R. Noori and Mohammad Ali Oghabian and Jason A. Oliver and Max M. Owens and Martin P. Paulus and Irene Perini and Parnian Rafei and Lara A. Ray and Rajita Sinha and Michael N. Smolka and Ghazaleh Soleimani and Rainer Spanagel and Vaughn R. Steele and Susan Frances Tapert and Sabine Vollstädt‐Klein and Reagan R. Wetherill and Katie A. Witkiewitz and Kai Yuan and Xiaochu Zhang and Antonio Verdejo‐García and Marc Nicholas Potenza and Amy C. Janes and Hedy Kober A and Anna Zilverstand and Hamed Ekhtiari},
  year = {2024},
  doi = {10.1001/jamapsychiatry.2023.5483},
  url = {https://doi.org/10.1001/jamapsychiatry.2023.5483},
