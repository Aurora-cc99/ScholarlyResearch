@misc{panorama_xiaochu_zhang_06540cdde7f25bf1,
  title = {Cognitive control in individuals with heroin use disorder after prolonged methadone maintenance treatment},
  author = {Wei Zhao and Fan Duan and Xiangyu Li and Junda Li and Lingling Xia and Zixuan Ren and Yegang Li and Song Li and Peipei Song and Linlin Mu and Lijin Wang and Jing Zhang and Xun Song and Ze Wang and Jinxuan Chen and Xiaochu Zhang and Dongliang Jiao},
