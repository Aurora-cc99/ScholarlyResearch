@misc{panorama_xiaochu_zhang_e40467578c75b61e,
  title = {Computing Addiction: Epistemic Injustice Challenges in the Culture of Computational Psychiatry},
  author = {Min Wang and Zhoukang Wu and Liangjiecheng Huang and Xiaochu Zhang and Xiaosong He},
  year = {2024},
  doi = {10.4067/s1726-569x2024000200263},
  url = {https://doi.org/10.4067/s1726-569x2024000200263},
  howpublished = {Acta bioethica},
  annotation = {中文辅助译名：计算成瘾：计算精神病学文化中的认知不公正挑战},
  abstract = {Computational psychiatry (CP), based on artificial intelligence technology, plays an increasingly important role in scientific research and medical diagnosis.Epistemic concerns in the ethics of artificial intelligence have also been at the center of debate in CP, but the different epistemic forms of injustice caused by the internal cultures of CP remain unexplained.We distinguish between datadriven and theory-driven cultures and their research purposes via practical examples of CP models deployed in addiction.A data-driven culture may advance medical understanding of biological categories of mental illness, whereas a theory-driven culture provides better explanatory mechanisms between symptoms and biology.We discuss testimonial injustice caused by the silencing of patient voices in a data-driven culture, and hermeneutic injustice caused by the non-sharing of hermeneutic resources in theory-driven culture based on Miranda Fricker's account of epistemic injustice.We analyze the factors underlying nuances in epistemic forms between the two, such as naturalistic-dominated medical understanding and the system's epistemic privileging.The above epistemic risks all indicate the intricacies of mental disorders and require that success be assessed in terms of actual benefit to patients.Finally, we emphasize the importance of the patient's phenomenology and call for greater inclusion of patients in psychiatric decision-making processes.},
}

@misc{panorama_xiaochu_zhang_732544a063b0f797,
  title = {Higher emotional synchronization is modulated by relationship quality in romantic relationships and not in close friendships},
  author = {Yijun Chen and Shen Liu and Yaru Hao and Qian Zhao and Jiecheng Ren and Yi Piao and Liuyun Wang and Yunping Yang and Chenggong Jin and Hangwei Wang and Xuezhi Zhou and Jia‐Hong Gao and Xiaochu Zhang and Zhengde Wei},
  year = {2024},
  doi = {10.1016/j.neuroimage.2024.120733},
  url = {https://doi.org/10.1016/j.neuroimage.2024.120733},
  howpublished = {NeuroImage},
  annotation = {中文辅助译名：较高的情感同步是由浪漫关系中的关系质量调节的，而不是亲密友谊中的关系质量},
  abstract = {Emotions are fundamental to social interaction and deeply intertwined with interpersonal dynamics, especially in romantic relationships. Although the neural basis of interaction processes in romance has been widely explored, the underlying emotions and the connection between relationship quality and neural synchronization remain less understood. Our study employed EEG hyperscanning during a non-interactive video-watching paradigm to compare the emotional coordination between romantic couples and close friends. Couples showed significantly greater behavioral and prefrontal alpha synchronization than friends. Notably, couples with low relationship quality required heightened neural synchronization to maintain robust behavioral synchronization. Further support vector machine analysis underscores the crucial role of prefrontal activity in differentiating couples from friends. In summary, our research addresses gaps concerning how intrinsic emotions linked to relationship quality influence neural and behavioral synchronization by investigating a natural non-interactive context, thereby advancing our understanding of the neural mechanisms underlying emotional coordination in romantic relationships.},
}

@misc{panorama_xiaochu_zhang_0ad1e2deeb4a2bc4,
  title = {Atypical effective connectivity from the frontal cortex to striatum in alcohol use disorder},
  author = {Hongwen Song and Ping Yang and Xinyue Zhang and Rui Tao and Lin Zuo and Weili Liu and Jiaxin Fu and Zhuo Kong and Rui Tang and Siyu Wu and Liangjun Pang and Xiaochu Zhang},
  year = {2024},
  doi = {10.1038/s41398-024-03083-8},
  url = {https://doi.org/10.1038/s41398-024-03083-8},
  howpublished = {Translational Psychiatry},
  annotation = {中文辅助译名：酒精使用障碍中从额叶皮层到纹状体的非典型有效连接},
  abstract = {Alcohol use disorder (AUD) is a profound psychiatric condition marked by disrupted connectivity among distributed brain regions, indicating impaired functional integration. Previous connectome studies utilizing functional magnetic resonance imaging (fMRI) have predominantly focused on undirected functional connectivity, while the specific alterations in directed effective connectivity (EC) associated with AUD remain unclear. To address this issue, this study utilized multivariate pattern analysis (MVPA) and spectral dynamic causal modeling (DCM). We recruited 32 abstinent men with AUD and 30 healthy controls (HCs) men, and collected their resting-state fMRI data. A regional homogeneity (ReHo)-based MVPA method was employed to classify AUD and HC groups, as well as predict the severity of addiction in AUD individuals. The most informative brain regions identified by the MVPA were further investigated using spectral DCM. Our results indicated that the ReHo-based support vector classification (SVC) exhibits the highest accuracy in distinguishing individuals with AUD from HCs (classification accuracy: 98.57%). Additionally, our results demonstrated that ReHo-based support vector regression (SVR) could be utilized to predict the addiction severity (alcohol use disorders identification test, AUDIT, R 2 = 0.38; Michigan alcoholism screening test, MAST, R 2 = 0.29) of patients with AUD. The most informative brain regions for the prediction include left pre-SMA, right dACC, right LOFC},
}

@misc{panorama_xiaochu_zhang_5e77d883a861e909,
  title = {Harnessing Network Effect for Fake News Mitigation: Selecting Debunkers via Self-Imitation Learning},
  author = {Xiaofei Xu and Ke Deng and Michael Dann and Xiuzhen Zhang},
  year = {2024},
  doi = {10.48550/ARXIV.2402.03357},
  url = {https://doi.org/10.48550/ARXIV.2402.03357},
  howpublished = {CoRR},
  annotation = {中文辅助译名：利用网络效应减少假新闻：通过自模仿学习选择揭穿者},
  abstract = {This study aims to minimize the influence of fake news on social networks by deploying debunkers to propagate true news. This is framed as a reinforcement learning problem, where, at each stage, one user is selected to propagate true news. A challenging issue is episodic reward where the "net" effect of selecting individual debunkers cannot be discerned from the interleaving information propagation on social networks, and only the collective effect from mitigation efforts can be observed. Existing Self-Imitation Learning (SIL) methods have shown promise in learning from episodic rewards, but are ill-suited to the real-world application of fake news mitigation because of their poor sample efficiency. To learn a more effective debunker selection policy for fake news mitigation, this study proposes NAGASIL - Negative sampling and state Augmented Generative Adversarial Self-Imitation Learning, which consists of two improvements geared towards fake news mitigation: learning from negative samples, and an augmented state representation to capture the "real" environment state by integrating the current observed state with the previous state-action pairs from the same campaign. Experiments on two social networks show that NAGASIL yields superior performance to standard GASIL and state-of-the-art fake news mitigation models.},
}

@misc{panorama_xiaochu_zhang_f6c8119d5c56f2fe,
  title = {Cross-ancestry genome-wide association studies of brain imaging phenotypes},
  author = {Jilian Fu and Quan Zhang and Jianhua Wang and Meiyun Wang and Bing Zhang and Wenzhen Zhu and Shijun Qiu and Zuojun Geng and Guangbin Cui and Yongqiang Yu and Weihua Liao and Hui Zhang and Bo Gao and Xiaojun Xu and Tong HAN and Zhenwei Yao and Wen Qin and Feng Liu and Meng Liang and Sijia Wang and Qiang Xu and Jiayuan Xu and Peng Zhang and Wei Li and Dapeng Shi and Caihong Wang and Su Lui and Zhihan Yan and Feng Chen and Jing Zhang and Jiance Li and Wen Shen and Yanwei Miao and Dawei Wang and Junfang Xian and Jia‐Hong Gao and Xiaochu Zhang and Kai Xu and Xi‐Nian Zuo and Long Jiang Zhang and Zhaoxiang Ye and Jingliang Cheng and Mulin Jun Li and Chunshui Yu and Quan Zhang and Junping Wang and Xue Zhang and Xinjun Suo and Congcong Yuan and Yuan Ji and Hui Feng Xue and Tianying Gao and Junpeng Liu and Yanjun Li and Xi Guo and Lixue Xu and Jiajia Zhu and Huaigui Liu and Fangshi Zhao and Jie Sun and Yongjie Xu and Huanhuan Cai and Jie Tang and Yaodan Zhang and Yongqin Xiong and Xianting Sun and Nannan Pan and Xue Zhang and Jiayang Yang and Nana Liu and Ya Wen and Dan Zhu and Bingjie Wu and Wenshuang Zhu and Qingqing Diao and Yujuan Cao and Bingbing Yang and Lining Guo and Yingying Xie and Jiahui Lin and Zhimin Li and Yan Zhang and Kaizhong Xue and Zirui Wang and Junlin Shen and Xuejun Zhang and Hao Ding and Qian Su and Shijie Zhang and Ma Lun and Yan Qin Bai and Min Guan and Wei Wei and Peifang Miao and Fuhong Duan and Yafei Guo and Weijian Wang and Lijuan Zheng and Li Lin and Yunfei Wang},
  year = {2024},
  doi = {10.1038/s41588-024-01766-y},
  url = {https://doi.org/10.1038/s41588-024-01766-y},
  howpublished = {Nature Genetics},
  annotation = {中文辅助译名：脑成像表型的跨祖先全基因组关联研究},
  abstract = {Abstract Genome-wide association studies of brain imaging phenotypes are mainly performed in European populations, but other populations are severely under-represented. Here, we conducted Chinese-alone and trans-ancestral genome-wide association studies of 3,414 brain imaging phenotypes in 7,058 Chinese and 33,224 European individuals. We identified 37 novel variant-phenotype associations in Chinese-alone analyses and 459 additional novel associations in trans-ancestral meta-analyses under the thresholds of P < 1.46 × 10− 11 for discovery and P < 0.05 for replication. We pooled genome-wide significant associations for brain imaging phenotypes identified in either single-ancestral or trans-ancestral analyses into 6,361 independent significant associations. These associations were unevenly distributed in the genome and across the brain phenotypic subgroups and demonstrated significant enrichment for nervous system development and signal transduction. We further categorized the 4,890 pooled genome-wide significant associations whose index variants were included in both Chinese and European analyses into 43 ancestry-specific and 3,524 ancestry-shared associations. Loci of the 6,361 pooled genome-wide significant associations for brain imaging phenotypes were shared by 16 brain-related non-imaging traits including cognition, personality, risk behavior, addiction, and neuropsychiatric disorders. Our results provide a valuable catalog of genetic associations for brain imaging phenot},
}

@misc{panorama_xiaochu_zhang_a2efee3c671e9e22,
  title = {Evaluation of tolerability and safety of transcranial electrical stimulation with gel particle electrodes in healthy subjects},
  author = {Chuangchuang Chang and Yi Piao and Mingsong Zhang and Yan Liu and Minglei Du and Miao Yang and Tianyuan Mei and Chengkai Wu and Yan Wang and Xueli Chen and Ginger Qinghong Zeng and Xiaochu Zhang},
  year = {2024},
  doi = {10.3389/fpsyt.2024.1441533},
  url = {https://doi.org/10.3389/fpsyt.2024.1441533},
  howpublished = {Frontiers in Psychiatry},
  annotation = {中文辅助译名：凝胶颗粒电极经颅电刺激对健康受试者的耐受性和安全性评估},
  abstract = {Background: With the advancement of transcranial electrical stimulation (tES) technology, an increasing number of stimulation devices and treatment protocols have emerged. However, safety and tolerability remain critical concerns before new strategies can be implemented. Particularly, the use of gel particle electrodes brings new challenges to the safety and tolerability of tES, which hinders its widespread adoption and further research. Objective: Our study utilized a specially designed and validated transcranial electrical stimulation stimulator along with preconfigured gel particle electrodes placed at F3 and F4 in the prefrontal lobes. We aimed to assess the tolerance and safety of these electrodes in healthy subjects by administering different durations and types of tES. Methods: Each participant underwent ten sessions of either transcranial direct current stimulation (tDCS) or transcranial alternating current stimulation (tACS), with session durations varying. In the experiment, we collected various measurement data from participants, including self-report questionnaire data and behavioral keystroke data. Tolerability was evaluated through adverse events (AEs), the relationship of adverse events with tES (AEs-rela), the Self-Rating Anxiety Scale (SAS), and the Visual Analog Mood Scale-Revised (VAMS-R). Safety was assessed using the Visual Analog Scale (VAS), the Skin Sensation Rating (SSR), Montreal Cognitive Assessment (MoCA), and Stroop task. These data were analyzed },
}

