@misc{panorama_xiaochu_zhang_85688bfe0617b789,
  title = {Cross-ancestry genome-wide association meta-analyses of hippocampal and subfield volumes},
  author = {Nana Liu and Long Jiang Zhang and Tian Tian and Jingliang Cheng and Bing Zhang and Shijun Qiu and Zuojun Geng and Guangbin Cui and Quan Zhang and Weihua Liao and Yongqiang Yu and Hui Zhang and Bo Gao and Xiaojun Xu and Tong HAN and Zhenwei Yao and Wen Qin and Feng Liu and Meng Liang and Qiang Xu and Jilian Fu and Jiayuan Xu and Wenzhen Zhu and Peng Zhang and Wei Li and Dapeng Shi and Caihong Wang and Su Lui and Zhihan Yan and Feng Chen and Jiance Li and Jing Zhang and Dawei Wang and Wen Shen and Yanwei Miao and Junfang Xian and Jia‐Hong Gao and Xiaochu Zhang and Mulin Jun Li and Kai Xu and Xi‐Nian Zuo and Meiyun Wang and Zhaoxiang Ye and Chunshui Yu and Quan Zhang and Junping Wang and Xue Zhang and Xinjun Suo and Congcong Yuan and Yuan Ji and Hui Feng Xue and Tianying Gao and Junpeng Liu and Yanjun Li and Xi Guo and Lixue Xu and Jiajia Zhu and Huaigui Liu and Fangshi Zhao and Jie Sun and Yongjie Xu and Huanhuan Cai and Jie Tang and Yaodan Zhang and Yongqin Xiong and Xianting Sun and Nannan Pan and Xue Zhang and Jiayang Yang and Ya Wen and Dan Zhu and Bingjie Wu and Wenshuang Zhu and Qingqing Diao and Yujuan Cao and Bingbing Yang and Lining Guo and Yingying Xie and Jiahui Lin and Zhimin Li and Yan Zhang and Kaizhong Xue and Zirui Wang and Junlin Shen and Xuejun Zhang and Hao Ding and Qian Su and Shijie Zhang and Ma Lun and Yan Qin Bai and Min Guan and Wei Wei and Peifang Miao and Fuhong Duan and Yafei Guo and Weijian Wang and Lijuan Zheng and Li Lin and Yunfei Wang and Han Zhang},
  year = {2023},
  doi = {10.1038/s41588-023-01425-8},
  url = {https://doi.org/10.1038/s41588-023-01425-8},
  howpublished = {Nature Genetics},
  annotation = {中文辅助译名：海马和亚区体积的跨祖先全基因组关联荟萃分析},
  abstract = {Abstract The hippocampus is critical for memory and cognition and neuropsychiatric disorders, and its subfields differ in cytoarchitecture, function and disease vulnerability. The genetic architectures of hippocampal and subfield volumes have been studied in individuals of European ancestry; however, the results cannot explain for inter-ancestry differences in their associations with cognitive abilities and brain disorders. Here, we conduct trans-ancestry genome-wide association meta-analyses in 65,821 individuals for hippocampal volume and 39,007 for subfield volumes, including 7,039 individuals of East Asian ancestry. We identify 539 locus-trait associations at P < 5×10− 8 for 44 hippocampal volumetric traits, including 161 novel associations and 41 novel loci. Trans-ancestry analysis improves the precision of fine-mapping mainly caused by the inter-ancestry difference in linkage disequilibrium and can enhance the prediction performance of polygenic scores in under-represented population by including hundreds of individuals from this population. Genetic variants associated with hippocampal and subfield volumes are enriched for neurogenesis and Wnt signaling and also affect cognition, emotion and neuropsychiatric disorders, such as Alzheimer's disease, schizophrenia, and depression. Our results highlight the value of trans-ancestry analysis in the investigation of genetic architectures of human traits.},
}

@misc{panorama_xiaochu_zhang_aaccadc3c969d47b,
  title = {Capacity-aware fair POI recommendation combining transformer neural networks and resource allocation policy},
  author = {Sajal Halder and Kwan Hui Lim and Jeffrey Chan and Xiuzhen Zhang},
  year = {2023},
  doi = {10.1016/J.ASOC.2023.110720},
  url = {https://doi.org/10.1016/J.ASOC.2023.110720},
  howpublished = {Appl. Soft Comput.},
  annotation = {中文辅助译名：结合Transformer神经网络和资源分配策略的容量感知公平 POI 推荐},
  abstract = {Point of Interest (POI) recommendations have primarily focused on maximizing user satisfaction, while neglecting the needs of POIs and their operators. One such need is recommendation exposure, which can lead to envy among the POIs. Some POIs may be under-recommended, while others may be over-recommended, resulting in dissatisfaction for both staff and users due to long queues or overcrowding. Existing work has not addressed the trade-off between satisfying user preferences and being fair to POIs, which typically aim to operate at capacity. Therefore, we introduce the POI fair allocation problem to model this issue, taking into account both user satisfaction and POI exposure fairness. To address this problem, we propose a fair POI allocation technique that balances user satisfaction and POI capacity-based exposure simultaneously. Our proposed model utilizes existing (transformer neural networks and attention LSTM model) personalized POI recommendation models that capture users’ spatio-temporal influences and interests in POI visits. We then propose POI capacity-based allocation using the over-demand cut policy and under-demand add policy, which ensures POI exposure ratio and envy-freeness up to certain thresholds. We evaluate the performance of our proposed model on five datasets containing real-life POI visits. Experimental evaluations show that our proposed model outperforms baselines in terms of user and POI-based evaluation metrics. To ensure reproducibility, we have publ},
}

@misc{panorama_xiaochu_zhang_59422ee6226e134a,
