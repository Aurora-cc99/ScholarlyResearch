@misc{panorama_xiaochu_zhang_9ad14f6369f01584,
  title = {Beyond mean rating: Probabilistic aggregation of star ratings based on helpfulness},
  author = {Wenyi Tay and Xiuzhen Zhang and Sarvnaz Karimi},
  year = {2020},
  doi = {10.1002/ASI.24297},
  url = {https://doi.org/10.1002/ASI.24297},
  howpublished = {J. Assoc. Inf. Sci. Technol.},
  annotation = {中文辅助译名：超越平均评级：基于有用性的星级评级的概率聚合},
  abstract = {Abstract The star‐rating mechanism of customer reviews is used universally by the online population to compare and select merchants, movies, products, and services. The consensus opinion from aggregation of star ratings is used as a proxy for item quality. Online reviews are noisy and effective aggregation of star ratings to accurately reflect the “true quality” of products and services is challenging. The mean‐rating aggregation model is widely used and other aggregation models are also proposed. These existing aggregation models rely on a large number of reviews to tolerate noise. However, many products rarely have reviews. We propose probabilistic aggregation models for review ratings based on the Dirichlet distribution to combat data sparsity in reviews. We further propose to exploit the “helpfulness” social information and time to filter noisy reviews and effectively aggregate ratings to compute the consensus opinion. Our experiments on an Amazon data set show that our probabilistic aggregation models based on “helpfulness” achieve better performance than the statistical and heuristic baseline approaches.},
}

