@misc{xipeng_qiu_a4d294d92c453de4,
  title = {FutureX: An Advanced Live Benchmark for LLM Agents in Future Prediction},
  author = {Xin Zhou and Xiang Gao and Jiecao Chen and Jiacheng Guo and Xiangsheng Li and Zehui Chen and Kaiyuan Zhang and Jiashuo Liu and Xinjie Chen and Yantao Du and Yixiao Tian and Yang Yang and Mingren Yin and Jose Blanchet and Zaiyuan Wang and Jingkai Liu and Liang Hu and Zhoufutu Wen and Shuang Ni and Jianpeng Jiao and Lingyue Yin and Yali Liao and Tianci He and Zhenwei Zhu and Tianle Cai and Zhiyuan Zeng and Ge Zhang and Mengdi Wang and Xipeng Qiu and Wenhao Huang and Siyuan Chen and Jinpeng Wang},
