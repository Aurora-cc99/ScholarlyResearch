@misc{xuanjing_huang_2ab60d5eb7c0ac7c,
  title = {Thinking with Video: Video Generation as a Promising Multimodal Reasoning Paradigm},
  author = {Tianyi Liang and Xuanjing Huang and Xinchi Chen and Xiaomeng Hu and Hangcheng Li and Yurong Mou and Qiguang Chen and Yining Zheng and Ming Zhang and Jun Zhao and Yongzhuo Yang and Mingzhe Li and Jingqi Tong and Xipeng Qiu},
  year = {2026},
  doi = {10.48550/arxiv.2511.04570},
  url = {http://arxiv.org/abs/2511.04570},
  howpublished = {CVPR},
  annotation = {中文辅助译名：用视频思考：视频生成作为一种有前途的多模态推理范式},
  abstract = {The "Thinking with Text" and "Thinking with Images" paradigms significantly improve the reasoning abilities of large language models (LLMs) and Vision-Language Models (VLMs). However, these paradigms have inherent limitations. (1) Images capture only single moments and fail to represent dynamic processes or continuous changes, and (2) The separation of text and vision as distinct modalities, which hinders unified multimodal understanding and generation. Therefore, we propose "Thinking with Video", a new paradigm that leverages video generation models such as Sora-2 to use video frames as a unified medium for multimodal reasoning. To support this exploration, we developed the Video Thinking Benchmark (VideoThinkBench), which covers both vision-centric tasks (e.g., Eyeballing Puzzles) and text-centric tasks (e.g., GSM8K and MMMU). Our evaluation on VideoThinkBench establishes Sora-2 as a capable reasoner. On vision-centric tasks, Sora-2 is comparable to state-of-the-art (SOTA) VLMs, and even surpasses GPT-5 by 10% on eyeballing puzzles. On text-centric tasks, Sora-2 achieves 92% accuracy on MATH, and 69.2% accuracy on MMMU. Furthermore, we systematically analyze the source of these abilities. We also find that self-consistency and in-context learning can improve Sora-2's performance. In summary, our findings show that the video generation model is the potential unified multimodal understanding and generation model, positioning "Thinking with Video" as a potential unified multim},
}

