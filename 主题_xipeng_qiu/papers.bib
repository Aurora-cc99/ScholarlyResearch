@misc{xipeng_qiu_b8b55e843ed0824d,
  title = {KLNCC: A new nonlinear correlation clustering algorithm based on KL-divergence},
  author = {Chaofeng Sha and Xipeng Qiu and Aoying Zhou},
  year = {2008},
  doi = {10.1109/CIT.2008.4594661},
  url = {https://doi.org/10.1109/CIT.2008.4594661},
  howpublished = {CIT},
  annotation = {中文辅助译名：KLNCC：一种基于KL散度的新型非线性相关聚类算法},
  abstract = {The problem of finding correlation among subsets of features in high-dimensional data arises in many applications. There has been much work on finding those correlations, including linear and nonlinear correlation clusters. In this paper, we present KLNCC, a novel nonlinear correlation clustering algorithm which adopts a dynamic two-phase approach. In the first phase, we findmicroclusters by EMalgorithm. In the second phase, these microclusters are merged in a bottom-up manner resulting in a dendrogram. The final clustering is determined by the users. When merging microclusters, we adopt the KL-divergence as the distance between two microclusters, which has explicit form when we use the EM clustering algorithm to find the microclusters. Our experimental evaluation on several real datasets demonstrates that KLNCC indeed discovers meaningful and accurate nonlinear correlation clusters.},
}

