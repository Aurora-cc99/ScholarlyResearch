@misc{xipeng_qiu_59ddf0ed34c31d75,
  title = {LLatrieval: LLM-Verified Retrieval for Verifiable Generation},
  author = {Linyang Li and Tianxiang Sun and Zhangyue Yin and Changtai Zhu and Xipeng Qiu and Xiaonan Li},
