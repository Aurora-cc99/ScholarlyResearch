  title = {Implicit Reward as the Bridge: A Unified View of SFT and DPO Connections},
  author = {Linyang Li and Qipeng Guo and Rong Bao and Peiji Li and Runyu Peng and Qinyuan Cheng and Xipeng Qiu and Zhiyuan Zeng and Yunhua Zhou and Bo Wang},
