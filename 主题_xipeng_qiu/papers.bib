  author = {Xiangyang Liu and Yan Teng and Jiawei Sun and Qianyu Guo and Yingchun Wang and Kexin Huang and Zeyang Zhou and Yixu Wang and Tianxiang Sun and Dahua Lin and Yaru Wang and Xipeng Qiu},
  year = {2014},
  doi = {10.18653/V1/2024.NAACL-LONG.256},
