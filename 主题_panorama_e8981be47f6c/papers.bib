  author = {Hao-Yuan Ma and Li Zhang and Minjie Qiang},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11463312},
  url = {https://doi.org/10.1109/icassp55912.2026.11463312},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：OVID：文本引导的开放词汇密集对象计数和本地化},
  abstract = {Object counting and localization with open-vocabulary text descriptions remains challenging, as existing methods often require separate models for counting and localization tasks, lacking unified frameworks. We present OVID (Open-Vocabulary Image-text Dense Framework), the first unified end-to-end trainable architecture for simultaneous object counting and localization via textual queries. OVID predicts point coordinates for each object instance, enabling fine-grained visual-textual alignment. We design MAFT (Multi-Attention Fusion Transformer) to effectively fuse multi-modal features while preserving crucial fine-grained local information. A unified multi-task loss optimization strategy allows the model to learn complementary features for both tasks. Extensive experiments on FSC147 and TRANCOS benchmarks demonstrate our approach achieves competitive performance in open-vocabulary object counting and localization. Code is available at: https://github.com/Jason-Mar1/OVID.},
}

