@misc{panorama_e8981be47f6c_179f275f7ea8dd5d,
  title = {A fast approximation algorithm for 1-norm SVM with squared loss},
  author = {Li Zhang and Weida Zhou and Zhao Zhang and Jiwen Yang},
  year = {2015},
  doi = {10.1109/IJCNN.2015.7280326},
  url = {https://doi.org/10.1109/IJCNN.2015.7280326},
  howpublished = {IJCNN},
  annotation = {中文辅助译名：具有平方损失的一范数 SVM 的快速逼近算法},
  abstract = {1-norm support vector machine (SVM) has attracted substantial attentions for its good sparsity. However, the computational complexity of training 1-norm SVM is about the cube of the sample number, which is high. This paper replaces the hinge loss or the ε-insensitive loss by the squared loss in the 1-norm SVM, and applies orthogonal matching pursuit (OMP) to approximate the solution of the 1-norm SVM with the squared loss. Experimental results on toy and real-world datasets show that OMP can faster train 1-norm SVM and achieve similar learning performance compared with some methods available.},
}

