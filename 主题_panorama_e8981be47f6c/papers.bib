@misc{panorama_e8981be47f6c_ba48a00ebb031019,
  title = {Multi-Source Clustering based on spectral recovery},
  author = {Hongwei Yin and Fanzhang Li and Li Zhang},
  year = {2018},
  doi = {10.1109/ICPR.2018.8545661},
