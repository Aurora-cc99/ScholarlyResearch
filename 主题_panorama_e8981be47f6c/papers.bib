@misc{panorama_e8981be47f6c_8689651cf676ded5,
  title = {Supervised locally linear embedding algorithm based on orthogonal matching pursuit},
  author = {Li Zhang and Yiqin Leng and Jiwen Yang and Fanzhang Li},
  year = {2015},
  doi = {10.1049/IET-IPR.2014.0841},
  url = {https://doi.org/10.1049/IET-IPR.2014.0841},
  howpublished = {IET Image Process.},
  annotation = {中文辅助译名：基于正交匹配追踪的有监督局部线性嵌入算法},
  abstract = {Supervised locally linear embedding (SLLE) has been proposed for classification tasks. SLLE can take full use of the label information and select neighbours only in the same class. However, SLLE uses the least squares (LSs) method for solving a set of linear equations to obtain linear representation coefficients, which relates to the inverse of a matrix. If the matrix is singular, the solution to the set of linear equations does not exist. Additionally, if the size of neighbourhood is not appropriate, some further neighbours along the manifold would be selected. To remedy those, this study deals with SLLE based on orthogonal matching pursuit (SLLE‐OMP) by introducing OMP into SLLE. In SLLE‐OMP, LS is replaced by OMP and OMP can reselect new neighbours from old ones. Experimental results on some real‐world datasets show that SLLE‐OMP can achieve better classification performance compared with SLLE.},
}

@misc{panorama_e8981be47f6c_bb3b7331cd446d0a,
  title = {Orthogonal matching pursuit-based incremental locally linear embedding algorithm},
  author = {Yiqin Leng and Li Zhang and Jiwen Yang},
  year = {2015},
  doi = {10.1504/IJAACS.2015.069572},
  url = {https://doi.org/10.1504/IJAACS.2015.069572},
  howpublished = {Int. J. Auton. Adapt. Commun. Syst.},
  annotation = {中文辅助译名：基于正交匹配追踪的增量局部线性嵌入算法},
  abstract = {Locally linear embedding (LLE) is one of powerful manifold learning algorithms. However, when new data are available, it is necessary for LLE to run again with both the new data and the original data together. Thus, several incremental methods have been proposed for LLE to solve this problem. Linear incremental method is currently the most commonly used incremental approach. But the pseudo inverse solution does not possibly exist when handling incremental process. This paper deals with an incremental LLE based on orthogonal matching pursuit (ILLE-OMP), which remedies the drawback. ILLE-OMP is also a linear incremental method. Compared with other linear incremental methods, experimental results show that ILLE-OMP is promising.},
}

