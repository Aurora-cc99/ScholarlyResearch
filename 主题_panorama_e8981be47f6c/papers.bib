  year = {2019},
  doi = {10.1109/CBD.2019.00063},
  url = {https://doi.org/10.1109/CBD.2019.00063},
  howpublished = {CBD},
  annotation = {中文辅助译名：通过残差多尺度卷积神经网络进行人群计数},
  abstract = {Scale-adaptive Convolutional Neural Network (SaCNN) has been proposed for crowd counting that is a practical application of machine learning in video surveillance. However, SaCNN suffers from an issue of degradation caused by its deep structure. Therefore, this paper proposes a Residual Multiscale Convolutional Neural Network (RMsCNN) to address the degradation issue. Based on the backbone of SaCNN, RMsCNN adopts residual learning and maps the image to its crowd density map for crowd counting. Crowd counting can be implemented by integrating the estimated density map. Experiments are conducted on Shanghaitech and UCF CC 50 datasets. Experimental results indicate that RMsCNN has a better performance compared with the state-of-the-art models.},
}

