@misc{panorama_e8981be47f6c_56c1d166efc352e8,
  title = {Position Attention Mechanism-based Ensemble Network for Trend Prediction of Limit Order Book},
  author = {Li Zhang and Yong-Ai Zheng and Xue-Rui Lv},
  year = {2024},
  doi = {10.1109/CSCWD61410.2024.10580770},
  url = {https://doi.org/10.1109/CSCWD61410.2024.10580770},
  howpublished = {CSCWD},
  annotation = {中文辅助译名：基于位置注意力机制的限价订单趋势预测集成网络},
  abstract = {Limit order books (LOBs) can reflect the order trading situation and the interactive information of the financial market; thus, LOBs have been widely adopted to forecast the future trend of stocks. Existing methods either do not make full use of LOBs’ information or lack adaptability to the information when constructing a model for trend prediction. Therefore, this paper proposes an ensemble network based on position attention mechanism (PAM-ENet) for trend prediction of LOBs. In PAM-ENet, we fuse three sub-models: a convolutional neural network (CNN) and two gated recurrent unit (GRU) networks, which are used to deal with the basic, time-insensitive, and time-sensitive features information of LOBs, respectively. To integrate outputs of three sub-models, we design a fusion module based on the position attention mechanism (PAM) and use it twice. First, two GRU sub-models are fused. Then, the output vector of CNN sub-model is fused with that of the first PAM fusion module. PAM-ENet can not only capture locality from the CNN sub-model and global property from two GRU sub-models, but also obtain the dependency between elements at any position of output vectors by using PAM fusion modules. Experimental results on FI-2010 show that PAM-ENet can extract significant features and discriminate the price trend well.},
}

