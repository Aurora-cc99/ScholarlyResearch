  author = {Yujie Zhang and Masashi Sakamoto and Chengqing Zong and Kazuhide Yamamoto and Satoshi Shirai},
  year = {2001},
  url = {http://nlpr-web.ia.ac.cn/cip/ZongPublications/2001-%20Zong-NLPRS.pdf},
