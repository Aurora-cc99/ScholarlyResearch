  title = {The CASIA statistical machine translation system for IWSLT 2008},
  author = {Yanqing He and Licheng Fang and Yu Zhou and Maoxi Li and Chengqing Zong and Yufeng Chen and Jiajun Zhang},
  year = {2008},
  url = {http://citeseerx.ist.psu.edu/viewdoc/summary?doi=10.1.1.505.180},
