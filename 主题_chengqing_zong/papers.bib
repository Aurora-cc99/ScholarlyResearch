@misc{chengqing_zong_b07d041553dd2c09,
  title = {AtomicCheck: Learning Structured Reasoning for Fact Verification via Protocol-Guided Reinforcement Learning},
  author = {Xingquan Zhang and Jianghao Chen and Yang Zhao and Pu Jian and Haoran Gao and Fanyu Meng and Junlan Feng and Chengqing Zong},
  year = {2026},
  doi = {10.18653/2026.aacl-long.184},
  url = {https://doi.org/10.18653/2026.aacl-long.184},
  howpublished = {International Joint Conference on Natural Language Processing and Conference of the Asia-Pacific Chapter of the Association for Computational Linguistics (IJCNLP-AACL)},
  annotation = {中文辅助译名：AtomicCheck：通过协议引导强化学习学习结构化推理以进行事实验证},
  abstract = {Fact verification is a critical primitive for ensuring the reliability of Large Language Models (LLMs).While frontier LLMs are effective verifiers, their repeated long-context inference incurs substantial costs; meanwhile, existing specialized verifiers face a fundamental dilemma: label-only models suffer from black-box opacity, while free-form rationale generators, whether trained by distillation or explanation-oriented RL objectives, can produce fluent but not structurally checkable explanations.In this work, we propose ATOMIC-CHECK, a Protocol-Guided Policy Optimization framework that trains specialized verifiers to produce protocol-guided, locally inspectable traces, moving beyond opaque label-only predictions and free-form rationales.Rather than cloning teacher traces or optimizing unstructured explanations, ATOMICCHECK uses RL to make the verification protocol itself part of the policy objective.To preserve semantic integrity during atomic decomposition, we introduce a Contrastive Decomposition Reward that compares decomposed reasoning with a samebackbone holistic counterfactual and penalizes decompositions that reduce verification accuracy.Extensive experiments demonstrate that ATOMICCHECK outperforms existing specialized verifiers and approaches strong frontier LLMs while producing structured traces that expose local checks behind the final decision.},
}

@misc{chengqing_zong_bec11565a4a9fb58,
  title = {BrainMoE: A Brain-Inspired Modular Mixture-of-Experts Model for Multimodal Reasoning},
  author = {Siyao Song and Yunhao Zhang and Jingyuan Sun and Yaping Zhang and Chengqing Zong},
  year = {2026},
  doi = {10.18653/2026.aacl-long.271},
  url = {https://doi.org/10.18653/2026.aacl-long.271},
  howpublished = {International Joint Conference on Natural Language Processing and Conference of the Asia-Pacific Chapter of the Association for Computational Linguistics (IJCNLP-AACL)},
  annotation = {中文辅助译名：BrainMoE：用于多模态推理的受大脑启发的模块化专家混合模型},
  abstract = {Reliable cross-modal reasoning requires Multimodal Large Language Model (MLLMs) with interpretable and controllable computation.However, existing models rely on datadriven architectures that entangle multimodal processing, obscuring the functional processes underlying their outputs.Inspired by the human brain's specialized and dynamically collaborative networks, we propose BrainMoE, a multimodal MoE model with six sensory and cognitive experts: Language, Logic, Social, World Knowledge, Vision, and Auditory.To support flexible sensory-cognitive coordination, we incorporates a layer-wise adaptive router that dynamically determines which experts are activated at each layer based on task-processing demands.Experiments on text, image, and audio reasoning benchmarks demonstrate that BrainMoE outperforms strong baselines by 1.59 and 2.2 points on text-only and multimodal benchmarks, while matching competitive external multimodal models.Routing and ablation analyses demonstrate clear expert specialization and causally important module-level contributions.Experiments on the cognitive benchmark further show that adaptive-routing BrainMoE aligns more closely with human behavioral patterns than baselines and static routing methods.},
}

@misc{chengqing_zong_750a0d9c799ce067,
  title = {CoPRM: A Collaborative Process Reward Model for Guiding Search Agent Reasoning},
  author = {Pu Jian and Donglei Yu and Chengqing Zong and Xingquan Zhang and Yang Zhao and Chong Li},
  year = {2026},
  doi = {10.18653/2026.emnlp-main.65},
  url = {https://doi.org/10.18653/2026.emnlp-main.65},
  howpublished = {EMNLP},
  annotation = {中文辅助译名：CoPRM：指导搜索智能体推理的协作过程奖励模型},
  abstract = {Large Language Model (LLM)-based search agents have demonstrated superior performance in knowledge-intensive tasks through interleaved reasoning and search interactions.Process Reward Models (PRMs) can enhance search agent performance by guiding step selection during inference.However, existing PRMs for search agents face a critical bottleneck: assessment unreliability in their training data.This issue stems from an over-reliance on single-source supervision, forcing a compromise between global solvability and local validity.We propose CoPRM (Collaborative Process Reward Model), a process reward model trained on high-quality preference data generated through our Collaborative Calibration methodology.This approach synthesizes immediate quality assessments with outcomeinformed evaluations through a dual-strategy mechanism: strictly enforcing consensus filtering to eliminate unreliable signals, and employing an outcome-informed gating mechanism to resolve heterogeneous cross-type tradeoffs.Trained on 10k preference pairs, CoPRM provides plug-and-play test-time guidance, enabling diverse search agents to achieve consistent performance improvements across four multi-hop QA benchmarks, demonstrating substantial gains, robust cross-domain generalization, and superior efficiency. 1},
}

@misc{chengqing_zong_f71885b7201919be,
  title = {DART: Disambiguation-Aware Reasoning for Video-guided Machine Translation},
  author = {Boyu Guan and Chuang Han and Chengqing Zong and Yang Zhao},
  year = {2026},
  doi = {10.18653/V1/2026.ACL-LONG.352},
  url = {https://doi.org/10.18653/V1/2026.ACL-LONG.352},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：DART：视频引导机器翻译的消歧感知推理},
  abstract = {Video-guided Machine Translation (VMT) seeks to enhance translation quality by incorporating contextual information derived from paired short video clips.However, many VMT samples are text-sufficient; even when visual information is needed, only minimal cues are required.Aiming to tackle these issues, we propose a novel framework DART (Disambiguation-Aware Reasoning for Videoguided Machine Translation).Reinforcement learning is used to incorporate multimodal large language models' multimodal reasoning into VMT.The model dynamically switches between text-only processing and multimodal integration, contingent on the necessity of visual disambiguation.Furthermore, we present TVRF (Translation-oriented Video Relevance Filtering), a systematic pipeline for constructing training data based on multimodal relevance to translation.This pipeline filters samples where video information is translationrelevant, mitigating training collapse caused by video-irrelevant data in conventional VMT.Experimental results show that our approach improves multimodal information utilization in VMT, yielding gains in both translation quality and computational efficiency.* Equal corresponding authors.Reasoning: Okay, I need to translate the input sentence ... So the answer is "哦！".(809 tokens in total) DA T Existing LMRMs … "It's hitting his yacht."Translation: 哦！(Oh!) Reasoning: Okay, so I need to translate the sentence ..},
}

@misc{chengqing_zong_cfa3d9d90f3edff8,
  title = {DQ-Former: Layer-Wise Querying Transformer With Dynamic Modality Priority for Conversational Multimodal Emotion Recognition},
  author = {Lu Xiang and Xinpei Zhao and Chengqing Zong and Jing Ye},
  year = {2026},
  doi = {10.1109/TAFFC.2026.3683357},
  url = {https://doi.org/10.1109/TAFFC.2026.3683357},
  howpublished = {IEEE Trans. Affect. Comput.},
  annotation = {中文辅助译名：DQ-Former：具有动态模态优先级的分层查询Transformer，用于会话多模态情感识别},
  abstract = {Human emotions are expressed through a variety of complementary channels, including text, speech signals, and visual behavior. Effectively modeling how these heterogeneous modalities interact remains a central challenge in multimodal emotion recognition (MER). Existing MER approaches predominantly rely on predefined fusion schemes, such as early/late fusion or hierarchical pairwise interactions, implicitly treating multimodal learning as a static aggregation problem. Such designs overlook the dynamic and hierarchical nature of emotional expression, where different modalities contribute unevenly across representation levels. As a result, they often fail to capture fine-grained emotional cues and suffer from limited scalability as the number of modalities increases. To address these limitations, we introduce DQ-Former, a novel framework thatDynamically utilizes signals from multiple modalities within a Layer-wiseQuerying TransFormerarchitecture to improve the emotion recognition ability. Instead of explicitly constructing modality pairs or fixed fusion structures, DQ-Former introduces a small set of learnable query tokens at each layer to dynamically extract and integrate emotional cues from pre-trained unimodal encoders. This design enables (i) adaptive cross-modal interaction without combinatorial fusion overhead, and (ii) progressive aggregation of modality-specific information across hierarchical representations. Our approach provides a new perspective on MER: emotional cue},
}

