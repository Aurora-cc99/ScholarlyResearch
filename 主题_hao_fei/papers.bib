@misc{hao_fei_b1e7fd3eec94dff3,
  title = {Detecting the Scope of Negation and Speculation in Biomedical Texts by Using Recursive Neural Network},
  author = {Yafeng Ren and Hao Fei and Qiong Peng},
  year = {2018},
  doi = {10.1109/bibm.2018.8621261},
  url = {https://doi.ieeecomputersociety.org/10.1109/BIBM.2018.8621261},
  howpublished = {BIBM},
  annotation = {中文辅助译名：利用递归神经网络检测生物医学文本中否定和推测的范围},
  abstract = {Detecting the scope of speculation and negation inbiomedical texts is an important research topic in biomedical community. Previous work shows that syntax information is crucial for the task, and these work usually models it locally by extracting a set of manually-crafted features such as dependency paths. In this paper, we explore empirically a recursive neural network model, representing whole dependency trees globally and learning automatically syntactic features, to better incorporate dependency-based syntax information. Experiments on BioScope corpus show that our model achieves competitive performance, outperforming previous systems.},
}

@misc{hao_fei_f6ee4f1a24a73e5e,
  title = {Neural Networks for Bacterial Named Entity Recognition},
  author = {Yafeng Ren and Hao Fei and Han Ren},
  year = {2018},
  doi = {10.1109/bibm.2018.8621206},
  url = {https://doi.ieeecomputersociety.org/10.1109/BIBM.2018.8621206},
  howpublished = {BIBM},
  annotation = {中文辅助译名：用于细菌命名实体识别的神经网络},
  abstract = {Bacterial named entity recognition is a challenging task in biomedical field. The task is typically modeled as a sequence labeling problem, and existing work mainly adopts discrete models such as CRF (Conditional Random Fields), requiring a large amount of hand-designed features with domain experience. To address this issue, this paper explores a neural network model for the task. We empirically study the effect of word embeddings and character embeddings on the task by extending a CRF baseline using neural networks. Results show the proposed neural network model achieves competitive performance, outperforming the current best discrete model. Meanwhile, the performance can be further improved by integrating neural and discrete features.},
}

