@misc{hao_fei_f218afa848e6,
  title = {The 1st International Workshop on Joint Audio-Video Comprehension and Generation (JAV-CG)},
  author = {You Qin and Kai Liu and Shengqiong Wu and Juncheng Li and Wei Ji and Hao Fei and Liang Zheng and Roger Zimmermann and Jiebo Luo and Tat-Seng Chua},
  year = {2026},
  doi = {10.1145/3767308.3842130},
  url = {https://doi.org/10.1145/3767308.3842130},
  howpublished = {Proceedings of the 34th ACM International Conference on Multimedia},
  annotation = {中文辅助译名：第一届联合音视频理解与生成国际研讨会 (JAV-CG)},
  abstract = {Audio and video jointly shape how people perceive events, yet many multimodal systems still process the two signals separately or use one only as auxiliary context. The 1st International Workshop on Joint Audio-Video Comprehension and Generation (JAV-CG) brings together researchers in multimedia, computer vision, speech and audio, and generative artificial intelligence to study their deep integration. The workshop centers on three connected themes: audio-visual comprehension, including localization, segmentation, question answering, and cross-modal reasoning; synchronized audio-video generation and editing; and unified models that support both understanding and generation across modalities. JAV-CG provides a focused forum for technical, position, and perspective papers, invited talks, paper presentations, and community discussion. It seeks to clarify shared evaluation needs, expose limitations in alignment, controllability, robustness, and data, and identify promising architectures for holistic audio-visual intelligence. The program includes archival workshop papers published in the ACM MM 2026 workshop proceedings and non-archival featured-paper presentations.},
}

@misc{hao_fei_013eb89d5efc,
  title = {Unveiling the Cognitive Compass: Theory-of-Mind-Guided Multimodal Emotion Reasoning},
  author = {Meng Luo and Bobo Li and Shanqing Xu and Shize Zhang and Qiuchan Chen and Menglu Han and Wenhao Chen and Yanxiang Huang and Hao Fei and Mong-Li Lee and Wynne Hsu},
  year = {2026},
  doi = {10.48550/ARXIV.2602.00971},
  url = {https://arxiv.org/abs/2602.00971},
  howpublished = {ICLR 2026},
  annotation = {中文辅助译名：揭示认知罗盘：心智理论引导的多模态情感推理},
  abstract = {Despite rapid progress in multimodal large language models (MLLMs), their capability for deep emotional understanding remains limited. We argue that genuine affective intelligence requires explicit modeling of Theory of Mind (ToM), the cognitive substrate from which emotions arise. To this end, we introduce HitEmotion, a ToM-grounded hierarchical benchmark that diagnoses capability breakpoints across increasing levels of cognitive depth. Second, we propose a ToM-guided reasoning chain that tracks mental states and calibrates cross-modal evidence to achieve faithful emotional reasoning. We further introduce TMPO, a reinforcement learning method that uses intermediate mental states as process-level supervision to guide and strengthen model reasoning. Extensive experiments show that HitEmotion exposes deep emotional reasoning deficits in state-of-the-art models, especially on cognitively demanding tasks. In evaluation, the ToM-guided reasoning chain and TMPO improve end-task accuracy and yield more faithful, more coherent rationales. In conclusion, our work provides the research community with a practical toolkit for evaluating and enhancing the cognition-based emotional understanding capabilities of MLLMs. Our dataset and code are available at: https://HitEmotion.github.io/.},
}

@misc{hao_fei_e9ae8125aa0b,
  title = {Enhancing Weakly Correlated Multimodal Sentiment Analysis With Meta-Knowledge},
  author = {Li Zheng and Mingqi Yan and Hao Fei and Yuzhe Ding and Jinghang Li and Bobo Li and Fei Li and Jinbo Li and Chong Teng and Donghong Ji},
  year = {2026},
  doi = {10.1109/taffc.2026.3738631},
  url = {https://haofei.vip/publications},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：利用元知识增强弱相关多模态情感分析},
  abstract = {Multimodal sentiment analysis (MSA) plays a crucial role in analyzing the diverse attitudes and opinions of internet users on social media platforms. Although existing works have achieved promising performance in sentiment analysis of image-text pairs in social media with strong correlations, they fall far short when dealing with those with weak correlations. In this paper, we propose Meta-MSA, a meta-knowledge driven multimodal sentiment analysis with multiple disentanglement and unimodal auxiliary enhancement framework to mine sentiment cues from weakly correlated multimodal data. We first design a meta-knowledge generation module to generate implicit associative knowledge behind image-text pairs, which supplements the model and enhances its ability to understand weakly correlated multimodal data. To improve the quality of features, we design a multiple disentanglement strategy to filter out the redundant information in the weakly correlated multimodal data. Moreover, since unimodal data also contains unique sentiment flags, we design two unimodal auxiliary tasks, namely text sentiment analysis and image sentiment analysis, to extract latent clues from unimodal data, thereby enhancing the understanding of multimodal sentiment analysis. Experiments on the RU-Senti and MVSA-Multiple datasets show that Meta-MSA achieves competitive performance and outperforms several state-of-the-art baselines for weakly-correlated multimodal sentiment-analysis scenarios, verifying its effecti},
}

@misc{hao_fei_5dfec0a2da29,
  title = {Towards One-to-Many Temporal Grounding},
  author = {Qi Xu and Tan Yue and Shihao Chen and Jiahao Meng and Anran Wang and Shunping Ji and Hao Fei and Xiangtai Li},
  year = {2026},
  doi = {10.48550/ARXIV.2606.06294},
  url = {https://arxiv.org/abs/2606.06294},
  howpublished = {CoRR},
  annotation = {中文辅助译名：迈向一对多时间接地},
  abstract = {Temporal Grounding (TG) aims to localize video segments corresponding to a textual query. Prior research predominantly focuses on single-segment retrieval. Real-world scenarios, however, often require localizing multiple disjoint segments for a single query -- a setting we term One-to-Many Temporal Grounding (OMTG). Previous state-of-the-art MLLMs, optimized for one-to-one settings, struggle in this context, often yielding near-zero scores due to a lack of event cardinality perception. To bridge this gap, we present a systematic solution with three key contributions. First, we establish the first comprehensive OMTG benchmark, introducing Count Accuracy (C-Acc) and Effective Temporal F1 (EtF1) as evaluation metrics. Second, we curate a high-quality OMTG dataset comprising 56k samples through a sophisticated construction pipeline. Third, we develop novel temporal and caption reward functions specifically designed for OMTG. In particular, the caption reward leverages Chain-of-Thought reasoning over dense video captions to explicitly guide policy optimization toward both preciseness and completeness. Extensive experiments show our model achieves a new state-of-the-art EtF1 of 43.65\% on OMTG Bench, outperforming Gemini 2.5 Pro and Seed-1.8 by 15.85\% and 15.61\%, respectively. Project Page: https://insomniaaac.github.io/OMTG/},
}

@misc{hao_fei_f7b95abe6db9,
  title = {Grounding is All You Need? Dual Temporal Grounding for Video Dialog},
  author = {You Qin and Wei Ji and Xinze Lan and Hao Fei and Xun Yang and Dan Guo and Roger Zimmermann and Lizi Liao},
  year = {2026},
  doi = {10.1109/TMM.2026.3668656},
  url = {https://arxiv.org/abs/2410.05767},
  howpublished = {IEEE Trans. Multim.},
  annotation = {中文辅助译名：您只需要接地吗？视频对话的双时间接地},
  abstract = {In the realm of video dialog response generation, the understanding of video content and the temporal nuances of conversation history are paramount. While a segment of current research leans heavily on large-scale pretrained visual-language models and often overlooks temporal dynamics, another delves deep into spatial-temporal relationships within videos but demands intricate object trajectory pre-extractions and sidelines dialog temporal dynamics. This paper introduces the Dual Temporal Grounding-enhanced Video Dialog model (DTGVD), strategically designed to merge the strengths of both dominant approaches. It emphasizes dual temporal relationships by predicting dialog turn-specific temporal regions, filtering video content accordingly, and grounding responses in both video and dialog contexts. One standout feature of DTGVD is its heightened attention to chronological interplay. By recognizing and acting upon the dependencies between different dialog turns, it captures more nuanced conversational dynamics. To further bolster the alignment between video and dialog temporal dynamics, we've implemented a list-wise contrastive learning strategy. Within this framework, accurately grounded turn-clip pairings are designated as positive samples, while less precise pairings are categorized as negative. This refined classification is then funneled into our holistic end-to-end response generation mechanism. Evaluations using AVSD@DSTC-7 and AVSD@DSTC-8 datasets underscore the superiorit},
}

@misc{hao_fei_7d4abc0921a0,
  title = {Evaluating and Mitigating Relationship Hallucinations in Large Vision-Language Models},
  author = {Mingrui Wu and Jiale Li and Jiayi Ji and Hao Fei and Xiaoshuai Sun and Rongrong Ji},
  year = {2026},
  doi = {10.1109/TPAMI.2026.3656175},
  url = {https://doi.org/10.1109/TPAMI.2026.3656175},
  howpublished = {IEEE Trans. Pattern Anal. Mach. Intell.},
  annotation = {中文辅助译名：评估和减轻大型视觉语言模型中的关系幻觉},
  abstract = {The issue of hallucinations is a prevalent concern in existing Large Vision-Language Models (LVLMs). Previous efforts have primarily focused on investigating object hallucinations, which can be easily alleviated by introducing object detectors. However, these efforts neglect hallucinations in inter-object relationships, essential for visual comprehension. In this work, we introduce R-Bench, a novel benchmark specifically designed to evaluate hallucinations in visual relationships. R-Bench includes both image-level questions to assess the existence of relationships and instance-level questions that probe deeper into local visual comprehension. Our analysis reveals that relationship hallucinations arise from three types of co-occurrences: relationship-relationship, subject-relationship, and relationship-object, exacerbated by the long-tail distribution in visual datasets. Moreover, LVLMs often ignore visual content, over-relying on common sense from language models, particularly in spatial reasoning tasks. We further demonstrate that region-level image-text alignment helps mitigate relationship hallucinations and propose a new baseline, Region-Aware Alignment Mitigation (RA$^2$2M), that enhances model attention to relevant regions, improving alignment between generated text and images.},
}

@misc{hao_fei_d5d6d3aa56ab05dc,
  title = {Spatial Causal Prediction in Video},
  author = {Yanguang Zhao and Jie Yang and Shengqiong Wu and Shutong Hu and Hongbo Qiu and Yu Wang and Guijia Zhang and Tan Kai Ze and Hao Fei and Chia-Wen Lin and Mong-Li Lee and Wynne Hsu},
  year = {2026},
  doi = {10.48550/ARXIV.2603.03944},
  url = {https://doi.org/10.48550/ARXIV.2603.03944},
  howpublished = {CoRR},
  annotation = {中文辅助译名：视频中的空间因果预测},
  abstract = {Spatial reasoning, the ability to understand spatial relations, causality, and dynamic evolution, is central to human intelligence and essential for real-world applications such as autonomous driving and robotics. Existing studies, however, primarily assess models on visible spatio-temporal understanding, overlooking their ability to infer unseen past or future spatial states. In this work, we introduce Spatial Causal Prediction (SCP), a new task paradigm that challenges models to reason beyond observation and predict spatial causal outcomes. We further construct SCP-Bench, a benchmark comprising 2,500 QA pairs across 1,181 videos spanning diverse viewpoints, scenes, and causal directions, to support systematic evaluation. Through comprehensive experiments on 23 state-of-the-art models, we reveal substantial gaps between human and model performance, limited temporal extrapolation, and weak causal grounding. We further analyze key factors influencing performance and propose perception-enhancement and reasoning-guided strategies toward advancing spatial causal intelligence. The project page is https://guangstrip.github.io/SCP-Bench.},
}

@misc{hao_fei_7d3dca677d85,
  title = {Taming Actor-Observer Asymmetry in Agents via Dialectical Alignment},
  author = {Association for Computational Linguistics 2026 and Hao Fei and Wynne Hsu and Zibo Ji and Mong-Li Lee and Bobo Li and Wu Rui and Min Zhang and Meishan Zhang},
  year = {2026},
  doi = {10.48550/ARXIV.2604.19548},
  url = {https://arxiv.org/abs/2604.19548},
  howpublished = {CoRR},
  annotation = {中文辅助译名：通过辩证对齐驯服智能体中的演员-观察者不对称性},
  abstract = {Large Language Model agents have rapidly evolved from static text generators into dynamic systems capable of executing complex autonomous workflows. To enhance reliability, multi-agent frameworks assigning specialized roles are increasingly adopted to enable self-reflection and mutual auditing. While such role-playing effectively leverages domain expert knowledge, we find it simultaneously induces a human-like cognitive bias known as Actor-Observer Asymmetry (AOA). Specifically, an agent acting as an actor (during self-reflection) tends to attribute failures to external factors, whereas an observer (during mutual auditing) attributes the same errors to internal faults. We quantify this using our new Ambiguous Failure Benchmark, which reveals that simply swapping perspectives triggers the AOA effect in over 20% of cases for most models. To tame this bias, we introduce ReTAS (Reasoning via Thesis-Antithesis-Synthesis), a model trained through dialectical alignment to enforce perspective-invariant reasoning. By integrating dialectical chain-of-thought with Group Relative Policy Optimization, ReTAS guides agents to synthesize conflicting viewpoints into an objective consensus. Experiments demonstrate that ReTAS effectively mitigates attribution inconsistency and significantly improves fault resolution rates in ambiguous scenarios.},
}

@misc{hao_fei_6335baf8463c,
  title = {Synergizing Understanding and Generation with Interleaved Analyzing-Drafting Thinking},
  author = {Shengqiong Wu and Bobo Li and Xinkai Wang and Xiangtai Li and Lei Cui and Furu Wei and Shuicheng Yan and Hao Fei* and Tat-Seng Chua},
  year = {2026},
  doi = {10.48550/ARXIV.2602.21435},
  url = {https://openreview.net/pdf?id=GtqmPJf00A},
  howpublished = {CoRR},
  annotation = {中文辅助译名：通过交错分析-绘图思维协同理解和生成},
  abstract = {Unified Vision-Language Models (UVLMs) aim to advance multimodal learning by supporting both understanding and generation within a single framework. However, existing approaches largely focus on architectural unification while overlooking the need for explicit interaction between the two capabilities during task solving. As a result, current models treat understanding and generation as parallel skills rather than synergistic processes. To achieve real synergy, we introduce the interleaved Analyzing-Drafting problem-solving loop (AD-Loop), a new think paradigm that dynamically alternates between analytic and drafting operations. By interleaving textual thoughts with visual thoughts, AD-Loop enables models to iteratively refine both comprehension and outputs, fostering genuine synergy. To train this mechanism, we design a two-stage strategy: supervised learning on interleaved thought data to initialize alternation, followed by reinforcement learning to promote adaptive and autonomous control. Extensive experiments demonstrate that AD-Loop consistently improves performance across standard benchmarks for both understanding and generation, with strong transferability to various UVLMs architectures. Visual analyses further validate the effectiveness of implicit visual thoughts. These results highlight AD-Loop as a principled and broadly applicable strategy for synergizing comprehension and creation. The project page is at https://sqwu.top/AD-Loop.},
}

@misc{hao_fei_555ad3b4fbd56228,
  title = {Reading, Writing, Sharing, and Interacting with the World through Video},
  author = {Shengqiong Wu and Meng Luo and Bobo Li and Ziwei Liu and Shuicheng Yan and Ming-Hsuan Yang and Philip H. S. Torr and Hao Fei},
  year = {2026},
  doi = {10.48550/arxiv.2610.31668},
  url = {https://arxiv.org/abs/2610.31668},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：通过视频阅读、写作、分享、与世界互动},
  abstract = {Video foundation models have advanced rapidly in understanding and generating visual sequences, while video world models seek to capture the underlying dynamics of the world they depict. Despite their different objectives, both concern the relationship between video observations and an evolving world. This survey adopts world modeling as a unifying lens for examining these developments. Viewing an observed video as a partial, lossy, and temporally ordered projection of a latent temporal world, we organize the literature around four complementary operations: reading infers world properties from observed video; writing synthesizes video from specified or learned world conditions; sharing integrates understanding and generation through common modeling mechanisms; and interacting predicts and updates world states under actions and evolving observations. This perspective distinguishes temporal coherence in observed or generated sequences from consistency in the underlying world state. Across tasks, representations, models, datasets, and benchmarks, we trace a shift in emphasis from clip-level recognition and perceptual fidelity toward persistent state, controllable evolution, physical and causal validity, and evaluation grounded in interaction and downstream decisions, and we distill the open challenges that follow.},
}

