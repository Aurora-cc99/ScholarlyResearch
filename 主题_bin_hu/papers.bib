@misc{bin_hu_d8854a394339,
  title = {SynPO: Synergizing Descriptiveness and Preference Optimization for Video Detailed Captioning},
  author = {Jisheng Dang and Yizhou Zhang and Hao Ye and Teng Wang and Siming Chen and Huicheng Zheng and Yulan Guo and Jianhuang Lai and Bin Hu},
  year = {2026},
  doi = {10.1109/tip.2026.3680029},
  url = {https://doi.org/10.1109/tip.2026.3680029},
  howpublished = {IEEE Transactions on Image Processing},
  annotation = {中文辅助译名：SynPO：协同视频详细描述性和偏好优化字幕},
  abstract = {Fine-grained video captioning aims to generate detailed, temporally coherent descriptions of video content. However, existing methods struggle to capture subtle video dynamics and rich detailed information. In this paper, we leverage preference learning to enhance the performance of vision-language models (VLM) in fine-grained video captioning, while mitigating several limitations inherent to Direct Preference Optimization (DPO). First, we propose a pipeline for constructing preference pairs that leverages the intrinsic properties of VLMs along with partial assistance from large language models, achieving an balance between cost and data quality. Then, we propose Synergistic Preference Optimization (SynPO), a novel optimization method offering significant advantages over DPO and its variants. SynPO prevents negative pReferences from dominating the training, explicitly preserves the model's language capability to avoid deviation of the optimization objective, thus obtains high-quality captions and improves training efficiency by eliminating the need for the reference model. We extensively evaluate our proposed data construction pipeline across three models: AuroraCap, LLaVA1.6-7B-Video and InterVL2-8B. Results demonstrate that our method improve performance in fine-grained video captioning significantly and consistenly. Source code is available at https://github.com/longmalongma/SynPO.},
}

@misc{bin_hu_5fe4b95b7400,
  title = {TF-LSNet: Lightweight Heart Sound Classification via Large-Small Receptive Field Modeling and Reinforced Distillation},
  author = {Xin Ma and Enze Li and Haojie Zhang and Kun Qian and Bin Hu and Bjorn W. Schuller},
  year = {2026},
  doi = {10.1109/jiot.2026.3736010},
  url = {https://doi.org/10.1109/jiot.2026.3736010},
  howpublished = {IEEE Internet of Things Journal},
  annotation = {中文辅助译名：TF-LSNet：通过大-小接受场建模和强化蒸馏进行轻量级心音分类},
  abstract = {This study aims to develop an accurate, ultra-lightweight, and practically deployable heart sound classification framework for heterogeneous mobile devices. We propose a Time-Frequency Large-Small Network (TF-LSNet) built on a Time-Frequency Large-Small Convolution (TF-LSConv), which decouples long-range contextual modeling from local feature aggregation. Two variants are designed for different resource budgets: Large-TF-LSNet for accuracy-oriented deployment and Small-TF-LSNet for highly constrained devices. To recover the accuracy lost through extreme compression, we further introduce Physiology-Aware Dual-Teacher Knowledge Distillation with Reinforcement Learning (PADKD-RL), which adaptively assigns sample-wise teacher weights using model-state and heart-sound physiological information. The models are evaluated on PhysioNet 2016, ZCHSound, a noise-corrupted PhysioNet set, and a cross-dataset benchmark, and are deployed in an Android application. Large-TF-LSNet contains only 47.7K parameters and requires 37.7M floating-point operations (FLOPs), achieving an accuracy of 93.19±1.52% and an unweighted average recall (UAR) of 93.37±1.34% on PhysioNet 2016 and 93.58±3.15 %/93.06±3.28% on the high-quality ZCHSound subset. With only 4.7K parameters and 8.9M FLOPs, PADKD-RL-enhanced Small-TF-LSNet achieves 93.36±1.76% accuracy and 92.49±1.46% UAR on PhysioNet 2016 while maintaining low on-device inference latency. These results demonstrate a favorable balance among classification p},
}

