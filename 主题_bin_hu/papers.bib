  title = {ADED: Method and Device for Automatically Detecting Early Depression Using Multimodal Physiological Signals Evoked and Perceived via Various Emotional Scenes in Virtual Reality},
  author = {Mi Li and Yanbo Chen and Zeying Lu and Fan Ding and Bin Hu},
  year = {2025},
  doi = {10.1109/tim.2025.3551439},
  url = {https://doi.org/10.1109/tim.2025.3551439},
  howpublished = {IEEE Transactions on Instrumentation and Measurement},
