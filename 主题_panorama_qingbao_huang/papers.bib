@misc{panorama_qingbao_huang_d21fb24245d1f674,
  title = {Look Around Before Locating: Considering Content and Structure Information for Visual Grounding},
  author = {Shiyi Zheng and Peizhi Zhao and Zhilong Zheng and Peihang He and Haonan Cheng and Yi Cai and Qingbao Huang},
  year = {2025},
  doi = {10.1609/AAAI.V39I2.32158},
