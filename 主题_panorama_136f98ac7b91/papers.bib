@misc{panorama_136f98ac7b91_f953b22e2f1c0c6f,
  title = {Network-aware Adaptive QoS Architecture for Video Delivery over Differentiated Service Network},
  author = {Yinglei Fan and Fang Su and Yong Li and Huimin Xu},
  year = {2006},
  doi = {10.1109/itst.2006.288893},
  url = {https://doi.org/10.1109/itst.2006.288893},
  howpublished = {International Conference on ITS Telecommunications},
  annotation = {中文辅助译名：用于通过差异化服务网络进行视频传输的网络感知自适应 QoS 架构},
  abstract = {In this paper we propose a network-aware adaptive quality-of-service (QoS) architecture for video delivery over differentiated service network. We leverage the characteristics of MPEG-4, Internet protocol (IP) differentiated service frameworks and effective bandwidth theory in this architecture. The proposed adaptive algorithm not only overcomes the shortcoming of besteffort network which can not provide the better protection of the more important frames but also solve the low bandwidth utility ratio problem of the existing Differentiated service network scheduling scheme. Simulation results demonstrate the performance is improved distinctly in terms of the peak signal to noise ratio (PSNR) of the video in the receivers and the network throughput.},
}

@misc{panorama_136f98ac7b91_cdc358cb6d8ad755,
