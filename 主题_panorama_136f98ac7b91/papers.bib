@misc{panorama_136f98ac7b91_2588511cbfbc5d0a,
  title = {An effective scheme for population protocols to solve uniform partition problems},
  author = {Qianfei Mao and Jia Lee and Yong Li and Teijiro Isokawa},
  year = {2025},
  doi = {10.1080/17445760.2025.2553291},
  url = {https://doi.org/10.1080/17445760.2025.2553291},
  howpublished = {International Journal of Parallel Emergent and Distributed Systems},
  annotation = {中文辅助译名：解决均匀划分问题的群体协议的有效方案},
  abstract = {This paper introduces an efficient and scalable model within the population protocol framework to address the fundamental problem of uniform partitioning in distributed computing. Using transient fluctuations, our protocol can significantly reduce the spatial complexity of the model, in which each agent assumes only 2k states and 3k rules, a substantial improvement over previous work. Numerical experiments and theoretical analyses based on absorbing Markov chains show that our protocol is not only more space efficient but can also achieve superior time efficiency, with intense fluctuations surprisingly accelerating convergence.},
}

@misc{panorama_136f98ac7b91_402eee68ce516650,
  title = {Learning Distinctive Feature Representation for Descriptors on Multimodal Images by Incorporating Multiple Negative Samples},
  author = {Bohan Li and Yixuan Li and Yong Li and Guohan Zhang},
  year = {2025},
  doi = {10.1109/jstars.2025.3576821},
  url = {https://doi.org/10.1109/jstars.2025.3576821},
  howpublished = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
  annotation = {中文辅助译名：通过合并多个负样本来学习多模态图像上描述符的独特特征表示},
  abstract = {This paper proposes a method composed of a loss function and a feature extractor structure, to learn the distinctive feature representation (DIFR) for descriptors on multimodal images. The distinctiveness of the feature representation plays a key role in matching keypoints, and has drawn a lot of research attention. In the past, many methods were proposed that either employed handcrafted features or deep neural networks to learn the feature representation. However, the incorrect ratio of built keypoint matches still remains high due to the insufficient distinctiveness of the associated descriptors. To address this problem, this work designs a new contrastive loss function that for the first time incorporates multiple negative descriptors from both the reference image and the test image, to constrain the networks to learn the distinctive feature representation for descriptors. To further enable the descriptors to encode more global information, we design RestExtractor, a novel CNN-Transformer structure that effectively adapts the self-attention mechanism to the feature learning for multimodal images. In the RestExtractor, we design a gated-v block and a receptive field enhanced feed-forward network for extracting distinctive modal-shared feature representation. We evaluated the proposed method on two challenging multimodal image datasets, VIS-SAR and VIS-IR. The experimental results showed that the proposed DIFR significantly improved the number of correct keypoint matches ove},
}

@misc{panorama_136f98ac7b91_1a5780ba4dcbd14a,
  title = {Channel Estimation for Massive MIMO Systems via Polarized Self-Attention-Aided Channel Estimation Neural Network},
  author = {Shuo Yang and Yong Li and Lizhe Liu and Jing Xia and Bin Wang and Xingjian Li},
  year = {2025},
  doi = {10.3390/e27030220},
  url = {https://doi.org/10.3390/e27030220},
  howpublished = {Entropy},
  annotation = {中文辅助译名：通过极化自注意力辅助信道估计神经网络进行大规模 MIMO 系统的信道估计},
  abstract = {Research on deep learning (DL)-based channel estimation for massive multiple-input multiple-output (MIMO) communication systems has attracted considerable interest in recent years. In this paper, we propose a DL-assisted channel estimation algorithm that transforms the original channel estimation problem into an image denoising problem, contrasting it with traditional experience-based channel estimation methods. We establish a new polarized self-attention-aided channel estimation neural network (PACE-Net) to achieve efficient channel estimation. This approach addresses the limitations of the conventional methods, particularly their low accuracy and high computational complexity. In addition, we construct a channel dataset to facilitate the training and testing of PACE-Net. The simulation results show that the proposed DL-assisted channel estimation algorithm has better normalization mean square error (NMSE) performance compared with the traditional algorithms and other DL-assisted algorithms. Furthermore, the computational complexity of the proposed DL-assisted algorithm is significantly lower than that of the traditional minimum mean square error (MMSE) channel estimation algorithm.},
}

@misc{panorama_136f98ac7b91_f4e1a829c768d35a,
  title = {Structure-prior Informed Diffusion Model for Graph Source Localization with Limited Data},
  author = {Hongyi Chen and Jingtao Ding and Xiaojun Liang and Yong Li and Xiao-Ping Steven Zhang},
  year = {2025},
  doi = {10.1145/3746252.3761146},
  url = {https://doi.org/10.1145/3746252.3761146},
  howpublished = {ACM International Conference on Information and Knowledge Management (CIKM)},
  annotation = {中文辅助译名：有限数据下图源定位的结构先验信息扩散模型},
  abstract = {Source localization in graph information propagation is essential for mitigating network disruptions, including misinformation spread, cyber threats, and infrastructure failures. Existing deep generative approaches face significant challenges in real-world applications due to limited propagation data availability. We present SIDSL (Structure-prior Informed Diffusion model for Source Localization), a generative diffusion framework that leverages topology-aware priors to enable robust source localization with limited data. SIDSL addresses three key challenges: unknown propagation patterns through structure-based source estimations via graph label propagation, complex topology-propagation relationships via a propagation-enhanced conditional denoiser with GNN-parameterized label propagation module, and class imbalance through structure-prior biased diffusion initialization. By learning pattern-invariant features from synthetic data generated by established propagation models, SIDSL enables effective knowledge transfer to real-world scenarios. Experimental evaluation on four real-world datasets demonstrates superior performance with 7.5-13.3% F1 score improvements over baselines, including over 19% improvement in few-shot and 40% in zero-shot settings, validating the framework's effectiveness for practical source localization. Our code can be found here (https://github.com/tsinghua-fib-lab/SIDSL).},
}

@misc{panorama_136f98ac7b91_0f5b9eb205dfb014,
  title = {DPAD: Distribution-Driven Perturbation-Adaptive Defense for UAV Time-Series Regression Under Hybrid Adversarial Attacks},
  author = {Bo Xu and Zhiqiang Liu and Zhongjun Dong and Kaiqi Huang and Xiaopeng Huang and Haolin Zhu and Jun Chao Wei and Yong Li and Yan Zhang and Xiuping Li},
  year = {2025},
  doi = {10.3390/drones9120828},
  url = {https://doi.org/10.3390/drones9120828},
  howpublished = {Drones},
  annotation = {中文辅助译名：DPAD：混合对抗攻击下无人机时间序列回归的分布驱动扰动自适应防御},
  abstract = {Time-series regression models are essential components in unmanned aerial vehicles (UAVs) for accurate trajectory and state prediction. Nevertheless, they are still vulnerable to hybrid adversarial attacks, which can lead to a compromised mission performance and cause huge economic loss. For this challenge, we propose the Distribution-driven Perturbation-Adaptive Defense (DPAD) framework. DPAD improves perturbation detection with Gaussian Mixture Model (GMM)-based feature augmentation that raises the accuracy of perturbation strength prediction, increasing from 0.685 to 0.943 R2, and dynamically chooses a suitable defense sub-model or the original model for adaptive correction. The experiments on UAV_Delivery show that DPAD significantly enhances robustness by achieving about 80% reduction in prediction errors under hybrid attacks while maintaining high accuracy on clean samples with an inference speed of 2.744 ms per sample. The proposed framework can scale up an effective solution to defend UAV time-series regression models against complex adversarial scenarios.},
}

@misc{panorama_136f98ac7b91_a20d6c9ec4c481d2,
  title = {DualCascadeTSF-MobileNetV2: A Lightweight Violence Behavior Recognition Model},
  author = {Yuang Chen and Yong Li and Shaohua Li and Shuhan Lv and Fang Lin},
  year = {2025},
  doi = {10.3390/app15073862},
  url = {https://doi.org/10.3390/app15073862},
  howpublished = {Applied Sciences},
  annotation = {中文辅助译名：DualCascadeTSF-MobileNetV2：轻量级暴力行为识别模型},
  abstract = {This paper proposes a lightweight violent behavior recognition model, DualCascadeTSF-MobileNetV2, which is improved based on the temporal shift module and its subsequent research. By introducing the Dual Cascade Temporal Shift and Fusion module, the model further enhances the feature correlation ability in the time dimension and solves the problem of information sparsity caused by multiple temporal shifts. Meanwhile, the model incorporates the efficient lightweight structure of MobileNetV2, significantly reducing the number of parameters and computational complexity. Experiments were conducted on three public violent behavior datasets, Crowd Violence, RWF-2000, and Hockey Fights, to verify the performance of the model. The results show that it outperforms other classic models in terms of accuracy, computational speed, and memory size, especially among lightweight models. This research continues and expands on the previous achievements in the fields of TSM and lightweight network design, providing a new solution for real-time violent behavior recognition on edge devices.},
}

@misc{panorama_136f98ac7b91_81d50adacf60144c,
  title = {SAG-Net: Spectrum Adaptive Gate Network for Learning Feature Representation From Multispectral Imagery},
  author = {Yong Li and Bohan Li and Zhongqun Chen and Yixuan Li and Guohan Zhang},
  year = {2025},
  doi = {10.1109/lgrs.2025.3535635},
  url = {https://doi.org/10.1109/lgrs.2025.3535635},
  howpublished = {IEEE Geoscience and Remote Sensing Letters},
  annotation = {中文辅助译名：SAG-Net：用于从多光谱图像学习特征表示的光谱自适应门网络},
  abstract = {Feature representation plays a key role in matching keypoints, especially for the multispectral images of large spectral difference. On such image pairs, existing methods typically use the two images only, but it is challenging to directly learn spectrum-invariant feature representation due to the complex nonlinear distortion between them. To address this issue, this letter proposes using intermediate-band images to facilitate learning spectrum-invariant feature representation. For this purpose, this work designs a spectrum adaptive gate network (SAG-Net) that consists of a SPectral gate (SPeG) module and a deep feature extractor. The SPeG module selectively activates the spectrum-invariant features according to input image content on-the-fly. It hence allows for training on the images of over two bands simultaneously with a single network without the need of an individual branch per band. To investigate the SPeG module, we also constructed a Landsat 9 Multi-Spectral Images (L9-MSI) dataset including 3167 scenes of aligned images across five spectral bands (visible, B5, B6, B7, and B10) from the Landsat 9 imagery. The experimental results demonstrate the SPeG module can learn common feature representation for varying-band images, and the intermediate B5, B6, and B7 images are useful for the SAG-Net to learn the common feature between visible and B10. On the L9-MSI dataset, the SAG-Net significantly improved the number of correct matches and the matching score (MS). Our datase},
}

@misc{panorama_136f98ac7b91_d34d3166976d94e5,
  title = {The Research and Design of Self-Diagnostic Function for NPP I&C System},
  author = {Yong Li and Gen-Hua Liang and Ke Zhong and Debiao Chen and Xuanlin Zhu and Hanyang Zheng and Cifu Xie and Daqi Chen},
  year = {2024},
  doi = {10.1109/phm-beijing63284.2024.10874814},
  url = {https://doi.org/10.1109/phm-beijing63284.2024.10874814},
  howpublished = {Global Reliability and Prognostics and Health Management Conference (PHM)},
  annotation = {中文辅助译名：核电厂仪表控制系统自诊断功能的研究与设计},
  abstract = {Self-diagnosis is one of the most efficacious approaches to enhancing and ensuring the reliability of NPP I&C (Nuclear Power Plant Instrumentation & Control) systems. According to the requirements of IEC 61508 on self-diagnosis, a self-diagnosis design scheme for NPP I&C system is proposed in this paper. Firstly, the overall fault analysis of the NPP I&C system is carried out to identify the potential faults and derive the fault types to be diagnosed. Secondly, in the level of fault diagnosis design, the static and dynamic combination diagnosis design mechanism, the specific diagnosis design for different fault types is implemented, including the CPU core diagnosis design of LoongArch (loong architecture), and the diagnosis framework design suitable for multi-service scenarios are proposed. Finally, at the level of fault handling and warning, the design mechanism of the equipment's fault handling state transition, the system's data-oriented safety output, the fault bit information arrangement, and the local and network warning are proposed. This paper provides a systematic and detailed design scheme for the self-diagnosis of NPP I&C system, which can effectively improve the reliability of the system itself.},
}

@misc{panorama_136f98ac7b91_f65caa81b0b4dd02,
  title = {Multi-Robot Formation Obstacle Avoidance Based on Virtual Robots and Improved Artificial Potential Fields},
  author = {Yong Li and Liaoning Chai and Chao Wu},
  year = {2024},
  doi = {10.1109/cac63892.2024.10864998},
  url = {https://doi.org/10.1109/cac63892.2024.10864998},
  howpublished = {China Automation Congress (CAC)},
  annotation = {中文辅助译名：基于虚拟机器人和改进人工势场的多机器人编队避障},
  abstract = {Aiming at the problem of multi-robot formation control to avoid obstacles, a formation obstacle avoidance algorithm based on virtual robot layer and improved artificial potential field is proposed. First, for information management, a member management mechanism based on the virtual swarm head is designed to realize information sharing and navigator designation. Second, the artificial potential field method is improved to establish the internal potential field of robots and the potential field of obstacles to ensure the obstacle avoidance of multiple robots in the formation process and the collision avoidance among members; finally, simulation experiments are designed, and it is finally proved that the method can effectively solve the obstacle avoidance and collision avoidance problems of the multi-robot system in the formation process.},
}

@misc{panorama_136f98ac7b91_60fa8d15c6c1ea8f,
  title = {Classification and Identification of Frequency-Hopping Signals Based on Jacobi Salient Map for Adversarial Sample Attack Approach},
  author = {Yanhan Zhu and Yong Li and Tianyi Wei},
  year = {2024},
  doi = {10.3390/s24217070},
  url = {https://doi.org/10.3390/s24217070},
  howpublished = {Sensors},
  annotation = {中文辅助译名：基于雅可比显着图的对抗样本攻击方法跳频信号分类识别},
  abstract = {Frequency-hopping (FH) communication adversarial research is a key area in modern electronic countermeasures. To address the challenge posed by interfering parties that use deep neural networks (DNNs) to classify and identify multiple intercepted FH signals-enabling targeted interference and degrading communication performance-this paper presents a batch feature point targetless adversarial sample generation method based on the Jacobi saliency map (BPNT-JSMA). This method builds on the traditional JSMA to generate feature saliency maps, selects the top 8% of salient feature points in batches for perturbation, and increases the perturbation limit to restrict the extreme values of single-point perturbations. Experimental results in a white-box environment show that, compared with the traditional JSMA method, BPNT-JSMA not only maintains a high attack success rate but also enhances attack efficiency and improves the stealthiness of the adversarial samples.},
}

@misc{panorama_136f98ac7b91_af6c410fca024d68,
  title = {Joint Resource Allocation and Trajectory Planning for UAV-Assisted ISAC Systems with Distinct QoSs},
  author = {Kaigui Liu and Chunjing Hu and Yongqing Xu and Yong Li},
  year = {2024},
  doi = {10.1145/3708657.3708668},
  url = {https://doi.org/10.1145/3708657.3708668},
  howpublished = {International Conference on Communication and Information Processing (ICCIP)},
  annotation = {中文辅助译名：具有不同 QoS 的无人机辅助 ISAC 系统的联合资源分配和轨迹规划},
  abstract = {Integrated sensing and communication (ISAC) has received considerable attention from both industry and academia.Nevertheless, the fixed-position base stations (BSs) limit the ISAC capabilities when facing the asymmetric requirements between the sensing and the communication.The unmanned aerial vehicle (UAV)-assisted ISAC systems using UAVs as the BSs enable the ISAC technology to satisfy the requirements of both the sensing and the communication by jointly optimizing the UAV resource and trajectory.Therefore, we consider a UAV-assisted ISAC system, where a UAV simultaneously serves three types of users, namely the sensingonly targets, the communication-only users, and the ISAC users, respectively.To obtain the state information of the sensing targets in advance, we establish a closed-loop extended Kalman filtering (EKF) tracking scheme.Based on the state information (e.g., the horizontal location) obtained by the target tracking scheme, we formulate an optimization problem to maximize the weighted sum of the sensing and the communication quality of services (QoSs) of the multi-type users by jointly optimizing the transmit power, the available bandwidth, and the UAV trajectory in real-time.To tackle the formulated non-convex optimization problem, we propose an alternative optimization (AO) algorithm based on the successive convex approximation (SCA) method.Simulation results validate the reliability of the proposed target tracking scheme and reveal a more flexible trade-off be},
}

