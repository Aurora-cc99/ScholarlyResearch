@misc{panorama_136f98ac7b91_55079499e78c367a,
  title = {Spectrally-Efficient Sensing Using Fractional OFDM Symbols: Transceiver Design and Performance Evaluation},
  author = {Yuming Zhang and Yongqing Xu and Yong Li},
  year = {2024},
  doi = {10.1145/3708657.3708699},
  url = {https://doi.org/10.1145/3708657.3708699},
  howpublished = {International Conference on Communication and Information Processing (ICCIP)},
  annotation = {中文辅助译名：使用分数 OFDM 符号的频谱效率感知：收发器设计和性能评估},
  abstract = {The orthogonal frequency division multiplexing (OFDM) waveform is a promising candidate for integrated sensing and communications (ISAC).In typical OFDM-based ISAC systems, time division multiplexing (TDM) is implemented for flexible resource allocation between sensing and communication.However, this approach severely limits the residual time-domain resources available for sensing while maintaining communication throughput.To address this issue, we utilize a fractional OFDM symbol-based waveform that exploits sparse modulation periodicity to create a periodic waveform, replacing repetitive parts with zero-power signals.This enables the temporal overlap of multiple symbols, forming a consecutive frame structure and reducing effective waveform duration to a fraction of a standard OFDM symbol.However, this duration reduction compromises orthogonality.To mitigate energy leakage from adjacent subcarriers, we introduce a post-filling algorithm to restore modulation sparsity.Additionally, since the fractional symbols abandon the cyclic prefix (CP) to improve spectral efficiency, their resistance to inter-symbol interference (ISI) caused by multipath is impaired.To combat multipath interference, we propose a signal processing algorithm for fractional symbol demodulation that mimics the CP protection of standard CP-OFDM symbols.We evaluate the performance of the proposed design through mathematical analysis and simulation, demonstrating that the proposed design can achieve the same ra},
}

@misc{panorama_136f98ac7b91_59a8f307da14d5c8,
  title = {Human Action Recognition Using Dual-Stream Neural Networks with FMCW Radar},
  author = {Yuqing Wu and Yong Li and Wei Cheng and Guangyu Lei},
  year = {2024},
  doi = {10.1109/icsidp62679.2024.10868895},
  url = {https://doi.org/10.1109/icsidp62679.2024.10868895},
  howpublished = {IEEE International Conference on Signal, Information and Data Processing (ICSIDP)},
  annotation = {中文辅助译名：使用双流神经网络和 FMCW 雷达进行人体动作识别},
  abstract = {This paper presents a approach to human action recognition utilizing FMCW radar. We propose a method that extracts range-time and velocity-time features from radar echoes and processes them using a dual-stream neural network for action classification. The improved Constant False Alarm Rate (CFAR) detection algorithm, combined with a Shape Profile Constraint - Feature Map (SPC-FM) generation method, significantly enhances feature extraction by removing noise. Experimental results demonstrate an average classification accuracy of 96.4% across six common actions, showcasing the method’s robustness for applications in various domains, including medical monitoring and autonomous vehicle systems.},
}

@misc{panorama_136f98ac7b91_b221fd73beeb317b,
  title = {AOHDL: Adversarial Optimized Hybrid Deep Learning Design for Preventing Attack in Radar Target Detection},
  author = {Muhammad Moin Akhtar and Yong Li and Wei Cheng and Limeng Dong and Yumei Tan and Langhuan Geng},
  year = {2024},
  doi = {10.3390/rs16163109},
  url = {https://doi.org/10.3390/rs16163109},
  howpublished = {Remote Sensing},
  annotation = {中文辅助译名：AOHDL：用于防止雷达目标检测中的攻击的对抗性优化混合深度学习设计},
  abstract = {In autonomous driving, Frequency-Modulated Continuous-Wave (FMCW) radar has gained widespread acceptance for target detection due to its resilience and dependability under diverse weather and illumination circumstances. Although deep learning radar target identification models have seen fast improvement, there is a lack of research on their susceptibility to adversarial attacks. Various spoofing attack techniques have been suggested to target radar sensors by deliberately sending certain signals through specialized devices. In this paper, we proposed a new adversarial deep learning network for spoofing attacks in radar target detection (RTD). Multi-level adversarial attack prevention using deep learning is designed for the coherence pulse deep feature map from DAALnet and Range-Doppler (RD) map from TDDLnet. After the discrimination of the attack, optimization of hybrid deep learning (OHDL) integrated with enhanced PSO is used to predict the range and velocity of the target. Simulations are performed to evaluate the sensitivity of AOHDL for different radar environment configurations. RMSE of AOHDL is almost the same as OHDL without attack conditions and it outperforms the earlier RTD implementations.},
}

