@misc{panorama_d7c7a21d0e0c_766d4c58b1eb594d,
  title = {A new dataset and method for comprehensive evaluation of visual design elements in educational slides},
  author = {Xinning Du and Qiwen Liang and Jianping Ren and Ming Fang and Shuhua Liu},
  year = {2025},
  doi = {10.1145/3743093.3770982},
  url = {https://doi.org/10.1145/3743093.3770982},
  howpublished = {ACM International Conference on Multimedia in Asia (MMAsia)},
  annotation = {中文辅助译名：教育幻灯片中视觉设计元素综合评价的新数据集和方法},
  abstract = {As a modern teaching method, the interface design quality of teaching courseware has a significant impact on teaching effectiveness. However, the absence of standardized datasets and evaluation frameworks presents significant challenges for the quantitative assessment of slide visual design quality. To address this gap, we introduce Vis-TCA, a large-scale benchmark dataset for evaluating the visual design quality of educational slides. Vis-TCA aims to systematically assess the layout regularity and visual design rationality of multiple visual elements in slides. This dataset includes 40144 middle school courseware images with four visual elements, that is, title, text, table, and image. Furthermore, for the text element, this paper defines 269 fine-grained textual visual attributes, such as font, size, and color. On this basis, we propose Educational Slide Assessment Model (ESAM), a novel model designed for evaluating the visual quality of educational slides. ESAM is trained using a multi-task joint learning strategy and incorporates a plug-and-play Adaptive Correlation Fusion Module (ACFM) to enhance the model’s ability to understand and process diverse visual elements and their fine-grained attributes. Experimental results demonstrate that ESAM can effectively assess the visual design quality of slides, providing a robust technical foundation for automated analysis and intelligent feedback in slide visual presentation.},
}

@misc{panorama_d7c7a21d0e0c_2cefdc3eaec6993a,
