  abstract = {New thrust bearing with space surfaceoil wedge structure was developed. The New material usedfor the bearing was introduced. The Special surface coating was made for improving the bearing capacity and wearresistance, and extending the service life. The number ofcomponets for the bearing is reduced by more than 70%.Application results show that the new bearings are good inboth reliability and durability.},
}

@misc{panorama_d7c7a21d0e0c_a8e5d4eb223e3896,
  title = {Study of Mixed-signal crosstalk in 3-D package},
  author = {Shuhua Liu and Liqiang Cao and Jun Li and Yunyan Zhou and Jing Hua Zhou and Qidong Wang and Fengwei Dai and Lixi Wan and Daniel Guidotti},
  year = {2010},
  doi = {10.1109/icept.2010.5583791},
  url = {https://doi.org/10.1109/icept.2010.5583791},
  howpublished = {International Conference on Electronic Packaging Technology (ICEPT)},
  annotation = {中文辅助译名：3D 封装中混合信号串扰的研究},
  abstract = {With the development of miniaturization, multi-function, environmental protection and other aspects of electronic products, high-density integration technology such as System-on-Chip (SOC) and System-in-Package (SIP) technology has developed rapidly. Mixed-signal integrity in multi-chip integration packages is a main issue. To meet the demand for high-density, 3-D chip stacking is one solution to reduce size and increase the integration. In this paper, three methods are implemented and contrasted: (1) sweep the stack sequence of RF chip and digital chip; (2) investigate the crosstalk with or without adding shielding layer to the stacked dies; (3) investigate the crosstalk with varying the density of ground points on the shielding.},
}

@misc{panorama_d7c7a21d0e0c_d4f1c8869ed862d8,
