  abstract = {Through creating human body size database and bicycle parts inventory,based on the characteristics of sport bicycle frame and ergonomic principle of human engineering,the authors designs computerized parameters for framing bicycles.The paper explores a design method to make the frame suit different body size and actualize the ideal of people-first,tailor-made.},
}

@misc{panorama_d7c7a21d0e0c_ef074833798b6202,
  title = {Power integrity simulation for multilayer power distribution networks based on GTLE and via model},
  author = {Yunyan Zhou and Lixi Wan and Shuhua Liu and Liqiang Cao and Jia Jia},
  year = {2011},
  doi = {10.1109/icept.2011.6066895},
  url = {https://doi.org/10.1109/icept.2011.6066895},
  howpublished = {International Conference on Electronic Packaging Technology (ICEPT)},
  annotation = {中文辅助译名：基于GTLE和过孔模型的多层配电网络电源完整性仿真},
  abstract = {In high-speed applications, electronic packages usually contain multilayer power-ground planes with large number of P-G vias to provide a low-impedance path for the power distribution system between the PCB and the die. The transient current injected into the P-G planes can induce unintentional voltage fluctuations in the power distribution network of the packages. The undesired voltage fluctuations can be significant even for the packages with solid P-G planes due to the return currents of switching input/output lines. A major problem arising in power distribution networks is simultaneous switching noise (SSN) which is induced by the power and ground inductance. This paper presents a numerical approach that combines the 2D generalized transmission line equations (GTLE) method and multi-layer finite-difference frequency-domain (FDFD) method to model and analyze the two-dimensional electromagnetic problem arising in multilayered power distribution planes. The results of our analysis method are compared to those from a full-wave simulator to show efficiency in power integrity simulation.},
}

@misc{panorama_d7c7a21d0e0c_b26cac617a8d49b9,
  title = {A Kind of Sub-pixel Adjustment Method of Grid Characters Thickness},
  author = {Shuhua Liu},
  year = {2011},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=PYSB201102009},
  howpublished = {China Printing and Packaging Study},
  annotation = {中文辅助译名：一种网格字符粗细的亚像素调整方法},
  abstract = {In order to ensure printing quality of text content in grid image,it is necessary to adjust the thickness of characters in the pre-press.In this paper,a sub-pixel adjustment method was presented based on analysis of characters' neighborhood pixel information to control the scope and direction of the adjustment.With the new method,grid character image was considered as a combined result of a foreground character layer and a background image layer.By performing the steps of separating characters from background,calculating ink density of each pixel of characters,adjusting each pixel's ink density by analysis of neighborhood stroke shape,the result was achieved which could simulate the effects performed by vector methods. The method can be adapted to global or any certain direction(e.g.vertical,horizontal,diagonal,etc) thickness adjustment. Experimental results show that the method can achieve excellent results and is proved to be very practical.},
}

@misc{panorama_d7c7a21d0e0c_e648b2fb5d395f29,
