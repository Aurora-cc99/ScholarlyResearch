  author = {Min Li and Lanbo Zhao and Xue Zhou and Kailu Zhang and Panyue Yin and Shuhua Liu and Yuliang Zou and Qiling Li},
  year = {2021},
  url = {https://europepmc.org/article/MED/33520359},
  howpublished = {American Journal of Cancer Research},
  annotation = {中文辅助译名：浆液性渗出液中癌的检测：综述},
  abstract = {A malignant serous effusion is one of the most common complications of advanced tumors, indicating a poor prognosis and having a profound impact on diagnosis, treatment, and prognosis. It is of great significance to identify benign and malignant effusions quickly and accurately. Both cellular and non-cellular components in the effusion can be employed for detection, diagnostic methods are necessary to obtain a definite diagnosis and more relevant information such as tumor classification. In this review, we focus on the comparison of several widespread cytological preparation methods, enrichment technology of exfoliated cells, and present tests for serous effusions, mainly including routine and special stains, immunocytochemistry, electron microscopy, enzyme-linked immunosorbent assay, flow cytometry, and molecular analysis.},
}

