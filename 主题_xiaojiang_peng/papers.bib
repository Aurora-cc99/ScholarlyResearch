@misc{xiaojiang_peng_2ff5d36aaf426b74,
  title = {Learning Discriminative Representation For Facial Expression Recognition From Uncertainties},
  author = {Xiaojiang Peng and Zhongying Deng and Xingyu Fan and Kai Wang and Yu Qiao},
  year = {2020},
  doi = {10.1109/ICIP40778.2020.9190643},
  url = {https://doi.org/10.1109/ICIP40778.2020.9190643},
  howpublished = {ICIP},
  annotation = {中文辅助译名：从不确定性中学习面部表情识别的判别表示},
  abstract = {Recent progresses on Facial Expression Recognition (FER) heavily rely on deep learning models trained with large scale datasets. However, large-scale facial expression datasets always suffer from annotation uncertainties caused by ambiguous expressions, low-quality facial images, and the subjectiveness of annotators, which limits FER performance. To address this challenge, this paper introduces novel Rayleigh and weighted-softmax loss from two aspects. First, we propose Rayleigh loss to extract discriminative representation, which aims at minimizing within-class distances and maximizing inter-class distances simultaneously. Moreover, Rayleigh loss has a Euclidean form which make it easily be optimized with SGD and be combined with other forms. Second, we introduce a weight to measure the uncertainty of a given sample, by considering its distance to class center. Extensive experiments on RAF-DB, FERPlus and AffectNet show the effectiveness of our method with SOTA performance.},
}

