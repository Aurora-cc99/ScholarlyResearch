  year = {2025},
  doi = {10.48550/ARXIV.2510.20279},
  url = {https://doi.org/10.48550/ARXIV.2510.20279},
  howpublished = {CoRR},
  annotation = {中文辅助译名：ResearchGPT：端到端计算机科学研究工作流程的大语言模型基准测试和培训},
  abstract = {Large language models (LLMs) are increasingly being used to support computer science research. To contribute reliably, these systems must be able to work with information distributed across research papers and across different aspects of the research process. However, large-scale resources that systematically organize such information into structured supervision for both model evaluation and post-training remain limited. To address this gap, we propose a systematic paper-to-QA construction pipeline that organizes information from AI research papers into structured QA pairs supported by source evidence. Using this pipeline, we construct CS-54k, a 54k-pair corpus derived from 14,474 openly licensed AI research papers. The corpus covers eight recurring paper components, including research domain, prior work, existing challenges, motivation, findings and assumptions, methods, experimental settings, and experimental results. We further derive two complementary subsets: CS-4k, a benchmark for evaluating LLMs on paper-derived research QA, and CS-50k, a companion corpus for post-training. Extensive evaluations on CS-4k reveal substantial performance differences across existing LLMs and paper components, with experimental settings and results remaining particularly challenging. Moreover, post-training on CS-50k substantially improves Qwen2.5-7B-Instruct on CS-4k, demonstrating the practical utility of structured, paper-derived supervision. Together, CS-4k and CS-50k provide a unified },
}

@misc{xiaojiang_peng_fa7084e49d693650,
  title = {SmokeSAM: Vehicle Black Smoke Segmentation Based on SAM and LoRA Fine-Tuning},
  author = {Zeyu Dong and Qing Li and Chuan Yan and Xiaojiang Peng},
