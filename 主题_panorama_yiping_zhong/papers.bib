@misc{panorama_yiping_zhong_77c1fbb6e5463368,
  title = {Effects of working memory span training on top-down attentional asymmetry at both neural and behavioral levels},
  author = {Yang Li and Xiongying Chen and Qiumei Zhang and Wending Xu and Jin Li and Feng Ji and Qi Dong and Chuansheng Chen and Jun Li},
  year = {2023},
  doi = {10.1093/cercor/bhac472},
  url = {https://doi.org/10.1093/cercor/bhac472},
  howpublished = {Cerebral Cortex},
  annotation = {中文辅助译名：工作记忆广度训练对神经和行为层面自上而下注意力不对称的影响},
  abstract = {The leftward asymmetry of the visual field and posterior brain regions, a feature of the normal attention process, can be strengthened by brain stimulation, e.g. administering alpha frequency stimulation to the left posterior cortex. However, whether it can be strengthened by cognitive training, especially with nonlateralized tasks, is unknown. We used a dataset from a 2-month-long randomized controlled trial and compared the control group with 2 training groups trained with backward or forward memory span tasks. A lateralized change detection task with varied memory loads was administered as the pre-, mid-, and post-tests with simultaneous electroencephalographic recording. Intrasubject response variability (IRV) and the alpha modulation index (MI) were calculated. Analysis of IRV showed more enhanced leftward attentional bias in the backward group than in the other groups. Consistently, analysis of MI found that its enhancements in the left hemisphere (but not the right hemisphere) of the backward group were significantly higher than those of the other groups. Further analysis revealed that left MI changes predicted left IRV improvement. All of these results indicated that backward memory span training enhanced leftward attentional asymmetry at both the behavioral and neural levels.},
}

