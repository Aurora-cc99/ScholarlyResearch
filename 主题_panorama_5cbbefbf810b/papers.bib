@misc{panorama_5cbbefbf810b_e2f095cb9a7c9f2d,
  title = {A feature extraction method based on optimized frame algorithm in speech recognition},
  author = {Ying Sun and Xueying Zhang},
  year = {2007},
  doi = {10.1049/cp:20070126},
  url = {https://doi.org/10.1049/cp:20070126},
  howpublished = {IET Conference on Wireless, Mobile and Sensor Networks (CCWMSN)},
  annotation = {中文辅助译名：语音识别中基于优化帧算法的特征提取方法},
  abstract = {This paper used optimized frame algorithm in noise-robust feature extraction of speech recognition and introduced a feature extraction method based on optimized frame algorithm. The method of calculating the sample numbers of observation window in ZCPA feature extraction was proposed by studying the length of frame and human auditory characteristic. This paper also discussed the effect of using different frame in ZCPA feature extraction in detail. The RBF neural net was used in training and recognition course. The results showed that new feature has higher recognition rate and better robustness than traditional feature.},
}
