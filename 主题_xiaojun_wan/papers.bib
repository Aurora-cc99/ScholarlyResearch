@misc{xiaojun_wan_59f729a147d75942,
  title = {AMRec: An Intelligent System for Academic Method Recommendation},
  author = {Xiaojun Wan and Xuewei Tang and Shanshan Huang},
  year = {2013},
  doi = {10.48550/arxiv.1904.04995},
  url = {http://arxiv.org/abs/1904.04995},
  howpublished = {AAAI (Late-Breaking Developments)},
  annotation = {中文辅助译名：AMRec：学术方法推荐的智能系统},
  abstract = {Finding new academic Methods for research problems is the key task in a researcher's research career. It is usually very difficult for new researchers to find good Methods for their research problems since they lack of research experiences. In order to help researchers carry out their researches in a more convenient way, we describe a novel recommendation system called AMRec to recommend new academic Methods for research problems in this paper. Our proposed system first extracts academic concepts (Tasks and Methods) and their relations from academic literatures, and then leverages the regularized matrix factorization Method for academic Method recommendation. Preliminary evaluation results verify the effectiveness of our proposed system.},
}

@misc{xiaojun_wan_dccff924f3cc2564,
  title = {PPSGen: Learning to Generate Presentation Slides for Academic Papers},
  author = {Xiaojun Wan and Yue Hu},
  year = {2013},
  url = {http://dblp.uni-trier.de/db/conf/ijcai/ijcai2013.html#HuW13},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：PPSGen：学习为学术论文生成演示幻灯片},
  abstract = {In this paper, we investigate a very challenging task of automatically generating presentation slides for academic papers. The generated presentation slides can be used as drafts to help the presenters prepare their formal slides in a quicker way. A novel system called PPSGen is proposed to address this task. It first employs regression methods to learn the importance of the sentences in an academic paper, and then exploits the integer linear programming (ILP) method to generate well-structured slides by selecting and aligning key phrases and sentences. Evaluation results on a test set of 200 pairs of papers and slides collected on the web demonstrate that our proposed PPSGen system can generate slides with better quality. A user study is also illustrated to show that PPSGen has a few evident advantages over baseline methods.},
}

@misc{rui_yan_ruc_40d1bbf578daedad,
  title = {Hierarchical Graph Summarization: Leveraging Hybrid Information through Visible and Invisible Linkage},
  author = {Xiaojun Wan and Yan Zhang and Rui Yan and Xiaoming Li and Zi Yuan},
  year = {2012},
  doi = {10.1007/978-3-642-30220-6_9},
