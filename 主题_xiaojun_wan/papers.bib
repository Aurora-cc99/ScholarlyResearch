}

@misc{xiaojun_wan_48aafe041945eeee,
  title = {Content Based Image Retrieval Using Manifold-Ranking of Blocks},
  author = {Xiaojun Wan},
  year = {2007},
  doi = {10.1109/ICME.2007.4285117},
  url = {https://doi.org/10.1109/ICME.2007.4285117},
  howpublished = {ICME},
  annotation = {中文辅助译名：使用块流形排序的基于内容的图像检索},
  abstract = {CBIR has been a challenging problem and we propose to extend the manifold-ranking based image retrieval method by using image block instead of the whole image as the unit in the manifold-ranking process. The retrieval score of each image is a fusion of the obtained ranking scores of the blocks in the image. The proposed approach can make full use of the intrinsic global manifold structure for the blocks of the images in the re-ranking process. Experimental results demonstrate that the proposed approach can significantly improve the retrieval performance. Image block is validated to be a better unit than the whole image in the manifold-ranking process.},
}

@misc{xiaojun_wan_f600b107ce1c1e40,
  title = {Learning information diffusion process on the web},
  author = {Xiaojun Wan and Jianwu Yang},
  year = {2007},
  doi = {10.1145/1242572.1242751},
  url = {https://doi.org/10.1145/1242572.1242751},
  howpublished = {WWW},
  annotation = {中文辅助译名：学习网络信息传播过程},
  abstract = {Many text documents on the Web are not originally created but forwarded or copied from other source documents. The phenomenon of document forwarding or transmission between various web sites is denoted as Web information diffusion. This paper focuses on mining information diffusion processes for specific topics on the Web. A novel system called LIDPW is proposed to address this problem using matching learning techniques. The source site and source document of each document are identified and the diffusion process composed of a sequence of diffusion relationships is visually presented to users. The effectiveness of LIDPW is validated on a real data set. A preliminary user study is performed and the results show that LIDPW does benefit users to monitor the information diffusion process of a specific topic, and aid them to discover the diffusion start and diffusion center of the topic.},
}

