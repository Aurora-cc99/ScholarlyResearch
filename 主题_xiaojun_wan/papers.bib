@misc{xiaojun_wan_5ee6b3eab0434c5c,
  title = {FactNLI: Dynamic and Automated Fact-Based Augmentation of NLI Benchmarks},
  author = {Yihan Lu and Junzhe Zhang and Huixuan Zhang and Xiaojun Wan},
  year = {2026},
  doi = {10.18653/2026.findings-emnlp.1234},
  url = {https://doi.org/10.18653/2026.findings-emnlp.1234},
  howpublished = {Findings of the Association for Computational Linguistics: EMNLP (Findings of EMNLP)},
  annotation = {中文辅助译名：FactNLI：基于事实的动态和自动化的 NLI 基准增强},
  abstract = {Natural Language Inference (NLI) is a core task for language understanding, yet existing NLI datasets are static and increasingly saturated, making it difficult to diagnose model robustness in semantically enriched contexts.We propose FactNLI 1 , a dynamic and automated framework that constructs more challenging NLI instances by iteratively fusing retrieved facts into the premise and hypothesis.A truthset and graph-based filter removes contradictory and redundant candidates before fusion.Applied to SNLI and MNLI, FactNLI substantially increases input length and factual density, and accuracy drops consistently across a range of models (up to 30%).Length-controlled ablations show that this degradation is not explained by length or generic extra text alone, while human audits confirm high, though not perfect, label preservation and overall data quality.},
}

