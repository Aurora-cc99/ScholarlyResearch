  annotation = {中文辅助译名：学生视角下职业教育吸引力案例研究},
  abstract = {A case study was carried out on a vocational school student who failed in higher education enrollment examina- tion and selected vocational schools, and the outcome show that, the attractiveness of vocational education are limited and the objects of vocational education are limited. Based on the reality problem of bad cultural basis, lack of confidence and bad discipline of vocational school students, vocational schools should persist in the education model different from general high school, pay attention to teaching as well as personality education, care for the growth of every student and every aspect of student growth, take the education of bad performance students as the starting point for enhancing attractiveness of vocational education.},
}

@misc{panorama_2c1b5a1f24eb_6364cca2fbc38989,
  title = {Key detection through pitch class distribution model and ANN},
  author = {Jiayin Sun and Haifeng Li and Lei Li},
  year = {2009},
  doi = {10.1109/icdsp.2009.5201119},
  url = {https://doi.org/10.1109/icdsp.2009.5201119},
  howpublished = {IEEE International Conference on Digital Signal Processing (DSP)},
  annotation = {中文辅助译名：通过音级分布模型和 ANN 进行基调检测},
  abstract = {Being one of the most well-known high-level music content concepts, music key reveals an important theoretical feature for Western music in music structure analysis, music note and chord transcription and music mood comprehension. Key finding becomes a main task of music information retrieval (MIR). In this paper, we propose a novel approach with good robustness to detect keys in polyphonic music based on Artificial Neural Network (ANN). Constant Q transform (CQT) is firstly applied to music signal for CQT spectrum analysis. Then onset detection and pitch tuning are introduced in order to ensure a high robustness. Finally a distribution matrix is generated as music key feature. Considering the classifier, a neural network is applied to model the pitch class distribution and complete the task of key recognition. Experiments showed that the proposed strategy can reach a good performance in polyphonic music at a relatively lower computational cost, and proved our strategy to be quite promising.},
}

