@misc{panorama_2c1b5a1f24eb_7c8814e480178355,
  title = {A Mobile Learning System for learning Mandarin Pronunciation},
  author = {Long Zhang and Jianhua Wang and Haifeng Li},
  year = {2011},
  doi = {10.1109/iccsnt.2011.6182034},
  url = {https://doi.org/10.1109/iccsnt.2011.6182034},
  howpublished = {International Conference on Computer Science and Network Technology (ICCSNT)},
  annotation = {中文辅助译名：学习普通话发音的移动学习系统},
  abstract = {Based on speech recognition technology and wireless communication technology, a novel mobile learning system for learning Mandarin pronunciation is built. It likes an excellent human teacher to help learners improve their pronunciation quality and has the following good features: intelligence, interaction, and convenience. After training the standard acoustic model, the system can recognize the learner's speech and then calculate the accuracy rate of the pronunciation. Compared the practical pronunciation with the standard pronunciation, the system can accurately detect the defects and errors of the learner's pronunciation, and locate its position and type. Combined the phonetics knowledge and expert knowledge, the system also can give a concrete pronunciation diagnosis, and make reasonable suggestions and correction methods. Finally, Using intelligent search techniques, adaptive training materials can be automatically generated and reinforcement learning will be performed.},
}

@misc{panorama_2c1b5a1f24eb_0cbb1731c946fed5,
  title = {A music key detection method based on pitch class distribution theory},
  author = {Sun Jiayin and Haifeng Li and Lin Ma},
  year = {2011},
  doi = {10.3233/kes-2011-0219},
  url = {https://doi.org/10.3233/kes-2011-0219},
  howpublished = {International Journal of Knowledge-based and Intelligent Engineering Systems},
  annotation = {中文辅助译名：一种基于音级分布理论的音乐调检测方法},
  abstract = {As one of the most well-known music elements, music key, which reveals an important feature in music transcription, structure analysis and mood comprehension, is always an essential theoretical construct of music. As a result, key finding is becoming a popular topic of Music Information Retrieval ( MIR). In this paper, we propose a novel approach with good robustness to detect keys in polyphonic music from a view of pitch class distribution theory. A signal transformation with musical representation-Constant Q transform (CQT) is firstly applied to music audio for spectrum analysis. Then onset detection and pitch tuning are introduced in order to ensure robustness. Finally, a weighted harmonic structure pattern-pitch class distribution matrix (PCDM) is extracted as feature for key classification. PCDM contains both pitch class information and chord structure, and it is based on pitch class distribution view. Considering the classifier, a neural network is applied to model the pitch class distribution and complete the task of key recognition. Also, a key smoothing method makes proposed method capable of processing modulation and reducing key fluctuation. Experiments showed that the proposed strategy can reach a good performance in polyphonic music at a relatively lower computational cost, and proved our strategy to be quite promising.},
}

@misc{panorama_2c1b5a1f24eb_e8f2a378a8dde7c0,
