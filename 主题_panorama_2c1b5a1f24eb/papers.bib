@misc{panorama_2c1b5a1f24eb_cc9fa819ee4e70e1,
  title = {An Ensemble Pipeline for Four-Class Imagined Handwriting Trajectory Classification from Synchronized EEG-fNIRS Signals},
  author = {G.C. Wang and Wenchao Liu and Zhouyang Xu and H. Zhu and Congshan Sun and Hongwei Li and Cong Xu and Haifeng Li},
  year = {2026},
  doi = {10.1145/3767308.3838621},
  url = {https://doi.org/10.1145/3767308.3838621},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：用于根据同步 EEG-fNIRS 信号进行四类想象手写轨迹分类的集成管道},
  abstract = {We present our solution to the ACM Multimedia 2026 Grand Challenge on Multimodal Brain-Computer Interfaces: EEG-fNIRS based Handwriting-Trajectory Classification. The task is four-class classification of imagined logographic handwriting trajectories from synchronized 27-channel electroencephalography (EEG) and 8-channel functional near-infrared spectroscopy (fNIRS) recordings, evaluated subject-independently on 10 held-out subjects (3,238 trials). Our pipeline combines two frozen pretrained EEG Transformers (EEGPT-CCA and EEGPT-SA, two variants of EEGPT with different encoder attention scope) with multi-window heads, together with five lightweight models trained from scratch (EEGNet, MI-EEGNet, EEGNeX, EEG-ITNet, CTNet), forming a seven-branch ensemble. The ensemble is refined by three calibration stages: CCA-disagreement-boost weighted fusion, fNIRS quality logit scaling, and per-session Sinkhorn-Knopp entropic optimal transport (OT) calibration that exploits the publicly documented balanced session structure. On the private test set our system achieves 0.80097 classification accuracy, ranking 2nd out of 9 valid submissions. Ablation shows the three calibration stages contribute a cumulative +3.34pp cross-validated accuracy over the uncalibrated ensemble (0.7922 \to 0.8256), with Sinkhorn OT contributing +0.14pp in the full pipeline (+1.14pp on a controlled single-branch ablation); the public leaderboard accuracy of the final system is 0.84465. All training uses only the off},
}

@misc{panorama_2c1b5a1f24eb_ae5ef139dddfb45e,
  title = {ScaleSpecter: a frequency-aware multi-scale patch framework for robust physiological classification under non-stationarity},
  author = {Xu zhouyang and Hongwei Li and Wenchao Liu and Li Haifeng},
  year = {2026},
  doi = {10.3389/fnhum.2026.1856803},
  url = {https://doi.org/10.3389/fnhum.2026.1856803},
  howpublished = {Frontiers in Human Neuroscience},
  annotation = {中文辅助译名：ScaleSpecter：一种频率感知的多尺度补丁框架，用于非平稳性下的稳健生理分类},
  abstract = {Introduction: Early detection and intervention for cognitive impairment associated with neurodegenerative diseases are important for slowing disease progression and improving quality of life. Electroencephalography provides high temporal resolution and sensitivity to neural oscillations, making it a promising tool for early disease identification. However, weak and transient pathological abnormalities are often obscured by diffuse, non-stationary low-frequency background rhythms, making robust feature extraction challenging. Methods: We propose ScaleSpecter, a frequency-aware multiscale patch framework for neurodegenerative disease-related EEG classification. ScaleSpecter first constructs temporal representations at multiple scales to jointly capture transient local abnormalities and long-term rhythmic variations. A lightweight cross-scale attention mechanism then enables interaction between fine-grained temporal tokens and coarse scale-level summaries. Finally, an amplitude-phase-aware spectral modulation module uses learnable complex-valued weights to recalibrate spectral responses and provide frequency-domain guidance for temporal feature aggregation. Results: Extensive experiments were conducted on three public EEG datasets: the Alzheimer's Disease and Frontotemporal Dementia (ADFTD) dataset, the Alzheimer's Patients' Relatives Association of Valladolid (APAVA) dataset, and the Two Decades-Brainclinics Research Archive for Insights in Neurophysiology (TDBRAIN) database. T},
}

@misc{panorama_2c1b5a1f24eb_92b2252fd5b93120,
  title = {Experimental Frequency-Comb-Based Mode-Pairing Quantum Key Distribution Beyond the Rate-Loss Limit},
  author = {Yifei Lu and Yan-Yang Zhou and Yuyao Guo and X. L. Li and Xiao‐Lei Jiang and Yang Wang and Yu Zhou and Jia-Ji Li and Chun Hua Zhou and Hongwei Li and Linjie Zhou and Wan‐Su Bao},
  year = {2025},
  doi = {10.48550/arxiv.2505.09223},
  url = {http://arxiv.org/abs/2505.09223},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：超出速率损失限制的实验性基于频率梳的模式配对量子密钥分配},
  abstract = {Mode-pairing quantum key distribution (MP-QKD) offers significant potential for long-distance secure communication, benefiting from its quadratic scaling capacity and phase compensation-free characteristic. However, MP-QKD still requires stringent wavelength consistency between remote lasers, which is impractical with commercial lasers without locking. In this work, we develop a simple optical-frequency-comb-based MP-QKD system to simultaneously establish coherence and distribute keys with free-running commercial lasers. We implement the experiment over standard single-mode fiber with a loss coefficient of 0.2 dB/km. The system achieves finite-size secret key rates (SKRs) of 561.26, 113.59, and 10.20 bits per second over 303.37, 354.62, and 404.25 km, which are 1.0267, 2.5230, and 2.1033 times of the rate-loss limit. Besides, the SKR over 202.31 km is 8695.34 bits per second, which is sufficient to support practical cryptographic applications. These results validate the practicality and robustness of our method, offering a simplified yet high-performance framework for long-distance secure communication.},
}

@misc{panorama_2c1b5a1f24eb_0ca8a7291b5c3fcf,
  title = {Adjustment Algorithm for Free Station Control Network of Ultra-Large Deepwater Jacket},
  author = {Xianyang Yang and Wei Shu and Huoping Wang and Haifeng Li and Yi Wang and Di Zhang and Jiayu Liu and Deyang Wang and Wangsui Xiao},
  year = {2025},
  doi = {10.3390/a18050292},
  url = {https://doi.org/10.3390/a18050292},
  howpublished = {Algorithms},
  annotation = {中文辅助译名：超大型深水导管架自由站控制网调整算法},
  abstract = {The offshore oil engineering jacket is a giant super-heavy steel frame structure with dimensions in the hundreds of meters. A high-precision free station control network is usually arranged around it to ensure construction accuracy. However, as the jacket is gradually assembled, its extreme weight will cause the widespread deformation of the surrounding ground surface, and each control point may be affected to varying degrees, resulting in the non-uniform deformation of the entire network. For adjustments of control networks in the subsequent phases, if the same starting point as the first phase is chosen without careful analysis, the starting points’ non-uniform deformation will degrade the whole network’s accuracy. Considering the particularities of the free station control network, this paper proposes an adjustment algorithm consisting of a three-step analytical method. Firstly, the initial coordinates of the points of the current phase are obtained through classical free network adjustment; second, stable and unstable points are identified via coordinate similarity transformation between the current and the first phase; and finally, quasi-stable adjustment is conducted. The experimental data analysis of a jacket control network shows that this method can effectively identify stable and unstable points, thereby ensuring construction accuracy and jacket stability.},
}

@misc{panorama_2c1b5a1f24eb_1c0cd4879076,
  title = {Synthesizing intelligible utterances from EEG of imagined speech},
  author = {Wenjing Xiong and Lin Ma and Haifeng Li},
  year = {2025},
  doi = {10.3389/fnins.2025.1565848},
  url = {https://doi.org/10.3389/fnins.2025.1565848},
  howpublished = {Frontiers in Neuroscience},
  annotation = {中文辅助译名：从想象的言语的脑电图合成可理解的话语.. Front Neurosci},
  abstract = {Decoding natural language directly from neural activity is of great interest to people with limited communication means. Being a non-invasive and convenient approach, the electroencephalogram (EEG) offers better portability and wider application potentiality. We present an EEG-to-speech system (ETS) that synthesizes audible, and highly understandable language by EEG of imagined speech. Our ETS applies a specially designed X-shape deep neural network (DNN) to realize an End-to-End correspondence between imagined speech EEG and the speech. The system innovatively incorporates dynamic time warping into the network's training process, using actual speech EEG data as a bridge to temporally align imagined speech EEG signals with speech signals. The ETS performance was evaluated on 13 participants who pretraining four Chinese disyllabic words. These words cover all four tones and 40% of the phonemes in Chinese. Our synthesized utterances' average accuracy across all subjects was 91.23%, the average MOS value was 3.50, and the best accuracy was 99% with an MOS value of 3.99. Furthermore, a partial feedback mechanism for DNN and spectral subtraction-based speech enhancement are introduced to improve the quality of generated speech. Our findings prove that non-invasive approaches can be a significant step in regaining verbal language ability.},
}

