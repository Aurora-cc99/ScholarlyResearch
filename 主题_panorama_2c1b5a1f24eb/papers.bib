@misc{panorama_2c1b5a1f24eb_b9e5a31569d2393c,
  title = {Experiential Teaching based on Living Lab: A study on the telecommunication service experience},
  author = {Ying Peng and LU Zi-fang and Jing Wang and Jianqin Xu and Hongwei Li},
