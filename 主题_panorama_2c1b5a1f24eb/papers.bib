  annotation = {中文辅助译名：多国、多文化、多学科联合培养软件工程+X硕士项目},
  abstract = {Facing the challenge of the new globalization tendency of international industry especially the IT and software industry, universities keep make great efforts to provide the so-called T-Shape people to fulfill the demand of industry. This paper introduces a novel joint Master programme which aims at establishing an international education system and platform. It offers for education in software engineering plus a special familiarity in an application domain such as services in enterprises, production engineering, information technology, computer network systems, etc. Students graduate from this programme, will be equipped with multi-ability in multi-discipline, familiar with multiple cultures and traditions, and with studying and working experiences in multiple countries. The schema, the characteristics, the execution principles are discussed wishing to share our practice and experience with our education colleagues.},
}

@misc{panorama_2c1b5a1f24eb_86533dca7001c0e5,
