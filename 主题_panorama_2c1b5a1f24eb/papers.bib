  annotation = {中文辅助译名：高校双语教育发展趋势——基于北京七所高校的调查},
  abstract = {The survey about bilingual education of seven colleges and universities in Beijing shows:Overall,the goal of bilingual education made by the Ministry of Education did not achieve,but bilingual education in colleges and universities has achieved some success.Bilingual education in colleges and universities have a good public opinion basis;The quality of teachers,foreign language level of students,learning interest are important factors for taking bilingual education.Teacher quality of bilingual education is too low,poor foundation of students' foreign language is too weak,and their interests in learning are not strong,there are differences between different students and different colleges and universities.It suggests that colleges and universities should adjust the goal of bilingual education according to the principle of seeking truth from facts,requiring students by classifi cation,and promote bilingual education with the principle of respecting the wishes,developing step-by-step,promoting the professional development .},
}

@misc{panorama_2c1b5a1f24eb_84a4571794ba9bd6,
