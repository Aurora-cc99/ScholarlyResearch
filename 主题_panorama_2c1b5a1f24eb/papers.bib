}

@misc{panorama_2c1b5a1f24eb_963b82d08a167dbb,
  title = {Two-Dimensional Frequency Estimation in Correlative Noise Based on Genetic Algorithm},
  author = {Sunyong Wu and Hongwei Li and Qiutiao Xue},
  year = {2006},
  doi = {10.1109/wcica.2006.1712994},
  url = {https://doi.org/10.1109/wcica.2006.1712994},
