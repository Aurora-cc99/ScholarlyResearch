@misc{panorama_2c1b5a1f24eb_c2373086dd7ad403,
  title = {Mixed Models Based Pronunciation Evaluation of Mandarin Tone},
  author = {Long Zhang and Haifeng Li and Lin Ma and Jianhua Wang and Wei Zhang},
  year = {2013},
  doi = {10.4304/jmm.8.6.726-731},
  url = {https://doi.org/10.4304/jmm.8.6.726-731},
  howpublished = {Journal of Multimedia},
  annotation = {中文辅助译名：基于混合模型的普通话声调发音评价},
  abstract = {Under the framework of traditional pronunciation evaluation system, we try to extract discrete and continuous fundamental frequency features by different methods, use the fundamental frequency features respectively at the speech frame level and syllable level to set up embedded tone models, explicit tone models and their mixed models for the pronunciation evaluation of Mandarin tone, and then compare the influence of different methods and models on the evaluation performance. The results show that the performance of mixed models is the best. The average score error rate (ASER) of mixed models is 0.249 with a relative 29.66% reduction in contrast with the baseline system.},
}

@misc{panorama_2c1b5a1f24eb_2258e1f851fd6b03,
  title = {A microstructure evolution visualization method based on neutrosophic set theory and cellular automaton technique},
  author = {Haifeng Li and Dayi Yang and Yangyang Fu and Hujie Huang and Hongyuan Fang},
  year = {2013},
  doi = {10.1145/2493102.2493106},
  url = {https://doi.org/10.1145/2493102.2493106},
  howpublished = {International Symposium on Visual Information Communication and Interaction (VINCI)},
  annotation = {中文辅助译名：基于中智集合论和元胞自动机技术的微观结构演化可视化方法},
  abstract = {The visualization of complex physical processes is becoming a challenging topic in fields of information visualization, and attracting more and more researchers. Microstructure evolution visualization (MEV) has become an important and unsubstitutable method in the modern material processing engineering domains. A novel MEV approach combining the neutrosophic set theory (NS) and the cellular automaton technique (CA) is developed in order to precisely simulate the invisible, complex and unrepeatable physical process of metal solidification. The NS theory is applied to realize the complex evolution rules among three phases including solid phase, liquid phase and interface phase, while the CA method is used to simulate the dynamic process of dendrite growth. Experiment results of the dendrite growing simulation show strange consistency of the virtual invisible microstructure with that in practical industrial trials and production. Material experts also convince the statistical characteristics of the simulation results and further the inspirational value for the visualization of other complex physical processes.},
}

@misc{panorama_2c1b5a1f24eb_5713009ac01d32f6,
