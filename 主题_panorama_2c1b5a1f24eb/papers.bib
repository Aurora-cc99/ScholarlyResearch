@misc{panorama_2c1b5a1f24eb_3ffb4bf881d9c962,
  title = {Spatio-Temporal Modeling For Air Quality Prediction Based On Spectral Graph Convolutional Network And Attention Mechanism},
  author = {Yiyi Song and Hongyan Mao and Hongwei Li},
  year = {2022},
  doi = {10.1109/ijcnn55064.2022.9891881},
  url = {https://doi.org/10.1109/ijcnn55064.2022.9891881},
  howpublished = {International Joint Conference on Neural Networks (IJCNN)},
  annotation = {中文辅助译名：基于谱图卷积网络和注意力机制的空气质量预测时空建模},
  abstract = {Air quality prediction is always an urgent and challenging issue due to the diffusivity and anelasticity of air pollutants. Temporal and spatial dependency, as influencing factors, have progressively represented a significant portion in the forecast of constant change-making air pollution. Nevertheless, the existing hybrid models, such as GC-LSTM, fully connected-LSTM, disregard the long-distance spatial dependence and the distinction of weights at various timesteps. For avoiding these limitations, we propose a novel air quality prediction model to process spatiotemporal dependency. In detail, a spatial adjacency graph structure based on correlations of air monitoring stations is constructed, and then spectral graph convolution with 2nd-order Chebyshev polynomial is well designed. This spatial module can capture the impacts from remote stations. Attention mechanism with LSTM is utilized for capturing temporal dependency with the inputs of spatial features from spatial module and node features. This model is applied on the hourly scaled dataset consisting of spatiotemporal factors, air pollutant concentrations, and meteorological factors at 12 air quality monitoring stations in Shanghai. To evaluate our prediction effects, a large number of comparative experiments are implemented in various preset time windows based on 5 metrics. The results illustrate that our model achieves higher accuracy than other compared models in both the short and long term. Furthermore, in exceptiona},
}

