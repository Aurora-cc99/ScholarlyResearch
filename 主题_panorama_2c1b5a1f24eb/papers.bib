  author = {Liangwen Wang and Feng Zhao and Wenliao Du and Guofu Luo and Fannian Meng and Hongwei Li},
  year = {2016},
  doi = {10.12783/dtssehs/icaem2016/4310},
  url = {https://doi.org/10.12783/dtssehs/icaem2016/4310},
