@misc{zhen_hua_ling_1f59cc8246395f56,
  title = {PACodec: A Low-bitrate Neural Speech Codec with Parallel Additive Vector Quantization},
  author = {Yang Ai and Fei Liu and Xiao-Hang Jiang and Zhen-Hua Ling},
  year = {2026},
  doi = {10.48550/ARXIV.2609.03363},
  url = {https://doi.org/10.48550/ARXIV.2609.03363},
  howpublished = {CoRR},
  annotation = {中文辅助译名：PACodec：具有并行加法矢量量化的低比特率神经语音编解码器},
  abstract = {This paper proposes PACodec, a novel low-bitrate neural speech codec based on parallel additive vector quantization (PAVQ). Unlike the mainstream residual vector quantization (RVQ) used in most neural speech codecs, where vector quantizers (VQs) are sequentially dependent, the PAVQ strategy adopted in PACodec aggregates parallel quantization results to optimize bitrate usage. Specifically, the PAVQ adopts a "global-local-global" (GLG) design: the global encoded features are quantized in parallel by multiple independent VQs, each attending to a local component of the representation, and their outputs are aggregated through addition to yield the final global quantization result for decoding. Experimental results show that PACodec, as each VQ focuses only on local information, supports smaller codebooks and reduces bitrate by 30% compared with baselines at the same decoding quality, with only minor model complexity. Further analysis shows that, owing to the GLG framework of PAVQ, the proposed PACodec is disentanglement-friendly, and each independent VQ captures different aspects of speech, e.g., content, timbre, and acoustic details, suggesting potential for application to downstream tasks such as voice conversion.},
}

@misc{zhen_hua_ling_4f5ca979d5988289,
  title = {QE-XVC: Zero-Shot Cross-Lingual Voice Conversion via Query-Enhancement and Conditional Flow Matching},
  author = {郭汉杰 GUO Han-jie and Hui-Peng Du and Shi-Ming Wang and Xiao-Hang Jiang and Ying-Ying Gao and Shi-Lei Zhang and Zhen-Hua Ling},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11460747},
  url = {https://doi.org/10.1109/icassp55912.2026.11460747},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：QE-XVC：通过查询增强和条件流匹配进行零样本跨语言语音转换},
  abstract = {Voice conversion (VC) aims to modify the speaker identity of speech while preserving its linguistic content. Cross-lingual voice conversion (XVC) further enables converting speech between speakers of different languages. Existing zero-shot XVC methods often struggle with pronunciation errors, insufficient speaker modeling or the difficulty of aligning source and target across languages. In this paper, we propose QE-XVC, an efficient zero-shot XVC method with query-enhancement and conditional flow matching (CFM). Specifically, we designed a query-enhancement module in which the speaker embeddings from a speaker verification (SV) model and the content representation are successively used as queries to enhance the frame-level speaker representations extracted by wavelet convolutions. The CFM model then generates converted acoustic features conditioned on both the content and the fine-grained speaker representations, which are subsequently transformed into waveforms by a vocoder. Experimental results demonstrate that, QE-XVC reduces potential pronunciation errors without introducing any quantization or clustering operations, while also improving prosody preservation from the source speaker.},
}

@misc{zhen_hua_ling_cc43bc173c5c5057,
  title = {REAL: Reward Modeling through Evidence-Linked Analysis of Lifelikeness in Generated Speech},
  author = {Yaodong Song and Jie Lian and Xusheng Yang and 赵根良 and Hongjie Chen and Jian Kang and Zhen-Hua Ling and Jie Li and Yongxiang Li},
  year = {2026},
  doi = {10.48550/arxiv.2611.12406},
  url = {https://arxiv.org/abs/2611.12406},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：REAL：通过对生成语音的逼真度进行循证分析来进行奖励建模},
  abstract = {As modern text-to-speech systems become increasingly intelligible and natural, evaluation is shifting from detecting gross synthesis failures to identifying subtle departures from lifelike human delivery. Because large-scale listening tests are costly and slow, speech reward models can serve as scalable automatic judges for comparing generated utterances, curating data, and supporting iterative TTS development. Existing speech reward models can predict scores or pairwise preferences and may generate natural-language rationales, but their supervision is typically defined at the utterance or pair level. The connection between local acoustic phenomena and the final preference therefore remains implicit. We introduce REAL, a framework for Reward modeling through Evidence-linked Analysis of Lifelikeness in generated speech. Its central idea is to supervise not only the final pairwise preference but also a structured account of its supporting observations, linking local audio spans to perceptual phenomena, affected dimensions, and the overall judgment. Specifically, REAL-Jury constructs these evidence-linked reports through timestamp alignment, multi-model analysis, and dispute-oriented deliberation. REAL-Judge learns to generate them from paired audio inputs. REAL-Eval assesses preference prediction in two tiers, from salient perceptual differences to subtle distinctions among strong TTS systems. Instantiated with MiMo-Audio, REAL-Judge improves pairwise preference accuracy over i},
}

@misc{zhen_hua_ling_bc081a551584023b,
  title = {ReCE: Rule-Retrieval Augmented Generation for Zero-shot and Few-shot Cybersecurity Event Extraction},
  author = {Xi Xiao and Yanjun Li and Zhen-Hua Ling and Zhengpeng Zha},
  year = {2026},
  doi = {10.1145/3804601.3804641},
  url = {https://doi.org/10.1145/3804601.3804641},
  howpublished = {International Conference on Computer, Artificial Intelligence and Control Engineering (CAICE)},
  annotation = {中文辅助译名：ReCE：用于零样本和少样本网络安全事件提取的规则检索增强生成},
  abstract = {Cybersecurity event extraction is a task that automatically identifies and categorizes key actions and their participants from plain text in cybersecurity field, which is crucial for threat intelligence analysis but severely hampered by the scarcity of annotated data. Existing methods face a dilemma that training-based approaches are data intensive and expensive, while training-free methods using Large Language Models (LLMs) often lack the domain-specific knowledge needed for high accuracy. We argue that instead of solely relying on an LLM’s internal knowledge, the key is to provide it with explicit, task-relevant rules at inference time. To realize this, we propose ReCE, a Rule-retrieval augmented generation framework for Cybersecurity event Extraction. It first uses a powerful model (GPT-4o) to generate a database of high-quality extraction rules, then retrieves the most relevant rules for any given text and provides them as actionable guidance to a smaller LLM (LLaMA3-8B-Instruct) to perform the final extraction. Experiments show that ReCE outperforms existing training-free baselines and achieves a balance of high performance and low resource requirements, thus providing a highly effective and practical method in data-scarce domains.},
}

@misc{zhen_hua_ling_25c5f7775ffa3c89,
  title = {REINS: Refusal-Enhanced Inhibitory Steering with Sparse Autoencoder Features},
  author = {Jiaqi Wang and Hao-Xiang Xu and Kai-Xuan Ding and Zi-Qi Chen and Ji-Hua Peng and Zhen-Hua Ling},
  year = {2026},
  doi = {10.48550/ARXIV.2608.28233},
  url = {https://doi.org/10.48550/ARXIV.2608.28233},
  howpublished = {CoRR},
  annotation = {中文辅助译名：REINS：具有稀疏自动编码器功能的拒绝增强型抑制转向},
  abstract = {Steering with Sparse Autoencoders (SAEs) offers a lightweight inference-time path for adapting the behavior of large language models without retraining.By exposing sparse and interpretable features, SAE steering provides a promising interface for safety control that guides harmful continuations toward refusal.However, we observe that complex wrappers can still undermine existing SAE steering methods on harmful prompts.To evaluate this failure mode systematically, we construct Generalized Undercover Instruction Safety Evaluation (GUISE), a dataset of harmful prompts with complex wrappers.Existing single direction SAE steering methods do not reliably produce refusals on harmful prompts, suggesting that refusal enhancement alone can be too weak when the harmful continuation path remains active.This motivates us to propose Refusal-Enhanced INhibitory Steering (REINS), which suppresses harmful continuation features and enhances safe refusal features in the same SAE feature space.Experiments on GUISE and other datasets show that prior methods either intervene too weakly or achieve only apparent safety through collapse, while REINS substantially reduces harmful responses, markedly improves safe refusals and largely preserves general capabilities.The dataset and code are publicly available at https://github.com/Geralt1020/REINS.},
}

@misc{zhen_hua_ling_7bc4a2d26ec7ce94,
  title = {StreamWSR: Streamable and Lightweight Waveform-Domain Neural Speech Super-Resolution},
  author = {Yuan Tian and Yang Ai and Hui-Peng Du and Zhen-Hua Ling},
  year = {2026},
  doi = {10.48550/arxiv.2609.03381},
  url = {https://arxiv.org/abs/2609.03381},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：StreamWSR：可流式传输的轻量级波形域神经语音超分辨率},
  abstract = {This paper proposes StreamWSR, a Streamable neural Waveform-domain model for speech Super-Resolution (SR). By adopting a fully causal architecture with compact frame-level waveform representation, the proposed StreamWSR supports zero-look-ahead streaming inference while avoiding vocoder-based reconstruction and explicit phase prediction. Specifically, StreamWSR downsamples the input waveform into a compact frame-level representation using strided causal convolutions. Then, a lightweight causal long-short-term modeling backbone is employed to capture both local waveform structures and long-range historical dependencies under causal constraints. Finally, the modeled output is converted back to the waveform domain through a causal transposed-convolution and combined with the input waveform via a residual connection to generate the final high-resolution speech. Experimental results on 16 kHz speech SR show that StreamWSR achieves competitive or superior speech quality and intelligibility compared with representative waveform- and spectrum-based baselines, while maintaining a zero-look-ahead streaming advantage with only 9M parameters and 2G FLOPs.},
}

