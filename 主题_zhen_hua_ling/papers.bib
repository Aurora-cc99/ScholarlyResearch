@misc{zhen_hua_ling_dd521f03d138797e,
  title = {End-to-End Markov State Sequence Learning for Auditory Attention Decoding},
  author = {Huadong Liang and Miao Sun and Xin Li and Yushan Yashengjiang and Jie Zhang and Zhen-Hua Ling},
