@misc{zhen_hua_ling_f60b3207cf6ae0dd,
  title = {DuraMark: Duration-Embedded Watermarking in LLM-based TTS},
  author = {Kai Gao and Boyu Zhao and Weili Jiang and Zhenwei Mou and Kong-Aik Lee and Liping Chen and Zhen-Hua Ling},
