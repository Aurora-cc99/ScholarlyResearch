@misc{zhen_hua_ling_2d1f3dc8c37c05f3,
  title = {Neural Music Enhancement with Dual Time-Frequency Spectral Representations for Prediction and Discrimination},
  author = {Yang Ai and Fei Liu and Zhen-Hua Ling},
  year = {2026},
  doi = {10.48550/ARXIV.2609.03357},
  url = {https://doi.org/10.48550/ARXIV.2609.03357},
  howpublished = {CoRR},
  annotation = {中文辅助译名：使用双时频频谱表示增强神经音乐以进行预测和辨别},
  abstract = {Non-professional music recordings shared online often suffer from background noise and reverberation, degrading perceived quality and limiting reuse. This paper proposes DSME, a music enhancement model based on dual time-frequency spectral representations. Within a generative adversarial framework, DSME uses short-time Fourier transform (STFT) spectra for generation and constant-Q transform (CQT) spectra for discrimination. Leveraging STFT's fixed window, invertibility, and predictability, the generator estimates clean amplitude-phase spectra from degraded inputs and reconstructs waveforms via inverse STFT. Exploiting CQT's log-frequency, variable-window structure aligned with musical octaves, we design an octave-segmented CQT discriminator. We also introduce a chroma-spectrum loss to emphasize pitch and harmonic consistency. Experiments show DSME outperforms baselines in objective and subjective tests, validating the effectiveness of the dual-spectrum approach.},
}

@misc{zhen_hua_ling_ee1b91c57d55b189,
  title = {Dual Task Vector Merging: Leveraging Emotion and ASR Knowledge for Low-Resource Alzheimer's Disease Detection},
  author = {Yuan-Chao Li and Yin-Long Liu and Liu He and Sizhe Liu and Deng Ji-xuan and Yin Zhang and Zhen-Hua Ling and Jiahong Yuan},
  year = {2026},
  doi = {10.48550/arxiv.2610.24870},
  url = {https://arxiv.org/abs/2610.24870},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：双任务向量合并：利用情感和 ASR 知识进行低资源阿尔茨海默病检测},
  abstract = {Alzheimer's Disease (AD) detection from speech benefits from both paralinguistic and linguistic cues, yet model training is frequently constrained by limited data. Fine-tuning a large pretrained speech encoder can easily overfit, while a frozen probe leaves the encoder's task-relevant knowledge underutilized. Therefore, we propose Dual Task Vector Merging, a parameter-efficient method that adapts a frozen wav2vec 2.0 backbone using task knowledge learned outside the AD task. Specifically, we inject two task vectors, derived as weight deltas from emotion- and ASR-fine-tuned wav2vec 2.0 models, into each transformer layer. During AD training, only layer-wise merging coefficients and a linear classification head are optimized, updating less than 0.1% of the parameters required for full fine-tuning. Speaker-independent experiments on ADReSS and ADReSSo show that dual merging improves over frozen probes, LoRA, and full fine-tuning, in the main binary settings, and gives the best results when combined with LoRA. Evaluation on PROCESS further shows that our advantages transfer to three-class HC/MCI/dementia classification when paired with LoRA. Experiments under reduced training data (20%, 40%, and 80%) confirm reliable gains in low-resource settings.},
}

