@misc{zhen_hua_ling_624c8e526637aac4,
  title = {ADReasoner: Acoustic-Linguistic Cue-Aware Reinforcement Learning for Explainable Alzheimer's Disease Detection from Speech},
  author = {Yin-Long Liu and Yuanchao Li and Jiahong Yuan and Zhen-Hua Ling},
  year = {2026},
  doi = {10.48550/arxiv.2610.34220},
  url = {https://arxiv.org/abs/2610.34220},
