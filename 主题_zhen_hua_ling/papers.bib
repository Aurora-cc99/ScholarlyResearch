  url = {https://doi.org/10.1007/978-981-97-0601-3_6},
  howpublished = {Communications in computer and information science},
  annotation = {中文辅助译名：APNet2：具有直接预测幅度和相位谱的高质量、高效率神经声码器},
}

@misc{zhen_hua_ling_80f4555c254e2366,
  title = {BiVocoder: A Bidirectional Neural Vocoder Integrating Feature Extraction and Waveform Generation},
  author = {Yang Ai and Ye-Xin Lu and Hui-Peng Du and Zhen-Hua Ling},
  year = {2024},
  doi = {10.21437/INTERSPEECH.2024-255},
  url = {https://doi.org/10.21437/INTERSPEECH.2024-255},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：BiVocoder：集成特征提取和波形生成的双向神经声码器},
  abstract = {This paper proposes a novel bidirectional neural vocoder, named BiVocoder, capable both of feature extraction and reverse waveform generation within the short-time Fourier transform (STFT) domain. For feature extraction, the BiVocoder takes amplitude and phase spectra derived from STFT as inputs, transforms them into long-frame-shift and low-dimensional features through convolutional neural networks. The extracted features are demonstrated suitable for direct prediction by acoustic models, supporting its application in text-to-speech (TTS) task. For waveform generation, the BiVocoder restores amplitude and phase spectra from the features by a symmetric network, followed by inverse STFT to reconstruct the speech waveform. Experimental results show that our proposed BiVocoder achieves better performance compared to some baseline vocoders, by comprehensively considering both synthesized speech quality and inference speed for both analysis-synthesis and TTS tasks.},
}

@misc{zhen_hua_ling_54e2a1000254d2be,
  title = {DeepGAN: A fast and high-quality time-domain-based neural vocoder for low-resource scenarios},
  author = {Yuan Jiang and Lijuan Liu and Yajun Hu and Shun Bao and Guoping Hu and Yang Ai and Zhen-Hua Ling},
  year = {2024},
  doi = {10.1145/3653876.3653893},
  url = {https://doi.org/10.1145/3653876.3653893},
  howpublished = {ICDSP},
  annotation = {中文辅助译名：DeepGAN：适用于资源匮乏场景的快速、高质量的基于时域的神经声码器},
  abstract = {Recent advancements in neural vocoders have primarily relied on generative adversarial networks (GANs) operating in the time domain. However, these vocoders are parameter-heavy and computationally expensive, limiting their use in resource-constrained environments such as embedded devices. Depthwise separable convolution, known for its lower parameter count and reduced computational costs, can be employed to construct lightweight networks. In this paper, we introduce an extension to HiFi-GAN, named DeepGAN, which utilizes depthwise separable convolution as the primary unit within the network, introduces a novel upsample module, and incorporates a lightweight excitation generation network to enhance the quality of the generated speech. Both objective and subjective evaluations demonstrate that our proposed DeepGAN achieves comparable results to competing vocoders for both seen and unseen speakers. Notably, the parameter count of DeepGAN is only 1/7 of that of HiFi-GAN, resulting in an approximately sixfold improvement in generation speed, while maintaining the synthesized speech quality.},
}

@misc{zhen_hua_ling_739e26544b96a760,
  title = {ESTVocoder: An Excitation-Spectral-Transformed Neural Vocoder Conditioned on Mel Spectrogram},
