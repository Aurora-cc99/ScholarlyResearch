  abstract = {Current speech deepfake detection systems mostly use fixedlength training and evaluation through audio padding or truncation.However, the utterances' durations are inherently variable, which poses a challenge to deepfake detection.To address this limitation, we propose incorporating the timing embeddings computed from the audio duration and the segment offset into self-attention.The objective is to correct the attention bias map when computing the attention coefficients, so that the timing embeddings guide a better learning of positional interactions.The resulting method is called duration-aware selfattention (DASA), which is implemented in three ways.Experiments on ASVspoof21, In-the-Wild, and CodecFake show the effectiveness of the relative positional encoding based DASA.This result indicates that the proposed method is beneficial to alleviate duration variations.},
}

@misc{zhen_hua_ling_620c084466493623,
  title = {Multiplicative Orthogonal Sequential Editing for Language Models},
  author = {Yuhao Sun and Jun-Yu Ma and Ziqi Peng and Hao-Xiang Xu and Zhen-Hua Ling and Jia-Chen Gu},
