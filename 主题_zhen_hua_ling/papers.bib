@misc{zhen_hua_ling_50f0c9a02a95742a,
  title = {SHINE: Syntax-augmented Hierarchical Interactive Encoder for Zero-shot Cross-lingual Information Extraction},
  author = {Jun-Yu Ma and Quan Liu and Guoping Hu and Zhen-Hua Ling and Cong Liu and Jia-Chen Gu},
  year = {2023},
  doi = {10.48550/ARXIV.2305.12389},
  url = {https://doi.org/10.48550/ARXIV.2305.12389},
  howpublished = {CoRR},
  annotation = {中文辅助译名：SHINE：用于零样本跨语言信息提取的语法增强分层交互式编码器},
}

@misc{zhen_hua_ling_5d48bd3e9bdeb7b1,
  title = {The Ustc System for Adress-m Challenge},
  author = {Xin Li and Tuya Naren and Yinlong Liu and Feiyang Xu and Zhiqiang Guo and Kangdi Mei and Xinyun Ding and Zhen-Hua Ling and Jiahong Yuan},
  year = {2023},
  doi = {10.1109/ICASSP49357.2023.10094714},
  url = {https://doi.org/10.1109/ICASSP49357.2023.10094714},
  howpublished = {ICASSP},
  annotation = {中文辅助译名：Ustc Adress-m 挑战赛系统},
  abstract = {This paper describes our submission to the ICASSP 2023 Signal Processing Grand Challenge (SPGC), which focuses on multilingual Alzheimer’s disease (AD) recognition through spontaneous speech. Our approaches include using a variety of acoustic features and silence-related information for AD detection and mini-mental state examination (MMSE) score prediction, and fine-tuning wav2vec2.0 models on speech in various frequency bands for AD detection. Our overall results on the test data outperform the baseline provided by the organizers, achieving 73.9% accuracy in AD detection by fine-tuning our bilingual wav2vec2.0 pre-trained model on the 0-1000Hz frequency band speech, and 4.610 RMSE (r = 0.565) in MMSE prediction through the fusion of eGeMAPS and silence features.},
}

@misc{zhen_hua_ling_f575cc4515a43e0c,
  title = {USTC-NELSLIP at SemEval-2023 Task 2: Statistical Construction and Dual Adaptation of Gazetteer for Multilingual Complex NER},
  author = {Xiaoyi Zhao and Jun-Yu Ma and Jiajun Qi and Quan Liu and Jia-Chen Gu and Zhen-Hua Ling},
  year = {2023},
  doi = {10.18653/V1/2023.SEMEVAL-1.89},
  url = {https://doi.org/10.18653/V1/2023.SEMEVAL-1.89},
  howpublished = {SemEval@ACL},
  annotation = {中文辅助译名：USTC-NELSLIP 在 SemEval-2023 任务 2：多语言复杂 NER 的地名词典的统计构建和双重适应},
  abstract = {This paper describes the system developed by the USTC-NELSLIP team for SemEval-2023 Task 2 Multilingual Complex Named Entity Recognition (MultiCoNER II).A method named Statistical Construction and Dual Adaptation of Gazetteer (SCDAG) is proposed for Multilingual Complex NER.The method first utilizes a statistics-based approach to construct a gazetteer.Secondly, the representations of gazetteer networks and language models are adapted by minimizing the KL divergence between them at both the sentence-level and entity-level.Finally, these two networks are then integrated for supervised named entity recognition (NER) training.The proposed method is applied to XLM-R with a gazetteer built from Wikidata, and shows great generalization ability across different tracks.Experimental results and detailed analysis verify the effectiveness of the proposed method.The official results show that our system ranked 1st on one track (Hindi) in this task.},
}

@misc{zhen_hua_ling_904eeeffd4801ea2,
  title = {Conversation- and Tree-Structure Losses for Dialogue Disentanglement},
  author = {Tianda Li and Zhen-Hua Ling and Quan Liu and Jia-Chen Gu},
  year = {2022},
  doi = {10.18653/V1/2022.DIALDOC-1.6},
  url = {https://doi.org/10.18653/V1/2022.DIALDOC-1.6},
  howpublished = {DialDoc@ACL},
  annotation = {中文辅助译名：对话解开的对话和树结构损失},
  abstract = {When multiple conversations occur simultaneously, a listener must decide which conversation each utterance is part of in order to interpret and respond to it appropriately.This task is referred as dialogue disentanglement.A significant drawback of previous studies on disentanglement lies in that they only focus on pair-wise relationships between utterances while neglecting the conversation structure which is important for conversation structure modeling.In this paper, we propose a hierarchical model, named Dialogue BERT (DIALBERT), which integrates the local and global semantics in the context range by using BERT to encode each message-pair and using BiLSTM to aggregate the chronological context information into the output of BERT.In order to integrate the conversation structure information into the model, two types of loss of conversation-structure loss and tree-structure loss are designed.In this way, our model can implicitly learn and leverage the conversation structures without being restricted to the lack of explicit access to such structures during the inference stage.Experimental results on two large datasets show that our method outperforms previous methods by substantial margins, achieving great performance on dialogue disentanglement.},
}

@misc{zhen_hua_ling_315d621f6b49f991,
  title = {Detecting Alzheimer's Disease Based on Acoustic Features Extracted from Pre-trained Models},
  author = {Zhaoci Liu and Xin Li and Lijuan Liu and Zhiqiang Guo and Zhen-Hua Ling and Kangdi Mei},
