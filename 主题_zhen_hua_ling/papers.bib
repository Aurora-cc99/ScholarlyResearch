}

@misc{zhen_hua_ling_5a48914436b48b31,
  title = {Refining Self-supervised Learnt Speech Representation using Brain Activations},
  author = {Zhaoci Liu and Kangdi Mei and Yang Ai and Hengyu Li and Zhen-Hua Ling and Liping Chen and Jie Zhang},
  year = {2024},
  doi = {10.21437/INTERSPEECH.2024-604},
  url = {https://doi.org/10.21437/INTERSPEECH.2024-604},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：使用大脑激活完善自我监督学习的语音表示},
  abstract = {It was shown in literature that speech representations extracted by self-supervised pre-trained models exhibit similarities with brain activations of human for speech perception and fine-tuning speech representation models on downstream tasks can further improve the similarity. However, it still remains unclear if this similarity can be used to optimize the pre-trained speech models. In this work, we therefore propose to use the brain activations recorded by fMRI to refine the often-used wav2vec2.0 model by aligning model representations toward human neural responses. Experimental results on SUPERB reveal that this operation is beneficial for several downstream tasks, e.g., speaker verification, automatic speech recognition, intent classification.One can then consider the proposed method as a new alternative to improve self-supervised speech models.},
}

@misc{zhen_hua_ling_f2f692ae11c39371,
  title = {The NERCSLIP-USTC System for Track2 of the First Chinese Auditory Attention Decoding Challenge},
  author = {Yubang Zhang and Zhen-Hua Ling and Jie Zhang},
  year = {2024},
  doi = {10.1109/ISCSLP63861.2024.10800123},
  url = {https://doi.org/10.1109/ISCSLP63861.2024.10800123},
  howpublished = {ISCSLP},
  annotation = {中文辅助译名：首届中国听觉注意力解码挑战赛Track2的NERCSLIP-USTC系统},
  abstract = {The human brain has the ability to selectively focus on a specific auditory stimulus in multi-speaker scenarios. Recently, it was shown that clues on the target speaker can be extracted from electroencephalography (EEG) signals, which is termed as auditory attention decoding (AAD). Existing AAD methods mainly use EEG data elicited by audio-only stimuli and are evaluated on the subjects that have appeared in the training set, resulting in a poor generalization capacity. In the ISCSLP 2024 Chinese AAD Challenge, we explore the performance of AAD models on audio-only and audio-video scenarios. We evaluate 3 different methods and 3 dataset splitting and training strategies and propose to utilize the DenseNet-3D approach and cross-subject data utilization as the submitted system. The effectiveness is verified in the cross-subject track of this challenge, and our method ranks the first with an average accuracy of 59.91%. The reproducible source code is available at: https://github.com/zyb6239/my-AAD-challenge.},
}

