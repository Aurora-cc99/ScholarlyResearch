@misc{zhen_hua_ling_a44b097e5941432a,
  title = {Enhancing Sentence Embedding with Generalized Pooling},
  author = {Qian Chen and Zhen-Hua Ling and Xiaodan Zhu},
  year = {2018},
  doi = {10.48550/arxiv.1806.09828},
