@misc{lei_xie_nwpu_66f16fd4d47b3852,
  title = {Automated Fault Detection and Diagnosis for Large-Scale Cloud Systems Based on Log Analysis},
  author = {Zhiyao Li and Yi Zhou and Lei Xie and Ruiying Cheng and Xiao Jin Yu},
  year = {2025},
  doi = {10.1109/icicr65456.2025.00021},
  url = {https://doi.org/10.1109/icicr65456.2025.00021},
  howpublished = {International Conference on Intelligent Computing and Robotics (ICICR)},
  annotation = {中文辅助译名：基于日志分析的大规模云系统故障自动检测与诊断},
  abstract = {The fast expansion of large-scale cloud systems has presented hitherto unheard-of difficulties preserving system stability and dependability. Generated constantly throughout operation, system logs are an essential data source for failure identification and diagnostics. Nevertheless, the unstructured, high-dimensional, sequential character of log data and the natural complexity of cloud settings restrict the efficiency of conventional approaches. This work presents a new deep learning-based system for automated fault detection and diagnosis in order to solve these problems. Three main components comprise the framework: a Long Short-Term Memory (LSTM)-based sequence modeling architecture to capture temporal dependencies in $\log$ data, an efficient $\log$ parsing and preprocessing pipeline to transform raw logs into structured sequences, and a hierarchical fault classification mechanism for multi-level fault detection. With an accuracy of 97.3%, a precision of 92.5%, and an F1 score of 91.1%, experimental data shows how well the framework handles large-scale log data. Furthermore, appropriate for real-time fault detection, the model achieves great computational efficiency with an average inference time of $\mathbf2. 3$ milliseconds per log event. Emphasizing its practical possibilities in enhancing system dependability, the suggested framework beats conventional rule-based techniques and machine learning models.},
}

@misc{lei_xie_nwpu_99d711feb98921e4,
  title = {EASY: Emotion-aware Speaker Anonymization via Factorized Distillation},
  author = {Hexin Liu and Jixun Yao and Chng Eng Siong and Lei Xie},
  year = {2025},
  doi = {10.21437/INTERSPEECH.2025-194},
  url = {https://doi.org/10.21437/INTERSPEECH.2025-194},
  howpublished = {INTERSPEECH},
  annotation = {中文辅助译名：简单：通过因子蒸馏实现情绪感知说话者匿名化},
  abstract = {Emotion plays a significant role in speech interaction, conveyed through tone, pitch, and rhythm, enabling the expression of feelings and intentions beyond words to create a more personalized experience. However, most existing speaker anonymization systems employ parallel disentanglement methods, which only separate speech into linguistic content and speaker identity, often neglecting the preservation of the original emotional state. In this study, we introduce EASY, an emotion-aware speaker anonymization framework. EASY employs a novel sequential disentanglement process to disentangle speaker identity, linguistic content, and emotional representation, modeling each speech attribute in distinct subspaces through a factorized distillation approach. By independently constraining speaker identity and emotional representation, EASY minimizes information leakage, enhancing privacy protection while preserving original linguistic content and emotional state. Experimental results on the VoicePrivacy Challenge official datasets demonstrate that our proposed approach outperforms all baseline systems, effectively protecting speaker privacy while maintaining linguistic content and emotional state.},
}

