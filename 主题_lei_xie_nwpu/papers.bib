@misc{lei_xie_nwpu_a044c1f73cb1da27,
  title = {The NNI Query-by-Example System for MediaEval 2015},
  author = {Yougen Yuan and Sining Sun and Zhong-Hua Fu and Haihua Xu and Shaofei Zhang and Jingyong Hou and Cheung-Chi Leung and Tin Lay Nwe and Van Tung Pham and Haizhou Li and Hang Lv and Chongjia Ni and Xiong Xiao and Sunil Sivadas and Bin Ma and Chng Eng Siong and Lei Xie and Pengcheng Li and Lei Wang and Hongjie Chen},
