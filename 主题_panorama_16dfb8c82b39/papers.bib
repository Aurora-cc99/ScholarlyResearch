  annotation = {中文辅助译名：基于改进的PPC-YOLOv11n不同光照干扰条件下小目标识别算法},
  abstract = {To address the insufficient recognition accuracy caused by small target defects on the hull surface of fiberglass reinforced plastic (FRP) ships, weak lighting at night, and similar surface textures, this paper proposes PPC-YOLOv11n, an algorithm for identifying surface damage of FRP ship hulls based on YOLOv11n. A small target P2 detection layer is introduced into YOLOv11n to accurately capture detailed information of small targets by operating directly on high-resolution feature maps, thereby reducing missed detections of tiny defects. Meanwhile, the C2PSA module in the backbone network is replaced with CSDAttention, a novel attention mechanism that integrates channel and spatial attention branches to jointly model inter-channel dependencies and spatial feature responses. Furthermore, 1 × 1 convolutions are adopted for channel reduction, and 5 × 5 dilated convolutions are introduced to expand the effective receptive field, enabling the model to capture broader contextual information for distinguishing defect textures from similar background patterns. A residual connection is employed to preserve fine-grained shallow features and alleviate gradient degradation. In addition, a PPConv multi-scale convolution module is proposed, which employs two parallel PConv branches with 3 × 3 and 5 × 5 kernel sizes to extract multi-scale defect features. Combined with batch normalization to suppress feature distribution shifts caused by illumination fluctuations, PPConv enhances the recogn},
}

@misc{panorama_16dfb8c82b39_3152a9d4cda34bcc,
  title = {An Efficient Spike-Inspired Differential Attention Model for Traffic Flow Forecasting},
  author = {Linliang Zhang and Xueting Liang and Jin Li and Yanyan Ma and Bei Sun and Zhaoxia Li and Rui Cao},
  year = {2026},
  doi = {10.1109/access.2026.3724884},
  url = {https://doi.org/10.1109/access.2026.3724884},
  howpublished = {IEEE Access},
  annotation = {中文辅助译名：用于交通流预测的高效尖峰启发差分注意模型},
  abstract = {Traffic flow forecasting is a fundamental task in intelligent transportation systems, and accurate multi-step prediction depends critically on effective modeling of both temporal dynamics and spatial dependencies within sensor networks. On the one hand, forecasting models must possess strong spatiotemporal interaction modeling capabilities; on the other hand, computational complexity must be carefully controlled to satisfy practical deployment requirements. In recent years, spiking neural networks have shown considerable potential for efficient sequential modeling tasks due to their event-driven nature, sparse activations, and low-power computational characteristics. Transformer-based methods effectively capture temporal dependencies but suffer from high computational costs, while lightweight channel-independent and MLP-based approaches improve efficiency at the expense of limited cross-node interaction modeling. To address these limitations, this paper proposes a spiking spatiotemporal forecasting framework for traffic flow prediction, which integrates a temporal core fusion mechanism and a spike-driven differential spatial attention mechanism within a unified architecture. Specifically, along the temporal dimension, an “aggregate-then-redistribute” strategy is employed to compress and reconstruct temporal context, thereby enabling efficient global temporal interaction while avoiding the quadratic complexity of conventional attention. To capture spatial correlations, we furt},
}

