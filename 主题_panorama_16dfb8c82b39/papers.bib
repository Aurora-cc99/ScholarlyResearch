@misc{panorama_16dfb8c82b39_2aa3c3b1aaf3f528,
  title = {WCB-YOLO: An Improved Detection Algorithm for Underwater Fishing Vessel Surface Defects},
  author = {Shibo Wei and Rui Cao and Jianghua Sui},
  year = {2026},
  doi = {10.1109/caibda70336.2026.11621181},
  url = {https://doi.org/10.1109/caibda70336.2026.11621181},
  howpublished = {International Conference on Artificial Intelligence, Big Data and Algorithms (CAIBDA)},
  annotation = {中文辅助译名：WCB-YOLO：一种改进的水下渔船表面缺陷检测算法},
  abstract = {To address the limited detection accuracy of small-scale, low-contrast defects on underwater hull surfaces of fishing vessels, this paper proposes WCB-YOLO, an improved detection network based on YOLO11n. First, we reconstruct the backbone feature extraction by introducing WTConv convolution and the BiFormer bi-level routing attention mechanism. WTConv leverages the wavelet transform to enlarge the effective receptive field, enhancing both local detail and global context modeling while controlling parameter count and computational cost. BiFormer employs dynamic routing attention to strengthen the response to critical features such as defect regions and edge textures, improving model robustness under low-contrast conditions and complex backgrounds. Second, we introduce GFPN into the neck network. Through cross-scale feature fusion and skip-layer connections, GFPN facilitates thorough interaction between high-level semantic and low-level spatial information, strengthening feature representation for defect targets at varying scales and improving small-scale target detection in complex underwater scenes. Experimental results show that, compared with YOLO11n, WCB-YOLO achieves improvements of 7.4 and 8.4 percentage points in mAP50 and mAP50-95, respectively, while maintaining 3.12 M parameters and 8.2 G FLOPs. The model strikes a favorable balance between detection accuracy and real-time efficiency, providing technical support for automated underwater inspection of fishing vessels},
}

@misc{panorama_16dfb8c82b39_a78bb370ae62e0c8,
  title = {WMD: A Lightweight YOLO11 Extension for Efficient Complexity Detection in Mechanical Part Inspection},
  author = {Xiaofeng Yue and Jiaqi Yang and Zeyu Qi and Ruochen Cao and Rui Cao and Xin Wen},
  year = {2026},
  doi = {10.1109/ijcnn69854.2026.11729936},
  url = {https://doi.org/10.1109/ijcnn69854.2026.11729936},
  howpublished = {International Joint Conference on Neural Networks (IJCNN)},
  annotation = {中文辅助译名：WMD：轻量级 YOLO11 扩展，用于机械零件检测中的高效复杂性检测},
  abstract = {A key feature of Industry 4.0 is intelligent manufacturing, which calls for the deep integration of advanced technologies in industrial production. In current manufacturing practices, the complexity detection of mechanical parts still heavily relies on manual inspection, leading to high labor costs and low efficiency. To address this challenge, this study proposes an efficient improved object detection algorithm based on YOLO11, incorporating Wavelet Convolution (WTConv), Manhattan Self-Attention (MaSA), and Distance Intersection over Union (DIoU), collectively referred to as the WMD model. The WMD model integrates WTConv and MaSA into the backbone and neck of the YOLO11 architecture to enhance feature extraction capabilities, while DIoU replaces the original bounding box regression loss function to improve localization accuracy. Experimental results demonstrate that the proposed WMD model achieves significant improvements over the baseline model: precision increases by 3.6%, mAP@0.5 improves by 1.5%, model parameters decrease by 0.042 × 106, and computational cost reduces by 0.1 GFLOPs. Overall, the WMD model effectively balances detection performance and computational efficiency, making it a promising lightweight solution for automated mechanical part complexity detection in smart manufacturing.},
}

@misc{panorama_16dfb8c82b39_0a93a27be77c87b3,
  title = {Swin Transformer-Based Temporal-Channel Network for Cross-Subject EEG Emotion Classification},
  author = {Ruijie He and Xin Wen and Yanrong Hao and Mengni Zhou and Jin Li and Rui Cao},
  year = {2025},
  doi = {10.1109/ijcb65343.2025.11411107},
  url = {https://doi.org/10.1109/ijcb65343.2025.11411107},
  howpublished = {IEEE International Joint Conference on Biometrics (IJCB)},
  annotation = {中文辅助译名：基于 Swin Transformer 的时间通道网络，用于跨受试者脑电图情绪分类},
  abstract = {To tackle the challenge of effectively representing time-varying information in cross-subject EEG emotion recognition, we introduce Swin Transformer-Based Temporal-Channel Network (Swin-TCNet), a novel multi-scale neural network with parallel temporal pathways to enhance the extraction of dynamic temporal features. EEG signals are simultaneously processed through a Temporal Swin Transformer for 3D feature representation and a dynamic spatiotemporal convolutional layer with multi-head attention for extracting differential entropy-based channel features, which enhances channel learning while preserving temporal information. Swin-TCNet attains state-of-the-art performance, achieving 93.47% and 86.80% accuracy in cross-subject experiments on SEED and SEED-IV datasets, respectively, as substantiated by ablation studies. By leveraging temporal dynamics, this framework enhances the extraction of temporal variations and spatial information, leading to more robust and generalizable cross-subject emotion recognition.},
}

