@misc{hatice_gunes_2328b78811261c43,
  title = {Bodily Expression for Automatic Affect Recognition},
  author = {Hatice Güneş and Caifeng Shan and Shi‐Zhi Chen and Yingli Tian},
  year = {2015},
  doi = {10.1002/9781118910566.ch14},
  url = {https://doi.org/10.1002/9781118910566.ch14},
  howpublished = {Wiley eBooks},
  annotation = {中文辅助译名：用于自动情感识别的身体表情},
  abstract = {This chapter first addresses the question of ‘why bodily expression?’, and attempts to find answers by reviewing the latest bodily expression perception literature. It then turns its attention to the question of ‘what are the bodily expressions recognized automatically?’ by providing an overview of the automatic bodily expression recognition literature. The chapter provides representative answers to how bodily expression analysis can aid affect recognition by describing three case studies: data acquisition and annotation of the first publicly available database of affective face-and-body displays (FABO database); a representative approach for affective state recognition from face-and-body display by detecting the space-time interest points in video and using Canonical Correlation Analysis (CCA) for fusion, and a representative approach for explicit detection of the temporal phases of affective states from bodily expressions. It concludes by summarizing the main challenges faced and discussing how one can advance the state of the art in the field.},
}

