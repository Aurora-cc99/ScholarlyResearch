  year = {2024},
  doi = {10.1109/eiecc64539.2024.10929590},
  url = {https://doi.org/10.1109/eiecc64539.2024.10929590},
  howpublished = {International Conference on Electronic Information Engineering and Computer Communication (EIECC)},
  annotation = {中文辅助译名：具有高保持电压和鲁棒性的栅极二极管 LVTSCR 的设计},
  abstract = {A gate-diode LVTSCR(GDLVTSCR) is proposed and implemented in 0.18um CMOS technology. By embedding a gate-diode in the traditional LVTSCR, an additional surface discharge path is provided, thereby enhancing the holding voltage and robustness. Transient simulations of the device were carried out using TCAD, the turn-on process and working principle of the device were analyzed. The simulation results demonstrate that the gated diode path can discharge the large ESD current together with the main SCR. The TLP test results demonstrate that compared with traditional LVTSCR, the proposed GDLVTSCR has a lower |V|t1, a higher |V|h, and a greater failure current.},
}

@misc{panorama_a1b824acf8ea_9cf10902ebf3,
  title = {Generating the Transcriptional Regulation View of Transcriptomic Features for Prediction Task and Dark Biomarker Detection on Small Datasets},
  author = {Kewei Li and Yusi Fan and Yaqing Liu and Hongmei Liu and Gongyou Zhang and Meiyu Duan and Lan Huang and Fengfeng Zhou},
  year = {2024},
  doi = {10.3791/66030},
  url = {https://doi.org/10.3791/66030},
  howpublished = {Journal of Visualized Experiments},
  annotation = {中文辅助译名：生成转录组特征的转录调控视图，用于小数据集上的预测任务和暗生物标志物检测。J Vis Exp},
  abstract = {Transcriptome represents the expression levels of many genes in a sample and has been widely used in biological research and clinical practice. Researchers usually focused on transcriptomic biomarkers with differential representations between a phenotype group and a control group of samples. This study presented a multitask graph-attention network (GAT) learning framework to learn the complex inter-genic interactions of the reference samples. A demonstrative reference model was pre-trained on the healthy samples (HealthModel), which could be directly used to generate the model-based quantitative transcriptional regulation (mqTrans) view of the independent test transcriptomes. The generated mqTrans view of transcriptomes was demonstrated by prediction tasks and dark biomarker detection. The coined term "dark biomarker" stemmed from its definition that a dark biomarker showed differential representation in the mqTrans view but no differential expression in its original expression level. A dark biomarker was always overlooked in traditional biomarker detection studies due to the absence of differential expression. The source code and the manual of the pipeline HealthModelPipe can be downloaded from http://www.healthinformaticslab.org/supp/resources.php.},
}

@misc{panorama_a1b824acf8ea_2cdba41ad764c7b4,
