  year = {2026},
  doi = {10.1016/j.ygeno.2025.111173},
  url = {https://doi.org/10.1016/j.ygeno.2025.111173},
  howpublished = {Genomics},
  annotation = {中文辅助译名：OCm7G：使用有限负样本训练的 m7G 甲基化位点的可解释一类预测器。基因组学},
  abstract = {N7-methylguanosine (m7G) is a common RNA modification linked to multiple diseases. Accurate detection of m7G sites is vital for elucidating its biological roles, but conventional methods are often laborious and costly. AI-based approaches offer alternatives, yet most rely on balanced datasets, ignoring real-world imbalances where negative samples vastly outnumber positives. This discrepancy may lead to overestimated model performance. To address this, we reconstructed independent test sets with low positive-to-negative ratios and benchmarked various models. We propose OCm7G, an ensemble of one-class classifiers with hierarchical thresholding. OCm7G achieves performance comparable to state-of-the-art methods on balanced sets and surpasses them in highly imbalanced scenarios, despite using only 52.5 % of the training data. Moreover, OCm7G offers interpretable predictions, aiding researchers in understanding model decisions. The source code and datasets are publicly available at: https://github.com/lidaosheng/OCm7G.},
}

