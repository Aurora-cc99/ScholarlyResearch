  author = {Kewei Li and Yuqian Wu and Yinheng Li and Yutong Guo and Yanwen Kong and Yan Wang and Yiyang Liang and Yusi Fan and Lan Huang and Ruochi Zhang and Fengfeng Zhou},
  year = {2026},
