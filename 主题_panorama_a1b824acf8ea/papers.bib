@misc{panorama_a1b824acf8ea_1b59162e56c9a58c,
  title = {A Recently Active Miniature Inverted-Repeat Transposable Element, Chunjie, Inserted Into an Operon Without Disturbing the Operon Structure in Geobacter uraniireducens Rf4},
  author = {Yong Chen and Fengfeng Zhou and Guojun Li and Ying Xu},
  year = {2008},
  doi = {10.1534/genetics.108.089995},
  url = {https://doi.org/10.1534/genetics.108.089995},
  howpublished = {Genetics},
  annotation = {中文辅助译名：最近活跃的微型反向重复转座元件Chunjie插入操纵子中而不干扰Geobacter uraniireducens Rf4中的操纵子结构},
  abstract = {Miniature inverted-repeat transposable elements (MITEs) are short DNA transposons with terminal inverted repeat (TIR) signals and have been extensively studied in plants and other eukaryotes. But little is known about them in eubacteria. We identified a novel and recently active MITE, Chunjie, when studying the recent duplication of an operon consisting of ABC transporters and a phosphate uptake regulator in the chromosome of Geobacter uraniireducens Rf4. Chunjie resembles the other known MITEs in many aspects, e.g., having TIR signals and direct repeats, small in size, noncoding, able to fold into a stable secondary structure, and typically inserted into A + T-rich regions. At least one case of recent transposition was observed, i.e., the insertion of Chunjie into one copy of the aforementioned operon. As far as we know, this is the first report that the insertion of a MITE does not disrupt the operon structure.},
}

