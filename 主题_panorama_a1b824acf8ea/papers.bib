@misc{panorama_a1b824acf8ea_2c6859af6cec,
  title = {Reconstructing the cytokine view for the multi-view prediction of COVID-19 mortality},
  author = {Yueying Wang and Zhao Wang and Yaqing Liu and Qiong Yu and Yujia Liu and Changfan Luo and Siyang Wang and Hongmei Liu and Mingyou Liu and Gongyou Zhang and Yusi Fan and Kewei Li and Lan Ji Huang and Meiyu Duan and Fengfeng Zhou},
  year = {2023},
  doi = {10.1186/s12879-023-08291-z},
