  annotation = {中文辅助译名：Eye3DVas：结合眼底图像特征三维重建视网膜血管结构},
  abstract = {Two-dimensional images of fundus blood vessels are easy to obtain with low diagnostic accuracy. This study realized the reconstruction of three-dimensional vascular structures from two-dimensional fundus images to improve the accuracy to 95%.},
}

