@misc{karim_jerbi_0458dfdf1340,
  title = {The 2026 PNPL Competition: Word Classification and Efficient Cross-Subject Generalisation in LibriBrain100},
  author = {Francesco Mantegna and Gereon Elvers and Dulhan Jayalath and Gilad Landau and Tasha Kim and Miran Özdogan and Luisa Kurth and Teyun Kwon and SungJun Cho and Benjamin Ballyk and Alex Fung and Anna Greer and Pratik Somaiya and Christian Herff and Yorguin-José Mantilla-Ramos and Hamza Abdelhedi and Karim Jerbi and Gregory Farquhar and Brendan Shillingford and Mark W. Woolrich and Ōiwi Parker Jones},
  year = {2026},
  doi = {10.48550/arxiv.2609.03231},
  url = {https://doi.org/10.48550/arxiv.2609.03231},
