  abstract = {Abstract Executive functions continue to develop throughout childhood and vary considerably across children. Design fluency tasks are commonly used to assess executive functioning through design production, repetitions, and strategy use. When averaged across the full task, these measures summarize performance but do not show how they change as the task progresses. Whether examining these measures minute by minute provides additional information about variability across children remains unclear. We examined this question in 113 neurotypical children aged 7–13 years using a tablet-based design fluency task. To identify performance profiles, we applied K-means clustering separately to design production, repetitions, and strategy use averaged across the task and measured across five one-minute intervals. Overall task measures identified two overlapping profiles. One showed lower design production and lower proportions of repetitions and strategies, whereas the other showed higher production and higher proportions of repetitions and strategies. Minute-by-minute clustering produced nearly identical assignments, but weaker separation, suggesting that temporal information added little to profile identification. However, examining changes over time revealed subtler differences: strategy use followed broadly similar patterns across profiles, but showed a pronounced between-profile difference during the first minute that narrowed thereafter. In contrast, the difference in repetition rat},
}

@misc{karim_jerbi_d821865a74b6,
  title = {Predicting cognitive decline in prodromal synucleinopathies using clinical markers and machine learning},
  author = {Loubna Mekki Berrada and Arthur Dehgan and Ronald B. Postuma and Yann Harel and Hamza Abdelhedi and Jacques Yves Montplaisir and Karim Jerbi and Jean‐François Gagnon},
  year = {2025},
  doi = {10.21203/rs.3.rs-4619161/v2},
  url = {https://doi.org/10.21203/rs.3.rs-4619161/v2},
  howpublished = {Research Square},
  annotation = {中文辅助译名：使用临床标记和机器学习预测前驱突触核蛋白病的认知衰退},
  abstract = {Abstract Neuroprotective interventions for dementia with Lewy bodies (DLB) and Parkinson’s disease (PD) are still in their early days. Clinical trials are expected to target idiopathic rapid eye movement sleep behavior disorder (iRBD), their strongest predictor. However, the presentation and progression of symptoms within this population show significant heterogeneity. We used machine learning (ML) to identify the clinical markers that are best at distinguishing iRBD patients (n=156) who developed DLB (n=26) from those who developed PD (n=34) at a mean follow-up of 4.37 years. Our model classified subsequent conversion to DLB versus PD with 0.80 accuracy, with mild cognitive impairment as best predictive feature. Cognitive tests of executive functions and verbal learning also played a major role in classifying other related pathological trajectories. These findings support the use of ML with clinical markers in iRBD, paving the way for a more targeted selection of participants in future neuroprotective trials of synucleinopathies.},
}

@misc{karim_jerbi_66e26591b325,
