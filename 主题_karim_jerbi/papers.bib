  annotation = {中文辅助译名：NeuroMM 2026：第一届多媒体多模态神经生理智能国际研讨会},
  abstract = {Multimedia intelligence primarily models observable content and behavior, yet many human-centered tasks depend on neural and bodily dynamics. Multimodal neurophysiological intelligence addresses this gap by relating EEG, fNIRS, ECG, EMG, and other biosignals to synchronized multimedia and contextual information. We synthesize 13 NeuroMM 2026 Workshop and Grand Challenge papers across four directions: neuroclinical analysis; context, behavior, and well-being; personalized generation; and brain--computer interfaces. The interictal epileptiform discharge (IED) Grand Challenge grounds this agenda in a clinical case combining physiological evidence with observable context. Across these directions, we identify three priorities: explicit modality roles, validation across time, people, devices, and recording conditions, and evaluation aligned with intended use and deployment-time data access. NeuroMM thus extends human-aware multimedia toward task-grounded integration of behavior, context, and physiology.},
}

@misc{karim_jerbi_45286063796a,
