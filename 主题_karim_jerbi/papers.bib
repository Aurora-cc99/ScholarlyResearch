  author = {Derek Newman and Charlotte Maschke and Jordan O’Byrne and Michele Angelo Colombo and Angela Comanducci and Silvia Casarotto and Giuseppe Citerio and Mario Rosanova and Marcello Massimini and Karim Jerbi and Stefanie Blain‐Moraes},
  year = {2026},
