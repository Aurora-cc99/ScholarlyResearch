  author = {Venkatesh Subramani and Timothy Nest and Annalisa Pascarella and Jérémy Brunel and Yorguin-José Mantilla-Ramos and Yann Harel and Suresh D Muthukumaraswamy and Robin Lester Carhart-Harris and Giulia Lioi and Nicolas Farrugia and Karim Jerbi},
  year = {2026},
