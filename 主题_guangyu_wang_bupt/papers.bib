  author = {Zhiwei Li and Xiaona Fan and Dan Jiang and Qingwei Li and Chao Liu and Dan Wang and Na Li and Hengzhen Li and Zhuo Chen and Hongzhen Tang and Changjie Lou and Haitao Xu and Chao Zhan and Yuandi Dong and Zhigang Ma and Guangyu Wang and Chunhui Zhang and Haibo Lu and Tongsen Zheng and Yanqiao Zhang},
  year = {2024},
  doi = {10.1093/oncolo/oyae207},
  url = {https://doi.org/10.1093/oncolo/oyae207},
