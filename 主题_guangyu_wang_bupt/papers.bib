@misc{guangyu_wang_bupt_edba6521e5cb1786,
  title = {Benefit of Sunitinib in the treatment of pulmonary primitive neuroectodermal tumors: a case report and literature review},
  author = {Chunhui Zhang and Jingchun Zhang and Guangyu Wang and Jiajia Xu and Yan-Lin Li and Qing Guo and Tongsen Zheng and Yanqiao Zhang},
