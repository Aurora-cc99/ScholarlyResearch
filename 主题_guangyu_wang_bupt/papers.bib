  abstract = {Background Alternating sequential administration of drugs may be a promising approach to overcome chemotherapy resistance in advanced pancreatic ductal adenocarcinoma (PDAC). Methods This study was an open-label, single-arm, and prospective trial included patients with untreated advanced PDAC. They received 2 cycles of NS regimen (nab-paclitaxel:125 mg/m2, intravenously injected on days 1 and 8, plus S-1:40-60 mg, orally twice per day for 1-14 days) followed by 2 cycles of GemOx regimen (gemcitabine, intravenously injected on days 1 and 8, and oxaliplatin: 130 mg/m2, intravenously injected on day 1). The primary efficacy endpoint was a progression-free survival rate at 6 months (PFSR-6m). The secondary efficacy endpoints included overall survival (OS), progression-free survival (PFS), objective response rate (ORR), disease control rate (DCR), and adverse events (AEs). Specific mRNA transcripts were used to explore survival associated genes. Results Forty-two patients received a minimum of one treatment cycle, and of these, 30 patients completed one alternating treatment consisting of 4 cycles. The PFSR-6m was 71% (95% CI = 58%-87%). The median PFS and OS were 6.53 months (95% CI = 6.03-8.43) and 11.4 months (95% CI = 9.8-14.4), respectively. Common grades 3-4 hematological AEs included neutropenia 30.9%, leukopenia 26.2%, anemia 2.4%, and thrombocytopenia in 11.9%. Patients with OS > 10 months showed high expression of HLA-DQA2 while melanoma-associated antigen genes (MAGE) w},
}

@misc{guangyu_wang_bupt_9bf33db7d3eea7d8,
  title = {Methods for Removing Artifacts from EEG signals: A review},
  author = {Yucheng Zhao and Mingxu Sun and Yan Yan and Zhonghua Zhao and Guangyu Wang},
  year = {2024},
  doi = {10.1109/QRS-C63300.2024.00100},
  url = {https://doi.org/10.1109/QRS-C63300.2024.00100},
  howpublished = {QRS Companion},
  annotation = {中文辅助译名：从脑电图信号中去除伪影的方法：综述},
  abstract = {Electroencephalogram signals are widely used in neuroscience and brain-computer interfaces. The EEG signals are relatively weak, so the devices for acquiring the EEG signals are very sensitive. Therefore, during EEG acquisition, interfering signals that are not EEG activity are usually mixed in, and these interferences are known as artifacts,and the most common of these artifacts are from physiological sources including electrooculographic (EOG) artifacts, electromyographic (EMG) artifacts, and electrocardiographic (ECG) artifacts. In order to know more accurately the intention of brain activity, after acquiring the EEG signal, some method must be taken to remove artifacts from it. The removal of these three artifacts is difficult and usually requires some specific methods to remove them. This paper describes the causes of these three artifacts and reviews the methods to eliminate them, and summarizes the advantages and disadvantages of these methods through the conclusions of the published literature.},
}

