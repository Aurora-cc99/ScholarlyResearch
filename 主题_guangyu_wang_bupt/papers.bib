@misc{guangyu_wang_bupt_af56a9ee776a0c42,
  title = {A Single Carrier Frequency Division Multiplex Access System Based on Discret Sine Transform and its Performance Analysis},
  author = {Guangyu Wang},
  year = {2013},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=DATE201304017},
  howpublished = {Telecommunication Engineering},
  annotation = {中文辅助译名：基于离散正弦变换的单载波频分多址系统及其性能分析},
  abstract = {To analyze the influence of Discrete Fourier Transform(DFT) and Discrete Sine Transform(DST) on the performance of a Single Carrier Frequency Division Multiple Access(SC-FDMA) system,a DST-based SC-FDMA system is introduced.The structure of SC-FDMA system based on DST is described.Then,the time domain expressions of the DST IFDMA signal and DST LFDMA signal are derived and analyzed.Finally,the Peak-to-Average Power Ratio(PAPR) and impulse response of different pulse shaping filter are discussed.The simulation results show that the proposed DST SC-FDMA system has a better bit performance than the conventional DFT SC-FDMA and Orthogonal Frequency Division Multiple Access(OFDMA) system.Furthermore,the PAPR of DST SC-FDMA signals is closed to that of DFT SC-FDMA signals and lower than that of OFDMA.},
}

@misc{guangyu_wang_bupt_061598fbf6e54625,
  title = {Time‐varying multicarrier and single‐carrier modulation systems},
  author = {Guangyu Wang and Ling Zhuang and Kai Shao},
  year = {2013},
  doi = {10.1049/iet-spr.2012.0181},
  url = {https://doi.org/10.1049/iet-spr.2012.0181},
  howpublished = {IET Signal Processing},
  annotation = {中文辅助译名：时变多载波和单载波调制系统},
  abstract = {The modulation system is an important part in all communication networks including wireline and wireless networks. Orthogonal frequency‐division multiplexing/orthogonal frequency‐division multiple access (OFDM/OFDMA) and single‐carrier frequency‐division multiple access (SCFDMA) are representatives of multicarrier and single‐carrier modulations, which are widely used in different communication standards, like WiMAX and Long Term Evolution (LTE). However, all existed modulation systems use the fixed symbol block length or fixed subcarrier number. In the adaptive OFDM system the subcarrier number is still fixed, and just the symbol constellation mapping schemes are adaptively selected based on the subchannel quality. In this study, the author introduce a new concept, namely time‐varying symbol block or time‐varying subcarrier number into the modulation systems to improve the system performance. The author call the new modulation system time‐varying OFDM (TV‐OFDM), time‐varying OFDMA (TV‐OFDMA) for multicarrier modulation, and time‐varying SCFDMA(TV‐SCFDMA) for single‐carrier modulation. Here, peak‐to‐average power ratio (PAPR) is used as criteria to change the symbol block length timely. The algorithm for determination of the symbol block length is presented. The simulation results show that the time‐varying modulation schemes can clearly reduce the PAPR values for both multicarrier and single‐carrier modulation systems.},
}

@misc{guangyu_wang_bupt_0a2eeb51fbf4ee1b,
  title = {FBMC for broadband wireless communications},
  author = {Guangyu Wang},
  year = {2012},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=CASH201206020},
  howpublished = {Journal of Chongqing University of Posts and Telecommunications},
  annotation = {中文辅助译名：用于宽带无线通信的 FBMC},
  abstract = {Filter Bank based Multicarrier technique has a strong ability of anti-multipath fading,and provides a better solution to the contradiction between the high-speed wireless data transmission and sophisticated equalization processing technique.Filter Bank based Multicarrier has been seen as a developing direction of the next-generation broadband wireless communication.This paper describes the basic principles of FBMC and OFDM,as well as their advantages and disadvantages.Based on the description of the principles,the combination of these two techniques,MIMO,CDMA and CR are discussed.Finally,the article makes a prospect for the development of multicarrier technology.},
}

@misc{guangyu_wang_bupt_1b3d3c0fbb5ee586,
  title = {Joint Optimization for Sub-Carrier Pair and Power in OFDM-Based Two-Way Relaying},
  author = {Guangyu Wang},
  year = {2011},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=BJYD2011S1021},
  howpublished = {Beijing Youdian Xueyuan xuebao},
  annotation = {中文辅助译名：基于 OFDM 的双向中继中子载波对和功率的联合优化},
  abstract = {In order to improve the sum-capacity of amplify-and-forward scheme for two-way relaying over orthogonal frequency division multiple(OFDM),a sub-carrier pairing method based on sorting the channel coefficients(SP-SCC) with low complexity is proposed.And for jointing sub-carrier pairing and its optimal power allocation,a resource allocation strategy is presented.The sub-carrier pairing by applying SP-SCC with equal power allocation among each sub-carrier pair is firstly considered;and a dual decomposition for power allocation among each sub-carrier pair with total power constraint is employed.Finally,the power of each sub-carrier pair is allocated to each node,i.e.the optimal power allocation of each node is obtained.Numerical analysis shows that the proposed resource allocation strategy can improve the sum-capacity.},
}

@misc{guangyu_wang_bupt_e8cac83f7e54461a,
