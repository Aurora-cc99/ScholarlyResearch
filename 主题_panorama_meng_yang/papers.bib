  howpublished = {Journal of Computing and Information Science in Engineering},
  annotation = {中文辅助译名：基于大语言模型和知识图谱的智能制造智能控制框架},
  abstract = {Abstract The rapid development of large language models (LLMs) and robotics is fundamentally reshaping the manufacturing sector. LLMs have already had a profound impact across multiple fields, such as document management, medical consultation, education, etc. However, the inherent complexity and dynamic nature of manufacturing continue to pose challenges for applying LLMs in robotic control within this domain, particularly in understanding the spatial and logical relationships between different objects. Although fine-tuning can be implemented, it requires a significant amount of time for each iteration and does not support real-time updates, making it unsuitable for industrial applications. To relieve the problem, this paper proposes a novel industrial robot control scheme called the LLM-Knowledge Graph (KG) Powered Intelligent Agent Framework (LKPI). The goal is to fully leverage the external knowledge and logical relationships provided by KG to enhance robotic perception and decision-making in complex production environments, without the need to finetune the LLMs. In experimental validation, LKPI demonstrated superior logical reasoning and environmental adaptability in a dynamic and noise-prone pecan processing scenario. Even when the camera could not directly identify the target object, LKPI utilized environmental background information and relationship information stored in the KG to accomplish transportation and navigation. By integrating real-time recognition and depth },
}

@misc{panorama_meng_yang_7b789461b51768cf,
  title = {Personalized Recommendation of Exhibits for Aerospace Cloud Museums based on Deep Learning},
  author = {Yunting Fan and Qiang Li and Meng Yang},
  year = {2025},
  doi = {10.1109/ispa67752.2025.00090},
  url = {https://doi.org/10.1109/ispa67752.2025.00090},
  howpublished = {IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)},
  annotation = {中文辅助译名：基于深度学习的航天云博物馆展品个性化推荐},
  abstract = {This study presents a deep learning-based personalized recommendation system for aerospace cloud museum exhibits to address the limitations of traditional cloud museum designs, which often overlook users' personalized recommendation needs and hinder rapid access to interested knowledge. The system employs the Attention-CNN-Transformer model (ACT), where the attention mechanism dynamically adjusts the weight proportions of user attributes (age, gender, etc) and exhibit attributes (type, model, browsing time, etc) in the feature space. Combined with CNN and Transformer, ACT enables cross-domain coupling of multimodal features and modelling of long-range dependencies. Experimental results show that compared with traditional recommendation models, ACT achieves optimal performance in four error metrics, demonstrating the high accuracy for aerospace popular science exhibit recommendation. When embedded in the aerospace cloud museum and validated by flow theory, the personalized recommendation system realizes tailored knowledge recommendation for different user groups, assists users in entering the flow state, and effectively enhances visit satisfaction and the depth of scientific knowledge memory. This research provides technical support and theoretical references for innovating aerospace science education models.},
}

