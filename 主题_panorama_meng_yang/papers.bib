@misc{panorama_meng_yang_1cf9164e04807cb7,
  title = {Petri net and GASA based approach for FSP with multi-workstation operation},
  author = {Meng Yang and Ze Tao},
  year = {2010},
  doi = {10.1109/icinfa.2010.5512365},
  url = {https://doi.org/10.1109/icinfa.2010.5512365},
  howpublished = {IEEE International Conference on Information and Automation (ICIA)},
  annotation = {中文辅助译名：基于 Petri 网和 GASA 的 FSP 多工作站操作方法},
  abstract = {A new flow shop scheduling problem (FSP) is studied, which is abstracted from the auto assemble workshop. The problem is characterized by multi-workstation operation and stopping line operation, and fluctuant processing time. So the problem is very complicated. Firstly, the math model of this scheduling problem is constructed, and then the Petri net model is constructed based on the math model. The scheduling results are obtained based on hybrid algorithm of genetic algorithm and simulated annealing algorithm (GASA) with minimizing the completion time as function objective. Lastly, testing and analyzing the performance of scheduling results through 2D animation simulation. The effectiveness of this method is tested on the real data from the assemble workshop in an auto factory in Beijing.},
}

@misc{panorama_meng_yang_1974318ad98a2b67,
  title = {Study of Network-based Intrusion Detection System for virtualization},
  author = {Zhen Wang and Meng Yang and Sheng Li},
  year = {2010},
  doi = {10.1109/iccet.2010.5486042},
  url = {https://doi.org/10.1109/iccet.2010.5486042},
  howpublished = {International Conference on Computer Engineering and Technology},
  annotation = {中文辅助译名：基于网络的虚拟化入侵检测系统研究},
  abstract = {Intrusion Detection System (IDS) through collecting and analyzing information from network and Host to check whether there are some signs about attack. Network-based Intrusion Detection System for Virtual Machine Environment is a novel approach to implement the traditional network-based IDS in virtual machine environment. The paper get the network packets from the virtual bridge which is a virtual device in virtual machine used to transmit packets from physical device to virtual interface. Considering of the DHCP, virtual machine's IP address is variable, and so we use the MAC address to identify a virtual machine's network interface. The real system test shows that VNIDS has a complete function implement about what provide an IDS which is suitable to the virtual machine environment.},
}

@misc{panorama_meng_yang_ec46fa70b3f456a9,
  title = {Metaface learning for sparse representation based face recognition},
  author = {Meng Yang and Lei Zhang and Jian Yang and David Zhang},
  year = {2010},
  doi = {10.1109/ICIP.2010.5652363},
  url = {https://doi.org/10.1109/ICIP.2010.5652363},
  howpublished = {ICIP},
  annotation = {中文辅助译名：基于稀疏表示的人脸识别的元脸学习},
  abstract = {Face recognition (FR) is an active yet challenging topic in computer vision applications. As a powerful tool to represent high dimensional data, recently sparse representation based classification (SRC) has been successfully used for FR. This paper discusses the metaface learning (MFL) of face images under the framework of SRC. Although directly using the training samples as dictionary bases can achieve good FR performance, a well learned dictionary matrix can lead to higher FR rate with less dictionary atoms. An SRC oriented unsupervised MFL algorithm is proposed in this paper and the experimental results on benchmark face databases demonstrated the improvements brought by the proposed MFL algorithm over original SRC.},
}

@misc{panorama_meng_yang_d037f8aed288c0c9,
  title = {On the Dimensionality Reduction for Sparse Representation Based Face Recognition},
  author = {Lei Zhang and Meng Yang and Zhizhao Feng and David Zhang},
  year = {2010},
  doi = {10.1109/ICPR.2010.308},
  url = {https://doi.org/10.1109/ICPR.2010.308},
  howpublished = {ICPR},
  annotation = {中文辅助译名：基于稀疏表示的人脸识别降维研究},
  abstract = {Face recognition (FR) is an active yet challenging topic in computer vision applications. As a powerful tool to represent high dimensional data, recently sparse representation based classification (SRC) has been successfully used for FR. This paper discusses the dimensionality reduction (DR) of face images under the framework of SRC. Although one important merit of SRC is that it is insensitive to DR or feature extraction, a well trained projection matrix can lead to higher FR rate at a lower dimensionality. An SRC oriented unsupervised DR algorithm is proposed in this paper and the experimental results on benchmark face databases demonstrated the improvements brought by the proposed DR algorithm over PCA or random projection based DR under the SRC framework.},
}

@misc{panorama_meng_yang_0a61d1a17d978b65,
  title = {Developing of mobile-game based on J2ME technology},
  author = {Zhen Wang and Zhidong Xiao and Meng Yang},
  year = {2010},
  doi = {10.1109/iccda.2010.5541482},
  url = {https://doi.org/10.1109/iccda.2010.5541482},
  howpublished = {International Conference on Computer Design and Applications (ICCDA)},
  annotation = {中文辅助译名：基于J2ME技术的手机游戏开发},
  abstract = {Based on the research and analysis of mobile telephone game development technology, this dissertation has studied the theory and implementation of the 2D mobile telephone game engine framework based on J2ME. This dissertation introduced the key development problems, such as: how to control the game flow, how to paint the animation and how to respond key-press events, and also introduced the corresponding solutions. Aim to practice application; the dissertation implemented a mobile telephone game. The reflection of this software is very good, indicated the design thoughts are appropriate. Finally, this dissertation discussed the transplant methods.},
}

@misc{panorama_meng_yang_8957b7d7dd82be73,
  title = {The Effects of Chinese Dialect on English Phonetic Expression in Xiang,Gan Dialect Areas——Take PingXiang Dialect as an example},
  author = {Meng Yang},
  year = {2008},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=YCSB2008S1029},
  howpublished = {Journal of Yichun College},
  annotation = {中文辅助译名：湘、赣方言地区汉语方言对英语语音表达的影响——以凭祥方言为例},
  abstract = {As for the English learners who grow up in dialects areas,the dialects have a deep influence on their second language learning.Taking method of comparison,we can analyze the similarities and differences between Pingxiang dialect and English in terms of the systems of vowels and consonants,point out the positive transfer and negative transfer and put forward practical suggestions to the English learners in the Xiang and Gan dialect areas.},
}

@misc{panorama_meng_yang_3cf907d87dc1855d,
  title = {Two odds-radio-based text classification algorithms},
  author = {Zhihong Deng and Shiwei Tang and Dongqing Yang and Ming Zhang and Xiaobin Wu and Meng Yang},
  year = {2005},
  doi = {10.1109/wisew.2002.1177866},
  url = {https://doi.org/10.1109/wisew.2002.1177866},
  howpublished = {International Conference on Web Information Systems Engineering (WISE)},
  annotation = {中文辅助译名：两种基于概率无线电的文本分类算法},
  abstract = {Since 1990's, the exponential growth of theseWeb documents has led to a great deal of interestin developing efficient tools and software toassist users in finding relevant information. Textclassification has been proved to be useful inhelping organize and search text information onthe Web. Although there have been existed anumber of text classification algorithms, most ofthem are either inefficient or too complex. In thispaper we present two Odds-Radio-Based textclassification algorithms, which are called ORand TF*OR respectively. We have evaluated ouralgorithm on two text collections and compared itagainst k-NN and SVM. Experimental resultsshow that OR and TF*OR are competitive withk-NN and SVM. Furthermore, OR and TF*OR ismuch simpler and faster than them. The resultsalso indicate that it is not TF but relevancefactors derived from Odds Radio that play thedecisive role in document categorization.},
}

@misc{panorama_meng_yang_2c542157a2985cd0,
  title = {SRFW: a simple, fast and effective text classification algorithm},
  author = {Zhihong Deng and Shiwei Tang and Dongqing Yang and Ming Zhang and Xiaobin Wu and Meng Yang},
  year = {2003},
  doi = {10.1109/icmlc.2002.1167407},
  url = {https://doi.org/10.1109/icmlc.2002.1167407},
  howpublished = {International Conference on Machine Learning and Cybernetics},
  annotation = {中文辅助译名：SRFW：一种简单、快速、有效的文本分类算法},
  abstract = {Text classification is a powerful technique for automating assignment of documents to topic hierarchies. Although there are a number of text classification algorithms, most of them are either inefficient or too complex. We present a linear text classification algorithm called SRFW, which is fast, effective and easily used. SRFW obtains relevance factors. For new unlabelled documents, SRFW adopts sum of weights based on relevance factors to obtain the probability that these documents belong to each category and assigns them to categories that have the biggest probability. We have evaluated our algorithm on a subset of Reuters-21578 and 20-newsgroups text collections and compared it against k-NN and SVM. Experimental results show that SRFW is competitive with k nearest neighbor (k-NN) and support vector machines (SVM), while SRFW is much simpler and faster than them.},
}

