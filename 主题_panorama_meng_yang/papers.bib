@misc{panorama_meng_yang_09549a0e5d97c170,
  title = {Sensitivity Analysis of Transmission Tower-Line Systems Under Tornado},
  author = {Wenqi Fan and Zhenguo Wang and Meng Yang and Mingchuan Ni},
  year = {2026},
  doi = {10.1109/ecitech69277.2026.11601744},
  url = {https://doi.org/10.1109/ecitech69277.2026.11601744},
  howpublished = {International Conference on Electrical, Control and Information Technology (ECITech)},
  annotation = {中文辅助译名：龙卷风下输电塔线系统的敏感性分析},
  abstract = {Transmission lines, as vital components of modern power systems, are highly susceptible to damage from tornadoes due to their elevated structures and extreme sensitivity to wind loads. This paper therefore analyses their vulnerability under tornado wind fields by establishing a three-dimensional finite element model of the transmission line. The Baker-Sterling model was selected to generate tornado loads, and finite element modelling was performed on an 800kV ultra-high voltage transmission line. Sensitivity analysis was conducted using four key tornado wind field parameters to assess their respective impacts on the transmission line. Results indicate that maximum wind speed (VF) and vortex core radius (rm) are significant parameters influencing transmission tower structural response, whereas vortex ratio (S) and the ratio of maximum wind speed to translational wind speed (Gmax) exert relatively minor effects. Specifically, the displacement increase at the tower top caused by VF and rm exceeds 50%, whereas the changes induced by S and Gmax are both less than 10%. This study provides a ranking of key parameter influences for future tornado-resistant transmission tower design, thereby enhancing the disaster prevention and mitigation capabilities of power systems.},
}

