@misc{panorama_meng_yang_abc77ab9d3cd6a21,
  title = {Microservice Container Load Trend Prediction based on Informer and Batch Normalization},
  author = {Dequan Gao and Meng Yang and Bing Zhang and Bao Feng},
  year = {2023},
  doi = {10.1109/aees59800.2023.10469263},
  url = {http://dx.doi.org/10.1109/aees59800.2023.10469263},
  howpublished = {International Conference on Advanced Electrical and Energy Systems (AEES)},
  annotation = {中文辅助译名：基于Informer和Batch Normalization的微服务容器负载趋势预测},
  abstract = {The microservice container load refers to the workload and resource consumption carried by the microservice during operation. With the increasing scale of microservice application systems, the existing passive cloud resource management and control model has been unable to meet the needs of large-scale microservice operation and MAINTENANCE. To address this issue, we introduce a load trend forecasting model tailored for microservice containers, which leverages the Informer model in conjunction with Batch Normalization. Our proposed approach demonstrates significant efficacy in precisely forecasting container loads. It adeptly resolves the persistent issues associated with missing data and the efficiency limitations encountered when dealing with large-scale data, which have posed challenges for existing models.},
}

