  abstract = {This paper studies how to use data mining technology to optimize economic decision support system. Traditional economic decision models often rely on static rules and assumptions, which are difficult to cope with the ever-changing economic environment. This study proposes a data mining optimization algorithm based on multi-model forecast fusion, which combines regression analysis, SVM and neural network, and improves the adaptability and accuracy of the model through a hierarchical structure. Experimental results show that the proposed model is significantly better than the traditional model in multiple economic forecasting tasks, especially when the economic fluctuations are large, it can provide more accurate decision support. In the specific experiment, historical economic data was used for training and verification, and the mean square error (MSE) of the model was reduced by more than 15% compared with the traditional model, and the real-time and accuracy of the decision were greatly improved. Through comparative experiments, this paper proves the effectiveness of the multi-model fusion strategy in economic decision-making and demonstrates its great potential in practical applications.},
}

@misc{panorama_meng_yang_2e465d55e2c3b878,
  title = {Anomaly Detection in Microservices Systems via Call Chain Analysis and Machine Learning},
  author = {Jing Du and Meng Yang and Yue Shao and Feng Zhang and Sihan Tian},
  year = {2025},
  doi = {10.3233/atde250652},
  url = {https://doi.org/10.3233/atde250652},
  howpublished = {Advances in transdisciplinary engineering},
  annotation = {中文辅助译名：通过调用链分析和机器学习检测微服务系统中的异常},
  abstract = {Microservices architecture, with its scalability and modularity, has become the foundation for modern distributed systems. However, the complexity of service interactions, often represented as intricate service call chains, creates challenges in identifying anomalies accurately and efficiently. This paper introduces an innovative framework for anomaly detection in microservices-based systems, integrating call chain analysis with machine learning techniques. The framework leverages distributed tracing data to construct Service Dependency Graphs (SDGs) and extract critical features, including temporal metrics such as latency and topological metrics like dependency weights. These features are processed by advanced machine learning models, including Isolation Forests and Long Short-Term Memory (LSTM) networks, to detect anomalous patterns in real time. Experimental results on a cloud-native microservices platform demonstrate the framework’s high performance, achieving an F1-score of 94.3% while reducing detection latency by over 70% compared to traditional rule-based methods. Additionally, the framework exhibits robust scalability, maintaining low detection delays even under increasing service complexity. This work provides a practical and scalable solution for enhancing anomaly detection in dynamic and large-scale microservices environments.},
}

