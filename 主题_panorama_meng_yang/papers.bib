@misc{panorama_meng_yang_8ca84edd34e0cb6e,
  title = {Human-Interaction Weakly-Supervised Deep Networks for Semantic Segmentation},
  author = {Wenfeng Luo and Meng Yang},
  year = {2019},
  doi = {10.1109/ICMEW.2019.0-114},
  url = {https://doi.org/10.1109/ICMEW.2019.0-114},
  howpublished = {ICME Workshops},
  annotation = {中文辅助译名：用于语义分割的人机交互弱监督深度网络},
  abstract = {Weakly-supervised semantic segmentation models help relieve the burden on data labeling. However, there is a huge performance gap between weakly-supervised and fully-supervised models since weakly-supervised models have trouble in recognizing co-occurring objects and non-discriminative object regions, especially when weak supervision of image-level label is considered. In this work, we propose a unified framework to bring in human interaction to assist with weakly-supervised model at inference stage. The proposed method, Human-Interaction WeaklySupervised Deep Networks (HIWSDN), utilizes humandrawn squiggles and seed map from classification network to dynamically update the trained weakly-supervised model. HIWSDN achieves superior segmentation performance, which is a 5.6% improvement over the original weakly-supervised model.},
}

@misc{panorama_meng_yang_cd2bb0fdf646619d,
  title = {Semantic GAN: Application for Cross-Domain Image Style Transfer},
  author = {Pengfei Li and Meng Yang},
  year = {2019},
  doi = {10.1109/ICME.2019.00161},
  url = {https://doi.org/10.1109/ICME.2019.00161},
  howpublished = {ICME},
  annotation = {中文辅助译名：语义GAN：跨域图像风格迁移的应用},
  abstract = {Image style transfer has attracted much attention from many fields and received promising performance. However, style transfer in the cross-domain field, e.g., the transfer between near-infrared and visible light images, is rarely studied. In the cross-domain image style transfer, one key issue is mismatching problem existing in the generated semantic regions. In this paper, we propose a novel model of Semantic GAN, which integrates the semantic guidance and the recent CycleGAN. In particular, we present a semantic style loss with Gram matrix to well preserve the semantic information in the generated images. The proposed Semantic GAN can control the transfer in the right way with semantic masks and solve the mismatching problem. We apply our approach to two outdoor scene datasets to evaluate the performance of all competing methods. The experimental results show that our approach outperforms previous methods in addressing the mismatching problem and providing a good quality result.},
}

@misc{panorama_meng_yang_7be74070f3a085f2,
