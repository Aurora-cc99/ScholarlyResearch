@misc{panorama_jinyi_long_5356403359adfdf5,
  title = {Calibration-free Plug-and-Play EEG-based BCIs},
  author = {Hanrui Wu and Ge Zhang and Junkang Liao and Jia Zhang and Wei‐Shi Zheng and Jinyi Long},
  year = {2026},
  doi = {10.1109/tpami.2026.3725079},
