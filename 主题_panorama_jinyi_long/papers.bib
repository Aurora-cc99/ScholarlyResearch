  title = {Novel lower limb robot-assisted gait phase stimulation enhances walking and balance in stroke patients: a pilot trial},
  author = {Yixuan Huang and Yuting Tang and Zhanpeng Zhang and Longbin Shen and Zhenpeng Guo and Zhuoming Chen and Jinyi Long},
