@misc{panorama_jinyi_long_0dc7d9da4ca851b7,
  title = {Novel Approach to Transfer of Coordination Skills to the Paretic Hand by Improving the Efficiency of Cortical Network},
  author = {Jinyi Long and Longbin Shen and Qiuwen Cai and Shan Zhu Xiao and Zhuoming Chen},
