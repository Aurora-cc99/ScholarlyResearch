@misc{panorama_jinyi_long_7fb47298dfd6f1aa,
  title = {Transfer of Coordination Skill to the Unpracticed Hand in Immersive Environments},
  author = {Shan Xiao and Xupeng Ye and Yaqiu Guo and Boyu Gao and Jinyi Long},
  year = {2020},
