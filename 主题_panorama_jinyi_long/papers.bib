@misc{panorama_jinyi_long_339bbc790e8defc5,
  title = {Joint channel-frequency selection for motor imagery-based BCIs using a semi-supervised SVM algorithm},
  author = {Yuanqing Li and Jinyi Long},
  year = {2010},
  url = {http://yadda.icm.edu.pl/yadda/element/bwmeta1.element.ieee-000005573278},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：使用半监督 SVM 算法进行基于运动想象的 BCI 的联合通道频率选择},
  abstract = {In this paper, motor imagery-based Brain computer interfaces (BCIs) are considered, in which channels and frequency band are two important parameters. A semi-supervised support vector machine algorithm is proposed for joint channel-frequency selection automatically and adaptively. This algorithm is designed for small training data case, in which the training data set is insufficient for parameter setting. Our algorithm is then applied to a BCI competition data set. Data analysis results are presented and the effectiveness of this algorithm is demonstrated.},
}

