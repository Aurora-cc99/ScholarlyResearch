@misc{wei_bang_jiang_016ea5742910,
  title = {LaBraM: A General Large Model for EEG Representation Learning},
  author = {Wei-Bang Jiang and Bao‐Liang Lu and Li-Ming Zhao},
  year = {2026},
  doi = {10.1201/9781003616719-11},
  url = {https://doi.org/10.1201/9781003616719-11},
  howpublished = {CRC Press eBooks},
  annotation = {中文辅助译名：LaBraM：脑电图表示学习的通用大型模型},
  abstract = {Most existing deep learning models for electroencephalogram (EEG) analysis are tailored to specific datasets and brain-computer interface (BCI) applications, restricting their scalability, perceptual capacity, and generalization ability. Inspired by the remarkable success of Large Language Models (LLMs) in natural language processing, we explore the development of Large EEG Models (LEMs) that can achieve universal EEG understanding through large-scale unsupervised pre-training and subsequent task-specific fine-tuning. Unlike text data, EEG signals are limited in quantity and exhibit diverse structures, such as varying electrode configurations, unequal sequence lengths, heterogeneous experimental protocols, and low signal-to-noise ratios. To address these challenges, we introduce the Large Brain Model (LaBraM), a unified foundation model for EEG. LaBraM achieves cross-dataset learning by segmenting EEG recordings into channel-wise patches and employing vector-quantized neural spectrum prediction to build a semantically meaningful neural tokenizer that compresses continuous EEG patches into discrete representations. A Transformer backbone is then pre-trained to reconstruct masked neural codes, enabling deep semantic understanding of EEG dynamics. Trained on approximately 2,500 hours of data from over 20 EEG datasets, LaBraM demonstrates strong generalization across multiple downstream tasks—including abnormality detection, event classification, emotion recognition, and gait pre},
}

