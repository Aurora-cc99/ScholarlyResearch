@misc{panorama_wanqing_wu_f72973dae34b1b53,
  title = {The treatment of selected traditional Chinese medicine prescriptions and their metabolites for heart failure with preserved ejection fraction from basic science discovery to the clinic},
  author = {Yanhong Zhang and Wanqing Wu and Xi Zhai and Jingkai Zhang and Weidong Wang and Xinyuan Huang and Lan Wu},
  year = {2026},
  doi = {10.3389/fphar.2026.1927962},
  url = {https://doi.org/10.3389/fphar.2026.1927962},
  howpublished = {Frontiers in Pharmacology},
  annotation = {中文辅助译名：精选中药方剂及其代谢物治疗射血分数保留性心力衰竭从基础科学发现到临床},
  abstract = {The prevalence of heart failure with preserved ejection fraction (HFpEF) continues to rise worldwide. Compared with heart failure with reduced ejection fraction, HFpEF is associated with significant morbidity and mortality, yet only a limited number of treatment options have been proven effective. This narrative review aims to summarize the pathophysiological mechanisms of HFpEF and the pharmacological therapeutic strategies for this condition. Through a search of relevant literature from PubMed, VIP, Wanfang Data, and CNKI, basic research and clinical data on HFpEF were collected. The process involved examining and analyzing research on mechanisms and treatments of HFpEF. Based on both basic research and clinical data, this paper discussed the key roles of anti-inflammatory effects, anti-oxidant effects, and the reversal of mitochondrial dysfunction in improving cardiac remodeling, cardiac dysfunction and exercise intolerance in HFpEF. Furthermore, the paper suggested that Traditional Chinese Medicine (TCM), including metabolites and prescriptions, may serve as a potential therapeutic strategy for HFpEF and some prescriptions may serve as a potential adjuvant to guideline-directed medical therapy. In the future, it is hoped that the prognosis for patients with HFpEF by promoting the usage of TCM can be improved.},
}

@misc{panorama_wanqing_wu_9666477ba30ea32b,
  title = {Enhancing Generalization for EEG-Based Emotion Recognition Models With the Personality Cross-Attention Mechanism},
  author = {Yao Pi and Ming Li and Xianbin Zhang and Wei Wu and Xuanhao Qi and Jihui Yue and Guibin Bian and Wanqing Wu},
  year = {2026},
  doi = {10.1109/tmm.2026.3673551},
  url = {https://doi.org/10.1109/tmm.2026.3673551},
  howpublished = {IEEE Transactions on Multimedia},
  annotation = {中文辅助译名：利用人格交叉注意机制增强基于脑电图的情绪识别模型的泛化},
  abstract = {In EEG-based affective computing, addressing individual differences for model generalizability is crucial. Psychological research has demonstrated that personality traits significantly influence emotional perception, thereby introducing individual response specificity. Existing public datasets employed the Big Five personality scale and few-channel EEG sensors. As a supplement, we developed a dataset employing the widely utilized Eysenck personality scale in clinical settings and 32-channel EEG sensors. Our investigation into personality traits and EEG topography reveals that variations in personality traits significantly influence emotional EEG response patterns. Building on these findings, we propose a novel Personality Cross-Attention Mechanism (PCAM) designed to enhance the generalization capability of mainstream emotion recognition models. This mechanism leverages insights from psychology and neuroscience to improve model performance. Empirical evaluations on AMIGOS and our proprietary dataset demonstrate that PCAM effectively enhances the generalization ability of mainstream emotion recognition models, including CNN-LSTM, EEGNet, ACRNN, and Conformer. Furthermore, visualization of the PCAM weights reveals its ability to discern differences in emotional EEG responses associated with different personality traits, thereby providing explainability for the observed improvements in model generalization ability.},
}

@misc{panorama_wanqing_wu_27fab0630388,
  title = {Emotion effects on spatiotemporal brain-heart interactions with convergent cross mapping},
  author = {Xiaqi Zeng and Xianbin Zhang and Hanrui Dong and Guibin Bian and Victor Hugo C. de Albuquerque and Wanqing Wu},
  year = {2026},
  doi = {10.1088/1361-6579/ae7c55},
  url = {https://doi.org/10.1088/1361-6579/ae7c55},
  howpublished = {Physiological Measurement},
  annotation = {中文辅助译名：情绪对时空脑心相互作用的影响与收敛交叉映射。生理测量},
  abstract = {Interactions linking the heart to changes in brain organization offer insights into how central and peripheral systems jointly contribute to affective processing. Conventional approaches to brain-heart interaction, which rely primarily on EEG rhythms and heart rate variability, fail to capture the heartbeat-resolved dynamics that characterize the bidirectional interaction between cortical and cardiac activity. We apply convergent cross mapping, a nonlinear causality framework, to 32-channel EEG and single-lead ECG signals recorded during validated virtual reality videos designed to elicit positive or negative affect. By modeling heartbeat-evoked potentials and full cardiac waveforms as evolving dynamical systems, we observed pronounced directional asymmetry in emotion-related brain-heart interactions: descending coupling patterns were stronger, more sustained, and spatially focused than ascending effects. Positive and negative emotional conditions were associated with differential bidirectional coupling patterns, with preferential enhancement of descending cortical-to-cardiac interactions. Spatially, modulation was left-lateralized, with a concentration in frontal and central electrodes. These findings advance embodied models of affect by demonstrating that such interactions are both directionally asymmetric and hemispherically organized, positioning cardiac dynamics as an actively involved component of emotion-related brain-heart coordination.},
}

