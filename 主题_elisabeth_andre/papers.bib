@misc{elisabeth_andre_acee3a19171ac95c,
  title = {Traveller: An Intercultural Training System with Intelligent Agents (Demonstration)},
  author = {Samuel F. Mascarenhas and André Silva and Ana Paiva and Ruth S. Aylett and Felix Kistler and Elisabeth André and Nick Degens and Gert Jan Hofstede and Arvid Kappas},
  year = {2013},
  url = {http://www.ifaamas.org/Proceedings/aamas2013/docs/p1387.pdf},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：旅行者：具有智能代理的跨文化培训系统（演示）},
  abstract = {There is a growing demand for new forms of intercultural training. We describe a demonstration of an agent-based application designed to teach young adults (18-25) general patterns of behaviour that can distinguish a broad range of cultures. Training is done through an interactive-story telling approach where the user must go through a series of critical incidents, interacting with agents capable of simulating dierent synthetic cultures in their behaviour.},
}

@misc{elisabeth_andre_eae46fddd745b666,
  title = {Traveller: Interacting with agents to deal with misunderstandings due to culture},
  author = {Nick Degens and André Silva and Gert Jan Hofstede and Arvid Kappas and Samuel Mascarenhas and Ruth Aylett and Elisabeth André and Felix Kistler and Ana Paiva},
  year = {2013},
