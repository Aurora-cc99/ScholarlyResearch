@misc{elisabeth_andre_d21ea79bcd374abc,
  title = {Voice Design Compass: Guidance for Developing and Reflecting on Voice Concepts for Embodied Characters},
  author = {Johanna Magdalena Kuch and Anna Lea Reinwarth and Bernhard Hilpert and Laura Kanschat and Tanja Schneeberger and Elisabeth André},
  year = {2026},
  doi = {10.21203/rs.3.rs-11221361/v1},
  url = {https://doi.org/10.21203/rs.3.rs-11221361/v1},
  howpublished = {Research Square},
  annotation = {中文辅助译名：语音设计指南针：开发和反思具体角色语音概念的指南},
  abstract = {An embodied character's voice can shape how we perceive the whole character. Nevertheless, the voice is often overlooked during the planning process, or no explanation is given as to why certain approaches were chosen. We present the Voice Design Compass, a conceptual framework for developing, reviewing, and documenting voice concepts for embodied characters. A voice concept describes how a character's voice should sound and be perceived. It provides a basis for voice selection and production. The Voice Design Compass offers questions to help designers consider early on what influences their voice choices and which unintended effects they might otherwise overlook. These questions address, for example, how a voice relates to the character's appearance, whom it might remind users of, and whether it could reinforce stereotypes.We developed a literature-informed prototype. Ten domain experts from research and industry reviewed its written questions, examples and workflow in formative think-aloud interviews. Qualitative content analysis identified experts' accounts of component relevance, process structure, potential support for design work, and reflection. Needs for change concerned missing content, wording, conceptual distinctions, ease of understanding, cognitive load, and overall organization. Experts suggested using the prototype to clarify requirements, communicate intentions, and revisit decisions across project phases, identifying researchers, practitioners, and non-expert},
}

