@misc{elisabeth_andre_517d3c8fb3cd8eff,
  title = {Development of a Multi-Device Nutrition Logging Prototype Including a Smartscale},
  author = {Andreas Seiderer and Elisabeth André},
  year = {2017},
  doi = {10.1145/3079452.3079486},
  url = {https://doi.org/10.1145/3079452.3079486},
  howpublished = {DH},
  annotation = {中文辅助译名：开发包括智能秤在内的多设备营养记录原型},
  abstract = {In this work we present a portable system for nutrition logging that integrates multiple devices and modalities in order to facilitate food and drink tracking. The system consists of a smartphone, a smartwatch and a smartscale that can be combined flexibly by users depending on the current situation and their personal needs. Based on a requirement analysis, we present the rationale behind the design and implementation of our food and drink logger. We also report the preliminary results of an in-situ study we conducted in order to explore the potential benefits and challenges of a multi-device approach to nutrition tracking in daily life settings.},
}

@misc{elisabeth_andre_c0bf00d1b646bd76,
  title = {Towards a Gamified Recommender System for the Elderly},
  author = {Andreas Seiderer and Madita Herpich and Elisabeth André and Thomas Rist},
  year = {2017},
  doi = {10.1145/3079452.3079500},
  url = {https://doi.org/10.1145/3079452.3079500},
  howpublished = {DH},
  annotation = {中文辅助译名：面向老年人的游戏化推荐系统},
  abstract = {Starting from our previous work on a digital picture frame - the CARE system - that interleaves a picture display mode with a recommender mode to promote a healthy life-style and to increase well-being of elderly people, this paper investigates the use of gamification as a means to increase user appreciation of the CARE system. To this end, we arranged two co-design workshops with peer-groups of senior citizens. We report on outcomes of the workshops and draw conclusions for a gamified version of CARE.},
}

@misc{elisabeth_andre_0e83c1e6ac58a51e,
  title = {Temporal Visualization of Energy Consumption Loads Using Time-Tone},
  author = {Ida Buchwald and Elisabeth André and Masood Masoodian and Saturnino Luz},
  year = {2017},
  doi = {10.1109/IV.2017.13},
  url = {https://doi.org/10.1109/IV.2017.13},
  howpublished = {IV},
  annotation = {中文辅助译名：使用时间音对能源消耗负载进行时间可视化},
  abstract = {Feedback plays an important role in assisting users to better understand their energy consumption behaviour. This is particularly true when users want to change their behaviour in order to reduce their energy consumption, and to manage their usage more effectively so as to avoid putting unnecessary load on energy providers. This paper presents the time-tone visualization, which aims to assist users by displaying variations in energy consumption by different categories of household devices over time, and their respective contributions to the total energy usage load. A user study conducted to compare time-tone against area-charts shows that although the two visualizations are comparable, time-tone is more effective for cases where there are large variations in energy usage loads.},
}

