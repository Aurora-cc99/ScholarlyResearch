@misc{elisabeth_andre_bc93054f96e13682,
  title = {Self-Supervised Transformer With Masked Latent Representations for Multimodal Biometric Authentication},
  author = {Mohamed Benouis and Yekta Said Can and Elisabeth André},
  year = {2025},
  doi = {10.1109/IWBF63717.2025.11113468},
