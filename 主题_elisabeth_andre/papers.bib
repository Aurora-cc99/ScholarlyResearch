@misc{elisabeth_andre_346879bf13eb486e,
  title = {Trust-based decision-making for the adaptation of public displays in changing social contexts},
  author = {Ekaterina Kurdjokova and Michael Wissner and Stephan Hammer and Elisabeth André},
  year = {2013},
  doi = {10.1109/PST.2013.6596068},
  url = {https://doi.org/10.1109/PST.2013.6596068},
  howpublished = {PST},
  annotation = {中文辅助译名：基于信任的决策，以适应不断变化的社会环境中的公共展示},
  abstract = {Public displays may adapt intelligently to the social context, tailoring information on the screen, for example, to the profiles of spectators, their gender or based on their mutual proximity. However, such adaptation decisions should on the one hand match user preferences and on the other maintain the user’s trust in the system. A wrong decision can negatively influence the user’s acceptance of a system, cause frustration and, as a result, make users abandon the system. In this paper, we propose a trust-based mechanism for automatic decision-making, which is based on Bayesian Networks. We present the process of network construction, initialization with empirical data, and validation. The validation demonstrates that the mechanism generates accurate decisions on adaptation which match user preferences and support user trust.},
}

