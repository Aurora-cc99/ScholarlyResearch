@misc{elisabeth_andre_923cc32bc018ab21,
  title = {Social signal processing for dummies},
  author = {Frank Gaibler and Ionut Damian and Michael Dietz and Elisabeth André},
  year = {2016},
  doi = {10.1145/2993148.2998527},
