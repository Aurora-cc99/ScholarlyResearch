@misc{elisabeth_andre_bf728cdb1fb2887a,
  title = {The use of affective and attentive cues in an empathic computer-based Companions},
  author = {Nikolaus Bee and Elisabeth André and Thurid Vogt and Patrick Gebhard},
  year = {2010},
  doi = {10.1075/nlp.8.19bee},
  url = {https://doi.org/10.1075/nlp.8.19bee},
  howpublished = {Natural language processing},
  annotation = {中文辅助译名：在基于计算机的同理心同伴中使用情感和注意力线索},
  abstract = {Recently, a number of research projects have been started to create virtual agents that do not just serve as assistants to which tasks may be delegated, but that may even take on the role of a Companion. Such agents require a great deal of social intelligence, such as the ability to detect the user’s affective state and to respond to it in an empathic manner. The objective of our work is to create an empathetic listener that is capable to react on affective and attentive input cues of the user. In particular, we discuss various forms of empathy and how they may be realized based on these cues.},
}

@misc{elisabeth_andre_79a161c8482bd1cd,
  title = {Discovering eye gaze behavior during human-agent conversation in an interactive storytelling application},
  author = {David Pizzi and Nikolaus Bee and Johannes Wagner and Fred Charles and Thurid Vogt and Elisabeth André and Marc Cavazza},
  year = {2010},
  doi = {10.1145/1891903.1891915},
  url = {https://doi.org/10.1145/1891903.1891915},
  howpublished = {ICMI-MLMI},
  annotation = {中文辅助译名：在交互式讲故事应用程序中发现人与代理对话期间的目光注视行为},
  abstract = {In this paper, we investigate the user's eye gaze behavior during the conversation with an interactive storytelling application. We present an interactive eye gaze model for embodied conversational agents in order to improve the experience of users participating in Interactive Storytelling. The underlying narrative in which the approach was tested is based on a classical XIXth century psychological novel: Madame Bovary, by Flaubert. At various stages of the narrative, the user can address the main character or respond to her using free-style spoken natural language input, impersonating her lover. An eye tracker was connected to enable the interactive gaze model to respond to user's current gaze (i.e. looking into the virtual character's eyes or not). We conducted a study with 19 students where we compared our interactive eye gaze model with a non-interactive eye gaze model that was informed by studies of human gaze behaviors, but had no information on where the user was looking. The interactive model achieved a higher score for user ratings than the non-interactive model. In addition we analyzed the users' gaze behavior during the conversation with the virtual character.},
}

@misc{elisabeth_andre_f9310aa7e51cc15f,
  title = {Multimodal interaction with a virtual character in interactive storytelling},
  author = {Nikolaus Bee and David Pizzi and Johannes Wagner and Marc Cavazza and Elisabeth André and Fred Charles},
  year = {2010},
  doi = {10.5555/1838206.1838468},
  url = {http://hdl.handle.net/10149/100057},
  howpublished = {AAMAS},
  annotation = {中文辅助译名：在交互式讲故事中与虚拟角色的多模式交互},
  abstract = {A number of interactive storytelling (IS) systems offer the user the possibility to input natural language input which \ndetermines how a story progresses. We introduce a framework for real-time signal processing (SSI) to analyze the users’ state which then can influence the feelings of the story characters and their actions in the story. SSI is not only used to enable more natural character responses that are sensitive to the user’s state at runtime. In addition SSI offers the possibility to collect a large variety of synchronized user data which can be used to analyze the user’s experience in offline mode. The underlying narrative in which the approach was tested is based on a classical XIXth century psychological novel: Madame Bovary, by Flaubert.},
}

@misc{elisabeth_andre_d79fb811bb63e25f,
  title = {Gaze behavior during interaction with a virtual character in interactive storytelling},
  author = {Nikolaus Bee and Johannes Wagner and Elisabeth André and Thurid Vogt and Fred Charles and David Pizzi and Marc Cavazza},
  year = {2010},
  url = {http://hdl.handle.net/10149/110554},
  howpublished = {学术期刊/预印本},
  annotation = {中文辅助译名：在交互式讲故事中与虚拟角色互动时的注视行为},
  abstract = {In this paper, we present an interactive eye gaze model for embodied conversational agents in order to improve the experience of users participating in Interactive Storytelling. The underlying narrative in which the approach was tested is based on a classical XIX th century psychological novel: Madame Bovary, by Flaubert. At various stages of the narrative, the user can address the main character or respond to her using free-style spoken natural language input, impersonating her lover. An eye tracker was connected to enable the interactive gaze model to respond to user’s current gaze (i.e. looking into the virtual character’s eyes or not). We conducted a study with 19 students where we compared our interactive eye gaze model with a non-interactive eye gaze model that was informed by studies of human gaze behaviors, but had no information on where the user was looking. The interactive model achieved a higher score for user ratings than the non-interactive model.},
}

