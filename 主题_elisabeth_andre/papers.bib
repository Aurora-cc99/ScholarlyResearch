@misc{elisabeth_andre_b50206f2568c222b,
  title = {Embodied Multimedia: From Multimedia Content to Situated Human-AI Interaction},
  author = {Elisabeth André},
  year = {2026},
  doi = {10.1145/3767308.3839347},
  url = {https://doi.org/10.1145/3767308.3839347},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：具身多媒体：从多媒体内容到情境式人机交互},
  abstract = {Multimedia research, which has traditionally been concerned with the analysis and generation of multimedia content, has increasingly addressed multimodal human behavior. This development is exemplified by current ACM Multimedia Challenges, including POLY-SIM [3], which addresses robust speaker identification under missing-modality and cross-lingual scenarios, MultiMediate [2], which targets engagement estimation across domain, age, and culture, and REACT [4], which focuses on generating appropriate facial reactions in dyadic interactions. Together, these challenges reflect a broader shift from analyzing multimedia content toward analyzing, understanding and generating multimodal behavior in increasingly complex social contexts. The next frontier is to develop embodied AI systems that understand, support, and fluently participate in situated human interaction. We pursue this vision through virtual agents and social robots that facilitate communication between people and AI and increasingly between people themselves. The talk will demonstrate how pretrained multimodal foundation models can be leveraged to create context-aware embodied AI. Drawing on applications in assistive communication, AI-mediated group discussions, and social coaching, the talk will illustrate how embodied agents enabled by these models can help overcome communication barriers, facilitate social interaction, and foster authentic self-expression. At the same time, significant challenges remain in grounding },
}

@misc{elisabeth_andre_6d5979ffc953611f,
  title = {Towards a Voice Design Tool to Support Game Masters of Tabletop Role-Playing Games},
  author = {Laura Kanschat and Johanna Magdalena Kuch and Daksitha Senel Withanage Don and N. Lynn Heimerl and Silvan Mertes and Elisabeth André},
  year = {2026},
  doi = {10.1145/3776574.3831159},
  url = {https://doi.org/10.1145/3776574.3831159},
  howpublished = {INTERNATIONAL CONFERENCE ON MULTIMODAL INTERACTION},
  annotation = {中文辅助译名：开发一款支持桌面角色扮演游戏高手的语音设计工具},
  abstract = {Tabletop role-playing games (TTRPGs) are collaborative storytelling experiences in which a human facilitator, the Game Master (GM), prepares and runs sessions while portraying non-player characters (NPCs), often through improvised voice acting. Creating distinct and consistent character voices can be challenging, especially in long-running or complex narratives, which motivates the need for supportive tools. To explore how voice design tools could support GMs in this context, we conducted a formative online survey among GMs and players (32 participants with GM experience and 28 participants who primarily played), designed a web-based voice design prototype called NPVoice, and evaluated it in five semi-structured interviews with experienced GMs. Our findings show that voice design tools are particularly promising for preparation-heavy use cases and static texts such as speeches, while being less suitable for dynamic in-game dialogue due to interaction and generation delays. At the same time, participants highlighted the potential of such tools to support player immersion and identified desirable features such as accents, monster voices, randomizers, and improved voice controls. Taken together, our work contributes an initial design exploration of voice design support for GMs and provides concrete implications for future design and research.},
}

@misc{elisabeth_andre_e12d3e467c88ff2c,
  title = {Explainable Autonomous Robots: Taxonomy, State, and Trends - An Implementation-driven Mapping Study},
  author = {Tobias Huber and Stina Klein and Moritz Schmidt and Amar Halilovic and Andreas Wiedholz and Shuyuan Shen and Elisabeth André},
  year = {2026},
  doi = {10.5281/ZENODO.21624794},
  url = {https://doi.org/10.5281/ZENODO.21624794},
  howpublished = {学术期刊/会议},
  annotation = {中文辅助译名：可解释的自主机器人：分类、状态和趋势 - 实施驱动的映射研究},
  abstract = {As autonomous robots increasingly operate in dynamic environments shared with humans, explaining their decisions and behaviors isessential for trust, transparency, and effective human-robot interaction. Although eXplainable Artificial Intelligence (XAI) has receivedsubstantial attention in recent years, challenges specific to eXplainable Autonomous Robot (XAR) remain underexplored. We reporta systematic mapping study of 94 papers (922 screened) published between 2021 and February 2026, providing empirical evidenceon how XAR research is implemented. Based on the analyzed papers, we derive a taxonomy spanning target platforms, softwarecharacteristics, explanation structures, stakeholders, and evaluation practices. With this, we categorize the reviewed literature andderive insights, trends and challenges for XAR research.The field demonstrates technical feasibility across diverse contexts. However, we identify clear opportunities: reversing the currenttrend from real-world validation to simulations (especially in Machine Learning (ML)-based systems), more explicit specification ofthe intended context of use, deeper investigation of human involvement, exploration of multi-agent/multi-stakeholder scenarios,and closer alignment between researchers’ focus on “Why” explanations and users’ broader question needs. Furthermore, currentevaluation practices are inconsistent in their initial motivation and measured results. Finally, XAR research forgoes comparativeanalysis and reproducibil},
}

@misc{elisabeth_andre_1fe32d49a0445bcb,
  title = {Virtual role-play in the classroom - experiences with FearNot!},
  author = {Sibylle Enz and Carsten Zoll and Natalie Vannini and Scott Watson and Ruth S. Aylett and Lynne E. Hall and Ana Paiva and Dieter Wolke C and Kerstin Dautenhahn and Elisabeth André and P. Rizzo},
  year = {2026},
  doi = {10.82444/warw.33614548},
  url = {https://doi.org/10.82444/warw.33614548},
  howpublished = {University of Warwick},
  annotation = {中文辅助译名：课堂上的虚拟角色扮演 - 体验 FearNot！},
  abstract = {FearNot! is a novel software application aimed at the age-group of 8-12 year old students with the aim to influence their attitude towards and knowledge about bullying. It is a virtual learning environment for social and emotional learning that allows for individual interaction with synthetic autonomous characters that engage in bullying and ask the learner for help and advice in order to escape victimisation. FearNot! uses an emergent narrative approach that generates stories through the interaction of the learner with the autonomous characters, a highly innovative and believable way to create engaging stories and evoke emotional learning in the user. Whether learning in the virtual environment transfers to real-world attitudes and behaviour about bullying is currently investigated in a comprehensive evaluation study, both in the UK and in Germany.},
}

@misc{elisabeth_andre_5cc66017ec21b494,
  title = {Engagement Estimation in Human-Robot and Human-Human Interactions across Domain, Age and Culture: The MultiMediate '26 Challenge},
  author = {M. Funk and Daksitha Senel Withanage Don and Michal Balážia and Victor Oei and Shogo Okada and François Brémond and Andreas Bulling and Elisabeth André and Philipp Müller},
  year = {2026},
  doi = {10.1145/3767308.3837718},
  url = {https://doi.org/10.1145/3767308.3837718},
  howpublished = {ACM International Conference on Multimedia (ACM MM)},
  annotation = {中文辅助译名：跨领域、年龄和文化的人机交互和人机交互的参与度估计：MultiMediate '26 挑战},
  abstract = {Understanding engagement in human interaction is essential for modelling assistive and context-aware AI systems. Previously, the MultiMediate challenge has focused on estimating momentary continuous engagement values in adult conversation across cultures, achieving high levels of generalisability across domains. However, engagement can be measured in different metrics and manifest differently between children and adults. MultiMediate'26 therefore expands the evaluated domain set to include the PInSoRo dataset of Child-Child and Child-Robot play sessions in English. These sessions were annotated categorically with task and social engagement, diversifying engagement types, age ranges and interaction types. In this paper, we describe the MultiMediate'26 challenge and its goals, introduce the NoXi, NoXi-J, MPIIGI, and PInSoRo datasets, showcase extracted multi-modal features, present our baseline model for engagement estimation across all domains, and discuss challenge submissions and approaches. In an effort to provide a transparent and welcoming challenge environment, baseline code, leaderboard, datasets, and extracted features are publicly available at https://github.com/hcmlab/MultiMediate26.},
}

@misc{elisabeth_andre_03b0795ecdc6c711,
  title = {Collaborative Creativity in Extended Realities: Findings from Co-creative Design Sessions in Augmented and Virtual Reality},
  author = {Ruben Schlagowski and Elisabeth André},
  year = {2026},
  doi = {10.1007/978-3-032-15283-1_15},
  url = {https://doi.org/10.1007/978-3-032-15283-1_15},
