@misc{elisabeth_andre_a7a4d9fedbf0714f,
  title = {From AI-Driven Emotion Recognition to Emotional Labor Support: Proactive Virtual Agents in Healthcare},
  author = {Chang Zhou and Jauwairia Nasir and Bhargavi Mahesh and Matthias Kraus and Elisabeth André},
  year = {2025},
  doi = {10.1145/3742886.3756744},
  url = {https://doi.org/10.1145/3742886.3756744},
  howpublished = {IVA (Adjunct)},
  annotation = {中文辅助译名：从人工智能驱动的情绪识别到情绪劳动力支持：医疗保健中的主动虚拟代理},
  abstract = {Emotional labor, the effortful regulation of emotion to meet social and organizational expectations, plays a central role in professional resilience and long-term productivity, especially in emotionally intense domains like healthcare.While affective computing has advanced in detecting emotions, current virtual agents rarely support the complex social and strategic dimensions of emotional labor.This study explores how AI-driven systems can move beyond emotion recognition to proactively support emotional labor and foster emotional capital.Leveraging recent advances in multimodal affective computing and proactive decision systems, the study will (i) devise sensor-based metrics for detecting labor episodes, (ii) construct computational simulations of emotional-capital accrual, and (iii) deploy a context-aware proactive support agent in nursing-home wards for supporting nurses and residents.Empirical evaluation will examine whether the proposed tools reduce caregiver burden, mitigate burnout risk, and elevate care quality and organizational efficiency.},
}

