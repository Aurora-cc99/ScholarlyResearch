@misc{elisabeth_andre_f519b601d4e02345,
  title = {Basic tutorial tactics for virtual agents. DynaLearn, EC FP7 STREP project 231526, Deliverable D5.2},
  author = {Michael Wißner and Maximilian Häring and Gregor Mehlmann and René Bühling and U. Milošević and Jochem Liem and Floris E. Linnebank and Wouter van Beek and Bert Bredeweg A and Elisabeth André},
  year = {2010},
  url = {https://handle.uba.uva.nl/personal/pure/en/publications/basic-tutorial-tactics-for-virtual-agents-dynalearn-ec-fp7-strep-project-231526-deliverable-d52(5b03148d-0c23-4847-8710-a61827321fee).html},
  howpublished = {UvA-DARE (University of Amsterdam)},
  annotation = {中文辅助译名：虚拟代理的基本教程策略。 DynaLearn，EC FP7 STREP 项目 231526，可交付成果 D5.2},
  abstract = {This document presents the progress and effort made in the design of a dialog system for the virtual characters in DynaLearn. The main purpose of this system is to provide means by which the virtual characters can present relevant system knowledge to the learners in a pedagogically sound manner. After providing an overview of the role of dialogs in interactive learning environments we present the architecture of our approach and describe in detail the functionality of its three main components: Dialog Management, Verbalization and User Modeling.},
}

