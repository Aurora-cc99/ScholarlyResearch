@misc{elisabeth_andre_76eb9714279594bc,
  title = {A Job Interview Simulation: Social Cue-Based Interaction with a Virtual Character},
  author = {Tobias Baur and Ionut Damian and Kaska Porayska-Pomsta and Patrick Gebhard and Elisabeth André},
  year = {2013},
  doi = {10.1109/SOCIALCOM.2013.39},
  url = {https://doi.org/10.1109/SOCIALCOM.2013.39},
  howpublished = {SocialCom},
  annotation = {中文辅助译名：求职面试模拟：与虚拟角色基于社交线索的交互},
  abstract = {This paper presents an approach that makes use of a virtual character and social signal processing techniques to create an immersive job interview simulation environment. In this environment, the virtual character plays the role of a recruiter which reacts and adapts to the user's behavior thanks to a component for the automatic recognition of social cues (conscious or unconscious behavioral patterns). The social cues pertinent to job interviews have been identified using a knowledge elicitation study with real job seekers. Finally, we present two user studies to investigate the feasibility of the proposed approach as well as the impact of such a system on users.},
}

@misc{elisabeth_andre_87a3e35a7dc19ab2,
  title = {Player Modeling},
  author = {Daniele Loiacono and Georgios N. Yannakakis and Pieter Spronck and Elisabeth André},
  year = {2013},
  doi = {10.4230/DFU.VOL6.12191.45},
  url = {https://doi.org/10.4230/DFU.VOL6.12191.45},
  howpublished = {Artificial and Computational Intelligence in Games},
  annotation = {中文辅助译名：球员建模},
  abstract = {Player modeling is the study of computational models of players in games. This includes the detection, modeling, prediction and expression of human player characteristics which are manifested through cognitive, affective and behavioral patterns. This chapter introduces a holistic view of player modeling and provides a high level taxonomy and discussion of the key components of a player’s model. The discussion focuses on a taxonomy of approaches for constructing a player model, the available types of data for the model’s input and a proposed classification for the model’s output. The chapter provides also a brief overview of some promising applications and a discussion of the key challenges player modeling is currently facing which are linked to the input, the output and the computational model.},
}

