@misc{elisabeth_andre_56e249cbce300e4b,
  title = {Engaging with virtual characters using a pictorial interaction language},
  author = {Colette Hume and Birgit Lugrin and Sarah Tazzyman and Lynne E. Hall and Ruth Aylett and Elisabeth André},
  year = {2014},
  doi = {10.1145/2559206.2574804},
