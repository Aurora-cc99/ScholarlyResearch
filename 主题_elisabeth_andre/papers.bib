@misc{elisabeth_andre_feb39ef5a56afe03,
  title = {Interpreting social cues to generate credible affective reactions of virtual job interviewers},
  author = {Tobias Baur and Nicolas Sabouret and Paola Rizzo and Hazaël Jones and Ionut Damian and Elisabeth André and Kaska Porayska-Pomsta},
  year = {2014},
  doi = {10.48550/ARXIV.1402.5039},
