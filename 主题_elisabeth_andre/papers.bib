@misc{elisabeth_andre_b08863479246c693,
  title = {Smart sensor integration: A framework for multimodal emotion recognition in real-time},
  author = {Frank Jung and Johannes Wagner and Elisabeth André},
  year = {2009},
  doi = {10.1109/ACII.2009.5349571},
  url = {https://doi.org/10.1109/ACII.2009.5349571},
  howpublished = {ACII},
  annotation = {中文辅助译名：智能传感器集成：实时多模态情感识别框架},
  abstract = {Affect sensing by machines has been argued as an essential part of next-generation human-computer interaction (HCI). To this end, in the recent years a large number of studies have been conducted, which report automatic recognition of emotion as a difficult, but feasible task. However most effort has been put towards offline analysis, whereas to date only few applications exist, which are able to react to a user's emotion in real-time. In response to this deficit we introduce a framework we call Smart Sensor Integration (SSI), which considerably jump-starts the development of multimodal online emotion recognition (OER) systems. In particular SSI supports the pattern recognition pipeline by offering tailored tools for data segmentation, feature extraction, and pattern recognition, as well as, tools to apply them offline (training phase) and online (real-time recognition). Furthermore, it has been designed to handle input from various input modalities and to suit the fusion of multimodal information.},
}

@misc{elisabeth_andre_67d57f0cab3755ab,
  title = {DynaLearn - Engaging and Informed Tools for Learning Conceptual System Knowledge},
  author = {Bert Bredeweg and Paulo Salles and Elisabeth André and Asunción Gómez-Pérez},
  year = {2009},
  url = {https://handle.uba.uva.nl/personal/pure/en/publications/dynalearn--engaging-and-informed-tools-for-learning-conceptual-system-knowledge(b43b295d-634d-40d6-84de-296d2efcac15).html},
  howpublished = {AAAI Fall Symposium: Cognitive and Metacognitive Educational Systems},
  annotation = {中文辅助译名：DynaLearn - 用于学习概念系统知识的参与和知情工具},
  abstract = {This paper describes the DynaLearn project, which seeks to address contemporary problems in science education by integrating well established, but currently independent technological developments, and utilize the added value that emerges. Specifically, diagrammatic representations are used for learners to articulate, analyse and communicate ideas, and thereby construct their conceptual knowledge. Ontology mapping is used to find and match co-learners working on similar ideas to provide individualised and mutually benefiting learning opportunities. Virtual characters are used to make the interaction engaging and motivating. The development of the workbench is tuned to fit key topics from environmental science curricula, and evaluated and further improved in the context of existing curricula using case studies. Through this approach, the DynaLearn project will deliver an individualised and engaging cognitive tool for acquiring conceptual knowledge that fits the true nature of this expertise.},
}

@misc{elisabeth_andre_3cb77740e8b75aba,
  title = {EmoEmma: emotional speech input for interactive storytelling},
  author = {David Pizzi and Fred Charles and Thurid Vogt and Elisabeth André and Marc Cavazza},
  year = {2009},
  url = {http://hdl.handle.net/10149/91153},
  howpublished = {AAMAS (2)},
  annotation = {中文辅助译名：EmoEmma：用于交互式讲故事的情感语音输入},
  abstract = {Whilst techniques for narrative generation and agent behaviour have made significant progress in recent years, natural language \nprocessing remains a bottleneck hampering the scalability of Interactive Storytelling systems. This demonstrator introduces a \nnovel interaction technique based solely on emotional speech recognition. It allows the user to use speech to interact with virtual actors without any constraints on style or expressivity, by mapping the recognised emotional categories to narrative \nsituations and virtual characters feelings.},
}

