@misc{elisabeth_andre_3015e4a9e1c1ba3b,
  title = {Towards a Multimedia Knowledge-Based Agent with Social Competence and Human Interaction Capabilities},
  author = {Lori Lamel and Louisa Pragst and Ludo Stellingwerff and Gregor Mehlmann and Gerard Llorach Tó and Mónica Domínguez and Stefan Ultes and Wolfgang Minker and Simon Mille and Florian Lingenfelser and Stefanos Vrochidis and Federico Sukno and Josep Blat and Leo Wanner and Andries Stam and Bianca Vieru-Dimulescu and Stamatia Dasiopoulou and Elisabeth André and Ioannis Kompatsiaris and Eleni Kamateri},
  year = {2016},
  doi = {10.1145/2927006.2927011},
