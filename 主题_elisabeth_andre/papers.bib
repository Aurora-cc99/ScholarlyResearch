  howpublished = {Künstliche Intell.},
  annotation = {中文辅助译名：历代智能体：从早期计算角色到生成社交智能},
  abstract = {Over several decades, research on socially interactive agents has transformed human–machine interaction, evolving from early script-based systems to today’s generative, multimodal agents. Tracing this development through the ages, this article reflects on major conceptual and technical shifts that shaped the field, drawing on advances across multiple areas of AI, and discusses how progress in natural language processing and multimodal behavior analysis and generation has redefined AI as a social interface. Rather than presenting this trajectory as a narrative of continuous progress, we also examine persistent limitations, including weak grounding, difficult evaluation, opaque decision processes, safety risks in sensitive contexts, and the gap between convincing social simulation and genuine social understanding.},
}

@misc{elisabeth_andre_55d560525dcc059c,
  title = {Toward Explainable AI-Supported Clinical Reasoning Education: A Qualitative Content Analysis of Final-Year Medical Students’ Diagnostic Reasoning and AI Support Preferences (Preprint)},
  author = {Fabio Hellmann and Katharina Weitz and Thomas Rotthoff and Moritz Bauermann and Ann-Kathrin Schindler and Elisabeth André},
  year = {2026},
  doi = {10.2196/105339},
  url = {https://doi.org/10.2196/105339},
  howpublished = {JMIR Medical Education},
  annotation = {中文辅助译名：迈向可解释的人工智能支持的临床推理教育：对医学生最后一年诊断推理和人工智能支持偏好的定性内容分析（预印本）},
  abstract = {BACKGROUND Medical students increasingly encounter artificial intelligence (AI) and explainable AI (XAI) in clinical training, yet their mental models of diagnostic decision-making and expectations for AI support remain poorly understood. Understanding these expectations is crucial for designing human-centered clinical decision support systems that are pedagogically effective and safe. OBJECTIVE This study explores medical students' diagnostic processes in their final year of undergraduate training and AI support preferences across four research questions: (1) What information do medical students use to make a diagnosis? (2) In what form would they like (X)AI to support them in this process? (3) What questions do they have for such (X)AI? (4) What form of presentation would they prefer for XAI? METHODS Semi-structured interviews (N=14 medical students, ages 24-31) were analyzed using reflexive thematic analysis, following information power principles. Participants worked through a standardized interactive online CASUS™ case based on a real multimorbid patient. During the CASUS™ case, participants used think-aloud techniques, followed by semi-structured interviews and a drawing task in which they sketched desired XAI interfaces for four modalities (laboratory results, electrocardiograms, radiographs, patient photographs). Interviews were audio-recorded, transcribed, and analyzed using an iterative, mixed deductive–inductive content analysis with a collaboratively developed cod},
}

@misc{elisabeth_andre_c6dcb1b82fbd4d59,
  title = {Evaluating Cross-Cultural Generative Embodied Social Agents},
  author = {M. Funk and Shogo Okada and Elisabeth André},
  year = {2026},
  doi = {10.1145/3776591.3836651},
  url = {https://doi.org/10.1145/3776591.3836651},
  howpublished = {Companion Publication of the International Conference on Multimodal Interaction (ICMI Companion)},
  annotation = {中文辅助译名：评估跨文化生成性体现社会代理人},
  abstract = {While research on generative multimodal social agents has recently gained interest, cultural aspects of non-verbal behaviour and gesture generation remain relatively unexplored. Research has especially neglected the evaluation of these culture-specific aspects, focusing instead on general measures of behavioural appropriateness, naturalness and speech alignment. Based on the literature and our own experience, we discuss several important aspects that future evaluations should consider. We examine evaluation processes that can be replicated to analyse generative performance in a culture-sensitive manner. The paper focuses on evaluation constructs such as cultural recognizability, social acceptance, behavioural fidelity, human behavioural response, and cultural understanding, and considers what measurements could assess these constructs, such as standardized questionnaires and uniform computed metrics.},
}

@misc{elisabeth_andre_3d77a3f9a0c02b0d,
  title = {Future Horizons in Human-AI Interaction: Joint Perspectives from HCI and AI},
  author = {Micol Spitale and Maristella Matera and Cristina Conati and Shelly Levy-Tzedek and Elisabeth André},
  year = {2026},
  doi = {10.1145/3811427.3811490},
  url = {https://doi.org/10.1145/3811427.3811490},
  howpublished = {AVI},
  annotation = {中文辅助译名：人机交互的未来视野：人机交互和人工智能的共同视角},
  abstract = {Recent advances in artificial intelligence (AI), including generative models and socially interactive agents, are reshaping the design of interactive systems and raising new challenges for Human–Computer Interaction (HCI). While AI research has traditionally focused on improving performance and scalability, HCI emphasizes usability, transparency, and the broader social implications of technology, all aspects that imply the application of proper human-centered design methods. Bridging these perspectives is increasingly critical as AI moves from backend functionality to a central role in user interaction. This paper reports on the workshop Future Horizons in Human–AI Interaction: Joint Perspectives from HCI and AI, held at AVI 2026. It synthesizes key insights on emerging challenges and opportunities in designing human-centered AI systems, emphasizing the importance of integrating perspectives from HCI and AI, to advance the design of interactive AI systems that are both technically robust and aligned with human values.},
}

@misc{elisabeth_andre_17cc987423ff0d51,
  title = {Design Your Cobot, Shape Your Workplace: Insights From a Participatory Design Session},
  author = {Katharina Weitz and Stina Klein and Pooja Prajod and Elisabeth André},
  year = {2026},
  doi = {10.1145/3805029.3818276},
  url = {https://doi.org/10.1145/3805029.3818276},
  howpublished = {CHIWORK (Adjunct)},
  annotation = {中文辅助译名：设计您的协作机器人，塑造您的工作场所：参与式设计会议的见解},
  abstract = {Industry 5.0 highlights the importance of integrating human needs and values into the design of human-robot workspaces, especially for collaborative robots that work in close proximity with humans. However, there is still little guidance on how to involve employees with different roles as co-designers when (re)designing cobot-avatar workstations in real industrial settings. To explore how such involvements can be realized, this paper presents a participatory design session for cobot–avatar workstations and reports insights from its evaluation with three employees of a manufacturing company, who created pen-and-paper prototypes during the session. The qualitative analysis of these prototypes and the accompanying discussions reveals shared and role-specific requirements for safety, ergonomics, and the division of responsibilities between cobots, avatars, and workers in everyday production. Based on these insights, we provide implications for human-centered cobot-avatar workstations and discuss the value of participatory design as a method for aligning Industry 5.0 principles with practical workspace design.},
}

@misc{elisabeth_andre_02e69a742d17082b,
  title = {Application of deep learning and explainable AI-supported medical decision-making for facial phenotyping in genetic syndromes},
  author = {Ömer Sümer and Tobias Huber and Jiayi Cheng and Dat Duong and Suzanna E. Ledgister Hanchard and Cristina Conati and Elisabeth André and Benjamin D. Solomon and Rebekah L. Waikel},
  year = {2026},
  doi = {10.1097/mcd.0000000000000581},
  url = {https://doi.org/10.1097/mcd.0000000000000581},
  howpublished = {Clinical Dysmorphology},
  annotation = {中文辅助译名：深度学习和可解释的人工智能支持的医疗决策在遗传综合征面部表型分析中的应用},
  abstract = {Objective To conduct a pilot study to assess whether saliency-based explainable artificial intelligence (XAI) affects the recognition of genetic conditions from facial images. Methods Forty-four medical geneticists, divided into AI-only and XAI-supported groups, assessed 18 images of individuals with or without genetic conditions. Diagnostic accuracy and confidence were recorded before and after viewing an AI classifier’s prediction probability, with or without XAI explanations. Mediation analyses were conducted to better interpret how geneticists interact with AI and XAI in decision-making. Results AI-only and XAI support improved accuracy for correct AI classifications, while incorrect AI classifications decreased accuracy. Average confidence increased with correct and decreased with incorrect classification. Geneticists reported that AI prediction probability was useful, whereas XAI explanations were viewed less favorably. For incorrect AI classifications, there was a negative correlation between accuracy improvement and perceived AI usefulness. When AI was correct (without XAI), the model prediction probability acted as a mediator between user confidence and the user’s decision to choose the same answer as AI. Conclusion The lack of accuracy or confidence improvements indicates that participants did not integrate saliency-based XAI into decisions. AI prediction probability had a greater impact on participants’ decision-making. These data may help inform larger studies.},
}

@misc{elisabeth_andre_1b075d210895a801,
  title = {Automated Behavioural Analysis in Parent-Infant Interactions using Multimodal-Large-Language Models},
  author = {Daksitha Senel Withanage Don and Tobias Hallmen and Mitho Müller and Lea Teresa Kaubisch and Linda Luisa Stürmlinger and Yaren Günay and Anna–Lena Zietlow and Beate Ditzen and Johannes C. Ehrenthal and Cristina Luna-Jiménez and Corinna Reck and Elisabeth André},
  year = {2026},
  doi = {10.1145/3776574.3831216},
  url = {https://doi.org/10.1145/3776574.3831216},
