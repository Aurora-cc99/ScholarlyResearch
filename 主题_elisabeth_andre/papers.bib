@misc{elisabeth_andre_35379fe200148fb3,
  title = {EVAL - an evaluation component for mobile interfaces},
  author = {Karin Bee and Dennis Erdmann and Elisabeth André},
  year = {2008},
  doi = {10.1145/1409240.1409320},
  url = {https://doi.org/10.1145/1409240.1409320},
  howpublished = {Mobile HCI},
  annotation = {中文辅助译名：EVAL - 移动界面的评估组件},
  abstract = {The Eval Tool is a usability evaluation environment which can be used to evaluate users an their behaviour while they interact with their pervasive computing environment via a mobile phone interface. The tool supports audio-visual recordings of several users and automatically annotates and synchronizes them with context data emerging from the pervasive environment. The annotation of video material with contextual information is important for the analysis of user studies and the detection of usability issues. The EVAL Tool consists of a recorder and a analyzer component. Using the recorder component the capturing of the videos and the logging of the context can be controlled whereas the analyzer components helps to interpret the user study.},
}

