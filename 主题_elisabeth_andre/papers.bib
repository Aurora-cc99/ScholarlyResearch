  author = {Bernhard Meyer and Claudius Thomé and Peter Vajkoczy and Victoria Kehl and Richard C. Dodel and Florian A. Ringel and _ _ and _ _ and Bernhard Meyer and Florian A. Ringel and Michael Behr and Haiko Pape and Michael Putzier and Marc Schürings and Claudius Thomé and Sebastian Hartmann and Peter Vajkoczy and Marcus Czabanka and Veit Rohde and Kajetan von Eckardstein and Wolfgang Börm and Stefan Zausinger and Rafael Donatus Sambale and Michael Hubert Stoffel and Marcus Richter and Mirko Arp and Richard Bostelmann and Frerk Meyer and Fritz Weber and Tobias Ludger Schulte and Uwe Spetzger and Andreas Müller and Rainer Wirtz and Richard C. Dodel and Janis Evers and Elisabeth André and Alfred Zollner and Viktoria Kehl},
