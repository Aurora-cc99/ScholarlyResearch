@misc{elisabeth_andre_994c061282f0453d,
  title = {A systematic discussion of fusion techniques for multi-modal affect recognition tasks},
  author = {Florian Lingenfelser and Johannes Wagner and Elisabeth André},
  year = {2011},
  doi = {10.1145/2070481.2070487},
  url = {https://doi.org/10.1145/2070481.2070487},
  howpublished = {ICMI},
  annotation = {中文辅助译名：多模态情感识别任务融合技术的系统讨论},
  abstract = {Recently, automatic emotion recognition has been established as a major research topic in the area of human computer interaction (HCI). Since humans express emotions through various channels, a user's emotional state can naturally be perceived by combining emotional cues derived from all available modalities. Yet most effort has been put into single-channel emotion recognition, while only a few studies with focus on the fusion of multiple channels have been published. Even though most of these studies apply rather simple fusion strategies -- such as the sum or product rule -- some of the reported results show promising improvements compared to the single channels. Such results encourage investigations if there is further potential for enhancement if more sophisticated methods are incorporated. Therefore we apply a wide variety of possible fusion techniques such as feature fusion, decision level combination rules, meta-classification or hybrid-fusion. We carry out a systematic comparison of a total of 16 fusion methods on different corpora and compare results using a novel visualization technique. We find that multi-modal fusion is in almost any case at least on par with single channel classification, though homogeneous results within corpora point to interchangeability between concrete fusion schemes.},
}

