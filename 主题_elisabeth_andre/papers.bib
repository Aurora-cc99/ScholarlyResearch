@misc{elisabeth_andre_29952b453e80af4c,
  title = {Multimedia Information Extraction Roadmap: Integration of Affective Computing and Multimedia Information Extraction},
  author = {Elisabeth André},
  year = {2008},
  url = {https://www.aaai.org/Papers/Symposia/Fall/2008/FS-08-05/FS08-05-015.pdf},
