@misc{panorama_601b492ca1c8_f5f7f0aa28013f18,
  title = {Segmentation method of degree-based transition region extraction for coronary angiograms},
  author = {Wenwei Kang and Wenying Kang and Wanzhong Chen and Bin Liu and Wei Wu},
  year = {2010},
  doi = {10.1109/icacc.2010.5486876},
  url = {https://doi.org/10.1109/icacc.2010.5486876},
  howpublished = {International Conference on Advanced Computer Control},
  annotation = {中文辅助译名：基于程度的冠状动脉造影过渡区域提取的分割方法},
  abstract = {Aiming at the complex background of coronary angiograms, weak contrast between the coronary arteries and the background, a new segmentation method based on transition region extraction of degree is proposed. Firstly, the paper analyzes the characteristic of coronary angiograms. Secondly, 6 different Gaussian matched templates are used to enhance the coronary angiograms in order to remove the background. Finally, the coronary arteries are obtained with the method of degree-based transition region extraction. The experiments indicate that the proposed method outperforms the segmentation method based on not only top-hat but also Gaussian filter about the small vessels extraction, connectivity and effectiveness. The method is indeed valuable for diagnosis and the quantitative analysis of coronary arteries.},
}

@misc{panorama_601b492ca1c8_d5d50333c92f9a37,
  title = {Multi-pattern recognition of sEMG based on improved BP neural network algorithm},
  author = {Yang Li and Yantao Tian and Wanzhong Chen},
  year = {2010},
  url = {http://yadda.icm.edu.pl/yadda/element/bwmeta1.element.ieee-000005573567},
  howpublished = {Chinese Control Conference (CCC)},
  annotation = {中文辅助译名：基于改进BP神经网络算法的表面肌电多模式识别},
  abstract = {For realizing seven hand gestures classification correctly, wavelet transform is used firstly to eliminate the noise in sEMG, because of its multi-resolution analysis characteristic. Then combine time domain features (such as EMG integral, variance, the third-order AR model coefficients) with frequency domain features (power-spectrum) as the inputs of neural network classifier to discriminate seven motion patterns. According to the shortcoming of traditional BP neural network algorithm which is easily trapped into local minimum, an improved one based on existing BP algorithm and simulated annealing algorithm is proposed in this paper. The experimental results indicate that the correct rate is above 90% by using the above algorithm. Comparing with traditional BP algorithm, the novel one has better recognition capability},
}

@misc{panorama_601b492ca1c8_8b929f1814ec4f41,
  title = {Segmentation of coronary arteries based on transition region extraction},
  author = {Wenwei Kang and Ke Wang and Wanzhong Chen and Yong Li},
  year = {2010},
  doi = {10.1109/car.2010.5456533},
  url = {https://doi.org/10.1109/car.2010.5456533},
  howpublished = {International Asia Conference on Informatics in Control, Automation and Robotics},
  annotation = {中文辅助译名：基于过渡区域提取的冠状动脉分割},
  abstract = {Aiming at the complex background of coronary angiograms, weak contrast between the coronary arteries and the background, a new segmentation method based on transition region extraction is proposed. The paper analyzes the characteristic of coronary angiograms, and then 6 different Gaussian matched templates are used to enhance the coronary angiograms. Finally, the coronary arteries are obtained with local complexity method based on transition region extraction. The experiments indicate that the proposed method outperforms the segmentation method based on top-hat about the small vessels extraction, connectivity and effectiveness. The method is indeed valuable for diagnosis and the quantitative analysis of coronary arteries.},
}

@misc{panorama_601b492ca1c8_7be75b54db3d24f9,
  title = {Modeling and pattern recognition of sEMG for intelligent bionic artificial limb},
  author = {Yang Li and Yantao Tian and Wanzhong Chen},
  year = {2010},
  doi = {10.1109/ROBIO.2010.5723581},
  url = {https://doi.org/10.1109/ROBIO.2010.5723581},
  howpublished = {ROBIO},
  annotation = {中文辅助译名：智能仿生假肢表面肌电信号建模与模式识别},
  abstract = {There are different kinds of correlations between sEMG and muscle activities, which can represent the activities of neuromuscular in a certain extent. sEMG is a feeble, complex, non-stationary signal, which is susceptible to external interference. According to these characteristics, sEMG mathematics models of two hand movements (letter `C' in ASL and CSL (ASLC), and extension of index finger (EXIF)) are established in this paper, which are used for identification and classification of motion patterns. This method can verify the models' ability to characterize different motions. According to the shortcoming of traditional BP neural network algorithm which is easily trapped into local minimum, an improved one based on existing BP algorithm and simulated annealing algorithm is proposed in this paper. The experimental results indicate that the novel one has better recognition capability comparing with traditional BP algorithm.},
}

@misc{panorama_601b492ca1c8_a192c3171732b69b,
  title = {Segmentation Method Based on Fusion Algorithm for Coronary Angiograms},
  author = {Wenwei Kang and Ke Wang and Wanzhong Chen and Wenying Kang},
  year = {2009},
  doi = {10.1109/cisp.2009.5303615},
  url = {https://doi.org/10.1109/cisp.2009.5303615},
  howpublished = {International Congress on Image and Signal Processing (CISP)},
  annotation = {中文辅助译名：基于融合算法的冠状动脉造影分割方法},
  abstract = {Aiming at weak contrast between the coronary arteries and the background, a new segmentation method based on fusion algorithm is proposed. Firstly, the coronary arteries are extracted by using the maximizing entropy segmentation method based on Top-hat. Then the coronary arteries are extracted again by using the maximizing entropy segmentation method based on Gaussian filter. Finally, the last segmentation result is the image obtained by fusing two extracted coronary arteries images. A lot of experiments indicate that the proposed method outperforms the maximizing entropy method based on not only Top-hat but also Gaussian filter about the small vessels extraction and background elimination. In addition, the method is indeed valuable for diagnosis and the quantitative analysis of vessels.},
}

@misc{panorama_601b492ca1c8_6a1fc5b965744b71,
  title = {An Improvement of the Ant Colony Optimization Algorithm for Solving Travelling Salesman Problem (TSP)},
  author = {Tiankun Li and Wanzhong Chen and Xin Zheng and Zhuo Zhang},
  year = {2009},
  doi = {10.1109/wicom.2009.5302937},
  url = {https://doi.org/10.1109/wicom.2009.5302937},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：解决旅行商问题(TSP)的蚁群优化算法的改进},
  abstract = {The ant colony optimization algorithm usually falls into local optimal solution and can not select the path with high pheromone concentration quickly in solving the TSP. According to this, in this paper an improved max-min ant system (MMAS) algorithm based on pheromone concentration reinitialization is proposed to overcome the shortcoming above. The simulation results show that the improved algorithm can obtain the optimal solution of TSP, and speed up convergence.},
}

@misc{panorama_601b492ca1c8_c24ca02994252336,
  title = {The Research on the Application of an Improved Algorithm in the Zigbee Network},
  author = {Tiankun Li and Wanzhong Chen and Xin Zheng and Zhuo Zhang},
  year = {2009},
  doi = {10.1109/wicom.2009.5302933},
  url = {https://doi.org/10.1109/wicom.2009.5302933},
  howpublished = {International Conference on Wireless Communications, Networking and Mobile Computing},
  annotation = {中文辅助译名：一种改进算法在Zigbee网络中的应用研究},
  abstract = {An improved AntNet algorithm is put forward to overcome the shortcomings of the nodes around the sink node excessive energy consumption in AntNet algorithm. This improved algorithm is based on the thought of cluster structure routing, when the Zigbee network carries out for a period of time, the algorithm re-select sub-sink node. The NS2 simulation platform has been built to simulate a Zigbee wireless sensor network, the simulation results prove that the improved AntNet algorithm compared to the two existing wireless routing algorithm: the LEACH algorithm and the AntNet algorithm, has several notable improvements among the energy consumption in the network, node mortality and some degree of network congestion.},
}

@misc{panorama_601b492ca1c8_2a0f26cc4aedace1,
  title = {The Algorithm of Dynamic Battery SOC Based on Mamdani Fuzzy Reasoning},
  author = {Shuang-shuang Han and Wanzhong Chen},
  year = {2008},
  doi = {10.1109/fskd.2008.166},
  url = {https://doi.org/10.1109/fskd.2008.166},
  howpublished = {International Conference on Fuzzy Systems and Knowledge Discovery (FSKD)},
  annotation = {中文辅助译名：基于Mamdani模糊推理的动态电池SOC算法},
  abstract = {The measurement of dynamic battery spare capacity (SOC), has an important impact on the energy management system of hybrid electric vehicles. In this paper, a fuzzy forecast algorithm against the forecast of dynamic battery SOC was proposed. According to the minimum-maximum-Barycenter method of Mamdani fuzzy reasoning, the forecast model of vehicle dynamic battery SOC based on fuzzy forecast algorithm was established, the forecast of the battery SOC could be achieved using the present voltage and current data of battery, simulation and practical test showed that the forecast error was less than 5%, it could meet the control requirements of electric vehicle and hybrid electric vehicles and had a wide range of applications.},
}

@misc{panorama_601b492ca1c8_9bc3ffb7f92cd2aa,
  title = {The control of lighting luminance based on ethernet},
  author = {Wanzhong Chen},
  year = {2007},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=YYKJ200706001},
  howpublished = {Applied science and technology},
  annotation = {中文辅助译名：基于以太网的照明亮度控制},
  abstract = {This paper proposes an intelligent control system for lighting luminance based on Ethernet.It can remotely control the household lighting luminance through Ethernet in computers.In the household,MCU is utilized to achieve the communication and control of data,possessing the advantages of simple operation,low cost and easy control.The proposed system has the wide application perspective in the intelligent furniture.},
}

@misc{panorama_601b492ca1c8_b3281c1d3e776587,
  title = {The Dynamic Imitation on Opposite Rotary Moment of Force for an Automobile Steering Wheel},
  author = {Wanzhong Chen},
  year = {2006},
  url = {https://oversea.cnki.net/kcms/detail/detail.aspx?dbcode=CJFD&filename=SYJL200603010},
  howpublished = {Experimental Technology and Management},
  annotation = {中文辅助译名：汽车方向盘反向转动力矩的动态模拟},
  abstract = {In the study of automobile dynamic imitation,the effect of dynamic imitation of a steering wheel opposite rotary moment affects directly driver's operate action,thus affects the studying accuracy of person-automobile close-ring control system.This paper introduced a method of dynamic imitation in which a moment motor is regarded as a unit of steering wheel opposite rotary moment,and analyses stable state error of the control system.The dynamic imitation experiment on Jetta vehicle proves that the system is in real-time,and can meet dynamic imitation demands.},
}

@misc{panorama_601b492ca1c8_cc31d23b7c3f048a,
  title = {The information acquisition and error control in the wireless infrared temperature measurement system},
  author = {Yongjun Wang and Wanzhong Chen and Wentai Zhang},
  year = {2005},
  doi = {10.1109/icia.2004.1373367},
  url = {https://doi.org/10.1109/icia.2004.1373367},
  howpublished = {IEEE International Conference on Information Acquisition},
  annotation = {中文辅助译名：无线红外测温系统的信息采集与误差控制},
  abstract = {This paper aim to the practical problems of the wireless infrared temperature measuring system, have introduced a method of information acquisition which adopts the infrared temperature sensors, and have recommended the RS error correcting code algorithm in wireless data transmission. So the accuracy of data transmission has been improved. It has been proved to be steady and reliable.},
}

@misc{panorama_601b492ca1c8_75fbe90dd2e4594e,
  title = {Study on de-noising of the torque sensor signal in electric power steering system using wavelet transform},
  author = {Wentai Zhang and Wanzhong Chen and Yongjun Wang},
  year = {2005},
  doi = {10.1109/icia.2004.1373368},
  url = {https://doi.org/10.1109/icia.2004.1373368},
  howpublished = {IEEE International Conference on Information Acquisition},
  annotation = {中文辅助译名：小波变换对电动助力转向系统扭矩传感器信号去噪的研究},
  abstract = {According to the characteristics that the signal of torque sensor both have electromagnetic noise of engine and impact signal of road surface, by changing thresholding on the different scales, we present an algorithm that wavelet transform coefficients of noise are filtered and impact signal of road surface are reserved, and reconstruct the torque signal in order to enhance signal-to-noise ratio (SNR) and make the torque signal present enough information of road surface. The experimental results derive from the bench test show that the method is more effective.},
}

@misc{panorama_601b492ca1c8_58b7d820d4bb80b0,
  title = {Simulation of Straight-Line Type Assist Characteristic of Electric Power-Assisted Steering},
  author = {Shi Guo-biao and Lin Yi and Xin Zhang and Wanzhong Chen and Zhu Hai},
  year = {2004},
  doi = {10.4271/2004-01-1107},
  url = {https://doi.org/10.4271/2004-01-1107},
  howpublished = {SAE technical papers on CD-ROM/SAE technical paper series},
  annotation = {中文辅助译名：电动助力转向直线式辅助特性仿真},
  abstract = {Electric Power-Assisted Steering (EPAS) is a new power steering technology that will define the future of vehicle steering. The assist of EPAS is the function of the steering wheel torque and vehicle velocity. The assist characteristic of EPAS is set by control software, which is one of the key issues of EPAS. The straight-line type assist characteristic has been used in some current EPAS products, but its influence on the steering maneuverability and road feel hasn't been explicitly studied in theory. In this paper, the straight-line type assist characteristic is analyzed theoretically. Then a whole vehicle dynamic model used to study the straight-line type assist characteristic is built with ADAMS/Car and validated with DCF (Driver Control Files) mode of ADAMS/Car. Based on the whole vehicle dynamic model, the straight-line type assist characteristic's influence on the steering maneuverability and road feel is investigated. Based on the driver's request for the ideal relationship between steering wheel torque and vehicle velocity, the vehicle speed proportional coefficient of the assist characteristic can be determined by making steering wheel torque at different vehicle lateral acceleration agree with the request of the driver at a certain velocity. The target of this paper is analyzing the influence of the straight-line type assist characteristic on the steering maneuverability and road feel, and studying how to apply simulation method to determine the straight-line type },
}

