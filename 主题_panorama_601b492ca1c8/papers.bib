@misc{panorama_601b492ca1c8_326cad17b43cef28,
  title = {Finite-time back-stepping sliding mode control based on disturbance and sliding mode disturbance observers for hysteresis systems with application to microscopy autofocus},
  author = {Liqun Cheng and Wanzhong Chen and Liguo Tian},
  year = {2025},
  doi = {10.1088/1402-4896/ae166b},
  url = {https://doi.org/10.1088/1402-4896/ae166b},
  howpublished = {Physica Scripta},
  annotation = {中文辅助译名：基于磁滞系统扰动和滑模扰动观测器的有限时间反步滑模控制及其在显微镜自动对焦中的应用},
  abstract = {Abstract This paper presents a finite-time back-stepping sliding mode control method based on disturbance and sliding mode disturbance observers for piezoelectric actuator (PEA) with application to microscopy autofocus (AF) system. A radial basis function neural-network (RBFNN) is constructed to estimate the hysteresis model of PEA. The disturbance observer (DOB) without any priori knowledge is used to estimate the uncertainties and disturbances of PEA system. Sliding mode disturbance observer (SMDO) estimates the errors of DOB and RBFNN. With the proposed finite-time back-stepping sliding mode control with DOB and SMDO, all the solutions of the PEA systems are finite-time stable. Experiments of tracking trajectories under different frequencies are conducted on a commercial PEA to demonstrate the effectiveness of the proposed control method. For AF system, we propose a two-step AF method based on the convolution neural-network. With the motion tracking capability, the proposed control methodology enables the microscopy AF system to obtain the defocus training-set, and can be used as the positioning control method for the z -axis of system that can move cell samples to focal plane. Experiments verified our proposed AF method needs only 2 cell images to process the AF procedure. The image acquisition times are reduced at least 60% compared with well known AF methods.},
}

