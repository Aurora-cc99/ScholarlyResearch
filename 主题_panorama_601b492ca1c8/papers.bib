  year = {2025},
  doi = {10.1109/icaci65340.2025.11096311},
  url = {https://doi.org/10.1109/icaci65340.2025.11096311},
  howpublished = {International Conference on Advanced Computational Intelligence (ICACI)},
  annotation = {中文辅助译名：基于时频域特征交叉融合和局部-全局特征提取的脑电情绪识别方法},
  abstract = {Emotion recognition is an important foundation of human-computer interaction. However, efficiently extracting EEG signal features and building high-performance, low-cost classification models remains a challenge. To address this, this study proposes an emotion recognition method based on timefrequency domain features cross-fusion and local-global feature extraction. This method first extracts differential entropy to represent temporal information and power spectral density to represent spectral information from EEG, and introduces a crossattention mechanism as a purely mathematical approach to achieve deep fusion of time-frequency domain features, fully leveraging the mutually enhancing relationship between temporal and spectral features of EEG data. Then, local features are extracted using a Convolutional Neural Network (CNN), and a lightweight Gated Attention Unit (GAU) is employed to perceive global features, constructing an efficient feature extraction and classification framework. Evaluations conducted on the DEAP and SEED datasets demonstrate the effectiveness of the proposed approach which not only significantly improves classification performance but also greatly reduces the model parameter size, providing an efficient and reliable solution for EEG emotion recognition.},
}

