  doi = {10.1109/JIOT.2026.3723455},
  url = {https://doi.org/10.1109/JIOT.2026.3723455},
  howpublished = {IEEE Internet Things J.},
  annotation = {中文辅助译名：超越网格和图形：采用柯尔莫哥洛夫-阿诺德网络进行脑电图情绪识别的双流时空框架},
  abstract = {As a core component of affective computing, emotion recognition supports broad IoT-based applications in healthcare, human–computer interaction, and digital entertainment. Recently, EEG-based emotion recognition has been widely investigated due to its noninvasiveness, high temporal resolution, and accessibility. Neuroscientific evidence indicates that emotional brain activity is highly complex, involving both local spatiospectral patterns (grid-like patterns) and global topological connections (graph-based topology), alongside highly nonlinear dynamics. However, existing studies often model EEG signals solely as Euclidean images or non-Euclidean graphs. This single-view modeling fails to capture complementary spatio-temporal features, limiting representation capability for complex emotional states. To address this, a dual-stream spatiotemporal Kolmogorov-Arnold network (KAN) is proposed. In particular, multichannel EEG signals are first mapped into 3-D grid tensors preserving spatial topology. Subsequently, a dual-stream architecture is employed: 1) a ConvMixer-based local spatiospectral encoder (LSSE) efficiently extracts local spatiospectral features via alternating stacks of depthwise and pointwise convolutions and 2) a dynamic topological graph encoder (DTGE) based on adaptive spectral graph convolutions captures global functional connectivity. In parallel, a node saliency mechanism based on KAN is introduced to adaptively enhance representations of critical interpolated },
}

