@misc{panorama_fbd62c7fa25d_97e40ff255dd75cb,
  title = {Implementation of High-Performance Automated Monitoring Collection Based on Kubernetes},
  author = {Ke Li and Xiao Xue and Chuanji Gao and Shenke Yu and Xiaodong Tang and Guoge Tan},
  year = {2024},
  doi = {10.1109/cbase64041.2024.10824649},
  url = {https://doi.org/10.1109/cbase64041.2024.10824649},
  howpublished = {International Conference on Cloud Computing, Big Data Application and Software Engineering (CBASE)},
  annotation = {中文辅助译名：基于Kubernetes的高性能自动化监控采集实现},
  abstract = {Unified configuration and centralized management of monitoring collection are prerequisites and key elements for achieving automated monitoring in cloud-native platforms. With the rapid development of container technology, Kubernetes has been widely adopted for container orchestration and cluster management. As the number of application-associated monitoring objects increases and the scale of environmental applications and nodes expands, traditional monitoring systems face challenges in achieving high performance and automated collection. This paper introduces a declarative monitoring collection configuration management method based on Kubernetes and provides a detailed explanation of configuration management and related technologies. The management framework fully leverages the advantages of the Kubernetes platform, seamlessly integrating the cloud-native monitoring system Prometheus. It combines technologies such as collection agents, operators, and custom resources to provide a stable and reliable solution for the high-performance operation and automated management of monitoring collections in cloud-native environments.},
}

