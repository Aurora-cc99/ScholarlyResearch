@misc{panorama_fbd62c7fa25d_dfba6f10abd8e277,
  title = {No Universal Winner in Model Selection: Regression versus Representational Similarity Analysis},
  author = {Chuanji Gao and Gang Chen and Svetlana V. Shinkareva and Rutvik H. Desai},
  year = {2025},
  doi = {10.48550/arxiv.2511.00395},
  url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12754712/},
  howpublished = {PubMed Central},
  annotation = {中文辅助译名：模型选择中没有普遍的赢家：回归与表征相似性分析},
  abstract = {Selecting among competing computational models is central to cognitive psychology and neuroscience, yet the relative model-selection performance of regression and representational similarity analysis (RSA) remains unclear. We compared these approaches using Monte Carlo simulations and empirical data. Univariate simulations compared generating and rival feature models against the same response under direct-linear and geometry-based mappings. Under direct-linear generation, regression outperformed correlation-distance RSA/Spearman but not RSA/Pearson. Under geometry-linear generation, neither approach showed a significant advantage, whereas correlation-distance RSA outperformed regression under a sigmoid readout, although this advantage did not extend to Euclidean-distance RSA. Feature dimensionality, covariance, and PCA preprocessing further influenced model-selection accuracy. In multivoxel simulations, pattern component modeling (PCM) showed superior performance under spatially correlated noise, while crossnobis improved selection relative to squared Euclidean RSA under the same condition. Feature reweighting improved held-out representational correspondence for both generating and rival models without consistently improving model selection. Separate signal-strength comparisons yielded different method rankings. In empirical data from 4,026 words, all methods preferred frequency over affect features, but small-sample preference stability depended on distance measures and pre},
}

@misc{panorama_fbd62c7fa25d_84e1065d3a322d56,
  title = {Emotional Amplifier: How Event Boundaries influence Time and Source Memory},
  author = {Jingwen Hu and Kaijie Zhang and Ziyi Li and Ren Zhigang and Zhu Xiaoman and Li Xiang and Chuanji Gao and Bao‐Ming Li and Xi Jia},
  year = {2025},
  doi = {10.31234/osf.io/v7u6h_v1},
  url = {https://doi.org/10.31234/osf.io/v7u6h_v1},
  howpublished = {PsyArXiv (OSF Preprints)},
  annotation = {中文辅助译名：情绪放大器：事件边界如何影响时间和源记忆},
  abstract = {Event boundaries, marked by contextual changes, segment continuous experiences into memory units. Day-to-day emotional arousal also affects memory structure. Yet their joint impact remains unclear. We examine whether emotional arousal modulates memory boundary effects. Participants viewed negative or neutral image sequences, with contexts shifted via auditory cues (Experiment 1, n = 61) or visual cues (Experiment 2, n = 60), followed by temporal and source memory tests. Across both experiments, boundaries impaired order memory, increased perceived temporal distance, and enhanced source memory. Importantly, negative arousal amplified boundary effects across modalities but in a modality-specific fashion: it amplified effects on temporal distance memory in Experiment 1 and on source memory in Experiment 2. Exploratory analyses revealed boundaries modulated the correlation between order and distance memory under neutral contexts, but this modulation disappeared under negative arousal. These findings offer insights into how emotional arousal modulates memory boundary effects and their joint effects on multiple components of episodic memory.},
}

@misc{panorama_fbd62c7fa25d_6490ab51c89533a2,
  title = {Comparative Study on Cloud Resource Scheduling Using Chaotic Tuna Swarm Optimization Algorithm},
  author = {Chuanji Gao and Guoge Tan and Xiaodong Tang and Wei Song and Yu Tian and Hongyuan Song},
  year = {2024},
  doi = {10.1109/icftic64248.2024.10912906},
  url = {https://doi.org/10.1109/icftic64248.2024.10912906},
  howpublished = {IEEE International Conference on Frontiers Technology of Information and Computer (ICFTIC)},
  annotation = {中文辅助译名：混沌金枪鱼群优化算法云资源调度比较研究},
  abstract = {As the current standard platform for cloud resource management, Kubernetes generally adopts metaheuristic algorithms for pod scheduling by many researchers due to various shortcomings of its default mechanism. Tuna swarm optimization (TSO) is used as the basic algorithm herein, and a chaotic mapping based population initialization scheme is introduced to address the common problems of metaheuristic algorithms, such as susceptibility to initial populations and premature convergence during later iterations. A comparative study on cloud resource scheduling based on the chaotic tuna swarm optimization (CTSO) using various chaotic maps combined with other improvement strategies, such as levy flight and t-distribution, is conducted in this paper. A series of comparative experiments elaborate the introduced population initialization scheme based on chaotic maps and other improved strategies can effectively improve the optimization performance of the original TSO algorithm.},
}

