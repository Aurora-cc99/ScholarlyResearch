@misc{panorama_zhengjia_dai_14216500e2a2,
  title = {Charting sex divergence in the human brain across the lifespan},
  author = {Minhui Zhu and Lianglong Sun and Mingrui Xia and Yanchao Bi and Qingjiu Cao and Rui Chen and Yuan Chen and Taolin Chen and Yuqi Cheng and Zhengjia Dai and Yao Deng and Yuyin Ding and Qi Dong and Jia‐Hong Gao and Qiyong Gong and Ying Han and Zaizhu Han and Chu‐Chung Huang and Hao Huang and Ruiwang Huang and Ran Huo and Lingjiang Li and Qixiang Lin and Bangshan Liu and Chao Liu and Hesheng Liu and Ningyu Liu and Ying Liu and Yong Liu and Jing Lu and Leilei Ma and Weiwei Men and Chenxuan Pang and Shaozheng Qin and Wen Qin and Jiang Qiu and Shijun Qiu and Tianmei Si and Shuping Tan and Yanqing Tang and Sha Tao and Dawei Wang and Fei Wang and Pan Wang and Pan Wang and Qian Wang and Xiaoqin Wang and Yanpei Wang and Dongtao Wei and Yunong Wu and Peng Xie and Xiufeng Xu and Li Yang and Chunshui Yu and Huishu Yuan and Xi Zhang and Xi Zhang and Gai Zhao and Kun Zhao and Yanting Zheng and Alzheimer’s Disease Neuroimaging Initiative and MCADI and DIDA-MDD Working Group and Xinyuan Liang and Yong He A},
  year = {2026},
  doi = {10.2139/ssrn.7361036},
  url = {https://doi.org/10.2139/ssrn.7361036},
  howpublished = {SSRN Electronic Journal},
  annotation = {中文辅助译名：绘制人类大脑在整个生命周期中的性别差异},
  abstract = {Summary Biological sex fundamentally shapes human brain organization, but sex-specific normative neuroanatomical trajectories across the lifespan remain largely uncharted. Here, we constructed independent, sex-specific lifespan brain charts using structural neuroimaging data from 59,915 healthy individuals (29,760 males and 30,155 females) ranging in age from 266 postconception days to 100 years. By examining 296 structural phenotypes across global, cortical, and subcortical measures, these models revealed widespread sex differences in maturational timing, with males reaching peak milestones later than females. These trajectories demonstrate that sex differences evolve dynamically, with phenotype-specific windows of emergence and maximal separation. Compared with conventional sex-pooled references, sex-specific models achieved superior predictive accuracy and reduced misestimation of individual deviations in healthy populations. Across five neuropsychiatric conditions, sex-specific models improved the detection of extreme deviations and revealed both shared and sex-dependent patterns of disorder-related neuroanatomical abnormalities. These sex-specific charts establish tailored normative references for assessing brain development, ageing, and disease.},
}

