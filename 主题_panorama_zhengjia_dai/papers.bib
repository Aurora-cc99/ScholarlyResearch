@misc{panorama_zhengjia_dai_fc0e287bb943,
  title = {Population-specific brain charts reveal Chinese-Western differences in neurodevelopmental trajectories},
  author = {Lianglong Sun and Qin Wen and Xinyuan Liang and Caihong Wang and Weiwei Men and Yunyun Duan and Xue-Ru Fan and Qing Cai and Shijun Qiu and Meiyun Wang and Qiyong Gong and Yanghua Tian and Peipeng Liang and Zeyu Liu and Xiaochu Zhang and Hongwen Song and Zhaoxiang Ye and Peng Zhang and Qi Dong and Sha Tao and Wenzhen Zhu and Jintao Zhang and Fang Xie and Jianfeng Feng and Jing Zhang and Chao Liu and Qiujin Qian and Bing Zhang and Ming Meng and Li Hu and Jia‐Hong Gao and Tianzi Jiang and Xiongzhao Zhu and Yuhan Zhang and Liping Liu and Hanjun Liu and Weihua Liao and Dawei Wang and Huali Wang and Tengfei Guo and Zhengjia Dai and Su Lui and Kai Xu and Lingjiang Li and Peng Xie and Chunliang Feng and Guangbin Cui and Jinsong Wu and Xuntao Yin and Guosheng Ding and Junfang Xian and Lianping Zhao and Jie Lu and Zhifen Liu and Ying Han and Zhen Yuan and Xilin Zhang and Tianmei Si and Fuqing Zhou and Yanchao Bi and Dan Wu and Fei Gao and Fei Wang and Shaozheng Qin and Gang Wang and Feng Chen and Zhiqiang Zhang and Jing Sui （Beijing Normal University）， my correct affiliation is beijing normal university, not Qingdao University of Science and Technology, please correct the current affiliation. Thank you and Huafu Chen and Jinhua Cai and Shuwei Liu and Zuojun Geng and Chen Zhang and Ning Mao and Hong Yin and Bo Liu and Heng Ma and Bo Gao and Yanwei Miao and Xiangzhen Kong and Yuan Zhou and Li Liu and Jianping Hu and Liang Wang and Quan Zhang and Hua Shu and Peijun Wang and Tatia M.C. Lee and Qingjiu Cao and Li Yang and Xi Zhang and Wenbo Luo and Meng Liang and Hongxiang Yao and Meng Li and Hao Huang and Yun Wen Peng and Zaizhu Han and Chao Zhou and Haibo Xu},
  year = {2025},
  doi = {10.1101/2025.06.17.659820},
  url = {https://doi.org/10.1101/2025.06.17.659820},
  howpublished = {bioRxiv (Cold Spring Harbor Laboratory)},
  annotation = {中文辅助译名：特定人群的脑图揭示了中西方神经发育轨迹的差异},
  abstract = {. However, current lifespan brain charts are primarily derived from European and North American cohorts, with Asian populations severely underrepresented. Here, we present the first population-specific brain charts for China, developed through the Chinese Lifespan Brain Mapping Consortium (Phase I) using neuroimaging data from 43,037 participants (aged 0-100 years) across 384 sites nationwide. We establish the lifespan normative trajectories for 296 structural brain phenotypes, encompassing global, subcortical, and cortical measures. Cross-population comparisons with Western brain charts (based on data from 56,339 participants aged 0-100 years) reveal distinct neurodevelopmental patterns in the Chinese population, including prolonged cortical and subcortical maturation, accelerated cerebellar growth, and earlier development of sensorimotor regions relative to paralimbic regions. Crucially, these Chinese-specific charts outperform Western-derived models in predicting healthy brain phenotypes and detecting pathological deviations in Chinese clinical cohorts. These findings highlight the urgent need for diverse, population-representative brain charts to advance equitable precision neuroscience and improve clinical validity across populations.},
}

