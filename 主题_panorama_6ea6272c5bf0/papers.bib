@misc{panorama_6ea6272c5bf0_985603a708d59862,
  title = {HRA-Former: Hierarchical Region-Aware Transformer with Structure-Preserving Multi-Stage Learning for EEG-Based Driver Fatigue Detection},
  author = {Dongrui Gao and Xingyu Chen and Xueyi Zhang and Yuan Zong and Siqi Cai and Hongli Chang},
  year = {2026},
  doi = {10.1109/jbhi.2026.3752848},
  url = {https://doi.org/10.1109/jbhi.2026.3752848},
  howpublished = {IEEE Journal of Biomedical and Health Informatics},
  annotation = {中文辅助译名：HRA-Former：具有结构保持多阶段学习功能的分层区域感知Transformer，用于基于脑电图的驾驶员疲劳检测},
  abstract = {Driver fatigue is associated with changes in neural rhythms and interregional coordination. However, most EEG-based fatigue detection methods model dense inter-electrode dependencies with limited attention to the electrode-to-region hierarchy. Conventional classification objectives may also favor discriminative patterns while inadequately preserving EEG spatial and spectral structure. To address these limitations, this study proposes a hierarchical region-aware Transformer with structure-preserving multi-stage learning for EEG-based driver fatigue detection. The proposed framework first aggregates electrode-level features into region-level features using prototypeattention aggregation and incorporates two-dimensional scalp positional encoding to retain spatial topology. A region-aware attention mask regulates information propagation based on predefined region assignments, preserving electrode-to-region interactions and global communication among regions. Furthermore, a two-stage learning strategy is developed. In the first stage, masked EEG feature reconstruction and fatigue classification are jointly optimized to learn structure-preserving and taskrelevant representations. In the second stage, the pretrained encoder is transferred to a dedicated classifier for supervised fatigue recognition. Experiments on SEED-VIG and an independently collected dataset achieved subject-dependent accuracies of 95.18% and 86.67%, respectively, outperforming representative methods. Ablation st},
}

