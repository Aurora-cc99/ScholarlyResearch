  annotation = {中文辅助译名：用于现实世界4D点云增强的渐进式潜在去噪和几何细化},
  abstract = {Dynamic point clouds (DPCs) have become a fundamental modality for immersive multimedia applications like free-viewpoint video and holographic telepresence. While consumer-grade depth sensors have democratized large-scale 4D data acquisition, real-world DPCs captured in-the-wild inevitably suffer from severe spatial-temporal degradations, including chaotic outliers, missing topologies, and temporal flickering. Existing enhancement methods mostly operate in raw 3D coordinate spaces under simplified noise assumptions, leading to drastic performance drops in real-world scenarios. Furthermore, they inherently suffer from a delicate trade-off: aggressive noise suppression tends to oversmooth intricate geometries, whereas direct surface completion often amplifies residual noise. To tackle this, we propose PointPower, a progressive multi-stage pipeline tailored for dynamic point cloud enhancement. Specifically, the first stage introduces an invertible latent-space denoising module that maps corrupted point clouds into a well-structured latent space for robust, topology-aware noise filtering. The second stage performs spatial anchoring and primary density refinement to regularize point coordinates and density in Euclidean space, yielding a reliable primary representation. Finally, the third stage executes a decision-driven gated refinement, utilizing a frame-level gating mechanism to dynamically invoke a pretrained diffusion model for high-fidelity structural completion only when sig},
}

@misc{wenming_zheng_156eac025cea,
  title = {Generalizable Dynamic Domain Adaptation for Speaker-Independent Speech Emotion Recognition},
  author = {Cheng Lu and Yuan Zong and Hailun Lian and Sunan Li and Yan Daniel Zhao and Björn Wolfgang Schuller and Wenming Zheng},
  year = {2026},
  doi = {10.1109/taslpro.2025.3636055},
