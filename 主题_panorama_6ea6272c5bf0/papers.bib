  year = {2026},
  doi = {10.3390/jfmk11040473},
  url = {https://doi.org/10.3390/jfmk11040473},
  howpublished = {Journal of Functional Morphology and Kinesiology},
  annotation = {中文辅助译名：在坚硬和泡沫表面上的姿势调整与年龄相关的差异},
  abstract = {Background: Age-related changes in postural control and altered somatosensory input may both affect balance regulation, but their combined influence on postural adjustments during external perturbations remains unclear. This study investigated the effects of age and support-surface condition on postural adjustments induced by pendulum perturbations. Methods: Forty-four healthy male Chinese participants, including 22 young adults and 22 older adults, were exposed to external perturbations while standing on firm and foam support surfaces. Surface electromyography and force-platform data were used to assess muscle activation and center-of-pressure behavior during anticipatory postural adjustments (APAs) and compensatory postural adjustments (CPAs). Results: Young adults showed earlier EMG onset and greater modulation of selected postural muscles than older adults. During APAs, tibialis anterior and rectus femoris baseline-normalized EMG responses were greater on the foam surface, whereas during CPAs, soleus baseline-normalized EMG activity was greater on foam. Older adults showed greater normalized lower-limb co-contraction on the foam surface, whereas young adults showed no significant surface-related change in co-contraction. Conclusions: These findings indicate age-related differences in neuromuscular responses to compliant support conditions and suggest that older adults may rely more on lower-limb co-contraction when somatosensory information and mechanical support are alte},
}

@misc{panorama_jing_wang_c9c7620437f0,
  title = {Enhanced Emotion-Aware Contrastive Adaptation Networks for Source-Free Cross-Corpus Speech Emotion Recognition},
  author = {Yan Zhao and Jincen Wang and Cheng Lu and Sunan LI and Fan Liu and Björn Wolfgang Schuller and Wenming Zheng and Yuan Zong},
  year = {2026},
  doi = {10.1109/taffc.2026.3746232},
  url = {https://doi.org/10.1109/taffc.2026.3746232},
  howpublished = {IEEE Transactions on Affective Computing},
  annotation = {中文辅助译名：增强型情感感知对比适应网络，用于无源跨语料库语音情感识别},
  abstract = {Speech emotion recognition (SER) remains challenging when the training (source) and testing (target) data are drawn from different speech corpora, a setting commonly referred to as cross-corpus SER. Although domain adaptation (DA) methods show promise for mitigating this domain shift, many conventional unsupervised DA methods require access to labeled source speech data, limiting their applicability in privacy-sensitive scenarios, e.g., patient recordings from different hospitals. To address this limitation, we investigate a stricter setting of cross-corpus SER, i.e., source-free cross-corpus SER, aligned with the source-free DA (SFDA) paradigm. In this setting, no source speech data are accessible and only a pre-trained source SER model is available. Building on our prior ECAN (emotion-aware contrastive adaptation network), we propose E$^2$CAN, an enhanced emotion-aware contrastive adaptation network tailored to source-free cross-corpus SER. To evaluate E$^2$CAN, we establish an evaluation protocol on five widely-used speech corpora: CASIA, EmoDB, EMOVO, eNTERFACE, and IEMOCAP, and compare against seven recent state-of-the-art SFDA methods. Experiments demonstrate the effectiveness and superiority of E$^2$CAN in addressing source-free cross-corpus SER.},
}

@misc{wenming_zheng_eef9a7c40403,
  title = {AVI Challenge 2026: Assessing True Personality Traits and Cognitive Ability from Asynchronous Video Interviews (AVIs)},
