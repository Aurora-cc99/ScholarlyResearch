@misc{panorama_6ea6272c5bf0_78ddeaf51f8b0b5b,
  title = {A Survey of Deep Learning-Based Multimodal Emotion Recognition: Speech, Text, and Face},
  author = {Hailun Lian and Cheng Lu and Sunan Li and Yan Daniel Zhao and Chuangao Tang and Yuan Zong},
  year = {2023},
