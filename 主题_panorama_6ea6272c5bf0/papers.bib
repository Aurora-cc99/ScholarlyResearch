@misc{wenming_zheng_1009fd5e3ac4,
  title = {Towards Domain-Specific Cross-Corpus Speech Emotion Recognition Approach},
  author = {Yan Zhao and Yuan Zong and Hailun Lian and Cheng Lu and Jingang Shi and Wenming Zheng},
  year = {2025},
