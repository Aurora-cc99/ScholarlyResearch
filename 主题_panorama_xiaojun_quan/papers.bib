@misc{panorama_xiaojun_quan_239480fb99c0a24f,
  title = {Regularizing Flat Latent Variables with Hierarchical Structures},
  author = {Rongcheng Lin and Huayu Li and Xiaojun Quan and Richang Hong and Zhiang Wu and Yong Ge},
  year = {2015},
  url = {http://ijcai.org/Abstract/15/516},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：使用层次结构正则化平面潜在变量},
  abstract = {In this paper, we propose a stratified topic model (STM). Instead of directly modeling and inferring flat topics or hierarchically structured topics, we use the stratified relationships in topic hierarchies to regularize the flat topics. The topic structures are captured by a hierarchical clustering method and play as constraints during the learning process. We propose two theoretically sound and practical inference methods to solve the model. Experimental results with two real world data sets and various evaluation metrics demonstrate the effectiveness of the proposed model.},
}

@misc{panorama_xiaojun_quan_653525e80d834b99,
  title = {Short and Sparse Text Topic Modeling via Self-Aggregation},
  author = {Xiaojun Quan and Chunyu Kit and Yong Ge and Sinno Jialin Pan},
  year = {2015},
  url = {http://ijcai.org/Abstract/15/321},
  howpublished = {IJCAI},
  annotation = {中文辅助译名：通过自聚合进行短而稀疏的文本主题建模},
  abstract = {The overwhelming amount of short text data on social media and elsewhere has posed great chal-lenges to topic modeling due to the sparsity prob-lem. Most existing attempts to alleviate this prob-lem resort to heuristic strategies to aggregate short texts into pseudo-documents before the application of standard topic modeling. Although such strate-gies cannot be well generalized to more general genres of short texts, the success has shed light on how to develop a generalized solution. In this pa-per, we present a novel model towards this goal by integrating topic modeling with short text aggre-gation during topic inference. The aggregation is founded on general topical affinity of texts rather than particular heuristics, making the model read-ily applicable to various short texts. Experimental results on real-world datasets validate the effective-ness of this new model, suggesting that it can distill more meaningful topics from short texts. 1},
}

