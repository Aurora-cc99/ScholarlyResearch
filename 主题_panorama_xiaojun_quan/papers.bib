@misc{panorama_xiaojun_quan_6823a731b2cba224,
  title = {Automatic Construction of Semantic Dictionary for Question Categorization},
  author = {Tianyong Hao and Xingliang Ni and Xiaojun Quan and Wenyin Liu},
  year = {2009},
  url = {https://doaj.org/article/ee5a7390d18b4cfd99c643af0c3c07ce},
  howpublished = {DOAJ (DOAJ: Directory of Open Access Journals)},
  annotation = {中文辅助译名：自动构建问题分类语义词典},
  abstract = {An automatic method for building a semantic dictionary from existing questions in a pattern-based question answering system is proposed for question categorization. This dictionary consists of two main parts: Semantic Domain Terms (SDT), which is a domain specific term list, and Semantic Labeled Terms (SLT), which contain common terms tagged with semantic labels. The semantic dictionary is built using the proposed method on a set of 2509 questions with semantic patterns in our system. 3390 questions without semantic patterns are used as ground truth to test its performance. Experimental results show that the precision of question classification is improved by 7.5% in average after using the constructed semantic dictionary compared with the baseline method.},
}

@misc{panorama_xiaojun_quan_7138f4efd589e667,
  title = {Adaptive label-driven scaling for latent semantic indexing},
  author = {Xiaojun Quan and Enhong Chen and Qiming Luo and Hui Xiong},
  year = {2008},
  doi = {10.1145/1390334.1390525},
  url = {https://doi.org/10.1145/1390334.1390525},
  howpublished = {SIGIR},
  annotation = {中文辅助译名：用于潜在语义索引的自适应标签驱动缩放},
  abstract = {This paper targets on enhancing Latent Semantic Indexing (LSI) by exploiting category labels. Specifically, in the term-document matrix, the vector for each term either appearing in labels or semantically close to labels is scaled before performing Singular Value Decomposition (SVD) to boost its impact on the generated left singular vectors. As a result, the similarities among documents in the same category are increased. Furthermore, an adaptive scaling strategy is designed to better utilize the hierarchical structure of categories. Experimental results show that the proposed approach is able to significantly improve the performance of hierarchical text categorization.},
}

