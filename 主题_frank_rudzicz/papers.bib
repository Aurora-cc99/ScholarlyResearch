  author = {Ishan Thukral and Andrea Gershon and Parco Sin and Daniyal Liaqat and Robert Wu and Hisham Alshaer and Frank Rudzicz and Eyal de Lara},
  year = {2016},
  doi = {10.1145/2938559.2938606},
  url = {https://doi.org/10.1145/2938559.2938606},
  howpublished = {MobiSys (Companion Volume)},
  annotation = {中文辅助译名：海报：WearCOPD - 使用智能手表远程监测慢性阻塞性肺病患者},
  abstract = {Chronic Obstructive Pulmonary Disease (COPD) is a chronic lung disease that is characterized by airway obstruction, coughing, shortness of breath and increased sputum production. An acute exacerbation of COPD is a sudden worsening of the disease. Acute exacerbations result in more frequent and severe coughing and increased difficulty breathing. If not treated quickly, hospitalization may be required which is expensive and decreases patient's quality of life. If untreated, an acute exacerbation can lead to death. We present WearCOPD, an application that uses a smartwatch and smartphone to continuously monitor physiological signs from patients with the goal of predicting exacerbations before they happen.},
}

