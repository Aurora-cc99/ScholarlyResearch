  abstract = {BACKGROUND: Dementia and heart failure (HF) frequently coexist; however, the relationship between these conditions is not fully explored. OBJECTIVES: The objectives of the study were to: 1) compare dementia incidence in newly-diagnosed patients with HF or matched non-HF controls; and 2) examine risk factors for and outcomes after dementia diagnosis in HF patients. METHODS: In community-dwelling residents (aged 40-80 years), we compared incident dementia in those with new-onset HF vs age/sex, and cardiovascular risk factor/disease-matched non-HF controls. In those with HF, we examined time-varying dementia onset as the exposure with outcomes of mortality and hospitalization. We also compared physician visits after vs before dementia diagnosis. RESULTS: Among 211,548 outpatients with HF (median 68 [60-75] years, 41.2% female), time-dependent HRs for dementia were 1.42 (95% CI: 1.38-1.47) at 5 years and 1.31 (95% CI: 1.27-1.35) at 10 years compared to non-HF controls. Prior stroke or transient ischemia attack (HR: 1.41; 95% CI: 1.33-1.50) and hospital frailty risk score >10 vs <5 (HR: 1.93; 95% CI: 1.77-2.09) were important predictors of dementia (both P < 0.001). Incident dementia was associated with higher multivariable-adjusted hazards of all-cause mortality (HR: 2.44; 95% CI: 2.40-2.49) and all-cause hospitalization (HR: 1.63; 95% CI: 1.58-1.69) in outpatients with HF (all P < 0.001). Rates of outpatient physician visits with primary care, internal medicine, cardiologists (p},
}

@misc{frank_rudzicz_aeeab8a957d5cc1f,
  title = {Integrative Functional Genomics Identifies Candidate Brain and Pituitary Regulatory Mechanisms of Reproductive Aging},
  author = {Suzan Farhang‐Sardroodi and Amin Madani and Frank Rudzicz},
  year = {2026},
  doi = {10.21203/rs.3.rs-11157515/v1},
  url = {https://doi.org/10.21203/rs.3.rs-11157515/v1},
  howpublished = {Research Square},
  annotation = {中文辅助译名：Integrative Functional Genomics Identifies Candidate Brain and Pituitary Regulatory Mechanisms of Reproductive Aging},
  abstract = {We analyzed genome-wide association study (GWAS) summary statistics for age at natural menopause (ANM) from 173,424 women of European ancestry and identified 230 genomic risk loci, 108 of which were novel. Fine-mapping prioritized 216 representative variants, one per fine-mapped locus, each within a 90% credible set and with posterior inclusion probability (PIP) > 0.03; 168 of these variants were novel. Integration of transcriptome-wide association analysis (TWAS), Mendelian randomization (MR), and colocalization prioritized genes with complementary functional genomic evidence. Single-cell enhancer–gene maps highlighted candidate cell-type-specific regulatory targets in brain and pituitary, including HSD17B6 in inhibitory neurons, NBR1 and HGS in oligodendrocyte precursor cells (OPCs), and ERBB4 in pituitary lactotropes. TWAS showed positive associations of genetically predicted NBR1 expression in ovary (Z = 15) and ERBB4 expression in pituitary (Z = 5.1) with ANM. MR identified associations between later ANM and higher genetically predicted expression of HSD17B6 across five brain tissues, including frontal cortex BA9 (β = 0.087), as well as higher genetically predicted expression of NBR1 in cerebellum (β = 0.095). These findings advance the interpretation of ANM genetics by prioritizing candidate variants and genes and highlighting cell-type-specific regulatory mechanisms potentially relevant to reproductive aging.},
}

