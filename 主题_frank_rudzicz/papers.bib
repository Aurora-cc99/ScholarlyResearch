@misc{frank_rudzicz_69936cf3bf6bc1b2,
  title = {Multi-Token Prediction and Alternative Tokenization Improve Learning Latent Multi-Hop Graph Search at Scale},
  author = {Arvid Frydenlund and FuTe Wong and Katherine Lambert and Frank Rudzicz},
  year = {2026},
  doi = {10.48550/arxiv.2610.31439},
  url = {https://arxiv.org/abs/2610.31439},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：Multi-Token Prediction and Alternative Tokenization Improve Learning Latent Multi-Hop Graph Search at Scale},
  abstract = {Given an unseen graph, a start node, $s$, and an end node, $t$, can a language model generate the shortest path from $s$ to $t$? Prior work has found that models fail to learn this task as the graphs scale. We show that this failure has two causes: the supervision signal and the tokenization. First, we theoretically establish and empirically demonstrate the effectiveness of multi-token prediction (MTP), and show that the benefits of MTP are topologically agnostic. Second, we introduce alternative tokenizations and show that the two causes are orthogonal. Using these methods, we break through the scaling wall observed by prior work, consistently and stably learning to solve the task at scales far beyond previous limits.},
}

@misc{frank_rudzicz_fe01c015e7d0d56d,
  title = {REFRAME: A Test Suite for the Knowledge–Deployment Gap in LLMs},
  author = {Elahe Rahimi and François Roewer-Després and Hassan Sajjad and Md Mahbub Alam and Sher Badshah and Elham Dolatabadi and Frank Rudzicz},
  year = {2026},
  doi = {10.18653/2026.emnlp-main.2520},
  url = {https://doi.org/10.18653/2026.emnlp-main.2520},
  howpublished = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  annotation = {中文辅助译名：REFRAME: A Test Suite for the Knowledge–Deployment Gap in LLMs},
  abstract = {Large language models (LLMs) are commonly evaluated on multiple-choice tasks that ask them to select an answer or to abstain on unanswerable questions.Neither setting captures frame-breaking: where the question is answerable, but the correct answer lies outside the framing of a candidate set of invalid answers.A useful model must reframe the task, rather than choose an invalid frame-compliant answer.We introduce REFRAME, a test suite of 150 scenarios in which a commonsense constraint invalidates their framing.Each REFRAME scenario is additionally paired with a direct knowledge probe of the same frame-breaking constraint, which we leverage to separate what a model knows from what it deploys.Across nine frontier LLMs, we observe a substantial knowledge-deployment gap with zero-shot prompting.A targeted reasoning prompt only partially closes this gap.Human annotators, by contrast, readily detect the constraint and reframe the problem.Together, these results characterize frame-breaking as a distinct reasoning challenge and demonstrate significant room for LLM improvement.},
}

@misc{frank_rudzicz_8ee3177b56732231,
  title = {SphereEdit: Spherical Semantic Editing in Diffusion Models},
  author = {Elham Dolatabadi and Laleh Seyyed-Kalantari and Salamata Konate and Frank Rudzicz and Hassan Hamidi},
  year = {2026},
  doi = {10.1109/WACV61042.2026.00780},
  url = {https://doi.org/10.1109/WACV61042.2026.00780},
  howpublished = {WACV},
  annotation = {中文辅助译名：SphereEdit：扩散模型中的球形语义编辑},
  abstract = {Despite significant advances in diffusion models, achieving precise and composable image editing without task-specific training remains a challenge. Existing approaches often rely on iterative optimization or linear latent operations, which are slow, brittle, and prone to attribute entanglement (e.g., editing "lipstick" inadvertently alters skin tone). We introduce SphereEdit, a training-free framework that leverages the spherical geometry of diffusion embeddings and token aware cross-attention to enable interpretable, fine-grained control. We represent semantic attributes as unit vector directions in the denoiser’s prediction space and show that antipodal symmetry (‘old’ is approximately the negation of ‘young’) naturally supports bidirectional edits, while approximate orthogonality enables clean composition through spherical coefficient. At inference, these directions modulate cross-attention activations, producing spatially localized edits without optimization or fine-tuning. SphereEdit achieves sharper, more disentangled edits than prior baselines, while remaining plug-and-play and applicable across diverse image editing tasks. The code is available at https://github.com/sala-kon/SphereEdit},
}

@misc{frank_rudzicz_0cf54aeb42e795b6,
  title = {Standardization of actigraphy processing for research platforms},
  author = {André Comiran Tonon and Adile Nexha and Jason d’Eon and Luísa K. Pilz and Pierre Blier and Nicholas A. Bock and Amer M. Burhan and Nathan W. Churchill and Faranak Farzan and Jane Allyson Foster and Fabiano A. Gomes and Kate Harkness and Stefanie Hassel and Muhammad Ishrat Husain and Luciano Minuzzi and María Paz Loayza Hidalgo and Keith Ho and Stefan M. Kloiber and Raymond Wing Moon Lam and Roumen Milev and Daniel J. Müller and Abraham Nunes and Sagar V. Parikh and Lena Catherine Quilty and Joshua Rosenblat and Susan Rotzinger and Frank Rudzicz and Claudio N. Soares and Valerie H. Taylor and Gustavo Turecki and Rudolf Uher and Benicio Noronha Frey},
  year = {2026},
  doi = {10.1080/07420528.2026.2753649},
  url = {https://doi.org/10.1080/07420528.2026.2753649},
  howpublished = {Chronobiology International},
  annotation = {中文辅助译名：Standardization of actigraphy processing for research platforms},
  abstract = {Actigraphy is a non-invasive method for continuous monitoring of rest–activity cycles, sleep patterns, light exposure, body temperature and other physiological rhythms in real-world settings. By passively capturing behavioral data over extended periods, it enables detailed characterization of the temporal dynamics of biological rhythms and their relevance to physiology and health. As actigraphy becomes increasingly common in large-scale observational studies and clinical trials, the need for standardized procedures in data acquisition and processing has become urgent. Variability across devices, scoring algorithms, and analytic pipelines can hinder reproducibility and limit the integration of data across data collection sites. This report introduces standardized guidelines for the use of actigraphy in clinical research, supporting reproducibility, comparability and harmonization across studies. A fillable standardized operating procedure for actigraphy research, along with an empirical example, supports best practices across the full workflow, from device selection and data collection to quality control, analysis, and transparent reporting. By promoting clarity in documentation, harmonization of processing choices, and rigorous quality control, this work aims to enhance the reliability and reproducibility of actigraphy-derived variables as potential digital biomarkers and to support broader implementation of actigraphy in studies of health and disease.},
}

