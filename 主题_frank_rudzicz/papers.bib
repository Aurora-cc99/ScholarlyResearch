  howpublished = {JMIR Formative Research},
  annotation = {中文辅助译名：用于动态风险评估和结果优化的人工智能（AIRO）：心脏外科机器学习的治理驱动框架（预印本）},
  abstract = {BACKGROUND Contemporary cardiac surgical risk assessment is largely based on static regression-derived models that do not account for evolving perioperative data or integration within clinical workflows. Although machine learning approaches offer improved capacity to model complex relationships, most existing applications remain retrospective, outcome-specific, and disconnected from real-world clinical implementation. OBJECTIVE To describe the development of the Artificial Intelligence for dynamic Risk assessment and Outcome optimization (AIRO) platform, a clinician-led, governance-driven framework designed to support dynamic, explainable risk assessment and clinical decision support across the perioperative continuum. METHODS AIRO was developed using a formative research approach integrating retrospective model development with prospective implementation design within a learning health system framework. Baseline predictive modelling (AIRO 1.0) was conducted using a prospectively maintained cardiac surgery registry comprising approximately 30,000 patients and over 13 million data elements. A standardized modelling pipeline was established to support development of multiple outcome-specific models. The AIRO conceptual framework was structured around three layers: population-level risk stratification, individual-level risk explanation, and dynamic outcome optimization. For clinical deployment (AIRO 2.0), a system architecture was designed to enable real-time model inference wit},
}

@misc{frank_rudzicz_6108a6c4347cf72e,
  title = {Design and User-Centred Evaluation of a Persuasive and Explainable AI App for Health Monitoring},
  author = {Fidelia A. Orji and Grace Ataguba and Rita Orji and Frank Rudzicz and Divy Bhavsar and Harshil Makwana},
  year = {2026},
  doi = {10.1109/IS71416.2026.11727343},
  url = {https://doi.org/10.1109/IS71416.2026.11727343},
  howpublished = {IS},
  annotation = {中文辅助译名：用于健康监测的有说服力且可解释的人工智能应用程序的设计和以用户为中心的评估},
  abstract = {Continuous health monitoring can support early identification of potential health risks and well-being beyond episodic clinic-based care. This paper presents the design and user-centred evaluation of VitalAnchor, an intelligent mobile health app that integrates smartwatch-based vital sign monitoring, AI-based detection of abnormal vital sign patterns, explainable AI feedback, and persuasive health prompts to encourage appropriate follow-up actions. Thirty adults interacted with the app prototype and evaluated its usability using the System Usability Scale (SUS). Adapted Health Belief Model (HBM) was also used to assess beliefs concerning specific behavioural referent of regular health monitoring, and participants also provided written rationales and app-related comments. We analyzed quantitative data using descriptive and inferential statistics, and open-ended responses using thematic analysis. The results showed that the app achieved excellent usability, with a mean SUS score of 85.8. Perceived susceptibility, perceived severity, perceived benefits, cues to action, and self-efficacy were significantly above the neutral point, while perceived barriers to regular health monitoring were significantly below it. Thematic analysis identified themes concerning ease of use; understanding and transparency of AI explanations; perceived health utility; trust, accuracy, and self-efficacy; and design improvements. Participants valued plain-language interpretations and actionable recommen},
}

@misc{frank_rudzicz_e668a94fa9c4edca,
  title = {Is This LLM Library Learning? Evaluation Must Account For Compute and Behaviour},
  author = {Xujie Si and Frank Rudzicz and Ian Berlot-Attwell and Tobias Sesterhenn},
  year = {2026},
  doi = {10.18653/V1/2026.EACL-LONG.163},
  url = {https://doi.org/10.18653/V1/2026.EACL-LONG.163},
  howpublished = {EACL (Volume 1: Long Papers)},
  annotation = {中文辅助译名：这是LLM图书馆学习吗？评估必须考虑计算和行为},
  abstract = {The in-context learning (ICL) coding, reasoning, and tool-using ability of LLMs has spurred interest in library learning (i.e., the creation and exploitation of reusable and composable functions, tools, or lemmas). Such systems often promise improved task performance and computational efficiency by caching reasoning (i.e., storing generated tools) - all without finetuning. However, we find strong reasons to be skeptical. Specifically, we identify a serious evaluation flaw present in a large number of ICL library learning works: these works do not correct for the difference in computational cost between baseline and library learning systems. Studying three separately published ICL library learning systems, we find that all of them fail to consistently outperform the simple baseline of prompting the model - improvements in task accuracy often vanish or reverse once computational cost is accounted for. Furthermore, we perform an in-depth examination of one such system, LEGO-Prover, which purports to learn reusable lemmas for mathematical reasoning. We find no evidence of the direct reuse of learned lemmas, and find evidence against the soft reuse of learned lemmas (i.e., reuse by modifying relevant examples). Our findings suggest that a serious re-examination of the effectiveness of ICL LLM-based library learning is required, as is much stronger standards for evaluation. An equal computational budget must be used for baselines, alongside behavioural analysis.},
}

