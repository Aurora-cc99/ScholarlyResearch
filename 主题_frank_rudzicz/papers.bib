@misc{frank_rudzicz_1829d7cf7b302c1f,
  title = {A Straightforward Approach to Construct “Lightweight” Token Graphs from Transformers},
  author = {João Pimentel and Joana Amorim and Frank Rudzicz},
  year = {2026},
  doi = {10.1162/coli.a.618},
  url = {https://doi.org/10.1162/coli.a.618},
  howpublished = {Computational Linguistics},
  annotation = {中文辅助译名：从 Transformer 构建“轻量级”Token图的直接方法},
  abstract = {Even though Transformers are the standard to extract information from text, they have considerable limitations that make them sub-optimal for certain tasks. Graph neural networks (GNNs) are an alternative that mitigate some of these limitations, with recent work focusing on combining information from pre-trained language models (PLMs) with graph structures. However, most existing methods use fixed-size sliding windows to construct graphs, ignoring long-distance relationships between words. We propose a memory-efficient method to construct token graphs that exploits semantic and relational information inside Transformers via their attention coefficients, mitigating the limitations of using sliding windows. Additionally, each graph can fully encode documents longer than the Transformer’s context window via a chunk-and-stride mechanism, while also reducing memory usage. Our method surpasses the performance of sliding windows when both approaches are compared under the same model architecture, particularly in longer documents, and reaches statistically identical performance in shorter ones. It also surpasses GNN-based state-of-the-art techniques. When compared with fine-tuning, our method reaches marginally lower performance in documents that fit inside the pre-trained model’s context window. However, our method surpasses fine-tuning in documents that do not fit inside these windows, which comes as a result of fully encoding each document using our chunk-and-stride mechanism.},
}

@misc{frank_rudzicz_ff0fd08f312d4f92,
  title = {Voluntary Collusion with Secret Tools in Competing LLM Agents},
  author = {Frank Rudzicz and Xijie Zeng},
  year = {2026},
  doi = {10.48550/ARXIV.2605.27593},
  url = {https://doi.org/10.48550/ARXIV.2605.27593},
  howpublished = {CoRR},
  annotation = {中文辅助译名：大语言模型智能体人之间自愿与秘密工具勾结},
  abstract = {Even when a tool is explicitly described as unfair and harmful to others, ostensibly safety-aligned LLM agents still voluntarily engage in secret collusion whenever doing so confers a strategic advantage. To investigate this phenomenon, we introduce an empirical framework built on two strategic multi-agent environments: Liar's Bar, a competitive deception scenario, and Cleanup, a mixed-motive resource-management scenario, in which agents are offered secret collusion tools that provide significant advantages while clearly disadvantaging the other agents. Across 12 models (at the 7B, 70B, and proprietary scales) and 6 prompt variants, we find that most agents consistently accept these tools and develop collusive strategies, while explicitly acknowledging the unfairness of the tools before accepting. We further show that neither the unfairness labels nor baseline alignment alone reliably deters collusion: only explicit ethical framing reduces adoption and, even then, smaller models remain susceptible. More broadly, our work presents the first systematic investigation of voluntary collusion adoption in LLM-based multi-agent systems, and suggests that preventing such behaviour requires explicit safeguards rather than reliance on general alignment.},
}

@misc{frank_rudzicz_af99bc03496129a4,
  title = {Path-Level Structural and Semantic Alignment for Hierarchical Multi-Label Text Classification},
  author = {Xindi Wang and Aifen Xiong and Baiyang Wang and Xuri Ge and Robert L. Mercer and Frank Rudzicz and Yifan Peng and Zhumin Chen and Hongjun Wang},
  year = {2026},
  doi = {10.48550/arxiv.2611.12420},
  url = {https://arxiv.org/abs/2611.12420},
  howpublished = {arXiv (Cornell University)},
  annotation = {中文辅助译名：分层多标签文本分类的路径级结构和语义对齐},
  abstract = {Hierarchical multi-label text classification (HMTC) requires models to capture both structural dependencies among labels and the fine-grained semantics of labels at different hierarchy levels. Existing methods often model hierarchy through prediction constraints or representations of individual labels and local relations. Structural and semantic supervision, however, are usually formulated separately. We instead use complete root-to-node label paths as a shared unit for both. Our framework introduces two auxiliary training objectives while retaining a standard multi-label classifier at inference. PathSimNCE aligns document representations with hierarchical paths using hierarchy-aware contrastive targets. These targets provide graded supervision for structurally related paths while preserving explicit supervision for the ground-truth paths. The complementary semantic objective uses LLM-generated, document-conditioned descriptions of the same positive paths. It thereby provides context-specific label semantics beyond static label representations. Experiments on three benchmarks show consistent improvements: structural alignment is particularly beneficial in deeper hierarchies, while semantic alignment provides additional gains for fine-grained labels.},
}

@misc{frank_rudzicz_fc821b7e5a43a8c8,
  title = {Correction: The development and usability of ‘The Genetics Navigator’: a digital solution for adult and paediatric clinical genetics services},
  author = {Saumeh Saeedi and Daena Hirjikaka and Marc Clausen and Stephanie Luca and Emma Reble and Rita Kodida and Daniel Assamad and Lauren Chad and Gregory Costain and Hanna Faghfoury and Josh Silver and Serena Shastri-Estrada and Maureen Smith and Robin Z. Hayeems and Yvonne Bombard and The Genetics Navigator Study Team and Melyssa D. Aronson and FP Bernier and Michael Brudno and June C. Carroll and Ronald D. Cohn and Irfan A. Dhalla and JN Friedman and Stacey Hewson and Trevor Jamieson and Rebekah Kjerland Jobling and Anne‐Marie Laberge and Jordan P. Lerner‐Ellis and Eriskay Liston and Muhammad Mamdani and Christian R. Marshall and Matthew Osmond and Quỳnh Phạm and Frank Rudzicz and Emily Seto and Cheryl T. Shuman and Kevin Thorpe and Wendy J. Ungar},
