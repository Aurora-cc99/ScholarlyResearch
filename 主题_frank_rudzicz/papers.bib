@misc{frank_rudzicz_31ed0e7168e89491,
  title = {Postcard Memories: an interactive tablet application for elders with early-stage dementia},
  author = {Martha Ladly and Frank Rudzicz and Bryn A. Ludlow and Ana Jofré and Wright, Laura},
  year = {2015},
  url = {http://openresearch.ocadu.ca/id/eprint/1213/1/Ladly_Postcard_2015.pdf},
  howpublished = {OCAD University Open Research Repository (OCAD University)},
  annotation = {中文辅助译名：明信片回忆：为患有早期痴呆症的老年人设计的交互式平板电脑应用程序},
  abstract = {In this demonstration, we present ‘Postcard Memories’, an interactive \ntablet application to create a social space for elders with \nearly stage dementia. The touchscreen tablet application encourages \npeople to create, organize, and send digital postcards that \ncombine photographs and short text with audio and video. Users \ncan send digital or print postcards to family, friends, and caregivers \nto encourage memory recall and facilitate social interaction. \nResults from a mixed method user study indicate that people find \nthe interaction with the application enjoyable and meaningful.},
}

