  author = {Whiwon Lee and Daena Hirjikaka and Sonya K. Grewal and Angela Shaw and Stephanie Luca and Marc Clausen and Yvonne Bombard and Robin Z. Hayeems and Yvonne Bombard and Robin Z. Hayeems and Melyssa D. Aronson and François P. Bernier and Michael Brudno and June C. Carroll and Lauren Chad and Marc Clausen and Ronald D. Cohn and Gregory Costain and Irfan A. Dhalla and Hanna Faghfoury and Jan M. Friedman and Stacy Hewson and Trevor Jamieson and Rebekah Kjerland Jobling and Rita Kodida and Anne‐Marie Laberge and Jordan P. Lerner‐Ellis and Eriskay Liston and Stephanie Luca and Muhammad Mamdani and Christian R. Marshall and Matthew Osmond and Quỳnh Phạm and Emma Reble and Frank Rudzicz and Emily Seto and Serena Shastri-Estrada and Cheryl T. Shuman and Josh Silver and Maureen Smith and Kevin E. Thorpe and Wendy J. Ungar},
