  annotation = {中文辅助译名：MSPB 2.0：用于高级多模式蜜蜂监测的音频蜂箱数据},
  abstract = {MSPB 2.0 is an extension of the MSPB dataset, which provides extended time coverage, expanded sensor data, and more granular phenotypic measurements compared to its predecessor. More specifically, MSPB 2.0 covers two years of multimodal sensor data (audio, humidity, and temperature per box) collected from 100 honey bee colonies (Apis mellifera), paired with extensive phenotypic trait measurements and exogenous environment data.},
}

@misc{tiago_falk_e4f9bce5c68749b7,
  title = {Changes in Heart Rate Variability During Immersive Multisensory Forest Bathing Experiences},
  author = {Marilia K. S. Lopes and Belmir Jose De Jesus and Olivier Rosanne and Susanna Pardini and Lora Appel and Christopher Smith and Tiago Henrique Falk},
  year = {2025},
  doi = {10.54941/ahfe1006347},
  url = {https://doi.org/10.54941/ahfe1006347},
  howpublished = {AHFE international},
  annotation = {中文辅助译名：沉浸式多感官森林沐浴体验中心率变异性的变化},
  abstract = {Exposure to nature promotes relaxation and reduces stress, but accessibility concerns have led to increased investigation of virtual reality nature simulations, including “virtual forest bathing.” This study examines the effects of audiovisual (AV) and audio-visual-olfactory (AVO) immersive VR experiences on relaxation, quality of experience (QoE), and heart rate variability (HRV) among nurses in a mental health inpatient unit. Participants experienced 2.5-min sessions of 360° natural scenes with counterbalanced conditions. Both conditions (AV and AVO) showed improvements in relaxation and QoE ratings, while the AVO condition resulted in greater HRV changes towards the end of the experience, as well as greater correlations with subjective relaxation and QoE ratings.},
}

