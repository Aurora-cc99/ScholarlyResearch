  url = {https://doi.org/10.1186/1687-6180-2014-49},
  howpublished = {EURASIP J. Adv. Signal Process.},
  annotation = {中文辅助译名：修正：脑电图振幅调制分析用于阿尔茨海默病的半自动诊断},
  abstract = {Author details Institut National de la Recherche Scientifique, Energy, Materials, and Telecommunications, University of Quebec, Montreal, Quebec, Canada. Engineering, Modeling and Applied Social Sciences Center, Universidade Federal do ABC, Santo Andre, Brazil. Mathematics, Computing and Cognition Center, Universidade Federal do ABC, Santo Andre, Brazil. Reference Center of Behavioral Disturbances and Dementia, School of Medicine, Universidade de Sao Paulo, Sao Paulo, Brazil.},
}

@misc{tiago_falk_0570d07c886b8899,
  title = {Investigating the use of modulation spectral features within an i-vector framework for far-field automatic speaker verification},
  author = {Anderson Raymundo Avila and Francisco J. Fraga and Milton Sarria-Paja and Tiago Henrique Falk},
  year = {2014},
  doi = {10.1109/its.2014.6948012},
  url = {https://doi.org/10.1109/its.2014.6948012},
  howpublished = {International Telecommunications Symposium (ITS)},
  annotation = {中文辅助译名：研究在 i 向量框架内使用调制频谱特征进行远场自动说话人验证},
  abstract = {It is known that channel variability compromises automatic speaker recognition accuracy. However, little attention has been given so far to the detrimental effects encountered under reverberant environments. In this paper, we focus on the issue of automatic speaker verification (ASV) under several levels of room reverberation. Alternative auditory inspired features are explored. Specifically, we investigate whether the performance of the so-called modulation spectral features (MSFs) can overcome the well-known mel-frequency cepstral coefficients (MFCCs). Experiments were conducted with an ASV system based on the state-of-the-art i-vector. The main contribution of this paper is to verify if MSFs combined with i-vectors are able to present the same performance encountered in the literature regarding speech recognition and speaker identification systems in reverberant environment.},
}

