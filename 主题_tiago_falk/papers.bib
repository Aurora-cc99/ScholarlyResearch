@misc{tiago_falk_ffbf78229050e146,
  title = {QoN: Quality of Experience (QoE) Framework for Network Services},
  author = {Asif Ali Laghari and Khalil ur Rehman Laghari and Muhammad Ibrahim Channa and Tiago Henrique Falk},
  year = {2012},
  doi = {10.1115/1.860151_ch50},
