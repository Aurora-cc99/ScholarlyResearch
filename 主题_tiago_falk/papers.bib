  annotation = {中文辅助译名：融合听觉调幅频谱和倒谱特征，用于耳语和正常语音说话者验证},
}

@misc{tiago_falk_995ade7326dda1b3,
  title = {Speech quality enhancement of in-ear microphone},
  author = {Rachel E. Bouserhal and Tiago Henrique Falk and Jérémie Voix},
