@misc{tiago_falk_66616f7562de7ec1,
  title = {Tracking user trust and mental states during cyber-attacks: A survey of existing methods and future research directions on AI-enabled decision-making for the Royal Canadian Navy},
  author = {Ming Hou and Tiago H. Falk and Liam Foley and Simon P. Banbury and Madison Cameron and Sebastian Fischmeister and G. Robert Arrabito and Hannah Willoughby and Sarah Normandin},
  year = {2024},
  doi = {10.1109/ICHMS59971.2024.10555658},
  url = {https://doi.org/10.1109/ICHMS59971.2024.10555658},
  howpublished = {ICHMS},
  annotation = {中文辅助译名：跟踪网络攻击期间的用户信任和心理状态：加拿大皇家海军人工智能决策的现有方法和未来研究方向调查},
  abstract = {The increased use of artificial intelligence to detect cyber-attacks against military organizations can put the operator at risk of having miscalibrated trust in the autonomous system. The present paper reviews techniques to capture the human experience of cyber-attacks to support advanced cybersecurity training strategies for the Royal Canadian Navy. Psychophysiological sensors can provide objective measures to help predict the changing mental states of cyber operators (e.g., predict cognitive load, trust, stress) of whether the operator is aware of ongoing human-noticeable aspects of cyber-attacks. Techniques for measuring the experience of cyber-attacks will help advance research on decision-making in automated systems.},
}

@misc{tiago_falk_ef409c67fff0a0fb,
  title = {Brained-inspired optical computing unit based on transient nonlinear dynamics of single-mode fibers},
  author = {Nicolas Perron and Bennet Fischer and Mario Chemnitz and Yi Ming Zhu and Piotr Roztocki and Benjamin MacLellan and Luigi Di Lauro and Abdul Rahim Aadhi and Cristina Rimoldi and Tiago Henrique Falk and Roberto Morandotti},
  year = {2024},
  doi = {10.1364/cleo_si.2024.stu3p.5},
  url = {http://dx.doi.org/10.1364/cleo_si.2024.stu3p.5},
  howpublished = {Conference on Lasers and Electro-Optics},
  annotation = {中文辅助译名：基于单模光纤瞬态非线性动力学的类脑光计算单元},
  abstract = {We developed and studied a hardware-based neuromorphic wave computer using optical nonlinearities. Here, we showcase the low-power consumption, robustness, and scalable complexity of soliton-based spectral broadening as a novel neuromorphic approach.},
}

@misc{tiago_falk_4d634c022bb7688d,
  title = {Implementation and Scaling of an Optical Computing Unit Based on Transient Nonlinear Dynamics},
  author = {Nicolas Perron and Bennet Fischer and Mario Chemnitz and Yi Ming Zhu and Piotr Roztocki and Benjamin MacLellan and Luigi Di Lauro and Abdul Rahim Aadhi and Cristina Rimoldi and Tiago Henrique Falk and Roberto Morandotti},
  year = {2024},
  doi = {10.1109/pn62551.2024.10621829},
  url = {http://dx.doi.org/10.1109/pn62551.2024.10621829},
  howpublished = {Photonics North (PN)},
  annotation = {中文辅助译名：基于瞬态非线性动力学的光学计算单元的实现和扩展},
  abstract = {We build and use a neuromorphic wave computer established on soliton-based spectral broadening. Featuring low-power consumption, robustness, and scalability, our approach enables the emulation of a variety of neural networks using a single system setting, opening the way to opportunities in sustainable photonic computing and machine learning applications.},
}

@misc{tiago_falk_9c5e6656e75ca631,
  title = {Harnessing nonlinear broadening dynamics in single-mode fibers for neuromorphic computing},
  author = {Mario Chemnitz and Bennet Fischer and Yi Ming Zhu and Mohammad Sobhi Saeed and Nicolas Perron and Imtiaz Alamgir and Piotr Roztocki and Benjamin MacLellan and Luigi Di Lauro and Cristina Rimoldi and Tiago Henrique Falk and Roberto Morandotti},
  year = {2024},
  doi = {10.1117/12.3028152},
  url = {https://doi.org/10.1117/12.3028152},
  howpublished = {Emerging Topics in Artificial Intelligence (ETAI)},
  annotation = {中文辅助译名：利用单模光纤中的非线性展宽动力学进行神经形态计算},
  abstract = {Optical neuromorphic computing marks a breakthrough over traditional digital computing by offering energy-efficient, fast, and parallel processing solutions while challenges remain in incorporating nonlinearity efficiently. Leveraging nonlinear wave dynamics in optical fibers as a computational resource may provide a solution. Our research demonstrates how femtosecond pulse propagation in optical fibers can emulate neural network inference, utilizing the high phase sensitivity of broadband light for creating nonlinear input-output mappings akin to Extreme Learning Machines (ELMs). Experimental results show high classification accuracies and low RMS errors in function regression, all at pico-joule pulse energy. This indicates our method's potential to lower energy consumption for inference tasks, complementing existing spatial-mode systems. We also investigated femtosecond pulses' nonlinear broadening effects – self-phase modulation and coherent soliton fission – demonstrating their distinct impacts on classification tasks and showcasing broadband frequency generation as a powerful, energy-efficient tool for next-generation computing.},
}

