@misc{tiago_falk_40ba987d75097080,
  title = {Characterizing The Confounding Effects of Cybersickness On Mental Workload And Stress Detection Performance During An Immersive Virtual Reality Driving Task Using Electroencephalography},
  author = {Abhishek Tiwari and Marc-Antoine Moinnereau and Danielle Benesch and Nicole K. Bolt and Gregory P. Krätzig and Simon Paré and Tiago Henrique Falk},
  year = {2026},
  doi = {10.1109/icassp55912.2026.11465039},
  url = {https://doi.org/10.1109/icassp55912.2026.11465039},
  howpublished = {IEEE International Conference on Acoustics Speech and Signal Processing},
  annotation = {中文辅助译名：使用脑电图描述沉浸式虚拟现实驾驶任务期间晕车对心理工作量和压力检测性能的混杂影响},
  abstract = {Monitoring of stress and mental workload during virtual reality (VR) immersion is important, especially in the context of training exercises, to ensure optimal performance. To this end, electroencephalogram (EEG)-based metrics have been proposed and demonstrated promise in monitoring different cognitive and emotional states. In training scenarios involving complex and dynamic environments (e.g., driver and/or pilot training), however, cybersickness can become a significant barrier, not only affecting training outcomes, but also degrading the performance of EEG-based measures of stress and mental workload due to potentially overlapping neural signatures. In this study, we aim to characterize the confounding effects that cybersickness may have on measures of stress and workload. Using a VR driving task with varying levels of complexity and stressors, we explore the effects that cybersickness has on stress and mental workload measures based on EEG power spectral density (PSD) and coherence-based measures. Experimental results show that the mental state models rely on features derived from occipital regions in the delta EEG subband, which are features typically associated with visual discomfort and cybersickness. These results corroborate that cybersickness may play a crucial detrimental role on mental state monitoring in VR and should be taken into consideration when developing complex training environments.},
}

@misc{tiago_falk_959e4e43fb55d65d,
  title = {Cognitive Training Using a Brain-Computer Interface for $\theta / \beta$ Ratio Self-Regulation - Preliminary Results With Long Covid-19 Survivors},
  author = {Samara Tenório Oliveira Duarte Santana and Jade Carvalho da Silva and Yuzen Hatano and Cristian David Guerrero-Méndez and Mariane Lima de Souza and Tomohiko Igasaki and Teodiano Bastos-Filho and André Felipe Oliveira de Azevedo Dantas and Tiago H. Falk and Denis Delisle-Rodríguez},
  year = {2026},
  doi = {10.1109/ichms69701.2026.11602366},
  url = {https://doi.org/10.1109/ichms69701.2026.11602366},
  howpublished = {IEEE International Conference on Human-Machine Systems (ICHMS)},
  annotation = {中文辅助译名：使用脑机接口进行认知训练以进行 $\theta/\beta$ 比率自我调节 - Covid-19 长期幸存者的初步结果},
  abstract = {Long COVID-19 can generate cognitive impairments, affecting a person's attention, working memory, and executive functions. Previous studies have suggested that therapies based on neurotechnologies can be used to recover cognitive skills. This current research presents an electroencephalography brain-computer interface based serious game for sustained attention training. The system classifies attention levels while the user controls the speed of a virtual car by self-regulating the$\theta / \beta$power band ratio across multiple brain locations. Pilot experiments were conducted with two COVID-19 adult survivors who experienced cognitive decline due to long COVID19 symptoms. Participants underwent 10 sessions across consecutive working days (2 sessions × week). Both participants enhanced brain wave oscillations in both frontal and central regions, reducing theta activity and simultaneously increasing beta oscillations) after the training, achieving therefore healthy brain behavior during a cognitive attention task. Furthermore, both individuals improved cognitive skills, such as attention, working memory, and executive functions. These preliminary findings are promising and motivate the further development of multichannel neurofeedback systems for cognitive training for long COVID-19 survivors.},
}

@misc{tiago_falk_2117647217a70aa3,
  title = {On the Prediction of Varroa Mite Infestations in Honey Bee Colonies via Acoustic Monitoring},
  author = {Mahsa Abdollahi and Yi Ming Zhu and Heitor R. Guimarães and Nico Coallier and Ségolène Maucourt and Pierre Giovenazzo and Tiago Henrique Falk},
  year = {2026},
  doi = {10.1109/jsen.2026.3666127},
  url = {https://doi.org/10.1109/jsen.2026.3666127},
  howpublished = {IEEE Sensors Journal},
  annotation = {中文辅助译名：通过声学监测预测蜂群瓦螨侵扰},
  abstract = {Honey bees play a vital role in global ecosystems and agriculture through their pollination services. However, the Varroa destructor mite remains one of the most damaging parasites affecting honeybee health, contributing significantly to colony decline. Early detection of Varroa infestation is essential for effective beekeeping management. In this study, we propose a machine learning approach for predicting Varroa mite infestation levels based on acoustic analysis of hive recordings. We introduce a set of nine spectral shape descriptors (SSD) computed from conventional and modulation spectrograms to characterize the acoustic environment within hives. We evaluate the predictive power of these features against traditional cepstral features across multiple classifiers, including Support Vector Machines, Random Forests, and k-Nearest Neighbors. Our results demonstrate that the proposed SSDs significantly improve classification performance relative to conventional features across numerous figures-of-merit, particularly in hive-independent test settings. This work highlights the potential of spectral acoustic monitoring combined with supervised learning as a scalable and non-invasive tool for precision beekeeping and early detection of parasitic threats.},
}

@misc{tiago_falk_3de371aeb1c08f22,
  title = {Improved Monitoring of Honey Bee Colony Strength via Audio IoT Sensors, Modulation Tensorgrams, and Recurrent Neural Networks},
  author = {Mahsa Abdollahi and Yi Zhu and Heitor R. Guimarães and Nico Coallier and Ségolène Maucourt and Pierre Giovenazzo and Tiago H. Falk},
  year = {2026},
  doi = {10.1109/tafe.2026.3740361},
  url = {https://doi.org/10.1109/tafe.2026.3740361},
  howpublished = {IEEE Transactions on AgriFood Electronics},
  annotation = {中文辅助译名：通过音频物联网传感器、调制张量图和循环神经网络改进对蜂群强度的监控},
  abstract = {Honey bees (Apis mellifera) play a crucial role in agriculture and ecosystem stability as key pollinators of crops and wild plants. As such, monitoring hive strength remotely with Internet of Things sensors has become a crucial task. Previously, handcrafted features extracted from the modulation spectrum of audio IoT devices were shown to improve acoustic monitoring of colony strength. In this article, we hypothesize that important discriminative information is present in the temporal dynamics of the modulation spectrum, but this information is discarded with prior methods. As such, we explore the use of a new modulation tensorgram where the time dimension is kept. This new representation is used as input to a convolutional neural network and a convolutional recurrent deep neural network. Using the public UrBAN dataset, which contains more than 3000 h of beehive audio recordings, we show that the proposed method improves both accuracy and cross-hive generalizability over prior benchmark methods, and the results further suggest improved robustness to noisy in-the-wild recording conditions. We use saliency maps and gradient-weighted class activation maps for explainability and show the importance of the modulation spectral temporal dynamics for the task at hand. Overall, our results suggest that accurate, generalizable, and robust acoustic monitoring of honey bee colony strength is possible.},
}

