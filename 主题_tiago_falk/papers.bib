@misc{tiago_falk_8e50d0721df9510e,
  title = {Lessons Learned: Recommendations For Implementing a Longitudinal Study Using Wearable and Environmental Sensors in a Health Care Organization},
  author = {Michelle L’Hommedieu and Justin L’Hommedieu and Cynthia Begay and Alison Schenone and Lida Dimitropoulou and Gayla Margolin and Tiago Henrique Falk and Emilio Ferrara and Kristina Lerman and Shrikanth Shri Narayanan},
  year = {2019},
  doi = {10.2196/13305},
  url = {https://doi.org/10.2196/13305},
  howpublished = {JMIR mhealth and uhealth},
  annotation = {中文辅助译名：经验教训：在医疗保健组织中使用可穿戴和环境传感器实施纵向研究的建议},
  abstract = {Although traditional methods of data collection in naturalistic settings can shed light on constructs of interest to researchers, advances in sensor-based technology allow researchers to capture continuous physiological and behavioral data to provide a more comprehensive understanding of the constructs that are examined in a dynamic health care setting. This study gives examples for implementing technology-facilitated approaches and provides the following recommendations for conducting such longitudinal, sensor-based research, with both environmental and wearable sensors in a health care setting: pilot test sensors and software early and often; build trust with key stakeholders and with potential participants who may be wary of sensor-based data collection and concerned about privacy; generate excitement for novel, new technology during recruitment; monitor incoming sensor data to troubleshoot sensor issues; and consider the logistical constraints of sensor-based research. The study describes how these recommendations were successfully implemented by providing examples from a large-scale, longitudinal, sensor-based study of hospital employees at a large hospital in California. The knowledge gained from this study may be helpful to researchers interested in obtaining dynamic, longitudinal sensor data from both wearable and environmental sensors in a health care setting (eg, a hospital) to obtain a more comprehensive understanding of constructs of interest in an ecologically va},
}

@misc{tiago_falk_a5077d20810f7208,
  title = {Multi-objective training of Generative Adversarial Networks with multiple discriminators},
  author = {João Monteiro and Isabela Albuquerque and Breandan Considine and Thang Doan and Tiago H. Falk and Ioannis Mitliagkas},
  year = {2019},
  doi = {10.48550/arxiv.1901.08680},
  url = {http://arxiv.org/abs/1901.08680},
  howpublished = {ICML},
  annotation = {中文辅助译名：具有多个判别器的生成对抗网络的多目标训练},
  abstract = {Recent literature has demonstrated promising results for training Generative Adversarial Networks by employing a set of discriminators, in contrast to the traditional game involving one generator against a single adversary. Such methods perform single-objective optimization on some simple consolidation of the losses, e.g. an arithmetic average. In this work, we revisit the multiple-discriminator setting by framing the simultaneous minimization of losses provided by different models as a multi-objective optimization problem. Specifically, we evaluate the performance of multiple gradient descent and the hypervolume maximization algorithm on a number of different datasets. Moreover, we argue that the previously proposed methods and hypervolume maximization can all be seen as variations of multiple gradient descent in which the update direction can be computed efficiently. Our results indicate that hypervolume maximization presents a better compromise between sample quality and computational cost than previous methods.},
}

