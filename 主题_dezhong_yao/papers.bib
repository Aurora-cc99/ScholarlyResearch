  abstract = {Spectral regression is a newly proposed method which is widely used in signal processing and feature extraction. However, like most methods based on regression analysis, it is prone to outlier artifacts with large norm. In this paper, a novel regression function for SR is constructed in the Lp (p ≤ 1) norm space with the aim at compressing the outlier effects on pattern recognition. The quantitative evaluation using simulated outliers demonstrates the proposed method can effectively deal with the outliers introduced in the features.},
}

@misc{dezhong_yao_4ab7fd65ce4212a1,
  title = {Enhanced functional connectivity and increased gray matter volume of insula related to action video game playing},
  author = {Diankun Gong and Hui He and Dongbo Liu and Weiyi Ma and Li Dong and Cheng Luo and Dezhong Yao},
  year = {2015},
  doi = {10.1038/srep09763},
  url = {https://doi.org/10.1038/srep09763},
  howpublished = {Scientific Reports},
  annotation = {中文辅助译名：与玩动作视频游戏相关的脑岛功能连接增强和灰质体积增加},
  abstract = {Research has shown that distinct insular subregions are associated with particular neural networks (e.g., attentional and sensorimotor networks). Based on the evidence that playing action video games (AVGs) facilitates attentional and sensorimotor functions, this study examined the relation between AVG experience and the plasticity of insular subregions and the functional networks therein that are related to attentional and sensorimotor functions. By comparing AVG experts and amateurs, we found that AVG experts had enhanced functional connectivity and grey matter volume in insular subregions. Furthermore, AVG experts exhibited increased functional connectivity between the attentional and sensorimotor networks, and the experience-related enhancement was predominantly evident in the left insula, an understudied brain area. Thus, AVG playing may enhance functional integration of insular subregions and the pertinent networks therein.},
}

@misc{dezhong_yao_70c7cf4bdd3b08c2,
  title = {Alteration of Basal Ganglia and Right Frontoparietal Network in Early Drug-Naïve Parkinson’s Disease during Heat Pain Stimuli and Resting State},
  author = {Ying Hui Valerie Tan and Juan Tan and Jiayan Deng and Wenjuan Cui and Hui He and Fei Yang and Hongjie Deng and Ruhui Xiao and Zhengkuan Huang and Xingxing Zhang and Rui Tan and Xiaotao Shen and Tao Liu and Xiaoming Wang and Dezhong Yao and Cheng Luo},
  year = {2015},
  doi = {10.3389/fnhum.2015.00467},
  url = {https://doi.org/10.3389/fnhum.2015.00467},
