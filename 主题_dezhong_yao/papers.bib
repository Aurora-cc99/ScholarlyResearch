  author = {Xiaoyan Jia and Yan Xie and Debo Dong and Haonan Pei and Sisi Jiang and Shuai Ma and Yang Huang and Xingxing Zhang and Yuhong Wang and Qiong Zhu and Yanan Zhang and Dezhong Yao and Liang Yu and Cheng Luo},
  year = {2019},
  doi = {10.1002/hbm.24787},
