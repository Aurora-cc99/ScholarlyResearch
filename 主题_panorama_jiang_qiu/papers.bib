@misc{panorama_jiang_qiu_3a512b560f2a7f31,
  title = {Mapping cortical brain asymmetry in 17,141 healthy individuals worldwide via the ENIGMA Consortium},
  author = {Xiangzhen Kong and Samuel R. Mathias and Tulio M. Guadalupe and ENIGMA Laterality Working Group and David C. Glahn and Barbara Franke and Fabrice Crivello and Nathalie Tzourio‐Mazoyer and Simon E. Fisher and Paul M. Thompson and Clyde Francks and ENIGMA Laterality Working Group and Xiangzhen Kong and Samuel R. Mathias and Tulio M. Guadalupe and Christoph Abé and Ingrid Agartz and Theophilus N. Akudjedu and André Aleman and Saud Alhusaini and Nicholas Brian Allen and David J. Ames and Ole A. Andreassen and Alejandro Arias Vásquez and Nicola J. Armstrong and Felipe P. G. Bergo and Mark E. Bastin and Albert Batalla and Jochen Bauer and Bernhard Theodor Baune and Ramona Baur‐Streubel and Joseph Biederman and Sara K. Blaine and Premika S.W. Boedhoe and Erlend Bøen and Anushree Bose and Janita Bralten and Daniel Brandeis and Silvia Brem and Henry Brodaty and Dilara Yüksel and Samantha Jane Brooks and Jan K. Buitelaar and Christian Bürger and Robin Bülow and Vince D. Calhoun and Anna Calvo and Erick Jorge Canales-Rodríguez and José M. Cañive and Dara M. Cannon and Elisabeth C. Caparelli and F. Xavier Castellanos and Gianpiero L. Cavalleri and Fernando Cendes and Tiffany Moukbel Chaim-Avancini and Kaylita C. Chantiluke and Qunlin Chen and Xiayu S. Chen and Yuqi Cheng and Anastasia Christakou and Vincent P. Clark and David Coghill and Colm G. Connolly and Annette Conzelmann and Aldo Córdova‐Palomera and Janna Cousijn and T. J. Crow and Ana Cubillo and Anders Martin Dale and Udo Dannlowski and Sara Ambrosino and Patrick de Zeeuw and Ian J. Deary and Norman Delanty and Damion V. Demeter and Adriana Di Martino and Erin W. Dickie and Bruno Dietsche and Nhat Trung Doan and Colin P. Doherty and Alysa E. Doyle and Sarah Durston and Eric Earl and Stefan Ehrlich and Carl Johan Ekman and Torbjørn Elvsåshagen and Jeffery N. Epstein and Damien A. Fair and Stephen V. Faraone and Guillén Fernández and Geraldo F. Busatto and Katharina Förster and Jean‐Paul Fouché and John J. Foxe and Thomas Frodl and Paola Fuentes‐Claramonte and Janice M. Fullerton and Hugh Garavan and Danielle dos Santos Garcia and Ian H. Gotlib},
  year = {2018},
  doi = {10.1073/pnas.1718418115},
  url = {https://doi.org/10.1073/pnas.1718418115},
  howpublished = {Proceedings of the National Academy of Sciences},
  annotation = {中文辅助译名：通过 ENIGMA 联盟绘制全球 17,141 名健康个体的大脑皮质不对称图},
  abstract = {Significance Left–right asymmetry is a key feature of the human brain's structure and function. It remains unclear which cortical regions are asymmetrical on average in the population and how biological factors such as age, sex, and genetic variation affect these asymmetries. Here, we describe by far the largest-ever study of cerebral cortical asymmetry, based on data from 17,141 participants. We found a global anterior–posterior “torque” pattern in cortical thickness, together with various regional asymmetries at the population level, which have not been previously described, as well as effects of age, sex, and heritability estimates. From these data, we have created an online resource that will serve future studies of human brain anatomy in health and disease.},
}

@misc{panorama_jiang_qiu_3d99804c4da9e942,
