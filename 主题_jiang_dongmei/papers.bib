@misc{jiang_dongmei_34da416a1ec33c73,
  title = {Smoking behavior, knowledge, attitudes and practice among health care providers in Changsha city, China},
  author = {Yan Jin and Shuiyuan Xiao and Dongsheng Ouyang and Dongmei Jiang and Caiyun He and Shanghui Yi},
