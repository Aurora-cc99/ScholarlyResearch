@misc{jiang_dongmei_15b6dd08aaa8,
  title = {Microstate-Guided Dynamic Graph Neural Network with Prototypical Contrastive Learning for EEG Emotion Recognition},
  author = {Zheng Liu and Lei Su and Liping Wu and Di Jiang},
  year = {2026},
  doi = {10.21203/rs.3.rs-10981032/v1},
  url = {https://doi.org/10.21203/rs.3.rs-10981032/v1},
  howpublished = {(untitled)},
  annotation = {中文辅助译名：具有典型对比学习的微状态引导动态图神经网络用于脑电图情绪识别},
  abstract = {Abstract Emotion recognition from electroencephalogram (EEG) requires modeling how brain signals evolve over time and how different brain regions interact. Deep learning has substantially improved the extraction of spatiotemporal EEG features, yet models anchored to static connectivity templates struggle to follow the functional reorganization of brain networks as emotions unfold. We propose a microstate-guided fusion framework that embeds EEG microstate information at both feature and graph levels through a dedicated encoder and a multi-source dynamic graph generator, combined with prototypical contrastive domain adaptation for cross-subject alignment. On the SEED benchmark under the subject-independent protocol, the model achieves an average accuracy of 89.64%, consistently outperforming state-of-the-art baselines. Evaluation with leave-one-subject-out validation demonstrates robust generalization across subjects. These results suggest that microstate-guided dynamic graph modeling is an effective route to capturing task-relevant neural connectivity in EEG-based emotion recognition. Future work will extend the framework to cross-dataset validation on SEED-IV and explore adaptive microstate template selection.},
}

@misc{jiang_dongmei_b618c286b668e055,
  title = {Reusable Experiences: Latent Routing and Modular Composition in LLMs},
  author = {Shuai Ling and Lizi Liao and Dongmei Jiang and Weili Guan},
  year = {2026},
  doi = {10.18653/V1/2026.ACL-LONG.1388},
  url = {https://doi.org/10.18653/V1/2026.ACL-LONG.1388},
  howpublished = {ACL (1)},
  annotation = {中文辅助译名：可重用的体验：大语言模型中的潜在路由和模块化组合},
  abstract = {Large language models (LLMs) have remarkable capabilities, but adapting them to specialized domains poses a fundamental question: how should accumulated experience be represented and leveraged?Existing approaches represent experience either as explicit textual artifacts in prompts (e.g., retrieved documents or dialogues) or implicitly within model weights via fine-tuning (e.g., LoRA adapters).However, textual methods are limited by context windows and cannot internalize knowledge, while parametric fine-tuning yields one adapter per task with minimal cross-task skill reuse.We propose ReX (Reusable eXperience), an experience-centric adaptation framework that treats latent experiences -recurring reasoning patterns and skills -as fundamental units for LLM specialization.Our method learns a shared Experience Bank of foundational skill vectors and uses a VAE-based encoder to map each input to a low-dimensional experience code.An Experience Router then dynamically composes the relevant skill vectors from this bank into a lightweight adapter for that input.By reusing skills across inputs, ReX enables implicit knowledge sharing across tasks without any explicit task identifiers.Experiments on multi-task NLP benchmarks show that this approach outperforms standard task-specific fine-tuning, yielding improved generalization through flexible skill reuse.Code is available at https://github. com/iLearn-Lab/ACL26-ReX.},
}

