  annotation = {中文辅助译名：全球博弈中的中国减排战略研究},
  abstract = {Emission reduction is the mainstream of combating climate change for green house gas emission contributes to global warming.China is now the world's biggest green house gas emitter,and its emissions are rising rapidly as its economy grows.Being a developing country,China is in the accelerated development period of industrialization and urbanization which need long time to be completed,so emission space is strongly demanded.International communities are paying more attention to Greenhouse gas emissions fast growth in China.United States and other developed countries insist that China should undertake commitments to reduce carbon emissions in international climate negotiations.Developed countries are cooperating more closely on emission reduction,and developing counties,especially China,are pressured more greatly.Two aspects of China strategy in global game playing of combating climate change should be emphasized as follows.On the one hand,the relationship between combating climate change and rapid economic development is conflict.If China can't correctly dealing with the relationship,the developmental cost will be increased and the developmental speed will be seriously influenced.On the other hand,if China addressing strategy is proper,international capital and technology can be effective used to promote sustainable development of China itself.},
}

@misc{jiang_dongmei_07826f36b248c317,
  title = {A Study of China's Peaceful Development Strategy Influence on Addressing Global Climate Change},
