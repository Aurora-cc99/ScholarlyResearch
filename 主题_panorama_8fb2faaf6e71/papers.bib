  abstract = {In order to research and express the inter-action trend of regional urban economy, society and space, the analysis of agglomeration and fragmentation emphasized the dynamic evolution relationship of the inter-units, especially of the inter-cities in the metropolitan area. Based on the introduction of the American metropolitan fragmentation index (MFI), this paper improved the uniformity index (UI) according to the characters of the development for the metropolitan areas in China. Taking the metropolitan area along Yangtze River in Jiangsu Province as an example, this paper selected the data of GDP, social total investment of capital asserts, total retail sales of consumer goods, local public finance income, local public finance expense, gross output value of the secondary industry, gross output value of tertiary industry, foreign capital introduction and actual utilization of foreign capital from Jiangsu statistical annual 1999-2005, to calculate the agglomeration and fragmentation since the 21st century, aiming to figure out the inter-action evolution relationship of the developing trend of economy, space, and governance in Jiangsu's metropolitan area through a multi-dimension analysis. This paper summed up the trends of homogenization and general development. Meanwhile, the paper concluded that the development policy making and governance structure constructing should aim at the characters of different regions, and problems in different regions should be treated in respecti},
}

@misc{panorama_8fb2faaf6e71_659941135ead79f7,
