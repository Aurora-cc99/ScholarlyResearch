  annotation = {中文辅助译名：在 NSR 发表科学报告的新方法},
  abstract = {Beginning this year, NSR will expand its scope by initiating new approaches in publishing research articles. NSR will commit to promoting scientific communication and debate, free of many existing constraints of other major journals (see Perspectives, page 518, this issue). These new initiatives include a new format for soliciting, reviewing and publishing research articles, publishing reviewers’ commentaries, and creating a new section for publishing scientific critiques and debates. In publishing original research articles, we envisage a format that involves four sets of participating scientists—authors, recommenders, editors and reviewers; all of them could find the participation a rewarding experience. Recommender—In science publishing, the initial stage of evaluation is most challenging because this demands broad expertise and informed judgment of the handling editor(s). In academic appointments, candidates are required to arrange for recommendation letters from distinguished scientists of the same field. In the same spirit, NSR will require authors to arrange for at least one such recommendation for the initial editorial evaluation. Recommenders are not involved in the subsequent manuscript review process but, if the manuscript is eventually accepted, their name will be identified in the publication. Recommenders would benefit from the opportunity of promoting high-quality research based on his/her scientific judgment. NSR will also gradually assemble a large advisory b},
}

@misc{mu_ming_poo_048224fa76bdb0d9,
  title = {Phasic dopamine release in the medial prefrontal cortex enhances stimulus discrimination},
  author = {Andrei T. Popescu and Michael Zhou and Mu‐ming Poo},
  year = {2016},
  doi = {10.1073/pnas.1606098113},
  url = {https://doi.org/10.1073/pnas.1606098113},
  howpublished = {Proceedings of the National Academy of Sciences},
  annotation = {中文辅助译名：内侧前额叶皮层的阶段性多巴胺释放增强了刺激辨别力},
  abstract = {Phasic dopamine (DA) release is believed to guide associative learning. Most studies have focused on projections from the ventral tegmental area (VTA) to the striatum, and the action of DA in other VTA target regions remains unclear. Using optogenetic activation of VTA projections, we examined DA function in the medial prefrontal cortex (mPFC). We found that mice perceived optogenetically induced DA release in mPFC as neither rewarding nor aversive, and did not change their previously learned behavior in response to DA transients. However, repetitive temporal pairing of an auditory conditioned stimulus (CS) with mPFC DA release resulted in faster learning of a subsequent task involving discrimination of the same CS against unpaired stimuli. Similar results were obtained using both appetitive and aversive unconditioned stimuli, supporting the notion that DA transients in mPFC do not represent valence. Using extracellular recordings, we found that CS-DA pairings increased firing of mPFC neurons in response to CSs, and administration of D1 or D2 DA-receptor antagonists in mPFC during learning impaired stimulus discrimination. We conclude that DA transients tune mPFC neurons for the recognition of behaviorally relevant events during learning.},
}

@misc{mu_ming_poo_6592cc91c7fd3b24,
  title = {Spatial structure of neuronal receptive field in awake monkey secondary visual cortex (V2)},
  author = {Lu Liu and Liang She and Ming Chen and Tianyi Liu and Haidong D. Lu and Yang Dan and Mu‐ming Poo},
  year = {2016},
  doi = {10.1073/pnas.1525505113},
  url = {https://doi.org/10.1073/pnas.1525505113},
  howpublished = {Proceedings of the National Academy of Sciences},
  annotation = {中文辅助译名：清醒猴次级视觉皮层（V2）神经元感受野的空间结构},
  abstract = {Visual processing depends critically on the receptive field (RF) properties of visual neurons. However, comprehensive characterization of RFs beyond the primary visual cortex (V1) remains a challenge. Here we report fine RF structures in secondary visual cortex (V2) of awake macaque monkeys, identified through a projection pursuit regression analysis of neuronal responses to natural images. We found that V2 RFs could be broadly classified as V1-like (typical Gabor-shaped subunits), ultralong (subunits with high aspect ratios), or complex-shaped (subunits with multiple oriented components). Furthermore, single-unit recordings from functional domains identified by intrinsic optical imaging showed that neurons with ultralong RFs were primarily localized within pale stripes, whereas neurons with complex-shaped RFs were more concentrated in thin stripes. Thus, by combining single-unit recording with optical imaging and a computational approach, we identified RF subunits underlying spatial feature selectivity of V2 neurons and demonstrated the functional organization of these RF properties.},
}

