@misc{mu_ming_poo_4475196b37f165eb,
  title = {RETRACTED: Binding of DCC by Netrin-1 to Mediate Axon Guidance Independent of Adenosine A2B Receptor Activation},
  author = {Elke Stein and Yimin Zou and Mu‐ming Poo and Marc Tessier‐Lavigne},
  year = {2001},
  doi = {10.1126/science.1059391},
  url = {https://doi.org/10.1126/science.1059391},
  howpublished = {Science},
  annotation = {中文辅助译名：撤回：Netrin-1 与 DCC 的结合介导独立于腺苷 A2B 受体激活的轴突引导},
  abstract = {Netrins stimulate and orient axon growth through a mechanism requiring receptors of the DCC family. It has been unclear, however, whether DCC proteins are involved directly in signaling or are mere accessory proteins in a receptor complex. Further, although netrins bind cells expressing DCC, direct binding to DCC has not been demonstrated. Here we show that netrin-1 binds DCC and that the DCC cytoplasmic domain fused to a heterologous receptor ectodomain can mediate guidance through a mechanism involving derepression of cytoplasmic domain multimerization. Activation of the adenosine A2B receptor, proposed to contribute to netrin effects on axons, is not required for rat commissural axon outgrowth or Xenopus spinal axon attraction to netrin-1. Thus, DCC plays a central role in netrin signaling of axon growth and guidance independent of A2B receptor activation.},
}

