@misc{mu_ming_poo_90dbac316f311fc9,
  title = {Single-cell spatial transcriptome atlas and whole-brain connectivity of the macaque claustrum},
  author = {Ying Lei and Yuxuan Liu and Mingli Wang and Nini Yuan and Yujie Hou and Lingjun Ding and Zhiyong Zhu and Zihan Wu and Chao Li and Mingyuan Zheng and Ruiyi Zhang and Ana Rita Ribeiro Gomes and Yuanfang Xu and Zhaoke Luo and Zhen Liu and Qinwen Chai and Pierre Misery and Yanqing Zhong and Xinxiang Song and Camille Lamy and Wei Cui and Qian Yu and Jiao Fang and Yingjie An and Ye Tian and Yiwen Liu and Xing Sun and Ruiqi L. Wang and Huanhuan Li and Jingjing Song and Xing Guo Tan and He Wang and Shiwen Wang and Ling Han and Yong Zhang and Shenyu Li and Kexin Wang and Guangling Wang and Wanqiu Zhou and Jianfeng Liu and Cong Yu and Shuzhen Zhang and Liangtang Chang and Dafina Toplanaj and Mengni Chen and Jiabing Liu and Yun Zhao and Biyu Ren and Hanyu Shi and Hui Zhang and Haotian Yan and Jianyun Ma and Lina Wang and Yan Li and Yichen Zuo and Linjie Lu and Liqin Gu and Shuting Li and Yaqian Wang and Ya-Ling He and Shengkang Li and Qi Zhang and Yanbing Lu and Yannong Dou and Yuan Liu and Anqi Zhao and Minyuan Zhang and Xinyan Zhang and Ying Xia and Wei Zhang and Huateng Cao and Zhiyue Lu and Zixian Yu and Xin Li and Xiaofei Wang and Zhifeng Liang and Shengjin Xu and Cirong Liu and Changhong Zheng and Chun Xu and Zhiyong Liu and Chengyu Li and Yan-Gang Sun and Xun Xu and Colette Dehay and Julien Vezoli and Mu‐ming Poo and Jianhua Yao and Longqi Liu and Wei Wu and Henry Kennedy and Zhiming Shen},
  year = {2025},
  doi = {10.1016/j.cell.2025.02.037},
  url = {https://doi.org/10.1016/j.cell.2025.02.037},
  howpublished = {Cell},
  annotation = {中文辅助译名：猕猴屏状体的单细胞空间转录组图谱和全脑连接},
  abstract = {Claustrum orchestrates brain functions via its connections with numerous brain regions, but its molecular and cellular organization remains unresolved. Single-nucleus RNA sequencing of 227,750 macaque claustral cells identified 48 transcriptome-defined cell types, with most glutamatergic neurons similar to deep-layer insular neurons. Comparison of macaque, marmoset, and mouse transcriptomes revealed macaque-specific cell types. Retrograde tracer injections at 67 cortical and 7 subcortical regions defined four distinct distribution zones of retrogradely labeled claustral neurons. Joint analysis of whole-brain connectivity and single-cell spatial transcriptome showed that these four zones containing distinct compositions of glutamatergic (but not GABAergic) cell types preferentially connected to specific brain regions with a strong ipsilateral bias. Several macaque-specific glutamatergic cell types in ventral vs. dorsal claustral zones selectively co-projected to two functionally related areas-entorhinal cortex and hippocampus vs. motor cortex and putamen, respectively. These data provide the basis for elucidating the neuronal organization underlying diverse claustral functions.},
}

