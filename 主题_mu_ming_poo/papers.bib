@misc{mu_ming_poo_506356efedbc0830,
  title = {Whole-brain spatial organization of hippocampal single-neuron projectomes},
  author = {Shou Qiu and Yachuang Hu and Yiming Huang and Taosha Gao and Xiaofei Wang and Danying Wang and Biyu Ren and Xiaoxue Shi and Yu Chen and Xinran Wang and Dan Wang and Luyao Han and Yikai Liang and Dechen Liu and Qingxu Liu and Li Deng and Zhaoqin Chen and Lijie Zhan and Tianzhi Chen and Yuzhe Huang and Qingge Wu and Taorong Xie and Liuqin Qian and Chenxi Jin and Jiawen Huang and Wei Deng and Tao Jiang and Xiangning Li and Xueyan Jia and Jing Yuan and Anan Li and Jun Yan and Ning-long Xu and Lin Xu and Qingming Luo and Mu‐ming Poo and Yidi Sun and Chengyu Li and Haishan Yao and Hui Gong and Yan-Gang Sun and Chun Xu},
  year = {2024},
  doi = {10.1126/science.adj9198},
  url = {https://doi.org/10.1126/science.adj9198},
  howpublished = {Science},
  annotation = {中文辅助译名：海马单神经元投影的全脑空间组织},
  abstract = {Mapping single-neuron projections is essential for understanding brain-wide connectivity and diverse functions of the hippocampus (HIP). Here, we reconstructed 10,100 single-neuron projectomes of mouse HIP and classified 43 projectome subtypes with distinct projection patterns. The number of projection targets and axon-tip distribution depended on the soma location along HIP longitudinal and transverse axes. Many projectome subtypes were enriched in specific HIP subdomains defined by spatial transcriptomic profiles. Furthermore, we delineated comprehensive wiring diagrams for HIP neurons projecting exclusively within the HIP formation (HPF) and for those projecting to both intra- and extra-HPF targets. Bihemispheric projecting neurons generally projected to one pair of homologous targets with ipsilateral preference. These organization principles of single-neuron projectomes provide a structural basis for understanding the function of HIP neurons.},
}

@misc{mu_ming_poo_491bccbc0c26c6e4,
  title = {Biphasic regulation of epigenetic state by matrix stiffness during cell reprogramming},
  author = {Yang Song and Jennifer Soto and Sze Yue Wong and Yifan Wu and Tyler Hoffman and Navied Akhtar and Sam C. P. Norris and Julia S. F. Chu and Hyungju Park and Douglas O. Kelkhoff and Cheen Euong Ang and Marius Wernig and Andrea M. Kasko and Timothy L. Downing and Mu‐ming Poo and Song Li},
  year = {2024},
  doi = {10.1126/sciadv.adk0639},
  url = {https://doi.org/10.1126/sciadv.adk0639},
  howpublished = {Science Advances},
  annotation = {中文辅助译名：细胞重编程过程中基质刚度对表观遗传状态的双相调节},
  abstract = {We investigate how matrix stiffness regulates chromatin reorganization and cell reprogramming and find that matrix stiffness acts as a biphasic regulator of epigenetic state and fibroblast-to-neuron conversion efficiency, maximized at an intermediate stiffness of 20 kPa. ATAC sequencing analysis shows the same trend of chromatin accessibility to neuronal genes at these stiffness levels. Concurrently, we observe peak levels of histone acetylation and histone acetyltransferase (HAT) activity in the nucleus on 20 kPa matrices, and inhibiting HAT activity abolishes matrix stiffness effects. G-actin and cofilin, the cotransporters shuttling HAT into the nucleus, rises with decreasing matrix stiffness; however, reduced importin-9 on soft matrices limits nuclear transport. These two factors result in a biphasic regulation of HAT transport into nucleus, which is directly demonstrated on matrices with dynamically tunable stiffness. Our findings unravel a mechanism of the mechano-epigenetic regulation that is valuable for cell engineering in disease modeling and regenerative medicine applications.},
}

@misc{mu_ming_poo_16590b0182265919,
  title = {Cross-species single-cell spatial transcriptomic atlases of the cerebellar cortex},
  author = {Shijie Hao and Xiaojia Zhu and Zhi Rui Huang and Qianqian Yang and H.-C. Liu and Yan H. Wu and Yafeng Zhan and Yuhui Dong and Chao Li and He Wang and Elize D. Haasdijk and Zihan Wu and Shenglong Li and Haotian Yan and Lijing Zhu and Shiyong Guo and Zefang Wang and Aojun Ye and Youning Lin and Luman Cui and Xing Tan and Huanlin Liu and Ming-Li Wang and Jing Chen and Yanqing Zhong and Wensi Du and Guangling Wang and Tingting Lai and Mengdi Cao and Tao Yang and Yuanfang Xu and Ling Li and Qian Yu and Zhenkun Zhuang and Ying Xia and Ying Lei and Yingjie An and Mengnan Cheng and Yun Zhao and Lei Han and Yue Yuan and Xinxiang Song and Yumo Song and Liqin Gu and Chang Xin Liu and Xiumei Lin and Ruiqi L. Wang and Zhifeng Wang and Yang Wang and Shenyu Li and Huanhuan Li and Jingjing Song and Mengni Chen and Wanqiu Zhou and Nini Yuan and Suhong Sun and Shiwen Wang and Yu Chen and Mingyuan Zheng and Jiao Fang and Ruiyi Zhang and Shuzhen Zhang and Qinwen Chai and Jiabing Liu and Wei Wu and Jie He and Haibo Zhou and Yan-Gang Sun and Zhen Liu and Chuanyu Liu and Jianhua Yao and Zhifeng Liang and Xun Xu and Mu‐ming Poo and Chengyu Li and Chris I. De Zeeuw and Zhiming Shen and Zhiyong Liu and Longqi Liu and Shiping Liu and Yidi Sun and Cirong Liu},
  year = {2024},
  doi = {10.1126/science.ado3927},
  url = {https://doi.org/10.1126/science.ado3927},
  howpublished = {Science},
  annotation = {中文辅助译名：小脑皮质的跨物种单细胞空间转录组图谱},
  abstract = {The molecular and cellular organization of the primate cerebellum remains poorly characterized. We obtained single-cell spatial transcriptomic atlases of macaque, marmoset, and mouse cerebella and identified primate-specific cell subtypes, including Purkinje cells and molecular-layer interneurons, that show different expression of the glutamate ionotropic receptor Delta type subunit 2 ( GRID2 ) gene. Distinct gene expression profiles were found in anterior, posterior, and vestibular regions in all species, whereas region-selective gene expression was predominantly observed in the granular layer of primates and in the Purkinje layer of mice. Gene expression gradients in the cerebellar cortex matched well with functional connectivity gradients revealed with awake functional magnetic resonance imaging, with more lobule-specific differences between primates and mice than between two primate species. These comprehensive atlases and comparative analyses provide the basis for understanding cerebellar evolution and function.},
}

