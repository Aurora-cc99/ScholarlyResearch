@misc{mu_ming_poo_17e87249984b78e0,
  title = {Gating of BDNF-Induced Synaptic Potentiation by cAMP},
  author = {Lisa M. Boulanger and Mu‐ming Poo},
  year = {1999},
  doi = {10.1126/science.284.5422.1982},
  url = {https://doi.org/10.1126/science.284.5422.1982},
  howpublished = {Science},
  annotation = {中文辅助译名：cAMP 对 BDNF 诱导的突触增强的门控},
  abstract = {Neurotrophins have been implicated in activity-dependent synaptic plasticity, but the underlying intracellular mechanisms remain largely unknown. Synaptic potentiation induced by brain-derived neurotrophic factor (BDNF), but not neurotrophin 3, was prevented by blockers of adenosine 3',5'-monophosphate (cAMP) signaling. Activators of cAMP signaling alone were ineffective in modifying synaptic efficacy but greatly enhanced the potentiation effect of BDNF. Blocking cAMP signaling abolished the facilitation of BDNF-induced potentiation by presynaptic activity. Thus synaptic actions of BDNF are gated by cAMP. Activity and other coincident signals that modulate cAMP concentrations may specify the action of secreted neurotrophins on developing nerve terminals.},
}

